{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_geometry.py <<'PY'\nimport gkm_try\nimport numpy as np\nfrom perception import connected_components,safe_step\n\ndef summary(e):\n    f=np.asarray(e.frame())\n    objs=[]\n    for color in [0,3,6]:\n        ys,xs=np.where((f==color)&(np.indices(f.shape)[1]>0))\n        objs.append((color,(round(float(xs.mean()),2),round(float(ys.mean()),2))) if len(xs) else (color,None))\n    return objs\n\ndef probe(e):\n    sequences=[[(39,21),(51,21)],[(39,21),(27,59),(51,21)],[(10,20),(50,20)],[(27,59),(51,21),(27,21)],[(51,21),(27,21)],[(39,21),(39,21),(39,21)],[(39,10),(39,32)]]\n    for seq in sequences:\n        c=e.clone()\n        print('NEW',summary(c))\n        for xy in seq:\n            safe_step(c,(6,*xy))\n            print(xy,summary(c),'L',c.levels_completed)\nprint(gkm_try.A.run_program('r11l',probe)[:1])\nPY\npython probe_geometry.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
