{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\np='probe_endgame.py';s=open(p).read().replace(\\\"print(A.run_program('ka59',probe)[::2])\\\",\\\"if __name__ == '__main__': print(A.run_program('ka59',probe)[::2])\\\");open(p,'w').write(s)\nPY\ncat > build_level7.py <<'PY'\nimport json\nfrom itertools import groupby\nfrom probe_cannon import START,ROUTE\nfrom probe_cross import BASE,VROUTE\nfrom probe_finish import CROSS\nfrom probe_endgame import HCROSS,VSTAGE\nsections=[\n ('Launch the horizontal piece through the lower barrier.',START),\n ('Move the upper block left through the vertical barrier.',BASE[len(START):]),\n ('Bring the vertical piece beside the upper block.',VROUTE),\n ('Time the crossing below the firing block, then launch it left.',CROSS[len(BASE+VROUTE):]),\n ('Enter the left doorway and corner-push the cross onto its outline.',HCROSS),\n ('Return the horizontal piece before staging the vertical piece.',[3]+[2]*3+[4]*7+[1]),\n ('Stage the vertical piece above its outline.',VSTAGE),\n ('Launch it down, then fill the horizontal outline.',[(6,25,28),4,2,1,3]),\n]\nlines=['','', 'def play_level_7(env):']\npath=[]\nfor comment,actions in sections:\n lines.append('    # '+comment)\n path.extend(actions)\n for action,group in groupby(actions):\n  count=len(list(group))\n  if isinstance(action,tuple):\n   for _ in range(count):lines.append(f'    select_object(env, {action[1]}, {action[2]})')\n  else:\n   lines.append(f'    move(env, {action}'+(f', {count}' if count>1 else '')+')')\nwith open('players.py','a') as f:f.write('\\\\n'.join(lines)+'\\\\n')\njson.dump(json.load(open('checkpoint.json'))['final_path']+path,open('level7_cooperative_launch_candidate.json','w'))\nprint('level7 actions',len(path))\nPY\npython build_level7.py\npython gkm_try.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
