{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_endgame.py <<'PY'\nfrom probe7 import entry\nimport gkm_arena as A\nimport perception as P\nfrom probe_finish import CROSS\n\ndef brief(e):return [(b.color,b.bbox) for b in P.connected_components(e.frame(),colors=(11,14))]\n# H exits the upper right chamber, enters the left doorway, and corner-pushes cross down.\nHCROSS=[(6,44,7)]+[4]*3+[2]*7+[3]*9+[2]+[3]*7+[1]*3+[4]+[2]\n# V descends through narrow upper doorway and stages above the lower barrier.\nVSTAGE=[(6,37,8)]+[2]*2+[3]+[2]*6+[3]*2\n# H returns through the left doorway and pushes V down onto the outline.\nHFINISH=[(6,8,22)]+[3]+[2]*3+[4]*7+[1]+[4]+[2]+[1]+[3]+[1]\ndef probe(e):\n entry(e);c=P.replay(e,CROSS)\n for label,acts in [('cross',HCROSS),('vertical',VSTAGE),('finish',HFINISH)]:\n  for a in acts: P.safe_step(c,a)\n  print(label,brief(c),'reward',c.levels_completed)\n print('final4',[(b.bbox,b.area) for b in P.connected_components(c.frame(),colors=(4,))])\nprint(A.run_program('ka59',probe)[::2])\nPY\npython - <<'PY'\np='probe_finish.py';s=open(p).read().replace(\\\"print(A.run_program('ka59',probe)[::2])\\\",\\\"if __name__ == '__main__': print(A.run_program('ka59',probe)[::2])\\\");open(p,'w').write(s)\nPY\npython probe_endgame.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
