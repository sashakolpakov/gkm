{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_mechanics.py <<'PY'\nfrom probe7 import entry\nimport gkm_arena as A\nimport perception as P\n\ndef summary(e):\n return [(b.color,b.bbox,b.area) for b in P.connected_components(e.frame(),colors=(0,5,11,14,12,13))]\ndef probe(e):\n entry(e)\n f=P.arr(e.frame()); chars={1:'.',2:'#',4:'t',11:'C',13:'B',14:'a',15:'='}\n for r in range(21): print(''.join(chars.get(int(f[r*3+1,c*3+1]),'?') for c in range(21)))\n for name,acts in [('cross',[(6,13,13),2]),('horizontal',[(6,35,52),3]),('block',[(6,47,8),3]),('wall',[1]*5+[3]*4),('bottom',[3]*3),('clickempty',[(6,1,1)])]:\n  c=P.replay(e,acts); print(name,summary(c),'reward',c.levels_completed)\n print('initial',summary(e))\nprint('done',A.run_program('ka59',probe)[::2])\nPY\n# Prevent the imported probe module from running its own callback.\npython - <<'PY'\np='probe7.py'\ns=open(p).read().replace(\\\"print(A.run_program('ka59',probe))\\\",\\\"if __name__ == '__main__': print('done',A.run_program('ka59',probe)[::2])\\\")\nopen(p,'w').write(s)\nPY\npython probe_mechanics.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
