{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat > search_level4.py <<'PY'\nimport json,math,time\nimport gkm_try as h\nfrom perception import connected_components,safe_step\nWEIGHT={10:1,6:2,15:4,11:8}\ndef blobs(e):return [b for b in connected_components(e.frame(),colors=WEIGHT) if b.bbox[0]>=10]\ndef points(bs):return [(b.color,b.bbox[3],b.bbox[2]) for b in bs]\ndef score(bs):\n p=points(bs); cost=0\n for col in WEIGHT:\n  q=[(x,y) for c,x,y in p if c==col]\n  while len(q)>1:\n   d,i,j=min((math.dist(a,b),i,j) for i,a in enumerate(q) for j,b in enumerate(q) if j>i)\n   cost+=d; q.pop(j);q.pop(i)\n return len(bs)*100+cost+sum(math.dist((x,y),(5,57))*WEIGHT[c]/8 for c,x,y in p)*.2\n\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']:e.step(a)\n start=e.clone();beam=[(score(blobs(start)),start,[])];seen=set();n=0;t=time.monotonic()\n for depth in range(45):\n  out=[]\n  for _,w,path in beam:\n   bs=blobs(w);p=points(bs)\n   acts=set()\n   for c,x,y in p:\n    for dx,dy in [(0,0),(6,0),(-6,0),(0,6),(0,-6),(4,4),(-4,4),(4,-4),(-4,-4)]:\n     if 1<=x+dx<=62 and 11<=y+dy<=61:acts.add((6,x+dx,y+dy))\n   for i,(c,x,y) in enumerate(p):\n    for d,tx,ty in p[i+1:]:\n     if c==d and math.dist((x,y),(tx,ty))<=18:acts.add((6,round((x+tx)/2),round((y+ty)/2)))\n   for a in sorted(acts):\n    v=w.clone();safe_step(v,a);n+=1\n    if n%100==0:\n     delay=n/250-(time.monotonic()-t)\n     if delay>0:time.sleep(delay)\n    vb=blobs(v)\n    if sum(WEIGHT[b.color] for b in vb)\"'!=8:continue\n    agent=tuple(b.bbox for b in connected_components(v.frame(),colors=[7]))\n    key=(tuple(points(vb)),agent)\n    if key in seen:continue\n    seen.add(key);pp=path+[a]\n    if len(vb)==1:\n     from legs import click_walk_to_region\n     print('\"'ONE',depth+1,points(vb),pp,flush=True)\n     click_walk_to_region(v,marker_color=11,stride=3,max_clicks=40)\n     print('WALK',v.levels_completed,points(blobs(v)),flush=True)\n     json.dump(pp,open('candidate_safe_merge.json','w'))\n     return\n    out.append((score(vb),v,pp))\n  out.sort(key=lambda z:z[0]);beam=out[:12]\n  print('DEPTH',depth+1,'probes',n,'best',[(round(s,1),points(blobs(w))) for s,w,p in beam[:1]],flush=True)\n  if not beam:return\nh.A.run_program('su15',probe)\nPY\npython search_level4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
