{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_search9.py <<'PY'\nimport json,time,math\nimport gkm_try as h\nfrom perception import connected_components,safe_step\nCOLORS=[10,6,15,11,12,8]\ndef marks(e):return [b for b in connected_components(e.frame(),colors=COLORS) if b.bbox[0]>=10]\ndef probe(env):\n for a in json.load(open('checkpoint.json'))['final_path']:env.step(a)\n beam=[(env.clone(),[])];seen=set();out=set();n=0;start=time.monotonic()\n for depth in range(8):\n  cand=[]\n  for e,path in beam:\n   bs=marks(e);big=max(bs,key=lambda b:b.area)\n   y,x=big.centroid\n   acts={(6,0,10)}|{(6,round(x+dx),round(y+dy)) for dx,dy in [(0,0),(6,0),(-6,0),(0,6),(0,-6),(4,4),(-4,4),(4,-4),(-4,-4)] if 0<=round(x+dx)<=63 and 10<=round(y+dy)<=62}\n   for a in sorted(acts):\n    c=e.clone();safe_step(c,a);n+=1\n    if n%50==0:time.sleep(max(0,n/250-(time.monotonic()-start)))\n    ms=marks(c);sig=tuple(sorted(b.color for b in ms));p=path+[a]\n    if sig not in out:\n     print('OUTCOME',depth+1,sig,[(b.color,b.bbox) for b in ms],p,flush=True);out.add(sig)\n    key=bytes(memoryview(c.frame()))\n    if key in seen or not ms:continue\n    seen.add(key)\n    score=100*sum(b.color==12 for b in ms)+20*len(ms)+sum(b.area for b in ms)*.1\n    cand.append((score,c,p))\n  cand.sort(key=lambda t:-t[0]);beam=[(c,p) for _,c,p in cand[:30]]\n print('DONE',n,flush=True)\nr=h.A.run_program('su15',probe);print('RESULT',r[0],r[2])\nPY\npython probe_search9.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
