{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_cycle9.py <<'PY'\nimport json,numpy as np\nimport gkm_try as h\nfrom perception import connected_components,safe_step\n\ndef agents(e):\n f=np.asarray(e.frame());out=[]\n for color in [7,14,13]:\n  pts=set(map(tuple,np.argwhere(f[10:]==color)+[10,0]))\n  while pts:\n   todo=[pts.pop()];group=[]\n   while todo:\n    p=todo.pop();group.append(p)\n    near={q for q in pts if max(abs(p[0]-q[0]),abs(p[1]-q[1]))<=2};pts-=near;todo.extend(near)\n   out.append((color,round(sum(p[1] for p in group)/len(group)),round(sum(p[0] for p in group)/len(group))))\n return out\n\ndef probe(env):\n for a in json.load(open('checkpoint.json'))['final_path']:env.step(a)\n c=env.clone();x,y=16,14\n for i in range(4):\n  safe_step(c,(6,x,y));ags=agents(c);print('CYCLE',i,ags,flush=True)\n  target=min(ags,key=lambda a:(a[1]-x)**2+(a[2]-y)**2);_,x,y=target\n for i in range(12):\n  safe_step(c,(6,0,10));print('IDLE',i,agents(c),[(b.color,b.bbox) for b in connected_components(c.frame(),colors=[6,8,10,11,12,15]) if b.bbox[0]>=10],flush=True)\nr=h.A.run_program('su15',probe);print(r[0],r[2])\nPY\npython probe_cycle9.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
