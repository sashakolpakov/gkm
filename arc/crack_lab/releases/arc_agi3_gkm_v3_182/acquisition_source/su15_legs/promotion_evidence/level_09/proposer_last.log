{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_cull9.py <<'PY'\nimport json,time,math\nimport gkm_try as h\nfrom perception import connected_components,safe_step\nfrom legs import wait_for_marker_color\nCOL=[10,6,15,11,12,8]\ndef marks(e):return [b for b in connected_components(e.frame(),colors=COL) if b.bbox[0]>=10]\ndef probe(env):\n for a in json.load(open('checkpoint.json'))['final_path']:env.step(a)\n c=env.clone();wait_for_marker_color(c,12)\n goals=[b.centroid for b in connected_components(c.frame(),colors=[9],min_area=4)]\n def score(ms):\n  ts=[b for b in ms if b.color==12]\n  return min(math.dist(b.centroid,g) for b in ts for g in goals)+12*(len(ms)-len(ts))\n beam=[(score(marks(c)),c,[])];seen=set();n=0;t=time.monotonic();best=1e9\n for depth in range(25):\n  cand=[]\n  for _,e,p in beam:\n   acts={(6,0,10)}\n   for b in marks(e):\n    y,x=b.centroid\n    for dx,dy in [(0,0),(6,0),(-6,0),(0,6),(0,-6),(4,4),(-4,4),(4,-4),(-4,-4)]:\n     nx,ny=round(x+dx),round(y+dy)\n     if 0<=nx<=63 and 10<=ny<=62:acts.add((6,nx,ny))\n   for a in sorted(acts):\n    ch=e.clone()\n    try:safe_step(ch,a)\n    except IndexError:continue\n    n+=1\n    if n%50==0:time.sleep(max(0,n/250-(time.monotonic()-t)))\n    np=p+[a]\n    if ch.levels_completed>8:\n     json.dump([(6,0,10)]*4+np,open('candidate_cull_and_place9.json','w'));print('WIN',np,flush=True);return\n    ms=marks(ch)\n    if not any(b.color==12 for b in ms):continue\n    key=bytes(memoryview(ch.frame()))\n    if key in seen:continue\n    seen.add(key);s=score(ms);cand.append((s,ch,np))\n  cand.sort(key=lambda z:z[0]);beam=cand[:24]\n  if not beam:break\n  print('DEPTH',depth+1,'best',round(beam[0][0],1),'marks',[(b.color,b.centroid) for b in marks(beam[0][1])],flush=True)\n print('FAIL',n,flush=True)\nr=h.A.run_program('su15',probe);print(r[0],r[2])\nPY\npython probe_cull9.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
