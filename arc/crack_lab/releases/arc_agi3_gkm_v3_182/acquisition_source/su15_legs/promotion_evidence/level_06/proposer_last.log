{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_mechanics.py <<'PY'\nimport json\nimport gkm_try as h\nfrom perception import connected_components,safe_step\n\ndef sig(e):\n    b=connected_components(e.frame(),colors=[7,8,9,10,6,15,11,12])\n    field=[(v.color,v.bbox,v.area) for v in b if v.bbox[0]>=10 and v.color\"'!=7]\n    hazard=[v.bbox for v in b if v.color==7 and v.bbox[0]>=10]\n    return e.levels_completed,field, (min(v[1] for v in hazard),min(v[0] for v in hazard)) if hazard else None\n\ndef probe(e):\n    for a in json.load(open('\"'checkpoint.json'))['final_path']:e.step(a)\n    tests=[[(6,36,35)],[(6,36,35),7],[(6,32,32),7],[(6,36,35)]*4,[(6,42,35)]*4,[(6,30,35)]*5,[(6,0,10)]*7]\n    for actions in tests:\n        c=e.clone();out=[]\n        for a in actions:safe_step(c,a);out.append(sig(c))\n        print(actions,out)\nprint(h.A.run_program('su15',probe)[::2])\nPY\npython probe_mechanics.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
