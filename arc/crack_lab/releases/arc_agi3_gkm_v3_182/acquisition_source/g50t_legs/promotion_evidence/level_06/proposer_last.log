{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > probe6b.py <<'PY'\nfrom probe6 import entry,A\nfrom perception import *\ndef grid(e):\n f=arr(e.frame()); return [[int(f[8+6*r,2+6*c]) for c in range(10)] for r in range(9)]\ndef show(e):\n print('reward',e.levels_completed)\n for row in grid(e): print(''.join({0:' ',5:'#',8:'G',9:'P',11:'B',14:'C',1:'.'}.get(x,str(x)) for x in row))\ndef run(e):\n entry(e); show(e)\n for path in [[3]*n for n in [1,2,3,4,5,6,7,8,9]]+[[3,3,5],[2]*5,[3,3,5,3,3]]:\n  c=replay(e,path); print('path',path);show(c)\nA.run_program('g50t',run)\nPY\n# Avoid executing the earlier probe on import.\npython - <<'PY'\np='probe6.py'\ns=open(p).read().replace(\\\"A.run_program('g50t',run)\\\",\\\"if __name__ == '__main__': A.run_program('g50t',run)\\\")\nopen(p,'w').write(s)\nPY\npython probe6b.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
