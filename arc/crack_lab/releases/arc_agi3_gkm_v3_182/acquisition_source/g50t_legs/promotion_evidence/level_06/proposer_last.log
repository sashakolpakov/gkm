{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe6c.py <<'PY'\nfrom probe6 import entry,A\nfrom perception import *\ndef tiles(e):\n f=arr(e.frame()); out=[]\n for r in range(9):\n  row=[]\n  for c in range(10):\n   v=set(int(x) for x in f[8+6*r:13+6*r,2+6*c:7+6*c].flat)\n   row.append(next((x for x in [14,9,11,8,1,5] if x in v),0))\n  out.append(row)\n return out\ndef show(e):\n print('reward',e.levels_completed)\n for row in tiles(e): print(''.join({0:' ',5:'.',8:'G',9:'P',11:'B',14:'C',1:'x'}.get(x,'?') for x in row))\ndef run(e):\n entry(e);show(e)\n paths=[[2]*3+[3]*4,[2]*3+[3]*4+[5], [3,3,1], [3,3,1,3,3], [3,3,1,3,3,5]]\n for p in paths:\n  print('PATH',p); c=replay(e,p); show(c)\nA.run_program('g50t',run)\nPY\npython probe6c.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
