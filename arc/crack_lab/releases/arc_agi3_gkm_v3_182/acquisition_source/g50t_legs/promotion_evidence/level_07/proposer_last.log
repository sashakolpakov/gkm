{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"cat > map7.py <<'PY'\nfrom probe7 import *\nimport numpy as np\n\ndef board(e):\n f=p.arr(e.frame()); out=[]\n for r in range(10):\n  row=[]\n  for c in range(10):\n   tile=f[1+6*r:6+6*r,1+6*c:6+6*c]\n   vals,counts=np.unique(tile,return_counts=True)\n   row.append('/'.join(f'{v}:{n}' for v,n in zip(vals,counts)))\n  out.append(row)\n return out\n\ndef compact(e):\n f=p.arr(e.frame()); return [' '.join(f'{int(f[4+6*r,4+6*c]):2}' for c in range(10)) for r in range(10)]\ndef probe(e):\n entry(e)\n for r,row in enumerate(board(e)): print(r,' '.join(f'{c}={v}' for c,v in enumerate(row)))\n for path in ([3,3],[3,3,5],[3,3,5,2],[2,3,3,1],[2]*4,[3]*4):\n  c=p.replay(e,path);print('PATH',path,'level',c.levels_completed)\n  print('\\\\n'.join(compact(c)))\nh.A.run_program('g50t',probe)\nPY\npython map7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
