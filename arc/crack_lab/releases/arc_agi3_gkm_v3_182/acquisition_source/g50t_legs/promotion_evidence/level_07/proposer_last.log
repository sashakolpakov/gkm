{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > reach7.py <<'PY'\nfrom probe7 import *\nfrom collections import deque\nimport time\n\ndef pos(e,color=9):\n f=p.arr(e.frame())\n for r in range(10):\n  for c in range(10):\n   if (f[2+6*r:7+6*r,2+6*c:7+6*c]==color).sum()==24:return r,c\n\ndef reach(e):\n q=deque([(e.clone(),[])]); paths={pos(e):[]}\n while q:\n  c,path=q.popleft()\n  for a in [1,2,3,4]:\n   d=p.replay(c,[a]);s=pos(d)\n   if s not in paths:\n    paths[s]=path+[a];q.append((d,path+[a]))\n  time.sleep(.014)\n return paths\n\ndef probe(e):\n entry(e);paths=reach(e);print('REACH',sorted(paths.items()))\n for target in [(4,2),(2,2),(6,8),(8,8)]:\n  if target in paths:\n   c=p.replay(e,paths[target]);print('TARGET',target,'colours',p.color_counts(c.frame()),'bot',pos(c,14),'path',paths[target])\n json.dump({str(k):v for k,v in paths.items()},open('reach7_paths.json','w'))\nh.A.run_program('g50t',probe)\nPY\npython reach7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
