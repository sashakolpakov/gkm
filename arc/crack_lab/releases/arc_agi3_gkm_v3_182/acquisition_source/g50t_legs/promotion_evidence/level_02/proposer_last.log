{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_map.py <<'PY'\nimport json\nimport gkm_try as h\nfrom perception import arr,replay,connected_components\n\ndef summary(e):\n f=arr(e.frame()); return [(b.color,b.bbox,b.area) for b in connected_components(f) if b.color not in (0,5,9)]+[(9,b.bbox,b.area) for b in connected_components(f, [9]) if b.bbox[0]>6 and b.bbox[0]<60]\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']: e.step(a)\n f=arr(e.frame())\n for r in range(8):\n  print(r, [''.join(format(int(x),'x') for x in f[10+6*r,7+6*c:13+6*c]) for c in range(8)])\n for path in ([3],[3,3],[3,3,5],[1,1,1,5],[2,2,2,2],[2,2,2,2,3,3],[3,3,3,3,3,3]):\n  c=replay(e,path);print(path,summary(c),'level',c.levels_completed)\nh.A.run_program('g50t',probe)\nPY\npython probe_map.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
