{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_route.py <<'PY'\nimport gkm_try\nfrom legs import align_marked_bar_tips\nfrom perception import safe_step, arr\nimport numpy as np\n\ndef probe(env):\n align_marked_bar_tips(env); c=env.clone(); path=[]\n for x,n in [(12,8),(27,8),(42,4),(57,6)]:\n  changed=0\n  for i in range(n):\n   before=arr(c.frame()).copy();act=(6,x,57);safe_step(c,act);path.append(act);changed+=int(not np.array_equal(before,arr(c.frame())))\n  a=arr(c.frame());ys,xs=np.where((a==13)&(np.indices(a.shape)[0]<54))\n  print('STAGE',x,n,'changed',changed,'pink',list(zip(xs.tolist(),ys.tolist())),'reward',c.levels_completed)\n print('FINAL',c.levels_completed)\n\ngkm_try.A.run_program('s5i5',probe)\nPY\npython probe_route.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
