{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,195p' legs.py\"","aggregated_output":"\"\"\"Reusable skills inferred from public frames and clone experiments.\"\"\"\nfrom perception import arr, connected_components, safe_step\n\n\ndef align_marked_bar_tips(env, max_moves=40):\n    \"\"\"Click paired controls to bring coloured bar tips onto cross marks.\n\n    Crosses are four pink pixels around an empty centre; the moving tips\n    are pink too. Choose controls by their measured reduction in distance.\n    \"\"\"\n    frame = arr(env.frame())\n    marks = []\n    for y in range(1, 63):\n        for x in range(1, 63):\n            if frame[y, x] == 5 and all(\n                frame[y + dy, x + dx] == 13\n                for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1))\n            ):\n                marks.append((x, y))\n    controls = []\n    for blob in connected_components(frame, colors=[4], min_area=4):\n        y0, x0, y1, x1 = blob.bbox\n        controls.append((6, (x0 + x1) // 2, (y0 + y1) // 2))\n    if not marks or not controls:\n        return\n    cross_pixels = {\n        (x + dx, y + dy)\n        for x, y in marks\n        for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1))\n    }\n\n    def distance(candidate):\n        pixels = arr(candidate.frame())\n        ys, xs = (pixels == 13).nonzero()\n        tips = [(int(x), int(y)) for y, x in zip(ys, xs)\n                if (int(x), int(y)) not in cross_pixels]\n        # A tip must serve its own mark; nearest-tip sums can strand a\n        # distant tip when another tip is close to both marks.\n        costs = {0: 0}\n        for x, y in marks:\n            following = {}\n            for mask, cost in costs.items():\n                for i, (tx, ty) in enumerate(tips):\n                    if not mask & (1 << i):\n                        key = mask | (1 << i)\n                        value = cost + abs(x - tx) + abs(y - ty)\n                        following[key] = min(following.get(key, 10000), value)\n            costs = following\n        return min(costs.values(), default=10000)\n\n    level = env.levels_completed\n    for _ in range(max_moves):\n        if env.terminal() or env.levels_completed > level:\n            return\n\n        best_action = None\n        best_score = distance(env)\n        for action in controls:\n            clone = env.clone()\n            safe_step(clone, action)\n            if clone.levels_completed > level:\n                best_action = action\n                break\n            score = distance(clone)\n            if score < best_score:\n                best_action, best_score = action, score\n        if best_action is None:\n            return\n        safe_step(env, best_action)\n\n\ndef park_crossing_telescopic_barriers(env, max_moves=60):\n    \"\"\"Park coupled horizontal/vertical barriers outside crossing tip lanes.\n\n    First separate the carriers sideways and upward, then retract the\n    perpendicular carriers. Saturate each joint using observed geometry,\n    verifying the complete parking sequence on a clone before committing.\n    \"\"\"\n    import numpy as np\n\n    frame = arr(env.frame())\n    controls = {}\n    buttons = connected_components(frame, colors=[4], min_area=4)\n    if not buttons:\n        return\n    ui_top = min(b.bbox[0] for b in buttons) - 1\n    for blob in buttons:\n        y0, x0, y1, x1 = blob.bbox\n        glyph = frame[y0:y1 + 1, x0:x1 + 1]\n        colors, counts = np.unique(glyph[glyph != 4], return_counts=True)\n        if len(colors):\n            color = int(colors[counts.argmax()])\n            controls.setdefault(color, []).append((6, (x0+x1)//2, (y0+y1)//2))\n    stages = ((9, 1), (14, 1), (8, 0), (12, 0))\n    if any(len(controls.get(color, [])) != 2 for color, _ in stages):\n        return\n    clone = env.clone()\n    path = []\n    for color, side in stages:\n        action = sorted(controls[color], key=lambda a: a[1])[side]\n        for _ in range(16):\n            before = arr(clone.frame())[:ui_top].copy()\n            safe_step(clone, action)\n            if np.array_equal(before, arr(clone.frame())[:ui_top]):\n                break\n            path.append(action)\n            if len(path) > max_moves:\n                return\n    for action in path:\n        safe_step(env, action)\n\n\ndef route_telescoping_arm_through_gap(env, max_moves=100):\n    \"\"\"Route a right/up/right/down arm via clear, grid-aligned bends.\n\n    Derive candidate bends from the visible arm and obstacles. Verify each\n    complete staged extension on a clone before committing its control clicks.\n    \"\"\"\n    from perception import replay\n\n    frame = arr(env.frame())\n    controls = []\n    for blob in connected_components(frame, colors=[4], min_area=4):\n        y0, x0, y1, x1 = blob.bbox\n        controls.append((6, (x0 + x1) // 2, (y0 + y1) // 2))\n    controls.sort(key=lambda action: action[1])\n    if len(controls) != 8:\n        return\n    ui_top = min(action[2] for action in controls) - 3\n    parts = {}\n    for blob in connected_components(frame, colors=[12, 10, 11, 14]):\n        if blob.bbox[2] < ui_top:\n            parts[blob.color] = blob.bbox\n    if len(parts) != 4:\n        return\n    marks = []\n    cross_pixels = set()\n    for y in range(1, ui_top):\n        for x in range(1, 63):\n            ring = [(x + dx, y + dy)\n                    for dx, dy in ((-1, 0), (1, 0), (0, -1), (0, 1))]\n            if frame[y, x] == 5 and all(frame[py, px] == 13 for px, py in ring):\n                marks.append((x, y))\n                cross_pixels.update(ring)\n    if len(marks) != 1:\n        return\n    tips = [(int(x), int(y)) for y, x in zip(*(frame == 13).nonzero())\n            if y < ui_top and (int(x), int(y)) not in cross_pixels]\n    if len(tips) != 1:\n        return\n    target_x, target_y = marks[0]\n    tip_x, tip_y = tips[0]\n    base_y = (parts[12][0] + parts[12][2]) // 2\n    base_x = parts[12][1] - 1\n    joint_x = (parts[10][1] + parts[10][3]) // 2\n    joint_y = (parts[11][0] + parts[11][2]) // 2\n    unit = parts[10][3] - parts[10][1] + 1\n    radius = unit // 2\n\n    def clear(x0, y0, x1, y1):\n        return (0 <= x0 <= x1 < 64 and 0 <= y0 <= y1 < ui_top\n                and not (frame[y0:y1 + 1, x0:x1 + 1] == 15).any())\n\n    candidates = []\n    for bend_x in range(joint_x, target_x, unit):\n        for bend_y in range(joint_y, 0, -unit):\n            shifted_tip_x = tip_x + bend_x - joint_x\n            shifted_tip_y = tip_y + bend_y - joint_y\n            changes = (bend_x - joint_x, joint_y - bend_y,\n                       target_x - shifted_tip_x, target_y - shifted_tip_y)\n            if any(value < 0 or value % unit for value in changes):\n                continue\n            if not all((\n                clear(base_x, base_y - radius, bend_x + radius, base_y + radius),\n                clear(bend_x - radius, bend_y - radius, bend_x + radius, base_y + radius),\n                clear(bend_x - radius, bend_y - radius, target_x + radius, bend_y + radius),\n                clear(target_x - radius, bend_y - radius, target_x + radius, target_y + radius),\n            )):\n                continue\n            path = [controls[2 * i + 1] for i, delta in enumerate(changes)\n                    for _ in range(delta // unit)]\n            if len(path) <= max_moves:\n                candidates.append(path)\n    level = env.levels_completed\n    for path in sorted(candidates, key=len)[:12]:\n        clone = replay(env, path)\n        if clone.levels_completed > level:\n            for action in path:\n                if env.terminal() or env.levels_completed > level:\n                    return\n                safe_step(env, action)\n            return\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,45p' perception.py; sed -n '126,205p' perception.py; cat players.py; cat solve.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,45p' perception.py; sed -n '126,205p' perception.py; cat players.py; cat solve.py\"","aggregated_output":"\"\"\"Source-free frame perception helpers for cracking.\n\nThis module is deliberately observational: it derives compact symbolic state\nfrom `env.frame()` and `env.clone()` only. It is a cofibration-style scaffold:\nraw pixels are embedded into a monotone tower of reusable observations\n(components -> objects -> action deltas -> replay states). Candidate level\nlogic should be written against these quotients, then replay-validated by the\nharness. No game source or prior solution history is read here.\n\"\"\"\nfrom collections import deque\nfrom dataclasses import dataclass\nfrom typing import Dict, Iterable, List, Optional, Sequence, Tuple\n\nimport numpy as np\n\nUP, DOWN, LEFT, RIGHT, USE = 1, 2, 3, 4, 5\nACTIONS = (UP, DOWN, LEFT, RIGHT, USE)\nDIRS = {UP: (-1, 0), DOWN: (1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\nACTION_NAME = {UP: \"UP\", DOWN: \"DOWN\", LEFT: \"LEFT\", RIGHT: \"RIGHT\", USE: \"USE\"}\n\n\n@dataclass(frozen=True)\nclass Blob:\n    color: int\n    bbox: Tuple[int, int, int, int]  # r0, c0, r1, c1 inclusive\n    area: int\n    centroid: Tuple[float, float]\n\n    @property\n    def top_left(self):\n        return self.bbox[0], self.bbox[1]\n\n    @property\n    def size(self):\n        r0, c0, r1, c1 = self.bbox\n        return r1 - r0 + 1, c1 - c0 + 1\n\n\ndef arr(frame) -> np.ndarray:\n    return np.asarray(frame)\n\n\ndef color_counts(frame) -> Dict[int, int]:\n    vals, cnts = np.unique(arr(frame), return_counts=True)\n    return {int(v): int(c) for v, c in zip(vals, cnts)}\ndef normalize_public_action(action):\n    \"\"\"Validate one public key or coordinate action without touching ``env``.\"\"\"\n    if isinstance(action, (list, tuple)):\n        if (\n            len(action) != 3\n            or action[0] != 6\n            or any(\n                not isinstance(value, int) or isinstance(value, bool)\n                for value in action\n            )\n        ):\n            raise ValueError(\n                \"coordinate action must be (6, x, y) with integer x,y in 0..63\"\n            )\n        normalized = (6, int(action[1]), int(action[2]))\n        if not (0 <= normalized[1] < 64 and 0 <= normalized[2] < 64):\n            raise ValueError(\n                \"coordinate action must be (6, x, y) with integer x,y in 0..63\"\n            )\n        return normalized\n    if (\n        not isinstance(action, int)\n        or isinstance(action, bool)\n        or action not in range(1, 8)\n    ):\n        raise ValueError(\"key action must be an integer in 1..7\")\n    if action == 6:\n        raise ValueError(\n            \"bare ACTION6 is invalid; use (6, x, y) with integer x,y in 0..63\"\n        )\n    return int(action)\n\n\ndef safe_step(env, action):\n    \"\"\"Validate locally, then apply one public key or coordinate action.\"\"\"\n    normalized = normalize_public_action(action)\n    if isinstance(normalized, tuple):\n        env.step(*normalized)\n    else:\n        env.step(normalized)\n    return normalized\n\n\ndef action_deltas(env, actions=None) -> Dict[object, dict]:\n    \"\"\"Compare valid cloned actions; bare ACTION6 is never sent to the arena.\"\"\"\n    if actions is None:\n        actions = tuple(action for action in env.actions if action != 6)\n    normalized_actions = tuple(\n        normalize_public_action(action) for action in actions\n    )\n    base = arr(env.frame()).copy()\n    out = {}\n    for action in normalized_actions:\n        clone = env.clone()\n        safe_step(clone, action)\n        out[action] = frame_delta(base, clone.frame())\n    return out\n\n\ndef replay(env, actions: Sequence):\n    normalized_actions = tuple(\n        normalize_public_action(action) for action in actions\n    )\n    clone = env.clone()\n    for action in normalized_actions:\n        if clone.terminal():\n            break\n        safe_step(clone, action)\n    return clone\n\n\ndef path_result(env, actions: Sequence[int]) -> dict:\n    clone = replay(env, actions)\n    return {\n        \"levels_completed\": int(clone.levels_completed),\n        \"terminal\": bool(clone.terminal()),\n        \"path_len\": len(actions),\n        \"colors\": color_counts(clone.frame()),\n        \"objects\": object_candidates(clone.frame()),\n    }\n# Per-level players only compose reusable legs.\nfrom legs import (align_marked_bar_tips, route_telescoping_arm_through_gap,\n                  park_crossing_telescopic_barriers)\n\n\ndef play_level_1(env):\n    align_marked_bar_tips(env)\n\n\ndef play_level_2(env):\n    route_telescoping_arm_through_gap(env)\n\n\ndef play_level_3(env):\n    park_crossing_telescopic_barriers(env)\n    align_marked_bar_tips(env)\nimport players\n\ndef solve(env):\n    # dispatch to the per-level player for the current level, in a loop\n    while not env.terminal():\n        k = env.levels_completed + 1\n        fn = getattr(players, f'play_level_{k}', None)\n        if fn is None:\n            return\n        before = env.levels_completed\n        fn(env)\n        if env.levels_completed <= before:\n            return  # no progress -> stop\n","exit_code":0,"status":"completed"}}
