{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_plan.py <<'PY'\nimport gkm_try\nfrom legs import align_ring_marker\nfrom perception import arr,safe_step\nfrom collections import deque\n\ndef probe(env):\n    align_ring_marker(env)\n    vertical=[(x,17) for x in range(23,36,3)]+[(35,y) for y in range(20,45,3)]+[(x,44) for x in range(32,22,-3)]+[(23,y) for y in range(41,17,-3)]\n    loops=[vertical,[(x,26) for x in range(17,46,3)],[(x,35) for x in range(17,46,3)]]\n    actions=[(6,20,17),(6,39,17),(6,14,26),(6,48,26),(6,14,35),(6,48,35)]\n    points=sorted(set(sum(loops,[])))\n    f=arr(env.frame());seq=tuple(int(f[y,x]) for x,y in points)\n    perms=[]\n    for a,loop in zip(actions,[l for l in loops for _ in range(2)]):\n        c=env.clone();safe_step(c,a);g=arr(c.frame());target=tuple(int(g[y,x]) for x,y in points)\n        fits=[]\n        for shift in [-1,1]:\n            perm=list(range(len(points)))\n            for i,p in enumerate(loop):perm[points.index(p)]=points.index(loop[(i+shift)%len(loop)])\n            after=list(seq)\n            for src,dst in enumerate(perm):after[dst]=seq[src]\n            if tuple(after)==target:fits.append(perm)\n        print('MODEL',a,'fits',len(fits))\n        assert len(fits)==1\n        perms.append(fits[0])\n    start=tuple(i for i,v in enumerate(seq) if v==11)\n    goal=tuple(sorted(points.index(p) for p in [(35,26),(35,35)]))\n    q=deque([(start,[])]);seen={start}\n    while q:\n        s,path=q.popleft()\n        if tuple(sorted(s))==goal:break\n        for k,perm in enumerate(perms):\n            t=tuple(sorted(perm[i] for i in s))\n            if t not in seen:seen.add(t);q.append((t,path+[k]))\n    print('PLAN',len(path),path,'states',len(seen),'start',start,'goal',goal)\n    c=env.clone();state=seq\n    for k in path:\n        safe_step(c,actions[k])\n        expected=list(state)\n        for src,dst in enumerate(perms[k]):expected[dst]=state[src]\n        state=tuple(expected)\n        if c.levels_completed>1:break\n        g=arr(c.frame());assert tuple(int(g[y,x]) for x,y in points)==state\n    print('VERIFIED',c.levels_completed,'terminal',c.terminal())\n\ngkm_try.A.run_program('lp85',probe)\nPY\npython probe_plan.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
