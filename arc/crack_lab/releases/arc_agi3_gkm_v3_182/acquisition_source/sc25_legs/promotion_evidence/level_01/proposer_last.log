{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > probe.py <<'PY'\nimport gkm_try as h\nfrom perception import *\ndef summary(e):\n f=arr(e.frame()); return [(b.color,b.bbox,b.area) for b in connected_components(f) if b.color not in (5,14)]\ndef probe(e):\n for x,y in [(15,20),(30,20),(41,20),(16,55),(16,51),(12,55),(19,55),(16,58),(25,50),(30,50),(35,50),(25,55),(30,55),(35,55),(25,60),(30,60),(35,60),(1,1)]:\n  c=e.clone();safe_step(c,(6,x,y));d=frame_delta(e.frame(),c.frame());print((x,y),'d',d['count'],d['bbox'],'level',c.levels_completed)\n  if d['count']:print('objects',summary(c))\nh.A.run_program('sc25',probe)\nPY\npython probe.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
