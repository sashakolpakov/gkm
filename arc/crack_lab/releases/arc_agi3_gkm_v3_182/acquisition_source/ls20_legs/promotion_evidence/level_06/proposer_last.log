{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"cat > hud6.py <<'PY'\nexec(open('probe6.py').read().split('def entry')[0])\ndef hud(e):\n f=P.arr(e.frame());return ''.join(format(int(v),'x') for v in f[55:61:2,3:9:2].flatten())\ndef entry(env):\n for a in json.load(open('checkpoint.json'))['final_path']:env.step(a)\n print('initial HUD',hud(env))\n for path in ([1,1,4],[3,3,1,3]+[1]*4+[4,4,4],[3,3,1,3]+[1]*8+[4]*6+[2]*2+[4]*2+[1,4,1,3,2,2,4,2,2,2]):\n  e=env.clone()\n  for a in path:\n   old=hud(e);e.step(a)\n   if hud(e)\"'!=old:print('\"'CHANGE',a,hud(e),state(e))\n  print('END',state(e),hud(e),e.levels_completed)\nA.run_program('ls20',entry)\nPY\npython hud6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
