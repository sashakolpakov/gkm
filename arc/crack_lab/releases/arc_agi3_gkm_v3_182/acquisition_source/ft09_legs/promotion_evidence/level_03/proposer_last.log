{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_level3.py <<'PY'\nimport gkm_try as h\nfrom perception import arr, safe_step\nfrom legs import match_miniature\nBOARDS=((20,4),(12,20),(28,20),(20,36))\ndef probe(env):\n    h.resumed_solve(env)\n    f=arr(env.frame())\n    for x,y in BOARDS:\n        print('board', (x,y), 'mini',f[y+8:y+14:2,x+8:x+14:2].tolist())\n    for xy in [(23,7),(23,23),(31,15),(23,31),(0,0)]:\n        c=env.clone(); values=[]\n        for _ in range(3):\n            safe_step(c,(6,*xy)); values.append(int(arr(c.frame())[xy[1],xy[0]]))\n        print('repeated',xy,'initial',int(f[xy[1],xy[0]]),'then',values,'level',c.levels_completed)\n    trial=env.clone()\n    try:\n        match_miniature(trial,*BOARDS[0],additional_boards=BOARDS[1:])\n        print('matched level',trial.levels_completed)\n    except Exception as e:\n        print('match failed',str(e))\nh.A.run_program('ft09',probe)\nPY\npython probe_level3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
