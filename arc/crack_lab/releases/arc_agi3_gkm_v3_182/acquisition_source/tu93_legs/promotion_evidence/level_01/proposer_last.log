{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_maze.py <<'PY'\nimport gkm_try as h\nimport perception as p\nfrom collections import deque\nimport json\n\ndef avatar(e):\n    bs=p.connected_components(e.frame(),colors=[9]);return bs[0].centroid if bs else None\n\ndef probe(env):\n    f=p.arr(env.frame());start=tuple(map(int,avatar(env)))\n    goal=tuple(map(int,p.connected_components(f,colors=[14])[0].centroid))\n    ds={1:(-6,0),2:(6,0),3:(0,-6),4:(0,6)}\n    q=deque([(start,[])]);seen={start};path=None\n    while q:\n        pos,acts=q.popleft()\n        if pos==goal:path=acts;break\n        for a,(dr,dc) in ds.items():\n            nxt=(pos[0]+dr,pos[1]+dc)\n            if not all(0<=v<64 for v in nxt) or nxt in seen:continue\n            if int(f[nxt]) not in (0,9,14) or int(f[pos[0]+dr//2,pos[1]+dc//2])\"'!=2:continue\n            seen.add(nxt);q.append((nxt,acts+[a]))\n    print('\"'graph',start,goal,'reachable',len(seen),'path',path)\n    for prefix in ([4],[4,2],[4,2,2]):\n        c=p.replay(env,prefix)\n        print('context',prefix,'avatar',avatar(c))\n        for a in env.actions:\n            t=p.replay(c,[a]);print('try',a,avatar(t),'level',t.levels_completed)\n    c=env.clone()\n    for i,a in enumerate(path):\n        c.step(a)\n        print('route',i+1,a,avatar(c),'level',c.levels_completed)\n    print('clone_result',c.levels_completed,c.terminal())\n    with open('maze_level1_candidate.json','w') as out:json.dump(path,out)\nh.A.run_program('tu93',probe)\nPY\npython probe_maze.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
