{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_submit.py <<'PY'\nimport gkm_try as H\nimport perception as P\n\ndef probe(e):\n for order in [(36,20,44,28),(20,28,36,44)]:\n  c=e.clone()\n  for sx,tx in zip(order,(23,29,35,41)):\n   P.safe_step(c,(6,sx,59));P.safe_step(c,(6,tx,30))\n  for i in range(2):\n   b=P.arr(c.frame()).copy();P.safe_step(c,5);d=P.frame_delta(b,c.frame())\n   print('submit',order,i,'reward',c.levels_completed,'delta',d['count'],d['bbox'],'objects',[(z.color,z.bbox,z.area) for z in P.connected_components(c.frame(),min_area=4) if z.color not in (4,5,2)])\n   if c.levels_completed or c.terminal():break\nH.A.run_program('sb26',probe)\nPY\npython probe_submit.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
