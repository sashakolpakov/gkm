r('\"'Not all sockets reachable from the root box')\n    match_colour_row(env, socket_order=order)\n''';open(p,'w').write(s)\np='players.py';s=open(p).read()+'''\\\\n\\\\ndef play_level_3(env):\n    match_nested_colour_rows(env)\n''';open(p,'w').write(s)\nPY\npython gkm_try.py\"","aggregated_output":"RESULT levels=3 moves=39 replay_ok=True err=None\n","exit_code":0,"status":"completed"}}
