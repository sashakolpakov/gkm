{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_plan5.py <<'PY'\nimport json,time\nfrom collections import deque\nimport gkm_try as H\nfrom perception import safe_step,connected_components\n\ndef obs(e):\n f=e.frame();heights=tuple(next((x for x in range(64) if int(f[y][x])==0),64) for y in [3,20,38,62])\n blobs=connected_components(f,colors=[11,14]);positions=tuple(next(sum(b.centroid[0]>y for y in [15,33,50]) for b in blobs if b.color==c and b.size==(6,2)) for c in [11,14])\n return heights,positions\n\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']:safe_step(e,a)\n start=obs(e);print('START',start)\n blocked=set()\n for attempt in range(15):\n  q=deque([start]);par={start:None};end=None\n  while q:\n   s=q.popleft();h,p=s\n   if p[0] in (0,1) and h[p[0]]==22 and p[1] in (2,3) and h[p[1]]==16:end=s;break\n   successors=[]\n   for i in range(3):\n    for d in [-1,1]:\n     a=(6,62,[12,30,47][i]+(6 if i<2 else 6)*(d==1))\n     if (i,d,h[i],h[i+1]) in blocked:continue\n     hs=list(h);hs[i]+=3*d;hs[i+1]-=3*d\n     if any(v<lo or v>64 for v,lo in zip(hs,[16,25,10,10])):continue\n     successors.append(((tuple(hs),p),a))\n   for i,w in enumerate([40,52,37]):\n    if h[i]\"'!=w or h[i+1]!=w:continue\n    for k in range(2):\n     if p[k] not in (i,i+1):continue\n     ps=list(p);ps[k]=2*i+1-p[k]\n     successors.append(((h,tuple(ps)),(6,[34,46,30][i],[15,33,50][i])))\n   for t,a in successors:\n    if t not in par:par[t]=(s,a);q.append(t)\n  if end is None:print('\"'NO PLAN',len(par));return\n  route=[]\n  while par[end] is not None:\n   prev,a=par[end];route.append((prev,a,end));end=prev\n  route.reverse();print('PLAN',attempt,len(route),len(par))\n  c=e.clone();good=True\n  for n,(prev,a,target) in enumerate(route):\n   safe_step(c,a)\n   if c.levels_completed>4:\n    print('WIN',n+1);json.dump([a for _,a,_ in route[:n+1]],open('level5_counterflow_candidate.json','w'));return\n   if c.terminal():print('TERMINAL',n);return\n   actual=obs(c)\n   if actual\"'!=target:\n    print('\"'MISMATCH',n,'from',prev,'a',a,'want',target,'actual',actual)\n    if actual==prev and a[1]==62:\n     i=[12,18,30,36,47,53].index(a[2])//2;d=1 if a[2] in [18,36,53] else -1\n     blocked.add((i,d,prev[0][i],prev[0][i+1]));good=False;break\n    return\n   time.sleep(.004)\n  if good:print('NO REWARD',obs(c));return\nprint(H.A.run_program('vc33',probe)[::2])\nPY\npython probe_plan5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
