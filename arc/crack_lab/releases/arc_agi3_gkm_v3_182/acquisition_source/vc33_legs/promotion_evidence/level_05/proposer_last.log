{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_ranges5.py <<'PY'\nimport json,random,time\nimport gkm_try as H\nfrom perception import safe_step\nROWS=[3,23,40,62]\ndef heights(e):\n f=e.frame()\n return tuple(next((x for x in range(64) if int(f[y][x])==0),64) for y in ROWS)\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']:safe_step(e,a)\n c=e.clone();rng=random.Random(413);mins=list(heights(c));maxs=mins[:];fail=set();start=time.monotonic()\n ys=[12,18,30,36,47,53]\n for n in range(1800):\n  j=rng.randrange(6);old=heights(c);safe_step(c,(6,62,ys[j]));new=heights(c)\n  if new==old:fail.add((j,old[j//2],old[j//2+1]))\n  mins=[min(a,b) for a,b in zip(mins,new)];maxs=[max(a,b) for a,b in zip(maxs,new)]\n  time.sleep(max(0,(n+1)/280-(time.monotonic()-start)))\n print('RANGES',mins,maxs)\n print('FAIL',sorted(fail))\nprint(H.A.run_program('vc33',probe)[::2])\nPY\npython probe_ranges5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
