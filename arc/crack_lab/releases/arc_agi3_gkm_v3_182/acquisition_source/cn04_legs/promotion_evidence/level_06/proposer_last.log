{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\np='probe_assembly_model.py';s=open(p).read();s=s.replace('        trial = replay(env, path)\\\\n        print', '''        test = env.clone()\n        for i, selection in enumerate(selections):\n            rotation, dy, dx = poses[i]\n            dy += shifts[0]; dx += shifts[1]\n            sub = ([] if selection is None else [selection]) + [5] * rotation\n            sub += [2 if dy > 0 else 1] * (abs(dy)//3)\n            sub += [4 if dx > 0 else 3] * (abs(dx)//3)\n            test = replay(test, sub)\n            actual = arr(test.frame())\n            body0,tips0 = models[i][rotation]\n            expected = {(y+dy,x+dx) for y,x in body0}\n            colors = {int(actual[y,x]) for y,x in expected if 0<=y<64 and 0<=x<64}\n            print('PIECE',i,'pose',rotation,dy,dx,'colors',colors,'sub',sub,flush=True)\n        trial = replay(env, path)\n        print''');open(p,'w').write(s)\nPY\npython probe_assembly6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
