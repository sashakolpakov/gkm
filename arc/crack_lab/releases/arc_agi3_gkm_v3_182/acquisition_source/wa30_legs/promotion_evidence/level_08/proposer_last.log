{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"cat > probe8_assist.py <<'PY'\nimport time,json\nfrom collections import deque\nfrom probe8 import h,entry\nfrom perception import block_signatures,DIRS\n\nclass Trial:\n def __init__(self,e,path=()):self.e=e;self.path=list(path);self.n=0;self.start=time.monotonic()\n def step(self,a):\n  if self.e.terminal():raise RuntimeError('terminal')\n  self.e.step(a);self.path.append(a);self.n+=1\n  time.sleep(max(0,self.n/280-(time.monotonic()-self.start)))\n def obs(self):\n  t={p:s for p,s in block_signatures(self.e.frame()).items() if p[0]<15}\n  av=next(p for p,s in t.items() if 14 in s)\n  pieces={p for p,s in t.items() if 9 in s and (4 in s or 3 in s)}\n  floor={p for p,s in t.items() if s\"'!=(5,)}\n  actors={p for p,s in t.items() if 12 in s or 15 in s}\n  return av,pieces,floor,actors,t\n def route(self,goal,offset=None,limit=45):\n  for _ in range(limit):\n   av,pc,fl,ac,t=self.obs()\n   if av==goal:return\n   q=deque([(av,[])]);seen={av};found=None\n   while q:\n    p,path=q.popleft()\n    if p==goal:found=path;break\n    for a,(dr,dc) in DIRS.items():\n     n=p[0]+dr,p[1]+dc;foot={n}\n     if offset:foot.add((n[0]+offset[0],n[1]+offset[1]))\n     if n not in seen and foot<=fl and not foot&(pc|ac):seen.add(n);q.append((n,path+[a]))\n   if not found:raise RuntimeError('\"'no route '+str(goal))\n   self.step(found[0])\n  raise RuntimeError('route bound')\n def deliver(self,source,target,facing=1):\n  dr,dc=DIRS[facing]\n  self.route((source[0]-dr,source[1]-dc));self.step(facing);self.step(5)\n  if not any(s==(0,9) for s in self.obs()[-1].values()):raise RuntimeError('no pickup')\n  self.route((target[0]-dr,target[1]-dc),(dr,dc));self.step(5)\n  if target not in self.obs()[1]:raise RuntimeError('no drop')\n\ndef probe(e):\n entry(e);root=e.clone();prefix=json.load(open('intercept_carriers_candidate.json'))[:20]\n for a in prefix:root.step(a)\n for targets in [((2,14),(2,13)),((2,13),(2,14)),((3,14),(2,14)),((2,14),(3,14))]:\n  t=Trial(root.clone(),prefix)\n  try:\n   for source,target in zip([(2,2),(2,1)],targets):t.deliver(source,target)\n   print('DELIVERED',targets,len(t.path),'carriers',[(p,s) for p,s in t.obs()[-1].items() if 12 in s or s==(5,9)],flush=True)\n   # Release the last trapped cargo with a facing interaction.\n   av,pc,fl,ac,tt=t.obs();held=[p for p,s in tt.items() if s==(5,9) and p[0]<6]\n   carriers=[p for p,s in tt.items() if 12 in s and p[0]<6]\n   if carriers:\n    actor=carriers[0]\n    for facing,(dr,dc) in DIRS.items():\n     approach=actor[0]-dr,actor[1]-dc\n     if approach in fl and approach not in pc:\n      try:t.route(approach);t.step(facing);t.step(5);break\n      except RuntimeError:continue\n   print('AFTER CLEAR',len(t.path),'loose',sorted(t.obs()[1]),flush=True)\n   goals={(r,c) for r in (2,3) for c in range(11,15)}\n   for _ in range(4):\n    pc=t.obs()[1];sources=sorted(p for p in pc-goals if p[0]<6);marks=goals-pc\n    if not sources:break\n    source=sources[0];target=min(marks,key=lambda p:abs(p[0]-source[0])+abs(p[1]-source[1]))\n    t.deliver(source,target)\n   for _ in range(max(0,105-len(t.path))):\n    if t.e.levels_completed>7:break\n    t.step(5)\n   print('RESULT ASSIST',t.e.levels_completed,len(t.path),flush=True)\n   if t.e.levels_completed>7:\n    json.dump(t.path,open('assisted_delivery_candidate.json','w'));return\n  except RuntimeError as x:print('FAIL',targets,len(t.path),str(x),flush=True)\nh.A.run_program('wa30',probe)\nPY\npython probe8_assist.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
