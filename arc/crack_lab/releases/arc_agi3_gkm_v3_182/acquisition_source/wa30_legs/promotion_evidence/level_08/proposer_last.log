{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"cat > probe8_finish.py <<'PY'\nimport time,json\nfrom probe8 import h,entry\nfrom perception import block_signatures\nfrom legs import fill_marked_cells,clear_interfering_carrier\n\ndef probe(e):\n entry(e);t=e.clone();path=json.load(open('intercept_carriers_candidate.json'))[:20]\n for a in path:t.step(a)\n for i in range(1,61):\n  t.step(5);time.sleep(.004)\n  if i%10==0:print('TIME',20+i,[(p,s) for p,s in block_signatures(t.frame()).items() if 12 in s or s==(5,9)],flush=True)\n  if i==30:break\n try:fill_marked_cells(t,target_signature=(2,9),persistent_targets=True,pickup_directions=(1,2,3,4))\n except Exception as x:print('FILL',str(x),flush=True)\n print('LEVEL',t.levels_completed,'term',t.terminal(),flush=True)\nh.A.run_program('wa30',probe)\nPY\npython probe8_finish.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
