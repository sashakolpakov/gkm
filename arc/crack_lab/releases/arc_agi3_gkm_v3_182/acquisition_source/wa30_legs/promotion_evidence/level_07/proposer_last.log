{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\np='legs.py';s=open(p).read();s=s.replace('target_signature=None):','target_signature=None, economical_facing=False):',1);s=s.replace('first+[facing, 5]+second+[5]))','first+([] if economical_facing and first and first[-1] == facing\\\\n                                                  else [facing])+[5]+second+[5]))',1);open(p,'w').write(s)\nPY\ncat > probe_compositions.py <<'PY'\nexec(open('probe_level7.py').read().split('class Trace')[0])\nfrom legs import fill_marked_cells\nclass Paced:\n def __init__(self,e):self.e=e;self.path=[]\n def __getattr__(self,k):return getattr(self.e,k)\n def clone(self):return Paced(self.e.clone())\n def step(self,a):time.sleep(.0036);self.e.step(a);self.path.append(a)\ndef probe(e):\n prefix=json.load(open('checkpoint.json'))['final_path']\n for a in prefix:e.step(a)\n for wait in (0,9,12,18):\n  for dirs in [(4,),(3,),(1,),(2,),(1,2,3,4)]:\n   c=Paced(e.clone())\n   for i in range(wait):c.step(5)\n   try:fill_marked_cells(c,target_signature=(2,9),pickup_directions=dirs,economical_facing=True)\n   except Exception as ex: print('FAIL',wait,dirs,len(c.path),str(ex),symbolic(c),flush=True)\n   else:print('END',wait,dirs,len(c.path),c.levels_completed,symbolic(c),flush=True)\n   if c.levels_completed>6:\n    json.dump(prefix+c.path,open('outlined_race_candidate.json','w'));return\nA.run_program('wa30',probe)\nPY\npython probe_compositions.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
