{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\np='probe_level7.py'\ns=open(p).read();s=s[:s.index('def symbolic')]+'''def symbolic(e):\n t=block_signatures(e.frame())\n return {str(p):s for p,s in t.items() if p[0]<15 and any(x in s for x in (0,2,3,9,14,15))}\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']: e.step(a)\n from legs import clear_interfering_carrier,fill_marked_cells\n for sig in [(2,),None]:\n  c=e.clone()\n  print('ENTRY',symbolic(c))\n  try:\n   clear_interfering_carrier(c)\n   print('CLEARED',symbolic(c))\n   fill_marked_cells(c,target_signature=sig)\n   print('FILLED',sig,c.levels_completed,symbolic(c))\n  except Exception as ex: print('ERROR',sig,str(ex),symbolic(c))\nA.run_program('wa30',probe)\n''';open(p,'w').write(s)\nPY\npython probe_level7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
