{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\np='legs.py';s=open(p).read().replace('max_states=1200, max_depth=48, waypoint=None):','max_states=1200, max_depth=48, waypoint=None,\\\\n                                  board_width=64):').replace('initial = arr(env.frame())','initial = arr(env.frame())[:, :board_width]').replace('np.argwhere(arr(node.frame()) == avatar_color)','np.argwhere(arr(node.frame())[:, :board_width] == avatar_color)');open(p,'w').write(s)\nPY\ncat > route6.py <<'PY'\nexec(open('explore6.py').read().split('def entry')[0])\nfrom legs import navigate_switchable_platforms\nclass Recorder:\n def __init__(self,e):self.e=e;self.path=[]\n def __getattr__(self,k):return getattr(self.e,k)\n def step(self,*a):self.path.append(a[0] if len(a)==1 else list(a));return self.e.step(*a)\ndef entry(env):\n for a in json.load(open('checkpoint.json'))['final_path']:env.step(a)\n e=Recorder(env.clone())\n for a in json.load(open('probe_path6.json')):safe_step(e,a);time.sleep(.004)\n target=tuple(map(int,sys.argv[1:3]))\n try:navigate_switchable_platforms(e,((54,6),(51,25),(51,18)),board_width=40,waypoint=target,max_states=1800,max_depth=80)\n except Exception as ex:print('FAIL',ex,flush=True);return\n print('ROUTE',e.path,'POS',pos(e),'LEVEL',e.levels_completed,flush=True)\n json.dump(e.path,open('candidate_level6_route.json','w'))\nA.run_program('dc22',entry)\nPY\npython route6.py 52 8\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
