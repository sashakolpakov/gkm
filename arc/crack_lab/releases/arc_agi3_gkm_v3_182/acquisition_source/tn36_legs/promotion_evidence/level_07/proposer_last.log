{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe7_mechanics.py <<'PY'\nimport json\nimport gkm_try as H\nfrom perception import arr, action_deltas, frame_delta\nfrom legs import write_binary_program\nCOLS=(34,39,44,49,54,59); ROWS=(33,36,39,42,45,48)\ndef snap(c):\n a=arr(c.frame()); out=[]\n for y in range(4,32,4):\n  line=[]\n  for x in range(33,61,4):\n   v,n=__import__('numpy').unique(a[y:y+4,x:x+4],return_counts=True)\n   line.append('/'.join(f'{k}:{m}' for k,m in zip(v,n)))\n  out.append(line)\n return out\n\ndef entry(env):\n for act in json.load(open('checkpoint.json'))['final_path']: env.step(act)\n print('BOARD',snap(env))\n for words in [(0,)*6,(1,)*6,(2,)*6,(4,)*6,(8,)*6,(16,)*6,(32,)*6]:\n  c=env.clone(); before=arr(c.frame()).copy()\n  write_binary_program(c,COLS,ROWS,words,(57,58))\n  d=frame_delta(before[:32,32:],arr(c.frame())[:32,32:])\n  print('TEST',words,'level',c.levels_completed,'boarddelta',d,'BOARD',snap(c))\nH.A.run_program('tn36',entry)\nPY\npython probe7_mechanics.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
