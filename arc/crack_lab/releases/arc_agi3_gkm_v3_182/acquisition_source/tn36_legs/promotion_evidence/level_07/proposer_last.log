{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"cat > probe7_check.py <<'PY'\nimport json\nimport gkm_try as H\nfrom perception import arr,frame_delta\nfrom legs import write_binary_program\n\ndef words(c):\n a=arr(c.frame()); return [sum((int(a[y,x])==1)<<b for b,y in enumerate((33,36,39,42,45,48))) for x in (34,39,44,49,54,59)]\ndef entry(env):\n for act in json.load(open('checkpoint.json'))['final_path']:env.step(act)\n c=env.clone();print('START',words(c),c.levels_completed)\n write_binary_program(c,(34,39,44,49,54,59),(33,36,39,42,45,48),(61,61,61,61,61,1),(57,58))\n print('END',words(c),c.levels_completed)\n b=arr(c.frame()).copy();c.step(6,57,58);print('AGAIN',frame_delta(b,c.frame()))\nH.A.run_program('tn36',entry)\nPY\npython probe7_check.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
