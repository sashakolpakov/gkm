{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"cat > probe7_sequence.py <<'PY'\nimport json,time\nimport gkm_try as H\nfrom perception import arr,frame_delta\nfrom legs import write_binary_program\n\ndef entry(env):\n for act in json.load(open('checkpoint.json'))['final_path']: env.step(act)\n c=env.clone();base=arr(c.frame()).copy()\n wordslist=[(61,61,61,61,61,1),(62,30,30,1,1,1),(30,30,30,30,61,1),(62,62,62,60,62,1)]\n for words in wordslist:\n  write_binary_program(c,(34,39,44,49,54,59),(33,36,39,42,45,48),words,(57,58))\n  a=arr(c.frame());print(words,frame_delta(base[:32],a[:32]),'lev',c.levels_completed,flush=True);base=a.copy();time.sleep(.15)\nH.A.run_program('tn36',entry)\nPY\npython probe7_sequence.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
