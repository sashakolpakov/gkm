{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"cat > probe7_random.py <<'PY'\nimport json,time,random\nimport gkm_try as H\nfrom perception import arr,frame_delta\nfrom legs import write_binary_program\n\ndef entry(env):\n for act in json.load(open('checkpoint.json'))['final_path']: env.step(act)\n base=arr(env.frame()).copy();rng=random.Random(7)\n for i in range(240):\n  words=tuple(rng.choice([0,1,30,60,61,62,63]) for _ in range(6));c=env.clone()\n  write_binary_program(c,(34,39,44,49,54,59),(33,36,39,42,45,48),words,(57,58))\n  a=arr(c.frame()); n=int((base[3:32]\"'!=a[3:32]).sum())\n  if n or c.levels_completed>6:\n   print('\"'FOUND',i,words,'delta',frame_delta(base[3:32],a[3:32]),'level',c.levels_completed,flush=True);break\n  if i%40==0:print('TRIED',i,'terminal',c.terminal(),flush=True)\n  time.sleep(.11)\nH.A.run_program('tn36',entry)\nPY\npython probe7_random.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
