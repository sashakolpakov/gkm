{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_map.py <<'PY'\nimport time\nimport gkm_try as H\nfrom perception import *\ndef scan(env,label):\n f=arr(env.frame()).copy();groups={}\n for y in range(2,64,2):\n  for x in range(0,64,2):\n   c=env.clone();c.step(6,x,y);g=arr(c.frame());ys,xs=np.where(f[2:]\"'!=g[2:])\n   if len(ys):\n    key=(len(ys), tuple((z.color,z.bbox,z.area) for z in connected_components(g,colors=[11])))\n    groups.setdefault(key,[]).append((x,y))\n   time.sleep(.004)\n print(label)\n for k,v in groups.items():print(k,'\"'coords',v)\ndef probe(env):\n scan(env,'initial')\n c=env.clone();c.step(6,31,35);scan(c,'after lower')\nH.A.run_program('tn36',probe)\nPY\npython probe_map.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
