{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_pristine.py <<'PY'\nimport gkm_try as h\nimport players\nimport numpy as np\nfrom perception import frame_delta\n\ndef trial(value):\n def probe(env):\n  players.play_level_1(env);e=env.clone();b=np.array(e.frame()).copy()\n  for y in (33,36,39,42,45,48):\n   for i,x in enumerate((39,44,49,54)):\n    if not(value>>(3-i)&1):e.step(6,x,y)\n  e.step(6,46,58);f=np.array(e.frame()).copy()\n  print('FRESH',value,'reward',e.levels_completed,'delta',frame_delta(b[3:32,32:62],f[3:32,32:62]),'left',frame_delta(b[3:32,:31],f[3:32,:31])['count'])\n return probe\nfor value in range(16):h.A.run_program('tn36',trial(value))\nPY\npython probe_pristine.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
