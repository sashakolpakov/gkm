{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_hits.py <<'PY'\nimport gkm_try as h\nimport players\nimport numpy as np\nfrom perception import frame_delta\n\ndef probe(env):\n players.play_level_1(env);e=env.clone();base=np.array(e.frame());out={}\n for y in range(32,64,2):\n  for x in range(32,64,2):\n   c=e.clone();c.step(6,x,y);f=np.array(c.frame());f[1]=base[1];d=frame_delta(base,f)\n   if d['count']:\n    key=str((d['count'],d['bbox']));out.setdefault(key,[]).append((x,y))\n print('HITS',out)\nprint(h.A.run_program('tn36',probe)[::2])\nPY\npython probe_hits.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
