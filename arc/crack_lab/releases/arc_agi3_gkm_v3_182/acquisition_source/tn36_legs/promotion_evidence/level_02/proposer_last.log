{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_controls.py <<'PY'\nimport gkm_try as h\nimport players\nimport numpy as np\nfrom perception import action_deltas, frame_delta\n\ndef summary(e):\n f=np.array(e.frame());return ('level',e.levels_completed,'pieces',[(int(c),np.argwhere(f[3:32,32:62]==c).shape[0]) for c in (11,1)],'bits',[[int(f[y,x]) for y in (33,39,45)] for x in (8,13,18,23,39,44,49,54)])\ndef probe(env):\n players.play_level_1(env); e=env.clone();f=e.frame()\n for ya,yb,xa,xb in [(32,51,4,27),(32,51,35,59),(53,63,5,27)]:\n  print('PANEL',xa,ya)\n  for y in range(ya,yb):print(''.join(str(int(v)) if int(v)\"'!=5 else '\"'.' for v in f[y][xa:xb]))\n acts=[(6,x,y) for x,y in [(8,33),(8,36),(8,39),(13,33),(39,33),(11,58),(21,58),(46,58),(46,9),(46,25)]]\n print('DELTAS',action_deltas(e,acts))\n for a in acts:\n  c=e.clone();c.step(*a);print('AFTER',a,summary(c))\n  if a==(6,46,58):\n   print('EXEC DIFF',frame_delta(e.frame(),c.frame()))\n   for i in range(5):\n    b=np.array(c.frame());c.step(6,0,0);print('TICK',i,summary(c),frame_delta(b,c.frame()))\nprint(h.A.run_program('tn36',probe)[::2])\nPY\npython probe_controls.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
