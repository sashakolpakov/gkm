{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_reference.py <<'PY'\nimport gkm_try as h\nimport players\nimport numpy as np\n\ndef desc(c):\n f=np.array(c.frame());p=np.argwhere(f[3:32,:31]==4);return {'reward':c.levels_completed,'point':p.min(0).tolist() if len(p) else [],'bits':[''.join(str(int(f[y,x])==1) for y in (33,36,39,42,45,48)) for x in (8,13,18,23)]}\ndef probe(env):\n players.play_level_1(env)\n for x,y in [(3,5),(7,9),(15,17),(23,25),(11,58),(21,58),(8,52),(18,52),(46,52),(58,52)]:\n  c=env.clone();c.step(6,x,y);print((x,y),desc(c))\n c=env.clone()\n for i in range(10):\n  c.step(6,11,58);print('PREV',i,desc(c))\nprint(h.A.run_program('tn36',probe)[::2])\nPY\npython probe_reference.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
