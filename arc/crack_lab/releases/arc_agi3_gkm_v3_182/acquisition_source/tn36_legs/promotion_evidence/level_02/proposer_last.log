{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_sequence.py <<'PY'\nimport gkm_try as h\nimport players\nimport numpy as np\nfrom perception import frame_delta\n\ndef d(e):\n f=np.array(e.frame());return {'reward':e.levels_completed,'terminal':e.terminal(),'program':[sum((int(f[y,x])==1)<<(3-i) for i,x in enumerate((8,13,18,23))) for y in (33,36,39,42,45,48)],'right':[sum((int(f[y,x])==1)<<(3-i) for i,x in enumerate((39,44,49,54))) for y in (33,36,39,42,45,48)]}\ndef probe(env):\n players.play_level_1(env)\n for xy in [(8,52),(21,58),(11,58),(46,58)]:\n  c=env.clone();b=np.array(c.frame());c.step(6,*xy);print('SINGLE',xy,d(c),frame_delta(b,c.frame()))\n c=env.clone()\n for i in range(6):\n  c.step(6,21,58);print('NEXT',i,d(c))\n c=env.clone()\n # copy reference exactly\n for x in (39,44,49,54):c.step(6,x,33)\n print('COPY',d(c))\n # add next reference zero in last slot\n for x in (39,44,49,54):c.step(6,x,48)\n print('COPYNEXT',d(c))\nprint(h.A.run_program('tn36',probe)[::2])\nPY\npython probe_sequence.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
