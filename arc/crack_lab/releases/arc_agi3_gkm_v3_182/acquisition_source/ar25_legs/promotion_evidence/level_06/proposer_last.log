{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_controls.py <<'PY'\nfrom probe_level6 import A,json,arr,action_deltas,safe_step\nfrom legs import align_reflection_axis,switch_control,guide_selected_shape_to_marker\n\ndef tiles(e,col):\n f=arr(e.frame());return [(r//3,c//3) for r in range(0,63,3) for c in range(0,63,3) if f[r,c]==col]\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']:e.step(a)\n c=e.clone()\n align_reflection_axis(c);switch_control(c);align_reflection_axis(c,axis=1);switch_control(c)\n print('ALIGNED',c.levels_completed,'axes',tiles(c,10),'source',tiles(c,5),'reflection',tiles(c,4))\n for i in range(5):\n  print('CONTROL',i)\n  for a in (1,2,3,4,5,7,(6,46,10)):\n   d=c.clone();safe_step(d,a)\n   print(a, 'src-',sorted(set(tiles(c,5))-set(tiles(d,5))),'src+',sorted(set(tiles(d,5))-set(tiles(c,5))),'ref',tiles(d,4),'level',d.levels_completed)\n  switch_control(c)\nA.run_program('ar25',probe)\nPY\npython probe_controls.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
