{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_mechanics.py <<'PY'\nimport json\nimport gkm_try as H\nfrom perception import arr,safe_step\n\ndef sig(e):\n f=arr(e.frame())[:63,:63];o=[]\n for col in [4,5,10,11,0]:\n  import numpy as np\n  ys,xs=np.where(f==col)\n  o.append((col,(int(ys.min()),int(xs.min()),int(ys.max()),int(xs.max()),len(ys)) if len(ys) else None))\n return (e.levels_completed,o)\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']:safe_step(e,a)\n f=arr(e.frame());print('SHAPE')\n for r in range(18,30):print(''.join(str(int(v)) if v\"'!=9 else '\"'.' for v in f[r,15:30]))\n for path in [[1]*4,[2]*4,[3]*5,[4]*5,[5]*5,[5,1,1,2,2,3,4,5,1,2],[(6,22,23),1,2,3,4],[(6,52,23),1,2,3,4],[3,1,2,5,1,2],[4,1,2,5,1,2]]:\n  c=e.clone(); print('PATH',path)\n  for a in path:safe_step(c,a);print(a,sig(c))\nH.A.run_program('ar25',probe)\nPY\npython probe_mechanics.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
