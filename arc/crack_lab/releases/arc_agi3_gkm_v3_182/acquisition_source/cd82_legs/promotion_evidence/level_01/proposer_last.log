{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_orientations.py <<'PY'\nimport gkm_try as H\nfrom perception import *\nfrom collections import deque\ndef probe(e):\n q=deque([(e.clone(),[])]);seen=set();states=[]\n while q and len(seen)<24:\n  c,p=q.popleft();f=arr(c.frame());k=(f==2).tobytes()\n  if k in seen:continue\n  seen.add(k);states.append((c,p));print('ORIENT',p,[(b.bbox,b.area) for b in connected_components(f,[2])])\n  for a in (1,2,3,4):\n   d=c.clone();d.step(a);q.append((d,p+[a]))\n for c,p in states:\n  c.step(5);f=arr(c.frame());print('PAINT',p,'level',c.levels_completed,'white',int((f[34:44,27:37]==15).sum()),'rows',[int((r==15).sum()) for r in f[34:44,27:37]])\nH.A.run_program('cd82',probe)\nPY\npython probe_orientations.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
