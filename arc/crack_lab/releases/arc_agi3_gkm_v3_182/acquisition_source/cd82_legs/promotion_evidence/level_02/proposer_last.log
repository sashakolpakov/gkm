{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_level2.py <<'PY'\nimport gkm_try as harness\nfrom players import play_level_1\nfrom perception import arr, color_counts, connected_components, action_deltas\n\ndef summary(e):\n    return {'level':e.levels_completed,'colors':color_counts(e.frame()),'blobs':[(b.color,b.bbox,b.area) for b in connected_components(e.frame(),min_area=2)]}\n\ndef probe(e):\n    play_level_1(e)\n    print('ENTRY',summary(e),'actions',e.actions)\n    print('DELTAS',action_deltas(e))\n    f=arr(e.frame())\n    for y in range(64):\n        row=f[y]; runs=[]; start=0\n        for x in range(1,65):\n            if x==64 or row[x]\"'!=row[start]:\n                runs.append((start,x-1,int(row[start]))); start=x\n        if y==0 or (row!=f[y-1]).any(): print('\"'ROW',y,runs)\n    for a in (1,2,3,4,5):\n        c=e.clone(); c.step(a); print('ACTION',a,summary(c))\nprint(harness.A.run_program('cd82',probe))\nPY\npython probe_level2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
