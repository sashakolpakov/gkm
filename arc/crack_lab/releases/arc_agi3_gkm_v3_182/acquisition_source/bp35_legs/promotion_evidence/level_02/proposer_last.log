{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_routes.py <<'PY'\nfrom probe_level2 import A,json,arr,safe_step,connected_components\nfrom legs import ascend_breakable_shaft\n\ndef brief(e):\n f=arr(e.frame()); av=connected_components(f,colors=[9]);return {'level':e.levels_completed,'terminal':e.terminal(),'avatar':[b.bbox for b in av], 'tiles':[''.join({5:'#',10:'.',14:'Y',9:'A',15:'o',7:'G'}.get(int(f[y,x]),'?') for x in range(15,54,6)) for y in range(3,63,6)]}\ndef run(e):\n for a in json.load(open('checkpoint.json'))['final_path']:safe_step(e,a)\n for path in [[(6,21,33)],[(6,21,33),(6,21,27)],[ (6,21,33),(6,21,27),7,7,7],[(6,15,9)],[(6,21,9)]]:\n  c=e.clone()\n  for a in path:safe_step(c,a)\n  print('TEST',path,brief(c),flush=True)\n c=e.clone();ascend_breakable_shaft(c);print('EXISTING',brief(c),flush=True)\nA.run_program('bp35',run)\nPY\npython probe_routes.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
