{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_search.py <<'PY'\nfrom probe_routes import *\nimport heapq,itertools,time\n\ndef board(e):\n f=arr(e.frame());return f[3:63:6,15:54:6].copy()\ndef shift(b,c):\n # Match persistent walls/yellow/air, excluding sprites; choose strongest full-row agreement.\n best=(0,0)\n for s in range(10):\n  old=b[:10-s] if s else b;new=c[s:]\n  valid=((old==5)|(old==10)|(old==14))&((new==5)|(new==10)|(new==14))\n  n=int(((old==new)&valid).sum()); mismatch=int(((old\"'!=new)&valid).sum())\n  score=n-3*mismatch\n  if score>best[0]:best=(score,s)\n return best[1]\ndef search(e,limit=1500):\n serial=itertools.count();q=[(0,next(serial),0,e.clone(),[])];seen=set();steps=0;t=time.monotonic();best=0\n while q and steps<limit:\n  _,_,height,c,path=heapq.heappop(q);b=board(c)\n  key=arr(c.frame())[:63].tobytes()\n  if key in seen:continue\n  seen.add(key)\n  if c.levels_completed>1:\n   print('\"'WIN',len(path),'probes',steps,flush=True);json.dump(path,open('level2_safe_route.json','w'));return path\n  if c.terminal():continue\n  if height>best:\n   best=height;print('BEST',height,len(path),steps,brief(c),flush=True)\n  if len(path)>=100:continue\n  actions=[3,4,7]\n  # Only yellow cells directly above or beside the avatar; remote clicks also verified separately.\n  av=connected_components(c.frame(),colors=[9])[0];y=round((av.centroid[0]-3)/6);x=round((av.centroid[1]-15)/6)\n  for yy in range(max(0,y-2),y+1):\n   for xx in range(max(0,x-1),min(7,x+2)):\n    if b[yy,xx]==14:actions.append((6,15+6*xx,3+6*yy))\n  for a in actions:\n   d=c.clone();safe_step(d,a);steps+=1\n   if d.terminal() and d.levels_completed<=1:continue\n   h=height+shift(b,board(d))\n   heapq.heappush(q,(-h+0.06*len(path),next(serial),h,d,path+[a]))\n  delay=steps/220-(time.monotonic()-t)\n  if delay>0:time.sleep(min(delay,.1))\n print('STOP',steps,len(seen),best,flush=True)\ndef run(e):\n for a in json.load(open('checkpoint.json'))['final_path']:safe_step(e,a)\n search(e)\nA.run_program('bp35',run)\nPY\npython probe_search.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
