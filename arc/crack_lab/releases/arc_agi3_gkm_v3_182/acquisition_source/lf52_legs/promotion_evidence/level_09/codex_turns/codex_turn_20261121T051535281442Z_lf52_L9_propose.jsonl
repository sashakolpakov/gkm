f b.size==(4,4))\n    lines.append(f'    jump_supported_route(env, {jumps!r}, expected_pegs={pegs!r}, expected_blue={blue!r})')\n def act(a):\n  nonlocal offset\n  old=arr(c.frame()).copy();safe_step(c,a);path.append(a);time.sleep(.004)\n  if c.levels_completed>=level:return\n  delta,_=align(old,arr(c.frame()));offset=tuple(u+v for u,v in zip(offset,delta))\n for a in plan:\n  next_kind='keys' if isinstance(a,int) else 'jumps'\n  if next_kind!=kind:finish();group=[];kind=next_kind\n  if kind=='keys':act(a);group.append(a)\n  else:\n   src,dst=a;s=tuple(src[i]-offset[i] for i in (0,1));t=tuple(dst[i]-offset[i] for i in (0,1))\n   act((6,*s));act((6,*t));group.append((s,t))\n finish()\n if c.levels_completed!=level:raise RuntimeError('planned path did not finish')\n src=text.splitlines();src[fn.body[first_statement].lineno-1:fn.body[-1].end_lineno]=lines\n candidate='\\n'.join(src)+'\\n'\n # Verify through the existing reusable legs before editing the player.\n import players\n scope=vars(players).copy();exec(compile(candidate,'candidate_players','exec'),scope)\n d=e.clone()\n for a in json.load(open('candidate_campaign_level9_635.json')):\n  if d.levels_completed==level-1:break\n  safe_step(d,a);time.sleep(.004)\n scope[f'play_level_{level}'](d)\n if d.levels_completed!=level:raise RuntimeError('composed route did not finish')\n with open('players.py','w') as f:f.write(candidate)\n json.dump(path,open(f'candidate_shorter_level{level}.json','w'))\n print('INTEGRATED',level,'suffix_moves',len(path),'macros',len(lines),flush=True)\nA.run_program('lf52',run)\n","exit_code":0,"status":"completed"}}
