ment.items()):\n    if q!=p and q in carriers and movement[q]==q:movement[p]=p\n  choices.append(((frozenset(movement.values()),movement[pink],frozenset(movement.get(p,p) for p in ys)),a,1))\n occupied=ys|{pink}|fixed\n for x,y in ys:\n  if x>=80:continue\n  for dx,dy in dirs.values():\n   mid=x+dx,y+dy;dst=x+2*dx,y+2*dy\n   if dst[0]<=80 and mid in occupied and dst in (board|carriers)-occupied:\n    choices.append(((carriers,pink,frozenset((ys-{(x,y),mid})|{dst})),((x,y),dst),2))\n return choices\n\ncounter=itertools.count();projection=start[:3];fq=[(0,next(counter),projection)];fcost={projection:0};reverse=collections.defaultdict(list);goal_nodes=[]\nwhile fq:\n g,_,s=heapq.heappop(fq)\n if fcost[s]!=g:continue\n if s[2]=={(80,26)}:goal_nodes.append(s);continue\n for t,a,edge in first_options(s):\n  if g+edge>39:continue\n  reverse[t].append((s,edge));ng=g+edge\n  if ng<fcost.get(t,10000):fcost[t]=ng;heapq.heappush(fq,(ng,next(counter),t))\nvf={s:0 for s in goal_nodes};fq=[(0,next(counter),s) for s in goal_nodes];heapq.heapify(fq)\nwhile fq:\n g,_,s=heapq.heappop(fq)\n if vf[s]!=g:continue\n for t,edge in reverse[s]:\n  ng=g+edge\n  if ng<vf.get(t,10000):vf[t]=ng;heapq.heappush(fq,(ng,next(counter),t))\nprint('FIRST_VALUE_STATES',len(fcost),'useful',len(vf),'initial',vf.get(projection),flush=True)\nqueue=[(vf[projection]+minimum,0,0,start)];counter=itertools.count(1);cost={start:0};prev={};best=86;cache={};goals=0\nfor n in range(900000):\n if not queue:break\n priority,g,_,s=heapq.heappop(queue)\n if cost[s]!=g:continue\n if priority>=best:continue\n carriers,pink,ys,cs=s\n if ys=={(80,26)}:\n  goals+=1\n  if max(last_vf.get((p,last_yellow),100000) for p in cs)+g>=best:continue\n  bound=best-g-1\n  if cs not in cache or (cache[cs][1] is None and cache[cs][0]<bound):cache[cs]=(bound,last_plan(cs,bound))\n  result=cache[cs][1]\n  if result and g+result[0]<best:\n   best=g+result[0];path=[];t=s\n   while t!=start:t,a=prev[t];path.append(a)\n   path=path[::-1]+result