,frozenset(hs)\n def jumps(s):\n  cs,ps,ys,hs=s;occupied=ps|ys|hs|fixed;support=occupied\n  dests=(board|cs)-occupied\n  for src in ys|hs:\n   x,y=src\n   for dx,dy in directions.values():\n    mid=x+dx,y+dy;dst=x+2*dx,y+2*dy\n    if mid in support and dst in dests:yield src,dst\n if phase=='whole':\n  initial_yellow=start[2];s=start;selected=None\n  for i,a in enumerate(w['actions'][:-1]):\n   if isinstance(a,int):s=key_step(s,a)\n   elif selected is None:selected=tuple(a[j]+w['states'][i]['offset'][j-1] for j in (1,2))\n   else:\n    dst=tuple(a[j]+w['states'][i]['offset'][j-1] for j in (1,2));s=jump_step(s,selected,dst);selected=None\n   new=freeze(w['states'][i+1]['yellow'])-s[2]\n   if new:\n    if not new<=board:print('UNMODELED_PEG',i,new,flush=True);return\n    initial_yellow|=new;s=(s[0],s[1],s[2]|new,s[3])\n  start=(start[0],start[1],initial_yellow,start[3]);print('INFERRED_INITIAL',sorted(initial_yellow),'fixed',sorted(fixed),flush=True)\n # Falsify the transition model against every already reproduced suffix step.\n s=start;selected=None\n validation=[] if phase=='five_last' else w['actions'][start_index:41] if phase=='six_first' else w['actions'][start_index:35] if phase=='five_first' else w['actions'][start_index:47] if phase=='first' else w['actions'][start_index:115] if phase=='middle' else w['actions'][start_index:-1]\n for i,a in enumerate(validation,start_index):\n  if isinstance(a,int):s=key_step(s,a)\n  elif selected is None:selected=tuple(a[j]+w['states'][i]['offset'][j-1] for j in (1,2))\n  else:\n   dst=tuple(a[j]+w['states'][i]['offset'][j-1] for j in (1,2));s=jump_step(s,selected,dst);selected=None\n  observed=w['states'][i+1]\n  expected=(freeze(observed['carriers'])&roads,freeze(observed['pink'])&roads,freeze(observed['yellow']),freeze(observed['helpers']))\n  if phase=='middle':expected=(*expected[:2],frozenset(p for p in expected[2] if p[0]<130),expected[3])\n  actual=s if phase not in ('whole','five_first','six_first') else (s[0],s[1],s[2]&freeze(observed['yellow']),s[3])\n  if selected is None and actual!=expected:\n   print('MODEL_MISMATCH',i,a,'predicted',s,'actual',expected,flush=True);return\n print('MODEL_VERIFIED',len(validation),'steps',flush=True)\n def goal(s):\n  if phase=='five_first':return s[2]=={(80,26)}\n  if phase=='six_first':return s[2]=={(116,20)} and s[3]=={(110,20)}\n  if phase=='middle':return s[2]=={(116,44)} and s[3]=={(116,38)}\n  return (s[2]|s[3]=={(50,56),(56,56)}) if phase=='first' else len(s[2])==1\n def h(s):\n  if phase=='first':\n   return min(sum(min(abs(x-u)+abs(y-v) for x,y in group)/6 for group,(u,v) in zip((s[2],s[3]),targets)) for targets in [((50,56),(56,56)),((56,56),(50,56))])\n  if phase in ('middle','six_first'):\n   targets=((116,20),(110,20)) if phase=='six_first' else ((116,44),(116,38))\n   return sum(min(abs(x-u)+abs(y-v) for x,y in group)/6 for group,(u,v) in zip((s[2],s[3]),targets))+2*(len(s[2])-1)\n  ys=s[2]\n  if phase in ('whole','five_first','five_last','six_last'):return 2*(len(ys)-1)\n  if len(ys)==1:return 0\n  a,b=tuple(ys)\n  return max(2,(abs(a[0]-b[0])+abs(a[1]-b[1]))/6)\n count=itertools.count();queue=[(h(start),0,next(count),start)];cost={start:0};prev={}\n for n in range(limit):\n  if not queue:break\n  _,g,_,s=heapq.heappop(queue)\n  if cost[s]!=g:continue\n  if goal(s):\n   path=[]\n   while s!=start:s,a=prev[s];path.append(a)\n   path.reverse();print('FOUND',g,'states',len(cost),'path',path,flush=True)\n   json.dump({'level':level,'start':start_index,'actions':path},open('candidate_planned_'+phase+str(level)+'.json','w'));return\n  successors=[(key_step(s,a),a,1) for a in directions]\n  successors += [(jump_step(s,src,dst),(src,dst),2) for src,dst in jumps(s)]\n  for t,a,edge in successors:\n   ng=g+edge\n   if ng>=(43 if phase=='six_first' else 37 if phase=='five_first' else 49 if phase=='first' else 68 if phase=='middle' else len(w['actions'])-start_index) or ng>=cost.get(t,100000):continue\n   cost[t]=ng;prev[t]=(s,a);heapq.heappush(queue,(ng+1.3*h(t),ng,next(count),t))\n  if n and n%50000==0:print('SEARCH',n,'states',len(cost),'cost',g,flush=True)\n print('BOUNDED',len(cost),flush=True)\n\nif __name__=='__main__':\n if len(sys.argv)>1 and sys.argv[1].isdigit():plan(level=int(sys.argv[1]),start_index=0,phase='whole')\n elif len(sys.argv)>1 and sys.argv[1]=='first':plan(start_index=0,phase='first')\n elif len(sys.argv)>1 and sys.argv[1]=='middle':plan(start_index=48,phase='middle')\n elif len(sys.argv)>1 and sys.argv[1]=='five_first':plan(level=5,start_index=0,phase='five_first')\n elif len(sys.argv)>1 and sys.argv[1]=='five_last':plan(level=5,start_index=36,phase='five_last')\n elif len(sys.argv)>1 and sys.argv[1]=='six_first':plan(level=6,start_index=0,phase='six_first')\n elif len(sys.argv)>1 and sys.argv[1]=='six_last':plan(level=6,start_index=42,phase='six_last')\n else:plan()\n","exit_code":0,"status":"completed"}}
