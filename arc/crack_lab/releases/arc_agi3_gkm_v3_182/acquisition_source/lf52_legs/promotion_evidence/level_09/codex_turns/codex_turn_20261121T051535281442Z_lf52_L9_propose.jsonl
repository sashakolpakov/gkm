{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,150p' collect_world.py\"","aggregated_output":"import sys,json,time,collections\nimport numpy as np\nsys.path.insert(0, '/Users/sasha/gkm/output/arc_agi3_gpt61_zero_seed_20261116T144404Z/source/arc/crack_lab')\nimport gkm_arena as A\nfrom perception import *\n\ndef align(a,b):\n def empties(f):return [(v.bbox[1]+2,v.bbox[0]+2) for v in connected_components(f,colors=(1,)) if v.size==(4,4)]\n hist=collections.Counter((x-u,y-v) for x,y in empties(a) for u,v in empties(b) if abs(x-u)<=54 and abs(y-v)<=54)\n candidates={p for p,n in hist.most_common(12)}|{(0,0),(6,0),(-6,0),(0,6),(0,-6),(20,0),(-20,0),(0,20),(0,-20)}\n def score(p):\n  dx,dy=p;x0=max(0,dx);x1=min(64,64+dx);y0=max(1,dy+1);y1=min(64,64+dy)\n  old=a[y0:y1,x0:x1];new=b[y0-dy:y1-dy,x0-dx:x1-dx]\n  return np.count_nonzero(old!=new)/old.size+.00001*(abs(dx)+abs(dy))\n p=min(candidates,key=score)\n return p,round(score(p),3)\n\ndef inspect(f,offset,phase=(2,2)):\n ox,oy=offset;tiles={};carriers=[];yellow=[];helpers=[];pink=[]\n for wy in range(phase[1]+6*((oy-phase[1])//6),oy+64,6):\n  for wx in range(phase[0]+6*((ox-phase[0])//6),ox+64,6):\n   x,y=wx-ox,wy-oy\n   if not(0<=x<64 and 0<=y<64):continue\n   if not(3<=x<=61 and 3<=y<=61):\n    col=int(f[y,x])\n    if col in (1,5,9,10,12):tiles[wx,wy]=5 if col==12 else col\n    continue\n   patch=f[y-3:y+3,x-3:x+3];rim=np.concatenate([patch[0],patch[-1],patch[1:-1,0],patch[1:-1,-1]])\n   carrier=bool(np.count_nonzero(rim==11)>=16);col=int(f[y,x])\n   p=(wx,wy)\n   if carrier:carriers.append(p)\n   # Central pixels identify pieces even when adjacent outlines are connected.\n   inner=f[y-2:y+2,x-2:x+2]\n   if np.count_nonzero(inner==14)>=10:yellow.append(p)\n   if np.count_nonzero(inner==8)>=10 or (np.count_nonzero(inner==9)==12 and col==9):helpers.append(p)\n   if np.count_nonzero(inner==15)>=8:pink.append(p)\n   tiles[p]=5 if carrier else (1 if p in yellow or p in helpers or p in pink else col)\n return tiles,{'carriers':carriers,'yellow':yellow,'helpers':helpers,'pink':pink}\n\ndef run(e):\n c=e.clone();path=json.load(open('candidate_campaign_level9_635.json'));level=int(sys.argv[1]) if len(sys.argv)>1 else 7\n for a in path:\n  if c.levels_completed==level-1:break\n  safe_step(c,a);time.sleep(.004)\n start=next(i for i in range(len(path)) if False) if False else {7:320,8:465,9:533}.get(level)\n # Boundaries are reproduced from rewards, rather than relying on saved offsets.\n d=e.clone();start=0\n for i,a in enumerate(path):\n  if d.levels_completed==level-1:start=i;break\n  safe_step(d,a);time.sleep(.004)\n offset=(0,0);previous=arr(c.frame()).copy();world={};states=[];actions=[]\n first_socket=next(b for b in connected_components(previous,colors=(1,)) if b.size==(4,4))\n phase=((first_socket.bbox[1]+2)%6,(first_socket.bbox[0]+2)%6)\n def record():\n  tiles,obs=inspect(arr(c.frame()),offset,phase)\n  for p,col in tiles.items():\n   # Keep terrain observations, deferring transient occupants to the state.\n   if col in (1,5,9,10) and not (col==1 and world.get(p)==5):world[p]=col\n   elif col==12:world[p]=5\n  states.append({'offset':offset,**obs})\n record()\n previous_action=None\n for i,a in enumerate(path[start:]):\n  safe_step(c,a);time.sleep(.004);actions.append(a)\n  if c.levels_completed>=level:break\n  f=arr(c.frame()).copy();delta,error=align(previous,f)\n  if isinstance(a,list) and isinstance(previous_action,list) and abs(a[1]-previous_action[1])+abs(a[2]-previous_action[2])==12:\n   sx,sy=previous_action[1:]\n   for color in (14,8):\n    if np.count_nonzero(previous[sy-2:sy+2,sx-2:sx+2]==color)>=10:\n     targets=[(a[1]-b.bbox[1]-2,a[2]-b.bbox[0]-2) for b in connected_components(f,colors=(color,)) if b.size==(4,4)]\n     if targets:delta=min(targets,key=lambda p:abs(p[0]-delta[0])+abs(p[1]-delta[1]))\n  if level in (6,7) and isinstance(a,list):\n   blue=lambda ff:[(b.bbox[1]+2,b.bbox[0]+2) for b in connected_components(ff,colors=(8,)) if b.size==(4,4)]\n   old_blue,new_blue=blue(previous),blue(f)\n   if len(old_blue)==len(new_blue)==1:\n    predicted=old_blue[0]\n    if isinstance(previous_action,list) and tuple(previous_action[1:])==predicted and abs(a[1]-predicted[0])+abs(a[2]-predicted[1])==12:predicted=tuple(a[1:])\n    delta=tuple(u-v for u,v in zip(predicted,new_blue[0]))\n  if delta!=(0,0):\n   offset=tuple(u+v for u,v in zip(offset,delta));print('SCROLL',i,delta,offset,error,flush=True)\n  previous=f;previous_action=a;record()\n json.dump({'level':level,'terrain':[[*p,col] for p,col in sorted(world.items())],'states':states,'actions':actions},open('candidate_world'+str(level)+'.json','w'))\n print('WORLD',level,'actions',len(actions),'tiles',len(world),'bounds',(min(x for x,y in world),min(y for x,y in world),max(x for x,y in world),max(y for x,y in world)),flush=True)\n print('INITIAL',states[0],flush=True)\nif __name__=='__main__':A.run_program('lf52',run)\n","exit_code":0,"status":"completed"}}
