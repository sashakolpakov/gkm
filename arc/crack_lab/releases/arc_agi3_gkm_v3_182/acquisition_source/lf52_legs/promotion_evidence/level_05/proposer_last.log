{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"cat > route_probe.py <<'PY'\nexec(open('probe5.py').read().split('def probe(e):')[0])\nfrom collections import deque\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']:e.step(a)\n q=deque([(e.clone(),())]);seen={arr(e.frame())[1:].tobytes()};states=[]\n while q and len(seen)<650:\n  n,p=q.popleft();s=summary(n);states.append((p,s))\n  for a in (1,2,3,4):\n   c=n.clone();safe_step(c,a);time.sleep(.004)\n   k=arr(c.frame())[1:].tobytes()\n   if k not in seen:seen.add(k);q.append((c,p+(a,)))\n print('STATES',len(seen),'QUEUE',len(q))\n json.dump(states,open('motion_observations.json','w'))\n for p,s in states:\n  movers=[(x[0],x[1]) for x in s if x[0] in (12,15)]\n  if any(x[1][1]>8 for x in movers if x[0]==12) or any(x[1][1]>8 and x[1]\"'!=(20,26) for x in movers if x[0]==15):print('\"'ROUTE',p,movers)\nA.run_program('lf52',probe)\nPY\npython route_probe.py\"","aggregated_output":"STATES 650 QUEUE 6\nROUTE (3, 3, 2) [(12, (14, 8)), (15, (32, 14)), (15, (20, 26))]\nROUTE (4, 4, 2) [(12, (32, 14)), (15, (50, 8)), (15, (20, 26))]\nROUTE (3, 3, 2, 2) [(12, (14, 8)), (15, (32, 20)), (15, (20, 26))]\nROUTE (3, 3, 2, 4) [(12, (20, 8)), (15, (32, 14)), (15, (20, 26))]\nROUTE (4, 4, 2, 2) [(12, (32, 20)), (15, (50, 8)), (15, (20, 26))]\nROUTE (4, 4, 2, 3) [(12, (32, 14)), (15, (44, 8)), (15, (20, 26))]\nROUTE (3, 3, 2, 2, 2) [(12, (14, 8)), (15, (20, 26)), (15, (32, 26))]\nROUTE (3, 3, 2, 2, 4) [(12, (20, 8)), (15, (32, 20)), (15, (20, 26))]\nROUTE (3, 3, 2, 4, 4) [(12, (26, 8)), (15, (32, 14)), (15, (20, 26))]\nROUTE (4, 4, 2, 2, 2) [(12, (32, 26)), (15, (50, 8)), (15, (20, 26))]\nROUTE (4, 4, 2, 2, 3) [(12, (32, 20)), (15, (44, 8)), (15, (20, 26))]\nROUTE (4, 4, 2, 3, 3) [(12, (32, 14)), (15, (38, 8)), (15, (20, 26))]\nROUTE (3, 3, 2, 2, 2, 2) [(12, (14, 8)), (15, (20, 26)), (15, (32, 32))]\nROUTE (3, 3, 2, 2, 2, 4) [(12, (20, 8)), (15, (20, 26)), (15,