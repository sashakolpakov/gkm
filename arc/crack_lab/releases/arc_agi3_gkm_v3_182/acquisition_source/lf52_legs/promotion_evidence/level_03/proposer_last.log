{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_map.py <<'PY'\nimport json\nimport numpy as np\nimport gkm_try as h\nfrom perception import connected_components,safe_step,arr\nfrom legs import solve_peg_jumps\n\ndef delta(a,b):\n scores=[]\n for d in range(-12,13):\n  aa=a[:,max(0,-d):min(64,64-d)];bb=b[:,max(0,d):min(64,64+d)]\n  mask=((aa==5)|(aa==9)|(bb==5)|(bb==9));scores.append((np.sum((aa\"'!=bb)&mask),d))\n return min(scores)[1]\ndef obs(e,ox=0):\n bs=connected_components(e.frame(),colors=(1,14))\n return {'\"'s':sorted((b.bbox[1]+2+ox,b.bbox[0]+2) for b in bs if b.size==(4,4)), 'p':sorted((b.bbox[1]+2+ox,b.bbox[0]+2) for b in connected_components(e.frame(),colors=(14,)) if b.size==(4,4)), 'c':[(b.bbox[1]+3+ox,b.bbox[0]+3) for b in connected_components(e.frame(),colors=(11,))]}\ndef inspect(e):\n for a in json.load(open('checkpoint.json'))['final_path']:e.step(a)\n c=e.clone();safe_step(c,3);solve_peg_jumps(c,extra_sockets=((38,14),),target_pegs=((38,14),(62,14),(14,50),(26,50)))\n ox=0; all_s=set();all_p=set()\n for i in range(15):\n  o=obs(c,ox);all_s.update(o['s']);all_p.update(o['p']);print('T',i,'OFFSET',ox,o)\n  a=arr(c.frame()).copy();safe_step(c,4);ox-=delta(a,arr(c.frame()))\n print('MAP',sorted(all_s),'PEGS',sorted(all_p))\n json.dump({'s':sorted(all_s),'p':sorted(all_p)},open('observed_scroll_map.json','w'))\nprint(h.A.run_program('lf52',inspect)[::2])\nPY\npython probe_map.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_map.py <<'PY'\nimport json\nimport numpy as np\nimport gkm_try as h\nfrom perception import connected_components,safe_step,arr\nfrom legs import solve_peg_jumps\n\ndef delta(a,b):\n scores=[]\n for d in range(-12,13):\n  aa=a[:,max(0,-d):min(64,64-d)];bb=b[:,max(0,d):min(64,64+d)]\n  mask=((aa==5)|(aa==9)|(bb==5)|(bb==9));scores.append((np.sum((aa\"'!=bb)&mask),d))\n return min(scores)[1]\ndef obs(e,ox=0):\n bs=connected_components(e.frame(),colors=(1,14))\n return {'\"'s':sorted((b.bbox[1]+2+ox,b.bbox[0]+2) for b in bs if b.size==(4,4)), 'p':sorted((b.bbox[1]+2+ox,b.bbox[0]+2) for b in connected_components(e.frame(),colors=(14,)) if b.size==(4,4)), 'c':[(b.bbox[1]+3+ox,b.bbox[0]+3) for b in connected_components(e.frame(),colors=(11,))]}\ndef inspect(e):\n for a in json.load(open('checkpoint.json'))['final_path']:e.step(a)\n c=e.clone();safe_step(c,3);solve_peg_jumps(c,extra_sockets=((38,14),),target_pegs=((38,14),(62,14),(14,50),(26,50)))\n ox=0; all_s=set();all_p=set()\n for i in range(15):\n  o=obs(c,ox);all_s.update(o['s']);all_p.update(o['p']);print('T',i,'OFFSET',ox,o)\n  a=arr(c.frame()).copy();safe_step(c,4);ox-=delta(a,arr(c.frame()))\n print('MAP',sorted(all_s),'PEGS',sorted(all_p))\n json.dump({'s':sorted(all_s),'p':sorted(all_p)},open('observed_scroll_map.json','w'))\nprint(h.A.run_program('lf52',inspect)[::2])\nPY\npython probe_map.py\"","aggregated_output":"RESULT levels=2 moves=42 replay_ok=True err=None\nT 0 OFFSET 0 {'s': [(8, 8), (8, 14), (8, 20), (8, 26), (8, 50), (8, 56), (14, 8), (14, 14), (14, 20), (14, 26), (14, 50), (14, 56), (20, 20), (20, 26), (20, 50), (20, 56), (26, 8), (26, 14), (26, 20), (26, 26), (26, 50), (32, 8), (32, 14), (38, 14), (62, 14)], 'p': [(14, 50), (26, 50), (38, 14), (62, 14)], 'c': [(38, 14), (32, 50)]}\nT 1 OFFSET 8 {'s': [(14, 8), (14, 14), (14, 20), (14, 26), (14, 50), (14, 56), (20, 20), (20, 26), (20, 50)