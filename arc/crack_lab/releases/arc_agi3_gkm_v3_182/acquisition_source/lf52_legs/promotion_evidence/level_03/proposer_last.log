{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,230p' gkm_try.py\nsed -n '1,175p' legs.py\nsed -n '1,60p' players.py\nsed -n '1,45p' perception.py\nsed -n '113,205p' perception.py\"","aggregated_output":"import importlib.util, json, os, sys\nsys.path.insert(0, '/Users/sasha/gkm/output/arc_agi3_gpt61_zero_seed_20261116T144404Z/source/arc/crack_lab')\nimport gkm_legs as G\nimport gkm_arena as A\ntaint_reason = G._workspace_taint_reason(os.getcwd())\nif taint_reason:\n    raise SystemExit(f\"TAINTED WORKSPACE: {taint_reason}\")\nspec = importlib.util.spec_from_file_location(\"solve\", \"solve.py\")\nm = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\ndef resumed_solve(env):\n    ck = None\n    # Prefix optimization must replay the edited solver from level 1 without\n    # mutating the supervisor-owned campaign checkpoint.\n    if os.environ.get(\"GKM_FRESH_REPLAY\") != \"1\" and os.path.exists(\"checkpoint.json\"):\n        with open(\"checkpoint.json\") as f:\n            ck = json.load(f)\n    if ck and ck.get(\"game\") == 'lf52' and ck.get(\"validated\") and ck.get(\"final_path\"):\n        for act in ck[\"final_path\"]:\n            env.step(act)\n    m.solve(env)\nlevels, path, err = A.run_program('lf52', resumed_solve)\nok = A.validate('lf52', path, levels) if path else False\nprint(f\"RESULT levels={levels} moves={len(path)} replay_ok={ok} err={err}\")\n\"\"\"Small reusable skills built from public frame observations and actions.\"\"\"\nfrom functools import lru_cache\n\nfrom perception import connected_components, safe_step\n\n\ndef solve_peg_jumps(env, *, extra_sockets=(), target_pegs=None):\n    \"\"\"Read square sockets, plan orthogonal peg captures, verify, then execute.\"\"\"\n    def observe(arena):\n        blobs = connected_components(arena.frame(), colors=(1, 14))\n        sockets = {\n            (b.bbox[1] + 2, b.bbox[0] + 2)\n            for b in blobs\n            if b.size == (4, 4) and b.area in (12, 16)\n        }\n        pegs = {\n            (b.bbox[1] + 2, b.bbox[0] + 2)\n            for b in blobs if b.color == 14 and b.size == (4, 4)\n        }\n        return sockets, frozenset(pegs)\n\n    board, initial = observe(env)\n    board.update(extra_sockets)\n    target = None if target_pegs is None else frozenset(target_pegs)\n    pitch = min(\n        abs(a[axis] - b[axis])\n        for a in board for b in board for axis in (0, 1)\n        if a[axis] != b[axis]\n    )\n    jumps = []\n    for x, y in sorted(board):\n        for dx, dy in ((pitch, 0), (-pitch, 0), (0, pitch), (0, -pitch)):\n            middle = (x + dx, y + dy)\n            destination = (x + 2 * dx, y + 2 * dy)\n            if middle in board and destination in board:\n                jumps.append(((x, y), middle, destination))\n\n    @lru_cache(None)\n    def plan(pegs):\n        if (target is not None and pegs == target) or (target is None and len(pegs) == 1):\n            return ()\n        for source, middle, destination in jumps:\n            if source in pegs and middle in pegs and destination not in pegs:\n                remaining = (pegs - {source, middle}) | {destination}\n                suffix = plan(frozenset(remaining))\n                if suffix is not None:\n                    return ((source, destination),) + suffix\n        return None\n\n    path = plan(initial)\n    if path is None:\n        raise RuntimeError('No peg reduction path found')\n    base_level = env.levels_completed\n    clone = env.clone()\n    for index, (source, destination) in enumerate(path):\n        safe_step(clone, (6, *source))\n        safe_step(clone, (6, *destination))\n        if clone.levels_completed > base_level:\n            path = path[:index + 1]\n            break\n        if len(observe(clone)[1]) != len(initial) - index - 1:\n            raise RuntimeError('Observed jump disagrees with the capture model')\n    if clone.levels_completed <= base_level and (target is None or observe(clone)[1] != target):\n        raise RuntimeError('Peg reduction did not complete the level')\n    for source, destination in path:\n        safe_step(env, (6, *source))\n        safe_step(env, (6, *destination))\n        if env.levels_completed > base_level:\n            return\n\n\ndef solve_peg_ferry(env):\n    \"\"\"Stage captures onto a movable socket, ferry it, and capture off it.\"\"\"\n    from collections import deque\n    from time import sleep\n\n    def carrier(arena):\n        outlines = [b for b in connected_components(arena.frame(), colors=(11,))\n                    if b.size == (6, 6)]\n        if len(outlines) != 1:\n            raise RuntimeError('Expected one movable socket')\n        b = outlines[0]\n        return b.bbox[1] + 3, b.bbox[0] + 3\n\n    def routes(arena):\n        start = carrier(arena)\n        found = {start: ()}\n        queue = deque([(arena.clone(), ())])\n        while queue and len(found) < 100:\n            node, path = queue.popleft()\n            for action in (1, 2, 3, 4):\n                child = node.clone()\n                safe_step(child, action)\n                sleep(0.004)\n                position = carrier(child)\n                if position not in found:\n                    found[position] = path + (action,)\n                    queue.append((child, path + (action,)))\n        if queue:\n            raise RuntimeError('Carrier routing bound exceeded')\n        return found\n\n    blobs = connected_components(env.frame(), colors=(1, 14))\n    sockets = {(b.bbox[1] + 2, b.bbox[0] + 2) for b in blobs\n               if b.size == (4, 4) and b.area in (12, 16)}\n    pegs = {(b.bbox[1] + 2, b.bbox[0] + 2) for b in blobs\n            if b.color == 14 and b.size == (4, 4)}\n    pitch = min(abs(a[i] - b[i]) for a in sockets for b in sockets\n                for i in (0, 1) if a[i] != b[i])\n    directions = ((pitch, 0), (-pitch, 0), (0, pitch), (0, -pitch))\n    unseen = set(sockets)\n    groups = []\n    while unseen:\n        group = {unseen.pop()}\n        pending = list(group)\n        while pending:\n            x, y = pending.pop()\n            for dx, dy in directions:\n                p = x + dx, y + dy\n                if p in unseen:\n                    unseen.remove(p)\n                    group.add(p)\n                    pending.append(p)\n        groups.append(group)\n    source = max(groups, key=lambda group: len(group & pegs))\n    outside = pegs - source\n    if len(outside) != 1:\n        raise RuntimeError('Ferry expects one isolated destination peg')\n\n    paths = routes(env)\n    pickup = next((p for p in paths if any(\n        (p[0] + dx, p[1] + dy) in source and\n        (p[0] + 2 * dx, p[1] + 2 * dy) in source\n        for dx, dy in directions)), None)\n    if pickup is None:\n        raise RuntimeError('No loading reach from carrier tracks')\n    for action in paths[pickup]:\n        safe_step(env, action)\n    solve_peg_jumps(env, extra_sockets=(pickup,), target_pegs=outside | {pickup})\n\n    paths = routes(env)\n    dropoff = next((p for p in paths if any(\n        (p[0] + dx, p[1] + dy) in outside and\n        (p[0] + 2 * dx, p[1] + 2 * dy) in sockets\n        for dx, dy in directions)), None)\n    if dropoff is None:\n        raise RuntimeError('No unloading reach from carrier tracks')\n    for action in paths[dropoff]:\n        safe_step(env, action)\n    solve_peg_jumps(env)\n# Per-level players only compose reusable legs.\nfrom legs import solve_peg_jumps, solve_peg_ferry\n\n\ndef play_level_1(env):\n    solve_peg_jumps(env)\n\n\ndef play_level_2(env):\n    solve_peg_ferry(env)\n\"\"\"Source-free frame perception helpers for cracking.\n\nThis module is deliberately observational: it derives compact symbolic state\nfrom `env.frame()` and `env.clone()` only. It is a cofibration-style scaffold:\nraw pixels are embedded into a monotone tower of reusable observations\n(components -> objects -> action deltas -> replay states). Candidate level\nlogic should be written against these quotients, then replay-validated by the\nharness. No game source or prior solution history is read here.\n\"\"\"\nfrom collections import deque\nfrom dataclasses import dataclass\nfrom typing import Dict, Iterable, List, Optional, Sequence, Tuple\n\nimport numpy as np\n\nUP, DOWN, LEFT, RIGHT, USE = 1, 2, 3, 4, 5\nACTIONS = (UP, DOWN, LEFT, RIGHT, USE)\nDIRS = {UP: (-1, 0), DOWN: (1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\nACTION_NAME = {UP: \"UP\", DOWN: \"DOWN\", LEFT: \"LEFT\", RIGHT: \"RIGHT\", USE: \"USE\"}\n\n\n@dataclass(frozen=True)\nclass Blob:\n    color: int\n    bbox: Tuple[int, int, int, int]  # r0, c0, r1, c1 inclusive\n    area: int\n    centroid: Tuple[float, float]\n\n    @property\n    def top_left(self):\n        return self.bbox[0], self.bbox[1]\n\n    @property\n    def size(self):\n        r0, c0, r1, c1 = self.bbox\n        return r1 - r0 + 1, c1 - c0 + 1\n\n\ndef arr(frame) -> np.ndarray:\n    return np.asarray(frame)\n\n\ndef color_counts(frame) -> Dict[int, int]:\n    vals, cnts = np.unique(arr(frame), return_counts=True)\n    return {int(v): int(c) for v, c in zip(vals, cnts)}\ndef frame_delta(before, after) -> dict:\n    a, b = arr(before), arr(after)\n    ys, xs = np.where(a != b)\n    if len(ys) == 0:\n        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n    return {\n        \"count\": int(len(ys)),\n        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n        \"samples\": samples,\n    }\n\n\ndef normalize_public_action(action):\n    \"\"\"Validate one public key or coordinate action without touching ``env``.\"\"\"\n    if isinstance(action, (list, tuple)):\n        if (\n            len(action) != 3\n            or action[0] != 6\n            or any(\n                not isinstance(value, int) or isinstance(value, bool)\n                for value in action\n            )\n        ):\n            raise ValueError(\n                \"coordinate action must be (6, x, y) with integer x,y in 0..63\"\n            )\n        normalized = (6, int(action[1]), int(action[2]))\n        if not (0 <= normalized[1] < 64 and 0 <= normalized[2] < 64):\n            raise ValueError(\n                \"coordinate action must be (6, x, y) with integer x,y in 0..63\"\n            )\n        return normalized\n    if (\n        not isinstance(action, int)\n        or isinstance(action, bool)\n        or action not in range(1, 8)\n    ):\n        raise ValueError(\"key action must be an integer in 1..7\")\n    if action == 6:\n        raise ValueError(\n            \"bare ACTION6 is invalid; use (6, x, y) with integer x,y in 0..63\"\n        )\n    return int(action)\n\n\ndef safe_step(env, action):\n    \"\"\"Validate locally, then apply one public key or coordinate action.\"\"\"\n    normalized = normalize_public_action(action)\n    if isinstance(normalized, tuple):\n        env.step(*normalized)\n    else:\n        env.step(normalized)\n    return normalized\n\n\ndef action_deltas(env, actions=None) -> Dict[object, dict]:\n    \"\"\"Compare valid cloned actions; bare ACTION6 is never sent to the arena.\"\"\"\n    if actions is None:\n        actions = tuple(action for action in env.actions if action != 6)\n    normalized_actions = tuple(\n        normalize_public_action(action) for action in actions\n    )\n    base = arr(env.frame()).copy()\n    out = {}\n    for action in normalized_actions:\n        clone = env.clone()\n        safe_step(clone, action)\n        out[action] = frame_delta(base, clone.frame())\n    return out\n\n\ndef replay(env, actions: Sequence):\n    normalized_actions = tuple(\n        normalize_public_action(action) for action in actions\n    )\n    clone = env.clone()\n    for action in normalized_actions:\n        if clone.terminal():\n            break\n        safe_step(clone, action)\n    return clone\n\n\ndef path_result(env, actions: Sequence[int]) -> dict:\n    clone = replay(env, actions)\n    return {\n        \"levels_completed\": int(clone.levels_completed),\n        \"terminal\": bool(clone.terminal()),\n        \"path_len\": len(actions),\n        \"colors\": color_counts(clone.frame()),\n        \"objects\": object_candidates(clone.frame()),\n    }\n","exit_code":0,"status":"completed"}}
