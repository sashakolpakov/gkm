{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_level3.py <<'PY'\nimport json\nimport gkm_try as h\nfrom perception import connected_components, color_counts, action_deltas, safe_step, arr, replay\n\ndef state(e):\n    bs=connected_components(e.frame(),colors=(11,12,14))\n    return [(b.color,(b.bbox[1]+b.size[1]//2,b.bbox[0]+b.size[0]//2),b.area) for b in bs]\ndef inspect(env):\n    for a in json.load(open('checkpoint.json'))['final_path']: env.step(a)\n    print('ENTRY',state(env))\n    f=arr(env.frame()); chars={0:' ',1:'.',5:'#',9:'X',10:' ',11:'C',12:'o',14:'P'}\n    for y in range(4,61,3): print(y,''.join(chars[int(f[y,x])] for x in range(4,64,3)))\n    for path in ([3],[4],[3,3],[4,4],[3,1],[3,2],[(6,14,14)],[(6,14,14),(6,14,26)],[(6,38,50),3],[(6,44,14),3]):\n        c=replay(env,path); print('PATH',path,'STATE',state(c),'level',c.levels_completed)\nprint(h.A.run_program('lf52',inspect)[::2])\nPY\npython probe_level3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
