{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\np='legs.py';s=open(p).read().replace('def collect_ordered_chain(env):','def collect_ordered_chain(env, clearance=None):');s=s.replace('        while board_blocks(colors[0])[0].bbox[1] > head.bbox[3] + 2:', '        if clearance is not None:\\\\n            clearance(trial)\\\\n            head = min(\\\\n                [b for b in connected_components(trial.frame(), colors=[6], min_area=12)\\\\n                 if b.size == (6, 6)], key=lambda b: b.bbox[0])\\\\n        while board_blocks(colors[0])[0].bbox[1] > head.bbox[3] + 2:')\n# Callback moves must enter outer planned path: use recording wrapper? instead callback returns actions and apply through step\ns=s.replace('            clearance(trial)','            for action in clearance(trial):\\\\n                step(action)')\ns+='''\\\\n\\\\ndef clear_chain_guide(env):\n    \\\"\\\"\\\"Find a short vertical escape from a guide that prevents chain pulling.\n\n    Return a clone-verified path, preserving the filled order prefix. A pull\n    must shift the first carried block left without releasing an order marker.\n    \\\"\\\"\\\"\n    from collections import deque\n\n    blobs = connected_components(env.frame(), min_area=12)\n    heads = sorted([b for b in blobs if b.color == 6 and b.size == (6, 6)],\n                   key=lambda b: b.bbox[0])\n    strip = heads[-1]\n    markers = sorted([b for b in blobs if b.area == 16\n                      and b.bbox[0] <= strip.centroid[0] <= b.bbox[2]\n                      and b.bbox[1] > strip.bbox[3]], key=lambda b: b.bbox[1])\n    # Filled markers are hollow and therefore absent from the area-16 list.\n    f = arr(env.frame())\n    strip_y = int(strip.centroid[0])\n    filled = [(strip_y, x) for x in range(strip.bbox[3] + 3, 63, 6)\n              if int(f[strip_y, x]) == 0]\n    first = min([b for b in blobs if b.area == 16\n                 and b.bbox[2] < strip.bbox[0]], key=lambda b: b.bbox[1])\n    if first.bbox[1] <= heads[0].bbox[3] + 2:\n        return []\n\n    def pullable(state):\n        test = state.clone()\n        safe_step(test, 3)\n        frame = arr(test.frame())\n        blocks = [b for b in connected_components(frame, colors=[first.color], min_area=12)\n                  if b.area == 16 and b.bbox[2] < strip.bbox[0]]\n        return (blocks and blocks[0].bbox[1] < first.bbox[1]\n                and all(int(frame[y, x]) == 0 for y, x in filled))\n\n    queue = deque([(env.clone(), [])])\n    seen = set()\n    while queue and len(seen) < 40:\n        state, path = queue.popleft()\n        key = arr(state.frame()).tobytes()\n        if key in seen:\n            continue\n        seen.add(key)\n        if pullable(state):\n            return path\n        if len(path) >= 8:\n            continue\n        for action in (1, 2):\n            child = state.clone()\n            safe_step(child, action)\n            queue.append((child, path + [action]))\n    raise RuntimeError('No vertical guide escape preserves the carried chain')\n''';open(p,'w').write(s)\np='players.py';s=open(p).read().replace('from legs import collect_ordered_chain, stage_chain_blockers','from legs import collect_ordered_chain, stage_chain_blockers, clear_chain_guide');s+='\\\\n\\\\ndef play_level_3(env):\\\\n    collect_ordered_chain(env, clearance=clear_chain_guide)\\\\n';open(p,'w').write(s)\nPY\npython gkm_try.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
