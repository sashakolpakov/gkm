{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cat > probe8.py <<'PY'\nimport json\nimport gkm_try as H\nfrom perception import connected_components, safe_step, arr\n\ndef sym(e):\n f=arr(e.frame());bs=connected_components(f)\n print('level',e.levels_completed,'heads',[(b.color,b.bbox) for b in bs if b.color in (6,15) and b.bbox[0]<50], 'cargo',[(b.color,b.bbox[:2]) for b in bs if b.area==16])\n print('board',[(b.bbox,b.area) for b in bs if b.color==4])\n print('rows', [''.join(format(int(f[y,x]),'x') for x in range(8,57,6)) for y in range(5,48,6)])\n\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']:e.step(a)\n sym(e)\n for seq in [[4]*8,[4]*8+[3]*8,[(6,32,5),2],[(6,32,5),3],[(6,32,5),4],[(6,32,5),7]]:\n  c=e.clone()\n  for a in seq:safe_step(c,a)\n  print('seq',seq);sym(c)\nH.A.run_program('sk48',probe)\nPY\npython probe8.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
