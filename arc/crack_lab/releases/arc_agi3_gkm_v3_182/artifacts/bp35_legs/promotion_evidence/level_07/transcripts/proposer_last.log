{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"cat >> legs.py <<'PY'\n\n\ndef navigate_scrolling_gravity_maze(env, max_moves=180, origin=(3, 3), cell=6, cols=10):\n    \\\"\\\"\\\"Map overlapping camera views and route through reversible gravity mazes.\n\n    Retain observed supports across scrolling. Search for the visible exit,\n    otherwise reveal an unmapped frontier. Equivalent remote reversals are\n    consumed in order; defer toggles until approaching their column. Verify\n    each departure on a clone, incorporating even a fatal preview's scenery.\n    \\\"\\\"\\\"\n    from collections import deque\n    ox, initial_oy = origin\n    base = env.levels_completed\n    world = {}\n    camera = 0\n    previous = None\n    gravity = -1\n    forbidden = set()\n\n    def observe(e, update_camera=True):\n        nonlocal camera, previous\n        f = arr(e.frame())\n        avatars = connected_components(f, colors=[9])\n        if avatars:\n            cy,cx=avatars[0].centroid\n            oy=initial_oy+((round(cy+.5)-initial_oy)%cell)\n        else:\n            # Infer the row phase from the repeating grid at the left wall.\n            oy = max(range(cell), key=lambda y: sum(\n                int(f[r,ox]) == 8 for r in range(y,63,cell)))\n            cy=cx=None\n        rows=[]\n        solids={}\n        for iy,py in enumerate(range(oy,63,cell)):\n            row=[]\n            for x in range(cols):\n                px=ox+x*cell\n                t=int(f[py,px])\n                row.append(10 if t==9 else t)\n                if t==12:\n                    solids[iy,x]=int((f[max(0,py-2):py+3,max(0,px-2):px+3]==12).sum())>=10\n            rows.append(row)\n        offset=camera\n        if previous is not None:\n            old_offset,old_rows=previous\n            candidates=[]\n            for shift in range(-12,13):\n                same=bad=0\n                for y,row in enumerate(rows):\n                    gy=old_offset+shift+y\n                    for x in range(1,cols):\n                        prior=world.get((gy,x))\n                        if prior is None:continue\n                        old=prior[0];new=row[x]\n                        if old==new:same+=1\n                        elif old in (9,10) and new in (9,10):same+=1\n                        else:bad+=1\n                if same>=12:candidates.append((same-8*bad-abs(shift)*.05,old_offset+shift))\n            if candidates:offset=max(candidates)[1]\n        for y,row in enumerate(rows):\n            for x,t in enumerate(row):\n                world[offset+y,x]=(t,solids.get((y,x),False))\n        if update_camera:\n            camera=offset\n            previous=(offset,rows)\n        if cy is None:return None,oy\n        return (offset+round((cy-oy)/cell),round((cx-ox)/cell)),oy\n\n    for move in range(max_moves):\n        if env.terminal() or env.levels_completed>base:return\n        start,oy=observe(env)\n        if start is None:return\n        removable={p:i for i,(p,(t,s)) in enumerate(world.items()) if t in (8,14)}\n        toggles={p:(len(removable)+i,s) for i,(p,(t,s)) in enumerate((v for v in world.items() if v[1][0]==12))}\n        def tile(y,x,mask):\n            p=(y,x)\n            if p in toggles:\n                bit,solid=toggles[p]\n                return 5 if solid \"'^ bool(mask&(1<<bit)) else 10\n            if p in removable and mask&(1<<removable[p]):return 10\n            return world.get(p,(None,False))[0]\n        q=deque([(start[0],start[1],gravity,0,[])])\n        seen={(start[0],start[1],gravity,0)}\n        frontier_path=None\n        chosen=None\n        while q and len(seen)<250000:\n            y,x,g,mask,path=q.popleft()\n            if path and tile(y,x,mask)==7:\n                chosen=path;break\n            if tile(y,x,mask) is None:\n                if frontier_path is None:frontier_path=path\n                continue\n            options=[]\n            for dx,a in [(-1,3),(1,4)]:\n                nx=x+dx\n                if 0<=nx<cols and tile(y,nx,mask) not in (5,8,14,15):\n                    options.append((y,nx,g,mask,a))\n            offered=False\n            # Only currently visible switches can be clicked.\n            for (ty,tx),bit in sorted(removable.items()):\n                if mask&(1<<bit) or not camera<=ty<camera+len(previous[1]):continue\n                t=tile(ty,tx,mask)\n                if t==8:\n                    if offered:continue\n                    offered=True\n                options.append((y,x,-g if t==8 else g,mask|(1<<bit),(6,ox+tx*cell,oy+(ty-camera)*cell)))\n            for (ty,tx),(bit,solid) in toggles.items():\n                if abs(tx-x)<=1 and (ty,tx)!=(y,x) and camera<=ty<camera+len(previous[1]):\n                    options.append((y,x,g,mask''^(1<<bit),(6,ox+tx*cell,oy+(ty-camera)*cell)))\n            for ny,nx,ng,nmask,a in options:\n                while tile(ny+ng,nx,nmask) not in (5,8,14):\n                    ny+=ng\n                    if tile(ny,nx,nmask) in (None,7,15):break\n                state=ny,nx,ng,nmask\n                if tile(ny,nx,nmask)==15 or state in seen:continue\n                if (start,gravity,a) in forbidden and not path:continue\n                seen.add(state);q.append((ny,nx,ng,nmask,path+[a]))\n        path=chosen or frontier_path\n        if not path:return\n        action=path[0]\n        check=env.clone();safe_step(check,action)\n        if check.terminal() and check.levels_completed<=base:\n            forbidden.add((start,gravity,action))\n            observe(check,False)\n            continue\n        if isinstance(action,tuple):\n            p=(camera+round((action[2]-oy)/cell),round((action[1]-ox)/cell))\n            if world.get(p,(None,False))[0]==8:gravity=-gravity\n        safe_step(env,action)\nPY\npython - <<'\"'PY'\np='probe_level7.py';s=open(p).read().replace('from legs import ascend_with_ceiling_hazards, navigate_consumable_gravity_switches','from legs import ascend_with_ceiling_hazards, navigate_consumable_gravity_switches, navigate_scrolling_gravity_maze');s=s.replace(\\\"[('gravity',navigate_consumable_gravity_switches)]\\\",\\\"[('mapped',navigate_scrolling_gravity_maze)]\\\");s=s.replace('max_moves=60,origin=(3,3),shape=(10,10),toggle_color=12,local_interactions=True,frontier=\\\"up\\\"','max_moves=120');open(p,'w').write(s)\nPY\npython probe_level7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
