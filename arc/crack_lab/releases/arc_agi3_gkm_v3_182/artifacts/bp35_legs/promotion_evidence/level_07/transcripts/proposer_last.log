{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\np='legs.py';s=open(p).read();s=s.replace('    from collections import deque\\\\n    ox, initial_oy = origin','    from collections import deque\\\\n    import heapq\\\\n    ox, initial_oy = origin')\ns=s.replace('''        q=deque([(start[0],start[1],gravity,0,[])])\n        seen={(start[0],start[1],gravity,0)}''','''        targets=[p for p,(t,s) in world.items() if t==7]\n        distances={p:0 for p in targets}\n        unknown=set()\n        for y,x in world:\n            for dy,dx in [(-1,0),(1,0),(0,-1),(0,1)]:\n                p=y+dy,x+dx\n                if 0<=p[1]<cols and p not in world:unknown.add(p)\n        for p in unknown:distances[p]=12 if targets else 0\n        hd=[(d,p) for p,d in distances.items()];heapq.heapify(hd)\n        while hd:\n            d,p=heapq.heappop(hd)\n            if d\"'!=distances[p]:continue\n            y,x=p\n            for dy,dx in [(-1,0),(1,0),(0,-1),(0,1)]:\n                np=y+dy,x+dx\n                if np not in world or world[np][0] in (5,15):continue\n                nd=d+(.2 if dy else 1)\n                if nd<distances.get(np,1e9):\n                    distances[np]=nd;heapq.heappush(hd,(nd,np))\n        serial=0\n        q=[(0,serial,start[0],start[1],gravity,0,[])]\n        seen={(start[0],start[1],gravity,0)}'\"''')\ns=s.replace('''            y,x,g,mask,path=q.popleft()\n            if path and tile(y,x,mask)==7:\n                chosen=path;break\n            if tile(y,x,mask) is None:\n                if frontier_path is None:frontier_path=path\n                continue''','''            _,_,y,x,g,mask,path=heapq.heappop(q)\n            if path and tile(y,x,mask) in (7,None):\n                chosen=path;break''')\ns=s.replace('''                seen.add(state);q.append((ny,nx,ng,nmask,path+[a]))''','''                seen.add(state)\n                serial+=1\n                npath=path+[a