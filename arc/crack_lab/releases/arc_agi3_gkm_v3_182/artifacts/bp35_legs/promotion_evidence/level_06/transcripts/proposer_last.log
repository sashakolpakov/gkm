{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_search.py <<'PY'\nimport json,time\nfrom collections import deque\nimport gkm_try as H\nfrom perception import arr,safe_step\n\ndef run(e):\n for a in json.load(open('checkpoint.json'))['final_path']:e.step(a)\n q=deque([(e.clone(),[])]);seen=set();n=0;t=time.monotonic();best=0\n while q and n<12000:\n  c,path=q.popleft();f=arr(c.frame())\n  actions=[3,4]+[(6,x,y) for y in range(3,58,6) for x in range(15,52,6) if int(f[y,x]) in (8,12,14)]\n  for a in actions:\n   d=c.clone();safe_step(d,a);n+=1\n   if d.levels_completed>=6:\n    print('FOUND',n,path+[a],flush=True);json.dump(path+[a],open('level6_search_candidate.json','w'));return\n   if d.terminal():continue\n   z=arr(d.frame()).copy();z[63,:]=0;z[z==11]=9\n   key=z.tobytes()\n   if key in seen:continue\n   seen.add(key);q.append((d,path+[a]))\n  if n//500>best:\n   best=n//500;print('SEARCH',n,len(seen),len(q),len(path),round(time.monotonic()-t,1),flush=True)\n  delay=n/250-(time.monotonic()-t)\n  if delay>0:time.sleep(min(delay,.05))\n print('STOP',n,len(seen),len(q),flush=True)\nH.A.run_program('bp35',run)\nPY\npython probe_search.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
