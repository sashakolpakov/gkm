{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_frontier.py <<'PY'\nimport json\nimport gkm_try as H\nfrom perception import arr, connected_components, safe_step\nCH={5:'#',10:'.',9:'@',8:'S',12:'T',14:'Y',15:'\"'!'\"',7:'E'}\ndef summary(e):\n f=arr(e.frame()); av=connected_components(f,colors=[9]); return (e.levels_completed,e.terminal(),[(b.centroid) for b in av],[(b.color,b.area) for b in connected_components(f,colors=[8,12,14,7]) if b.area>3])\ndef board(e):\n f=arr(e.frame()); print('\\\\n'.join(''.join(CH.get(int(f[y,x]),'?') for x in range(15,52,6)) for y in range(3,58,6)))\ndef run(e):\n for a in json.load(open('checkpoint.json'))['final_path']: e.step(a)\n print('ENTRY'); board(e)\n for path in [[(6,15,21)],[(6,39,51)],[(6,39,33)], [4,4,4],[(6,39,33),4,4,4],[(6,39,33),(6,39,51)],[(6,15,21),(6,39,33)]]:\n  c=e.clone()\n  for a in path:\n   safe_step(c,a)\n   if c.terminal(): break\n  print('PATH',path,summary(c)); board(c)\nH.A.run_program('bp35',run)\nPY\npython probe_frontier.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
