{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_search.py <<'PY'\nimport json,time\nfrom collections import deque\nimport gkm_try as h\nfrom perception import arr,connected_components,safe_step\n\ndef key(e):return arr(e.frame())[:63,12:55].tobytes()\ndef options(e):\n f=arr(e.frame());out=[3,4]\n for b in connected_components(f,colors=[8,14]):\n  y,x=b.centroid\n  if b.area>=8:out.append((6,round(x),round(y)))\n return out\n\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']:e.step(a)\n start=time.monotonic();q=deque([(e.clone(),[])]);seen={key(e)};n=0;steps=0\n while q and n<10000:\n  c,p=q.popleft();n+=1\n  for a in options(c):\n   d=c.clone();safe_step(d,a);steps+=1\n   if d.levels_completed>3:\n    json.dump(p+[a],open('level4_clone_candidate.json','w'));print('WIN',n,len(p)+1,p+[a],flush=True);return\n   if d.terminal():continue\n   k=key(d)\n   if k not in seen:seen.add(k);q.append((d,p+[a]))\n  if n%100==0:\n   time.sleep(max(0,steps/250-(time.monotonic()-start)))\n  if n%500==0:print('SEARCH',n,'queue',len(q),'depth',len(p),'steps',steps,flush=True)\n print('STOP',n,len(q))\nh.A.run_program('bp35',probe)\nPY\npython probe_search.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
