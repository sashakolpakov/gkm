{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_level4.py <<'PY'\nimport json\nimport gkm_try as harness\nfrom perception import arr, object_candidates, action_deltas, safe_step\n\ndef symbolic(e):\n f=arr(e.frame())\n return {'level':e.levels_completed,'terminal':e.terminal(),'objects':object_candidates(f,min_area=4),'tiles':[''.join(format(int(f[3+y*6,15+x*6]),'x') for x in range(7)) for y in range(10)]}\n\ndef probe(env):\n for a in json.load(open('checkpoint.json'))['final_path']: env.step(a)\n print('ACTIONS',env.actions)\n print('ENTRY',symbolic(env))\n for a,d in action_deltas(env).items():\n  c=env.clone();safe_step(c,a)\n  print('KEY',a,'delta',d['count'],'state',symbolic(c))\n for a in [(6,33,57),(6,33,51),(6,15,3)]:\n  c=env.clone();safe_step(c,a);print('CLICK',a,symbolic(c))\nharness.A.run_program('bp35',probe)\nPY\npython probe_level4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
