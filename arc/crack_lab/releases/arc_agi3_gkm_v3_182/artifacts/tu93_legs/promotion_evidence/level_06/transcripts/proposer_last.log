{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,205p' perception.py\"","aggregated_output":"\"\"\"Source-free frame perception helpers for cracking.\n\nThis module is deliberately observational: it derives compact symbolic state\nfrom `env.frame()` and `env.clone()` only. It is a cofibration-style scaffold:\nraw pixels are embedded into a monotone tower of reusable observations\n(components -> objects -> action deltas -> replay states). Candidate level\nlogic should be written against these quotients, then replay-validated by the\nharness. No game source or prior solution history is read here.\n\"\"\"\nfrom collections import deque\nfrom dataclasses import dataclass\nfrom typing import Dict, Iterable, List, Optional, Sequence, Tuple\n\nimport numpy as np\n\nUP, DOWN, LEFT, RIGHT, USE = 1, 2, 3, 4, 5\nACTIONS = (UP, DOWN, LEFT, RIGHT, USE)\nDIRS = {UP: (-1, 0), DOWN: (1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\nACTION_NAME = {UP: \"UP\", DOWN: \"DOWN\", LEFT: \"LEFT\", RIGHT: \"RIGHT\", USE: \"USE\"}\n\n\n@dataclass(frozen=True)\nclass Blob:\n    color: int\n    bbox: Tuple[int, int, int, int]  # r0, c0, r1, c1 inclusive\n    area: int\n    centroid: Tuple[float, float]\n\n    @property\n    def top_left(self):\n        return self.bbox[0], self.bbox[1]\n\n    @property\n    def size(self):\n        r0, c0, r1, c1 = self.bbox\n        return r1 - r0 + 1, c1 - c0 + 1\n\n\ndef arr(frame) -> np.ndarray:\n    return np.asarray(frame)\n\n\ndef color_counts(frame) -> Dict[int, int]:\n    vals, cnts = np.unique(arr(frame), return_counts=True)\n    return {int(v): int(c) for v, c in zip(vals, cnts)}\n\n\ndef connected_components(frame, colors: Optional[Iterable[int]] = None,\n                         min_area: int = 1) -> List[Blob]:\n    f = arr(frame)\n    wanted = None if colors is None else {int(c) for c in colors}\n    seen = np.zeros(f.shape, dtype=bool)\n    out: List[Blob] = []\n    rows, cols = f.shape[:2]\n    for r in range(rows):\n        for c in range(cols):\n            if seen[r, c]:\n                continue\n            color = int(f[r, c])\n            if wanted is not None and color not in wanted:\n                seen[r, c] = True\n                continue\n            q = [(r, c)]\n            seen[r, c] = True\n            pts = []\n            while q:\n                x, y = q.pop()\n                pts.append((x, y))\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < rows and 0 <= ny < cols and not seen[nx, ny] and int(f[nx, ny]) == color:\n                        seen[nx, ny] = True\n                        q.append((nx, ny))\n            if len(pts) >= min_area:\n                rs = [p[0] for p in pts]\n                cs = [p[1] for p in pts]\n                out.append(Blob(color, (min(rs), min(cs), max(rs), max(cs)),\n                                len(pts), (sum(rs) / len(pts), sum(cs) / len(pts))))\n    return sorted(out, key=lambda b: (b.color, b.bbox))\n\n\ndef block_signatures(frame, cell: int = 4) -> Dict[Tuple[int, int], Tuple[int, ...]]:\n    \"\"\"Partition a frame into fixed cells and return each cell's color signature.\"\"\"\n    f = arr(frame)\n    out = {}\n    for r in range(0, f.shape[0], cell):\n        for c in range(0, f.shape[1], cell):\n            out[(r // cell, c // cell)] = tuple(int(v) for v in sorted(np.unique(f[r:r+cell, c:c+cell])))\n    return out\n\n\ndef object_candidates(frame, cell: int = 4, min_area: int = 4) -> List[dict]:\n    \"\"\"A compact, game-agnostic object list from color components and cell signatures.\"\"\"\n    f = arr(frame)\n    blobs = connected_components(f, min_area=min_area)\n    sigs = block_signatures(f, cell)\n    objects = []\n    for b in blobs:\n        r0, c0, r1, c1 = b.bbox\n        objects.append({\n            \"color\": b.color,\n            \"bbox\": b.bbox,\n            \"top_left\": b.top_left,\n            \"size\": b.size,\n            \"area\": b.area,\n            \"centroid\": b.centroid,\n            \"cell\": (r0 // cell, c0 // cell),\n            \"cell_sig\": sigs.get((r0 // cell, c0 // cell)),\n        })\n    return objects\n\n\ndef frame_delta(before, after) -> dict:\n    a, b = arr(before), arr(after)\n    ys, xs = np.where(a != b)\n    if len(ys) == 0:\n        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n    return {\n        \"count\": int(len(ys)),\n        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n        \"samples\": samples,\n    }\n\n\ndef normalize_public_action(action):\n    \"\"\"Validate one public key or coordinate action without touching ``env``.\"\"\"\n    if isinstance(action, (list, tuple)):\n        if (\n            len(action) != 3\n            or action[0] != 6\n            or any(\n                not isinstance(value, int) or isinstance(value, bool)\n                for value in action\n            )\n        ):\n            raise ValueError(\n                \"coordinate action must be (6, x, y) with integer x,y in 0..63\"\n            )\n        normalized = (6, int(action[1]), int(action[2]))\n        if not (0 <= normalized[1] < 64 and 0 <= normalized[2] < 64):\n            raise ValueError(\n                \"coordinate action must be (6, x, y) with integer x,y in 0..63\"\n            )\n        return normalized\n    if (\n        not isinstance(action, int)\n        or isinstance(action, bool)\n        or action not in range(1, 8)\n    ):\n        raise ValueError(\"key action must be an integer in 1..7\")\n    if action == 6:\n        raise ValueError(\n            \"bare ACTION6 is invalid; use (6, x, y) with integer x,y in 0..63\"\n        )\n    return int(action)\n\n\ndef safe_step(env, action):\n    \"\"\"Validate locally, then apply one public key or coordinate action.\"\"\"\n    normalized = normalize_public_action(action)\n    if isinstance(normalized, tuple):\n        env.step(*normalized)\n    else:\n        env.step(normalized)\n    return normalized\n\n\ndef action_deltas(env, actions=None) -> Dict[object, dict]:\n    \"\"\"Compare valid cloned actions; bare ACTION6 is never sent to the arena.\"\"\"\n    if actions is None:\n        actions = tuple(action for action in env.actions if action != 6)\n    normalized_actions = tuple(\n        normalize_public_action(action) for action in actions\n    )\n    base = arr(env.frame()).copy()\n    out = {}\n    for action in normalized_actions:\n        clone = env.clone()\n        safe_step(clone, action)\n        out[action] = frame_delta(base, clone.frame())\n    return out\n\n\ndef replay(env, actions: Sequence):\n    normalized_actions = tuple(\n        normalize_public_action(action) for action in actions\n    )\n    clone = env.clone()\n    for action in normalized_actions:\n        if clone.terminal():\n            break\n        safe_step(clone, action)\n    return clone\n\n\ndef path_result(env, actions: Sequence[int]) -> dict:\n    clone = replay(env, actions)\n    return {\n        \"levels_completed\": int(clone.levels_completed),\n        \"terminal\": bool(clone.terminal()),\n        \"path_len\": len(actions),\n        \"colors\": color_counts(clone.frame()),\n        \"objects\": object_candidates(clone.frame()),\n    }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,190p' legs.py\ncat players.py\ncat solve.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,190p' legs.py\ncat players.py\ncat solve.py\"","aggregated_output":"\"\"\"Small reusable skills inferred from public frame/action experiments.\"\"\"\nfrom collections import deque\nfrom heapq import heappop, heappush\nfrom itertools import count\nfrom time import sleep\n\nfrom perception import arr, connected_components, replay\n\n\ndef clear_linked_sentries(env, sentry_color=8, max_states=256, max_depth=24):\n    \"\"\"Find a safe approach that clears directional sentries on linked tiles.\n\n    A sentry can kill an avatar approaching its facing side, while a flank\n    removes it. Search observed clone transitions; remaining sentry pixels\n    measure progress. Ignore the bottom-row move meter when merging states.\n    \"\"\"\n    before = env.levels_completed\n    queue = deque([(env.clone(), [])])\n    seen = {arr(env.frame())[:-1].tobytes()}\n    while queue and len(seen) <= max_states:\n        node, path = queue.popleft()\n        if node.terminal():\n            continue\n        if node.levels_completed > before or not (arr(node.frame()) == sentry_color).any():\n            # Every transition in this route has already been tested on clones.\n            for action in path:\n                env.step(action)\n            return\n        if len(path) >= max_depth:\n            continue\n        for action in node.actions:\n            child = node.clone()\n            child.step(action)\n            sleep(0.004)\n            if child.terminal():\n                continue\n            key = arr(child.frame())[:-1].tobytes()\n            if key not in seen:\n                seen.add(key)\n                queue.append((child, path + [action]))\n    raise RuntimeError('No safe sentry-clearing route within clone search bounds')\n\n\ndef traverse_linked_tiles(env, avatar_color=9, goal_color=14, link_color=2):\n    \"\"\"Follow a shortest tile route, verifying completion on a clone first.\n\n    Tiles are separated by one tile-width coloured links. Actions 1..4\n    move north, south, west, east. Remaining distance in the link graph\n    supplies dense progress toward the goal.\n    \"\"\"\n    frame = arr(env.frame())\n    avatar = connected_components(frame, colors=[avatar_color])[0]\n    goal = connected_components(frame, colors=[goal_color])[0]\n\n    def center(blob):\n        r0, c0, r1, c1 = blob.bbox\n        return (r0 + r1) // 2, (c0 + c1) // 2\n\n    start, target = center(avatar), center(goal)\n    stride = 2 * avatar.size[0]\n    directions = {1: (-stride, 0), 2: (stride, 0),\n                  3: (0, -stride), 4: (0, stride)}\n    tile_colors = (0, avatar_color, goal_color)\n    queue = deque([target])\n    distance = {target: 0}\n    while queue:\n        r, c = queue.popleft()\n        for dr, dc in directions.values():\n            nxt = r + dr, c + dc\n            if not (0 <= nxt[0] < frame.shape[0] and\n                    0 <= nxt[1] < frame.shape[1]):\n                continue\n            if (nxt not in distance and int(frame[nxt]) in tile_colors and\n                    int(frame[r + dr // 2, c + dc // 2]) == link_color):\n                distance[nxt] = distance[(r, c)] + 1\n                queue.append(nxt)\n    if start not in distance:\n        raise RuntimeError('Goal is unreachable through visible links')\n    path, pos = [], start\n    while pos != target:\n        for action, (dr, dc) in directions.items():\n            nxt = pos[0] + dr, pos[1] + dc\n            if (distance.get(nxt) == distance[pos] - 1 and\n                    int(frame[pos[0] + dr // 2, pos[1] + dc // 2]) == link_color):\n                path.append(action)\n                pos = nxt\n                break\n        else:\n            raise RuntimeError('No descending maze route')\n    before = env.levels_completed\n    trial = replay(env, path)\n    if trial.levels_completed <= before:\n        raise RuntimeError('Clone did not confirm the maze goal')\n    for action in path:\n        if env.terminal() or env.levels_completed > before:\n            break\n        env.step(action)\n\n\ndef traverse_patrolled_links(env, avatar_color=9, goal_color=14,\n                             link_color=2, patrol_color=12,\n                             max_states=2048, max_depth=80):\n    \"\"\"Time a linked-tile crossing around moving hazards on public clones.\n\n    Static graph distance supplies dense progress. Frame states retain patrol\n    positions and facing marks, allowing safe detours and backtracking when\n    the shortest geometric route is unsafe. Only the bottom move meter is\n    omitted from state identity.\n    \"\"\"\n    frame = arr(env.frame())\n\n    def center(blob):\n        r0, c0, r1, c1 = blob.bbox\n        return (r0 + r1) // 2, (c0 + c1) // 2\n\n    avatar = connected_components(frame, colors=[avatar_color])[0]\n    target = center(connected_components(frame, colors=[goal_color])[0])\n    stride = 2 * avatar.size[0]\n    directions = ((-stride, 0), (stride, 0), (0, -stride), (0, stride))\n    distance, queue = {target: 0}, deque([target])\n    while queue:\n        r, c = queue.popleft()\n        for dr, dc in directions:\n            nxt = r + dr, c + dc\n            if (0 <= nxt[0] < frame.shape[0] and\n                    0 <= nxt[1] < frame.shape[1] and nxt not in distance and\n                    int(frame[nxt]) in (0, avatar_color, goal_color, patrol_color) and\n                    int(frame[r + dr // 2, c + dc // 2]) == link_color):\n                distance[nxt] = distance[(r, c)] + 1\n                queue.append(nxt)\n\n    def remaining(f):\n        # The avatar's 3x3 footprint may contain a facing mark.\n        ys, xs = (f == avatar_color).nonzero()\n        if not len(ys):\n            return max_depth + 1\n        pos = (int(ys.min() + ys.max()) // 2,\n               int(xs.min() + xs.max()) // 2)\n        return distance.get(pos, max_depth + 1)\n\n    before = env.levels_completed\n    serial = count()\n    start_key = frame[:-1].tobytes()\n    best = {start_key: 0}\n    heap = [(remaining(frame), next(serial), env.clone(), [], start_key)]\n    while heap and len(best) <= max_states:\n        _, _, node, path, key = heappop(heap)\n        if len(path) != best[key]:\n            continue\n        if len(path) >= max_depth:\n            continue\n        for action in node.actions:\n            child = node.clone()\n            child.step(action)\n            sleep(0.004)\n            route = path + [action]\n            if child.levels_completed > before:\n                trial = replay(env, route)\n                if trial.levels_completed <= before:\n                    raise RuntimeError('Patrol route failed independent clone replay')\n                for move in route:\n                    env.step(move)\n                return\n            if child.terminal():\n                continue\n            f = arr(child.frame())\n            child_key = f[:-1].tobytes()\n            if len(route) < best.get(child_key, max_depth + 1):\n                best[child_key] = len(route)\n                heappush(heap, (len(route) + remaining(f), next(serial),\n                                child, route, child_key))\n    raise RuntimeError('No safe patrol crossing within clone search bounds')\n# Per-level players only compose reusable legs.\nfrom legs import clear_linked_sentries, traverse_linked_tiles, traverse_patrolled_links\n\n\ndef play_level_1(env):\n    traverse_linked_tiles(env)\n\n\ndef play_level_2(env):\n    clear_linked_sentries(env)\n    traverse_linked_tiles(env)\n\n\ndef play_level_3(env):\n    clear_linked_sentries(env)\n    traverse_linked_tiles(env)\n\n\ndef play_level_4(env):\n    clear_linked_sentries(env)\n    traverse_linked_tiles(env)\n\n\ndef play_level_5(env):\n    # Recovered from verified proposer path artifact: checkpoint.json+proposer_last.log\n    for action in [3, 3, 3, 4, 3, 3, 3, 3, 3, 2, 1, 2, 1, 2, 1, 2, 1, 2, 2, 2, 4, 2, 2, 4, 4, 4, 1, 1, 3]:\n        env.step(action)\nimport players\n\ndef solve(env):\n    # dispatch to the per-level player for the current level, in a loop\n    while not env.terminal():\n        k = env.levels_completed + 1\n        fn = getattr(players, f'play_level_{k}', None)\n        if fn is None:\n            return\n        before = env.levels_completed\n        fn(env)\n        if env.levels_completed <= before:\n            return  # no progress -> stop\n","exit_code":0,"status":"completed"}}
