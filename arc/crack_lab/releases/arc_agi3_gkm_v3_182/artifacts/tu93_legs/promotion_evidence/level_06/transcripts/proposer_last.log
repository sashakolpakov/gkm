{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_mechanics6.py <<'PY'\nfrom probe_level6 import setup, A, arr\nfrom perception import connected_components\nfrom time import sleep\n\ndef symbol(e):\n f=arr(e.frame());out=[]\n for color in (9,8,12,14):\n  for b in connected_components(f,colors=[color]):\n   if b.area<4:continue\n   r,c,rr,cc=b.bbox\n   marks=[(y-r-1,x-c-1,int(f[y,x])) for y in range(r,rr+1) for x in range(c,cc+1) if f[y,x]\"'!=color]\n   out.append((color,((r-12)//6,(c-12)//6),marks))\n return out\n\ndef probe(env):\n setup(env)\n for path in ([3],[3,3],[3,3,3],[3,3,3,3],[3,3,3,3,3],[3,3,3,3,3,3],[3,2],[3,3,2],[3,3,2,2],[3,3,2,2,4]):\n  e=env.clone()\n  for a in path:e.step(a);sleep(.004)\n  print(path,'\"'done',e.levels_completed,'term',e.terminal(),symbol(e))\n e=env.clone()\n for a in [3,3,3,3,3,3]:e.step(a);sleep(.004)\n print('goal actions')\n for a in e.actions:\n  n=e.clone();n.step(a);sleep(.004);print(a,n.levels_completed,n.terminal(),symbol(n))\n\nprint(A.run_program('tu93',probe)[::2])\nPY\npython probe_mechanics6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
