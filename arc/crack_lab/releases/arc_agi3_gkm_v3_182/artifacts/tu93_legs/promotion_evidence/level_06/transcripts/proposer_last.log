{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_reuse6.py <<'PY'\nfrom probe_level6 import setup,A\nfrom legs import traverse_patrolled_links, clear_linked_sentries, traverse_linked_tiles\nfrom time import sleep\nclass Recorder:\n def __init__(self,e):self.e=e;self.path=[]\n def __getattr__(self,k):return getattr(self.e,k)\n def step(self,a):self.path.append(a);self.e.step(a);sleep(.004)\ndef probe(env):\n setup(env)\n for leg,kw in [(traverse_patrolled_links,dict(max_states=512,max_depth=50)),(clear_linked_sentries,dict(max_states=512,max_depth=50))]:\n  e=Recorder(env.clone())\n  try:leg(e,**kw);print(leg.__name__,'success',e.levels_completed,e.terminal(),e.path)\n  except Exception as ex:print(leg.__name__,type(ex).__name__,str(ex))\nprint(A.run_program('tu93',probe)[::2])\nPY\npython probe_reuse6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
