{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_level2.py <<'PY'\nimport json\nimport gkm_try as h\nfrom perception import arr, connected_components, action_deltas, color_counts\n\ndef probe(env):\n    for a in json.load(open('checkpoint.json'))['final_path']:\n        env.step(a)\n    print('ENTRY',env.levels_completed,'ACTIONS',env.actions,'COUNTS',color_counts(env.frame()))\n    print('BLOBS',[(b.color,b.bbox,b.area) for b in connected_components(env.frame())])\n    print('DELTAS',action_deltas(env))\n    f=arr(env.frame())\n    print('ROWS')\n    for r in range(0,64,2):\n        print(r, ''.join('0123456789abcdef'[int(x)] for x in f[r,::2]))\n    for a in env.actions:\n        c=env.clone(); c.step(a)\n        print('AFTER',a,[(b.color,b.bbox,b.area) for b in connected_components(c.frame()) if b.color not in (4,5)])\nh.A.run_program('tu93',probe)\nPY\npython probe_level2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
