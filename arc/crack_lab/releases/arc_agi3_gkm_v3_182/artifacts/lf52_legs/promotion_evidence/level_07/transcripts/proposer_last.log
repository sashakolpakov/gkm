{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,72p' legs.py; cat solve.py; sed -n '48,79p' perception.py; sed -n '86,129p' players.py\"","aggregated_output":"\"\"\"Small reusable skills built from public frame observations and actions.\"\"\"\nfrom functools import lru_cache\n\nfrom perception import connected_components, safe_step\n\n\ndef solve_peg_jumps(env, *, extra_sockets=(), target_pegs=None):\n    \"\"\"Read square sockets, plan orthogonal peg captures, verify, then execute.\"\"\"\n    def observe(arena):\n        blobs = connected_components(arena.frame(), colors=(1, 14))\n        sockets = {\n            (b.bbox[1] + 2, b.bbox[0] + 2)\n            for b in blobs\n            if b.size == (4, 4) and b.area in (12, 16)\n        }\n        pegs = {\n            (b.bbox[1] + 2, b.bbox[0] + 2)\n            for b in blobs if b.color == 14 and b.size == (4, 4)\n        }\n        return sockets, frozenset(pegs)\n\n    board, initial = observe(env)\n    board.update(extra_sockets)\n    target = None if target_pegs is None else frozenset(target_pegs)\n    pitch = min(\n        abs(a[axis] - b[axis])\n        for a in board for b in board for axis in (0, 1)\n        if a[axis] != b[axis]\n    )\n    jumps = []\n    for x, y in sorted(board):\n        for dx, dy in ((pitch, 0), (-pitch, 0), (0, pitch), (0, -pitch)):\n            middle = (x + dx, y + dy)\n            destination = (x + 2 * dx, y + 2 * dy)\n            if middle in board and destination in board:\n                jumps.append(((x, y), middle, destination))\n\n    @lru_cache(None)\n    def plan(pegs):\n        if (target is not None and pegs == target) or (target is None and len(pegs) == 1):\n            return ()\n        for source, middle, destination in jumps:\n            if source in pegs and middle in pegs and destination not in pegs:\n                remaining = (pegs - {source, middle}) | {destination}\n                suffix = plan(frozenset(remaining))\n                if suffix is not None:\n                    return ((source, destination),) + suffix\n        return None\n\n    path = plan(initial)\n    if path is None:\n        raise RuntimeError('No peg reduction path found')\n    base_level = env.levels_completed\n    clone = env.clone()\n    for index, (source, destination) in enumerate(path):\n        safe_step(clone, (6, *source))\n        safe_step(clone, (6, *destination))\n        if clone.levels_completed > base_level:\n            path = path[:index + 1]\n            break\n        if len(observe(clone)[1]) != len(initial) - index - 1:\n            raise RuntimeError('Observed jump disagrees with the capture model')\n    if clone.levels_completed <= base_level and (target is None or observe(clone)[1] != target):\n        raise RuntimeError('Peg reduction did not complete the level')\n    for source, destination in path:\n        safe_step(env, (6, *source))\n        safe_step(env, (6, *destination))\n        if env.levels_completed > base_level:\n            return\n\n\ndef solve_peg_ferry(env):\nimport players\n\ndef solve(env):\n    # dispatch to the per-level player for the current level, in a loop\n    while not env.terminal():\n        k = env.levels_completed + 1\n        fn = getattr(players, f'play_level_{k}', None)\n        if fn is None:\n            return\n        before = env.levels_completed\n        fn(env)\n        if env.levels_completed <= before:\n            return  # no progress -> stop\ndef connected_components(frame, colors: Optional[Iterable[int]] = None,\n                         min_area: int = 1) -> List[Blob]:\n    f = arr(frame)\n    wanted = None if colors is None else {int(c) for c in colors}\n    seen = np.zeros(f.shape, dtype=bool)\n    out: List[Blob] = []\n    rows, cols = f.shape[:2]\n    for r in range(rows):\n        for c in range(cols):\n            if seen[r, c]:\n                continue\n            color = int(f[r, c])\n            if wanted is not None and color not in wanted:\n                seen[r, c] = True\n                continue\n            q = [(r, c)]\n            seen[r, c] = True\n            pts = []\n            while q:\n                x, y = q.pop()\n                pts.append((x, y))\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx, ny = x + dx, y + dy\n                    if 0 <= nx < rows and 0 <= ny < cols and not seen[nx, ny] and int(f[nx, ny]) == color:\n                        seen[nx, ny] = True\n                        q.append((nx, ny))\n            if len(pts) >= min_area:\n                rs = [p[0] for p in pts]\n                cs = [p[1] for p in pts]\n                out.append(Blob(color, (min(rs), min(cs), max(rs), max(cs)),\n                                len(pts), (sum(rs) / len(pts), sum(cs) / len(pts))))\n    return sorted(out, key=lambda b: (b.color, b.bbox))\ndef play_level_6(env):\n    jump_supported_route(\n        env, (((20, 20), (20, 32)), ((20, 26), (20, 38)),\n              ((20, 32), (20, 44)), ((20, 38), (20, 50)),\n              ((14, 50), (26, 50)), ((26, 56), (26, 44)),\n              ((20, 44), (32, 44)), ((26, 44), (38, 44)),\n              ((32, 44), (44, 44)), ((38, 44), (50, 44)),\n              ((24, 44), (36, 44))),\n        expected_pegs=((30, 44),), expected_blue=((36, 44),))\n    move_socket_team(\n        env, (4,) * 10 + (1,) * 2 + (3,) * 2 + (1,) * 2,\n        expected_centers=((30, 32), (48, 32)))\n    jump_supported_route(\n        env, (((30, 32), (30, 20)), ((30, 20), (42, 20)),\n              ((48, 32), (48, 20)), ((42, 20), (54, 20))),\n        expected_pegs=((10, 20), (58, 26), (34, 38), (22, 50)),\n        expected_blue=((4, 20),))\n    move_socket_team(\n        env, (2,) * 2 + (4,) * 2 + (1,) * 4,\n        expected_centers=((4, 32), (52, 20), (3, 44)))\n    jump_supported_route(\n        env, (((4, 20), (16, 20)), ((10, 20), (22, 20)),\n              ((16, 20), (28, 20)), ((22, 20), (34, 20)),\n              ((28, 20), (40, 20)), ((34, 20), (46, 20)),\n              ((40, 20), (52, 20)), ((46, 20), (58, 20)),\n              ((58, 20), (58, 32))),\n        expected_pegs=((58, 32), (34, 38), (22, 50)),\n        expected_blue=((52, 20),))\n    move_socket_team(\n        env, (2,) * 2, expected_centers=((3, 44), (52, 32)))\n    jump_supported_route(\n        env, (((58, 32), (46, 32)),),\n        expected_pegs=((46, 32), (34, 38), (22, 50)),\n        expected_blue=((52, 32),))\n    move_socket_team(\n        env, (2,) * 2 + (3,) * 2 + (1,) * 2,\n        expected_centers=((40, 32),))\n    jump_supported_route(\n        env, (((46, 32), (34, 32)), ((34, 32), (34, 44))),\n        expected_pegs=((34, 44), (22, 50)), expected_blue=((40, 32),))\n    move_socket_team(env, (2,) * 2, expected_centers=((40, 44),))\n    jump_supported_route(\n        env, (((40, 44), (28, 44)), ((34, 44), (22, 44)),\n              ((22, 44), (22, 56))))\n","exit_code":0,"status":"completed"}}
