{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_level2.py <<'PY'\nimport gkm_try as H\nfrom legs import solve_peg_jumps\nfrom perception import connected_components, safe_step, frame_delta\n\ndef summary(e):\n    bs=connected_components(e.frame(),colors=(1,11,12,14))\n    return [(b.color,b.bbox,b.area) for b in bs if b.color \"'!= 1 or b.area !=16]\n\ndef probe(env):\n    solve_peg_jumps(env)\n    e=env.clone()\n    print('\"'BASE',summary(e))\n    for path in ([3],[4],[3,3],[4,4],[4,1],[4,2],[(6,15,17)],[(6,15,17),(6,27,17)],[(6,45,53)],[(6,33,35)],[(6,15,17),3],[(6,15,17),4]):\n        c=e.clone()\n        for a in path: safe_step(c,a)\n        print('PATH',path,'REWARD',c.levels_completed,'STATE',summary(c))\n    f=e.frame()\n    for r in range(6,59):\n        runs=[]; last=None\n        for col in range(4,59):\n            v=int(f[r][col])\n            if v\"'!=last:\n                runs.append((col,v)); last=v\n        print('\"'ROW',r,runs)\nprint('PROBE', H.A.run_program('lf52',probe)[::2])\nPY\npython probe_level2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
