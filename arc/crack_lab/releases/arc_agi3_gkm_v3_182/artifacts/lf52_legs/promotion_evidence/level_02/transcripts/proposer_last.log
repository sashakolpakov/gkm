{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_level2.py <<'PY'\nimport gkm_try as H\nfrom legs import solve_peg_jumps\nfrom perception import connected_components, safe_step\n\ndef sym(e):\n    return [(b.color,b.bbox,b.area) for b in connected_components(e.frame()) if b.color in (2,3,11,12,14,15)]\ndef probe(env):\n    solve_peg_jumps(env);e=env.clone()\n    for a in [(6,15,17),(6,27,17),(6,27,17),(6,39,17),(6,45,17),(6,33,17)]:safe_step(e,a)\n    f=e.frame()\n    for r in [7,16,17,18,26,31,32,34,35,36,37,38,43,52,53,54,56]:\n        print('WALL',r,[c for c in range(4,60) if int(f[r][c])==5])\n    print('TERMINAL',e.terminal())\n    for path in ([1],[2],[7,1],[7,2],[3,3,3,2,2,2,4,4,4,4,7,4],[4,4,4,4,1,1,1,3,7,3]):\n        c=e.clone()\n        for a in path:safe_step(c,a)\n        print('PATH',path,sym(c),'R',c.levels_completed,'T',c.terminal())\nprint('PROBE',H.A.run_program('lf52',probe)[::2])\nPY\npython probe_level2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
