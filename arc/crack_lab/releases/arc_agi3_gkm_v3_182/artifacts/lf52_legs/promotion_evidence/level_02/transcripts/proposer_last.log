{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_level2.py <<'PY'\nimport gkm_try as H\nfrom legs import solve_peg_jumps\nfrom perception import connected_components, safe_step, color_counts\n\ndef summary(e):\n    return [(b.color,b.bbox,b.area) for b in connected_components(e.frame()) if b.color not in (0,1,5,9,10) ]\ndef probe(env):\n    solve_peg_jumps(env);e=env.clone()\n    path=[(6,15,17),(6,27,17),(6,27,17),(6,39,17),(6,45,17),(6,33,17)]\n    for a in path: safe_step(e,a)\n    print('SOLVED?',color_counts(e.frame()),summary(e))\n    for a in [4]*4+[1]*3+[3]*3:\n        safe_step(e,a);print('STEP',a,summary(e),e.levels_completed)\n    for a in [7,1,2,3,4,(6,45,53),(6,51,53)]:\n        c=e.clone();safe_step(c,a); print('TEST',a,summary(c),c.levels_completed)\nprint('PROBE',H.A.run_program('lf52',probe)[::2])\nPY\npython probe_level2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
