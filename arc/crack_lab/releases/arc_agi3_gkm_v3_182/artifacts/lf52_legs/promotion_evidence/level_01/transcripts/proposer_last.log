{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_solution.py <<'PY'\nimport gkm_try as h\nfrom perception import *\ndef read(e):\n blobs=connected_components(e.frame(),colors=[1,14])\n board={(b.bbox[1]+2,b.bbox[0]+2) for b in blobs if b.size==(4,4) and b.area in (12,16)}\n pegs={(b.bbox[1]+2,b.bbox[0]+2) for b in blobs if b.color==14}\n return board,pegs\ndef find(board,pegs):\n if len(pegs)==1:return []\n for x,y in sorted(pegs):\n  for dx,dy in [(6,0),(-6,0),(0,6),(0,-6)]:\n   mid=(x+dx,y+dy);dst=(x+2*dx,y+2*dy)\n   if mid in pegs and dst in board-pegs:\n    suffix=find(board,(pegs-{(x,y),mid})|{dst})\n    if suffix is not None:return [((x,y),dst)]+suffix\n return None\ndef probe(env):\n board,pegs=read(env);path=find(board,pegs)\n print('board',len(board),'pegs',sorted(pegs),'jumps',path)\n c=env.clone()\n for src,dst in path:\n  safe_step(c,(6,*src));f=arr(c.frame());print('select',src,'hint_colors',color_counts(f),'destination',int(f[dst[1]-2,dst[0]-1]))\n  safe_step(c,(6,*dst));print('jump',dst,'pegs',sorted(read(c)[1]),'levels',c.levels_completed)\n print('clone finished',c.levels_completed,c.terminal())\nh.A.run_program('lf52',probe)\nPY\npython probe_solution.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
