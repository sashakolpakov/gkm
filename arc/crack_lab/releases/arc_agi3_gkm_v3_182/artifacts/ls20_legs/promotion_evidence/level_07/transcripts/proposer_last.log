{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"cat > explore7.py <<'PY'\nimport json,time\nfrom collections import deque\nimport gkm_try as h\nfrom perception import *\ndef pos(e):\n b=next(b for b in connected_components(e.frame(),[9]) if b.area==15)\n return ((b.bbox[0]-7)//5,(b.bbox[1]-9)//5)\ndef inspect(env):\n for a in json.load(open('checkpoint.json'))['final_path']:env.step(a)\n q=deque([(env.clone(),[])]);seen={pos(env)};cells={};paths={};start=time.time();steps=0\n while q and len(seen)<100:\n  e,p=q.popleft();paths[str(pos(e))]=p\n  f=arr(e.frame())\n  for r in range(9):\n   for c in range(9):\n    tile=f[5+5*r:10+5*r,9+5*c:14+5*c];v=set(map(int,tile.flat))-{5,9,12}\n    if v:cells.setdefault((r,c),set()).update(v)\n  for a in e.actions:\n   n=e.clone();n.step(a);steps+=1\n   time.sleep(.004)\n   if n.terminal() or n.levels_completed\"'!=6:continue\n   at=pos(n)\n   if at not in seen:seen.add(at);q.append((n,p+[a]))\n print('\"'EXPLORE',steps,'seen',len(seen),'secs',round(time.time()-start,1))\n for r in range(9):print(' '.join(''.join(format(x,'x') for x in sorted(cells.get((r,c),set()))) or '?' for c in range(9)))\n print('PATHS',paths)\n json.dump(paths,open('explore7_paths.json','w'))\nh.A.run_program('ls20',inspect)\nPY\npython explore7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
