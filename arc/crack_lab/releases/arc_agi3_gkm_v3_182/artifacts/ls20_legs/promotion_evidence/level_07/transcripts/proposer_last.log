{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat > map7.py <<'PY'\nimport json,time\nfrom collections import deque\nimport gkm_try as h\nfrom perception import *\ndef pos(e):\n f=arr(e.frame());ys,xs=__import__('numpy').where(f[:55]==9)\n # Avatar has a 5-wide solid row.\n for r in sorted(set(ys)):\n  for c in range(60):\n   if (f[r,c:c+5]==9).all():return ((r-7)//5,(c-9)//5)\ndef inspect(env):\n for a in json.load(open('checkpoint.json'))['final_path']:env.step(a)\n q=deque([(env.clone(),[])]);seen={pos(env)};cells={};paths={};trans=[]\n while q and len(seen)<120:\n  e,p=q.popleft();at=pos(e);paths[str(at)]=p;f=arr(e.frame())\n  for r in range(10):\n   for c in range(10):\n    tile=f[5+5*r:10+5*r,9+5*c:14+5*c];v=set(map(int,tile.flat))-{5,9,12}\n    if v:cells.setdefault((r,c),set()).update(v)\n  for a in e.actions:\n   n=e.clone();n.step(a);time.sleep(.004)\n   if n.terminal() or n.levels_completed\"'!=6:continue\n   to=pos(n)\n   if abs(to[0]-at[0])+abs(to[1]-at[1])>1:trans.append((at,a,to))\n   if to not in seen:seen.add(to);q.append((n,p+[a]))\n print('\"'MAP')\n for r in range(10):print(' '.join(''.join(format(x,'x') for x in sorted(cells.get((r,c),set()))) or '?' for c in range(10)))\n print('JUMPS',trans);json.dump(paths,open('explore7_paths.json','w'));json.dump({str(k):sorted(v) for k,v in cells.items()},open('map7_cells.json','w'))\n for at in ['(7, 0)','(8, 4)','(9, 9)']:\n  e=replay(env,paths[at]);print('AT',at,'terminal',e.terminal());print('OB',[(b.color,b.bbox,b.area) for b in connected_components(e.frame(),[0,1,8,9,11,12,14])])\n  f=arr(e.frame())\n  for r,c in [(7,0),(7,2),(8,1),(8,3),(8,5),(9,4),(2,6),(5,7),(6,5)]:\n   t=f[5+5*r:10+5*r,9+5*c:14+5*c]\n   if (t\"'!=5).any(): print((r,c),['\"''.join(format(int(x),'x') for x in row) for row in t])\nh.A.run_program('ls20',inspect)\nPY\npython map7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
