{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"cat > graph7.py <<'PY'\nimport json,time\nfrom collections import deque\nimport numpy as np\nimport gkm_try as h\nfrom perception import arr,replay\n\ndef pos(e):\n f=arr(e.frame())\n for r in range(7,55,5):\n  for c in range(9,59,5):\n   if (f[r,c:c+5]==9).all():return ((r-7)//5,(c-9)//5)\ndef hud(e):return arr(e.frame())[55:61:2,3:9:2].tolist()\ndef inspect(env):\n for a in json.load(open('checkpoint.json'))['final_path']:env.step(a)\n q=deque([(env.clone(),[])]);seen={pos(env)};tiles={};graph={};paths={}\n while q:\n  e,p=q.popleft();at=pos(e);paths[str(at)]=p;f=arr(e.frame());edges={}\n  for r in range(10):\n   for c in range(10):\n    tile=f[5+5*r:10+5*r,9+5*c:14+5*c]\n    if not (tile==5).any() and (r,c)\"'!=at:tiles[str((r,c))]=tile.tolist()\n  for a in e.actions:\n   n=e.clone();n.step(a);time.sleep(.004)\n   if n.terminal() or n.levels_completed!=6:continue\n   to=pos(n);edges[a]=[to,hud(e),hud(n)]\n   if to not in seen:seen.add(to);q.append((n,p+[a]))\n  graph[str(at)]=edges\n json.dump(graph,open('\"'graph7.json','w'));json.dump(tiles,open('tiles7.json','w'));json.dump(paths,open('explore7_paths.json','w'))\n for at,t in tiles.items():\n  vals=set(np.array(t).flat)\n  if vals-{3,4,11}:print(at,[''.join(format(v,'x') for v in row) for row in t])\n print('HUD CHANGES')\n for at,edges in graph.items():\n  for a,(to,h1,h2) in edges.items():\n   if h1\"'!=h2:print(at,a,to,h1,'\"'->',h2)\nh.A.run_program('ls20',inspect)\nPY\npython graph7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
