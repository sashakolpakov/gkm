{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_centers.py <<'PY'\nfrom probe_routes import *\ndef probe(env):\n players.play_level_1(env);f=np.array(env.frame()); print('CENTERS')\n for i in range(10):print(''.join(format(int(f[7+i*5,11+j*5]),'x') for j in range(10)))\n # all valid moves from directly above exit after one marker, exact coords and deltas\n e=env.clone()\n for a in route(tiles(e),pos(e),(2,1))+[2]*4:e.step(a)\n for a,d in action_deltas(e).items():print('ATEXIT',a,d)\n # long wall attempts from entry to determine whether meter drains at walls\n t=env.clone()\n for a in [2,3,1,2]:\n  bef=np.array(t.frame()); t.step(a);print('WALL',a,pos(t),__import__('perception').frame_delta(bef,t.frame())['count'])\nA.run_program('ls20',probe)\nPY\npython probe_centers.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
