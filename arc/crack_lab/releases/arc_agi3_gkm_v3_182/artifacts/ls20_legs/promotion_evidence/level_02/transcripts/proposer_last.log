{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_routes.py <<'PY'\nexec(open('probe_level2.py').read().split('def probe(env):')[0])\nimport numpy as np\nfrom collections import deque\n\ndef tiles(e):\n f=np.array(e.frame()); out=[]\n for i in range(10):\n  row=[]\n  for j in range(10):\n   a=f[5+i*5:10+i*5,9+j*5:14+j*5]; cs=set(a.ravel())\n   row.append('P' if 12 in cs else 'k' if 11 in cs else 'E' if 5 in cs else '.' if 3 in cs else '#')\n  out.append(''.join(row))\n return out\n\ndef pos(e):\n a=np.array(e.frame()); ys,xs=np.where(a==12)\n return ((int(ys.min())-5)//5,(int(xs.min())-9)//5) if len(ys) else None\n\ndef route(board,start,end):\n q=deque([(start,[])]); seen={start}\n while q:\n  (r,c),p=q.popleft()\n  if (r,c)==end:return p\n  for a,dr,dc in [(1,-1,0),(2,1,0),(3,0,-1),(4,0,1)]:\n   v=(r+dr,c+dc)\n   if 0<=v[0]<10 and 0<=v[1]<10 and board[v[0]][v[1]]\"'!='\"'#' and v not in seen:\n    seen.add(v);q.append((v,p+[a]))\n\ndef probe(env):\n players.play_level_1(env)\n board=tiles(env); print('BOARD',*board,sep='\\\\n')\n for target in [(2,1),(9,6),(7,1)]:\n  e=env.clone();path=route(board,pos(e),target);print('TARGET',target,'PATH',path)\n  if path is None:continue\n  for n,a in enumerate(path):\n   e.step(a)\n   print('step',n+1,a,'pos',pos(e),'level',e.levels_completed,'counts', {k:v for k,v in color_counts(e.frame()).items() if k in (5,9,11,12)})\n  print('END BOARD',tiles(e))\nA.run_program('ls20',probe)\nPY\npython probe_routes.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
