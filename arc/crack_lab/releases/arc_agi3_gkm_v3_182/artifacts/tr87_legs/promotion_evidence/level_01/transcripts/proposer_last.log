{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_glyphs.py <<'PY'\nfrom gkm_try import A\nimport perception as p\n\ndef glyph(f,r,c):\n return '/'.join(''.join('#' if v==5 else '.' for v in row) for row in p.arr(f)[r:r+5,c:c+5])\ndef probe(e):\n f=e.frame()\n for r in [5,14,23]:\n  for c in [13,36]: print('pair',glyph(f,r,c),glyph(f,r,c+10))\n print('source',[glyph(f,41,c) for c in [15,22,29,36,43]])\n print('target',[glyph(f,52,c) for c in [15,22,29,36,43]])\n c=e.clone()\n for i in range(30):\n  print('cycle',i,glyph(c.frame(),52,15),'level',c.levels_completed)\n  c.step(1)\n for path in [[4,1],[3,2],[1,2],[1]*10,[2]*10]:\n  c=p.replay(e,path)\n  print('context',path,'selected',[(b.bbox) for b in p.connected_components(c.frame(),[0])], 'targets',[glyph(c.frame(),52,j) for j in [15,22,29,36,43]])\nA.run_program('tr87',probe)\nPY\npython probe_glyphs.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
