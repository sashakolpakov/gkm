{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\np='probe_level5.py'\ns=open(p).read().replace(\\\"harness.A.run_program('tr87',probe)\\\",\\\"if __name__ == '__main__':\\\\n    harness.A.run_program('tr87',probe)\\\")\nopen(p,'w').write(s)\nPY\ncat > probe_rules5.py <<'PY'\nimport time\nimport gkm_try as harness\nfrom probe_level5 import entry\nfrom legs import _glyph, _glyph_identity\n\ndef probe(env):\n    entry(env); ids={}\n    def lab(g):\n        key=_glyph_identity(g)\n        if key not in ids: ids[key]=chr(65+len(ids))\n        return ids[key]\n    groups=[[(11,9)],[(11,19)],[(11,32)],[(11,42),(11,49)],[(23,9),(23,16)],[(23,26)],[(23,39)],[(23,49)]]\n    fixed=[[(44,c) for c in range(15,44,7)],[(53,c) for c in range(15,44,7)]]\n    def seq(w,coords):return ''.join(lab(_glyph(w.frame(),r,c,5)) for r,c in coords)\n    print('INITIAL',[seq(env,g) for g in groups], [seq(env,g) for g in fixed])\n    w=env.clone()\n    for i,group in enumerate(groups):\n        scan=w.clone(); seen=[]\n        for j in range(7):\n            seen.append(seq(scan,group));scan.step(1);time.sleep(.004)\n        print('GROUP',i,seen,'fixed',[seq(scan,g) for g in fixed])\n        # verify inverses and 7-cycle\n        inverse=w.clone(); inverse.step(1); inverse.step(2)\n        print('INVERSE',i,seq(inverse,group)==seq(w,group),'CYCLE',seq(scan,group)==seq(w,group))\n        w.step(4)\nharness.A.run_program('tr87',probe)\nPY\npython probe_rules5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
