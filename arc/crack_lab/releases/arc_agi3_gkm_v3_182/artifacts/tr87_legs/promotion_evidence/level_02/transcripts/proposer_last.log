{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_level2.py <<'PY'\nimport json\nimport gkm_try as harness\nimport numpy as np\nfrom perception import arr, action_deltas\n\ndef ident(g): return min(np.rot90(g[:,::d],k).tobytes() for d in (1,-1) for k in range(4))\ndef probe(env):\n    with open('checkpoint.json') as f: path=json.load(f)['final_path']\n    for a in path: env.step(a)\n    ids={}\n    def glyph(e,r,c):\n        g=arr(e.frame())[r:r+5,c:c+5]==5\n        key=ident(g)\n        if key not in ids: ids[key]=len(ids)\n        return ids[key]\n    examples=[(5,6,[16]),(5,29,[39,46,53]),(14,6,[16,23]),(14,36,[46,53]),(23,6,[16,23,30]),(23,43,[53])]\n    mapping={}\n    for r,c,cols in examples:\n        s=glyph(env,r,c); t=[glyph(env,r,x) for x in cols];mapping[s]=t\n        print('EXAMPLE',s,t)\n    sources=[glyph(env,41,c) for c in (19,26,33,40)]\n    goals=sum([mapping[s] for s in sources],[])\n    print('SOURCE',sources,'GOAL',goals)\n    cols=list(range(8,53,7))\n    def state(e):\n        f=arr(e.frame()); ys,xs=np.where(f==0)\n        return {'cursor':round(float(xs.mean()),2),'answers':[glyph(e,52,c) for c in cols]}\n    print('ENTRY',state(env))\n    for path in ([1],[2],[3],[4],[4,1],[4,2],[1,2],[3,4]):\n        w=env.clone()\n        for a in path:w.step(a)\n        print('PROBE',path,state(w),w.levels_completed)\n    w=env.clone(); ring=[]\n    for i in range(24):\n        s=state(w);g=s['answers'][0]\n        if g in ring: break\n        ring.append(g);w.step(1)\n    print('RING',ring,'repeat',g,'levels',w.levels_completed)\n    w=env.clone();path=[]\n    for i,goal in enumerate(goals):\n        for j in range(len(ring)):\n            if glyph(w,52,cols[i])==goal:break\n            w.step(1);path.append(1)\n        print('SUBGOAL',i,'goal',goal,'actual',glyph(w,52,cols[i]),'levels',w.levels_completed)\n        if w.levels_completed>1:break\n        if i+1<len(goals):w.step(4);path.append(4)\n    print('CANDIDATE',len(path),path,'levels',w.levels_completed)\n    if w.levels_completed>1:\n        with open('level2_expansion_candidate.json','w') as f:json.dump(path,f)\nharness.A.run_program('tr87',probe)\nPY\npython probe_level2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
