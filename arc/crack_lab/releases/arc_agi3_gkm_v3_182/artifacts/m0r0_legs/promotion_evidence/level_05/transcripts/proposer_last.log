{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_pressure.py <<'PY'\nfrom collections import deque\nfrom probe_level5 import A,json,safe_step,arr,connected_components\n\ndef probe(env):\n    for a in json.load(open('checkpoint.json'))['final_path']:safe_step(env,a)\n    f=arr(env.frame()); start=tuple(sorted(b.top_left for b in connected_components(f,[10])))\n    tiles={(y,x):int(f[y,x]) for y in range(6,58,4) for x in range(2,62,4)}\n    plates={};gates={}\n    for k in (12,14,15):\n        bs=connected_components(f,[k]);plates[k]={b.top_left for b in bs if b.size==(4,4)}\n        gates[k]={p for p,v in tiles.items() if v==k and p not in plates[k]}\n    print('PLATES',plates,'GATES',gates,flush=True)\n    floor={p for p,v in tiles.items() if v in (5,10)}|set.union(*plates.values())\n    gatecolors={p:k for k,ps in gates.items() for p in ps}\n    dirs={1:(-4,0),2:(4,0),3:(0,4),4:(0,-4)}\n    def adv(s,a):\n        active={k for k,ps in plates.items() if any(p in ps for p in s)}\n        dy,dx=dirs[a];out=[]\n        for i,(y,x) in enumerate(s):\n            p=(y+dy,x+(dx if i==0 else -dx));out.append(p if p in floor or gatecolors.get(p) in active else (y,x))\n        return tuple(out)\n    q=deque([start]);parents={start:None};goal=None\n    while q and len(parents)<60000:\n        s=q.popleft()\n        if s[0]==s[1]:goal=s;break\n        for a in dirs:\n            t=adv(s,a)\n            if t not in parents:parents[t]=(s,a);q.append(t)\n    print('SEARCH',len(parents),'goal',goal,flush=True)\n    if goal is None:return\n    path=[]\n    while parents[goal] is not None:goal,a=parents[goal];path.append(a)\n    path.reverse();print('PATH',len(path),path,flush=True)\n    c=env.clone();s=start\n    for i,a in enumerate(path):\n        safe_step(c,a);s=adv(s,a)\n        if c.levels_completed>4:print('WIN',i+1,flush=True);json.dump(path[:i+1],open('pressure_reunion_level5_candidate.json','w'));return\n        actual=tuple(sorted(b.top_left for b in connected_components(c.frame(),[10])))\n        if tuple(sorted(s))\"'!=actual:\n            print('\"'MISMATCH',i,a,'expected',s,'actual',actual,flush=True);return\n    print('NO WIN',flush=True)\nA.run_program('m0r0',probe)\nPY\npython probe_pressure.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
