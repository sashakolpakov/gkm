   actual=tuple(sorted(b.top_left for b in connected_components(c.frame(),[10])))\n        if tuple(sorted(s))\"'!=actual:\n            print('\"'MISMATCH',i,a,'expected',s,'actual',actual,flush=True);return\n    print('NO WIN',flush=True)\nA.run_program('m0r0',probe)\nPY\npython probe_pressure.py\"","aggregated_output":"PLATES {12: {(26, 58)}, 14: {(26, 34)}, 15: {(6, 14), (50, 14)}} GATES {12: {(38, 18), (38, 14), (38, 10)}, 14: {(22, 18), (22, 14), (22, 22)}, 15: {(38, 46), (38, 42), (22, 50), (22, 46), (22, 42), (38, 50)}}\nSEARCH 4306 goal ((6, 30), (6, 30))\nPATH 39 [3, 3, 1, 1, 1, 1, 3, 1, 4, 4, 1, 4, 4, 1, 3, 3, 3, 3, 1, 1, 1, 3, 3, 1, 1, 1, 1, 1, 4, 4, 1, 3, 1, 1, 1, 1, 3, 3, 3]\nWIN 39\n","exit_code":0,"status":"completed"}}
