{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_level6.py <<'PY'\nimport json\nimport gkm_try as harness\nfrom perception import block_signatures, action_deltas\n\ndef tiles(e):\n    return {p:s for p,s in block_signatures(e.frame()).items() if p[0]<15}\n\ndef show(e):\n    t=tiles(e)\n    print('level', e.levels_completed, 'actions',e.actions)\n    print('legend',sorted(set(t.values())))\n    chars={s:chr(65+i) for i,s in enumerate(sorted(set(t.values())))}\n    print('key',chars)\n    for r in range(15): print(''.join(chars[t[r,c]] for c in range(16)))\n\ndef main(e):\n    for a in json.load(open('checkpoint.json'))['final_path']:e.step(a)\n    show(e)\n    print('deltas',action_deltas(e))\n    for a in e.actions:\n        c=e.clone(); c.step(a)\n        print('action',a, 'changed',[(p,s,tiles(c)[p]) for p,s in tiles(e).items() if s\"'!=tiles(c)[p]])\n\nif __name__=='\"'__main__': print(harness.A.run_program('wa30',main)[::2])\nPY\npython probe_level6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
