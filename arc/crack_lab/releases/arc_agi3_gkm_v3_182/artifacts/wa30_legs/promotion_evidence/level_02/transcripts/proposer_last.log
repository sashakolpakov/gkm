{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_cooperate.py <<'PY'\nimport json\nimport gkm_try as H\nfrom perception import arr\n\ndef s(e):\n f=arr(e.frame()); return {k:[(r,c) for r in range(15) for c in range(16) if k in f[r*4:r*4+4,c*4:c*4+4]] for k in (14,12,4,5,2)}\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']:e.step(a)\n c=e.clone()\n path=[4]*9+[2]*5+[1,5]+[3]*9+[2]*3+[5]\n for i,a in enumerate(path):\n  c.step(a)\n  if i in (13,14,15,24,27,28):print('DELIVER',i+1,s(c))\n for i in range(65):\n  if c.terminal() or c.levels_completed>1:break\n  c.step(5)\n  if i%10==0:print('WAIT',i+1,s(c))\n print('END',c.levels_completed,c.terminal(),len(path)+i)\nprint(H.A.run_program('wa30',probe))\nPY\npython probe_cooperate.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
