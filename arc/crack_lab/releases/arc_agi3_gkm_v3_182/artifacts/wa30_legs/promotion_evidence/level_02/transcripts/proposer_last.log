{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_mechanics.py <<'PY'\nimport json\nimport gkm_try as H\nfrom perception import arr\nfrom legs import fill_marked_cells\n\ndef state(e):\n f=arr(e.frame()); out={}\n for k in (14,12,4,2,3):\n  out[k]=[(r,c) for r in range(15) for c in range(16) if k in f[r*4:r*4+4,c*4:c*4+4]]\n return out\n\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']: e.step(a)\n c=e.clone()\n for i in range(26):\n  print('WAIT',i,state(c)); c.step(5)\n c=e.clone()\n try: fill_marked_cells(c)\n except Exception as ex: print('LEG_ERROR',str(ex))\n print('LEG_END',c.levels_completed,state(c))\nH.A.run_program('wa30',probe)\nPY\npython probe_mechanics.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
