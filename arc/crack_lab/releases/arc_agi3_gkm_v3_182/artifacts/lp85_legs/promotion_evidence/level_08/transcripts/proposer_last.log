{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_cycles8.py <<'PY'\nimport json,random,time\nimport gkm_try as harness\nfrom perception import arr,connected_components,safe_step\n\ndef inspect(env):\n    for a in json.load(open('checkpoint.json'))['final_path']: env.step(a)\n    blobs=connected_components(env.frame())\n    points=sorted((b.bbox[1],b.bbox[0]) for b in blobs if b.area==4 and b.size==(2,2))\n    actions=[(6,int(b.centroid[1]),int(b.centroid[0])) for b in blobs if b.area==10 and b.size in ((4,3),(3,4))]\n    def seq(e):\n        f=arr(e.frame());return tuple(int(f[y,x]) for x,y in points)\n    print('TARGETS',[(p,seq(env)[i]) for i,p in enumerate(points) if int(arr(env.frame())[p[1]-1,p[0]-1])==11])\n    rng=random.Random(0);begin=time.monotonic();steps=0\n    def step(e,a):\n        nonlocal steps\n        safe_step(e,a);steps+=1\n        time.sleep(max(0,steps/280-(time.monotonic()-begin)))\n    for a in actions:\n        cand=[set(range(len(points))) for _ in points]; changed=set()\n        for context in range(16):\n            e=env.clone()\n            if context:\n                for _ in range(12+context):step(e,rng.choice(actions))\n            hist=[seq(e)]\n            for _ in range(32):\n                step(e,a);hist.append(seq(e))\n                if hist[-1]==hist[0]:break\n            for dst in range(len(points)):\n                cand[dst]={src for src in cand[dst] if all(hist[t+1][dst]==hist[t][src] for t in range(len(hist)-1))}\n                if any(h[dst]\"'!=hist[0][dst] for h in hist): changed.add(dst)\n        print('\"'ACTION',a,'changed',len(changed),'ambiguous',[(points[d],len(c),d in c,d in changed) for d,c in enumerate(cand) if len(c)\"'!=1])\n        perm={next(iter(c)):d for d,c in enumerate(cand) if len(c)==1}\n        print('\"'MOVES',[(points[s],points[d]) for s,d in perm.items() if s\"'!=d])\nprint('\"'PROBE',harness.A.run_program('lp85',inspect)[::2])\nPY\npython probe_cycles8.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
