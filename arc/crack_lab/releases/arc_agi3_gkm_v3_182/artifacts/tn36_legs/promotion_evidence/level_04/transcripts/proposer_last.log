{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_program.py <<'PY'\nimport gkm_try as h\nimport players,perception as p\nfrom legs import clear_binary_program\n\ndef board(e):\n f=p.arr(e.frame());return [''.join(str(int(f[y,x])) if int(f[y,x])<10 else 'B' for x in range(34,61,4)) for y in range(5,32,4)]\ndef bits(e):\n f=p.arr(e.frame());return [''.join('1' if f[y,x]==1 else '0' for y in (33,36,39,42,45,48)) for x in (34,39,44,49,54,59)]\ndef probe(e):\n for f in (players.play_level_1,players.play_level_2,players.play_level_3):f(e)\n print('BOARD',board(e),'BITS',bits(e))\n c=e.clone();clear_binary_program(c,tuple((x,y) for x in (34,39,44,49,54,59) for y in (33,36,39,42,45,48)),(57,58))\n print('ZERO',board(c),bits(c))\n for xy in ((5,58),(15,58),(25,58),(35,58),(57,58),(0,0)):\n  d=c.clone();d.step(6,*xy);print('AFTER',xy,board(d),bits(d),d.levels_completed)\n for i in range(6):\n  d=c.clone();d.step(6,34,(33,36,39,42,45,48)[i]);print('BIT',i,board(d),bits(d))\n  d.step(6,57,58);print('RUNBIT',i,board(d),d.levels_completed)\nh.A.run_program('tn36',probe)\nPY\npython probe_program.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
