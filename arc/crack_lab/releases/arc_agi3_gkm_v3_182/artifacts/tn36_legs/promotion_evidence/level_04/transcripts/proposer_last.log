{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_route.py <<'PY'\nimport gkm_try as h\nimport players,perception as p\nimport json,time,itertools\nwords={'R':'101110','S':'111011','U':'001111','G':'011011'}\nxs=(34,39,44,49,54,59);ys=(33,36,39,42,45,48)\ndef program(e,route):\n for x,cmd in zip(xs,route):\n  for y,b in zip(ys,words[cmd]):\n   if int(e.frame()[y][x]) \"'!= (1 if b=='\"'1' else 5):e.step(6,x,y)\n e.step(6,57,58)\nroutes=['UUUURG','UUUUGR']\nroutes.extend(''.join(r) for r in sorted(set(itertools.permutations('UUUURG'))) if ''.join(r) not in routes)\nfor route in routes:\n def test(e):\n  for f in (players.play_level_1,players.play_level_2,players.play_level_3):f(e)\n  if route==routes[0]:\n   c=e.clone();program(c,route);print('CLONE',route,c.levels_completed)\n  program(e,route)\n levels,path,err=h.A.run_program('tn36',test)\n print('ROUTE',route,levels,len(path),err,flush=True)\n if levels>=4:\n  with open('candidate_up_right_grow.json','w') as f:json.dump(path,f)\n  break\n time.sleep(.15)\nPY\npython probe_route.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
