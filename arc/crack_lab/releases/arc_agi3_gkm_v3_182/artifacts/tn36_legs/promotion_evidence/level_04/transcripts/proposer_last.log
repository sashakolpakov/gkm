{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_isolation.py <<'PY'\nimport gkm_try as h\nimport players,perception as p\n\ndef bits(e):\n f=p.arr(e.frame()).copy();return [''.join('1' if f[y,x]==1 else '0' for y in (33,36,39,42,45,48)) for x in (34,39,44,49,54,59)]\ndef probe(e):\n for f in (players.play_level_1,players.play_level_2,players.play_level_3):f(e)\n print('BASE',bits(e))\n for i in range(4):\n  c=e.clone();c.step(6,34,33);print('C',i,bits(c),'P',bits(e))\n d=e.clone();d.step(6,0,0);print('D',bits(d))\nh.A.run_program('tn36',probe)\nPY\npython probe_isolation.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
