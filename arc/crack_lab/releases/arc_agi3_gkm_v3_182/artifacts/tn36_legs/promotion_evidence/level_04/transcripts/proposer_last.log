{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_effects.py <<'PY'\nimport gkm_try as h\nimport players,perception as p\nimport numpy as np\n\ndef probe(e):\n for f in (players.play_level_1,players.play_level_2,players.play_level_3):f(e)\n zero=e.clone()\n for x in (34,39,44,49,54,59):\n  for y in (33,36,39,42,45,48):zero.step(6,x,y)\n for base,name in ((e,'ones'),(zero,'zero')):\n  original=p.arr(base.frame()).copy()\n  for x in (34,39,44,49,54,59):\n   for y in (33,36,39,42,45,48):\n    c=base.clone();c.step(6,x,y);before=p.arr(c.frame()).copy();c.step(6,57,58);after=p.arr(c.frame()).copy()\n    delta=p.frame_delta(original[3:32,32:62],after[3:32,32:62])\n    run=p.frame_delta(before,after)\n    if delta['count'] or run['count']>1 or c.levels_completed>3:print(name,(x,y),'board',delta['count'],delta['bbox'],'run',run['count'],run['bbox'],'level',c.levels_completed)\n print('DONE')\nh.A.run_program('tn36',probe)\nPY\npython probe_effects.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
