{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_uniform.py <<'PY'\nfrom probe_common import *\nimport time\n\ndef probe(env):\n    for k in range(1,5):getattr(players,f'play_level_{k}')(env)\n    groups={}\n    for num in range(64):\n        bits=f'{num:06b}';c=env.clone()\n        for x in (34,39,44,49,54,59):\n            for y,bit in zip((33,36,39,42,45,48),bits):\n                if bit=='0':c.step(6,x,y);time.sleep(.004)\n        c.step(6,57,58);time.sleep(.004)\n        f=arr(c.frame())\n        markers=tuple((b.bbox,b.area) for b in connected_components(f,colors=(11,),min_area=1) if b.bbox[0]<32)\n        preview=tuple(''.join('1' if f[y,x]==4 else '.' for x in range(2,30,4)) for y in range(4,32,4))\n        left=tuple(''.join(str(int(f[y,x]==1)) for y in (33,36,39,42,45,48)) for x in (11,16,21))\n        groups.setdefault((c.levels_completed,markers,left,preview),[]).append(bits)\n    for key,codes in groups.items():print('CODES',','.join(codes),'EFFECT',key)\nlevels,path,err=A.run_program('tn36',probe)\nprint('RUN',levels,len(path),err)\nPY\npython probe_uniform.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
