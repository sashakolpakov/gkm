{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_entry.py <<'PY'\nfrom probe_common import *\n\ndef probe(env):\n    for k in range(1,4):getattr(players,f'play_level_{k}')(env)\n    controls=((34,33),(34,42),(39,36),(39,48),(44,33),(44,36),(49,33),(49,36),(54,33),(54,36),(59,33),(59,36))\n    for xy in controls+((57,58),):\n        env.step(6,*xy);print('PREFIX',xy,env.levels_completed)\n    c=env.clone()\n    for xy in ((57,58),(57,58),(57,58)):\n        before=arr(c.frame()).copy();c.step(6,*xy);print('RUN',xy,compact(c),'delta',frame_delta(before,c.frame())['count'])\n    # compare each coarse region clicked from pristine entry\n    changed=[]\n    for y in range(2,64,4):\n        for x in range(2,64,4):\n            c=env.clone();before=arr(c.frame()).copy();c.step(6,x,y);d=frame_delta(before,c.frame())\n            if d['count']>1: changed.append(((x,y),d['count'],d['bbox']))\n    print('COARSE',changed)\nlevels,path,err=A.run_program('tn36',probe)\nprint('RUN',levels,len(path),err)\nPY\npython probe_entry.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
