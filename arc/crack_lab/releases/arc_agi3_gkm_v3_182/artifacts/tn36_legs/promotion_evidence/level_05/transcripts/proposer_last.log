{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_timing.py <<'PY'\nfrom probe_common import *\n\ndef probe(env):\n    for k in range(1,5):getattr(players,f'play_level_{k}')(env)\n    c=env.clone(); last=compact(c)\n    for x in (34,39,44,49,54,59):\n        for y in (33,42):\n            c.step(6,x,y);now=compact(c)\n            print('EDIT',x,y,'left',now['left'],'board',now['board'])\n    for i in range(8):\n        before=arr(c.frame()).copy();c.step(6,57,58)\n        print('TRIGGER',i,compact(c),'delta',frame_delta(before,c.frame())['count'])\n    for xy in ((11,33),(11,36),(16,33),(20,10),(5,58),(57,58)):\n        c=env.clone();before=arr(c.frame()).copy();c.step(6,*xy)\n        print('OTHER',xy,compact(c),'delta',frame_delta(before,c.frame()))\nlevels,path,err=A.run_program('tn36',probe)\nprint('RUN',levels,len(path),err)\nPY\npython probe_timing.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
