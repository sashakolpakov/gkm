{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_routes.py <<'PY'\nfrom probe_common import *\nimport itertools, time\nCODES={'D':'001111','U':'011110','R':'101111','L':'101110','S':'011011','G':'111011','T':'010111','Z':'000000','N':'111111'}\n\ndef trial(route):\n    def probe(env):\n        for k in range(1,5):getattr(players,f'play_level_{k}')(env)\n        controls=tuple((x,y) for x,key in zip((34,39,44,49,54,59),route) for y,b in zip((33,36,39,42,45,48),CODES[key]) if b=='0')\n        clear_binary_program(env,controls,(57,58))\n    levels,path,err=A.run_program('tn36',probe)\n    if levels>=5:\n        print('WIN',route,levels,len(path),err,flush=True)\n        with open('candidate_level5_route.json','w') as f:json.dump(path,f)\n        return True\n    return False\n\nif __name__=='__main__':\n    routes=[]\n    for base in ('DDDRD','DDDDR'):\n        for op in 'SGTZN':\n            for i in range(6):routes.append(base[:i]+op+base[i:])\n    for i,route in enumerate(dict.fromkeys(routes)):\n        if trial(route):break\n    else:print('NONE',len(set(routes)))\nPY\npython probe_routes.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
