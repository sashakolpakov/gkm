{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_codes.py <<'PY'\nfrom probe_common import *\nimport time\n\ndef state(c):\n    f=arr(c.frame())\n    return (c.levels_completed,tuple((int(x),int(y)) for y,x in zip(*((f[:32,32:]==11).nonzero()))),tuple(int(f[y,x]) for x in (11,16,21) for y in (33,36,39,42,45,48)))\n\ndef probe(env):\n    for k in range(1,5):getattr(players,f'play_level_{k}')(env)\n    groups={}\n    for num in range(64):\n        bits=f'{num:06b}'\n        c=env.clone()\n        for y,bit in zip((33,36,39,42,45,48),bits):\n            if bit=='0': c.step(6,34,y);time.sleep(.004)\n        c.step(6,57,58);time.sleep(.004)\n        f=arr(c.frame())\n        markers=tuple((b.bbox,b.area) for b in connected_components(f,colors=(11,),min_area=1) if b.bbox[0]<32)\n        left=tuple(''.join(str(int(f[y,x]==1)) for y in (33,36,39,42,45,48)) for x in (11,16,21))\n        groups.setdefault((c.levels_completed,markers,left),[]).append(bits)\n    for key, codes in groups.items():print('CODES',codes,'EFFECT',key)\nlevels,path,err=A.run_program('tn36',probe)\nprint('RUN',levels,len(path),err)\nPY\npython probe_codes.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
