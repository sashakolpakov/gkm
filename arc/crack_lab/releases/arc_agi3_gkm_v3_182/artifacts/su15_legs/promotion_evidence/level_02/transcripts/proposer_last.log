{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_motion.py <<'PY'\nexec(open('probe_structure.py').read().split('def probe(env):')[0])\nfrom perception import connected_components, color_counts, arr, frame_delta\n\ndef summary(e):\n    return [(b.color,b.bbox,b.area) for b in connected_components(e.frame()) if b.color not in (0,4,5) and b.bbox[0]>=10]\ndef probe(env):\n    click_walk_to_region(env)\n    print('ENTRY',summary(env))\n    for act in [7,(6,33,27),(6,5,5),(6,10,1),(6,32,5),(6,30,45)]:\n        c=env.clone(); old=arr(c.frame()).copy(); safe_step(c,act)\n        print('ACTION',act, 'state',summary(c),'delta',frame_delta(old,c.frame()))\n        for i in range(1,5):\n            safe_step(c,act)\n            print('repeat',i,summary(c),'level',c.levels_completed)\nA.run_program('su15',probe)\nPY\npython probe_motion.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
