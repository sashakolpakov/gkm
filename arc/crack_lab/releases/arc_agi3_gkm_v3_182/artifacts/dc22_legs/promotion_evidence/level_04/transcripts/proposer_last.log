{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_routes.py <<'PY'\nfrom probe_level4 import *\nfrom legs import navigate_switchable_platforms\n\ndef run(env):\n    entry(env);c=env.clone()\n    for w in ((20,24),(24,4),(32,18),(40,28),None):\n        t=time.monotonic()\n        try:navigate_switchable_platforms(c,((52,20),(45,28),(56,28)),waypoint=w,max_states=1800,max_depth=65)\n        except RuntimeError as e:print('FAIL',w,str(e),flush=True);return\n        print('REACHED',w,'level',c.levels_completed,'seconds',round(time.monotonic()-t,2),'avatar',[(b.bbox) for b in connected_components(c.frame(),(14,))],flush=True)\n        if c.levels_completed>3:return\nprint(A.run_program('dc22',run)[::2])\nPY\npython probe_routes.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
