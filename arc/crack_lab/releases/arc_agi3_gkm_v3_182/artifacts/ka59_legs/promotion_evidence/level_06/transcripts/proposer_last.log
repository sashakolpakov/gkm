{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"cat > probe6.py <<'PY'\nimport json,sys\nimport gkm_try as H\nimport perception as P\n\ndef brief(e):\n f=P.arr(e.frame()); out=[]\n for color in (0,4,11,12,13,14,15):\n  bs=P.connected_components(f,colors=[color]); out.append((color,[(b.bbox,b.area) for b in bs]))\n return out\n\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']: P.safe_step(e,a)\n mode=sys.argv[1] if len(sys.argv)>1 else 'time'\n if mode=='time':\n  for a in [2]*8:\n   P.safe_step(e.clone(),a)\n  c=e.clone()\n  for i in range(8):\n   P.safe_step(c,2);print(i+1,brief(c),flush=True)\n if mode=='select':\n  for p in [(10,19),(52,49),(45,48),(27,18),(49,22)]:\n   c=P.replay(e,[(6,*p),1]);print(p,brief(c),flush=True)\n if mode=='path':\n  actions=json.loads(sys.argv[2]); c=e.clone()\n  for i,a in enumerate(actions):\n   P.safe_step(c,a); print(i+1,a,c.levels_completed,brief(c),flush=True)\nprint(H.A.run_program('ka59',probe)[:1])\nPY\npython probe6.py time\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
