{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/zsh -lc \"cat > map6.py <<'PY'\nimport json\nimport gkm_try as H\nimport perception as P\n\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']: P.safe_step(e,a)\n f=P.arr(e.frame())\n for y in range(21):\n  print(y,''.join('0123456789ABCDEF'[int(f[y*3+1,x*3+1])] for x in range(21)))\n for acts in ([1,1,1,3,3,2]+[1]*3+[3]*2+[1]*3,[1,1,1,3,3,2]+[3]*3+[1]*4):\n  c=P.replay(e,acts); print('PATH',acts,[(b.color,b.bbox) for b in P.connected_components(c.frame(),colors=[11,14])])\nprint(H.A.run_program('ka59',probe)[:1])\nPY\npython map6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
