{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"cat > reach5.py <<'PY'\nfrom probe5 import *\nfrom collections import deque\nimport time\ndef avatar(e):\n for b in connected_components(e.frame(),colors=[9]):\n  if b.area==24 and b.bbox[0]>=7 and b.bbox[2]<62:return ((b.bbox[0]-8)//6,(b.bbox[1]-2)//6)\ndef search(e,limit=300):\n q=deque([(e.clone(),[])]); seen={}; n=0\n while q and n<limit:\n  c,p=q.popleft(); k=arr(c.frame())[7:62,:].tobytes()\n  if k in seen:continue\n  seen[k]=p;n+=1\n  print(avatar(c),p,'counts',[(v,num) for v,num in color_counts(c.frame()).items() if v in [8,11,15]])\n  for a in [1,2,3,4]:\n   d=c.clone();safe_step(d,a)\n   if arr(d.frame())[7:62,:].tobytes() not in seen:q.append((d,p+[a]))\n  time.sleep(.015)\n print('states',n,'queue',len(q))\ndef probe(env):search(entry(env))\nprint(A.run_program('g50t',probe)[:1])\nPY\npython reach5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
