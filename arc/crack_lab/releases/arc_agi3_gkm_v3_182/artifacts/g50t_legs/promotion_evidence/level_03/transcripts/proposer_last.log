{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_map.py <<'PY'\nfrom probe3 import A,entry,arr,replay,safe_step,connected_components\n\ndef symbol(env):\n f=arr(env.frame()); return [''.join('0123456789abcdef'[int(f[y,x])] for x in range(10,55,6)) for y in range(10,55,6)]\ndef obs(env):\n return [(b.color,b.bbox,b.area) for b in connected_components(env.frame(),colors=[9,1,8,11],min_area=4)]\ndef run(env):\n entry(env)\n print('MAP',*symbol(env),sep='\\\\n')\n for path in ([1],[1,1],[1,1,4],[1,1,4,4],[1,1,4,4,5],[1,1,4,4,5,2],[1,1,4,4,5,2,2]):\n  c=replay(env,path); print('P',path,'L',c.levels_completed,obs(c));print(*symbol(c),sep='\\\\n')\nA.run_program('g50t',run)\nPY\npython probe_map.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
