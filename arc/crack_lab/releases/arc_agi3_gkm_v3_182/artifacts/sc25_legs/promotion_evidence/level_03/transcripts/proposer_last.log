{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_mechanics.py <<'PY'\nfrom probe_level3 import harness,entry\nfrom perception import arr,safe_step,frame_delta,connected_components\nfrom legs import enter_displayed_pattern\n\ndef sym(e):\n f=arr(e.frame()); return {'level':e.levels_completed,'figures':[(b.color,b.bbox,b.area) for b in connected_components(f,colors=[4,6,9,10,13]) if b.bbox[0]<45], 'grid':[[int(f[50+5*r,25+5*c]) for c in range(3)]for r in range(3)]}\ndef probe(e):\n entry(e)\n print('BASE',sym(e))\n for name,path in [('right',[4]*6),('down',[2]*5),('left',[3]*4),('click',[(6,30,50)]),('pattern',[(6,30,50),(6,30,55),(6,30,60)])]:\n  c=e.clone()\n  for a in path:\n   before=arr(c.frame()).copy();safe_step(c,a)\n   print(name,a,'delta',frame_delta(before,c.frame())['count'],sym(c))\n print('CONTEXT')\n c=e.clone(); enter_displayed_pattern(c,ink=6)\n for a in [4]*6+[3]*6+[2]*5+[3]*2:\n  safe_step(c,a);print(a,sym(c))\nprint(harness.A.run_program('sc25',probe)[::2])\nPY\npython probe_mechanics.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
