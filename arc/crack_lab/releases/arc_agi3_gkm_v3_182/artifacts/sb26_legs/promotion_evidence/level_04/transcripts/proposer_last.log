{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_level4.py <<'PY'\nimport gkm_try\nfrom perception import arr, connected_components, action_deltas, safe_step, frame_delta\nimport players\n\ndef brief(a,b):\n d=frame_delta(a,b); return (d['count'],d['bbox'],d['samples'][:6])\ndef probe(env):\n for f in (players.play_level_1,players.play_level_2,players.play_level_3): f(env)\n print('ENTRY',env.levels_completed,'ACTIONS',env.actions)\n for p in [(10,58),(52,58),(25,36),(20,22),(31,36),(15,18),(48,27),(31,18),(31,27),(31,32)]:\n  c=env.clone();a=arr(c.frame()).copy();safe_step(c,(6,*p));b=arr(c.frame()).copy()\n  print('CLICK',p,brief(a,b))\n  safe_step(c,(6,20,22));print('THEN_SOCKET',brief(b,c.frame()))\n for name,acts in [('paint',[(6,10,58),(6,20,22)]),('ref',[(6,52,58),(6,20,22)]),('ref_lower',[(6,52,58),(6,31,36)]),('move',[(6,15,18),(6,21,32)])]:\n  c=env.clone();a=arr(c.frame()).copy()\n  for act in acts: safe_step(c,act)\n  print(name,brief(a,c.frame()),'LEVEL',c.levels_completed)\n  print('OBJECTS',[(b.color,b.bbox,b.area) for b in connected_components(c.frame(),min_area=4) if 8<b.bbox[0]<53 and b.color\"'!=4])\ngkm_try.A.run_program('\"'sb26',probe)\nPY\npython probe_level4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
