{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\np='probe_level5.py'\ns=open(p).read(); start=s.index('def summary'); end=s.index(\\\"if __name__\\\")\ns=s[:start]+'''def summary(e):\n    f=arr(e.frame())\n    return {k:[(r//3,c//3) for r in range(0,63,3) for c in range(0,63,3) if f[r,c]==k] for k in (4,5,11)}\n\ndef axes(e):\n    f=arr(e.frame())[:63,:63]\n    return {'rows':[r//3 for r in range(0,63,3) if (f[r,:]==10).sum()>35], 'cols':[c//3 for c in range(0,63,3) if (f[:,c]==10).sum()>35]}\n\ndef probe(env):\n    for a in json.load(open('checkpoint.json'))['final_path']: env.step(a)\n    print('ENTRY',summary(env), axes(env))\n    print('DELTAS',{a:(v['count'],v['bbox']) for a,v in action_deltas(env).items()})\n    for prefix in ([],[5],[5,5],[5,5,5]):\n        c=env.clone()\n        for a in prefix: safe_step(c,a)\n        print('CONTROL',prefix,'dots',[(b.bbox) for b in connected_components(arr(c.frame())[:63,:63],colors=[0])][:3])\n        for a in (1,2,3,4,5,7,(6,43,37)):\n            d=c.clone();safe_step(d,a)\n            print('A',a,summary(d), axes(d))\n\n''' + s[end:];open(p,'w').write(s)\nPY\npython probe_level5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
