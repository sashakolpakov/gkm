{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_ft09.py <<'PY'\nimport gkm_try as h\nimport perception as p\nimport numpy as np\nORIGINS=[(4,2),(38,2),(4,36),(36,36)]\ndef board(f):\n a=p.arr(f)\n return [''.join(str(int(a[y+8*r,x+8*c])) for r in range(3) for c in range(3)) for x,y in ORIGINS]\ndef probe(env):\n print('initial',board(env.frame()))\n actions=[(6,x+8*c+2,y+8*r+2) for x,y in ORIGINS for r in range(3) for c in range(3)]+[(6,0,0)]\n for act,d in p.action_deltas(env,actions).items():\n  q=p.replay(env,[act]); a=p.arr(env.frame());b=p.arr(q.frame());ys,xs=np.where(a\"'!=b)\n  trans={}\n  for y,x in zip(ys,xs):\n   k=(int(a[y,x]),int(b[y,x]));trans[k]=trans.get(k,0)+1\n  print(act,'\"'boards',board(q.frame()),'delta',d['count'],d['bbox'],'trans',trans,'reward',q.levels_completed)\nh.A.run_program('ft09',probe)\nPY\npython probe_ft09.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
