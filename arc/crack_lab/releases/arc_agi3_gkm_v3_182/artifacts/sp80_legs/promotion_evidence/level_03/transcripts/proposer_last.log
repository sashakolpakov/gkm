{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_search.py <<'PY'\nimport json,time,itertools\nimport gkm_try as H\nfrom perception import safe_step,connected_components\n\ndef predicted(xs):\n rays={1,9,14}\n for left,width in reversed(list(zip(xs,[4,5,6,6]))):\n  if any(left<=x<left+width for x in rays):\n   rays={x for x in rays if not left<=x<left+width}|{left-1,left+width}\n return rays\n\ndef probe(e):\n for a in json.load(open('checkpoint.json'))['final_path']:safe_step(e,a)\n configs=[]\n for xs in itertools.product(range(13),range(12),range(11),range(11)):\n  rays=predicted(xs);score=len(rays&{2,7,13})\n  if score==3: configs.append((len(rays-{2,7,13}),sum(abs(x-y) for x,y in zip(xs,[2,10,2,9])),xs))\n configs.sort();print('CANDIDATES',len(configs),flush=True)\n start=time.monotonic();steps=0\n for i,(_,_,xs) in enumerate(configs):\n  c=e.clone();path=[]\n  for row,initial,left,width in zip([20,28,32,40],[2,10,2,9],xs,[4,5,6,6]):\n   a=(6,initial*4+1,row+1);safe_step(c,a);path.append(a)\n   for j in range(abs(left-initial)):\n    a=4 if left>initial else 3;safe_step(c,a);path.append(a)\n  safe_step(c,5);path.append(5);steps+=len(path)\n  if c.levels_completed>=3:\n   print('FOUND',xs,'PATH',path,flush=True);json.dump(path,open('level3_split_candidate.json','w'));return\n  delay=steps/250-(time.monotonic()-start)\n  if delay>0:time.sleep(delay)\n  if i%100==0:print('TRIED',i,'STEPS',steps,flush=True)\n print('NO SUCCESS',flush=True)\nH.A.run_program('sp80',probe)\nPY\npython probe_search.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
