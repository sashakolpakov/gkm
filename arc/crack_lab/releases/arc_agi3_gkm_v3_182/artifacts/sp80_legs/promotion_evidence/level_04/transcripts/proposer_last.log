{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"cat > model_routes.py <<'PY'\nfrom probe_search import routes\n\ndef search(order,split=False):\n layers={frozenset({7}):(0,[])}\n lens=[5,5,7,4,4]; initial=[5,12,2,14,12];target=frozenset({3,9,13,17})\n for i in order:\n  nxt={}; n=lens[i]\n  for xs,(cost,path) in layers.items():\n   for p in range(21-n):\n    if i==2 and p+3 in xs:continue\n    if split and i==2: ys=routes(xs,[(p,3),(p+4,3)])\n    else:ys=routes(xs,[(p,n)])\n    if not ys:continue\n    ys=frozenset(ys);v=cost+abs(p-initial[i]);old=nxt.get(ys)\n    if old is None or v<old[0]:nxt[ys]=(v,path+[(i,p)])\n  layers=nxt\n return layers.get(target)\n\nif __name__=='__main__':\n import itertools\n best=[]\n for split in (False,True):\n  for order in itertools.permutations(range(5)):\n   if order.index(0)>order.index(1) or order.index(3)>order.index(4):continue\n   r=search(order,split)\n   if r:best.append((r[0],split,order,r[1]))\n print(sorted(best)[:10])\nPY\npython model_routes.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
