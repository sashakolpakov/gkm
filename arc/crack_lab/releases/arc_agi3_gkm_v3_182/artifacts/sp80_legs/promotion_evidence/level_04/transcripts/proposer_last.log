{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/zsh -lc \"cat > probe_orders.py <<'PY'\nimport itertools,json,time\nimport gkm_try as H\nfrom perception import safe_step\nfrom model_routes import search\n\ndef probe(e):\n with open('checkpoint.json') as f:p=json.load(f)['final_path']\n for a in p:safe_step(e,a)\n candidates=[]\n for split in (False,True):\n  for order in itertools.permutations(range(5)):\n   if order.index(0)>order.index(1) or order.index(3)>order.index(4):continue\n   r=search(order,split)\n   if r:candidates.append((r[0],split,order,r[1]))\n for cost,split,order,plan in sorted(candidates):\n  c=e.clone();path=[];beg=time.monotonic()\n  def step(a):safe_step(c,a);path.append(a)\n  for row,(i,x) in zip((12,21,36,45,51),plan):\n   oldx,oldy=((24,18),(45,18),(12,30),(50,33),(44,42))[i]\n   step((6,oldx,oldy))\n   for _ in range(abs(row-oldy)//3):step(2 if row>oldy else 1)\n   dx=x-(5,12,2,14,12)[i]\n   for _ in range(abs(dx)):step(4 if dx>0 else 3)\n  step(5)\n  print('TEST',split,order,plan,'reward',c.levels_completed,flush=True)\n  if c.levels_completed>=4:\n   with open('level4_beam_candidate.json','w') as f:json.dump(path,f)\n   print('WIN',path);return\n  time.sleep(max(0,len(path)/280-(time.monotonic()-beg)))\nH.A.run_program('sp80',probe)\nPY\npython probe_orders.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
