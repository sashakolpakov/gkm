{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba gkm_try.py | sed -n '1,240p'; nl -ba perception.py | sed -n '1,245p'; nl -ba players.py | sed -n '1,80p'; nl -ba legs.py | sed -n '1,430p'\"","aggregated_output":"     1\timport importlib.util, json, os, sys\n     2\tsys.path.insert(0, '/Users/sasha/gkm/arc/crack_lab')\n     3\timport gkm_legs as G\n     4\timport gkm_arena as A\n     5\ttaint_reason = G._workspace_taint_reason(os.getcwd())\n     6\tif taint_reason:\n     7\t    raise SystemExit(f\"TAINTED WORKSPACE: {taint_reason}\")\n     8\tspec = importlib.util.spec_from_file_location(\"solve\", \"solve.py\")\n     9\tm = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\n    10\tdef resumed_solve(env):\n    11\t    ck = None\n    12\t    if os.path.exists(\"checkpoint.json\"):\n    13\t        with open(\"checkpoint.json\") as f:\n    14\t            ck = json.load(f)\n    15\t    if ck and ck.get(\"game\") == 'g50t' and ck.get(\"validated\") and ck.get(\"final_path\"):\n    16\t        for act in ck[\"final_path\"]:\n    17\t            env.step(act)\n    18\t    m.solve(env)\n    19\tlevels, path, err = A.run_program('g50t', resumed_solve)\n    20\tok = A.validate('g50t', path, levels) if path else False\n    21\tprint(f\"RESULT levels={levels} moves={len(path)} replay_ok={ok} err={err}\")\n     1\t\"\"\"Source-free frame perception helpers for cracking.\n     2\t\n     3\tThis module is deliberately observational: it derives compact symbolic state\n     4\tfrom `env.frame()` and `env.clone()` only. It is a cofibration-style scaffold:\n     5\traw pixels are embedded into a monotone tower of reusable observations\n     6\t(components -> objects -> action deltas -> replay states). Candidate level\n     7\tlogic should be written against these quotients, then replay-validated by the\n     8\tharness. No game source or prior solution history is read here.\n     9\t\"\"\"\n    10\tfrom collections import deque\n    11\tfrom dataclasses import dataclass\n    12\tfrom typing import Dict, Iterable, List, Optional, Sequence, Tuple\n    13\t\n    14\timport numpy as np\n    15\t\n    16\tUP, DOWN, LEFT, RIGHT, USE = 1, 2, 3, 4, 5\n    17\tACTIONS = (UP, DOWN, LEFT, RIGHT, USE)\n    18\tDIRS = {UP: (-1, 0), DOWN: (1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\n    19\tACTION_NAME = {UP: \"UP\", DOWN: \"DOWN\", LEFT: \"LEFT\", RIGHT: \"RIGHT\", USE: \"USE\"}\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Blob:\n    24\t    color: int\n    25\t    bbox: Tuple[int, int, int, int]  # r0, c0, r1, c1 inclusive\n    26\t    area: int\n    27\t    centroid: Tuple[float, float]\n    28\t\n    29\t    @property\n    30\t    def top_left(self):\n    31\t        return self.bbox[0], self.bbox[1]\n    32\t\n    33\t    @property\n    34\t    def size(self):\n    35\t        r0, c0, r1, c1 = self.bbox\n    36\t        return r1 - r0 + 1, c1 - c0 + 1\n    37\t\n    38\t\n    39\tdef arr(frame) -> np.ndarray:\n    40\t    return np.asarray(frame)\n    41\t\n    42\t\n    43\tdef color_counts(frame) -> Dict[int, int]:\n    44\t    vals, cnts = np.unique(arr(frame), return_counts=True)\n    45\t    return {int(v): int(c) for v, c in zip(vals, cnts)}\n    46\t\n    47\t\n    48\tdef connected_components(frame, colors: Optional[Iterable[int]] = None,\n    49\t                         min_area: int = 1) -> List[Blob]:\n    50\t    f = arr(frame)\n    51\t    wanted = None if colors is None else {int(c) for c in colors}\n    52\t    seen = np.zeros(f.shape, dtype=bool)\n    53\t    out: List[Blob] = []\n    54\t    rows, cols = f.shape[:2]\n    55\t    for r in range(rows):\n    56\t        for c in range(cols):\n    57\t            if seen[r, c]:\n    58\t                continue\n    59\t            color = int(f[r, c])\n    60\t            if wanted is not None and color not in wanted:\n    61\t                seen[r, c] = True\n    62\t                continue\n    63\t            q = [(r, c)]\n    64\t            seen[r, c] = True\n    65\t            pts = []\n    66\t            while q:\n    67\t                x, y = q.pop()\n    68\t                pts.append((x, y))\n    69\t                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n    70\t                    nx, ny = x + dx, y + dy\n    71\t                    if 0 <= nx < rows and 0 <= ny < cols and not seen[nx, ny] and int(f[nx, ny]) == color:\n    72\t                        seen[nx, ny] = True\n    73\t                        q.append((nx, ny))\n    74\t            if len(pts) >= min_area:\n    75\t                rs = [p[0] for p in pts]\n    76\t                cs = [p[1] for p in pts]\n    77\t                out.append(Blob(color, (min(rs), min(cs), max(rs), max(cs)),\n    78\t                                len(pts), (sum(rs) / len(pts), sum(cs) / len(pts))))\n    79\t    return sorted(out, key=lambda b: (b.color, b.bbox))\n    80\t\n    81\t\n    82\tdef block_signatures(frame, cell: int = 4) -> Dict[Tuple[int, int], Tuple[int, ...]]:\n    83\t    \"\"\"Partition a frame into fixed cells and return each cell's color signature.\"\"\"\n    84\t    f = arr(frame)\n    85\t    out = {}\n    86\t    for r in range(0, f.shape[0], cell):\n    87\t        for c in range(0, f.shape[1], cell):\n    88\t            out[(r // cell, c // cell)] = tuple(int(v) for v in sorted(np.unique(f[r:r+cell, c:c+cell])))\n    89\t    return out\n    90\t\n    91\t\n    92\tdef object_candidates(frame, cell: int = 4, min_area: int = 4) -> List[dict]:\n    93\t    \"\"\"A compact, game-agnostic object list from color components and cell signatures.\"\"\"\n    94\t    f = arr(frame)\n    95\t    blobs = connected_components(f, min_area=min_area)\n    96\t    sigs = block_signatures(f, cell)\n    97\t    objects = []\n    98\t    for b in blobs:\n    99\t        r0, c0, r1, c1 = b.bbox\n   100\t        objects.append({\n   101\t            \"color\": b.color,\n   102\t            \"bbox\": b.bbox,\n   103\t            \"top_left\": b.top_left,\n   104\t            \"size\": b.size,\n   105\t            \"area\": b.area,\n   106\t            \"centroid\": b.centroid,\n   107\t            \"cell\": (r0 // cell, c0 // cell),\n   108\t            \"cell_sig\": sigs.get((r0 // cell, c0 // cell)),\n   109\t        })\n   110\t    return objects\n   111\t\n   112\t\n   113\tdef frame_delta(before, after) -> dict:\n   114\t    a, b = arr(before), arr(after)\n   115\t    ys, xs = np.where(a != b)\n   116\t    if len(ys) == 0:\n   117\t        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n   118\t    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n   119\t    return {\n   120\t        \"count\": int(len(ys)),\n   121\t        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n   122\t        \"samples\": samples,\n   123\t    }\n   124\t\n   125\t\n   126\tdef action_deltas(env, actions: Sequence[int] = ACTIONS) -> Dict[int, dict]:\n   127\t    base = arr(env.frame()).copy()\n   128\t    out = {}\n   129\t    for action in actions:\n   130\t        clone = env.clone()\n   131\t        clone.step(action)\n   132\t        out[int(action)] = frame_delta(base, clone.frame())\n   133\t    return out\n   134\t\n   135\t\n   136\tdef replay(env, actions: Sequence[int]):\n   137\t    clone = env.clone()\n   138\t    for action in actions:\n   139\t        if clone.terminal():\n   140\t            break\n   141\t        clone.step(int(action))\n   142\t    return clone\n   143\t\n   144\t\n   145\tdef path_result(env, actions: Sequence[int]) -> dict:\n   146\t    clone = replay(env, actions)\n   147\t    return {\n   148\t        \"levels_completed\": int(clone.levels_completed),\n   149\t        \"terminal\": bool(clone.terminal()),\n   150\t        \"path_len\": len(actions),\n   151\t        \"colors\": color_counts(clone.frame()),\n   152\t        \"objects\": object_candidates(clone.frame()),\n   153\t    }\n   154\t\n   155\t\n   156\tdef changed_signature(env, actions: Sequence[int], cell: int = 4):\n   157\t    before = block_signatures(env.frame(), cell)\n   158\t    clone = replay(env, actions)\n   159\t    after = block_signatures(clone.frame(), cell)\n   160\t    return {k: (before.get(k), after.get(k)) for k in sorted(set(before) | set(after))\n   161\t            if before.get(k) != after.get(k)}\n   162\t\n   163\t\n   164\tdef bounded_bfs(env, goal_fn, actions: Sequence[int] = (UP, DOWN, LEFT, RIGHT, USE),\n   165\t                key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   166\t    \"\"\"Generic clone BFS over observational keys. Use small max_states first.\"\"\"\n   167\t    if key_fn is None:\n   168\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   169\t    start_key = key_fn(env)\n   170\t    q = deque([(env.clone(), [])])\n   171\t    seen = {start_key}\n   172\t    while q and len(seen) <= max_states:\n   173\t        node, path = q.popleft()\n   174\t        if goal_fn(node, path):\n   175\t            return path\n   176\t        if len(path) >= max_depth:\n   177\t            continue\n   178\t        for action in actions:\n   179\t            child = node.clone()\n   180\t            child.step(int(action))\n   181\t            key = key_fn(child)\n   182\t            if key in seen:\n   183\t                continue\n   184\t            seen.add(key)\n   185\t            q.append((child, path + [int(action)]))\n   186\t    return None\n   187\t\n   188\t\n   189\tdef bounded_replay_bfs(env, goal_fn, action_fn,\n   190\t                       key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   191\t    \"\"\"Path-only BFS for games whose deep Arena clones become expensive.\n   192\t\n   193\t    The queue retains compact action paths, not recursively deep-copied runtime\n   194\t    states. Each node is reconstructed from one root clone. ``action_fn(node)``\n   195\t    may return integer actions or coordinate tuples such as ``(6, x, y)``.\n   196\t    \"\"\"\n   197\t    if key_fn is None:\n   198\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   199\t\n   200\t    def reconstruct(path):\n   201\t        node = env.clone()\n   202\t        for action in path:\n   203\t            if isinstance(action, tuple):\n   204\t                node.step(*action)\n   205\t            else:\n   206\t                node.step(int(action))\n   207\t        return node\n   208\t\n   209\t    start = reconstruct([])\n   210\t    q = deque([[]])\n   211\t    seen = {key_fn(start)}\n   212\t    while q and len(seen) <= max_states:\n   213\t        path = q.popleft()\n   214\t        node = reconstruct(path)\n   215\t        if goal_fn(node, path):\n   216\t            return path\n   217\t        if len(path) >= max_depth or node.terminal():\n   218\t            continue\n   219\t        for action in action_fn(node):\n   220\t            child_path = path + [action]\n   221\t            child = reconstruct(child_path)\n   222\t            key = key_fn(child)\n   223\t            if key in seen:\n   224\t                continue\n   225\t            seen.add(key)\n   226\t            if goal_fn(child, child_path):\n   227\t                return child_path\n   228\t            q.append(child_path)\n   229\t    return None\n   230\t\n   231\t\n   232\tdef level_goal(base_level: int):\n   233\t    return lambda env, path: env.levels_completed > base_level\n     1\t# Per-level players. Each play_level_K(env) ONLY composes legs from legs.py.\n     2\tfrom legs import *  # noqa\n     3\t\n     4\t\n     5\tdef play_level_1(env):\n     6\t    # g50t level 1: move the avatar to the goal region, using USE to open the\n     7\t    # gate that unlocks the far side of the maze.  Fully handled by the general\n     8\t    # unlock-then-reach leg (bounded-depth, grow-pruned toggle search).\n     9\t    solve_unlock_reach(env)\n    10\t\n    11\t\n    12\tdef play_level_2(env):\n    13\t    # g50t level 2: same \"reach the goal chamber\" objective, but the avatar's\n    14\t    # region is only linked to the chamber through gates that open remotely when\n    15\t    # the avatar walks over wall segments; a USE resets the avatar to start\n    16\t    # while keeping opened gates.  A single USE does not enlarge reachability, so\n    17\t    # the plain unlock leg fails here -- the general USE-macro unlock search\n    18\t    # chains several staged openings until the chamber is reachable.\n    19\t    solve_unlock_macro(env)\n    20\t\n    21\t\n    22\tdef play_level_3(env):\n    23\t    # g50t level 3: another staged-unlock maze of the same family as level 2 --\n    24\t    # the goal only becomes movement-reachable after chaining several\n    25\t    # walk-somewhere-then-USE openings.  No new skill is needed: the SAME\n    26\t    # general USE-macro unlock leg subsumes this level too, so this player is\n    27\t    # the identical thin composition as play_level_2.\n    28\t    solve_unlock_macro(env)\n    29\t\n    30\t\n    31\tdef play_level_4(env):\n    32\t    # g50t level 4: yet another staged-unlock maze of the level-2/3 family --\n    33\t    # the goal chamber only becomes movement-reachable after chaining several\n    34\t    # walk-somewhere-then-USE openings.  No new skill: the SAME general USE-macro\n    35\t    # unlock leg clears it, so this player is the identical thin composition as\n    36\t    # play_level_2 / play_level_3.\n    37\t    solve_unlock_macro(env)\n    38\t\n    39\t\n    40\tdef play_level_5(env):\n    41\t    # This configuration has intermediate commits whose hidden effect appears\n    42\t    # only on the next special surface.  The frontier leg supplies the needed\n    43\t    # bounded memory while still steering by movement reachability.\n    44\t    solve_frontier_unlock(env)\n     1\t# Shared leg library: small, named, reusable skills.\n     2\t# Players import from here; add a NEW leg only when no existing leg fits.\n     3\t#\n     4\t# ---- Substrate facts discovered for g50t (raw frames, no game source) ----\n     5\t#   * The avatar is a compact solid block; movement actions 1/2/3/4 translate it\n     6\t#     (UP/DOWN/LEFT/RIGHT) and are blocked by non-floor cells.  Action 5 (USE)\n     7\t#     acts on the tile the avatar stands on: on a \"switch\" tile it reconfigures\n     8\t#     the maze (opens gates -> the avatar's reachable set grows); elsewhere it is\n     9\t#     effectively a reset.\n    10\t#   * A level is cleared (levels_completed increments) when the avatar reaches a\n    11\t#     goal region.\n    12\t#   * IMPORTANT: the environment carries HIDDEN state -- two states with byte\n    13\t#     identical frames can transition differently.  So NEVER dedup a search on\n    14\t#     raw frame bytes.  Planning is done on clones as concrete action sequences\n    15\t#     (which ARE deterministic when replayed), deduping only on the avatar's\n    16\t#     position within a fixed gate configuration.\n    17\tfrom collections import deque\n    18\timport heapq\n    19\timport time\n    20\t\n    21\timport numpy as np\n    22\t\n    23\tMOVES = (1, 2, 3, 4)\n    24\t\n    25\t\n    26\t# --------------------------------------------------------------------------\n    27\t# Cloning: the substrate has hidden state, so we always plan on throwaway\n    28\t# clones and only touch the real env when committing.  Almost every planning\n    29\t# step is \"take a fresh clone and replay these actions on it\" -- capture that\n    30\t# once here so callers stay one-liners.\n    31\t# --------------------------------------------------------------------------\n    32\tdef clone_after(env, actions):\n    33\t    \"\"\"Return a fresh clone of `env` with `actions` (an action or iterable of\n    34\t    actions) applied in order.  Never mutates `env`.\"\"\"\n    35\t    if isinstance(actions, int):\n    36\t        actions = (actions,)\n    37\t    c = env.clone()\n    38\t    for a in actions:\n    39\t        c.step(a)\n    40\t    return c\n    41\t\n    42\t\n    43\t# --------------------------------------------------------------------------\n    44\t# Perception: locate the avatar generically by seeing which blob moves.\n    45\t# --------------------------------------------------------------------------\n    46\tdef _components(mask):\n    47\t    \"\"\"4-connected components of a boolean mask -> list of (top_row, top_col, cells).\"\"\"\n    48\t    seen = np.zeros(mask.shape, bool)\n    49\t    rows, cols = mask.shape\n    50\t    out = []\n    51\t    for r in range(rows):\n    52\t        for c in range(cols):\n    53\t            if mask[r, c] and not seen[r, c]:\n    54\t                stack = [(r, c)]\n    55\t                seen[r, c] = True\n    56\t                cells = []\n    57\t                while stack:\n    58\t                    x, y = stack.pop()\n    59\t                    cells.append((x, y))\n    60\t                    for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n    61\t                        nx, ny = x + dx, y + dy\n    62\t                        if 0 <= nx < rows and 0 <= ny < cols and mask[nx, ny] and not seen[nx, ny]:\n    63\t                            seen[nx, ny] = True\n    64\t                            stack.append((nx, ny))\n    65\t                out.append((min(p[0] for p in cells), min(p[1] for p in cells), cells))\n    66\t    return out\n    67\t\n    68\t\n    69\tdef _shape_comps(frame, bg):\n    70\t    \"\"\"All non-background components as (color, shape_sig, top_left, cells).\"\"\"\n    71\t    out = []\n    72\t    for col in np.unique(frame):\n    73\t        if col == bg:\n    74\t            continue\n    75\t        for tr, tc, cells in _components(frame == col):\n    76\t            sig = frozenset((x - tr, y - tc) for x, y in cells)\n    77\t            out.append((int(col), sig, (tr, tc), cells))\n    78\t    return out\n    79\t\n    80\t\n    81\tdef avatar_tl(env):\n    82\t    \"\"\"Top-left (row, col) of the avatar in env's current frame.  The avatar is\n    83\t    the object that TRANSLATES (same colour & shape, new position) when a move is\n    84\t    applied.  This ignores flickering counters (shape changes, no match) and\n    85\t    static scenery (position unchanged).  Returns None if nothing translates.\"\"\"\n    86\t    before = np.asarray(env.frame())\n    87\t    vals, cnts = np.unique(before, return_counts=True)\n    88\t    bg = int(vals[int(np.argmax(cnts))])\n    89\t    bcomps = _shape_comps(before, bg)\n    90\t    for a in MOVES:\n    91\t        c = clone_after(env, a)\n    92\t        after = np.asarray(c.frame())\n    93\t        if np.array_equal(before, after):\n    94\t            continue\n    95\t        changed = before != after\n    96\t        after_shapes = {(col, sig, tl) for col, sig, tl, _ in _shape_comps(after, bg)}\n    97\t        for col, sig, tl, cells in bcomps:\n    98\t            if not any(changed[x, y] for x, y in cells):\n    99\t                continue\n   100\t            # A translated copy: same colour+shape somewhere else in `after`.\n   101\t            for col2, sig2, tl2 in after_shapes:\n   102\t                if col2 == col and sig2 == sig and tl2 != tl:\n   103\t                    return tl\n   104\t    return None\n   105\t\n   106\t\n   107\t# --------------------------------------------------------------------------\n   108\t# Movement search inside a FIXED gate configuration (deterministic, position\n   109\t# dedup is valid here).  Returns a reward-path if reachable, else the map of\n   110\t# reachable positions -> move-path.\n   111\t#\n   112\t# This is ONE skill -- \"flood the avatar's positions with moves, one clone per\n   113\t# edge, dedup on position\" -- parameterised by HOW we locate the avatar in a\n   114\t# clone (`locate: env -> pos | None`).  `_move_explore` uses the robust but\n   115\t# clone-heavy translation detector; `fast_reach` uses the clone-cheap\n   116\t# color-9-blob reader.  The BFS itself is written exactly once here.\n   117\t# --------------------------------------------------------------------------\n   118\tdef _reach_bfs(start, locate):\n   119\t    \"\"\"BFS over avatar POSITIONS in the current (fixed) gate configuration.\n   120\t    One clone per explored edge; dedup on the position returned by `locate`.\n   121\t    Returns (reward_path, {pos: move_path}); reward_path is a winning move list\n   122\t    if the reward can be raised by pure movement, else None.\"\"\"\n   123\t    base = int(start.levels_completed)\n   124\t    s = locate(start)\n   125\t    if s is None:\n   126\t        return None, {}\n   127\t    seen = {s}\n   128\t    paths = {s: []}\n   129\t    q = deque([(start.clone(), s, [])])\n   130\t    while q:\n   131\t        node, pos, path = q.popleft()\n   132\t        for a in MOVES:\n   133\t            c = clone_after(node, a)\n   134\t            if int(c.levels_completed) > base:\n   135\t                return path + [a], paths          # reward reached by moving\n   136\t            p = locate(c)\n   137\t            if p is None or p == pos or p in seen:\n   138\t                continue\n   139\t            seen.add(p)\n   140\t            paths[p] = path + [a]\n   141\t            q.append((c, p, path + [a]))\n   142\t    return None, paths\n   143\t\n   144\t\n   145\tdef _move_explore(start_env):\n   146\t    \"\"\"Reach-BFS using the translation-based avatar detector (robust, slow).\"\"\"\n   147\t    return _reach_bfs(start_env, avatar_tl)\n   148\t\n   149\t\n   150\t# --------------------------------------------------------------------------\n   151\t# High level: reach the goal, unlocking gates with USE when plain movement is\n   152\t# not enough.  Bounded number of switch presses.\n   153\t# --------------------------------------------------------------------------\n   154\tdef plan_unlock_reach(env, max_toggles=2):\n   155\t    \"\"\"Return a concrete action list that raises levels_completed, or None.\n   156\t\n   157\t    Strategy: try to reach the reward by movement alone; if not, try pressing\n   158\t    USE at each reachable position (a candidate switch) and recurse with one\n   159\t    fewer toggle.  A USE that opens gates enlarges the reachable set on the next\n   160\t    round, letting movement finish the job.\n   161\t    \"\"\"\n   162\t    def rec(node, toggles_left):\n   163\t        reward_path, reach = _move_explore(node)\n   164\t        if reward_path is not None:\n   165\t            return reward_path\n   166\t        if toggles_left <= 0:\n   167\t            return None\n   168\t        # Only keep switches that CHANGE reachability (open new gates); a USE\n   169\t        # that grows nothing is pruned so the bounded DFS stays shallow.\n   170\t        cur_size = len(reach)\n   171\t        for macro, c, _rp, reach2 in _use_macros(node, reach, _move_explore):\n   172\t            if len(reach2) <= cur_size:\n   173\t                continue  # this USE did not open anything new; skip\n   174\t            sub = rec(c, toggles_left - 1)\n   175\t            if sub is not None:\n   176\t                return macro + sub\n   177\t        return None\n   178\t\n   179\t    return rec(env.clone(), max_toggles)\n   180\t\n   181\t\n   182\tdef run_path(env, path):\n   183\t    \"\"\"Commit a planned action list on the real env, stopping if it terminates.\"\"\"\n   184\t    for a in path:\n   185\t        if env.terminal():\n   186\t            break\n   187\t        env.step(a)\n   188\t\n   189\t\n   190\t# --------------------------------------------------------------------------\n   191\t# Higher-order leg: the recurring \"plan on a clone, then commit\" shape.  Every\n   192\t# solve_* leg is a planner (env -> action-list-or-None) wrapped by this.  Given\n   193\t# the hidden-state substrate, planning MUST happen on a clone and the resulting\n   194\t# concrete action list is what we replay on the real env.\n   195\t# --------------------------------------------------------------------------\n   196\tdef plan_and_commit(env, planner, **kwargs):\n   197\t    \"\"\"Run `planner` on a clone of `env`; if it yields a non-empty action list,\n   198\t    commit it on the real `env` and return True.  Otherwise return False and\n   199\t    leave `env` untouched.\"\"\"\n   200\t    plan = planner(clone_after(env, ()), **kwargs)\n   201\t    if not plan:\n   202\t        return False\n   203\t    run_path(env, plan)\n   204\t    return True\n   205\t\n   206\t\n   207\tdef solve_unlock_reach(env, max_toggles=2):\n   208\t    \"\"\"Leg: plan an unlock-then-reach route and commit it. Returns True if a\n   209\t    winning plan was found and committed.\"\"\"\n   210\t    return plan_and_commit(env, plan_unlock_reach, max_toggles=max_toggles)\n   211\t\n   212\t\n   213\t# --------------------------------------------------------------------------\n   214\t# Fast avatar position + reachability (no per-position re-cloning).\n   215\t#\n   216\t# `_move_explore`/`avatar_tl` call clone-heavy translation detection at every\n   217\t# node, which is too slow for the multi-USE search needed on later levels.\n   218\t# `_avatar_pos` reads the avatar straight from a frame (the largest compact\n   219\t# color-9 blob that is not full-width scenery), and `fast_reach` does a single\n   220\t# clone per (position,action) BFS edge, deduping on avatar position.  This is\n   221\t# valid within a FIXED gate configuration (movement is deterministic there).\n   222\t# --------------------------------------------------------------------------\n   223\tdef _avatar_pos(frame):\n   224\t    \"\"\"Top-left (row, col) of the avatar = largest compact color-9 blob that is\n   225\t    not a full-width border line.  Returns None if none found.\"\"\"\n   226\t    f = np.asarray(frame)\n   227\t    cand = [(tr, tc, cells) for tr, tc, cells in _components(f == 9)\n   228\t            if 5 < len(cells) < 40 and tr < f.shape[0] - 4]\n   229\t    if not cand:\n   230\t        return None\n   231\t    cand.sort(key=lambda c: -len(c[2]))\n   232\t    return (cand[0][0], cand[0][1])\n   233\t\n   234\t\n   235\tdef fast_reach(start):\n   236\t    \"\"\"Reach-BFS using the clone-cheap color-9-blob avatar reader (fast).\"\"\"\n   237\t    return _reach_bfs(start, lambda e: _avatar_pos(e.frame()))\n   238\t\n   239\t\n   240\t# --------------------------------------------------------------------------\n   241\t# The shared \"unlock macro\" transition.  All unlock planners advance the gate\n   242\t# configuration the same way: from a node, pick a currently-reachable tile,\n   243\t# walk there and press USE (a \"macro\"), yielding a child gate-config.  Cheapest\n   244\t# walks are tried first where a planner expands the full set.  Written ONCE\n   245\t# here; the planners differ only in how they FILTER / SCHEDULE / PRUNE these\n   246\t# successors.\n   247\t# --------------------------------------------------------------------------\n   248\tdef _use_macro(node, pos, path, reach_fn):\n   249\t    \"\"\"Apply one walk-to-position-then-USE transition and probe its result.\"\"\"\n   250\t    macro = path + [5]\n   251\t    child = clone_after(node, macro)\n   252\t    reward_path, child_reach = reach_fn(child)\n   253\t    return pos, macro, child, reward_path, child_reach\n   254\t\n   255\t\n   256\tdef _use_macros(node, reach, reach_fn):\n   257\t    \"\"\"Yield (macro, child_env, child_reward_path, child_reach) for every\n   258\t    \"walk to a reachable tile, then USE\" macro, cheapest walk first.\n   259\t      * macro              = walk move-path + [5] (USE)\n   260\t      * child_env          = clone of `node` after that macro\n   261\t      * child_reward_path  = winning move list from the child, or None\n   262\t      * child_reach        = child's reachable-position map\n   263\t    `reach_fn` is the reach-BFS to probe children with (must match `reach`).\"\"\"\n   264\t    for pos, path in sorted(reach.items(), key=lambda kv: len(kv[1])):\n   265\t        _, macro, child, reward_path, child_reach = _use_macro(\n   266\t            node, pos, path, reach_fn)\n   267\t        yield macro, child, reward_path, child_reach\n   268\t\n   269\t\n   270\t# --------------------------------------------------------------------------\n   271\t# General unlock-then-reach via USE-MACROS.\n   272\t#\n   273\t# On these levels a USE performed after walking somewhere resets the avatar to\n   274\t# its start BUT PRESERVES gates that were opened along the way (touching a wall\n   275\t# segment can open a remote gate).  Chaining such \"walk-somewhere-then-USE\"\n   276\t# macros accumulates opened gates until the goal becomes reachable by plain\n   277\t# movement.  We search best-first over the resulting reachable-position sets:\n   278\t# a macro = (walk to some reachable position P, press USE); the state key is the\n   279\t# frozenset of currently reachable positions.  Unlike `plan_unlock_reach`, we do\n   280\t# NOT require each individual USE to enlarge reachability -- an opening can take\n   281\t# several staged macros before it pays off -- so this handles deeper unlock\n   282\t# chains while staying deterministic and clone-bounded.\n   283\t# --------------------------------------------------------------------------\n   284\tdef plan_unlock_macro(env, max_expand=400, time_limit=550):\n   285\t    \"\"\"Return a concrete winning action list, or None.  Plans on clones only.\"\"\"\n   286\t    t0 = time.time()\n   287\t    rp0, reach0 = fast_reach(env)\n   288\t    if rp0 is not None:\n   289\t        return rp0\n   290\t    seen = {frozenset(reach0)}\n   291\t    # priority queue keyed by -reachable-count (explore the most-open configs\n   292\t    # first); cnt is a monotone tiebreaker so ordering stays deterministic.\n   293\t    pq = [(-len(reach0), 0, env.clone(), [])]\n   294\t    cnt = 1\n   295\t    while pq and cnt < max_expand and (time.time() - t0) < time_limit:\n   296\t        _, _, node, prefix = heapq.heappop(pq)\n   297\t        rp, reach = fast_reach(node)\n   298\t        if rp is not None:\n   299\t            return prefix + rp\n   300\t        for macro, c, rp2, reach2 in _use_macros(node, reach, fast_reach):\n   301\t            if rp2 is not None:\n   302\t                return prefix + macro + rp2\n   303\t            rk = frozenset(reach2)\n   304\t            if rk in seen:                             # same gate config seen\n   305\t                continue\n   306\t            seen.add(rk)\n   307\t            heapq.heappush(pq, (-len(reach2), cnt, c, prefix + macro))\n   308\t            cnt += 1\n   309\t    return None\n   310\t\n   311\t\n   312\tdef solve_unlock_macro(env, max_expand=400, time_limit=550):\n   313\t    \"\"\"Leg: plan a USE-macro unlock-then-reach route and commit it.  Returns\n   314\t    True iff a winning plan was found and committed.\"\"\"\n   315\t    return plan_and_commit(env, plan_unlock_macro,\n   316\t                           max_expand=max_expand, time_limit=time_limit)\n   317\t\n   318\t\n   319\t# --------------------------------------------------------------------------\n   320\t# Special-surface frontier unlock.\n   321\t#\n   322\t# Some configurations need a commit whose hidden effect is only exposed by a\n   323\t# later commit: the first commit need not enlarge the avatar's reachable set.\n   324\t# Searching every reachable tile makes that memory step needlessly broad.\n   325\t# The persistent mechanisms are visibly colored surfaces, so restrict USE\n   326\t# macros to avatar placements overlapping a non-UI/non-wall color.  Reachable\n   327\t# position count is the dense progress measure; a bounded structural-change\n   328\t# fallback bridges intermediate commits with no immediate reach growth.\n   329\t# --------------------------------------------------------------------------\n   330\tdef _special_frontier(reach, frame):\n   331\t    \"\"\"Reach entries whose 5x5 avatar footprint overlaps a special surface.\"\"\"\n   332\t    f = np.asarray(frame)\n   333\t    special = ~np.isin(f, (0, 1, 2, 5, 9))\n   334\t    out = []\n   335\t    for pos, path in reach.items():\n   336\t        r, c = pos\n   337\t        if special[r:r + 5, c:c + 5].any():\n   338\t            out.append((pos, path))\n   339\t    return sorted(out, key=lambda item: (len(item[1]), item[0]))\n   340\t\n   341\t\n   342\tdef plan_frontier_unlock(env, max_stages=10, max_stalls=2):\n   343\t    \"\"\"Plan staged USE commits by maximizing movement reachability.\n   344\t\n   345\t    Candidate commits are limited to reachable special-colored surfaces.  A\n   346\t    commit that grows the reachable-position set is always preferred.  When\n   347\t    none grows it, the shortest commit producing the largest persistent world\n   348\t    change is accepted, up to ``max_stalls`` times; this preserves hidden\n   349\t    intermediate state without exploding into an unrestricted macro tree.\n   350\t    \"\"\"\n   351\t    node = env.clone()\n   352\t    prefix = []\n   353\t    stalls = 0\n   354\t    seen = set()\n   355\t\n   356\t    for _ in range(max_stages):\n   357\t        reward_path, reach = fast_reach(node)\n   358\t        if reward_path is not None:\n   359\t            return prefix + reward_path\n   360\t\n   361\t        state_key = (frozenset(reach), np.asarray(node.frame())[7:-1].tobytes())\n   362\t        if state_key in seen:\n   363\t            return None\n   364\t        seen.add(state_key)\n   365\t\n   366\t        candidates = _special_frontier(reach, node.frame())\n   367\t        if not candidates:\n   368\t            candidates = sorted(reach.items(), key=lambda item: (len(item[1]), item[0]))\n   369\t\n   370\t        growth = []\n   371\t        changed = []\n   372\t        base_world = np.asarray(node.frame())[7:-1]\n   373\t        for pos, path in candidates:\n   374\t            _, macro, child, child_reward, child_reach = _use_macro(\n   375\t                node, pos, path, fast_reach)\n   376\t            if child_reward is not None:\n   377\t                return prefix + macro + child_reward\n   378\t\n   379\t            item = (len(child_reach), -len(macro), pos, macro, child, child_reach)\n   380\t            if len(child_reach) > len(reach):\n   381\t                growth.append(item)\n   382\t            else:\n   383\t                delta = int(np.count_nonzero(\n   384\t                    base_world != np.asarray(child.frame())[7:-1]))\n   385\t                if delta:\n   386\t                    changed.append((delta, -len(macro), pos, macro, child, child_reach))\n   387\t\n   388\t        if growth:\n   389\t            _, _, _, macro, node, _ = max(growth, key=lambda item: item[:3])\n   390\t            prefix += macro\n   391\t            stalls = 0\n   392\t            continue\n   393\t        if changed and stalls < max_stalls:\n   394\t            _, _, _, macro, node, _ = max(changed, key=lambda item: item[:3])\n   395\t            prefix += macro\n   396\t            stalls += 1\n   397\t            continue\n   398\t        return None\n   399\t    return None\n   400\t\n   401\t\n   402\tdef solve_frontier_unlock(env, max_stages=10, max_stalls=2):\n   403\t    \"\"\"Leg: plan and commit a special-surface frontier unlock route.\"\"\"\n   404\t    return plan_and_commit(env, plan_frontier_unlock,\n   405\t                           max_stages=max_stages, max_stalls=max_stalls)\n","exit_code":0,"status":"completed"}}
