{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,220p' probe_l7_baseline.py && rg -n '\"'^(class|def) |actions|levels_completed|load|solve'\"' gkm_try.py\"","aggregated_output":"import json\nimport sys\n\nsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\nimport gkm_arena as arena\n\nfrom legs import _avatar_pos\nfrom perception import action_deltas, color_counts, connected_components\n\n\ndef summary(env):\n    blobs = connected_components(\n        env.frame(), colors=(8, 9, 11, 14, 15), min_area=4\n    )\n    return (\n        int(env.levels_completed),\n        bool(env.terminal()),\n        _avatar_pos(env.frame()),\n        tuple((b.color, b.bbox, b.area) for b in blobs),\n    )\n\n\ndef tile_map(frame):\n    chars = {0: \".\", 1: \"1\", 5: \"#\", 8: \"G\", 9: \"A\",\n             11: \"S\", 14: \"B\", 15: \"X\"}\n    return \"/\".join(\n        \"\".join(chars.get(int(frame[r + 2][c + 2]), \"?\")\n                for c in range(2, 62, 6))\n        for r in range(2, 62, 6)\n    )\n\n\ndef probe(env):\n    with open(\"checkpoint.json\") as fh:\n        checkpoint = json.load(fh)[\"final_path\"]\n    for action in checkpoint:\n        env.step(action)\n    print(\"base\", env.actions, color_counts(env.frame()), summary(env))\n    print(\"map\", tile_map(env.frame()))\n    deltas = action_deltas(env, env.actions)\n    for action in env.actions:\n        child = env.clone()\n        child.step(action)\n        delta = deltas[action]\n        print(\n            \"act\",\n            action,\n            (delta[\"count\"], delta[\"bbox\"]),\n            summary(child),\n        )\n\n\nlevels, path, err = arena.run_program(\"g50t\", probe)\nprint(\"result\", levels, len(path), err)\n8:spec = importlib.util.spec_from_file_location(\"solve\", \"solve.py\")\n9:m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\n10:def resumed_solve(env):\n14:            ck = json.load(f)\n18:    m.solve(env)\n19:levels, path, err = A.run_program('g50t', resumed_solve)\n","exit_code":0,"status":"completed"}}
