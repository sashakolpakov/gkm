{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,90p' gkm_try.py\nsed -n '1,30p' solve.py\nwc -l probe_clock.py probe_coop.py probe_handoffs.py probe_macro_search.py probe_previous_goal.py probe_routes.py probe_wedge.py\"","aggregated_output":"import importlib.util, json, os, sys\nsys.path.insert(0, '/Users/sasha/gkm/arc/crack_lab')\nimport gkm_legs as G\nimport gkm_arena as A\ntaint_reason = G._workspace_taint_reason(os.getcwd())\nif taint_reason:\n    raise SystemExit(f\"TAINTED WORKSPACE: {taint_reason}\")\nspec = importlib.util.spec_from_file_location(\"solve\", \"solve.py\")\nm = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\ndef resumed_solve(env):\n    ck = None\n    if os.path.exists(\"checkpoint.json\"):\n        with open(\"checkpoint.json\") as f:\n            ck = json.load(f)\n    if ck and ck.get(\"game\") == 'm0r0' and ck.get(\"validated\") and ck.get(\"final_path\"):\n        for act in ck[\"final_path\"]:\n            env.step(act)\n    m.solve(env)\nlevels, path, err = A.run_program('m0r0', resumed_solve)\nok = A.validate('m0r0', path, levels) if path else False\nprint(f\"RESULT levels={levels} moves={len(path)} replay_ok={ok} err={err}\")\nimport players\n\ndef solve(env):\n    # dispatch to the per-level player for the current level, in a loop\n    while not env.terminal():\n        k = env.levels_completed + 1\n        fn = getattr(players, f'play_level_{k}', None)\n        if fn is None:\n            return\n        before = env.levels_completed\n        fn(env)\n        if env.levels_completed <= before:\n            return  # no progress -> stop\n      35 probe_clock.py\n      34 probe_coop.py\n      73 probe_handoffs.py\n      99 probe_macro_search.py\n      36 probe_previous_goal.py\n      58 probe_routes.py\n      44 probe_wedge.py\n     379 total\n","exit_code":0,"status":"completed"}}
