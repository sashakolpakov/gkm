{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/zsh -lc \"nl -ba legs.py | sed -n '1,54p'; nl -ba solve.py | sed -n '1,30p'; nl -ba perception.py | sed -n '48,112p'\"","aggregated_output":"     1\t# Shared leg library: small, named, reusable skills.\n     2\t# Players import from here; add a NEW leg only when no existing leg fits.\n     3\t\n     4\tfrom perception import connected_components\n     5\t\n     6\t\n     7\tUP, DOWN, RETRACT, EXTEND = 1, 2, 3, 4\n     8\t\n     9\t\n    10\tdef move_vertical_lanes(env, direction, lanes):\n    11\t    \"\"\"Move the avatar and any attached horizontal train by whole lanes.\"\"\"\n    12\t    for _ in range(lanes):\n    13\t        if env.terminal():\n    14\t            return\n    15\t        env.step(direction)\n    16\t\n    17\t\n    18\tdef extend_tether(env, steps):\n    19\t    \"\"\"Extend the tether, pushing its attached train toward a new token.\"\"\"\n    20\t    for _ in range(steps):\n    21\t        if env.terminal():\n    22\t            return\n    23\t        env.step(EXTEND)\n    24\t\n    25\t\n    26\tdef retract_tether(env, steps):\n    27\t    \"\"\"Retract the tether, pulling a contacted token into the train.\"\"\"\n    28\t    for _ in range(steps):\n    29\t        if env.terminal():\n    30\t            return\n    31\t        env.step(RETRACT)\n    32\t\n    33\t\n    34\tdef reverse_row_train(env, approach_lanes, stages, final_extension):\n    35\t    \"\"\"Reverse a token row by staging each unwanted prefix one lane lower.\n    36\t\n    37\t    Each stage is ``(prefix_span, wall_reach, compact_steps)``.  The extended\n    38\t    train pushes the prefix down, then collects the exposed token against the\n    39\t    right wall before descending to repeat on the staged prefix.\n    40\t    \"\"\"\n    41\t    move_vertical_lanes(env, UP, approach_lanes)\n    42\t    for prefix_span, wall_reach, compact_steps in stages:\n    43\t        extend_tether(env, prefix_span)\n    44\t        move_vertical_lanes(env, DOWN, 1)\n    45\t        move_vertical_lanes(env, UP, 1)\n    46\t        retract_tether(env, prefix_span)\n    47\t        move_vertical_lanes(env, DOWN, 1)\n    48\t        extend_tether(env, wall_reach)\n    49\t        retract_tether(env, compact_steps)\n    50\t\n    51\t    move_vertical_lanes(env, DOWN, 1)\n    52\t    extend_tether(env, final_extension)\n    53\t\n    54\t\n     1\timport players\n     2\t\n     3\tdef solve(env):\n     4\t    # dispatch to the per-level player for the current level, in a loop\n     5\t    while not env.terminal():\n     6\t        k = env.levels_completed + 1\n     7\t        fn = getattr(players, f'play_level_{k}', None)\n     8\t        if fn is None:\n     9\t            return\n    10\t        before = env.levels_completed\n    11\t        fn(env)\n    12\t        if env.levels_completed <= before:\n    13\t            return  # no progress -> stop\n    48\tdef connected_components(frame, colors: Optional[Iterable[int]] = None,\n    49\t                         min_area: int = 1) -> List[Blob]:\n    50\t    f = arr(frame)\n    51\t    wanted = None if colors is None else {int(c) for c in colors}\n    52\t    seen = np.zeros(f.shape, dtype=bool)\n    53\t    out: List[Blob] = []\n    54\t    rows, cols = f.shape[:2]\n    55\t    for r in range(rows):\n    56\t        for c in range(cols):\n    57\t            if seen[r, c]:\n    58\t                continue\n    59\t            color = int(f[r, c])\n    60\t            if wanted is not None and color not in wanted:\n    61\t                seen[r, c] = True\n    62\t                continue\n    63\t            q = [(r, c)]\n    64\t            seen[r, c] = True\n    65\t            pts = []\n    66\t            while q:\n    67\t                x, y = q.pop()\n    68\t                pts.append((x, y))\n    69\t                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n    70\t                    nx, ny = x + dx, y + dy\n    71\t                    if 0 <= nx < rows and 0 <= ny < cols and not seen[nx, ny] and int(f[nx, ny]) == color:\n    72\t                        seen[nx, ny] = True\n    73\t                        q.append((nx, ny))\n    74\t            if len(pts) >= min_area:\n    75\t                rs = [p[0] for p in pts]\n    76\t                cs = [p[1] for p in pts]\n    77\t                out.append(Blob(color, (min(rs), min(cs), max(rs), max(cs)),\n    78\t                                len(pts), (sum(rs) / len(pts), sum(cs) / len(pts))))\n    79\t    return sorted(out, key=lambda b: (b.color, b.bbox))\n    80\t\n    81\t\n    82\tdef block_signatures(frame, cell: int = 4) -> Dict[Tuple[int, int], Tuple[int, ...]]:\n    83\t    \"\"\"Partition a frame into fixed cells and return each cell's color signature.\"\"\"\n    84\t    f = arr(frame)\n    85\t    out = {}\n    86\t    for r in range(0, f.shape[0], cell):\n    87\t        for c in range(0, f.shape[1], cell):\n    88\t            out[(r // cell, c // cell)] = tuple(int(v) for v in sorted(np.unique(f[r:r+cell, c:c+cell])))\n    89\t    return out\n    90\t\n    91\t\n    92\tdef object_candidates(frame, cell: int = 4, min_area: int = 4) -> List[dict]:\n    93\t    \"\"\"A compact, game-agnostic object list from color components and cell signatures.\"\"\"\n    94\t    f = arr(frame)\n    95\t    blobs = connected_components(f, min_area=min_area)\n    96\t    sigs = block_signatures(f, cell)\n    97\t    objects = []\n    98\t    for b in blobs:\n    99\t        r0, c0, r1, c1 = b.bbox\n   100\t        objects.append({\n   101\t            \"color\": b.color,\n   102\t            \"bbox\": b.bbox,\n   103\t            \"top_left\": b.top_left,\n   104\t            \"size\": b.size,\n   105\t            \"area\": b.area,\n   106\t            \"centroid\": b.centroid,\n   107\t            \"cell\": (r0 // cell, c0 // cell),\n   108\t            \"cell_sig\": sigs.get((r0 // cell, c0 // cell)),\n   109\t        })\n   110\t    return objects\n   111\t\n   112\t\n","exit_code":0,"status":"completed"}}
