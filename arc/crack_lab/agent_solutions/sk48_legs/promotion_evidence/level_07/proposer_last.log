contact completes the requested train.\n    17\t    move_vertical_lanes(env, UP, 2)\n    18\t    move_vertical_lanes(env, DOWN, 1)\n    19\t    extend_tether(env, 3)\n    20\t\n    21\t\n    22\tdef play_level_2(env):\n    23\t    reverse_row_train(\n    24\t        env,\n    25\t        approach_lanes=4,\n    26\t        stages=((5, 6, 6), (4, 6, 5), (2, 5, 4)),\n    27\t        final_extension=4,\n    28\t    )\n    29\t\n    30\t\n    31\tdef play_level_3(env):\n    32\t    weave_vertical_four_train(env)\n    33\t\n    34\t\n    35\tdef play_level_4(env):\n    36\t    unweave_horizontal_pairs_to_vertical_heads(env)\n    37\t\n    38\t\n    39\tdef play_level_5(env):\n    40\t    stage_split_rows_for_lower_interleave(env)\n    41\t    interleave_lower_lane_train(env)\n    42\t\n    43\t\n    44\tdef play_level_6(env):\n    45\t    deal_vertical_triplet_to_top_collector(env)\n    46\t    shuttle_row_tokens_under_vertical_train(env)\n   205\t    # Raise the first endpoint into the gap and thread the finished train.\n   206\t    move_vertical_lanes(env, DOWN, 2)\n   207\t    extend_tether(env, 5)\n   208\t    move_vertical_lanes(env, UP, 1)\n   209\t    retract_tether(env, 1)\n   210\t    move_vertical_lanes(env, UP, 1)\n   211\t    extend_tether(env, 3)\n   212\t\n   213\t\n   214\tdef repeat_action(env, action, count):\n   215\t    \"\"\"Apply one opaque action a bounded number of times.\"\"\"\n   216\t    for _ in range(count):\n   217\t        if env.terminal():\n   218\t            return\n   219\t        env.step(action)\n   220\t\n   221\t\n   222\tdef select_live_collector(env, color, edge):\n   223\t    \"\"\"Select the live collector of ``color`` nearest the named room edge.\"\"\"\n   224\t    if env.terminal():\n   225\t        return\n   226\t    heads = [\n   227\t        blob\n   228\t        for blob in connected_components(\n   229\t            env.frame(), colors=(color,), min_area=16\n   230\t        )\n   231\t        if blob.centroid[0] < 53\n   232\t    ]\n   233\t    if not heads:\n   234\t        raise RuntimeError(f\"live collector color {color} not found\")\n   235\t    head = min(\n   236\t        heads,\n   237\t        key=lambda blob: (\n   238\t            blob.centroid[1] if edge == \"left\" else blob.centroid[0]\n   239\t        ),\n   240\t    )\n   241\t    env.step(6, round(head.centroid[1]), round(head.centroid[0]))\n   242\t\n   243\t\n   244\tdef deal_vertical_triplet_to_top_collector(env):\n   245\t    \"\"\"Deal a vertical triplet onto the perpendicular top collector.\n   246\t\n   247\t    The left collector hooks each token against the right wall, carries it to\n   248\t    its final row, and releases it into the growing top-owned vertical train.\n   249\t    \"\"\"\n   250\t    # Hook the nearest token and carry it to the first top-tether slot.\n   251\t    move_vertical_lanes(env, DOWN, 1)\n   252\t    extend_tether(env, 6)\n   253\t    retract_tether(env, 4)\n   254\t    move_vertical_lanes(env, UP, 2)\n   255\t    extend_tether(env, 1)\n   256\t    move_vertical_lanes(env, UP, 2)\n   257\t    retract_tether(env, 3)\n   258\t    select_live_collector(env, 15, \"top\")\n   259\t    repeat_action(env, DOWN, 1)\n   260\t    repeat_action(env, UP, 1)\n   261\t    select_live_collector(env, 6, \"left\")\n   262\t\n   263\t    # The next two tokens use the first token as the top collector's prefix.\n   264\t    for index in range(2):\n   265\t        if index:\n   266\t            select_live_collector(env, 6, \"left\")\n   267\t        move_vertical_lanes(env, DOWN, 5)\n   268\t        extend_tether(env, 6)\n   269\t        retract_tether(env, 4)\n   270\t        move_vertical_lanes(env, UP, 4)\n   271\t        extend_tether(env, 1)\n   272\t        select_live_collector(env, 15, \"top\")\n   273\t        repeat_action(env, DOWN, 1)\n   274\t        select_live_collector(env, 6, \"left\")\n   275\t        retract_tether(env, 3)\n   276\t\n   277\t\n   278\tdef shuttle_row_tokens_under_vertical_train(\n   279\t    env,\n   280\t    stages=((1, 5, 6), (2, 6, 5), (3, 5, 3)),\n   281\t):\n   282\t    \"\"\"Grow a left-owned row using a finished vertical train as a lift.\n   283\t\n   284\t    Each stage is ``(right_shift, wall_reach, compact_steps)``.  The top\n   285\t    collector lowers the next row token to the clear bottom lane and restores\n   286\t    its vertical train.  The left collector carries its existing prefix down,\n   287\t    hooks the new token at the wall, compacts the enlarged train, and returns.\n   288\t    \"\"\"\n   289\t    # Return the left collector to the token row and restore its short tether.\n   290\t    move_vertical_lanes(env, DOWN, 1)\n   291\t    extend_tether(env, 1)\n   292\t\n   293\t    for right_shift, wall_reach, compact_steps in stages:\n   294\t        select_live_collector(env, 15, \"top\")\n   295\t        repeat_action(env, EXTEND, right_shift)\n   296\t\n   297\t        # Push the four-token column to the floor, then leave only its bottom\n   298\t        # token there while returning the three-token carrier to the top.\n   299\t        repeat_action(env, DOWN, 3)\n   300\t        repeat_action(env, UP, 3)\n   301\t        repeat_action(env, RETRACT, right_shift)\n   302\t\n   303\t        select_live_collector(env, 6, \"left\")\n   304\t        move_vertical_lanes(env, DOWN, 3)\n   305\t        extend_tether(env, wall_reach)\n   306\t        retract_tether(env, compact_steps)\n   307\t        move_vertical_lanes(env, UP, 3)\n     1\t\"\"\"Source-free frame perception helpers for cracking.\n     2\t\n     3\tThis module is deliberately observational: it derives compact symbolic state\n     4\tfrom `env.frame()` and `env.clone()` only. It is a cofibration-style scaffold:\n     5\traw pixels are embedded into a monotone tower of reusable observations\n     6\t(components -> objects -> action deltas -> replay states). Candidate level\n     7\tlogic should be written against these quotients, then replay-validated by the\n     8\tharness. No game source or prior solution history is read here.\n     9\t\"\"\"\n    10\tfrom collections import deque\n    11\tfrom dataclasses import dataclass\n    12\tfrom typing import Dict, Iterable, List, Optional, Sequence, Tuple\n    13\t\n    14\timport numpy as np\n    15\t\n    16\tUP, DOWN, LEFT, RIGHT, USE = 1, 2, 3, 4, 5\n    17\tACTIONS = (UP, DOWN, LEFT, RIGHT, USE)\n    18\tDIRS = {UP: (-1, 0), DOWN: (1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\n    19\tACTION_NAME = {UP: \"UP\", DOWN: \"DOWN\", LEFT: \"LEFT\", RIGHT: \"RIGHT\", USE: \"USE\"}\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Blob:\n    24\t    color: int\n    25\t    bbox: Tuple[int, int, int, int]  # r0, c0, r1, c1 inclusive\n    26\t    area: int\n    27\t    centroid: Tuple[float, float]\n    28\t\n    29\t    @property\n    30\t    def top_left(self):\n    31\t        return self.bbox[0], self.bbox[1]\n    32\t\n    33\t    @property\n    34\t    def size(self):\n    35\t        r0, c0, r1, c1 = self.bbox\n    36\t        return r1 - r0 + 1, c1 - c0 + 1\n    37\t\n    38\t\n    39\tdef arr(frame) -> np.ndarray:\n    40\t    return np.asarray(frame)\n    41\t\n    42\t\n    43\tdef color_counts(frame) -> Dict[int, int]:\n    44\t    vals, cnts = np.unique(arr(frame), return_counts=True)\n    45\t    return {int(v): int(c) for v, c in zip(vals, cnts)}\n   113\tdef frame_delta(before, after) -> dict:\n   114\t    a, b = arr(before), arr(after)\n   115\t    ys, xs = np.where(a != b)\n   116\t    if len(ys) == 0:\n   117\t        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n   118\t    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n   119\t    return {\n   120\t        \"count\": int(len(ys)),\n   121\t        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n   122\t        \"samples\": samples,\n   123\t    }\n   124\t\n   125\t\n   126\tdef action_deltas(env, actions: Sequence[int] = ACTIONS) -> Dict[int, dict]:\n   127\t    base = arr(env.frame()).copy()\n   128\t    out = {}\n   129\t    for action in actions:\n   130\t        clone = env.clone()\n   131\t        clone.step(action)\n   132\t        out[int(action)] = frame_delta(base, clone.frame())\n   133\t    return out\n   134\t\n   135\t\n   136\tdef replay(env, actions: Sequence[int]):\n   137\t    clone = env.clone()\n   138\t    for action in actions:\n   139\t        if clone.terminal():\n   140\t            break\n   141\t        clone.step(int(action))\n   142\t    return clone\n   143\t\n   144\t\n   145\tdef path_result(env, actions: Sequence[int]) -> dict:\n   146\t    clone = replay(env, actions)\n   147\t    return {\n   148\t        \"levels_completed\": int(clone.levels_completed),\n   149\t        \"terminal\": bool(clone.terminal()),\n   150\t        \"path_len\": len(actions),\n   151\t        \"colors\": color_counts(clone.frame()),\n   152\t        \"objects\": object_candidates(clone.frame()),\n   153\t    }\n   154\t\n   155\t\n   156\tdef changed_signature(env, actions: Sequence[int], cell: int = 4):\n   157\t    before = block_signatures(env.frame(), cell)\n   158\t    clone = replay(env, actions)\n   159\t    after = block_signatures(clone.frame(), cell)\n   160\t    return {k: (before.get(k), after.get(k)) for k in sorted(set(before) | set(after))\n   161\t            if before.get(k) != after.get(k)}\n   162\t\n   163\t\n   164\tdef bounded_bfs(env, goal_fn, actions: Sequence[int] = (UP, DOWN, LEFT, RIGHT, USE),\n   165\t                key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   166\t    \"\"\"Generic clone BFS over observational keys. Use small max_states first.\"\"\"\n   167\t    if key_fn is None:\n   168\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   169\t    start_key = key_fn(env)\n   170\t    q = deque([(env.clone(), [])])\n   171\t    seen = {start_key}\n   172\t    while q and len(seen) <= max_states:\n   173\t        node, path = q.popleft()\n   174\t        if goal_fn(node, path):\n   175\t            return path\n   176\t        if len(path) >= max_depth:\n   177\t            continue\n   178\t        for action in actions:\n   179\t            child = node.clone()\n   180\t            child.step(int(action))\n   181\t            key = key_fn(child)\n   182\t            if key in seen:\n   183\t                continue\n   184\t            seen.add(key)\n   185\t            q.append((child, path + [int(action)]))\n   186\t    return None\n   187\t\n   188\t\n   189\tdef bounded_replay_bfs(env, goal_fn, action_fn,\n   190\t                       key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   191\t    \"\"\"Path-only BFS for games whose deep Arena clones become expensive.\n   192\t\n   193\t    The queue retains compact action paths, not recursively deep-copied runtime\n   194\t    states. Each node is reconstructed from one root clone. ``action_fn(node)``\n   195\t    may return integer actions or coordinate tuples such as ``(6, x, y)``.\n   196\t    \"\"\"\n   197\t    if key_fn is None:\n   198\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   199\t\n   200\t    def reconstruct(path):\n   201\t        node = env.clone()\n   202\t        for action in path:\n   203\t            if isinstance(action, tuple):\n   204\t                node.step(*action)\n   205\t            else:\n   206\t                node.step(int(action))\n   207\t        return node\n   208\t\n   209\t    start = reconstruct([])\n   210\t    q = deque([[]])\n   211\t    seen = {key_fn(start)}\n   212\t    while q and len(seen) <= max_states:\n   213\t        path = q.popleft()\n   214\t        node = reconstruct(path)\n   215\t        if goal_fn(node, path):\n   216\t            return path\n   217\t        if len(path) >= max_depth or node.terminal():\n   218\t            continue\n   219\t        for action in action_fn(node):\n   220\t            child_path = path + [action]\n   221\t            child = reconstruct(child_path)\n   222\t            key = key_fn(child)\n   223\t            if key in seen:\n   224\t                continue\n   225\t            seen.add(key)\n   226\t            if goal_fn(child, child_path):\n   227\t                return child_path\n   228\t            q.append(child_path)\n   229\t    return None\n   230\t\n   231\t\n   232\tdef level_goal(base_level: int):\n   233\t    return lambda env, path: env.levels_completed > base_level\n","exit_code":0,"status":"completed"}}
