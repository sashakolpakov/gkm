(42, ((8, 25, 36), (8, 25, 48), (8, 31, 42), (9, 19, 12), (9, 19, 36), (9, 25, 42))) 4\nPROBE 2 5 (42, ((8, 25, 36), (8, 25, 48), (8, 31, 42), (9, 19, 12), (9, 19, 36), (9, 25, 42))) 4\nPROBE 2 6 (42, ((8, 25, 36), (8, 25, 48), (8, 31, 42), (9, 19, 12), (9, 19, 36), (9, 25, 42))) 4\nPROBE 4 1 (30, ((8, 25, 36), (8, 25, 48), (8, 31, 48), (9, 19, 12), (9, 19, 36), (9, 25, 42))) 4\nPROBE 4 2 (30, ((8, 25, 36), (8, 25, 48), (8, 31, 48), (9, 19, 12), (9, 19, 36), (9, 25, 42))) 4\nPROBE 4 3 (30, ((8, 25, 36), (8, 25, 48), (8, 31, 48), (9, 19, 12), (9, 19, 36), (9, 25, 42))) 4\nPROBE 4 4 (30, ((8, 25, 36), (8, 25, 48), (8, 31, 48), (9, 19, 12), (9, 19, 36), (9, 25, 42))) 4\nPROBE 4 5 (30, ((8, 25, 36), (8, 25, 48), (8, 31, 48), (9, 19, 12), (9, 19, 36), (9, 25, 42))) 4\nPROBE 4 6 (30, ((8, 25, 36), (8, 25, 48), (8, 31, 48), (9, 19, 12), (9, 19, 36), (9, 25, 42))) 4\nEND 4 243 None\n","exit_code":0,"status":"completed"}}
