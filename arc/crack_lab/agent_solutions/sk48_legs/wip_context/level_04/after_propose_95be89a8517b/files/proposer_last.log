{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc \"MPLCONFIGDIR=/tmp/gkm_mpl python - <<'PY'\nimport sys\nsys.path.insert(0, '/Users/sasha/gkm/arc/crack_lab')\nimport gkm_arena as A\nfrom players import play_level_1, play_level_2, play_level_3\nfrom perception import connected_components\n\ndef pieces(env):\n    out=[]\n    for b in connected_components(env.frame(), colors=(8,9,12,14), min_area=4):\n        out.append((b.color,b.bbox[0],b.bbox[1]))\n    return tuple(out)\nclass Watch:\n    def __init__(self, env): self.env=env\n    def terminal(self): return self.env.terminal()\n    def step(self,*action):\n        level=self.env.levels_completed; before=pieces(self.env)\n        self.env.step(*action)\n        if self.env.levels_completed>level:\n            print('WIN',level+1,'ACTION',action,'BEFORE',before)\ndef inspect(env):\n    w=Watch(env)\n    for player in (play_level_1,play_level_2,play_level_3): player(w)\nA.run_program('sk48',inspect)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
