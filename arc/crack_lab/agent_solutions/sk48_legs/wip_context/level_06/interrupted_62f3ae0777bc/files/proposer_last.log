{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"wc -l gkm_try.py probe_l6.py probe_l6_interleave.py probe_l6_ownership.py probe_l6_paths.py search_l6.py search_l6_coop.py search_l6_finish.py && sed -n '1,180p' gkm_try.py\"","aggregated_output":"      21 gkm_try.py\n      66 probe_l6.py\n     195 probe_l6_interleave.py\n     151 probe_l6_ownership.py\n     240 probe_l6_paths.py\n      64 search_l6.py\n     105 search_l6_coop.py\n     144 search_l6_finish.py\n     986 total\nimport importlib.util, json, os, sys\nsys.path.insert(0, '/Users/sasha/gkm/arc/crack_lab')\nimport gkm_legs as G\nimport gkm_arena as A\ntaint_reason = G._workspace_taint_reason(os.getcwd())\nif taint_reason:\n    raise SystemExit(f\"TAINTED WORKSPACE: {taint_reason}\")\nspec = importlib.util.spec_from_file_location(\"solve\", \"solve.py\")\nm = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\ndef resumed_solve(env):\n    ck = None\n    if os.path.exists(\"checkpoint.json\"):\n        with open(\"checkpoint.json\") as f:\n            ck = json.load(f)\n    if ck and ck.get(\"game\") == 'sk48' and ck.get(\"validated\") and ck.get(\"final_path\"):\n        for act in ck[\"final_path\"]:\n            env.step(act)\n    m.solve(env)\nlevels, path, err = A.run_program('sk48', resumed_solve)\nok = A.validate('sk48', path, levels) if path else False\nprint(f\"RESULT levels={levels} moves={len(path)} replay_ok={ok} err={err}\")\n","exit_code":0,"status":"completed"}}
