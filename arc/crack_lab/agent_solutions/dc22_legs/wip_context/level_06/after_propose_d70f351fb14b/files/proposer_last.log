{"type":"item.completed","item":{"id":"item_229","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_l6_component_planner.py | sed -n '1,290p'\"","aggregated_output":"     1\t\"\"\"Shortest-path search over level-6 walking components and visible controls.\"\"\"\n     2\tfrom collections import deque\n     3\timport heapq\n     4\timport itertools\n     5\timport sys\n     6\t\n     7\timport numpy as np\n     8\t\n     9\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n    10\t\n    11\timport gkm_arena as arena\n    12\t\n    13\timport perception\n    14\timport solve\n    15\t\n    16\t\n    17\tA = (6, 56, 8)\n    18\tB = (6, 50, 26)\n    19\tS = (6, 50, 46)\n    20\tDPAD = {\n    21\t    (56, 34): (\"U\", (6, 50, 34)),\n    22\t    (60, 34): (\"D\", (6, 50, 40)),\n    23\t    (58, 32): (\"L\", (6, 46, 36)),\n    24\t    (58, 36): (\"R\", (6, 54, 36)),\n    25\t}\n    26\tPORTALS = {\n    27\t    (4, 4),\n    28\t    (48, 18),\n    29\t    (52, 32),\n    30\t    (58, 34),\n    31\t}\n    32\t\n    33\t\n    34\tdef step(env, action):\n    35\t    env.step(*action) if isinstance(action, tuple) else env.step(action)\n    36\t\n    37\t\n    38\tdef avatar(env):\n    39\t    frame = perception.arr(env.frame())[:62, :40]\n    40\t    mask = frame == 14\n    41\t    squares = np.argwhere(\n    42\t        mask[:-1, :-1]\n    43\t        & mask[1:, :-1]\n    44\t        & mask[:-1, 1:]\n    45\t        & mask[1:, 1:]\n    46\t    )\n    47\t    if len(squares):\n    48\t        return tuple(int(value) for value in squares[0])\n    49\t    return None\n    50\t\n    51\t\n    52\tdef visible_key(env):\n    53\t    return perception.arr(env.frame())[:63].tobytes()\n    54\t\n    55\t\n    56\tdef solid_exits(env):\n    57\t    return tuple(\n    58\t        blob.bbox\n    59\t        for blob in perception.connected_components(\n    60\t            env.frame(), colors=(11,), min_area=4\n    61\t        )\n    62\t        if blob.area == 4\n    63\t        and blob.size == (2, 2)\n    64\t        and blob.bbox[1] < 40\n    65\t    )\n    66\t\n    67\t\n    68\tdef interaction_region(position):\n    69\t    if position is None:\n    70\t        return (\"hidden\",)\n    71\t    if position in PORTALS:\n    72\t        return (\"portal\", position)\n    73\t    row, col = position\n    74\t    if row >= 54 and col >= 30:\n    75\t        return (\"controller\", position)\n    76\t    if row < 14:\n    77\t        return (\"top\",)\n    78\t    if 24 <= row < 44:\n    79\t        return (\"rotator\", position)\n    80\t    if row >= 44 and col < 18:\n    81\t        return (\"phased_bridge\", position)\n    82\t    if row >= 44 and col >= 18:\n    83\t        return (\"hub\",)\n    84\t    return (\"upper\",)\n    85\t\n    86\t\n    87\tdef outcome_signature(before_frame, child):\n    88\t    \"\"\"Ignore avatar redraws while retaining real control-state changes.\"\"\"\n    89\t    after_frame = perception.arr(child.frame())[:63]\n    90\t    changed = before_frame != after_frame\n    91\t    changed &= before_frame != 14\n    92\t    changed &= after_frame != 14\n    93\t    rows, cols = np.where(changed)\n    94\t    delta = tuple(\n    95\t        (int(row), int(col), int(after_frame[row, col]))\n    96\t        for row, col in zip(rows, cols)\n    97\t    )\n    98\t    return delta, interaction_region(avatar(child))\n    99\t\n   100\t\n   101\tdef walk_closure(root, base_level):\n   102\t    \"\"\"Return one exact clone/path for each avatar position in this component.\"\"\"\n   103\t    queue = deque([(root.clone(), [])])\n   104\t    by_position = {}\n   105\t    while queue and len(by_position) < 120:\n   106\t        node, path = queue.popleft()\n   107\t        position = avatar(node)\n   108\t        if position in by_position:\n   109\t            continue\n   110\t        by_position[position] = (node, path)\n   111\t        for direction in (1, 2, 3, 4):\n   112\t            child = node.clone()\n   113\t            child.step(direction)\n   114\t            child_path = path + [direction]\n   115\t            if child.levels_completed > base_level:\n   116\t                return by_position, child_path\n   117\t            if avatar(child) not in by_position:\n   118\t                queue.append((child, child_path))\n   119\t    return by_position, None\n   120\t\n   121\t\n   122\tdef control_sites(by_position):\n   123\t    \"\"\"Yield the contexts that can differ under each visible control.\"\"\"\n   124\t    positioned = [\n   125\t        (position, node_path)\n   126\t        for position, node_path in by_position.items()\n   127\t        if position is not None\n   128\t    ]\n   129\t    if not positioned:\n   130\t        return\n   131\t\n   132\t    # A changes the phased bridges globally, and can also move an avatar\n   133\t    # occupying the lower incremental bridge.\n   134\t    canonical_position, canonical = min(positioned)\n   135\t    yield \"A\", canonical, A\n   136\t    for position, node_path in positioned:\n   137\t        row, col = position\n   138\t        if row >= 54 and col < 22:\n   139\t            yield \"A\", node_path, A\n   140\t\n   141\t    # S advances the destination globally.  Retain portal occupancy because\n   142\t    # the selected endpoint can move beneath the avatar.\n   143\t    yield \"S\", canonical, S\n   144\t    for position, node_path in positioned:\n   145\t        if position in PORTALS:\n   146\t            yield \"S\", node_path, S\n   147\t\n   148\t    # Away from a portal, the reproduced context matrix has one global B\n   149\t    # outcome (some occupied cells merely block it).  Keep a few ordered\n   150\t    # representatives so at least one is an active cell, plus every portal.\n   151\t    for _, node_path in sorted(positioned)[:4]:\n   152\t        yield \"B\", node_path, B\n   153\t    for position, node_path in positioned:\n   154\t        if position in PORTALS:\n   155\t            yield \"B\", node_path, B\n   156\t\n   157\t    # Ring motion is enabled only at the matching arm of the remote D-pad.\n   158\t    for position, node_path in positioned:\n   159\t        if position in DPAD:\n   160\t            label, point = DPAD[position]\n   161\t            yield label, node_path, point\n   162\t\n   163\t\n   164\tdef observe(env):\n   165\t    solve.solve(env)\n   166\t    base_level = env.levels_completed\n   167\t    counter = itertools.count()\n   168\t    heap = [(0, next(counter), env.clone(), [])]\n   169\t    seen_components = set()\n   170\t    enqueued_frames = {visible_key(env)}\n   171\t    best = (10**9, -1, -1)\n   172\t\n   173\t    while heap and len(seen_components) < 5000:\n   174\t        _, _, root, root_path = heapq.heappop(heap)\n   175\t        by_position, winning_walk = walk_closure(root, base_level)\n   176\t        if winning_walk is not None:\n   177\t            print(\"PLANNER_WIN\", root_path + winning_walk, flush=True)\n   178\t            return\n   179\t\n   180\t        exact_states = list(by_position.values())\n   181\t        component_key = min(visible_key(node) for node, _ in exact_states)\n   182\t        if component_key in seen_components:\n   183\t            continue\n   184\t        seen_components.add(component_key)\n   185\t        if len(seen_components) <= 10 or len(by_position) > 70:\n   186\t            print(\n   187\t                \"PLANNER_NODE\", len(seen_components), len(heap),\n   188\t                \"positions\", len(by_position),\n   189\t                \"path_len\", len(root_path), flush=True,\n   190\t            )\n   191\t\n   192\t        exits = sorted({\n   193\t            exit_box\n   194\t            for node, _ in exact_states\n   195\t            for exit_box in solid_exits(node)\n   196\t        })\n   197\t        positions = [\n   198\t            position for position in by_position\n   199\t            if position is not None\n   200\t        ]\n   201\t        metric = (\n   202\t            min(position[0] for position in positions),\n   203\t            max(position[1] for position in positions),\n   204\t            len(positions),\n   205\t        )\n   206\t        if exits:\n   207\t            print(\n   208\t                \"PLANNER_EXIT\", root_path, exits, metric,\n   209\t                \"states\", len(seen_components), flush=True,\n   210\t            )\n   211\t        improved = (\n   212\t            metric[0] < best[0]\n   213\t            or metric[1] > best[1]\n   214\t            or metric[2] > best[2]\n   215\t        )\n   216\t        if improved:\n   217\t            best = (\n   218\t                min(best[0], metric[0]),\n   219\t                max(best[1], metric[1]),\n   220\t                max(best[2], metric[2]),\n   221\t            )\n   222\t            print(\n   223\t                \"PLANNER_PROGRESS\", len(seen_components), len(heap),\n   224\t                \"metric\", metric, \"best\", best,\n   225\t                \"path_len\", len(root_path), \"path\", root_path, flush=True,\n   226\t            )\n   227\t\n   228\t        local_outcomes = set()\n   229\t        for label, (node, walk_path), control in control_sites(by_position):\n   230\t            child_path = root_path + walk_path + [control]\n   231\t            if len(child_path) > 295:\n   232\t                continue\n   233\t            before_frame = perception.arr(node.frame())[:63].copy()\n   234\t            before = before_frame.tobytes()\n   235\t            child = node.clone()\n   236\t            step(child, control)\n   237\t            if child.levels_completed > base_level:\n   238\t                print(\n   239\t                    \"PLANNER_WIN\", child_path,\n   240\t                    \"control\", label,\n   241\t                    \"states\", len(seen_components), flush=True,\n   242\t                )\n   243\t                return\n   244\t            after = visible_key(child)\n   245\t            signature = outcome_signature(before_frame, child)\n   246\t            if after == before or signature in local_outcomes:\n   247\t                continue\n   248\t            local_outcomes.add(signature)\n   249\t            if after in enqueued_frames:\n   250\t                continue\n   251\t            enqueued_frames.add(after)\n   252\t            heapq.heappush(\n   253\t                heap,\n   254\t                (len(child_path), next(counter), child, child_path),\n   255\t            )\n   256\t\n   257\t        if len(seen_components) % 50 == 0:\n   258\t            print(\n   259\t                \"PLANNER_STATES\", len(seen_components), len(heap),\n   260\t                \"path_len\", len(root_path), \"best\", best, flush=True,\n   261\t            )\n   262\t\n   263\t    print(\n   264\t        \"PLANNER_DONE\", len(seen_components), len(heap),\n   265\t        \"best\", best, flush=True,\n   266\t    )\n   267\t\n   268\t\n   269\tarena.run_program(\"dc22\", observe)\n","exit_code":0,"status":"completed"}}
