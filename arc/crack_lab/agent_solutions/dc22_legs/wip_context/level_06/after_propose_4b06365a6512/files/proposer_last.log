{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_level6_stage53.py | sed -n '20,140p'\"","aggregated_output":"    20\tspec.loader.exec_module(solver)\n    21\t\n    22\tA_CONTROL = (6, 56, 8)\n    23\tB_CONTROL = (6, 51, 25)\n    24\tS_CONTROL = (6, 51, 48)\n    25\tD_CONTROLS = {\n    26\t    \"u\": (1, (6, 50, 32), 2),\n    27\t    \"d\": (2, (6, 50, 40), 1),\n    28\t    \"l\": (3, (6, 46, 36), 4),\n    29\t    \"r\": (4, (6, 54, 36), 3),\n    30\t}\n    31\tREMOTE = [\n    32\t    3, 3, 3, 3, 3,\n    33\t    A_CONTROL, A_CONTROL, A_CONTROL, A_CONTROL,\n    34\t    2, 2, 3, 3, 3, 2, 3, A_CONTROL, 1, A_CONTROL, 1, 1,\n    35\t    B_CONTROL,\n    36\t] + [1] * 17 + [3] + [2] * 11\n    37\tHUB = (\n    38\t    REMOTE\n    39\t    + [2] * 8\n    40\t    + [4, 4, A_CONTROL, 4, A_CONTROL, 1]\n    41\t    + [A_CONTROL, 4] * 3\n    42\t    + [1, 1, 1]\n    43\t    + [S_CONTROL, S_CONTROL, S_CONTROL, 3, B_CONTROL]\n    44\t)\n    45\tRING_PATHS = [\n    46\t    [],\n    47\t    [\"u\"], [\"d\"], [\"l\"], [\"r\"],\n    48\t    [\"u\", \"l\"], [\"u\", \"r\"], [\"d\", \"l\"], [\"d\", \"r\"],\n    49\t    [\"l\", \"l\"], [\"u\", \"r\", \"u\"], [\"l\", \"l\", \"l\"],\n    50\t    [\"u\", \"r\", \"u\", \"u\"], [\"l\", \"l\", \"l\", \"l\"],\n    51\t    [\"u\", \"r\", \"u\", \"u\", \"l\"],\n    52\t    [\"u\", \"r\", \"u\", \"u\", \"l\", \"l\"],\n    53\t    [\"u\", \"r\", \"u\", \"u\", \"l\", \"l\", \"u\"],\n    54\t    [\"u\", \"r\", \"u\", \"u\", \"l\", \"l\", \"u\", \"u\"],\n    55\t    [\"u\", \"r\", \"u\", \"u\", \"l\", \"l\", \"u\", \"u\", \"u\"],\n    56\t]\n    57\t\n    58\t\n    59\tdef apply(env, path):\n    60\t    for action in path:\n    61\t        env.step(*action) if isinstance(action, tuple) else env.step(action)\n    62\t\n    63\t\n    64\tdef avatar_tile(env):\n    65\t    blobs = connected_components(env.frame(), colors=(14,), min_area=2)\n    66\t    if not blobs:\n    67\t        return None\n    68\t    blob = max(blobs, key=lambda item: item.area)\n    69\t    return blob.bbox[0] // 2, blob.bbox[1] // 2\n    70\t\n    71\t\n    72\tdef configure_ring(env, labels):\n    73\t    for label in labels:\n    74\t        outward, control, inward = D_CONTROLS[label]\n    75\t        apply(env, [outward, control, inward])\n    76\t\n    77\t\n    78\tdef movement_reach(root, limit=120):\n    79\t    queue = deque([root.clone()])\n    80\t    positions = {avatar_tile(root)}\n    81\t    won = False\n    82\t    while queue and len(positions) < limit:\n    83\t        node = queue.popleft()\n    84\t        for direction in (1, 2, 3, 4):\n    85\t            child = node.clone()\n    86\t            child.step(direction)\n    87\t            if child.levels_completed > 5:\n    88\t                won = True\n    89\t                break\n    90\t            position = avatar_tile(child)\n    91\t            if position not in positions:\n    92\t                positions.add(position)\n    93\t                queue.append(child)\n    94\t        if won:\n    95\t            break\n    96\t    return positions, won\n    97\t\n    98\t\n    99\tdef run(env):\n   100\t    solver.solve(env)\n   101\t    apply(env, HUB)\n   102\t    islands = {\n   103\t        0: {(row, col) for row in range(24, 27) for col in range(16, 19)},\n   104\t        2: {(row, col) for row in range(2, 6) for col in range(2, 6)},\n   105\t    }\n   106\t    for labels in RING_PATHS:\n   107\t        configured = env.clone()\n   108\t        configure_ring(configured, labels)\n   109\t        results = []\n   110\t        for endpoint_phase in (0, 2):\n   111\t            endpoint = configured.clone()\n   112\t            endpoint.step(*B_CONTROL)\n   113\t            for _ in range((endpoint_phase - 3) % 4):\n   114\t                endpoint.step(*S_CONTROL)\n   115\t            endpoint.step(*B_CONTROL)\n   116\t            positions, won = movement_reach(endpoint)\n   117\t            novel = sorted(\n   118\t                position for position in positions\n   119\t                if position is not None and position not in islands[endpoint_phase]\n   120\t            )\n   121\t            if won or novel:\n   122\t                results.append((endpoint_phase, won, novel))\n   123\t        print(\"CONFIG\", labels, \"results\", results, flush=True)\n   124\t        if any(result[1] for result in results):\n   125\t            return\n   126\t\n   127\t\n   128\tlevels, path, error = A.run_program(\"dc22\", run)\n   129\tprint(\"HARNESS\", levels, len(path), error)\n","exit_code":0,"status":"completed"}}
