n    69\t    blobs = connected_components(env.frame(), colors=(14,), min_area=2)\n    70\t    if not blobs:\n    71\t        return None\n    72\t    blob = max(blobs, key=lambda item: item.area)\n    73\t    return blob.bbox[0] // 2, blob.bbox[1] // 2\n    74\t\n    75\t\n    76\tdef configure_ring(env, labels):\n    77\t    for label in labels:\n    78\t        outward, control, inward = D_CONTROLS[label]\n    79\t        apply(env, [outward, control, inward])\n    80\t\n    81\t\n    82\tdef search(root):\n    83\t    actions = [(\"u\", 1), (\"d\", 2), (\"l\", 3), (\"r\", 4), (\"b\", B_CONTROL)]\n    84\t    queue = deque([(root.clone(), [])])\n    85\t    seen = {root.frame()[:63].tobytes()}\n    86\t    positions = {avatar_tile(root)}\n    87\t    while queue and len(seen) < 240:\n    88\t        node, path = queue.popleft()\n    89\t        if len(path) >= 35:\n    90\t            continue\n    91\t        for label, action in actions:\n    92\t            child = node.clone()\n    93\t            child.step(*action) if isinstance(action, tuple) else child.step(action)\n    94\t            child_path = path + [label]\n    95\t            if child.levels_completed > 5:\n    96\t                return \"win\", child_path, len(seen)\n    97\t            key = child.frame()[:63].tobytes()\n    98\t            if key in seen:\n    99\t                continue\n   100\t            seen.add(key)\n   101\t            positions.add(avatar_tile(child))\n   102\t            queue.append((child, child_path))\n   103\t    visible = sorted(position for position in positions if position is not None)\n   104\t    return \"done\", visible, len(seen)\n   105\t\n   106\t\n   107\tdef run(env):\n   108\t    solver.solve(env)\n   109\t    apply(env, HUB)\n   110\t    for labels in RING_PATHS:\n   111\t        child = env.clone()\n   112\t        configure_ring(child, labels)\n   113\t        apply(child, REVERSE)\n   114\t        result = search(child)\n   115\t        novel = []\n   116\t        if result[0] == \"done\":\n   117\t            novel = [\n   118\t                position for position in result[1]\n   119\t                if position[1] >= 10 or position[0] <= 7\n   120\t            ]\n   121\t        print(\"CONFIG\", labels, result[0], result[2], \"novel\", novel, flush=True)\n   122\t        if result[0] == \"win\":\n   123\t            print(\"WIN\", labels, result[1], flush=True)\n   124\t            return\n   125\t\n   126\t\n   127\tlevels, path, error = A.run_program(\"dc22\", run)\n   128\tprint(\"HARNESS\", levels, len(path), error)\n","exit_code":0,"status":"completed"}}
