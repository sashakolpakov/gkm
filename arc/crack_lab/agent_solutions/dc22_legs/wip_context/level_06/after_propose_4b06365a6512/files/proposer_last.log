{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba perception.py | sed -n '39,186p'\"","aggregated_output":"    39\tdef arr(frame) -> np.ndarray:\n    40\t    return np.asarray(frame)\n    41\t\n    42\t\n    43\tdef color_counts(frame) -> Dict[int, int]:\n    44\t    vals, cnts = np.unique(arr(frame), return_counts=True)\n    45\t    return {int(v): int(c) for v, c in zip(vals, cnts)}\n    46\t\n    47\t\n    48\tdef connected_components(frame, colors: Optional[Iterable[int]] = None,\n    49\t                         min_area: int = 1) -> List[Blob]:\n    50\t    f = arr(frame)\n    51\t    wanted = None if colors is None else {int(c) for c in colors}\n    52\t    seen = np.zeros(f.shape, dtype=bool)\n    53\t    out: List[Blob] = []\n    54\t    rows, cols = f.shape[:2]\n    55\t    for r in range(rows):\n    56\t        for c in range(cols):\n    57\t            if seen[r, c]:\n    58\t                continue\n    59\t            color = int(f[r, c])\n    60\t            if wanted is not None and color not in wanted:\n    61\t                seen[r, c] = True\n    62\t                continue\n    63\t            q = [(r, c)]\n    64\t            seen[r, c] = True\n    65\t            pts = []\n    66\t            while q:\n    67\t                x, y = q.pop()\n    68\t                pts.append((x, y))\n    69\t                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n    70\t                    nx, ny = x + dx, y + dy\n    71\t                    if 0 <= nx < rows and 0 <= ny < cols and not seen[nx, ny] and int(f[nx, ny]) == color:\n    72\t                        seen[nx, ny] = True\n    73\t                        q.append((nx, ny))\n    74\t            if len(pts) >= min_area:\n    75\t                rs = [p[0] for p in pts]\n    76\t                cs = [p[1] for p in pts]\n    77\t                out.append(Blob(color, (min(rs), min(cs), max(rs), max(cs)),\n    78\t                                len(pts), (sum(rs) / len(pts), sum(cs) / len(pts))))\n    79\t    return sorted(out, key=lambda b: (b.color, b.bbox))\n    80\t\n    81\t\n    82\tdef block_signatures(frame, cell: int = 4) -> Dict[Tuple[int, int], Tuple[int, ...]]:\n    83\t    \"\"\"Partition a frame into fixed cells and return each cell's color signature.\"\"\"\n    84\t    f = arr(frame)\n    85\t    out = {}\n    86\t    for r in range(0, f.shape[0], cell):\n    87\t        for c in range(0, f.shape[1], cell):\n    88\t            out[(r // cell, c // cell)] = tuple(int(v) for v in sorted(np.unique(f[r:r+cell, c:c+cell])))\n    89\t    return out\n    90\t\n    91\t\n    92\tdef object_candidates(frame, cell: int = 4, min_area: int = 4) -> List[dict]:\n    93\t    \"\"\"A compact, game-agnostic object list from color components and cell signatures.\"\"\"\n    94\t    f = arr(frame)\n    95\t    blobs = connected_components(f, min_area=min_area)\n    96\t    sigs = block_signatures(f, cell)\n    97\t    objects = []\n    98\t    for b in blobs:\n    99\t        r0, c0, r1, c1 = b.bbox\n   100\t        objects.append({\n   101\t            \"color\": b.color,\n   102\t            \"bbox\": b.bbox,\n   103\t            \"top_left\": b.top_left,\n   104\t            \"size\": b.size,\n   105\t            \"area\": b.area,\n   106\t            \"centroid\": b.centroid,\n   107\t            \"cell\": (r0 // cell, c0 // cell),\n   108\t            \"cell_sig\": sigs.get((r0 // cell, c0 // cell)),\n   109\t        })\n   110\t    return objects\n   111\t\n   112\t\n   113\tdef frame_delta(before, after) -> dict:\n   114\t    a, b = arr(before), arr(after)\n   115\t    ys, xs = np.where(a != b)\n   116\t    if len(ys) == 0:\n   117\t        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n   118\t    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n   119\t    return {\n   120\t        \"count\": int(len(ys)),\n   121\t        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n   122\t        \"samples\": samples,\n   123\t    }\n   124\t\n   125\t\n   126\tdef action_deltas(env, actions: Sequence[int] = ACTIONS) -> Dict[int, dict]:\n   127\t    base = arr(env.frame()).copy()\n   128\t    out = {}\n   129\t    for action in actions:\n   130\t        clone = env.clone()\n   131\t        clone.step(action)\n   132\t        out[int(action)] = frame_delta(base, clone.frame())\n   133\t    return out\n   134\t\n   135\t\n   136\tdef replay(env, actions: Sequence[int]):\n   137\t    clone = env.clone()\n   138\t    for action in actions:\n   139\t        if clone.terminal():\n   140\t            break\n   141\t        clone.step(int(action))\n   142\t    return clone\n   143\t\n   144\t\n   145\tdef path_result(env, actions: Sequence[int]) -> dict:\n   146\t    clone = replay(env, actions)\n   147\t    return {\n   148\t        \"levels_completed\": int(clone.levels_completed),\n   149\t        \"terminal\": bool(clone.terminal()),\n   150\t        \"path_len\": len(actions),\n   151\t        \"colors\": color_counts(clone.frame()),\n   152\t        \"objects\": object_candidates(clone.frame()),\n   153\t    }\n   154\t\n   155\t\n   156\tdef changed_signature(env, actions: Sequence[int], cell: int = 4):\n   157\t    before = block_signatures(env.frame(), cell)\n   158\t    clone = replay(env, actions)\n   159\t    after = block_signatures(clone.frame(), cell)\n   160\t    return {k: (before.get(k), after.get(k)) for k in sorted(set(before) | set(after))\n   161\t            if before.get(k) != after.get(k)}\n   162\t\n   163\t\n   164\tdef bounded_bfs(env, goal_fn, actions: Sequence[int] = (UP, DOWN, LEFT, RIGHT, USE),\n   165\t                key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   166\t    \"\"\"Generic clone BFS over observational keys. Use small max_states first.\"\"\"\n   167\t    if key_fn is None:\n   168\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   169\t    start_key = key_fn(env)\n   170\t    q = deque([(env.clone(), [])])\n   171\t    seen = {start_key}\n   172\t    while q and len(seen) <= max_states:\n   173\t        node, path = q.popleft()\n   174\t        if goal_fn(node, path):\n   175\t            return path\n   176\t        if len(path) >= max_depth:\n   177\t            continue\n   178\t        for action in actions:\n   179\t            child = node.clone()\n   180\t            child.step(int(action))\n   181\t            key = key_fn(child)\n   182\t            if key in seen:\n   183\t                continue\n   184\t            seen.add(key)\n   185\t            q.append((child, path + [int(action)]))\n   186\t    return None\n","exit_code":0,"status":"completed"}}
