{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_level6_stage57.py | sed -n '24,185p'\"","aggregated_output":"    24\tA_CONTROL = (6, 56, 8)\n    25\tB_CONTROL = (6, 51, 25)\n    26\tS_CONTROL = (6, 51, 48)\n    27\tD_BY_POSITION = {\n    28\t    (28, 17): (\"DU\", (6, 50, 32)),\n    29\t    (30, 17): (\"DD\", (6, 50, 40)),\n    30\t    (29, 16): (\"DL\", (6, 46, 36)),\n    31\t    (18, 27): (\"DR\", (6, 54, 36)),\n    32\t}\n    33\t\n    34\t\n    35\tdef step(env, action):\n    36\t    env.step(*action) if isinstance(action, tuple) else env.step(action)\n    37\t\n    38\t\n    39\tdef avatar_position(env):\n    40\t    frame = env.frame()\n    41\t    rows, cols = np.where(frame[:62, :40] == 14)\n    42\t    if len(rows):\n    43\t        return int(rows.min() // 2), int(cols.min() // 2)\n    44\t    blobs = connected_components(frame, colors=(14,), min_area=2)\n    45\t    if not blobs:\n    46\t        return None\n    47\t    blob = max(blobs, key=lambda item: item.area)\n    48\t    return blob.bbox[0] // 2, blob.bbox[1] // 2\n    49\t\n    50\t\n    51\tdef world_key(env):\n    52\t    return env.frame()[:62, :40].tobytes()\n    53\t\n    54\t\n    55\tdef apply(env, path):\n    56\t    for action in path:\n    57\t        step(env, action)\n    58\t\n    59\t\n    60\tdef movement_closure(root):\n    61\t    opposite = {1: 2, 2: 1, 3: 4, 4: 3}\n    62\t    by_position = {}\n    63\t    winning_walk = None\n    64\t\n    65\t    def visit(path):\n    66\t        nonlocal winning_walk\n    67\t        position = avatar_position(root)\n    68\t        by_position[position] = list(path)\n    69\t        for direction in (1, 2, 3, 4):\n    70\t            before = avatar_position(root)\n    71\t            root.step(direction)\n    72\t            after = avatar_position(root)\n    73\t            if root.levels_completed > 5:\n    74\t                winning_walk = list(path) + [direction]\n    75\t                return\n    76\t            moved = after != before\n    77\t            if moved and after not in by_position:\n    78\t                visit(path + [direction])\n    79\t                if winning_walk is not None:\n    80\t                    return\n    81\t            if moved:\n    82\t                root.step(opposite[direction])\n    83\t                restored = avatar_position(root)\n    84\t                if restored != before:\n    85\t                    raise RuntimeError(\n    86\t                        f\"non-reversible walk {before}->{after}->{restored}\"\n    87\t                    )\n    88\t\n    89\t    visit([])\n    90\t    return by_position, winning_walk\n    91\t\n    92\t\n    93\tdef canonical(by_position):\n    94\t    visible = [\n    95\t        position for position in by_position\n    96\t        if position is not None and position[1] < 20\n    97\t    ]\n    98\t    position = min(visible) if visible else min(\n    99\t        position for position in by_position if position is not None\n   100\t    )\n   101\t    return position, by_position[position]\n   102\t\n   103\t\n   104\tdef run(env):\n   105\t    solver.solve(env)\n   106\t    base = env.clone()\n   107\t    queue = deque([[]])\n   108\t    seen = set()\n   109\t    best = (99, -1, 0)\n   110\t    while queue and len(seen) < 2400:\n   111\t        root_path = queue.popleft()\n   112\t        root = base.clone()\n   113\t        apply(root, root_path)\n   114\t        if root.levels_completed > 5:\n   115\t            print(\"WIN\", root_path, \"states\", len(seen), flush=True)\n   116\t            return\n   117\t        by_position, winning_walk = movement_closure(root)\n   118\t        if winning_walk is not None:\n   119\t            path = root_path + winning_walk\n   120\t            print(\"WIN\", path, \"states\", len(seen), flush=True)\n   121\t            return\n   122\t        canonical_position, canonical_walk = canonical(by_position)\n   123\t        canonical_env = base.clone()\n   124\t        apply(canonical_env, root_path + canonical_walk)\n   125\t        key = world_key(canonical_env)\n   126\t        if key in seen:\n   127\t            continue\n   128\t        seen.add(key)\n   129\t\n   130\t        positions = [\n   131\t            position for position in by_position if position is not None\n   132\t        ]\n   133\t        metric = (\n   134\t            min(position[0] for position in positions),\n   135\t            max(position[1] for position in positions),\n   136\t            len(positions),\n   137\t        )\n   138\t        dense = (best[0] - metric[0], metric[1] - best[1], metric[2] - best[2])\n   139\t        if any(value > 0 for value in dense):\n   140\t            best = (\n   141\t                min(best[0], metric[0]),\n   142\t                max(best[1], metric[1]),\n   143\t                max(best[2], metric[2]),\n   144\t            )\n   145\t            print(\n   146\t                \"PROGRESS\", metric, \"best\", best,\n   147\t                \"path_len\", len(root_path), \"path\", root_path,\n   148\t                flush=True,\n   149\t            )\n   150\t\n   151\t        candidates = [(canonical_walk, A_CONTROL)]\n   152\t        if (24, 9) in by_position:\n   153\t            candidates.append((by_position[(24, 9)], S_CONTROL))\n   154\t        for position, walk in by_position.items():\n   155\t            if position is None:\n   156\t                continue\n   157\t            candidates.append((walk, B_CONTROL))\n   158\t            if position in D_BY_POSITION:\n   159\t                label, control = D_BY_POSITION[position]\n   160\t                candidates.append((walk, control))\n   161\t\n   162\t        resulting_keys = set()\n   163\t        for walk, control in candidates:\n   164\t            probe = base.clone()\n   165\t            apply(probe, root_path + walk)\n   166\t            before = world_key(probe)\n   167\t            step(probe, control)\n   168\t            if probe.levels_completed > 5:\n   169\t                print(\n   170\t                    \"WIN\", root_path + walk + [control],\n   171\t                    \"states\", len(seen), flush=True,\n   172\t                )\n   173\t                return\n   174\t            after = world_key(probe)\n   175\t            if after == before or after in resulting_keys:\n   176\t                continue\n   177\t            resulting_keys.add(after)\n   178\t            queue.append(root_path + walk + [control])\n   179\t\n   180\t        if len(seen) % 100 == 0:\n   181\t            print(\"STATES\", len(seen), \"queue\", len(queue), flush=True)\n   182\t    print(\"DONE\", len(seen), \"queue\", len(queue), \"best\", best, flush=True)\n   183\t\n   184\t\n   185\tlevels, path, error = A.run_program(\"dc22\", run)\n","exit_code":0,"status":"completed"}}
