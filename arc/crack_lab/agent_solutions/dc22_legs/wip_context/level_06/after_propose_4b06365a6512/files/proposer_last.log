{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_level6_stage59.py | sed -n '20,95p;163,225p;225,370p'\"","aggregated_output":"    20\tspec = importlib.util.spec_from_file_location(\"solve\", \"solve.py\")\n    21\tsolver = importlib.util.module_from_spec(spec)\n    22\tspec.loader.exec_module(solver)\n    23\t\n    24\tA_CONTROL = (6, 56, 8)\n    25\tB_CONTROL = (6, 51, 25)\n    26\tS_CONTROL = (6, 51, 48)\n    27\tD_CONTROLS = {\n    28\t    \"u\": (1, (6, 50, 32), 2),\n    29\t    \"d\": (2, (6, 50, 40), 1),\n    30\t    \"l\": (3, (6, 46, 36), 4),\n    31\t    \"r\": (4, (6, 54, 36), 3),\n    32\t}\n    33\t\n    34\tREMOTE = [\n    35\t    3, 3, 3, 3, 3,\n    36\t    A_CONTROL, A_CONTROL, A_CONTROL, A_CONTROL,\n    37\t    2, 2, 3, 3, 3, 2, 3, A_CONTROL, 1, A_CONTROL, 1, 1,\n    38\t    B_CONTROL,\n    39\t] + [1] * 17 + [3] + [2] * 11\n    40\t\n    41\tHUB = (\n    42\t    REMOTE\n    43\t    + [2] * 8\n    44\t    + [4, 4, A_CONTROL, 4, A_CONTROL, 1]\n    45\t    + [A_CONTROL, 4] * 3\n    46\t    + [1, 1, 1]\n    47\t    + [S_CONTROL, S_CONTROL, S_CONTROL, 3, B_CONTROL]\n    48\t)\n    49\t\n    50\tTOP_PATH = [\"u\", \"r\", \"u\", \"u\", \"l\", \"l\", \"u\", \"u\", \"u\"]\n    51\t\n    52\tREVERSE_TO_ROOT = [\n    53\t    4,\n    54\t    2, 2, 2, 3, 2, 3, 3, 2, 3, 3, 1, A_CONTROL, 1,\n    55\t] + [1] * 7 + [3]\n    56\t\n    57\tROOT_TO_SELECTOR = (\n    58\t    [2] * 8\n    59\t    + [4, 4, A_CONTROL, 4, A_CONTROL, 1]\n    60\t    + [A_CONTROL, 4] * 3\n    61\t    + [1, 1, 1]\n    62\t)\n    63\t\n    64\t\n    65\tdef step(env, action):\n    66\t    env.step(*action) if isinstance(action, tuple) else env.step(action)\n    67\t\n    68\t\n    69\tdef apply(env, path):\n    70\t    for action in path:\n    71\t        step(env, action)\n    72\t\n    73\t\n    74\tdef move_ring(env, labels):\n    75\t    for label in labels:\n    76\t        outward, control, inward = D_CONTROLS[label]\n    77\t        apply(env, [outward, control, inward])\n    78\t\n    79\t\n    80\tdef avatar(env):\n    81\t    blobs = connected_components(env.frame(), colors=(14,), min_area=2)\n    82\t    candidates = [blob for blob in blobs if blob.area >= 2]\n    83\t    if not candidates:\n    84\t        return None\n    85\t    blob = max(candidates, key=lambda item: item.area)\n    86\t    return blob.bbox[0] // 2, blob.bbox[1] // 2, blob.area\n    87\t\n    88\t\n    89\tdef color8(env):\n    90\t    return [\n    91\t        (blob.bbox, blob.area)\n    92\t        for blob in connected_components(env.frame(), colors=(8,), min_area=4)\n    93\t        if blob.bbox[1] < 40\n    94\t    ]\n    95\t\n   163\tdef run(env):\n   164\t    solver.solve(env)\n   165\t    apply(env, HUB)\n   166\t    print(\"HUB\", avatar(env), color8(env), flush=True)\n   167\t    center_controls(env, \"HUB\")\n   168\t    hub_root = env.clone()\n   169\t\n   170\t    left_terminal = hub_root.clone()\n   171\t    move_ring(left_terminal, [\"l\", \"l\", \"l\", \"l\"])\n   172\t    for push in range(1, 9):\n   173\t        before = left_terminal.frame()[:63].copy()\n   174\t        move_ring(left_terminal, [\"l\"])\n   175\t        changed = int(np.count_nonzero(before != left_terminal.frame()[:63]))\n   176\t        print(\n   177\t            \"LEFT_PUSH\", push, \"changed\", changed,\n   178\t            \"level\", left_terminal.levels_completed,\n   179\t            \"phase1\", phase1_result(left_terminal), flush=True,\n   180\t        )\n   181\t\n   182\t    move_ring(env, [\"l\", \"l\", \"l\"])\n   183\t    print(\"DOCKED\", avatar(env), color8(env), env.levels_completed, flush=True)\n   184\t    center_controls(env, \"DOCKED\")\n   185\t    docked = env.clone()\n   186\t    phase1(env, \"DOCKED_PHASE1\")\n   187\t\n   188\t    move_ring(env, [\"r\", \"r\", \"r\"])\n   189\t    print(\"RETURNED\", avatar(env), color8(env), env.levels_completed, flush=True)\n   190\t    phase1(env, \"RETURNED_PHASE1\")\n   191\t\n   192\t    move_ring(env, TOP_PATH)\n   193\t    print(\"TOP\", avatar(env), color8(env), env.levels_completed, flush=True)\n   194\t    center_controls(env, \"TOP\")\n   195\t    north_switch = env.clone()\n   196\t    apply(north_switch, [B_CONTROL] + REVERSE_TO_ROOT + [1] * 12)\n   197\t    print(\n   198\t        \"NORTH_SWITCH_APPROACH\", avatar(north_switch),\n   199\t        north_switch.levels_completed, flush=True,\n   200\t    )\n   201\t    before_switch = north_switch.frame()[:63].copy()\n   202\t    north_switch.step(2)\n   203\t    print(\n   204\t        \"NORTH_SWITCH_ENTER\", avatar(north_switch),\n   205\t        \"changed\", int(np.count_nonzero(\n   206\t            before_switch != north_switch.frame()[:63]\n   207\t        )),\n   208\t        \"level\", north_switch.levels_completed, flush=True,\n   209\t    )\n   210\t    switch_positions, switch_win = movement_reach(north_switch)\n   211\t    print(\n   212\t        \"NORTH_SWITCH_REACH\",\n   213\t        sorted(position for position in switch_positions if position),\n   214\t        \"win\", switch_win, flush=True,\n   215\t    )\n   216\t    phase1(north_switch, \"NORTH_SWITCH_PHASE1\")\n   217\t    for push in range(1, 9):\n   218\t        before = env.frame()[:63].copy()\n   219\t        move_ring(env, [\"u\"])\n   220\t        changed = int(np.count_nonzero(before != env.frame()[:63]))\n   221\t        print(\n   222\t            \"TOP_PUSH\", push, \"changed\", changed,\n   223\t            \"level\", env.levels_completed,\n   224\t            \"phase1\", phase1_result(env), flush=True,\n   225\t        )\n   225\t        )\n   226\t    phase1(env, \"TOP_PHASE1\")\n   227\t\n   228\t    northern = env.clone()\n   229\t    apply(\n   230\t        northern,\n   231\t        [B_CONTROL, S_CONTROL, S_CONTROL, S_CONTROL, B_CONTROL],\n   232\t    )\n   233\t    positions, _ = movement_reach(northern)\n   234\t    for position, path in positions.items():\n   235\t        for name in (\"u\", \"d\", \"l\", \"r\"):\n   236\t            child = northern.clone()\n   237\t            apply(child, path)\n   238\t            before = color8(child)\n   239\t            outward, control, inward = D_CONTROLS[name]\n   240\t            step(child, control)\n   241\t            after = color8(child)\n   242\t            if after != before or child.levels_completed > 5:\n   243\t                print(\n   244\t                    \"NORTH_CONTROL\", position, name, before, after,\n   245\t                    child.levels_completed, flush=True,\n   246\t                )\n   247\t    for direction in (1, 2, 3, 4):\n   248\t        child = northern.clone()\n   249\t        previous = (avatar(child), movers(child))\n   250\t        transitions = []\n   251\t        for turn in range(1, 31):\n   252\t            child.step(direction)\n   253\t            current = (avatar(child), movers(child))\n   254\t            if current != previous or child.levels_completed > 5:\n   255\t                transitions.append(\n   256\t                    (turn, current[0], current[1], child.levels_completed)\n   257\t                )\n   258\t                previous = current\n   259\t            if child.levels_completed > 5:\n   260\t                break\n   261\t        print(\"NORTH_REPEAT\", direction, transitions, flush=True)\n   262\t\n   263\t    coupled = docked.clone()\n   264\t    apply(coupled, [B_CONTROL] + REVERSE_TO_ROOT + [1] * 5)\n   265\t    print(\n   266\t        \"COUPLED_BEFORE\", avatar(coupled), color8(coupled),\n   267\t        movers(coupled), coupled.levels_completed, flush=True,\n   268\t    )\n   269\t    step(coupled, B_CONTROL)\n   270\t    print(\n   271\t        \"COUPLED_AFTER\", avatar(coupled), color8(coupled),\n   272\t        movers(coupled), coupled.levels_completed, flush=True,\n   273\t    )\n   274\t    apply(\n   275\t        coupled,\n   276\t        [2] * 5 + ROOT_TO_SELECTOR + [3, B_CONTROL],\n   277\t    )\n   278\t    print(\n   279\t        \"COUPLED_HUB\", avatar(coupled), color8(coupled),\n   280\t        movers(coupled), coupled.levels_completed, flush=True,\n   281\t    )\n   282\t    phase1(coupled, \"COUPLED_PHASE1\")\n   283\t    move_ring(coupled, [\"r\", \"r\", \"r\"] + TOP_PATH)\n   284\t    print(\n   285\t        \"COUPLED_TOP\", avatar(coupled), color8(coupled),\n   286\t        movers(coupled), coupled.levels_completed, flush=True,\n   287\t    )\n   288\t    phase1(coupled, \"COUPLED_TOP_PHASE1\")\n   289\t\n   290\t    attached = hub_root.clone()\n   291\t    move_ring(attached, [\"l\", \"l\", \"l\", \"l\"])\n   292\t    apply(attached, [B_CONTROL] + REVERSE_TO_ROOT + [2] * 8)\n   293\t    print(\n   294\t        \"ATTACH_BEFORE\", avatar(attached), color8(attached),\n   295\t        movers(attached), attached.levels_completed, flush=True,\n   296\t    )\n   297\t    step(attached, B_CONTROL)\n   298\t    print(\n   299\t        \"ATTACH_AFTER\", avatar(attached), color8(attached),\n   300\t        movers(attached), attached.levels_completed, flush=True,\n   301\t    )\n   302\t    selector_suffix = (\n   303\t        [4, 4, A_CONTROL, 4, A_CONTROL, 1]\n   304\t        + [A_CONTROL, 4] * 3\n   305\t        + [1, 1, 1, 3, B_CONTROL]\n   306\t    )\n   307\t    apply(attached, selector_suffix)\n   308\t    print(\n   309\t        \"ATTACH_HUB\", avatar(attached), color8(attached),\n   310\t        movers(attached), attached.levels_completed, flush=True,\n   311\t    )\n   312\t    move_ring(attached, [\"r\", \"r\", \"r\", \"r\"])\n   313\t    print(\n   314\t        \"ATTACH_RETURN\", avatar(attached), color8(attached),\n   315\t        movers(attached), attached.levels_completed, flush=True,\n   316\t    )\n   317\t    move_ring(attached, TOP_PATH)\n   318\t    print(\n   319\t        \"ATTACH_TOP\", avatar(attached), color8(attached),\n   320\t        movers(attached), attached.levels_completed, flush=True,\n   321\t    )\n   322\t    phase1(attached, \"ATTACH_TOP_PHASE1\")\n   323\t\n   324\t    carried = hub_root.clone()\n   325\t    move_ring(carried, [\"l\", \"l\", \"l\", \"l\"])\n   326\t    apply(carried, [B_CONTROL] + REVERSE_TO_ROOT + [2] * 8)\n   327\t    apply(carried, [B_CONTROL, B_CONTROL] + selector_suffix)\n   328\t    print(\n   329\t        \"CARRY_HUB\", avatar(carried), color8(carried),\n   330\t        movers(carried), carried.levels_completed, flush=True,\n   331\t    )\n   332\t    center_controls(carried, \"CARRY_HUB\")\n   333\t    phase1(carried, \"CARRY_HUB_PHASE1\")\n   334\t    move_ring(carried, [\"r\", \"r\", \"r\", \"r\"])\n   335\t    print(\n   336\t        \"CARRY_RETURN\", avatar(carried), color8(carried),\n   337\t        movers(carried), carried.levels_completed, flush=True,\n   338\t    )\n   339\t    move_ring(carried, TOP_PATH)\n   340\t    print(\n   341\t        \"CARRY_TOP\", avatar(carried), color8(carried),\n   342\t        movers(carried), carried.levels_completed, flush=True,\n   343\t    )\n   344\t    phase1(carried, \"CARRY_TOP_PHASE1\")\n   345\t\n   346\t    routed = hub_root.clone()\n   347\t    apply(routed, [S_CONTROL, S_CONTROL])\n   348\t    move_ring(routed, TOP_PATH)\n   349\t    print(\n   350\t        \"ROUTED_TOP\", avatar(routed), color8(routed),\n   351\t        movers(routed), routed.levels_completed, flush=True,\n   352\t    )\n   353\t    apply(\n   354\t        routed,\n   355\t        [S_CONTROL, S_CONTROL, B_CONTROL, S_CONTROL, S_CONTROL, B_CONTROL],\n   356\t    )\n   357\t    print(\n   358\t        \"ROUTED_PHASE1\", avatar(routed), color8(routed),\n   359\t        movers(routed), routed.levels_completed, flush=True,\n   360\t    )\n   361\t    routed_positions, routed_win = movement_reach(routed)\n   362\t    print(\n   363\t        \"ROUTED_REACH\",\n   364\t        sorted(position for position in routed_positions if position),\n   365\t        \"win\", routed_win, flush=True,\n   366\t    )\n   367\t\n   368\t\n   369\tlevels, path, error = A.run_program(\"dc22\", run)\n   370\tprint(\"HARNESS\", levels, len(path), error, flush=True)\n","exit_code":0,"status":"completed"}}
