TROL, S_CONTROL, S_CONTROL, B_CONTROL])\n    75\t    return avatar_tile(child), child.levels_completed\n    76\t\n    77\t\n    78\tdef phase1_combinations(root, path):\n    79\t    for a_phase in range(6):\n    80\t        for b_phase in range(2):\n    81\t            child = root.clone()\n    82\t            for _ in range(a_phase):\n    83\t                child.step(*A_CONTROL)\n    84\t            for _ in range(b_phase):\n    85\t                apply(child, [1, B_CONTROL, 2])\n    86\t            result = phase1_result(child)\n    87\t            if result != ((24, 9), 5):\n    88\t                print(\n    89\t                    \"ALIGNED_PHASE1\", path,\n    90\t                    (a_phase, b_phase), result,\n    91\t                )\n    92\t\n    93\t\n    94\tdef run(env):\n    95\t    solver.solve(env)\n    96\t    apply(env, HUB)\n    97\t    queue = deque([(env.clone(), [])])\n    98\t    seen = {env.frame()[:63].tobytes()}\n    99\t    configs = {ring(env): []}\n   100\t    print(\"PHASE1\", [], phase1_result(env))\n   101\t    phase1_combinations(env, [])\n   102\t    while queue and len(seen) < 500:\n   103\t        node, path = queue.popleft()\n   104\t        if len(path) >= 20:\n   105\t            continue\n   106\t        for label, (outward, control, inward) in D_CONTROLS.items():\n   107\t            child = node.clone()\n   108\t            apply(child, [outward, control, inward])\n   109\t            child_path = path + [label]\n   110\t            if child.levels_completed > 5:\n   111\t                print(\"WIN\", child_path, \"states\", len(seen))\n   112\t                return\n   113\t            key = child.frame()[:63].tobytes()\n   114\t            if key in seen:\n   115\t                continue\n   116\t            seen.add(key)\n   117\t            config = ring(child)\n   118\t            if config not in configs:\n   119\t                configs[config] = child_path\n   120\t                print(\"RING\", config, child_path)\n   121\t                result = phase1_result(child)\n   122\t                if result != ((24, 9), 5):\n   123\t                    print(\"PHASE1\", child_path, result)\n   124\t                phase1_combinations(child, child_path)\n   125\t            queue.append((child, child_path))\n   126\t    print(\"DONE\", len(seen), \"queue\", len(queue), \"configs\", configs)\n   127\t\n   128\t\n   129\tA.run_program(\"dc22\", run)\n","exit_code":0,"status":"completed"}}
