{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_level6.py | sed -n '1,85p;100,205p'\"","aggregated_output":"     1\timport importlib.util\n     2\timport os\n     3\timport sys\n     4\tfrom collections import deque\n     5\t\n     6\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     7\t\n     8\timport gkm_arena as A\n     9\timport gkm_legs as G\n    10\t\n    11\tfrom perception import (\n    12\t    action_deltas,\n    13\t    bounded_bfs,\n    14\t    bounded_replay_bfs,\n    15\t    color_counts,\n    16\t    connected_components,\n    17\t    frame_delta,\n    18\t)\n    19\t\n    20\t\n    21\ttaint_reason = G._workspace_taint_reason(os.getcwd())\n    22\tif taint_reason:\n    23\t    raise SystemExit(f\"TAINTED WORKSPACE: {taint_reason}\")\n    24\t\n    25\tspec = importlib.util.spec_from_file_location(\"solve\", \"solve.py\")\n    26\tsolver = importlib.util.module_from_spec(spec)\n    27\tspec.loader.exec_module(solver)\n    28\t\n    29\t\n    30\tdef summarize(env):\n    31\t    print(\"LEVEL\", env.levels_completed + 1, \"ACTIONS\", env.actions)\n    32\t    print(\"COUNTS\", color_counts(env.frame()))\n    33\t    blobs = connected_components(env.frame(), min_area=3)\n    34\t    print(\"BLOBS\")\n    35\t    for blob in blobs:\n    36\t        if blob.color != 2 or blob.area < 12:\n    37\t            print(blob.color, blob.bbox, blob.area)\n    38\t    print(\"LEFT_TILE_MAP\")\n    39\t    frame = env.frame()\n    40\t    for r in range(0, 62, 2):\n    41\t        print(f\"{r // 2:02d}\", \"\".join(f\"{int(frame[r, c]):X}\" for c in range(0, 40, 2)))\n    42\t    print(\"KEY_DELTAS\")\n    43\t    for action, delta in action_deltas(env, env.actions).items():\n    44\t        print(action, delta)\n    45\t\n    46\t\n    47\tdef run(env):\n    48\t    solver.solve(env)\n    49\t    summarize(env)\n    50\t\n    51\t    base = env.frame()\n    52\t    # Probe the centers of compact non-background components as likely controls.\n    53\t    points = []\n    54\t    for blob in connected_components(base, min_area=3):\n    55\t        r0, c0, r1, c1 = blob.bbox\n    56\t        if blob.area <= 40:\n    57\t            points.append(((c0 + c1) // 2, (r0 + r1) // 2))\n    58\t    print(\"COORD_DELTAS\")\n    59\t    for x, y in sorted(set(points)):\n    60\t        clone = env.clone()\n    61\t        clone.step(6, x, y)\n    62\t        delta = frame_delta(base, clone.frame())\n    63\t        if delta[\"count\"]:\n    64\t            print((x, y), {k: v for k, v in delta.items() if k != \"samples\"})\n    65\t\n    66\t    active = env.clone()\n    67\t    active.step(6, 56, 8)\n    68\t    print(\"CONTROL_56_8\", frame_delta(base, active.frame()))\n    69\t    print(\"AFTER_CONTROL_KEY_DELTAS\")\n    70\t    for action, delta in action_deltas(active, active.actions).items():\n    71\t        print(action, delta)\n    72\t\n    73\t    def avatar_key(node):\n    74\t        frame = node.frame()\n    75\t        cells = tuple(\n    76\t            (int(r), int(c))\n    77\t            for r, c in zip(*((frame == 14).nonzero()))\n    78\t            if int(c) < 40\n    79\t        )\n    80\t        return cells\n    81\t\n    82\t    path = bounded_bfs(\n    83\t        env,\n    84\t        lambda node, _: node.levels_completed > 5,\n    85\t        actions=(1, 2, 3, 4),\n   100\t                child = node.clone()\n   101\t                child.step(action)\n   102\t                child_path = node_path + [action]\n   103\t                if child.levels_completed > 5:\n   104\t                    return seen, child_path\n   105\t                key = avatar_key(child)\n   106\t                if key not in seen:\n   107\t                    seen.add(key)\n   108\t                    queue.append((child, child_path))\n   109\t        return seen, won\n   110\t\n   111\t    print(\"CONTROL_PHASES\")\n   112\t    phased = env.clone()\n   113\t    for phase in range(0):\n   114\t        positions, win = reachable(phased)\n   115\t        anchors = sorted((cells[0][0] // 2, cells[0][1] // 2) for cells in positions if cells)\n   116\t        one_blobs = [(b.bbox, b.area) for b in connected_components(phased.frame(), colors=(1,), min_area=1)]\n   117\t        print(phase, \"assembly\", one_blobs, \"reachable\", anchors, \"win\", win)\n   118\t        phased.step(6, 56, 8)\n   119\t\n   120\t    def compact_key(node):\n   121\t        frame = node.frame()\n   122\t        return avatar_key(node), frame[54:60, 6:20].tobytes()\n   123\t\n   124\t    transfer_path = [\n   125\t        3, 3, 3, 3, 3,\n   126\t        (6, 56, 8), (6, 56, 8), (6, 56, 8), (6, 56, 8),\n   127\t        2, 2, 3, 3, 3, 2, 3, (6, 56, 8), 1, (6, 56, 8), 1, 1,\n   128\t    ]\n   129\t    print(\"LEFT_ISLAND_TRANSFER\", transfer_path)\n   130\t    if transfer_path:\n   131\t        reached = env.clone()\n   132\t        for action in transfer_path:\n   133\t            reached.step(*action) if isinstance(action, tuple) else reached.step(action)\n   134\t        print(\"REACHED_BLOBS_RIGHT\")\n   135\t        for blob in connected_components(reached.frame(), min_area=3):\n   136\t            if blob.bbox[1] >= 40 and blob.area <= 100:\n   137\t                print(blob.color, blob.bbox, blob.area)\n   138\t        print(\"REACHED_COORD_DELTAS\")\n   139\t        reached_base = reached.frame()\n   140\t        for blob in connected_components(reached_base, min_area=3):\n   141\t            r0, c0, r1, c1 = blob.bbox\n   142\t            if c0 < 40 or blob.area > 100:\n   143\t                continue\n   144\t            point = ((c0 + c1) // 2, (r0 + r1) // 2)\n   145\t            child = reached.clone()\n   146\t            child.step(6, *point)\n   147\t            delta = frame_delta(reached_base, child.frame())\n   148\t            if delta[\"count\"]:\n   149\t                print(point, delta)\n   150\t\n   151\t        print(\"SECOND_CONTROL_PHASES\")\n   152\t        second_phased = reached.clone()\n   153\t        for phase in range(0):\n   154\t            positions, win = reachable(second_phased)\n   155\t            anchors = sorted(\n   156\t                (cells[0][0] // 2, cells[0][1] // 2)\n   157\t                for cells in positions\n   158\t                if cells\n   159\t            )\n   160\t            print(\n   161\t                phase,\n   162\t                \"bounds\",\n   163\t                (min(anchors), max(anchors)),\n   164\t                \"count\",\n   165\t                len(anchors),\n   166\t                \"win\",\n   167\t                win,\n   168\t            )\n   169\t            second_phased.step(6, 51, 25)\n   170\t\n   171\t        second_root = reached.clone()\n   172\t        second_root.step(6, 51, 25)\n   173\t        second_path = bounded_bfs(\n   174\t            second_root,\n   175\t            lambda node, _: (\n   176\t                bool(avatar_key(node))\n   177\t                and (\n   178\t                    avatar_key(node)[0][0] // 2,\n   179\t                    avatar_key(node)[0][1] // 2,\n   180\t                ) == (9, 4)\n   181\t            ),\n   182\t            actions=(1, 2, 3, 4),\n   183\t            key_fn=avatar_key,\n   184\t            max_states=200,\n   185\t            max_depth=50,\n   186\t        )\n   187\t        print(\"SECOND_TRANSFER\", [(6, 51, 25)] + second_path)\n   188\t        reached2 = second_root.clone()\n   189\t        for action in second_path:\n   190\t            reached2.step(action)\n   191\t        print(\"SECOND_REACHED_COORD_DELTAS\")\n   192\t        base2 = reached2.frame()\n   193\t        for blob in connected_components(base2, min_area=3):\n   194\t            r0, c0, r1, c1 = blob.bbox\n   195\t            if c0 < 40 or blob.area > 100:\n   196\t                continue\n   197\t            point = ((c0 + c1) // 2, (r0 + r1) // 2)\n   198\t            child = reached2.clone()\n   199\t            child.step(6, *point)\n   200\t            delta = frame_delta(base2, child.frame())\n   201\t            if delta[\"count\"]:\n   202\t                print(point, {k: v for k, v in delta.items() if k != \"samples\"})\n   203\t\n   204\t\n   205\tA.run_program(\"dc22\", run)\n","exit_code":0,"status":"completed"}}
