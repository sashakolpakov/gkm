{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\nfrom collections import deque\nslots={(r,c) for r,cs in {12:(12,18,24,30),18:(12,18,24,30),24:(12,18,24,30),30:(12,18,24,30),36:(12,18,24,30,36,42),42:(12,18,24,30,36,42,48,54),48:(12,18,24,30,36,42),54:(24,)} for c in cs}\nstart=(frozenset({(24,18),(48,12),(54,24)}),(18,18))\ncarriers={(42,48),(42,54)}\ndirs=((-6,0),(6,0),(0,-6),(0,6))\nq=deque([(start,())]); seen={start}; best=3\nfound=[]\nwhile q and len(seen)<200000:\n    (pegs,bridge),path=q.popleft()\n    if len(pegs)<best:\n        best=len(pegs); print('best',best,'depth',len(path),'state',pegs,bridge,'seen',len(seen))\n    if len(pegs)==1 and next(iter(pegs)) in carriers:\n        found.append((path,pegs,bridge)); print('FOUND',len(path),pegs,bridge,path); break\n    occupied=set(pegs)|{bridge}\n    for source in sorted(occupied):\n      for dr,dc in dirs:\n        mid=(source[0]+dr,source[1]+dc); dst=(source[0]+2*dr,source[1]+2*dc)\n        if dst not in slots or dst in occupied: continue\n        if source==bridge:\n          if mid not in pegs: continue\n          child=(pegs,dst); kind='B'\n        else:\n          if mid==bridge:\n            child=(frozenset(pegs-{source}|{dst}),bridge); kind='P/B'\n          elif mid in pegs:\n            child=(frozenset(pegs-{source,mid}|{dst}),bridge); kind='CAP'\n          else: continue\n        if child not in seen:\n          seen.add(child); q.append((child,path+((kind,source,dst),)))\nprint('seen',len(seen),'queue',len(q))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
