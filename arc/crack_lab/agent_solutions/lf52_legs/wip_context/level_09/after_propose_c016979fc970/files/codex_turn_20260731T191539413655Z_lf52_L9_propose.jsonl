{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/bin/zsh -lc \"MPLCONFIGDIR=/tmp/gkm_mpl python - <<'PY'\nimport json,sys,numpy as np\nsys.path.insert(0,'/Users/sasha/gkm/arc/crack_lab')\nimport gkm_arena as arena\nfrom probe_level9_labeled_entry_worlds import labeled_goals,actions_for,physical_key\nfrom probe_level9_shortest_suffix import play,lattice,visible_moves\n\ndef sm(e):\n h,b,p,c,s=lattice(e.frame());return {'p':sorted(p),'b':sorted(b),'s':sorted(s),'moves':visible_moves(e.frame())}\ndef probe(e):\n pre=json.load(open('checkpoint.json'))['final_path']\n for a in pre:play(e,a)\n worlds={}\n for terminal,path in labeled_goals(e.frame())[0]:\n  n=e.clone();acts=actions_for(path)\n  for a in acts:play(n,a)\n  worlds.setdefault(physical_key(n),(acts,n))\n ordered=sorted(worlds.values(),key=lambda z:len(z[0]))\n for wi in (0,1,2,3):\n  acts,n=ordered[wi];print('WORLD',wi,len(acts),sm(n))\n  for i in range(1,10):\n   play(n,4)\n   if visible_moves(n.frame()) or i in (1,8,9):print('K',wi,i,sm(n))\nlevels,path,error=arena.run_program('lf52',probe);print('H',levels,len(path),error)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
