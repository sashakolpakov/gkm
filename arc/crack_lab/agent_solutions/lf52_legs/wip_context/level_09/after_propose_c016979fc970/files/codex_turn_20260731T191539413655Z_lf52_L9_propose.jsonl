rce)\n        before = child.frame()\n        child.step(action)\n        print(\"REMOTE_SELECTED\", {\n            \"action\": action,\n            \"delta\": {\n                key: value\n                for key, value in frame_delta(before, child.frame()).items()\n                if key != \"samples\"\n            },\n            \"state\": compact(child),\n        })\n\n\nlevels, path, error = arena.run_program(\"lf52\", probe)\nprint(\"HARNESS\", {\n    \"levels\": levels,\n    \"moves\": len(path),\n    \"error\": str(error) if error else None,\n})\nprobe_level9_shortcut_search.py:23:MAX_COST = int(os.environ.get(\"SHORTCUT_MAX_COST\", \"15\"))\nprobe_level9_shortcut_search.py:24:MAX_STATES = int(os.environ.get(\"SHORTCUT_MAX_STATES\", \"1200\"))\nprobe_level9_shortcut_search.py:25:GREEDY = os.environ.get(\"SHORTCUT_GREEDY\") == \"1\"\nprobe_level9_shortcut_search.py:143:    print(\"SHORTCUT\", {\n","exit_code":0,"status":"completed"}}
