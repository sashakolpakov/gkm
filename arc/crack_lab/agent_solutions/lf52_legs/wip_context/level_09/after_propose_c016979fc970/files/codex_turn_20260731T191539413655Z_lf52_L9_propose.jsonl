{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/zsh -lc \"MPLCONFIGDIR=/tmp/gkm_mpl python - <<'PY'\nfrom collections import deque\nimport json,sys\nsys.path.insert(0,'/Users/sasha/gkm/arc/crack_lab')\nimport gkm_arena as arena\nfrom probe_level9_shortest_suffix import play,lattice\n\ndef solve(parts):\n holes,bs,ps,cs,sups=parts; dest=set(holes)|set(bs)|set(ps)|set(cs); start=(frozenset(bs),frozenset(ps));q=deque([(start,())]);seen={start};best=None;goals=[]\n while q and len(seen)<20000:\n  (b,p),path=q.popleft(); occ=set(b)|set(p)|set(sups)\n  dist=min((abs(x[0]-y[0])+abs(x[1]-y[1]) for x in p for y in p if x\"'!=y),default=999)\n  score=(len(p),dist,len(path))\n  if best is None or score<best[0]:best=(score,path,b,p)\n  if len(p)==1:goals.append((path,b,p));break\n  for kind,pieces in [('\"'b',b),('p',p)]:\n   for s in pieces:\n    for dr,dc in [(-6,0),(6,0),(0,-6),(0,6)]:\n     m=(s[0]+dr,s[1]+dc);d=(s[0]+2*dr,s[1]+2*dc)\n     if m not in occ or d not in dest or d in occ:continue\n     nb=set(b);np=set(p)\n     (nb if kind=='b' else np).remove(s);(nb if kind=='b' else np).add(d)\n     if kind=='p' and m in np:np.remove(m)\n     st=(frozenset(nb),frozenset(np))\n     if st not in seen:seen.add(st);q.append((st,path+((kind,s,d),)))\n return len(seen),best,goals\ndef probe(e):\n pre=json.load(open('checkpoint.json'))['final_path'];c=json.load(open('level9_candidate_102.json'))\n for a in pre:play(e,a)\n n=e.clone()\n for a in c[:28]:play(n,a)\n seen,best,goals=solve(lattice(n.frame()));print('STATIC',{'seen':seen,'best':best,'goal':goals[:1]})\narena.run_program('lf52',probe)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
