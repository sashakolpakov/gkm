{"type":"item.started","item":{"id":"item_96","type":"command_execution","command":"/bin/zsh -lc \"MPLCONFIGDIR=/tmp/gkm_mpl python - <<'PY'\nimport json,sys\nsys.path.insert(0,'/Users/sasha/gkm/arc/crack_lab')\nimport gkm_arena as arena\nfrom perception import frame_delta\nfrom legs import _bridge_carrier_state\nfrom probe_level9_shortest_suffix import play\n\ndef sm(e):s=_bridge_carrier_state(e.frame());return {'p':sorted(s[1]),'c':sorted(s[2]),'r':sorted(s[4]),'sel':s[5],'l':e.levels_completed}\ndef probe(e):\n pre=json.load(open('checkpoint.json'))['final_path'];c=json.load(open('level9_candidate_102.json'))\n for a in pre:play(e,a)\n base=e.clone()\n for a in c[:28]:play(base,a)\n print('BASE',sm(base))\n sources=[(21,35),(22,35),(21,36),(22,36),(20,35),(23,35)]\n dests=[(10,36),(16,36),(28,36),(22,24),(22,48),(52,12)]\n for src in sources:\n  n=base.clone();f=n.frame();play(n,[6,src[0],src[1]]);d=frame_delta(f,n.frame());print('SEL',src,d['count'],sm(n))\n  for dst in dests:\n   q=n.clone();play(q,[6,dst[0],dst[1]])\n   if sm(q)\"'!=sm(n):print('\"'MOVE',src,dst,sm(q))\nlevels,path,error=arena.run_program('lf52',probe);print('H',levels,len(path),error)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
