\n   560\t    # In the parallel section, synchronize the carriers to create the two\n   561\t    # otherwise missing vertical landings and finish with a peg capture.\n   562\t    play_lattice_moves(env, (\n   563\t        ((36, 18), (36, 30)),\n   564\t        ((42, 6), (42, 18)),\n   565\t        ((42, 18), (42, 30)),\n   566\t    ))\n   567\t    play_actions(env, (2, 3, 3, 3, 2, 2))\n   568\t    play_lattice_moves(env, (((42, 30), (30, 30)),))\n   569\t    play_actions(env, (1, 1, 4, 4, 4, 2, 2, 4, 2))\n   570\t    play_lattice_moves(env, (((24, 54), (36, 54)),))\n   571\t    play_actions(env, (1, 3, 1, 3, 3, 2, 4, 2, 2))\n   572\t    play_lattice_moves(env, (((42, 54), (30, 54)),))\n   573\t\n   574\t\n   575\tdef solve_grid_wrapped_bridge_carrier_peg_solitaire(env):\n   576\t    \"\"\"Relay a peg through a grid of synchronized wrapped carriers.\"\"\"\n   577\t    # Bring the left carrier to its entry and assemble the reusable bridge\n   578\t    # pair so the left peg can enter it.\n   579\t    play_actions(env, (3, 3, 1, 1, 1, 1, 4))\n   580\t    play_lattice_moves(env, (\n   581\t        ((48, 30), (36, 30)),\n   582\t        ((42, 30), (30, 30)),\n   583\t        ((36, 30), (24, 30)),\n   584\t        ((24, 12), (24, 24)),\n   585\t        ((24, 24), (24, 36)),\n   586\t        ((24, 36), (24, 48)),\n   587\t        ((24, 48), (36, 48)),\n   588\t        ((36, 48), (36, 36)),\n   589\t        ((24, 30), (36, 30)),\n   590\t        ((36, 36), (36, 24)),\n   591\t        ((36, 24), (36, 12)),\n   592\t    ))\n   593\t\n   594\t    # Wrap to the lower board.  Move the blocked carriers independently,\n   595\t    # stage the newly revealed bridge pair, and transfer the peg downward.\n   596\t    play_actions(env, (3, 2, 2, 2, 2, 4, 4, 4, 2, 3, 3, 3))\n   597\t    play_lattice_moves(env, (\n   598\t        ((42, 54), (42, 42)),\n   599\t        ((42, 48), (42, 36)),\n   600\t        ((42, 42), (42, 30)),\n   601\t        ((42, 36), (42, 24)),\n   602\t        ((36