ion, states = solve(entry.frame())\n    85\t    clone = entry.clone()\n    86\t    deltas = []\n    87\t    for kind, source, destination in solution:\n    88\t        before = clone.frame()\n    89\t        clone.step(6, source[1] + 1, source[0] + 1)\n    90\t        clone.step(6, destination[1] + 1, destination[0] + 1)\n    91\t        deltas.append(frame_delta(before, clone.frame())[\"count\"])\n    92\t    print(\"EXTRACTED\", extract(entry.frame()))\n    93\t    print(\"SOLUTION\", {\"moves\": len(solution), \"states\": states, \"path\": solution})\n    94\t    print(\"VERIFY\", {\n    95\t        \"levels\": clone.levels_completed,\n    96\t        \"deltas\": deltas,\n    97\t        \"post_extract\": extract(clone.frame()),\n    98\t    })\n    99\t\n   100\t\n   101\tlevels, path, error = arena.run_program(\"lf52\", probe)\n   102\tprint(\"HARNESS\", {\"levels\": levels, \"moves\": len(path), \"error\": str(error) if error else None})\n","exit_code":0,"status":"completed"}}
