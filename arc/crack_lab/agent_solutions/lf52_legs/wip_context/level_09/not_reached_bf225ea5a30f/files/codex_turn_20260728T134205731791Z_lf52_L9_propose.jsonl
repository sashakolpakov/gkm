 blob.top_left\n   421\t        for blob in blobs\n   422\t        if blob.color == 14 and blob.size == (4, 4)\n   423\t    }\n   424\t    return slots, carriers, bridges, pegs\n   470\tdef solve_wrapped_bridge_carrier_peg_solitaire(env):\n   471\t    \"\"\"Solve a long relay whose carrier rails reveal successive peg regions.\"\"\"\n   472\t    local_solution = _movable_bridge_solution(env.frame())\n   473\t    if local_solution is None:\n   474\t        return\n   475\t    play_lattice_moves(env, local_solution)\n   476\t\n   477\t    _, carriers, bridges, _ = _movable_bridge_board(env.frame())\n   478\t    if len(carriers) != 1 or len(bridges) != 1:\n   479\t        return\n   480\t    play_lattice_moves(env, ((next(iter(bridges)), next(iter(carriers))),))\n   481\t\n   482\t    play_actions(env, (4,) * 9 + (1, 3, 3, 1, 1))\n   483\t\n   484\t    play_lattice_moves(env, (\n   485\t        ((30, 28), (18, 28)),\n   486\t        ((18, 28), (18, 40)),\n   487\t        ((30, 46), (18, 46)),\n   488\t        ((18, 40), (18, 52)),\n   489\t        ((18, 2), (18, 14)),\n   490\t        ((18, 8), (18, 20)),\n   491\t        ((18, 14), (18, 26)),\n   492\t        ((18, 20), (18, 32)),\n   493\t        ((18, 26), (18, 38)),\n   494\t        ((18, 32), (18, 44)),\n   495\t        ((18, 38), (30, 38)),\n   496\t    ))\n   497\t    play_actions(env, (2, 2, 4, 4, 1, 1, 1, 1))\n   498\t    play_lattice_moves(env, (\n   499\t        ((18, 44), (18, 56)),\n   500\t        ((18, 56), (30, 56)),\n   501\t    ))\n   502\t\n   503\t    play_actions(env, (2, 2))\n   504\t    play_lattice_moves(env, (((30, 56), (30, 44)),))\n   505\t    play_actions(env, (2, 2, 3, 3, 1, 1))\n   506\t    play_lattice_moves(env, (\n   507\t        ((30, 44), (30, 32)),\n   508\t        ((30, 32), (42, 32)),\n   509\t    ))\n   510\t\n   511\t    play_actions(env, (2, 2))\n   512\t    play_lattice_moves(env, (\n   513\t        ((42, 38), (42, 26)),\n   514\t        ((42, 32), (42, 20)),\n   515\t        ((