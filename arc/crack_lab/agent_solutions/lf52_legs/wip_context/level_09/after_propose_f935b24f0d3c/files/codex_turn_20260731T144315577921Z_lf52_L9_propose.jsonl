el': 8}}\nREMOTE_SELECTED {'action': 7, 'delta': {'count': 29, 'bbox': (0, 38, 22, 62)}, 'state': {'pegs': [(36, 22)], 'carriers': [], 'bridges': [(12, 16), (12, 28), (24, 4), (24, 40), (24, 52)], 'selected': None, 'level': 8}}\nHARNESS {'levels': 8, 'moves': 544, 'error': None}\n","exit_code":0,"status":"completed"}}
