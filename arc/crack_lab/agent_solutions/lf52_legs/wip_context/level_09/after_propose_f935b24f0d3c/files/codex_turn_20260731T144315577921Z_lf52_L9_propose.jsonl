{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"python - <<'PY'\nfrom collections import deque\nD={(24,30),(36,24),(36,30),(48,24),(48,30),(24,36),(24,42),(36,36),(36,42),(48,36),(48,42),(18,18),(30,18),(18,24),(18,30),(30,24),(30,30),(18,36),(18,42),(30,36),(30,42),(42,18),(42,24),(42,30),(24,18),(36,18),(48,18),(42,36),(24,24)}\nB=frozenset({(24,36),(42,24),(18,30),(48,24)}); P=frozenset({(42,18),(48,42)})\nfor old_stays in (False,True):\n d=set(D); d.add((36,54))\n if not old_stays:d.remove((36,42))\n q=deque([((B,P),())]);seen={(B,P)};sol=None\n while q:\n  (b,p),path=q.popleft()\n  if len(p)==1 and p=={(36,54)}:sol=path;break\n  if len(path)>=20:continue\n  occ=b|p\n  for kind,pieces in [('b',b),('p',p)]:\n   for s in sorted(pieces):\n    for dr,dc in ((-6,0),(6,0),(0,-6),(0,6)):\n     m=(s[0]+dr,s[1]+dc);t=(s[0]+2*dr,s[1]+2*dc)\n     if m not in occ or t not in d or t in occ:continue\n     bb=set(b);pp=set(p)\n     if kind=='b':bb.remove(s);bb.add(t)\n     else:pp.remove(s);pp.add(t);pp.discard(m)\n     ch=(frozenset(bb),frozenset(pp))\n     if ch not in seen:seen.add(ch);q.append((ch,path+((kind,s,t),)))\n print('old',old_stays,'states',len(seen),'sol',None if sol is None else len(sol),sol)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
