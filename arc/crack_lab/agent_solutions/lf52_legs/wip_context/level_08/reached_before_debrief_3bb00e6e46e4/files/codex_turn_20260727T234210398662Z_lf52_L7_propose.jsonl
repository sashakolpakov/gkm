{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"nl -ba legs.py | sed -n '103,170p'\nnl -ba legs.py | sed -n '247,374p'\"","aggregated_output":"   103\tdef _carrier_capture_macros(frame):\n   104\t    \"\"\"Return visible peg captures, including an empty bordered carrier.\"\"\"\n   105\t    slots, pegs = _peg_board(frame)\n   106\t    carriers = {\n   107\t        blob.top_left\n   108\t        for blob in connected_components(frame, colors=(12,))\n   109\t        if blob.size == (4, 4)\n   110\t    }\n   111\t    step = _lattice_step(slots | carriers)\n   112\t    if not step:\n   113\t        return ()\n   114\t    destinations = slots | carriers\n   115\t    macros = []\n   116\t    for source in sorted(pegs):\n   117\t        for dr, dc in ((-step, 0), (step, 0), (0, -step), (0, step)):\n   118\t            jumped = (source[0] + dr, source[1] + dc)\n   119\t            destination = (source[0] + 2 * dr, source[1] + 2 * dc)\n   120\t            if (\n   121\t                jumped in pegs\n   122\t                and destination in destinations\n   123\t                and destination not in pegs\n   124\t            ):\n   125\t                macros.append((\n   126\t                    (6, source[1] + 1, source[0] + 1),\n   127\t                    (6, destination[1] + 1, destination[0] + 1),\n   128\t                ))\n   129\t    return tuple(macros)\n   130\t\n   131\t\n   132\tdef solve_peg_solitaire_with_carrier(env, max_states=2000, max_depth=40):\n   133\t    \"\"\"Solve peg boards connected by a key-movable bordered carrier slot.\"\"\"\n   134\t    base_level = env.levels_completed\n   135\t\n   136\t    def key(node):\n   137\t        frame = arr(node.frame())\n   138\t        return int(node.levels_completed), frame[1:, :].tobytes()\n   139\t\n   140\t    queue = deque([(env.clone(), ())])\n   141\t    seen = {key(env)}\n   142\t    solution = None\n   143\t    while queue and len(seen) < max_states:\n   144\t        node, path = queue.popleft()\n   145\t        if len(path) >= max_depth:\n   146\t            continue\n   147\t        macros = tuple((action,) for action in (1, 2, 3, 4))\n   148\t        macros += _carrier_capture_macros(node.frame())\n   149\t        for macro in macros:\n   150\t            child = node.clone()\n   151\t            for action in macro:\n   152\t                play_action(child, action)\n   153\t                if child.levels_completed > base_level:\n   154\t                    solution = path + (macro,)\n   155\t                    break\n   156\t            if solution is not None:\n   157\t                queue.clear()\n   158\t                break\n   159\t            child_key = key(child)\n   160\t            if child_key not in seen:\n   161\t                seen.add(child_key)\n   162\t                queue.append((child, path + (macro,)))\n   163\t\n   164\t    if solution is None:\n   165\t        return\n   166\t    for macro in solution:\n   167\t        play_actions(env, macro)\n   168\t\n   169\t\n   170\tdef _bridge_carrier_state(frame):\n   247\tdef solve_bridge_carrier_peg_solitaire(\n   248\t        env, max_align_states=120, max_macros=40, alignment_lookahead=24):\n   249\t    \"\"\"Solve peg boards joined by persistent bridges and a movable carrier.\"\"\"\n   250\t    base_level = env.levels_completed\n   251\t    node = env.clone()\n   252\t    solution = []\n   253\t    forbidden = set()\n   254\t\n   255\t    def bridge_score(state, move):\n   256\t        \"\"\"Dense progress: distance from a bridge landing to another peg.\"\"\"\n   257\t        pegs = state[1]\n   258\t        _, source, destination = move\n   259\t        others = pegs - {source}\n   260\t        if not others:\n   261\t            return 10 ** 9\n   262\t        return min(\n   263\t            abs(destination[0] - peg[0]) + abs(destination[1] - peg[1])\n   264\t            for peg in others\n   265\t        )\n   266\t\n   267\t    def choose_state(state, blocked):\n   268\t        moves = _bridge_carrier_moves_from_state(state)\n   269\t        captures = [move for move in moves if move[0] == \"capture\"]\n   270\t        if captures:\n   271\t            return captures[0]\n   272\t        bridges = [\n   273\t            move for move in moves\n   274\t            if (move[1], move[2]) not in blocked\n   275\t        ]\n   276\t        return min(bridges, key=lambda move: bridge_score(state, move)) if bridges else None\n   277\t\n   278\t    def choose(frame, blocked):\n   279\t        return choose_state(_bridge_carrier_state(frame), blocked)\n   280\t\n   281\t    def alignment_priority(state, path):\n   282\t        slots, pegs = state[:2]\n   283\t        ordered_pegs = sorted(pegs)\n   284\t        distances = [\n   285\t            abs(first[0] - second[0]) + abs(first[1] - second[1])\n   286\t            for index, first in enumerate(ordered_pegs)\n   287\t            for second in ordered_pegs[index + 1:]\n   288\t        ]\n   289\t        pair_distance = min(distances) if distances else 10 ** 9\n   290\t        return -len(pegs), pair_distance, -len(slots), len(path)\n   291\t\n   292\t    def alignment_path(root, blocked):\n   293\t        root_state = _bridge_carrier_state(root.frame())\n   294\t        serial = 0\n   295\t        queue = [(alignment_priority(root_state, ()), serial, ())]\n   296\t        seen = {root_state}\n   297\t        best_path = None\n   298\t        best_score = None\n   299\t        first_candidate_seen = None\n   300\t        while queue and len(seen) < max_align_states:\n   301\t            _, _, path = heappop(queue)\n   302\t            if (\n   303\t                first_candidate_seen is not None\n   304\t                and len(seen) >= first_candidate_seen + alignment_lookahead\n   305\t            ):\n   306\t                return best_path\n   307\t            for action in (4, 3, 2, 1):\n   308\t                child_path = path + (action,)\n   309\t                child = root.clone()\n   310\t                play_actions(child, child_path)\n   311\t                if child.levels_completed > base_level:\n   312\t                    return child_path\n   313\t                state = _bridge_carrier_state(child.frame())\n   314\t                if state in seen:\n   315\t                    continue\n   316\t                seen.add(state)\n   317\t                move = choose_state(state, blocked)\n   318\t                if move is not None:\n   319\t                    if move[0] == \"capture\":\n   320\t                        return child_path\n   321\t                    score = bridge_score(state, move)\n   322\t                    if best_score is None or score < best_score:\n   323\t                        best_path, best_score = child_path, score\n   324\t                    if first_candidate_seen is None:\n   325\t                        first_candidate_seen = len(seen)\n   326\t                    step = _lattice_step(state[0] | state[2])\n   327\t                    if step and score <= step:\n   328\t                        return child_path\n   329\t                if len(child_path) < 16:\n   330\t                    serial += 1\n   331\t                    heappush(\n   332\t                        queue,\n   333\t                        (alignment_priority(state, child_path), serial, child_path),\n   334\t                    )\n   335\t        return best_path\n   336\t\n   337\t    for _ in range(max_macros):\n   338\t        if node.levels_completed > base_level:\n   339\t            break\n   340\t        move = choose(node.frame(), forbidden)\n   341\t        if move is None:\n   342\t            keys = alignment_path(node, forbidden)\n   343\t            if keys is None:\n   344\t                return\n   345\t            for action in keys:\n   346\t                node.step(action)\n   347\t                solution.append(action)\n   348\t            if node.levels_completed > base_level:\n   349\t                break\n   350\t            move = choose(node.frame(), forbidden)\n   351\t            if move is None:\n   352\t                return\n   353\t        kind, source, destination = move\n   354\t        before = _bridge_carrier_state(node.frame())\n   355\t        clicks = (\n   356\t            (6, source[1] + 1, source[0] + 1),\n   357\t            (6, destination[1] + 1, destination[0] + 1),\n   358\t        )\n   359\t        play_actions(node, clicks)\n   360\t        solution.extend(clicks)\n   361\t        after = _bridge_carrier_state(node.frame())\n   362\t        if after == before:\n   363\t            return\n   364\t        if kind == \"bridge\":\n   365\t            forbidden.add((destination, source))\n   366\t        else:\n   367\t            forbidden.clear()\n   368\t\n   369\t    if node.levels_completed <= base_level:\n   370\t        return\n   371\t    play_actions(env, solution)\n   372\t\n   373\t\n   374\tdef _movable_bridge_board(frame):\n","exit_code":0,"status":"completed"}}
