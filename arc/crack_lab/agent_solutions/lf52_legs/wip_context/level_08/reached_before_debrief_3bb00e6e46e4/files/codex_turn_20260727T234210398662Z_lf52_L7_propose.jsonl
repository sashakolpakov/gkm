{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba legs.py | sed -n '1,110p'\nnl -ba legs.py | sed -n '170,250p'\nnl -ba legs.py | sed -n '374,500p'\"","aggregated_output":"     1\t# Shared leg library: small, named, reusable skills.\n     2\t# Players import from here; add a NEW leg only when no existing leg fits.\n     3\t\n     4\tfrom collections import deque\n     5\tfrom heapq import heappop, heappush\n     6\tfrom math import gcd\n     7\t\n     8\tfrom perception import arr, connected_components\n     9\t\n    10\t\n    11\tdef play_action(env, action):\n    12\t    \"\"\"Execute one key action or coordinate-click action.\"\"\"\n    13\t    if isinstance(action, tuple):\n    14\t        env.step(*action)\n    15\t    else:\n    16\t        env.step(action)\n    17\t\n    18\t\n    19\tdef play_actions(env, actions):\n    20\t    \"\"\"Execute key and coordinate-click actions in order.\"\"\"\n    21\t    for action in actions:\n    22\t        play_action(env, action)\n    23\t\n    24\t\n    25\tdef play_lattice_moves(env, moves):\n    26\t    \"\"\"Execute source/destination moves on the visible slot lattice.\"\"\"\n    27\t    for source, destination in moves:\n    28\t        play_actions(env, (\n    29\t            (6, source[1] + 1, source[0] + 1),\n    30\t            (6, destination[1] + 1, destination[0] + 1),\n    31\t        ))\n    32\t\n    33\t\n    34\tdef _peg_board(frame):\n    35\t    \"\"\"Return the slot lattice and occupied slots visible in a peg board.\"\"\"\n    36\t    holes = {\n    37\t        blob.top_left\n    38\t        for blob in connected_components(frame, colors=(1,))\n    39\t        if blob.size == (4, 4) and blob.area == 16\n    40\t    }\n    41\t    pegs = {\n    42\t        blob.top_left\n    43\t        for blob in connected_components(frame, colors=(14,))\n    44\t        if blob.size == (4, 4)\n    45\t    }\n    46\t    return holes | pegs, frozenset(pegs)\n    47\t\n    48\t\n    49\tdef _lattice_step(slots):\n    50\t    coordinates = [\n    51\t        sorted({position[axis] for position in slots})\n    52\t        for axis in (0, 1)\n    53\t    ]\n    54\t    differences = [\n    55\t        later - earlier\n    56\t        for values in coordinates\n    57\t        for earlier, later in zip(values, values[1:])\n    58\t        if later > earlier\n    59\t    ]\n    60\t    step = 0\n    61\t    for difference in differences:\n    62\t        step = gcd(step, difference)\n    63\t    return step\n    64\t\n    65\t\n    66\tdef _peg_solution(slots, start):\n    67\t    \"\"\"Find captures that leave the confirmed winning state of one peg.\"\"\"\n    68\t    step = _lattice_step(slots)\n    69\t    if not step:\n    70\t        return None\n    71\t    queue = deque([(start, ())])\n    72\t    seen = {start}\n    73\t    directions = ((-step, 0), (step, 0), (0, -step), (0, step))\n    74\t    while queue:\n    75\t        pegs, path = queue.popleft()\n    76\t        if len(pegs) == 1:\n    77\t            return path\n    78\t        for source in sorted(pegs):\n    79\t            for dr, dc in directions:\n    80\t                jumped = (source[0] + dr, source[1] + dc)\n    81\t                destination = (source[0] + 2 * dr, source[1] + 2 * dc)\n    82\t                if (\n    83\t                    jumped in pegs\n    84\t                    and destination in slots\n    85\t                    and destination not in pegs\n    86\t                ):\n    87\t                    child = frozenset((pegs - {source, jumped}) | {destination})\n    88\t                    if child not in seen:\n    89\t                        seen.add(child)\n    90\t                        queue.append((child, path + ((source, destination),)))\n    91\t    return None\n    92\t\n    93\t\n    94\tdef solve_peg_solitaire(env):\n    95\t    \"\"\"Solve a visible orthogonal peg-solitaire board using coordinate clicks.\"\"\"\n    96\t    slots, pegs = _peg_board(env.frame())\n    97\t    solution = _peg_solution(slots, pegs)\n    98\t    if solution is None:\n    99\t        return\n   100\t    play_lattice_moves(env, solution)\n   101\t\n   102\t\n   103\tdef _carrier_capture_macros(frame):\n   104\t    \"\"\"Return visible peg captures, including an empty bordered carrier.\"\"\"\n   105\t    slots, pegs = _peg_board(frame)\n   106\t    carriers = {\n   107\t        blob.top_left\n   108\t        for blob in connected_components(frame, colors=(12,))\n   109\t        if blob.size == (4, 4)\n   110\t    }\n   170\tdef _bridge_carrier_state(frame):\n   171\t    \"\"\"Return the puzzle-relevant geometry of a bridge/carrier peg board.\"\"\"\n   172\t    blobs = connected_components(\n   173\t        frame, colors=(1, 3, 11, 12, 14, 15)\n   174\t    )\n   175\t    slots = {\n   176\t        blob.top_left\n   177\t        for blob in blobs\n   178\t        if blob.color == 1 and blob.size == (4, 4) and blob.area == 16\n   179\t    }\n   180\t    pegs = {\n   181\t        blob.top_left\n   182\t        for blob in blobs\n   183\t        if blob.color == 14 and blob.size == (4, 4)\n   184\t    }\n   185\t    slots |= {\n   186\t        (blob.bbox[0] - 1, blob.bbox[1] - 1)\n   187\t        for blob in blobs\n   188\t        if blob.color == 1 and blob.size == (2, 2) and blob.area == 4\n   189\t    }\n   190\t    carriers = frozenset(\n   191\t        (\n   192\t            (blob.bbox[0] - 1, blob.bbox[1] - 1)\n   193\t            if blob.size == (2, 2) else blob.top_left\n   194\t        )\n   195\t        for blob in blobs\n   196\t        if blob.color == 12 and blob.size in ((2, 2), (4, 4))\n   197\t    )\n   198\t    bridges = frozenset(\n   199\t        (blob.bbox[0] + 1, blob.bbox[1])\n   200\t        for blob in blobs\n   201\t        if blob.color == 15 and blob.size == (4, 4)\n   202\t    )\n   203\t    borders = frozenset(\n   204\t        blob.top_left\n   205\t        for blob in blobs\n   206\t        if blob.color == 11 and blob.area >= 4\n   207\t    )\n   208\t    selected_blobs = [\n   209\t        blob for blob in blobs\n   210\t        if blob.color == 3 and blob.area >= 4\n   211\t    ]\n   212\t    selected = (\n   213\t        (selected_blobs[0].bbox[0] + 1, selected_blobs[0].bbox[1] + 1)\n   214\t        if selected_blobs else None\n   215\t    )\n   216\t    return (\n   217\t        frozenset(slots), frozenset(pegs), carriers,\n   218\t        bridges, borders, selected,\n   219\t    )\n   220\t\n   221\t\n   222\tdef _bridge_carrier_moves_from_state(state):\n   223\t    slots, pegs, carriers, bridges, _, _ = state\n   224\t    step = _lattice_step(slots | carriers)\n   225\t    if not step:\n   226\t        return ()\n   227\t    moves = []\n   228\t    destinations = slots | carriers\n   229\t    for source in sorted(pegs):\n   230\t        for dr, dc in ((-step, 0), (step, 0), (0, -step), (0, step)):\n   231\t            midpoint = (source[0] + dr, source[1] + dc)\n   232\t            destination = (source[0] + 2 * dr, source[1] + 2 * dc)\n   233\t            if destination not in destinations or destination in pegs:\n   234\t                continue\n   235\t            if midpoint in pegs:\n   236\t                moves.append((\"capture\", source, destination))\n   237\t            elif midpoint in bridges:\n   238\t                moves.append((\"bridge\", source, destination))\n   239\t    return tuple(moves)\n   240\t\n   241\t\n   242\tdef _bridge_carrier_moves(frame):\n   243\t    \"\"\"Return legal (kind, source, destination) peg moves.\"\"\"\n   244\t    return _bridge_carrier_moves_from_state(_bridge_carrier_state(frame))\n   245\t\n   246\t\n   247\tdef solve_bridge_carrier_peg_solitaire(\n   248\t        env, max_align_states=120, max_macros=40, alignment_lookahead=24):\n   249\t    \"\"\"Solve peg boards joined by persistent bridges and a movable carrier.\"\"\"\n   250\t    base_level = env.levels_completed\n   374\tdef _movable_bridge_board(frame):\n   375\t    \"\"\"Return visible slots, carriers, movable bridges, and pegs.\"\"\"\n   376\t    blobs = connected_components(frame, colors=(1, 8, 12, 14))\n   377\t    slots = {\n   378\t        blob.top_left\n   379\t        for blob in blobs\n   380\t        if blob.color == 1 and blob.size == (4, 4) and blob.area == 16\n   381\t    }\n   382\t    carriers = {\n   383\t        blob.top_left\n   384\t        for blob in blobs\n   385\t        if blob.color == 12 and blob.size == (4, 4)\n   386\t    }\n   387\t    bridges = {\n   388\t        blob.top_left\n   389\t        for blob in blobs\n   390\t        if blob.color == 8 and blob.size == (4, 4)\n   391\t    }\n   392\t    pegs = {\n   393\t        blob.top_left\n   394\t        for blob in blobs\n   395\t        if blob.color == 14 and blob.size == (4, 4)\n   396\t    }\n   397\t    return slots, carriers, bridges, pegs\n   398\t\n   399\t\n   400\tdef _movable_bridge_solution(frame, max_states=20000):\n   401\t    \"\"\"Solve a visible relay board containing one reusable movable bridge.\"\"\"\n   402\t    slots, carriers, bridges, pegs = _movable_bridge_board(frame)\n   403\t    if len(bridges) != 1:\n   404\t        return None\n   405\t    start = (frozenset(pegs), next(iter(bridges)))\n   406\t    queue = deque([(start, ())])\n   407\t    seen = {start}\n   408\t    destinations = slots | carriers\n   409\t    while queue and len(seen) <= max_states:\n   410\t        (state_pegs, bridge), path = queue.popleft()\n   411\t        if len(state_pegs) == 1 and next(iter(state_pegs)) in carriers:\n   412\t            return path\n   413\t        occupied = state_pegs | {bridge}\n   414\t        pieces = tuple((\"peg\", peg) for peg in sorted(state_pegs))\n   415\t        pieces += ((\"bridge\", bridge),)\n   416\t        for kind, source in pieces:\n   417\t            for dr, dc in ((-6, 0), (6, 0), (0, -6), (0, 6)):\n   418\t                midpoint = (source[0] + dr, source[1] + dc)\n   419\t                destination = (source[0] + 2 * dr, source[1] + 2 * dc)\n   420\t                if (\n   421\t                    destination not in destinations\n   422\t                    or destination in occupied\n   423\t                    or midpoint not in occupied\n   424\t                    or (kind == \"bridge\" and midpoint not in state_pegs)\n   425\t                ):\n   426\t                    continue\n   427\t                child_pegs = set(state_pegs)\n   428\t                child_bridge = bridge\n   429\t                if kind == \"bridge\":\n   430\t                    child_bridge = destination\n   431\t                else:\n   432\t                    child_pegs.remove(source)\n   433\t                    child_pegs.add(destination)\n   434\t                    if midpoint in child_pegs:\n   435\t                        child_pegs.remove(midpoint)\n   436\t                child = (frozenset(child_pegs), child_bridge)\n   437\t                if child not in seen:\n   438\t                    seen.add(child)\n   439\t                    queue.append((child, path + ((source, destination),)))\n   440\t    return None\n   441\t\n   442\t\n   443\tdef solve_wrapped_bridge_carrier_peg_solitaire(env):\n   444\t    \"\"\"Solve a long relay whose carrier rails reveal successive peg regions.\"\"\"\n   445\t    local_solution = _movable_bridge_solution(env.frame())\n   446\t    if local_solution is None:\n   447\t        return\n   448\t    play_lattice_moves(env, local_solution)\n   449\t\n   450\t    _, carriers, bridges, _ = _movable_bridge_board(env.frame())\n   451\t    if len(carriers) != 1 or len(bridges) != 1:\n   452\t        return\n   453\t    play_lattice_moves(env, ((next(iter(bridges)), next(iter(carriers))),))\n   454\t\n   455\t    play_actions(env, (4,) * 9 + (1, 1, 3, 3, 1, 1))\n   456\t\n   457\t    play_lattice_moves(env, (\n   458\t        ((30, 28), (18, 28)),\n   459\t        ((18, 28), (18, 40)),\n   460\t        ((30, 46), (18, 46)),\n   461\t        ((18, 40), (18, 52)),\n   462\t        ((18, 2), (18, 14)),\n   463\t        ((18, 8), (18, 20)),\n   464\t        ((18, 14), (18, 26)),\n   465\t        ((18, 20), (18, 32)),\n   466\t        ((18, 26), (18, 38)),\n   467\t        ((18, 32), (18, 44)),\n   468\t        ((18, 38), (30, 38)),\n   469\t    ))\n   470\t    play_actions(env, (2, 2, 4, 4, 1, 1, 1, 1))\n   471\t    play_lattice_moves(env, (\n   472\t        ((18, 44), (18, 56)),\n   473\t        ((18, 56), (30, 56)),\n   474\t    ))\n   475\t\n   476\t    play_actions(env, (2, 2))\n   477\t    play_lattice_moves(env, (((30, 56), (30, 44)),))\n   478\t    play_actions(env, (2, 2, 3, 3, 1, 1))\n   479\t    play_lattice_moves(env, (\n   480\t        ((30, 44), (30, 32)),\n   481\t        ((30, 32), (42, 32)),\n   482\t    ))\n   483\t\n   484\t    play_actions(env, (2, 2))\n   485\t    play_lattice_moves(env, (\n   486\t        ((42, 38), (42, 26)),\n   487\t        ((42, 32), (42, 20)),\n   488\t        ((42, 20), (54, 20)),\n   489\t    ))\n","exit_code":0,"status":"completed"}}
