\t    return None, None, len(seen)\n    47\t\n    48\t\n    49\tdef probe(env):\n    50\t    with open(\"checkpoint.json\") as stream:\n    51\t        checkpoint = json.load(stream)\n    52\t    assert checkpoint[\"game\"] == \"lf52\" and checkpoint[\"validated\"]\n    53\t    for action in checkpoint[\"final_path\"]:\n    54\t        act(env, tuple(action) if isinstance(action, list) else action)\n    55\t    base = env.levels_completed\n    56\t    blocked = set()\n    57\t    for index in range(50):\n    58\t        if env.levels_completed > base:\n    59\t            break\n    60\t        move = choose(env.frame(), blocked)\n    61\t        if move is None:\n    62\t            path, move, states = alignment(env, blocked)\n    63\t            print(\"ALIGN\", index, states, path, move)\n    64\t            if path is None:\n    65\t                break\n    66\t            for action in path:\n    67\t                env.step(action)\n    68\t        kind, source, destination = move\n    69\t        pegs_before = len(_bridge_carrier_state(env.frame())[1])\n    70\t        env.step(6, source[1] + 1, source[0] + 1)\n    71\t        env.step(6, destination[1] + 1, destination[0] + 1)\n    72\t        pegs_after = len(_bridge_carrier_state(env.frame())[1])\n    73\t        print(\n    74\t            \"MACRO\", index, kind, source, destination,\n    75\t            \"PEGS\", pegs_before, pegs_after,\n    76\t            \"LEVEL\", env.levels_completed,\n    77\t        )\n    78\t        if kind == \"bridge\":\n    79\t            blocked.add((destination, source))\n    80\t        else:\n    81\t            blocked.clear()\n    82\t    print(\"FINAL\", env.levels_completed, _bridge_carrier_state(env.frame()))\n    83\t\n    84\t\n    85\tlevels, path, err = A.run_program(\"lf52\", probe)\n    86\tprint(\"END\", levels, len(path), err)\n     1\timport json\n     2\timport sys\n     3\tfrom collections import deque\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\t\n     7\timport gkm_arena as A\n     8\t\n     9\tfrom legs import _bridge_carrier_state\n    10\tfrom perception import arr\n    11\t\n    12\t\n    13\tPREFIX = (\n    14\t    (6, 13, 25), (6, 25, 25),\n    15\t    3, 3, 2, 2, 2,\n    16\t    (6, 25, 25), (6, 37, 25),\n    17\t    4, 4, 4, 2, 2, 2,\n    18\t    (6, 43, 25), (6, 31, 25),\n    19\t)\n    20\t\n    21\t\n    22\tdef act(env, action):\n    23\t    env.step(*action) if isinstance(action, tuple) else env.step(action)\n    24\t\n    25\t\n    26\tdef key(env):\n    27\t    return arr(env.frame())[1:, :].tobytes()\n    28\t\n    29\t\n    30\tdef pegs(env):\n    31\t    pixels = {tuple(point) for point in zip(*((arr(env.frame()) == 14).nonzero()))}\n    32\t    out = []\n    33\t    while pixels:\n    34\t        seed = pixels.pop()\n    35\t        stack = [seed]\n    36\t        component = {seed}\n    37\t        while stack:\n    38\t            row, col = stack.pop()\n    39\t            for point in (\n    40\t                (row - 1, col), (row + 1, col),\n    41\t                (row, col - 1), (row, col + 1),\n    42\t            ):\n    43\t                if point in pixels:\n    44\t                    pixels.remove(point)\n    45\t                    component.add(point)\n    46\t                    stack.append(point)\n    47\t        rows = [point[0] for point in component]\n    48\t        cols = [point[1] for point in component]\n    49\t        if max(rows) - min(rows) == 3 and max(cols) - min(cols) == 3:\n    50\t            out.append((min(rows), min(cols)))\n    51\t    return tuple(sorted(out))\n    52\t\n    53\t\n    54\tdef clicks(env):\n    55\t    for row, col in pegs(env):\n    56\t        for dr, dc in ((-12, 0), (12, 0), (0, -12), (0, 12)):\n    57\t            dest = row + dr, col + dc\n    58\t            if 0 <= dest[0] < 64 and 0 <= dest[1] < 64:\n    59\t                yield (\n    60\t                    (6, col + 1, row + 1),\n    61\t                    (6, dest[1] + 1, dest[0] + 1),\n    62\t                )\n    63\t\n    64\t\n    65\tdef probe(env):\n    66\t    with open(\"checkpoint.json\") as stream:\n    67\t        checkpoint = json.load(stream)\n    68\t    assert checkpoint[\"game\"] == \"lf52\" and checkpoint[\"validated\"]\n    69\t    for action in checkpoint[\"final_path\"]:\n    70\t        act(env, tuple(action) if isinstance(action, list) else action)\n    71\t    for action in PREFIX:\n    72\t        act(env, action)\n    73\t\n    74\t    base_level = env.levels_completed\n    75\t    queue = deque([(env.clone(), ())])\n    76\t    seen = {key(env)}\n    77\t    transfers = []\n    78\t    solution = None\n    79\t    while queue and len(seen) < 240:\n    80\t        node, path = queue.popleft()\n    81\t        if len(path) >= 14:\n    82\t            continue\n    83\t        candidates = list(clicks(node)) + [(a,) for a in (1, 2, 3, 4)]\n    84\t        for macro in candidates:\n    85\t            child = node.clone()\n    86\t            before_pegs = pegs(child)\n    87\t            for action in macro:\n    88\t                act(child, action)\n    89\t            child_path = path + macro\n    90\t            if child.levels_completed > base_level:\n    91\t                solution = child_path\n    92\t                queue.clear()\n    93\t                break\n    94\t            after = key(child)\n    95\t            after_pegs = pegs(child)\n    96\t            if len(macro) == 2 and after_pegs != before_pegs:\n    97\t                transfers.append((path, macro, before_pegs, after_pegs))\n    98\t            elif len(macro) == 2:\n    99\t                continue\n   100\t            if after not in seen:\n   101\t                seen.add(after)\n   102\t                queue.append((child, child_path))\n   103\t        if solution is not None:\n   104\t            break\n   105\t    print(\"SEARCH\", len(seen), \"QUEUE\", len(queue), \"TRANSFERS\", len(transfers))\n   106\t    for item in transfers[:20]:\n   107\t        print(\"TRANSFER\", item)\n   108\t    print(\"SOLUTION\", solution)\n   109\t\n   110\t\n   111\tlevels, path, err = A.run_program(\"lf52\", probe)\n   112\tprint(\"END\", levels, len(path), err)\n     1\timport json\n     2\timport sys\n     3\t\n     4\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     5\t\n     6\timport gkm_arena as A\n     7\t\n     8\tfrom legs import _bridge_carrier_moves, _bridge_carrier_state\n     9\t\n    10\t\n    11\tPREFIX = (\n    12\t    (6, 13, 25), (6, 25, 25),\n    13\t    3, 3, 2, 2, 2,\n    14\t    (6, 25, 25), (6, 37, 25),\n    15\t    4, 4, 4, 2, 2, 2,\n    16\t    (6, 43, 25), (6, 31, 25),\n    17\t)\n    18\tNAVIGATION = (\n    19\t    2, 2, 3, 2, 4, 4, 4, 1, 1, 1, 1, 4, 4, 4, 2,\n    20\t)\n    21\tCAPTURE = ((6, 31, 25), (6, 43, 25))\n    22\t\n    23\t\n    24\tdef act(env, action):\n    25\t    env.step(*action) if isinstance(action, tuple) else env.step(action)\n    26\t\n    27\t\n    28\tdef probe(env):\n    29\t    with open(\"checkpoint.json\") as stream:\n    30\t        checkpoint = json.load(stream)\n    31\t    assert checkpoint[\"game\"] == \"lf52\" and checkpoint[\"validated\"]\n    32\t    for action in checkpoint[\"final_path\"]:\n    33\t        act(env, tuple(action) if isinstance(action, list) else action)\n    34\t    for action in PREFIX + NAVIGATION:\n    35\t        act(env, action)\n    36\t    print(\"ALIGNED\", env.levels_completed, _bridge_carrier_state(env.frame()))\n    37\t    print(\"MOVES\", _bridge_carrier_moves(env.frame()))\n    38\t    for action in CAPTURE:\n    39\t        act(env, action)\n    40\t    print(\"AFTER\", env.levels_completed, _bridge_carrier_state(env.frame()))\n    41\t    print(\"AFTER_MOVES\", _bridge_carrier_moves(env.frame()))\n    42\t\n    43\t\n    44\tlevels, path, err = A.run_program(\"lf52\", probe)\n    45\tprint(\"END\", levels, len(path), err)\n","exit_code":0,"status":"completed"}}
