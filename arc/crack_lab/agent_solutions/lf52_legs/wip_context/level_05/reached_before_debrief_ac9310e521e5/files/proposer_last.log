 ]\n   198\t    selected = (\n   199\t        (selected_blobs[0].bbox[0] + 1, selected_blobs[0].bbox[1] + 1)\n   200\t        if selected_blobs else None\n   201\t    )\n   202\t    return (\n   203\t        frozenset(slots), frozenset(pegs), carriers,\n   204\t        bridges, borders, selected,\n   205\t    )\n   206\t\n   207\t\n   208\tdef _bridge_carrier_moves_from_state(state):\n   209\t    slots, pegs, carriers, bridges, _, _ = state\n   210\t    step = _lattice_step(slots | carriers)\n   211\t    if not step:\n   212\t        return ()\n   213\t    moves = []\n   214\t    destinations = slots | carriers\n   215\t    for source in sorted(pegs):\n   216\t        for dr, dc in ((-step, 0), (step, 0), (0, -step), (0, step)):\n   217\t            midpoint = (source[0] + dr, source[1] + dc)\n   218\t            destination = (source[0] + 2 * dr, source[1] + 2 * dc)\n   219\t            if destination not in destinations or destination in pegs:\n   220\t                continue\n   221\t            if midpoint in pegs:\n   222\t                moves.append((\"capture\", source, destination))\n   223\t            elif midpoint in bridges:\n   224\t                moves.append((\"bridge\", source, destination))\n   225\t    return tuple(moves)\n   226\t\n   227\t\n   228\tdef _bridge_carrier_moves(frame):\n   229\t    \"\"\"Return legal (kind, source, destination) peg moves.\"\"\"\n   230\t    return _bridge_carrier_moves_from_state(_bridge_carrier_state(frame))\n   231\t\n   232\t\n   233\tdef solve_bridge_carrier_peg_solitaire(\n   234\t        env, max_align_states=120, max_macros=40, alignment_lookahead=24):\n   235\t    \"\"\"Solve peg boards joined by persistent bridges and a movable carrier.\"\"\"\n   236\t    base_level = env.levels_completed\n   237\t    node = env.clone()\n   238\t    solution = []\n   239\t    forbidden = set()\n   240\t\n   241\t    def bridge_score(state, move):\n   242\t        \"\"\"Dense progress: distance from a bridge landing to another peg.\"\"\"\n   243\t        pegs = state[1]\n   244\t        _, source, destination = move\n   245\t        others = pegs - {source}\n   246\t        if not others:\n   247\t            return 10 ** 9\n   248\t        return min(\n   249\t            abs(destination[0] - peg[0]) + abs(destination[1] - peg[1])\n   250\t            for peg in others\n   251\t        )\n   252\t\n   253\t    def choose_state(state, blocked):\n   254\t        moves = _bridge_carrier_moves_from_state(state)\n   255\t        captures = [move for move in moves if move[0] == \"capture\"]\n   256\t        if captures:\n   257\t            return captures[0]\n   258\t        bridges = [\n   259\t            move for move in moves\n   260\t            if (move[1], move[2]) not in blocked\n   261\t        ]\n   262\t        return min(bridges, key=lambda move: bridge_score(state, move)) if bridges else None\n   263\t\n   264\t    def choose(frame, blocked):\n   265\t        return choose_state(_bridge_carrier_state(frame), blocked)\n   266\t\n   267\t    def alignment_priority(state, path):\n   268\t        slots, pegs = state[:2]\n   269\t        ordered_pegs = sorted(pegs)\n   270\t        distances = [\n   271\t            abs(first[0] - second[0]) + abs(first[1] - second[1])\n   272\t            for index, first in enumerate(ordered_pegs)\n   273\t            for second in ordered_pegs[index + 1:]\n   274\t        ]\n   275\t        pair_distance = min(distances) if distances else 10 ** 9\n   276\t        return -len(pegs), pair_distance, -len(slots), len(path)\n   277\t\n   278\t    def alignment_path(root, blocked):\n   279\t        root_state = _bridge_carrier_state(root.frame())\n   280\t        serial = 0\n   281\t        queue = [(alignment_priority(root_state, ()), serial, ())]\n   282\t        seen = {root_state}\n   283\t        best_path = None\n   284\t        best_score = None\n   285\t        first_candidate_seen = None\n   286\t        while queue and len(seen) < max_align_states:\n   287\t            _, _, path = heappop(queue)\n   288\t            if (\n   289\t                first_candidate_seen is not None\n   290\t                and len(seen) >= first_candidate_seen + alignment_lookahead\n   291\t            ):\n   292\t                return best_path\n   293\t            for action in (4, 3, 2, 1):\n   294\t                child_path = path + (action,)\n   295\t                child = root.clone()\n   296\t                for replay_action in child_path:\n   297\t                    child.step(replay_action)\n   298\t                if child.levels_completed > base_level:\n   299\t                    return child_path\n   300\t                state = _bridge_carrier_state(child.frame())\n   301\t                if state in seen:\n   302\t                    continue\n   303\t                seen.add(state)\n   304\t                move = choose_state(state, blocked)\n   305\t                if move is not None:\n   306\t                    if move[0] == \"capture\":\n   307\t                        return child_path\n   308\t                    score = bridge_score(state, move)\n   309\t                    if best_score is None or score < best_score:\n   310\t                        best_path, best_score = child_path, score\n   311\t                    if first_candidate_seen is None:\n   312\t                        first_candidate_seen = len(seen)\n   313\t                    step = _lattice_step(state[0] | state[2])\n   314\t                    if step and score <= step:\n   315\t                        return child_path\n   316\t                if len(child_path) < 16:\n   317\t                    serial += 1\n   318\t                    heappush(\n   319\t                        queue,\n   320\t                        (alignment_priority(state, child_path), serial, child_path),\n   321\t                    )\n   322\t        return best_path\n   323\t\n   324\t    for _ in range(max_macros):\n   325\t        if node.levels_completed > base_level:\n   326\t            break\n   327\t        move = choose(node.frame(), forbidden)\n   328\t        if move is None:\n   329\t            keys = alignment_path(node, forbidden)\n   330\t            if keys is None:\n   331\t                return\n   332\t            for action in keys:\n   333\t                node.step(action)\n   334\t                solution.append(action)\n   335\t            if node.levels_completed > base_level:\n   336\t                break\n   337\t            move = choose(node.frame(), forbidden)\n   338\t            if move is None:\n   339\t                return\n   340\t        kind, source, destination = move\n   341\t        before = _bridge_carrier_state(node.frame())\n   342\t        clicks = (\n   343\t            (6, source[1] + 1, source[0] + 1),\n   344\t            (6, destination[1] + 1, destination[0] + 1),\n   345\t        )\n   346\t        for action in clicks:\n   347\t            node.step(*action)\n   348\t            solution.append(action)\n   349\t        after = _bridge_carrier_state(node.frame())\n   350\t        if after == before:\n     1\t# Per-level players. Each play_level_K(env) ONLY composes legs from legs.py.\n     2\tfrom legs import *  # noqa\n     3\t\n     4\t\n     5\tdef play_level_1(env):\n     6\t    solve_peg_solitaire(env)\n     7\t\n     8\t\n     9\tdef play_level_2(env):\n    10\t    solve_peg_solitaire_with_carrier(env)\n    11\t\n    12\t\n    13\tdef play_level_3(env):\n    14\t    solve_peg_solitaire_with_carrier(env)\n    15\t\n    16\t\n    17\tdef play_level_4(env):\n    18\t    solve_bridge_carrier_peg_solitaire(env)\n    19\t\n    20\t\n    21\tdef play_level_5(env):\n    22\t    solve_bridge_carrier_peg_solitaire(env, max_align_states=650)\n","exit_code":0,"status":"completed"}}
