{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"nl -ba legs.py | sed -n '1,310p'; nl -ba probe_fresh_l5.py | sed -n '1,260p'\"","aggregated_output":"     1\t# Shared leg library: small, named, reusable skills.\n     2\t# Players import from here; add a NEW leg only when no existing leg fits.\n     3\t\n     4\tfrom collections import deque\n     5\tfrom math import gcd\n     6\t\n     7\tfrom perception import arr, connected_components\n     8\t\n     9\t\n    10\tdef _peg_board(frame):\n    11\t    \"\"\"Return the slot lattice and occupied slots visible in a peg board.\"\"\"\n    12\t    holes = {\n    13\t        blob.top_left\n    14\t        for blob in connected_components(frame, colors=(1,))\n    15\t        if blob.size == (4, 4) and blob.area == 16\n    16\t    }\n    17\t    pegs = {\n    18\t        blob.top_left\n    19\t        for blob in connected_components(frame, colors=(14,))\n    20\t        if blob.size == (4, 4)\n    21\t    }\n    22\t    return holes | pegs, frozenset(pegs)\n    23\t\n    24\t\n    25\tdef _lattice_step(slots):\n    26\t    coordinates = [\n    27\t        sorted({position[axis] for position in slots})\n    28\t        for axis in (0, 1)\n    29\t    ]\n    30\t    differences = [\n    31\t        later - earlier\n    32\t        for values in coordinates\n    33\t        for earlier, later in zip(values, values[1:])\n    34\t        if later > earlier\n    35\t    ]\n    36\t    step = 0\n    37\t    for difference in differences:\n    38\t        step = gcd(step, difference)\n    39\t    return step\n    40\t\n    41\t\n    42\tdef _peg_solution(slots, start):\n    43\t    \"\"\"Find captures that leave the confirmed winning state of one peg.\"\"\"\n    44\t    step = _lattice_step(slots)\n    45\t    if not step:\n    46\t        return None\n    47\t    queue = deque([(start, ())])\n    48\t    seen = {start}\n    49\t    directions = ((-step, 0), (step, 0), (0, -step), (0, step))\n    50\t    while queue:\n    51\t        pegs, path = queue.popleft()\n    52\t        if len(pegs) == 1:\n    53\t            return path\n    54\t        for source in sorted(pegs):\n    55\t            for dr, dc in directions:\n    56\t                jumped = (source[0] + dr, source[1] + dc)\n    57\t                destination = (source[0] + 2 * dr, source[1] + 2 * dc)\n    58\t                if (\n    59\t                    jumped in pegs\n    60\t                    and destination in slots\n    61\t                    and destination not in pegs\n    62\t                ):\n    63\t                    child = frozenset((pegs - {source, jumped}) | {destination})\n    64\t                    if child not in seen:\n    65\t                        seen.add(child)\n    66\t                        queue.append((child, path + ((source, destination),)))\n    67\t    return None\n    68\t\n    69\t\n    70\tdef solve_peg_solitaire(env):\n    71\t    \"\"\"Solve a visible orthogonal peg-solitaire board using coordinate clicks.\"\"\"\n    72\t    slots, pegs = _peg_board(env.frame())\n    73\t    solution = _peg_solution(slots, pegs)\n    74\t    if solution is None:\n    75\t        return\n    76\t    for source, destination in solution:\n    77\t        env.step(6, source[1] + 1, source[0] + 1)\n    78\t        env.step(6, destination[1] + 1, destination[0] + 1)\n    79\t\n    80\t\n    81\tdef _carrier_capture_macros(frame):\n    82\t    \"\"\"Return visible peg captures, including an empty bordered carrier.\"\"\"\n    83\t    slots, pegs = _peg_board(frame)\n    84\t    carriers = {\n    85\t        blob.top_left\n    86\t        for blob in connected_components(frame, colors=(12,))\n    87\t        if blob.size == (4, 4)\n    88\t    }\n    89\t    step = _lattice_step(slots | carriers)\n    90\t    if not step:\n    91\t        return ()\n    92\t    destinations = slots | carriers\n    93\t    macros = []\n    94\t    for source in sorted(pegs):\n    95\t        for dr, dc in ((-step, 0), (step, 0), (0, -step), (0, step)):\n    96\t            jumped = (source[0] + dr, source[1] + dc)\n    97\t            destination = (source[0] + 2 * dr, source[1] + 2 * dc)\n    98\t            if (\n    99\t                jumped in pegs\n   100\t                and destination in destinations\n   101\t                and destination not in pegs\n   102\t            ):\n   103\t                macros.append((\n   104\t                    (6, source[1] + 1, source[0] + 1),\n   105\t                    (6, destination[1] + 1, destination[0] + 1),\n   106\t                ))\n   107\t    return tuple(macros)\n   108\t\n   109\t\n   110\tdef solve_peg_solitaire_with_carrier(env, max_states=2000, max_depth=40):\n   111\t    \"\"\"Solve peg boards connected by a key-movable bordered carrier slot.\"\"\"\n   112\t    base_level = env.levels_completed\n   113\t\n   114\t    def key(node):\n   115\t        frame = arr(node.frame())\n   116\t        return int(node.levels_completed), frame[1:, :].tobytes()\n   117\t\n   118\t    queue = deque([(env.clone(), ())])\n   119\t    seen = {key(env)}\n   120\t    solution = None\n   121\t    while queue and len(seen) < max_states:\n   122\t        node, path = queue.popleft()\n   123\t        if len(path) >= max_depth:\n   124\t            continue\n   125\t        macros = tuple((action,) for action in (1, 2, 3, 4))\n   126\t        macros += _carrier_capture_macros(node.frame())\n   127\t        for macro in macros:\n   128\t            child = node.clone()\n   129\t            for action in macro:\n   130\t                if isinstance(action, tuple):\n   131\t                    child.step(*action)\n   132\t                else:\n   133\t                    child.step(action)\n   134\t                if child.levels_completed > base_level:\n   135\t                    solution = path + (macro,)\n   136\t                    break\n   137\t            if solution is not None:\n   138\t                queue.clear()\n   139\t                break\n   140\t            child_key = key(child)\n   141\t            if child_key not in seen:\n   142\t                seen.add(child_key)\n   143\t                queue.append((child, path + (macro,)))\n   144\t\n   145\t    if solution is None:\n   146\t        return\n   147\t    for macro in solution:\n   148\t        for action in macro:\n   149\t            if isinstance(action, tuple):\n   150\t                env.step(*action)\n   151\t            else:\n   152\t                env.step(action)\n   153\t\n   154\t\n   155\tdef _bridge_carrier_state(frame):\n   156\t    \"\"\"Return the puzzle-relevant geometry of a bridge/carrier peg board.\"\"\"\n   157\t    slots, pegs = _peg_board(frame)\n   158\t    slots |= {\n   159\t        (blob.bbox[0] - 1, blob.bbox[1] - 1)\n   160\t        for blob in connected_components(frame, colors=(1,))\n   161\t        if blob.size == (2, 2) and blob.area == 4\n   162\t    }\n   163\t    carriers = frozenset(\n   164\t        (\n   165\t            (blob.bbox[0] - 1, blob.bbox[1] - 1)\n   166\t            if blob.size == (2, 2) else blob.top_left\n   167\t        )\n   168\t        for blob in connected_components(frame, colors=(12,))\n   169\t        if blob.size in ((2, 2), (4, 4))\n   170\t    )\n   171\t    bridges = frozenset(\n   172\t        (blob.bbox[0] + 1, blob.bbox[1])\n   173\t        for blob in connected_components(frame, colors=(15,))\n   174\t        if blob.size == (4, 4)\n   175\t    )\n   176\t    borders = frozenset(\n   177\t        blob.top_left\n   178\t        for blob in connected_components(frame, colors=(11,), min_area=4)\n   179\t    )\n   180\t    selected_blobs = connected_components(frame, colors=(3,), min_area=4)\n   181\t    selected = (\n   182\t        (selected_blobs[0].bbox[0] + 1, selected_blobs[0].bbox[1] + 1)\n   183\t        if selected_blobs else None\n   184\t    )\n   185\t    return (\n   186\t        frozenset(slots), frozenset(pegs), carriers,\n   187\t        bridges, borders, selected,\n   188\t    )\n   189\t\n   190\t\n   191\tdef _bridge_carrier_moves(frame):\n   192\t    \"\"\"Return legal (kind, source, destination) peg moves.\"\"\"\n   193\t    slots, pegs, carriers, bridges, _, _ = _bridge_carrier_state(frame)\n   194\t    step = _lattice_step(slots | carriers)\n   195\t    if not step:\n   196\t        return ()\n   197\t    moves = []\n   198\t    destinations = slots | carriers\n   199\t    for source in sorted(pegs):\n   200\t        for dr, dc in ((-step, 0), (step, 0), (0, -step), (0, step)):\n   201\t            midpoint = (source[0] + dr, source[1] + dc)\n   202\t            destination = (source[0] + 2 * dr, source[1] + 2 * dc)\n   203\t            if destination not in destinations or destination in pegs:\n   204\t                continue\n   205\t            if midpoint in pegs:\n   206\t                moves.append((\"capture\", source, destination))\n   207\t            elif midpoint in bridges:\n   208\t                moves.append((\"bridge\", source, destination))\n   209\t    return tuple(moves)\n   210\t\n   211\t\n   212\tdef solve_bridge_carrier_peg_solitaire(\n   213\t        env, max_align_states=120, max_macros=40):\n   214\t    \"\"\"Solve peg boards joined by persistent bridges and a movable carrier.\"\"\"\n   215\t    base_level = env.levels_completed\n   216\t    node = env.clone()\n   217\t    solution = []\n   218\t    forbidden = set()\n   219\t\n   220\t    def choose(frame, blocked):\n   221\t        moves = _bridge_carrier_moves(frame)\n   222\t        captures = [move for move in moves if move[0] == \"capture\"]\n   223\t        if captures:\n   224\t            return captures[0]\n   225\t        bridges = [\n   226\t            move for move in moves\n   227\t            if (move[1], move[2]) not in blocked\n   228\t        ]\n   229\t        return bridges[0] if bridges else None\n   230\t\n   231\t    def alignment_path(root, blocked):\n   232\t        queue = deque([()])\n   233\t        seen = {_bridge_carrier_state(root.frame())}\n   234\t        while queue and len(seen) < max_align_states:\n   235\t            path = queue.popleft()\n   236\t            for action in (4, 3, 2, 1):\n   237\t                child_path = path + (action,)\n   238\t                child = root.clone()\n   239\t                for replay_action in child_path:\n   240\t                    child.step(replay_action)\n   241\t                if child.levels_completed > base_level:\n   242\t                    return child_path\n   243\t                state = _bridge_carrier_state(child.frame())\n   244\t                if state in seen:\n   245\t                    continue\n   246\t                seen.add(state)\n   247\t                if choose(child.frame(), blocked) is not None:\n   248\t                    return child_path\n   249\t                if len(child_path) < 16:\n   250\t                    queue.append(child_path)\n   251\t        return None\n   252\t\n   253\t    for _ in range(max_macros):\n   254\t        if node.levels_completed > base_level:\n   255\t            break\n   256\t        move = choose(node.frame(), forbidden)\n   257\t        if move is None:\n   258\t            keys = alignment_path(node, forbidden)\n   259\t            if keys is None:\n   260\t                return\n   261\t            for action in keys:\n   262\t                node.step(action)\n   263\t                solution.append(action)\n   264\t            if node.levels_completed > base_level:\n   265\t                break\n   266\t            move = choose(node.frame(), forbidden)\n   267\t            if move is None:\n   268\t                return\n   269\t        kind, source, destination = move\n   270\t        before = _bridge_carrier_state(node.frame())\n   271\t        clicks = (\n   272\t            (6, source[1] + 1, source[0] + 1),\n   273\t            (6, destination[1] + 1, destination[0] + 1),\n   274\t        )\n   275\t        for action in clicks:\n   276\t            node.step(*action)\n   277\t            solution.append(action)\n   278\t        after = _bridge_carrier_state(node.frame())\n   279\t        if after == before:\n   280\t            return\n   281\t        if kind == \"bridge\":\n   282\t            forbidden.add((destination, source))\n   283\t        else:\n   284\t            forbidden.clear()\n   285\t\n   286\t    if node.levels_completed <= base_level:\n   287\t        return\n   288\t    for action in solution:\n   289\t        if isinstance(action, tuple):\n   290\t            env.step(*action)\n   291\t        else:\n   292\t            env.step(action)\n     1\timport importlib.util\n     2\timport json\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\t\n     7\timport gkm_arena as A\n     8\t\n     9\tfrom legs import _bridge_carrier_moves, _bridge_carrier_state\n    10\tfrom perception import action_deltas, block_signatures, color_counts, connected_components\n    11\t\n    12\t\n    13\tspec = importlib.util.spec_from_file_location(\"solve\", \"solve.py\")\n    14\tsolver = importlib.util.module_from_spec(spec)\n    15\tspec.loader.exec_module(solver)\n    16\t\n    17\t\n    18\tdef probe(env):\n    19\t    with open(\"checkpoint.json\") as stream:\n    20\t        checkpoint = json.load(stream)\n    21\t    assert checkpoint[\"game\"] == \"lf52\" and checkpoint[\"validated\"]\n    22\t    for action in checkpoint[\"final_path\"]:\n    23\t        env.step(action)\n    24\t    solver.solve(env)\n    25\t    state = _bridge_carrier_state(env.frame())\n    26\t    print(\"LEVEL\", env.levels_completed, \"ACTIONS\", env.actions)\n    27\t    print(\"COLORS\", color_counts(env.frame()))\n    28\t    print(\"STATE\", state)\n    29\t    print(\"MOVES\", _bridge_carrier_moves(env.frame()))\n    30\t    print(\n    31\t        \"OBJECTS\",\n    32\t        [\n    33\t            (b.color, b.bbox, b.area)\n    34\t            for b in connected_components(\n    35\t                env.frame(), colors=(1, 3, 11, 12, 14, 15), min_area=2\n    36\t            )\n    37\t        ],\n    38\t    )\n    39\t    print(\n    40\t        \"RAILS\",\n    41\t        [\n    42\t            (b.color, b.bbox, b.area)\n    43\t            for b in connected_components(\n    44\t                env.frame(), colors=(5, 7, 9), min_area=2\n    45\t            )\n    46\t        ],\n    47\t    )\n    48\t    print(\n    49\t        \"DELTAS\",\n    50\t        {\n    51\t            action: (delta[\"count\"], delta[\"bbox\"])\n    52\t            for action, delta in action_deltas(env, env.actions).items()\n    53\t        },\n    54\t    )\n    55\t    symbols = {\n    56\t        14: \"P\", 12: \"C\", 15: \"B\", 1: \"o\",\n    57\t        7: \"g\", 11: \"c\", 9: \"#\", 5: \"|\",\n    58\t    }\n    59\t    signatures = block_signatures(env.frame(), cell=6)\n    60\t    print(\"MAP\")\n    61\t    for row in range(11):\n    62\t        print(\"\".join(\n    63\t            next(\n    64\t                (symbols[color] for color in symbols if color in signatures[(row, col)]),\n    65\t                \".\",\n    66\t            )\n    67\t            for col in range(11)\n    68\t        ))\n    69\t\n    70\t\n    71\tlevels, path, err = A.run_program(\"lf52\", probe)\n    72\tprint(\"END\", levels, len(path), err)\n","exit_code":0,"status":"completed"}}
