{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/zsh -lc \"rg -n '\"'^def '\"' legs.py\nsed -n '235,430p' legs.py\"","aggregated_output":"12:def _peg_board(frame):\n27:def _lattice_step(slots):\n44:def _peg_solution(slots, start):\n72:def solve_peg_solitaire(env):\n83:def _carrier_capture_macros(frame):\n112:def solve_peg_solitaire_with_carrier(env, max_states=2000, max_depth=40):\n157:def _bridge_carrier_state(frame):\n193:def _bridge_carrier_actions(frame):\n229:def _bridge_carrier_moves(frame):\n250:def solve_bridge_carrier_peg_solitaire(\n335:def probe_visible_mechanics(env):\n    moves = []\n    destinations = slots | carriers\n    for source in sorted(pegs):\n        for dr, dc in ((-step, 0), (step, 0), (0, -step), (0, step)):\n            midpoint = (source[0] + dr, source[1] + dc)\n            destination = (source[0] + 2 * dr, source[1] + 2 * dc)\n            if destination not in destinations or destination in pegs:\n                continue\n            if midpoint in pegs:\n                moves.append((\"capture\", source, destination))\n            elif midpoint in bridges:\n                moves.append((\"bridge\", source, destination))\n    return tuple(moves)\n\n\ndef solve_bridge_carrier_peg_solitaire(\n        env, max_align_states=120, max_macros=40):\n    \"\"\"Solve peg boards joined by persistent bridges and a movable carrier.\"\"\"\n    base_level = env.levels_completed\n    node = env.clone()\n    solution = []\n    forbidden = set()\n\n    def choose(frame, blocked):\n        moves = _bridge_carrier_moves(frame)\n        captures = [move for move in moves if move[0] == \"capture\"]\n        if captures:\n            return captures[0]\n        bridges = [\n            move for move in moves\n            if (move[1], move[2]) not in blocked\n        ]\n        return bridges[0] if bridges else None\n\n    def alignment_path(root, blocked):\n        queue = deque([()])\n        seen = {_bridge_carrier_state(root.frame())}\n        while queue and len(seen) < max_align_states:\n            path = queue.popleft()\n            for action in (4, 3, 2, 1):\n                child_path = path + (action,)\n                child = root.clone()\n                for replay_action in child_path:\n                    child.step(replay_action)\n                if child.levels_completed > base_level:\n                    return child_path\n                state = _bridge_carrier_state(child.frame())\n                if state in seen:\n                    continue\n                seen.add(state)\n                if choose(child.frame(), blocked) is not None:\n                    return child_path\n                if len(child_path) < 16:\n                    queue.append(child_path)\n        return None\n\n    for macro_index in range(max_macros):\n        if node.levels_completed > base_level:\n            break\n        move = choose(node.frame(), forbidden)\n        if move is None:\n            keys = alignment_path(node, forbidden)\n            if keys is None:\n                return\n            for action in keys:\n                node.step(action)\n                solution.append(action)\n            if node.levels_completed > base_level:\n                break\n            move = choose(node.frame(), forbidden)\n            if move is None:\n                return\n        kind, source, destination = move\n        before = _bridge_carrier_state(node.frame())\n        clicks = (\n            (6, source[1] + 1, source[0] + 1),\n            (6, destination[1] + 1, destination[0] + 1),\n        )\n        for action in clicks:\n            node.step(*action)\n            solution.append(action)\n        after = _bridge_carrier_state(node.frame())\n        print(\"GREEDY\", macro_index, kind, source, destination,\n              after[1], after[2])\n        if after == before:\n            return\n        if kind == \"bridge\":\n            forbidden.add((destination, source))\n        else:\n            forbidden.clear()\n\n    if node.levels_completed <= base_level:\n        return\n    for action in solution:\n        if isinstance(action, tuple):\n            env.step(*action)\n        else:\n            env.step(action)\n\n\ndef probe_visible_mechanics(env):\n    \"\"\"Print compact one-step observations for a newly reached board.\"\"\"\n    frame = env.frame()\n    blobs = connected_components(frame, min_area=4)\n\n    def symbols(node):\n        return tuple(\n            (blob.color, blob.bbox, blob.area)\n            for blob in connected_components(node.frame(), min_area=4)\n            if blob.color != 9\n        )\n\n    print(\"PROBE actions\", env.actions)\n    print(\"PROBE colors\", color_counts(frame))\n    print(\"PROBE objects\", symbols(env))\n    for action in env.actions:\n        if action == 6:\n            continue\n        child = env.clone()\n        child.step(action)\n        delta = frame_delta(frame, child.frame())\n        print(\"PROBE key\", action, delta[\"count\"], delta[\"bbox\"],\n              symbols(child), child.levels_completed)\n    centers = sorted({\n        ((blob.bbox[1] + blob.bbox[3]) // 2,\n         (blob.bbox[0] + blob.bbox[2]) // 2)\n        for blob in blobs\n        if blob.color != 9\n    })\n    for x, y in centers:\n        child = env.clone()\n        child.step(6, x, y)\n        delta = frame_delta(frame, child.frame())\n        if delta[\"count\"] or child.levels_completed != env.levels_completed:\n            print(\"PROBE click\", (x, y), delta[\"count\"], delta[\"bbox\"],\n                  symbols(child), child.levels_completed)\n    def puzzle_state(node):\n        return tuple(\n            (blob.color, blob.top_left)\n            for blob in connected_components(\n                node.frame(), colors=(1, 3, 11, 12, 14, 15), min_area=4\n            )\n            if blob.color != 1 or blob.size != (4, 4)\n        ), tuple(sorted(_peg_board(node.frame())[1]))\n\n    node = env.clone()\n    staged = (\n        (6, 13, 25), (6, 25, 25),\n        (6, 25, 25), (6, 37, 25),\n        3,\n        (6, 37, 25), (6, 49, 25),\n    )\n    print(\"TRACE 0\", puzzle_state(node), node.levels_completed)\n    for index, action in enumerate(staged, 1):\n        if isinstance(action, tuple):\n            node.step(*action)\n        else:\n            node.step(action)\n        print(\"TRACE\", index, action, puzzle_state(node),\n              node.levels_completed)\n    for action in (1, 2, 3, 4):\n        child = node.clone()\n        child.step(action)\n        print(\"POST_KEY\", action, puzzle_state(child),\n              child.levels_completed)\n    for peg in sorted(_peg_board(node.frame())[1]):\n        child = node.clone()\n        child.step(6, peg[1] + 1, peg[0] + 1)\n        print(\"POST_PEG\", peg, puzzle_state(child),\n              child.levels_completed)\n    queue = deque([(node.clone(), ())])\n    seen = set()\n    selectable = []\n    while queue and len(seen) < 120:\n        here, path = queue.popleft()\n        state = puzzle_state(here)\n        if state in seen or len(path) > 18:\n            continue\n        seen.add(state)\n        for peg in sorted(_peg_board(here.frame())[1]):\n            child = here.clone()\n            child.step(6, peg[1] + 1, peg[0] + 1)\n            selected = tuple(\n                blob.top_left\n                for blob in connected_components(\n                    child.frame(), colors=(3,), min_area=4\n                )\n            )\n            if selected:\n                selectable.append((path, peg, selected,\n                                   puzzle_state(child)))\n        for action in (1, 2, 3, 4):\n            child = here.clone()\n            child.step(action)\n            queue.append((child, path + (action,)))\n    print(\"ALIGN states\", len(seen))\n","exit_code":0,"status":"completed"}}
