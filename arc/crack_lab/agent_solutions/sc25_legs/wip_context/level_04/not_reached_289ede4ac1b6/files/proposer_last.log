lta[\"count\"], delta[\"bbox\"])\n130:        action_fn=lambda _: (1, 2, 3, 4),\n144:        for action in sequence:\n145:            node.step(*action) if isinstance(action, tuple) else node.step(action)\n152:        \"prime_select\": [6] + plus,\n153:        \"target_prime_select\": [2, 2, 4, 4, 6] + plus,\n156:        for action in sequence:\n157:            node.step(*action) if isinstance(action, tuple) else node.step(action)\n186:    for action in shaped_sequence:\n187:        shaped.step(*action) if isinstance(action, tuple) else shaped.step(action)\n210:    interaction_path = None\n211:    print(\"INTERACTION_PATH\", interaction_path)\n212:    if interaction_path:\n213:        node = P.replay(shaped, interaction_path)\n215:    for name, actions in {\n222:        for action in actions:\n223:            node.step(action)\n247:        action_fn=lambda _: (1, 2, 3, 4),\n255:        for action in (3, 3, 1, 2, 4):\n257:            node.step(action)\n258:            print(\"AT_LEFT\", action, before, main_bounds(node),\n261:            \"vertical\": [(6, 30, 50), (6, 30, 55), (6, 30, 60)],\n265:            for action in command:\n266:                test.step(*action)\n271:        for action in [(6, 30, 50), (6, 30, 55), (6, 30, 60)]:\n272:            opened.step(*action)\n288:                for action in [(6, 30, 50), (6, 30, 55), (6, 30, 60)]:\n289:                    test.step(*action)\n305:        for action in [(6, 30, 50), (6, 30, 55), (6, 30, 60)]:\n306:            travel.step(*action)\n314:            action_fn=lambda _: (1, 2, 3, 4),\n","exit_code":0,"status":"completed"}}
