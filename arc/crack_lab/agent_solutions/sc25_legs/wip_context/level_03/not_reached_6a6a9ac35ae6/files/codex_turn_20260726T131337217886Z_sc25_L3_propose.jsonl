0,\n    22\t    )\n    23\t    move_until_level_progress(env, action=1, max_steps=8)\n     1\t# Shared leg library: small, named, reusable skills.\n     2\t# Players import from here; add a NEW leg only when no existing leg fits.\n     3\t\n     4\t\n     5\tdef prime_board(env, action=1):\n     6\t    \"\"\"Spend the board's initial inert input so subsequent controls take effect.\"\"\"\n     7\t    env.step(action)\n     8\t\n     9\t\n    10\tdef select_grid_cells_of_color(env, xs, ys, color, click_action=6):\n    11\t    \"\"\"Click the sampled cells of a coordinate grid that currently match color.\"\"\"\n    12\t    frame = env.frame()\n    13\t    points = [\n    14\t        (x, y)\n    15\t        for y in ys\n    16\t        for x in xs\n    17\t        if int(frame[y][x]) == color\n    18\t    ]\n    19\t    for x, y in points:\n    20\t        env.step(click_action, x, y)\n    21\t\n    22\t\n    23\tdef move_until_level_progress(env, action, max_steps):\n    24\t    \"\"\"Repeat a movement while bounded, stopping as soon as the level advances.\"\"\"\n    25\t    starting_level = env.levels_completed\n    26\t    for _ in range(max_steps):\n    27\t        if env.terminal() or env.levels_completed > starting_level:\n    28\t            break\n    29\t        env.step(action)\n","exit_code":0,"status":"completed"}}
