t in (3, 4, 5, 7, 9)\n    46\t            )\n    47\t        )\n    48\t        return squares, tuple(\n    49\t            (\n    50\t                round(sum(row for row, _ in group) / len(group)),\n    51\t                round(sum(col for _, col in group) / len(group)),\n    52\t                len(group),\n    53\t            )\n    54\t            for group in groups\n    55\t        ), body_overlap\n    56\t\n    57\t    print(\"ROOT\", state())\n    58\t    for index, action in enumerate(PATH, 1):\n    59\t        before = state()\n    60\t        env.step(*action)\n    61\t        print(index, action, \"before\", before, \"after\", state(),\n    62\t              \"level\", int(env.levels_completed))\n    63\t        if int(env.levels_completed) > start:\n    64\t            return\n    65\t\n    66\t\n    67\tA.run_program(\"su15\", inspect)\n   454\tdef stage_large_square_for_diagonal_partner(env, max_moves=16):\n   455\t    \"\"\"Stage the largest square in the far ring, then advance its partner.\"\"\"\n   456\t    start_level = env.levels_completed\n   457\t\n   458\t    def solid_squares():\n   459\t        return [\n   460\t            blob for blob in connected_components(env.frame(), min_area=1)\n   461\t            if (\n   462\t                blob.bbox[0] >= 10\n   463\t                and blob.size[0] == blob.size[1]\n   464\t                and blob.area == blob.size[0] ** 2\n   465\t                and blob.color not in (3, 4, 5, 7, 9)\n   466\t            )\n   467\t        ]\n   468\t\n   469\t    rings = [\n   470\t        blob for blob in connected_components(\n   471\t            env.frame(), colors=(9,), min_area=9\n   472\t        )\n   473\t        if blob.bbox[0] >= 10\n   474\t    ]\n   475\t    squares = solid_squares()\n   476\t    if len(rings) < 2 or not squares:\n   477\t        return\n   478\t\n   479\t    square = max(squares, key=lambda blob: blob.area)\n   480\t    start_row, start_col = square.centroid\n   481\t    target