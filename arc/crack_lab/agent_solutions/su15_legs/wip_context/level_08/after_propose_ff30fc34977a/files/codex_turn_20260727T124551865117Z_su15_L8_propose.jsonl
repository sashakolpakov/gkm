{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/zsh -lc \"wc -l probe_level8.py probe_body_controls8.py && nl -ba probe_level8.py | sed -n '1,190p' && nl -ba probe_body_controls8.py | sed -n '1,110p'\"","aggregated_output":"     104 probe_level8.py\n      54 probe_body_controls8.py\n     158 total\n     1\timport json\n     2\timport sys\n     3\t\n     4\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     5\timport gkm_arena as A\n     6\t\n     7\tfrom perception import color_counts, connected_components, frame_delta\n     8\tfrom legs import stage_large_square_for_diagonal_partner\n     9\t\n    10\t\n    11\tdef summary(frame):\n    12\t    blobs = connected_components(frame, min_area=4)\n    13\t    return {\n    14\t        \"colors\": color_counts(frame),\n    15\t        \"blobs\": [\n    16\t            (b.color, b.bbox, b.area)\n    17\t            for b in blobs\n    18\t            if b.bbox[0] >= 8 or b.area < 1000\n    19\t        ],\n    20\t    }\n    21\t\n    22\t\n    23\tdef bodies(frame):\n    24\t    points = {\n    25\t        (row, col)\n    26\t        for row in range(10, 64)\n    27\t        for col in range(64)\n    28\t        if int(frame[row][col]) == 7\n    29\t    }\n    30\t    groups = []\n    31\t    while points:\n    32\t        todo = [points.pop()]\n    33\t        group = []\n    34\t        while todo:\n    35\t            point = todo.pop()\n    36\t            group.append(point)\n    37\t            near = {\n    38\t                other for other in points\n    39\t                if max(abs(point[0] - other[0]), abs(point[1] - other[1])) <= 1\n    40\t            }\n    41\t            points -= near\n    42\t            todo.extend(near)\n    43\t        groups.append((\n    44\t            round(sum(row for row, _ in group) / len(group)),\n    45\t            round(sum(col for _, col in group) / len(group)),\n    46\t            len(group),\n    47\t        ))\n    48\t    return sorted(groups)\n    49\t\n    50\t\n    51\tdef compact(frame):\n    52\t    pieces = [\n    53\t        (b.color, b.bbox, b.area)\n    54\t        for b in connected_components(frame, min_area=1)\n    55\t        if b.bbox[0] >= 10\n    56\t        and b.size[0] == b.size[1]\n    57\t        and b.area == b.size[0] ** 2\n    58\t        and b.color not in (3, 4, 5, 7, 9)\n    59\t    ]\n    60\t    rings = [\n    61\t        (b.bbox, b.area)\n    62\t        for b in connected_components(frame, colors=(9,), min_area=9)\n    63\t        if b.bbox[0] >= 10\n    64\t    ]\n    65\t    return {\"pieces\": pieces, \"bodies\": bodies(frame), \"rings\": rings}\n    66\t\n    67\t\n    68\tdef inspect(env):\n    69\t    with open(\"checkpoint.json\") as stream:\n    70\t        checkpoint = json.load(stream)\n    71\t    for action in checkpoint[\"final_path\"]:\n    72\t        env.step(*action)\n    73\t    base = env.frame()\n    74\t    print(\"level\", env.levels_completed + 1, \"actions\", env.actions)\n    75\t    print(\"initial\", summary(base))\n    76\t    print(\"compact\", compact(base))\n    77\t\n    78\t    probes = []\n    79\t    blobs = connected_components(base, min_area=4)\n    80\t    for blob in blobs:\n    81\t        if blob.bbox[0] >= 8 and blob.area < 1000:\n    82\t            row, col = blob.centroid\n    83\t            probes.append((6, int(round(col)), int(round(row))))\n    84\t    probes.extend([(6, 0, 0), (6, 32, 32), (6, 63, 63)])\n    85\t\n    86\t    seen = set()\n    87\t    for action in probes:\n    88\t        if action in seen:\n    89\t            continue\n    90\t        seen.add(action)\n    91\t        clone = env.clone()\n    92\t        clone.step(*action)\n    93\t        delta = frame_delta(base, clone.frame())\n    94\t        print(\"probe\", action, \"level\", clone.levels_completed,\n    95\t              \"delta\", (delta[\"count\"], delta[\"bbox\"]),\n    96\t              \"state\", compact(clone.frame()))\n    97\t\n    98\t    clone = env.clone()\n    99\t    stage_large_square_for_diagonal_partner(clone, max_moves=20)\n   100\t    print(\"existing_stage\", \"level\", clone.levels_completed,\n   101\t          \"state\", compact(clone.frame()))\n   102\t\n   103\t\n   104\tA.run_program(\"su15\", inspect)\n     1\timport json\n     2\t\n     3\timport gkm_try as H\n     4\t\n     5\tfrom probe_clean8 import body_groups\n     6\t\n     7\t\n     8\tdef centers(frame):\n     9\t    return tuple(\n    10\t        (\n    11\t            round(sum(row for row, _ in group) / len(group)),\n    12\t            round(sum(col for _, col in group) / len(group)),\n    13\t        )\n    14\t        for group in body_groups(frame)\n    15\t    )\n    16\t\n    17\t\n    18\tdef inspect(env):\n    19\t    with open(\"checkpoint.json\") as stream:\n    20\t        checkpoint = json.load(stream)\n    21\t    for action in checkpoint[\"final_path\"]:\n    22\t        env.step(*action)\n    23\t    base_groups = body_groups(env.frame())\n    24\t    before = centers(env.frame())\n    25\t    print(\"CENTERS\", before)\n    26\t    for body_index, group in enumerate(base_groups):\n    27\t        center_row, center_col = before[body_index]\n    28\t        for row, col in group:\n    29\t            clone = env.clone()\n    30\t            clone.step(6, col, row)\n    31\t            after = centers(clone.frame())\n    32\t            delta = tuple(\n    33\t                (ar - br, ac - bc)\n    34\t                for (ar, ac), (br, bc) in zip(after, before)\n    35\t            )\n    36\t            print(\n    37\t                \"CONTROL\",\n    38\t                body_index,\n    39\t                (row - center_row, col - center_col),\n    40\t                delta,\n    41\t            )\n    42\t    clone = env.clone()\n    43\t    clone.step(6, 0, 10)\n    44\t    after = centers(clone.frame())\n    45\t    print(\n    46\t        \"BLANK\",\n    47\t        tuple(\n    48\t            (ar - br, ac - bc)\n    49\t            for (ar, ac), (br, bc) in zip(after, before)\n    50\t        ),\n    51\t    )\n    52\t\n    53\t\n    54\tH.A.run_program(\"su15\", inspect)\n","exit_code":0,"status":"completed"}}
