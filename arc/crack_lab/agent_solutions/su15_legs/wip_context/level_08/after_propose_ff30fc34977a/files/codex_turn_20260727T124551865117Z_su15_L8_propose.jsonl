    if previous is None or item[0] < previous[0]:\n    93\t                    candidates[key] = item\n    94\t        ranked = sorted(candidates.values(), key=lambda item: item[0])\n    95\t        selected = []\n    96\t        distance_counts = {}\n    97\t        for item in ranked:\n    98\t            distance = item[0][0]\n    99\t            if distance_counts.get(distance, 0) >= 100:\n   100\t                continue\n   101\t            distance_counts[distance] = distance_counts.get(distance, 0) + 1\n   102\t            selected.append(item)\n   103\t            if len(selected) >= BEAM:\n   104\t                break\n   105\t        beam = [\n   106\t            (node, path, groups)\n   107\t            for _, node, path, groups in selected\n   108\t        ]\n   109\t        if not beam:\n   110\t            break\n   111\t        print(\n   112\t            \"DEPTH\",\n   113\t            depth,\n   114\t            \"best\",\n   115\t            selected[0][0],\n   116\t            \"beam\",\n   117\t            len(beam),\n   118\t            \"states\",\n   119\t            len(candidates),\n   120\t            \"suffix\",\n   121\t            selected[0][2],\n   122\t            flush=True,\n   123\t        )\n   124\t    print(\"NO_PATH\", clone_steps, flush=True)\n   125\t\n   126\t\n   127\tH.A.run_program(\"su15\", inspect)\n","exit_code":0,"status":"completed"}}
