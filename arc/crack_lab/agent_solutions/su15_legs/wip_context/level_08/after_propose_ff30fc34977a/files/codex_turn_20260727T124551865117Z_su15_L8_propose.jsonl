n   234\t            while todo:\n   235\t                point = todo.pop()\n   236\t                group.append(point)\n   237\t                near = {\n   238\t                    other for other in points\n   239\t                    if max(\n   240\t                        abs(point[0] - other[0]),\n   241\t                        abs(point[1] - other[1]),\n   242\t                    ) <= 1\n   243\t                }\n   244\t                points -= near\n   245\t                todo.extend(near)\n   246\t            groups.append(\n   247\t                (\n   248\t                    round(sum(row for row, _ in group) / len(group)),\n   249\t                    round(sum(col for _, col in group) / len(group)),\n   250\t                )\n   251\t            )\n   252\t        return tuple(sorted(groups))\n   253\t\n   254\t    def rings(node):\n   255\t        return [\n   256\t            blob for blob in connected_components(\n   257\t                node.frame(), colors=(9,), min_area=9\n   258\t            )\n   259\t            if blob.bbox[0] >= 10\n   260\t        ]\n   261\t\n   262\t    def state(node):\n   263\t        movable = pieces(node)\n   264\t        compact = tuple(\n   265\t            sorted((color, blob.bbox) for color, _, blob in movable)\n   266\t        )\n   267\t        return movable, avatar_centers(node), compact\n   268\t\n   269\t    def target_for(node, blob):\n   270\t        targets = rings(node)\n   271\t        if not targets:\n   272\t            return None\n   273\t        row, col = anchor(blob)\n   274\t        return min(\n   275\t            targets,\n   276\t            key=lambda target: max(\n   277\t                abs(row - round(target.centroid[0])),\n   278\t                abs(col - round(target.centroid[1])),\n   279\t            ),\n   280\t        )\n   281\t\n   282\t    def candidate_actions(node):\n   283\t        movable, avatars, _ = state(node)\n   284\t        proposed = []\n   285\t        for color in stages:\n   286\t            same = [\n   287\t                blob for piece_color, _, blob in movable\n   288\t                if piece_color == color\n   289\t            ]\n   290\t            pairs = []\n   291\t            for index, left in enumerate(same):\n   292\t                for right in same[index + 1:]:\n   293\t                    lr, lc = anchor(left)\n   294\t                    rr, rc = anchor(right)\n   295\t                    distance = max(abs(lr - rr), abs(lc - rc))\n   296\t                    pairs.append((distance, left, right))\n   297\t            for distance, left, right in sorted(\n   298\t                pairs, key=lambda item: item[0]\n   299\t            )[:6]:\n   300\t                for first, second in ((left, right), (right, left)):\n   301\t                    fr, fc = anchor(first)\n   302\t                    sr, sc = anchor(second)\n   303\t                    if distance <= 2 * step:\n   304\t                        row = round((fr + sr) / 2)\n   305\t                        col = round((fc + sc) / 2)\n   306\t                    else:\n   307\t                        row = sr + max(-step, min(step, fr - sr))\n   308\t                        col = sc + max(-step, min(step, fc - sc))\n   309\t                    proposed.append((6, int(col), int(row)))\n   310\t\n   311\t        for color, _, final in movable:\n   312\t            if color != 11:\n   313\t                continue\n   314\t            target = target_for(node, final)\n   315\t            if target is None:\n   316\t                continue\n   317\t            row, col = anchor(final)\n   318\t            target_row = round(target.centroid[0])\n   319\t            target_col = round(target.centroid[1])\n   320\t            proposed.append(\n   321\t                (\n   322\t                    6,\n   323\t                    int(col + max(-step, min(step, target_col - col))),\n   324\t                    int(row + max(-step, min(step, target_row - row))),\n   325\t                )\n   326\t            )\n   327\t\n   328\t        frame = node.frame()\n   329\t        rows, cols = len(frame), len(frame[0])\n   330\t        top, bottom = 13, rows - 5\n   331\t        left, right = 4, cols - 5\n   332\t        lower_left = left\n   333\t        if any(\n   334\t            max(\n   335\t                abs(bottom - round(ring.centroid[0])),\n   336\t                abs(left - round(ring.centroid[1])),\n   337\t            ) <= 2 * step\n   338\t            for ring in rings(node)\n   339\t        ):\n   340\t            lower_left += 2 * step\n   341\t        proposed.extend(\n   342\t            (6, col, row)\n   343\t            for row, col in (\n   344\t                (top, left),\n   345\t                (top, right),\n   346\t                (bottom, right),\n   347\t                (bottom, lower_left),\n   348\t            )\n   349\t        )\n   350\t        proposed.extend((6, col, row) for row, col in avatars)\n   351\t        return list(dict.fromkeys(proposed))\n   352\t\n   353\t    def priority(node, depth):\n   354\t        movable, avatar, _ = state(node)\n   355\t        if not movable:\n   356\t            return 1_000_000\n   357\t        merge_distance = 0\n   358\t        for color in stages:\n   359\t            same = [\n   360\t                blob for piece_color, _, blob in movable\n   361\t                if piece_color == color\n   362\t            ]\n   363\t            if len(same) >= 2:\n   364\t                distances = []\n   365\t                for index, left in enumerate(same):\n   366\t                    for right in same[index + 1:]:\n   367\t                        lr, lc = anchor(left)\n   368\t                        rr, rc = anchor(right)\n   369\t                        distances.append(max(abs(lr - rr), abs(lc - rc)))\n   370\t                merge_distance += min(distances)\n   371\t\n   372\t        clearance = min(\n   373\t            (\n   374\t                max(\n   375\t                    abs(avatar_row - anchor(blob)[0]),\n   376\t                    abs(avatar_col - anchor(blob)[1]),\n   377\t                )\n   378\t                for avatar_row, avatar_col in avatar\n   379\t                for _, _, blob in movable\n   380\t            ),\n   381\t            default=0,\n   382\t        )\n   383\t        ring_distance = 0\n   384\t        if len(movable) == 1 and movable[0][0] == 11:\n   385\t            final = movable[0][2]\n   386\t            target = target_for(node, final)\n   387\t            if target is not None:\n   388\t                row, col = anchor(final)\n   389\t                ring_distance = max(\n   390\t                    abs(row - round(target.centroid[0])),\n   391\t                    abs(col - round(target.centroid[1])),\n   392\t                )\n   393\t        return (\n   394\t            len(movable) * 100\n   395\t            + merge_distance\n   396\t            + ring_distance\n   397\t            - min(clearance, 30)\n   398\t            + depth\n   399\t        )\n   400\t\n   401\t    start = env.clone()\n   402\t    initial, avatar, compact = state(start)\n   403\t    initial_mass = sum(mass for _, mass, _ in initial)\n   404\t    serial = itertools.count()\n   405\t    heap = [(priority(start, 0), 0, next(serial), start, [])]\n   406\t    seen = {(compact, avatar)}\n   407\t    path = None\n   408\t    expanded = 0\n   409\t    while heap and expanded < max_states:\n   410\t        _, depth, _, node, prefix = heapq.heappop(heap)\n   411\t        expanded += 1\n   412\t        if depth >= max_depth:\n   413\t            continue\n   414\t        for action in candidate_actions(node):\n   415\t            child = node.clone()\n   416\t            try:\n   417\t                child.step(*action)\n   418\t            except Exception:\n   419\t                continue\n   420\t            child_path = prefix + [action]\n   421\t            if child.levels_completed > start_level:\n   422\t                path = child_path\n   423\t                heap = []\n   424\t                break\n   425\t            movable, child_avatar, child_compact = state(child)\n   426\t            if (\n   427\t                child.terminal()\n   428\t                or sum(mass for _, mass, _ in movable) != initial_mass\n   429\t            ):\n   430\t                continue\n   431\t            key = (child_compact, child_avatar)\n   432\t            if key in seen:\n   433\t                continue\n   434\t            seen.add(key)\n   435\t            heapq.heappush(\n   436\t                heap,\n   437\t                (\n   438\t                    priority(child, len(child_path)),\n   439\t                    len(child_path),\n   440\t                    next(serial),\n   441\t                    child,\n   442\t                    child_path,\n   443\t                ),\n   444\t            )\n   445\t\n   446\t    if path is None:\n   447\t        return\n   448\t    for action in path:\n   449\t        if env.terminal() or env.levels_completed != start_level:\n   450\t            return\n   451\t        env.step(*action)\n   452\t\n   453\t\n","exit_code":0,"status":"completed"}}
