frame = node.frame()\n   329\t        rows, cols = len(frame), len(frame[0])\n   330\t        top, bottom = 13, rows - 5\n   331\t        left, right = 4, cols - 5\n   332\t        lower_left = left\n   333\t        if any(\n   334\t            max(\n   335\t                abs(bottom - round(ring.centroid[0])),\n   336\t                abs(left - round(ring.centroid[1])),\n   337\t            ) <= 2 * step\n   338\t            for ring in rings(node)\n   339\t        ):\n   340\t            lower_left += 2 * step\n   341\t        proposed.extend(\n   342\t            (6, col, row)\n   343\t            for row, col in (\n   344\t                (top, left),\n   345\t                (top, right),\n   346\t                (bottom, right),\n   347\t                (bottom, lower_left),\n   348\t            )\n   349\t        )\n   350\t        proposed.extend((6, col, row) for row, col in avatars)\n   351\t        return list(dict.fromkeys(proposed))\n   352\t\n   353\t    def priority(node, depth):\n   354\t        movable, avatar, _ = state(node)\n   355\t        if not movable:\n   356\t            return 1_000_000\n   357\t        merge_distance = 0\n   358\t        for color in stages:\n   359\t            same = [\n   360\t                blob for piece_color, _, blob in movable\n   361\t                if piece_color == color\n   362\t            ]\n   363\t            if len(same) >= 2:\n   364\t                distances = []\n   365\t                for index, left in enumerate(same):\n   366\t                    for right in same[index + 1:]:\n   367\t                        lr, lc = anchor(left)\n   368\t                        rr, rc = anchor(right)\n   369\t                        distances.append(max(abs(lr - rr), abs(lc - rc)))\n   370\t                merge_distance += min(distances)\n   371\t\n   372\t        clearance = min(\n   373\t            (\n   374\t                max(\n   375\t                    abs(avatar_row - anchor(blob)[0]),\n   376\t                    abs(avatar_col - anchor(blob)[1]),\n   377\t                )\n   378\t                for avatar_row, avatar_col in avatar\n   379\t                for _, _, blob in movable\n   380\t            ),\n   381\t            default=0,\n   382\t        )\n   383\t        ring_distance = 0\n   384\t        if len(movable) == 1 and movable[0][0] == 11:\n   385\t            final = movable[0][2]\n   386\t            target = target_for(node, final)\n   387\t            if target is not None:\n   388\t                row, col = anchor(final)\n   389\t                ring_distance = max(\n   390\t                    abs(row - round(target.centroid[0])),\n   391\t                    abs(col - round(target.centroid[1])),\n   392\t                )\n   393\t        return (\n   394\t            len(movable) * 100\n   395\t            + merge_distance\n   396\t            + ring_distance\n   397\t            - min(clearance, 30)\n   398\t            + depth\n   399\t        )\n   400\t\n   401\t    start = env.clone()\n   402\t    initial, avatar, compact = state(start)\n   403\t    initial_mass = sum(mass for _, mass, _ in initial)\n   404\t    serial = itertools.count()\n   405\t    heap = [(priority(start, 0), 0, next(serial), start, [])]\n   406\t    seen = {(compact, avatar)}\n   407\t    path = None\n   408\t    expanded = 0\n   409\t    while heap and expanded < max_states:\n   410\t        _, depth, _, node, prefix = heapq.heappop(heap)\n   411\t        expanded += 1\n   412\t        if depth >= max_depth:\n   413\t            continue\n   414\t        for action in candidate_actions(node):\n   415\t            child = node.clone()\n   416\t            try:\n   417\t                child.step(*action)\n   418\t            except Exception:\n   419\t                continue\n   420\t            child_path = prefix + [action]\n   421\t            if child.levels_completed > start_level:\n   422\t                path = child_path\n   423\t                he