{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"nl -ba gkm_try.py | sed -n '1,220p'; nl -ba perception.py | sed -n '1,235p'; nl -ba players.py | sed -n '1,60p'; nl -ba legs.py | sed -n '1,25p;189,240p;454,525p'\"","aggregated_output":"     1\timport importlib.util, json, os, sys\n     2\tsys.path.insert(0, '/Users/sasha/gkm/arc/crack_lab')\n     3\timport gkm_legs as G\n     4\timport gkm_arena as A\n     5\ttaint_reason = G._workspace_taint_reason(os.getcwd())\n     6\tif taint_reason:\n     7\t    raise SystemExit(f\"TAINTED WORKSPACE: {taint_reason}\")\n     8\tspec = importlib.util.spec_from_file_location(\"solve\", \"solve.py\")\n     9\tm = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\n    10\tdef resumed_solve(env):\n    11\t    ck = None\n    12\t    if os.path.exists(\"checkpoint.json\"):\n    13\t        with open(\"checkpoint.json\") as f:\n    14\t            ck = json.load(f)\n    15\t    if ck and ck.get(\"game\") == 'su15' and ck.get(\"validated\") and ck.get(\"final_path\"):\n    16\t        for act in ck[\"final_path\"]:\n    17\t            env.step(act)\n    18\t    m.solve(env)\n    19\tlevels, path, err = A.run_program('su15', resumed_solve)\n    20\tok = A.validate('su15', path, levels) if path else False\n    21\tprint(f\"RESULT levels={levels} moves={len(path)} replay_ok={ok} err={err}\")\n     1\t\"\"\"Source-free frame perception helpers for cracking.\n     2\t\n     3\tThis module is deliberately observational: it derives compact symbolic state\n     4\tfrom `env.frame()` and `env.clone()` only. It is a cofibration-style scaffold:\n     5\traw pixels are embedded into a monotone tower of reusable observations\n     6\t(components -> objects -> action deltas -> replay states). Candidate level\n     7\tlogic should be written against these quotients, then replay-validated by the\n     8\tharness. No game source or prior solution history is read here.\n     9\t\"\"\"\n    10\tfrom collections import deque\n    11\tfrom dataclasses import dataclass\n    12\tfrom typing import Dict, Iterable, List, Optional, Sequence, Tuple\n    13\t\n    14\timport numpy as np\n    15\t\n    16\tUP, DOWN, LEFT, RIGHT, USE = 1, 2, 3, 4, 5\n    17\tACTIONS = (UP, DOWN, LEFT, RIGHT, USE)\n    18\tDIRS = {UP: (-1, 0), DOWN: (1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\n    19\tACTION_NAME = {UP: \"UP\", DOWN: \"DOWN\", LEFT: \"LEFT\", RIGHT: \"RIGHT\", USE: \"USE\"}\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Blob:\n    24\t    color: int\n    25\t    bbox: Tuple[int, int, int, int]  # r0, c0, r1, c1 inclusive\n    26\t    area: int\n    27\t    centroid: Tuple[float, float]\n    28\t\n    29\t    @property\n    30\t    def top_left(self):\n    31\t        return self.bbox[0], self.bbox[1]\n    32\t\n    33\t    @property\n    34\t    def size(self):\n    35\t        r0, c0, r1, c1 = self.bbox\n    36\t        return r1 - r0 + 1, c1 - c0 + 1\n    37\t\n    38\t\n    39\tdef arr(frame) -> np.ndarray:\n    40\t    return np.asarray(frame)\n    41\t\n    42\t\n    43\tdef color_counts(frame) -> Dict[int, int]:\n    44\t    vals, cnts = np.unique(arr(frame), return_counts=True)\n    45\t    return {int(v): int(c) for v, c in zip(vals, cnts)}\n    46\t\n    47\t\n    48\tdef connected_components(frame, colors: Optional[Iterable[int]] = None,\n    49\t                         min_area: int = 1) -> List[Blob]:\n    50\t    f = arr(frame)\n    51\t    wanted = None if colors is None else {int(c) for c in colors}\n    52\t    seen = np.zeros(f.shape, dtype=bool)\n    53\t    out: List[Blob] = []\n    54\t    rows, cols = f.shape[:2]\n    55\t    for r in range(rows):\n    56\t        for c in range(cols):\n    57\t            if seen[r, c]:\n    58\t                continue\n    59\t            color = int(f[r, c])\n    60\t            if wanted is not None and color not in wanted:\n    61\t                seen[r, c] = True\n    62\t                continue\n    63\t            q = [(r, c)]\n    64\t            seen[r, c] = True\n    65\t            pts = []\n    66\t            while q:\n    67\t                x, y = q.pop()\n    68\t                pts.append((x, y))\n    69\t                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n    70\t                    nx, ny = x + dx, y + dy\n    71\t                    if 0 <= nx < rows and 0 <= ny < cols and not seen[nx, ny] and int(f[nx, ny]) == color:\n    72\t                        seen[nx, ny] = True\n    73\t                        q.append((nx, ny))\n    74\t            if len(pts) >= min_area:\n    75\t                rs = [p[0] for p in pts]\n    76\t                cs = [p[1] for p in pts]\n    77\t                out.append(Blob(color, (min(rs), min(cs), max(rs), max(cs)),\n    78\t                                len(pts), (sum(rs) / len(pts), sum(cs) / len(pts))))\n    79\t    return sorted(out, key=lambda b: (b.color, b.bbox))\n    80\t\n    81\t\n    82\tdef block_signatures(frame, cell: int = 4) -> Dict[Tuple[int, int], Tuple[int, ...]]:\n    83\t    \"\"\"Partition a frame into fixed cells and return each cell's color signature.\"\"\"\n    84\t    f = arr(frame)\n    85\t    out = {}\n    86\t    for r in range(0, f.shape[0], cell):\n    87\t        for c in range(0, f.shape[1], cell):\n    88\t            out[(r // cell, c // cell)] = tuple(int(v) for v in sorted(np.unique(f[r:r+cell, c:c+cell])))\n    89\t    return out\n    90\t\n    91\t\n    92\tdef object_candidates(frame, cell: int = 4, min_area: int = 4) -> List[dict]:\n    93\t    \"\"\"A compact, game-agnostic object list from color components and cell signatures.\"\"\"\n    94\t    f = arr(frame)\n    95\t    blobs = connected_components(f, min_area=min_area)\n    96\t    sigs = block_signatures(f, cell)\n    97\t    objects = []\n    98\t    for b in blobs:\n    99\t        r0, c0, r1, c1 = b.bbox\n   100\t        objects.append({\n   101\t            \"color\": b.color,\n   102\t            \"bbox\": b.bbox,\n   103\t            \"top_left\": b.top_left,\n   104\t            \"size\": b.size,\n   105\t            \"area\": b.area,\n   106\t            \"centroid\": b.centroid,\n   107\t            \"cell\": (r0 // cell, c0 // cell),\n   108\t            \"cell_sig\": sigs.get((r0 // cell, c0 // cell)),\n   109\t        })\n   110\t    return objects\n   111\t\n   112\t\n   113\tdef frame_delta(before, after) -> dict:\n   114\t    a, b = arr(before), arr(after)\n   115\t    ys, xs = np.where(a != b)\n   116\t    if len(ys) == 0:\n   117\t        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n   118\t    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n   119\t    return {\n   120\t        \"count\": int(len(ys)),\n   121\t        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n   122\t        \"samples\": samples,\n   123\t    }\n   124\t\n   125\t\n   126\tdef action_deltas(env, actions: Sequence[int] = ACTIONS) -> Dict[int, dict]:\n   127\t    base = arr(env.frame()).copy()\n   128\t    out = {}\n   129\t    for action in actions:\n   130\t        clone = env.clone()\n   131\t        clone.step(action)\n   132\t        out[int(action)] = frame_delta(base, clone.frame())\n   133\t    return out\n   134\t\n   135\t\n   136\tdef replay(env, actions: Sequence[int]):\n   137\t    clone = env.clone()\n   138\t    for action in actions:\n   139\t        if clone.terminal():\n   140\t            break\n   141\t        clone.step(int(action))\n   142\t    return clone\n   143\t\n   144\t\n   145\tdef path_result(env, actions: Sequence[int]) -> dict:\n   146\t    clone = replay(env, actions)\n   147\t    return {\n   148\t        \"levels_completed\": int(clone.levels_completed),\n   149\t        \"terminal\": bool(clone.terminal()),\n   150\t        \"path_len\": len(actions),\n   151\t        \"colors\": color_counts(clone.frame()),\n   152\t        \"objects\": object_candidates(clone.frame()),\n   153\t    }\n   154\t\n   155\t\n   156\tdef changed_signature(env, actions: Sequence[int], cell: int = 4):\n   157\t    before = block_signatures(env.frame(), cell)\n   158\t    clone = replay(env, actions)\n   159\t    after = block_signatures(clone.frame(), cell)\n   160\t    return {k: (before.get(k), after.get(k)) for k in sorted(set(before) | set(after))\n   161\t            if before.get(k) != after.get(k)}\n   162\t\n   163\t\n   164\tdef bounded_bfs(env, goal_fn, actions: Sequence[int] = (UP, DOWN, LEFT, RIGHT, USE),\n   165\t                key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   166\t    \"\"\"Generic clone BFS over observational keys. Use small max_states first.\"\"\"\n   167\t    if key_fn is None:\n   168\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   169\t    start_key = key_fn(env)\n   170\t    q = deque([(env.clone(), [])])\n   171\t    seen = {start_key}\n   172\t    while q and len(seen) <= max_states:\n   173\t        node, path = q.popleft()\n   174\t        if goal_fn(node, path):\n   175\t            return path\n   176\t        if len(path) >= max_depth:\n   177\t            continue\n   178\t        for action in actions:\n   179\t            child = node.clone()\n   180\t            child.step(int(action))\n   181\t            key = key_fn(child)\n   182\t            if key in seen:\n   183\t                continue\n   184\t            seen.add(key)\n   185\t            q.append((child, path + [int(action)]))\n   186\t    return None\n   187\t\n   188\t\n   189\tdef bounded_replay_bfs(env, goal_fn, action_fn,\n   190\t                       key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   191\t    \"\"\"Path-only BFS for games whose deep Arena clones become expensive.\n   192\t\n   193\t    The queue retains compact action paths, not recursively deep-copied runtime\n   194\t    states. Each node is reconstructed from one root clone. ``action_fn(node)``\n   195\t    may return integer actions or coordinate tuples such as ``(6, x, y)``.\n   196\t    \"\"\"\n   197\t    if key_fn is None:\n   198\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   199\t\n   200\t    def reconstruct(path):\n   201\t        node = env.clone()\n   202\t        for action in path:\n   203\t            if isinstance(action, tuple):\n   204\t                node.step(*action)\n   205\t            else:\n   206\t                node.step(int(action))\n   207\t        return node\n   208\t\n   209\t    start = reconstruct([])\n   210\t    q = deque([[]])\n   211\t    seen = {key_fn(start)}\n   212\t    while q and len(seen) <= max_states:\n   213\t        path = q.popleft()\n   214\t        node = reconstruct(path)\n   215\t        if goal_fn(node, path):\n   216\t            return path\n   217\t        if len(path) >= max_depth or node.terminal():\n   218\t            continue\n   219\t        for action in action_fn(node):\n   220\t            child_path = path + [action]\n   221\t            child = reconstruct(child_path)\n   222\t            key = key_fn(child)\n   223\t            if key in seen:\n   224\t                continue\n   225\t            seen.add(key)\n   226\t            if goal_fn(child, child_path):\n   227\t                return child_path\n   228\t            q.append(child_path)\n   229\t    return None\n   230\t\n   231\t\n   232\tdef level_goal(base_level: int):\n   233\t    return lambda env, path: env.levels_completed > base_level\n     1\t# Per-level players. Each play_level_K(env) ONLY composes legs from legs.py.\n     2\tfrom legs import *  # noqa\n     3\t\n     4\t\n     5\tdef play_level_1(env):\n     6\t    follow_diagonal_lattice_to_ring(env)\n     7\t\n     8\t\n     9\tdef play_level_2(env):\n    10\t    merge_equal_squares_and_deliver_to_ring(env)\n    11\t\n    12\t\n    13\tdef play_level_3(env):\n    14\t    merge_equal_squares_and_deliver_to_ring(env)\n    15\t    deliver_remaining_square_via_diagonal_detour(env)\n    16\t\n    17\t\n    18\tdef play_level_4(env):\n    19\t    merge_equal_squares_around_moving_cutter(env)\n    20\t\n    21\t\n    22\tdef play_level_5(env):\n    23\t    merge_equal_squares_around_moving_cutter(\n    24\t        env, max_depth=36, minimum_stage_mass=2\n    25\t    )\n    26\t\n    27\t\n    28\tdef play_level_6(env):\n    29\t    stage_large_square_for_diagonal_partner(env)\n    30\t\n    31\t\n    32\tdef play_level_7(env):\n    33\t    merge_equal_squares_around_moving_cutter(env)\n     1\t# Shared leg library: small, named, reusable skills.\n     2\t# Players import from here; add a NEW leg only when no existing leg fits.\n     3\timport heapq\n     4\timport itertools\n     5\t\n     6\tfrom perception import connected_components\n     7\t\n     8\t\n     9\tdef follow_diagonal_lattice_to_ring(env, step=6, max_moves=12):\n    10\t    \"\"\"Move the playfield avatar diagonally toward the ringed target.\"\"\"\n    11\t    start_level = env.levels_completed\n    12\t    for _ in range(max_moves):\n    13\t        if env.terminal() or env.levels_completed != start_level:\n    14\t            return\n    15\t\n    16\t        frame = env.frame()\n    17\t        avatars = [\n    18\t            blob for blob in connected_components(frame, colors=(15,), min_area=9)\n    19\t            if blob.area == 9 and blob.centroid[0] >= 10\n    20\t        ]\n    21\t        targets = connected_components(frame, colors=(3,), min_area=9)\n    22\t        if not avatars or not targets:\n    23\t            return\n    24\t\n    25\t        avatar = max(avatars, key=lambda blob: blob.centroid[0])\n   189\tdef merge_equal_squares_around_moving_cutter(\n   190\t    env, step=6, max_states=5000, max_depth=30, minimum_stage_mass=1\n   191\t):\n   192\t    \"\"\"Plan collision-free equal-square merges, then deliver into the ring.\n   193\t\n   194\t    ``minimum_stage_mass`` selects one merge cohort when smaller, unrelated\n   195\t    squares share the playfield.\n   196\t    \"\"\"\n   197\t    start_level = env.levels_completed\n   198\t    stages = {\n   199\t        color: mass\n   200\t        for color, mass in ((10, 1), (6, 2), (15, 4), (11, 8))\n   201\t        if mass >= minimum_stage_mass\n   202\t    }\n   203\t\n   204\t    def pieces(node):\n   205\t        found = []\n   206\t        for color, mass in stages.items():\n   207\t            for blob in connected_components(\n   208\t                node.frame(), colors=(color,), min_area=1\n   209\t            ):\n   210\t                if (\n   211\t                    blob.bbox[0] >= 10\n   212\t                    and blob.size[0] == blob.size[1]\n   213\t                    and blob.area == blob.size[0] ** 2\n   214\t                ):\n   215\t                    found.append((color, mass, blob))\n   216\t        return found\n   217\t\n   218\t    def anchor(blob):\n   219\t        r0, c0, r1, c1 = blob.bbox\n   220\t        return (r0 + r1 + 1) // 2, (c0 + c1 + 1) // 2\n   221\t\n   222\t    def avatar_centers(node):\n   223\t        frame = node.frame()\n   224\t        points = {\n   225\t            (row, col)\n   226\t            for row in range(10, len(frame))\n   227\t            for col in range(len(frame[0]))\n   228\t            if int(frame[row][col]) == 7\n   229\t        }\n   230\t        groups = []\n   231\t        while points:\n   232\t            todo = [points.pop()]\n   233\t            group = []\n   234\t            while todo:\n   235\t                point = todo.pop()\n   236\t                group.append(point)\n   237\t                near = {\n   238\t                    other for other in points\n   239\t                    if max(\n   240\t                        abs(point[0] - other[0]),\n   454\tdef stage_large_square_for_diagonal_partner(env, max_moves=16):\n   455\t    \"\"\"Stage the largest square in the far ring, then advance its partner.\"\"\"\n   456\t    start_level = env.levels_completed\n   457\t\n   458\t    def solid_squares():\n   459\t        return [\n   460\t            blob for blob in connected_components(env.frame(), min_area=1)\n   461\t            if (\n   462\t                blob.bbox[0] >= 10\n   463\t                and blob.size[0] == blob.size[1]\n   464\t                and blob.area == blob.size[0] ** 2\n   465\t                and blob.color not in (3, 4, 5, 7, 9)\n   466\t            )\n   467\t        ]\n   468\t\n   469\t    rings = [\n   470\t        blob for blob in connected_components(\n   471\t            env.frame(), colors=(9,), min_area=9\n   472\t        )\n   473\t        if blob.bbox[0] >= 10\n   474\t    ]\n   475\t    squares = solid_squares()\n   476\t    if len(rings) < 2 or not squares:\n   477\t        return\n   478\t\n   479\t    square = max(squares, key=lambda blob: blob.area)\n   480\t    start_row, start_col = square.centroid\n   481\t    target = max(\n   482\t        rings,\n   483\t        key=lambda ring: max(\n   484\t            abs(ring.centroid[0] - start_row),\n   485\t            abs(ring.centroid[1] - start_col),\n   486\t        ),\n   487\t    )\n   488\t    alternate = max(\n   489\t        (ring for ring in rings if ring != target),\n   490\t        key=lambda ring: max(\n   491\t            abs(ring.centroid[0] - target.centroid[0]),\n   492\t            abs(ring.centroid[1] - target.centroid[1]),\n   493\t        ),\n   494\t    )\n   495\t    step = square.size[0] + 1\n   496\t    moves = 0\n   497\t\n   498\t    while moves < max_moves:\n   499\t        if env.terminal() or env.levels_completed != start_level:\n   500\t            return\n   501\t        squares = solid_squares()\n   502\t        if not squares:\n   503\t            return\n   504\t        square = max(squares, key=lambda blob: blob.area)\n   505\t        row, col = square.centroid\n   506\t        target_row, target_col = target.centroid\n   507\t        if max(abs(row - target_row), abs(col - target_col)) <= 1:\n   508\t            break\n   509\t        next_row = row + max(-step, min(step, target_row - row))\n   510\t        next_col = col + max(-step, min(step, target_col - col))\n   511\t        env.step(6, int(round(next_col)), int(round(next_row)))\n   512\t        moves += 1\n   513\t\n   514\t    while moves < max_moves:\n   515\t        if env.terminal() or env.levels_completed != start_level:\n   516\t            return\n   517\t        row, col = alternate.centroid\n   518\t        env.step(6, int(round(col)), int(round(row)))\n   519\t        moves += 1\n","exit_code":0,"status":"completed"}}
