{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_level8.py | sed -n '1,110p'\"","aggregated_output":"     1\timport json\n     2\timport sys\n     3\t\n     4\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     5\timport gkm_arena as A\n     6\t\n     7\tfrom perception import color_counts, connected_components, frame_delta\n     8\t\n     9\t\n    10\tdef summary(frame):\n    11\t    blobs = connected_components(frame, min_area=4)\n    12\t    return {\n    13\t        \"colors\": color_counts(frame),\n    14\t        \"blobs\": [\n    15\t            (b.color, b.bbox, b.area)\n    16\t            for b in blobs\n    17\t            if b.bbox[0] >= 8 or b.area < 1000\n    18\t        ],\n    19\t    }\n    20\t\n    21\t\n    22\tdef inspect(env):\n    23\t    with open(\"checkpoint.json\") as stream:\n    24\t        checkpoint = json.load(stream)\n    25\t    for action in checkpoint[\"final_path\"]:\n    26\t        env.step(*action)\n    27\t    base = env.frame()\n    28\t    print(\"level\", env.levels_completed + 1, \"actions\", env.actions)\n    29\t    print(\"initial\", summary(base))\n    30\t\n    31\t    probes = [(7,)]\n    32\t    blobs = connected_components(base, min_area=4)\n    33\t    for blob in blobs:\n    34\t        if blob.bbox[0] >= 8 and blob.area < 1000:\n    35\t            row, col = blob.centroid\n    36\t            probes.append((6, int(round(col)), int(round(row))))\n    37\t    probes.extend([(6, 0, 0), (6, 32, 32), (6, 63, 63)])\n    38\t\n    39\t    seen = set()\n    40\t    for action in probes:\n    41\t        if action in seen:\n    42\t            continue\n    43\t        seen.add(action)\n    44\t        clone = env.clone()\n    45\t        clone.step(*action)\n    46\t        delta = frame_delta(base, clone.frame())\n    47\t        print(\"probe\", action, \"level\", clone.levels_completed,\n    48\t              \"delta\", (delta[\"count\"], delta[\"bbox\"]),\n    49\t              \"state\", summary(clone.frame()))\n    50\t\n    51\t\n    52\tA.run_program(\"su15\", inspect)\n","exit_code":0,"status":"completed"}}
