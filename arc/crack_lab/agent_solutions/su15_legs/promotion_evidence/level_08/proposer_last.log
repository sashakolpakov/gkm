{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '576,860p' legs.py\"","aggregated_output":"def merge_cut_and_fill_corner_rings(env):\n    \"\"\"Merge, cut, and cooperatively place coupled squares and moving bodies.\n\n    This handles layouts with two equal small squares, one large square,\n    three moving eight-cell bodies, and four corner rings.  Body controls are\n    expressed relative to the currently observed body, so the maneuver is not\n    tied to absolute body positions.\n    \"\"\"\n    start_level = env.levels_completed\n\n    def active():\n        return (\n            not env.terminal()\n            and env.levels_completed == start_level\n        )\n\n    def solid_squares(color):\n        return [\n            blob for blob in connected_components(\n                env.frame(), colors=(color,), min_area=1\n            )\n            if (\n                blob.bbox[0] >= 10\n                and blob.size[0] == blob.size[1]\n                and blob.area == blob.size[0] ** 2\n            )\n        ]\n\n    def body_groups(color):\n        frame = env.frame()\n        remaining = {\n            (row, col)\n            for row in range(10, len(frame))\n            for col in range(len(frame[0]))\n            if int(frame[row][col]) == color\n        }\n        found = []\n        while remaining:\n            todo = [remaining.pop()]\n            group = []\n            while todo:\n                row, col = todo.pop()\n                group.append((row, col))\n                near = {\n                    point for point in remaining\n                    if max(\n                        abs(point[0] - row),\n                        abs(point[1] - col),\n                    ) <= 1\n                }\n                remaining -= near\n                todo.extend(near)\n            if len(group) >= 4:\n                found.append(tuple(sorted(group)))\n        return tuple(sorted(found))\n\n    def center(points):\n        return (\n            round(sum(row for row, _ in points) / len(points)),\n            round(sum(col for _, col in points) / len(points)),\n        )\n\n    def click(row, col):\n        if active():\n            env.step(6, int(round(col)), int(round(row)))\n\n    def control(color, offset, selector=None):\n        if not active():\n            return False\n        groups = body_groups(color)\n        if not groups:\n            return False\n        group = selector(groups) if selector is not None else groups[0]\n        row, col = center(group)\n        point = (row + offset[0], col + offset[1])\n        if point not in group:\n            return False\n        click(*point)\n        return True\n\n    rings = [\n        blob for blob in connected_components(\n            env.frame(), colors=(9,), min_area=9\n        )\n        if blob.bbox[0] >= 10\n    ]\n    small = solid_squares(11)\n    large = solid_squares(8)\n    if (\n        len(rings) < 4\n        or len(small) != 2\n        or len(large) != 1\n        or len(body_groups(7)) != 3\n    ):\n        return\n\n    left_rings = sorted(rings, key=lambda ring: ring.centroid[1])[:2]\n    upper_left = min(left_rings, key=lambda ring: ring.centroid[0])\n    lower_left = max(left_rings, key=lambda ring: ring.centroid[0])\n    upper_row = round(upper_left.centroid[0])\n    upper_col = round(upper_left.centroid[1])\n    lower_row = round(lower_left.centroid[0])\n    lower_col = round(lower_left.centroid[1])\n\n    # Merge the nearby small pair along the lane to its closest corner ring.\n    small_size = max(blob.size[0] for blob in small)\n    click(\n        max(round(blob.centroid[0]) for blob in small) + small_size,\n        lower_col,\n    )\n    merged = solid_squares(12)\n    if len(merged) != 1:\n        return\n\n    # Seat the merged square, then advance the large square into the other\n    # left ring in strides determined by its own size.\n    square = merged[0]\n    row, col = map(round, square.centroid)\n    step = square.size[0] + 1\n    click(\n        row + max(-step, min(step, lower_row - row)),\n        col + max(-step, min(step, lower_col - col)),\n    )\n    for _ in range(2):\n        if not active():\n            return\n        candidates = solid_squares(8)\n        if not candidates:\n            return\n        square = candidates[0]\n        row, col = map(round, square.centroid)\n        if max(abs(row - upper_row), abs(col - upper_col)) <= 1:\n            break\n        step = square.size[0] + 1\n        click(\n            row + max(-step, min(step, upper_row - row)),\n            col + max(-step, min(step, upper_col - col)),\n        )\n\n    # Use three relative body controls to merge a pair while preserving the\n    # third body as the cutter.\n    if not control(\n        7, (-1, 1),\n        lambda groups: max(groups, key=lambda group: center(group)[0]),\n    ):\n        return\n    if not control(\n        7, (0, 2),\n        lambda groups: max(groups, key=lambda group: center(group)[1]),\n    ):\n        return\n    if not control(\n        7, (-1, 1),\n        lambda groups: max(groups, key=lambda group: center(group)[1]),\n    ):\n        return\n\n    if len(body_groups(7)) != 1 or len(body_groups(14)) != 1:\n        return\n\n    # Bring the small square back to its ring.  The remaining moving body\n    # cuts the staged large square into the second target square en route.\n    merged = solid_squares(12)\n    if len(merged) != 1:\n        return\n    square = merged[0]\n    row, col = map(round, square.centroid)\n    step = square.size[0] + 1\n    click(row, col + max(-step, min(step, lower_col - col)))\n    click(lower_row, lower_col)\n\n    if (\n        len(solid_squares(12)) != 2\n        or len(body_groups(7)) != 1\n        or len(body_groups(14)) != 1\n    ):\n        return\n\n    # Keep both squares seated while the cutter redirects the merged body\n    # along the lower lane and finally clears its target ring.\n    controls = (\n        (14, (0, 2)),\n        (7, (1, 0)),\n        (7, (1, 0)),\n        (7, (0, 2)),\n        (7, (1, 0)),\n        (7, (1, 1)),\n        (7, (0, 2)),\n        (7, (-1, -1)),\n        (7, (1, 0)),\n        (7, (-1, 1)),\n        (14, (0, 0)),\n        (7, (0, 2)),\n        (7, (-2, 0)),\n    )\n    for color, offset in controls:\n        if not control(color, offset):\n            return\n","exit_code":0,"status":"completed"}}
