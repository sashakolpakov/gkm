tal)\n                return\n        print(\"trial\", bdir, cdir, \"edges\", completed, \"moves\", len(total), \"level\", node.levels_completed)\n\n\narena.run_program(\"cn04\", probe)\n","exit_code":0,"status":"completed"}}
