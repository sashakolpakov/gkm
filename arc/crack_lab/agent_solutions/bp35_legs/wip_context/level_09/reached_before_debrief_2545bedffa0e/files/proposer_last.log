 child)\n    54\t        if child.terminal() or int(child.levels_completed) >= 9:\n    55\t            return\n    56\t    for action in (\n    57\t        3,\n    58\t        4,\n    59\t        7,\n    60\t        (6, 39, 33),\n    61\t        (6, 39, 27),\n    62\t        (6, 39, 39),\n    63\t        (6, 45, 33),\n    64\t        (6, 51, 33),\n    65\t        (6, 51, 27),\n    66\t    ):\n    67\t        branch = child.clone()\n    68\t        branch.step(*action) if isinstance(action, tuple) else branch.step(action)\n    69\t        report((\"ACTION\", action), branch)\n    70\t\n    71\t\n    72\tif __name__ == \"__main__\":\n    73\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Remove the yellow gate one band early and free-fall onto the cross shelf.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom perception import connected_components\n     9\tfrom probe_l9_control_row import compact, controls\n    10\tfrom probe_l9_route_deletions import enter_level_9\n    11\tfrom probe_l9_second_lower_entry import goals, staged_entry\n    12\t\n    13\t\n    14\tdef avatars(env):\n    15\t    return tuple(\n    16\t        (blob.bbox, blob.area)\n    17\t        for blob in connected_components(env.frame(), colors=(9,), min_area=3)\n    18\t        if blob.bbox[0] < 63\n    19\t    )\n    20\t\n    21\t\n    22\tdef report(label, env):\n    23\t    print(\n    24\t        label,\n    25\t        \"terminal\",\n    26\t        bool(env.terminal()),\n    27\t        \"level\",\n    28\t        int(env.levels_completed) + 1,\n    29\t        \"controls\",\n    30\t        controls(env),\n    31\t        \"goals\",\n    32\t        goals(env),\n    33\t        \"avatar\",\n    34\t        avatars(env),\n    35\t        \"state\",\n    36\t        compact(env),\n    37\t    )\n    38\t\n    39\t\n    40\tdef early_gate(root):\n    41\t    child = staged_entry(root, 3)\n    42\t    for _ in range(4):\n    43\t        child.step(6, 21, 33)\n    44\t    child.step(6, 27, 33)\n    45\t    child.step(4)\n    46\t    return child\n    47\t\n    48\t\n    49\tdef probe(env):\n    50\t    enter_level_9(env)\n    51\t    child = staged_entry(env, 3)\n    52\t    report(\"ENTRY\", child)\n    53\t    actions = [\n    54\t        *([(6, 21, 33)] * 4),\n    55\t        (6, 27, 33),\n    56\t        4,\n    57\t        4,\n    58\t        4,\n    59\t    ]\n    60\t    for index, action in enumerate(actions, 1):\n    61\t        child.step(*action) if isinstance(action, tuple) else child.step(action)\n    62\t        report((\"STEP\", index, action), child)\n    63\t        if child.terminal() or int(child.levels_completed) >= 9:\n    64\t            return\n    65\t    for action in (\n    66\t        4,\n    67\t        (6, 45, 33),\n    68\t        (6, 39, 33),\n    69\t        (6, 51, 33),\n    70\t        (6, 51, 27),\n    71\t        (6, 45, 27),\n    72\t    ):\n    73\t        branch = child.clone()\n    74\t        branch.step(*action) if isinstance(action, tuple) else branch.step(action)\n    75\t        report((\"ACTION\", action), branch)\n    76\t\n    77\t\n    78\tif __name__ == \"__main__\":\n    79\t    arena.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
