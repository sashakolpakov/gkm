_9(env)\n    50\t    for col in range(2, 9):\n    51\t        child = staged_entry(env, col)\n    52\t        print(\n    53\t            \"ENTRY\",\n    54\t            col,\n    55\t            \"terminal\",\n    56\t            bool(child.terminal()),\n    57\t            \"level\",\n    58\t            int(child.levels_completed) + 1,\n    59\t            \"controls\",\n    60\t            controls(child),\n    61\t            \"goals\",\n    62\t            goals(child),\n    63\t            \"state\",\n    64\t            compact(child),\n    65\t            \"objects\",\n    66\t            objects(child),\n    67\t        )\n    68\t        if not child.terminal():\n    69\t            below = child.clone()\n    70\t            below.step(6, 3 + 6 * col, 33)\n    71\t            print(\n    72\t                \"BELOW\",\n    73\t                col,\n    74\t                \"terminal\",\n    75\t                bool(below.terminal()),\n    76\t                \"level\",\n    77\t                int(below.levels_completed) + 1,\n    78\t                \"controls\",\n    79\t                controls(below),\n    80\t                \"goals\",\n    81\t                goals(below),\n    82\t                \"state\",\n    83\t                compact(below),\n    84\t                \"objects\",\n    85\t                objects(below),\n    86\t            )\n    87\t\n    88\t\n    89\tif __name__ == \"__main__\":\n    90\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Probe the new left-edge control chamber reached after the compressed fall.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom perception import connected_components\n     9\tfrom probe_l9_control_row import compact, controls\n    10\tfrom probe_l9_freefall_flip import enter_freefall_flip\n    11\t\n    12\t\n    13\tdef goals(env):\n    14\t    return [\n    15\t        (blob.bbox, blob.area)\n    16\t        for blob in connected_components(env.frame(), colors=(7,), min_area=3)\n    17\t        if blob.bbox[0] < 63\n    18\t    ]\n    19\t\n    20\t\n    21\tdef report(label, env):\n    22\t    avatars = [\n    23\t        blob.bbox\n    24\t        for blob in connected_components(env.frame(), colors=(9, 11), min_area=3)\n    25\t        if blob.bbox[0] < 63\n    26\t    ]\n    27\t    print(\n    28\t        label,\n    29\t        compact(env),\n    30\t        \"terminal\",\n    31\t        bool(env.terminal()),\n    32\t        \"avatars\",\n    33\t        avatars,\n    34\t        \"controls\",\n    35\t        controls(env),\n    36\t        \"goals\",\n    37\t        goals(env),\n    38\t    )\n    39\t\n    40\t\n    41\tdef enter_second_control(env):\n    42\t    enter_freefall_flip(env)\n    43\t    for _ in range(9):\n    44\t        env.step(3)\n    45\t\n    46\t\n    47\tdef enter_second_bridge(env):\n    48\t    enter_second_control(env)\n    49\t    for x in (57, 51, 45, 39, 33, 27, 21, 15, 9):\n    50\t        env.step(6, x, 45)\n    51\t\n    52\t\n    53\tdef probe(env):\n    54\t    enter_second_control(env)\n    55\t    report(\"CHAMBER\", env)\n    56\t    direct = env.clone()\n    57\t    direct.step(*controls(direct)[0])\n    58\t    report(\"DIRECT_FLIP\", direct)\n    59\t    bridged = env.clone()\n    60\t    for x in (57, 51, 45, 39, 33, 27, 21, 15, 9):\n    61\t        bridged.step(6, x, 45)\n    62\t    report(\"BRIDGED\", bridged)\n    63\t    bridged.step(*controls(bridged)[0])\n    64\t    report(\"BRIDGED_FLIP\", bridged)\n    65\t\n    66\t\n    67\tif __name__ == \"__main__\":\n    68\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Carry the gate-preserved switch through the aligned trapdoor to the goal wall.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom probe_l9_boosted_supported_landing import report\n     9\tfrom probe_l9_control_row import controls\n    10\tfrom probe_l9_multi_skip_bottom import root_for\n    11\tfrom probe_l9_oneflip_trapdoors import yellows\n    12\tfrom probe_l9_route_deletions import enter_level_9\n    13\t\n    14\t\n    15\tdef step(env, action):\n    16\t    env.step(*action) if isinstance(action, tuple) else env.step(action)\n    17\t\n    18\t\n    19\tdef preserved_gate(root):\n    20\t    child = root_for(root, 3)\n    21\t    for action in ((6, 21, 39), 4, (6, 27, 39), 4):\n    22\t        step(child, action)\n    23\t    return child\n    24\t\n    25\t\n    26\tdef probe(env):\n    27\t    enter_level_9(env)\n    28\t    root = preserved_gate(env)\n    29\t    root.step(6, 27, 33)\n    30\t    report(\"DROP\", root)\n    31\t    for first_index in range(len(controls(root))):\n    32\t        child = root.clone()\n    33\t        first = controls(child)[first_index]\n    34\t        child.step(*first)\n    35\t        child.step(3)\n    36\t        child.step(3)\n    37\t        report((first_index, first, \"ALIGNED\"), child)\n    38\t        visible = controls(child)\n    39\t        if len(visible) < 2 or child.terminal():\n    40\t            continue\n    41\t        left_yellow = min(yellows(child), key=lambda action: action[1])\n    42\t        child.step(*left_yellow)\n    43\t        report((first_index, \"OPENED\"), child)\n    44\t        visible = controls(child)\n    45\t        if not visible:\n    46\t            continue\n    47\t        child.step(*visible[-1])\n    48\t        report((first_index, \"DEEP\"), child)\n    49\t        if child.terminal():\n    50\t            continue\n    51\t        for index in range(1, 4):\n    52\t            child.step(4)\n    53\t            report((first_index, \"RIGHT\", index), child)\n    54\t        visible = controls(child)\n    55\t        if visible:\n    56\t            child.step(*visible[-1])\n    57\t            report((first_index, \"WALL_FLIP\"), child)\n    58\t\n    59\t\n    60\tif __name__ == \"__main__\":\n    61\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Return from the lower gap to column two, then enter the known goal corridor.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom probe_l9_route_deletions import enter_level_9\n     9\tfrom probe_l9_skip4_switch_choices import report\n    10\tfrom probe_l9_supported_gap_climb import flipped\n    11\t\n    12\t\n    13\tdef probe(env):\n    14\t    enter_level_9(env)\n    15\t    child = flipped(env, 6)\n    16\t    actions = (\n    17\t        3,\n    18\t        3,\n    19\t        3,\n    20\t        (6, 15, 39),\n    21\t        3,\n    22\t        (6, 15, 33),\n    23\t        4,\n    24\t        4,\n    25\t        4,\n    26\t        4,\n    27\t        4,\n    28\t        4,\n    29\t    )\n    30\t    report(0, child)\n    31\t    for index, action in enumerate(actions, 1):\n    32\t        child.step(*action) if isinstance(action, tuple) else child.step(action)\n    33\t        report((index, action), child)\n    34\t        if child.terminal() or int(child.levels_completed) >= 9:\n    35\t            break\n    36\t\n    37\t\n    38\tif __name__ == \"__main__\":\n    39\t    arena.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
