catches(child), flush=True)\n    44\t        return\n    45\t        child.step(6, 57, 27)\n    46\t        report((switch_index, side, \"OUTER_CLEAR\"), child)\n    47\t        if child.terminal():\n    48\t            return\n    49\t        child.step(4)\n    50\t        x = 57\n    51\t        report((switch_index, side, \"OUTER\"), child)\n    52\t        if child.terminal():\n    53\t            return\n    54\t        print(\"FULL\", full_catches(child), flush=True)\n    55\t    for depth in range(1, 9):\n    56\t        child.step(6, x, 35 if side == \"right\" else 33)\n    57\t        report((switch_index, side, depth), child)\n    58\t        if child.terminal() or int(child.levels_completed) >= 9:\n    59\t            break\n    60\t\n    61\t\n    62\tif __name__ == \"__main__\":\n    63\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Stage the lower catch beneath the trapdoor outside the solid wall.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom perception import connected_components\n     9\tfrom probe_l9_control_row import compact, controls\n    10\tfrom probe_l9_second_descent import component_at\n    11\tfrom probe_l9_second_gap_cross import enter_second_gap\n    12\t\n    13\t\n    14\tdef goals(env):\n    15\t    return [\n    16\t        (blob.bbox, blob.area)\n    17\t        for blob in connected_components(env.frame(), colors=(7,), min_area=3)\n    18\t        if blob.bbox[0] < 63\n    19\t    ]\n    20\t\n    21\t\n    22\tdef report(label, env):\n    23\t    print(\n    24\t        label,\n    25\t        compact(env),\n    26\t        \"terminal\",\n    27\t        bool(env.terminal()),\n    28\t        \"controls\",\n    29\t        controls(env),\n    30\t        \"goals\",\n    31\t        goals(env),\n    32\t    )\n    33\t\n    34\t\n    35\tdef enter_wall_outside(env):\n    36\t    enter_second_gap(env, 2)\