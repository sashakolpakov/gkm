\n    13\t\n    14\t\n    15\tdef report(label, env):\n    16\t    goals = tuple(\n    17\t        (blob.bbox, blob.area)\n    18\t        for blob in connected_components(env.frame(), colors=(7,), min_area=2)\n    19\t        if blob.bbox[0] < 63\n    20\t    )\n    21\t    print(\n    22\t        label,\n    23\t        \"terminal\",\n    24\t        bool(env.terminal()),\n    25\t        \"level\",\n    26\t        int(env.levels_completed) + 1,\n    27\t        \"controls\",\n    28\t        controls(env),\n    29\t        \"goals\",\n    30\t        goals,\n    31\t        \"state\",\n    32\t        compact(env),\n    33\t        \"objects\",\n    34\t        objects(env),\n    35\t    )\n    36\t\n    37\t\n    38\tdef root_lane8(root):\n    39\t    child = before_flip(root)\n    40\t    child.step(3)\n    41\t    child.step(*controls(child)[0])\n    42\t    return child\n    43\t\n    44\t\n    45\tdef probe(env):\n    46\t    enter_level_9(env)\n    47\t    root = root_lane8(env)\n    48\t    report(\"ROOT\", root)\n    49\t    for action in (\n    50\t        3,\n    51\t        4,\n    52\t        7,\n    53\t        (6, 57, 33),\n    54\t        (6, 57, 39),\n    55\t        (6, 57, 45),\n    56\t        (6, 51, 33),\n    57\t        (6, 51, 39),\n    58\t        (6, 51, 45),\n    59\t    ):\n    60\t        child = root.clone()\n    61\t        child.step(*action) if isinstance(action, tuple) else child.step(action)\n    62\t        report((\"ACTION\", action), child)\n    63\t        if action == 4 and not child.terminal():\n    64\t            for index in range(1, 9):\n    65\t                child.step(6, 57, 33)\n    66\t                report((\"C9_WAIT\", index), child)\n    67\t                if child.terminal() or int(child.levels_completed) >= 9:\n    68\t                    break\n    69\t\n    70\t\n    71\tif __name__ == \"__main__\":\n    72\t    arena.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
