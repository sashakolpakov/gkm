   19\t        for blob in connected_components(\n    20\t            env.frame(), colors=(12, 14, 15), min_area=3\n    21\t        )\n    22\t        if blob.bbox[0] < 63 and blob.area == 21\n    23\t    )\n    24\t\n    25\t\n    26\tdef supported(root):\n    27\t    child = boosted(root)\n    28\t    child.step(*controls(child)[0])\n    29\t    child.step(3)\n    30\t    child.step(3)\n    31\t    child.step(*max(yellows(child), key=lambda action: action[1]))\n    32\t    return child\n    33\t\n    34\t\n    35\tdef probe(env):\n    36\t    enter_level_9(env)\n    37\t    child = supported(env)\n    38\t    report(\"SUPPORTED\", child)\n    39\t    print(\"FULL\", full_catches(child), flush=True)\n    40\t\n    41\t    descent = child.clone()\n    42\t    descent.step(6, 21, 29)\n    43\t    descent.step(4)\n    44\t    report(\"RIGHT_LANDING\", descent)\n    45\t    for depth in range(1, 9):\n    46\t        descent.step(6, 21, 33)\n    47\t        report((\"DESCENT\", depth), descent)\n    48\t        if descent.terminal() or int(descent.levels_completed) >= 9:\n    49\t            break\n    50\t\n    51\t\n    52\tif __name__ == \"__main__\":\n    53\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Reverse at PRE_SECOND's far-right corridor while preserving one control.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom probe_l9_boosted_supported_landing import report\n     9\tfrom probe_l9_control_row import controls\n    10\tfrom probe_l9_presecond_outer import pre_second\n    11\tfrom probe_l9_route_deletions import enter_level_9\n    12\t\n    13\t\n    14\tdef right_end(root):\n    15\t    child = pre_second(root)\n    16\t    for target in range(3, 8):\n    17\t        x = 3 + 6 * target\n    18\t        if int(child.frame()[39][x]) in (12, 14, 15):\n    19\t            child.step(6, x, 39)\n    20\t        child.step(4)\n    21\t    return child\n    22\t\n    23\t\n    24\tdef probe(env):\n    25\t    enter_level_9(env)\n    26\t    child = right_end(env)\n    27\t    switch_index = int(sys.argv[1])\n    28\t    switch = controls(child)[switch_index]\n    29\t    child.step(*switch)\n    30\t    report((switch_index, switch, \"FLIP\"), child)\n    31\t    if child.terminal():\n    32\t        return\n    33\t    for depth in range(1, 9):\n    34\t        child.step(6, 45, 33)\n    35\t        report((switch_index, \"DROP\", depth), child)\n    36\t        if child.terminal() or int(child.levels_completed) >= 9:\n    37\t            break\n    38\t\n    39\t\n    40\tif __name__ == \"__main__\":\n    41\t    arena.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
