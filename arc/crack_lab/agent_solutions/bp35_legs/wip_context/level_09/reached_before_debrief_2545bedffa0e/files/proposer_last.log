{"type":"item.completed","item":{"id":"item_221","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_l9_route_deletions.py | sed -n '1,260p'\nnl -ba probe_l9_super_final_exit.py | sed -n '1,180p'\nnl -ba probe_l9_presecond_outer.py | sed -n '1,180p'\"","aggregated_output":"     1\t\"\"\"Find individually removable actions in the verified route to chamber two.\"\"\"\n     2\t\n     3\timport json\n     4\timport sys\n     5\t\n     6\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     7\timport gkm_arena as arena\n     8\t\n     9\timport solve\n    10\tfrom legs import band_grid, click_action\n    11\tfrom perception import connected_components\n    12\t\n    13\t\n    14\tdef enter_level_9(env):\n    15\t    with open(\"checkpoint.json\") as stream:\n    16\t        prefix = json.load(stream)[\"final_path\"]\n    17\t    for action in prefix:\n    18\t        env.step(action)\n    19\t    solve.solve(env)\n    20\t\n    21\t\n    22\tdef route():\n    23\t    actions = []\n    24\t\n    25\t    def add(section, *items):\n    26\t        actions.extend((section, item) for item in items)\n    27\t\n    28\t    add(\"open\", (6, 3, 39), 4, 4, 4, (6, 3, 5))\n    29\t    add(\"stage\", click_action(5, 4), click_action(1, 2))\n    30\t    for col in (3, 2):\n    31\t        add(\"stage\", click_action(6, col), 3)\n    32\t    add(\"upper_climb\", *([click_action(5, 2)] * 10))\n    33\t    for col in (3, 4, 5):\n    34\t        add(\"upper_cross\", click_action(6, col), 4)\n    35\t    add(\"upper_flip\", (6, 3, 3))\n    36\t    add(\"right_drop\", click_action(5, 5), click_action(5, 5))\n    37\t    for col in (6, 7):\n    38\t        add(\"right_cross\", click_action(4, col), 4)\n    39\t    add(\"right_flip\", (6, 3, 5))\n    40\t    add(\"right_climb\", *([click_action(5, 7)] * 7))\n    41\t    add(\"k_clear\", click_action(3, 2))\n    42\t    for col in (6, 5):\n    43\t        add(\"k_cross\", click_action(6, col), 3)\n    44\t    add(\"k_climb\", click_action(5, 5))\n    45\t    add(\"control_approach\", (6, 9, 33), (6, 45, 33))\n    46\t    for x in (39, 33, 27, 21, 15, 9, 3):\n    47\t        add(\"control_cross\", (6, x, 39), 3)\n    48\t    add(\"control_climb\", (6, 3, 33))\n    49\t    add(\"outer_flip\", (6, 9, 3))\n    50\t    add(\"outer_drop\", *([(6, 3, 33)] * 8), (6, 3, 59))\n    51\t    add(\n    52\t        \"gap_bridge\",\n    53\t        *((6, x, 45) for x in (51, 45, 39, 33, 27, 21, 15, 9)),\n    54\t    )\n    55\t    add(\"gap_flip_drop\", (6, 15, 3), (6, 3, 35))\n    56\t    for col in range(1, 10):\n    57\t        add(\"lane9_cross\", (6, 3 + 6 * col, 27), 4)\n    58\t    add(\"lane9_drop\", *([(6, 57, 35)] * 7), (6, 3, 41))\n    59\t    add(\"return_left\", *([3] * 9))\n    60\t    return actions\n    61\t\n    62\t\n    63\tdef step(env, action):\n    64\t    env.step(*action) if isinstance(action, tuple) else env.step(action)\n    65\t\n    66\t\n    67\tdef visible(env, color):\n    68\t    return tuple(\n    69\t        blob.bbox\n    70\t        for blob in connected_components(env.frame(), colors=(color,), min_area=3)\n    71\t        if blob.bbox[0] < 63\n    72\t    )\n    73\t\n    74\t\n    75\tdef summary(env):\n    76\t    return {\n    77\t        \"terminal\": bool(env.terminal()),\n    78\t        \"level\": int(env.levels_completed) + 1,\n    79\t        \"avatar\": visible(env, 9) + visible(env, 11),\n    80\t        \"controls\": visible(env, 8),\n    81\t        \"grid\": tuple(\"\".join(row) for row in band_grid(env.frame())),\n    82\t    }\n    83\t\n    84\t\n    85\tdef replay(root, actions, skips=()):\n    86\t    child = root.clone()\n    87\t    for index, (_, action) in enumerate(actions):\n    88\t        if index in skips:\n    89\t            continue\n    90\t        step(child, action)\n    91\t        if child.terminal() or int(child.levels_completed) >= 9:\n    92\t            break\n    93\t    return child\n    94\t\n    95\t\n    96\tdef probe(env):\n    97\t    enter_level_9(env)\n    98\t    root = env.clone()\n    99\t    actions = route()\n   100\t    baseline = replay(root, actions)\n   101\t    target = summary(baseline)\n   102\t    print(\"BASE\", len(actions), target)\n   103\t\n   104\t    candidates = [\n   105\t        index\n   106\t        for index, (section, _) in enumerate(actions)\n   107\t        if section\n   108\t        in {\n   109\t            \"open\",\n   110\t            \"stage\",\n   111\t            \"upper_climb\",\n   112\t            \"upper_cross\",\n   113\t            \"right_drop\",\n   114\t            \"right_cross\",\n   115\t            \"right_climb\",\n   116\t            \"k_clear\",\n   117\t            \"k_cross\",\n   118\t            \"k_climb\",\n   119\t            \"control_approach\",\n   120\t            \"control_cross\",\n   121\t            \"control_climb\",\n   122\t        }\n   123\t    ]\n   124\t    for ordinal, index in enumerate(candidates, 1):\n   125\t        child = replay(root, actions, skips=(index,))\n   126\t        result = summary(child)\n   127\t        if (\n   128\t            not result[\"terminal\"]\n   129\t            and result[\"level\"] == 9\n   130\t            and result[\"avatar\"] == target[\"avatar\"]\n   131\t            and len(result[\"controls\"]) == len(target[\"controls\"])\n   132\t        ):\n   133\t            print(\"CANDIDATE\", index, actions[index], result)\n   134\t        if ordinal % 10 == 0:\n   135\t            print(\"PROGRESS\", ordinal, \"of\", len(candidates))\n   136\t\n   137\t\n   138\tif __name__ == \"__main__\":\n   139\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Take the final left-shaft exits after all commuting prefix deletions.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom probe_l9_boosted_supported_landing import report\n     9\tfrom probe_l9_control_row import controls\n    10\tfrom probe_l9_fast_boost_endgame import FAST_SKIPS\n    11\tfrom probe_l9_faster_prefix_deletions import TAIL\n    12\tfrom probe_l9_route_deletions import enter_level_9, replay, route\n    13\tfrom probe_l9_ultra_combined_deletions import BRIDGE, RETURN, ROOM\n    14\tfrom probe_l9_ultra_cycle_stage import EXTRA_SKIPS\n    15\t\n    16\t\n    17\tSUPER_SKIPS = FAST_SKIPS | EXTRA_SKIPS | ROOM | BRIDGE | RETURN\n    18\t\n    19\t\n    20\tdef super_boosted(root):\n    21\t    child = replay(root, route(), skips=SUPER_SKIPS)\n    22\t    for action in TAIL:\n    23\t        child.step(*action) if isinstance(action, tuple) else child.step(action)\n    24\t    return child\n    25\t\n    26\t\n    27\tdef frontier(root):\n    28\t    child = super_boosted(root)\n    29\t    child.step(*controls(child)[0])\n    30\t    child.step(3)\n    31\t    child.step(6, 21, 33)\n    32\t    child.step(6, 21, 35)\n    33\t    for _ in range(3):\n    34\t        child.step(6, 21, 33)\n    35\t    child.step(6, 27, 27)\n    36\t    child.step(4)\n    37\t    child.step(*controls(child)[-1])\n    38\t    for _ in range(8):\n    39\t        child.step(6, 27, 33)\n    40\t    child.step(6, 21, 45)\n    41\t    child.step(*controls(child)[0])\n    42\t    for _ in range(3):\n    43\t        child.step(6, 27, 33)\n    44\t    child.step(6, 21, 27)\n    45\t    child.step(3)\n    46\t    child.step(*controls(child)[-1])\n    47\t    for _ in range(3):\n    48\t        child.step(6, 21, 33)\n    49\t    return child\n    50\t\n    51\t\n    52\tdef probe(env):\n    53\t    enter_level_9(env)\n    54\t    child = frontier(env)\n    55\t    name = sys.argv[1]\n    56\t    report((name, 0), child)\n    57\t    if name == \"left\":\n    58\t        actions = ((6, 15, 39), 3, 4, 4, 4, 4, 4, 4)\n    59\t    else:\n    60\t        actions = (\n    61\t            (6, 27, 39),\n    62\t            4,\n    63\t            (6, 33, 39),\n    64\t            4,\n    65\t            (6, 39, 39),\n    66\t            4,\n    67\t            (6, 45, 39),\n    68\t            4,\n    69\t            (6, 45, 33),\n    70\t            (6, 45, 33),\n    71\t            (6, 45, 33),\n    72\t            (6, 45, 33),\n    73\t            (6, 45, 33),\n    74\t            (6, 45, 33),\n    75\t        )\n    76\t    for index, action in enumerate(actions, 1):\n    77\t        child.step(*action) if isinstance(action, tuple) else child.step(action)\n    78\t        report((name, index, action), child)\n    79\t        if child.terminal() or int(child.levels_completed) >= 9:\n    80\t            break\n    81\t\n    82\t\n    83\tif __name__ == \"__main__\":\n    84\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Climb from PRE_SECOND while retaining both controls and seek the outer opening.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom probe_l9_boosted_supported_landing import report\n     9\tfrom probe_l9_control_row import controls\n    10\tfrom probe_l9_route_deletions import enter_level_9\n    11\tfrom probe_l9_super_final_exit import super_boosted\n    12\t\n    13\t\n    14\tdef pre_second(root):\n    15\t    child = super_boosted(root)\n    16\t    child.step(*controls(child)[0])\n    17\t    child.step(*controls(child)[0])\n    18\t    for action in ((6, 21, 39), 3, (6, 15, 39), 3):\n    19\t        child.step(*action) if isinstance(action, tuple) else child.step(action)\n    20\t    return child\n    21\t\n    22\t\n    23\tdef probe(env):\n    24\t    enter_level_9(env)\n    25\t    child = pre_second(env)\n    26\t    for height in range(10):\n    27\t        report((height, \"LEFT_COLOR\", int(child.frame()[39][9])), child)\n    28\t        if child.terminal() or int(child.levels_completed) >= 9:\n    29\t            break\n    30\t        child.step(6, 15, 33)\n    31\t\n    32\t\n    33\tif __name__ == \"__main__\":\n    34\t    arena.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
