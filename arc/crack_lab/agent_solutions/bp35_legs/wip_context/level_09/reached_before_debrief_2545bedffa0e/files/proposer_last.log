7)\n    38\t    child.step(4)\n    39\t    child.step(*controls(child)[-1])\n    40\t    return child\n    41\t\n    42\t\n    43\tdef probe(env):\n    44\t    enter_level_9(env)\n    45\t    child = reversed_root(env)\n    46\t    report(\"FLIP\", child)\n    47\t    for height in range(1, 15):\n    48\t        child.step(6, 27, 33)\n    49\t        report((\"CLIMB\", height), child)\n    50\t        if child.terminal() or int(child.levels_completed) >= 9:\n    51\t            break\n    52\t\n    53\t\n    54\tif __name__ == \"__main__\":\n    55\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Reverse one of the two controls at the compressed height-eight deadline.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom probe_l9_boosted_supported_landing import report\n     9\tfrom probe_l9_control_row import controls\n    10\tfrom probe_l9_faster_cycle import reversed_root\n    11\tfrom probe_l9_route_deletions import enter_level_9\n    12\t\n    13\t\n    14\tdef height_eight(root):\n    15\t    child = reversed_root(root)\n    16\t    for _ in range(8):\n    17\t        child.step(6, 27, 33)\n    18\t    return child\n    19\t\n    20\t\n    21\tdef probe(env):\n    22\t    enter_level_9(env)\n    23\t    child = height_eight(env)\n    24\t    switch = controls(child)[int(sys.argv[1])]\n    25\t    child.step(*switch)\n    26\t    report((sys.argv[1], switch, \"FLIP\"), child)\n    27\t\n    28\t\n    29\tif __name__ == \"__main__\":\n    30\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Turn upward where a lower horizontal traverse meets its first wall.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom probe_l9_boosted_supported_landing import report\n     9\tfrom probe_l9_route_deletions import enter_level_9\n    10\tfrom probe_l9_super_horizontal import start\n    11\t\n    12\t\n    13\tdef probe(env):\n    14\t    enter_level_9(env)\n    15\t    depth, column, height = map(int, sys.argv[1:4])\n    16\t    child = start(env, depth, column, height)\n    17\t    current = column\n    18\t    for target in range(column + 1, 9):\n    19\t        x = 3 + 6 * target\n    20\t        color = int(child.frame()[39][x])\n    21\t        if color in (3, 5):\n    22\t            break\n    23\t        if color in (12, 14, 15):\n    24\t            child.step(6, x, 39)\n    25\t        child.step(4)\n    26\t        current = target\n    27\t    report((depth, column, height, current, \"TURN\"), child)\n    28\t    x = 3 + 6 * current\n    29\t    for climb in range(1, 10):\n    30\t        child.step(6, x, 33)\n    31\t        report((climb, x), child)\n    32\t        if child.terminal() or int(child.levels_completed) >= 9:\n    33\t            break\n    34\t\n    35\t\n    36\tif __name__ == \"__main__\":\n    37\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Combine the two verified deletions and inspect the second-flip window.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom perception import connected_components\n     9\tfrom probe_l9_control_row import compact, controls\n    10\tfrom probe_l9_route_deletions import enter_level_9, replay, route, summary\n    11\t\n    12\t\n    13\tdef avatar(env):\n    14\t    return [\n    15\t        blob.bbox\n    16\t        for blob in connected_components(env.frame(), colors=(9, 11), min_area=3)\n    17\t        if blob.bbox[0] < 63\n    18\t    ]\n    19\t\n    20\t\n    21\tdef probe(env):\n    22\t    enter_level_9(env)\n    23\t    chamber = replay(env, route(), skips=(42, 48))\n    24\t    print(\"CHAMBER\", summary(chamber))\n    25\t    chamber.step(*controls(chamber)[0])\n    26\t    print(\"FLIP\", compact(chamber), \"avatar\", avatar(chamber))\n    27\t    for step in range(1, 12):\n    28\t        chamber.step(4)\n    29\t        print(\n    30\t            \"RIGHT\",\n    31\t            step,\n    32\t            compact(chamber),\n    33\t            \"terminal\",\n    34\t            bool(chamber.terminal()),\n    35\t            \"avatar\",\n    36\t            avatar(chamber),\n    37\t            \"controls\",\n    38\t            controls(chamber),\n    39\t        )\n    40\t        if chamber.terminal() or int(chamber.levels_completed) >= 9:\n    41\t            return\n    42\t\n    43\t\n    44\tif __name__ == \"__main__\":\n    45\t    arena.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
