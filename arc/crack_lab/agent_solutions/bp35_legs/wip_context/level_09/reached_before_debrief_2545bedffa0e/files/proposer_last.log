action_deltas(env, actions: Sequence[int] = ACTIONS) -> Dict[int, dict]:\n   127\t    base = arr(env.frame()).copy()\n   128\t    out = {}\n   129\t    for action in actions:\n   130\t        clone = env.clone()\n   131\t        clone.step(action)\n   132\t        out[int(action)] = frame_delta(base, clone.frame())\n   133\t    return out\n   134\t\n   135\t\n   136\tdef replay(env, actions: Sequence[int]):\n     1\t\"\"\"Apply the supported high-high handoff from the four-control frontier.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom perception import connected_components\n     9\tfrom probe_l9_control_row import compact, controls\n    10\tfrom probe_l9_preserve_boost import boosted\n    11\tfrom probe_l9_route_deletions import enter_level_9\n    12\tfrom probe_l9_supported_high_path import high_high as canonical_high_high\n    13\t\n    14\t\n    15\tdef boxes(env, color):\n    16\t    return tuple(\n    17\t        blob.bbox\n    18\t        for blob in connected_components(env.frame(), colors=(color,), min_area=2)\n    19\t        if blob.bbox[0] < 63\n    20\t    )\n    21\t\n    22\t\n    23\tdef report(label, env):\n    24\t    print(\n    25\t        label,\n    26\t        \"terminal\",\n    27\t        bool(env.terminal()),\n    28\t        \"levels\",\n    29\t        int(env.levels_completed),\n    30\t        \"avatar\",\n    31\t        boxes(env, 9),\n    32\t        \"controls\",\n    33\t        controls(env),\n    34\t        \"goals\",\n    35\t        boxes(env, 7),\n    36\t        \"grid\",\n    37\t        compact(env)[\"grid9\"],\n    38\t        flush=True,\n    39\t    )\n    40\t\n    41\t\n    42\tdef boosted_high_high(root):\n    43\t    child = boosted(root)\n    44\t    child.step(*controls(child)[0])\n    45\t    child.step(6, 21, 39)\n    46\t    child.step(3)\n    47\t    child.step(*controls(child)[0])\n    48\t    return child\n    49\t\n    50\t\n    51\tdef lower_landing(root):\n    52\t    child = boosted_high_high(root)\n    53\t    child.step(4)\n    54\t    for _ in range(5):\n    55\t        child.step(6, 27, 33)\n    56\t    child.step(6, 33, 27)\n    57\t    child.step(4)\n    58\t    child.step(*controls(child)[-1])\n    59\t    return child\n    60\t\n    61\t\n    62\tdef probe(env):\n    63\t    enter_level_9(env)\n    64\t    canonical = canonical_high_high(env)\n    65\t    report(\"CANONICAL_C3\", canonical)\n    66\t    canonical.step(4)\n    67\t    report(\"CANONICAL_C4\", canonical)\n    68\t    child = boosted(env)\n    69\t    report(\"BOOSTED\", child)\n    70\t    child = boosted_high_high(env)\n    71\t    report(\"HIGH_HIGH\", child)\n    72\t    child.step(4)\n    73\t    report(\"C4\", child)\n    74\t    for depth in range(1, 8):\n    75\t        child.step(6, 27, 33)\n    76\t        report((\"DROP\", depth), child)\n    77\t        if child.terminal() or int(child.levels_completed) >= 9:\n    78\t            return\n    79\t\n    80\t\n    81\tif __name__ == \"__main__\":\n    82\t    arena.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
