2\t            depth,\n    53\t            compact(env),\n    54\t            \"under\",\n    55\t            component_at(env, 3, 35),\n    56\t            \"controls\",\n    57\t            controls(env),\n    58\t            \"goals\",\n    59\t            goals(env),\n    60\t            \"cell\",\n    61\t            cell_symbol(env.frame()[35][3]),\n    62\t        )\n    63\t        if env.terminal() or int(env.levels_completed) >= 9:\n    64\t            return\n    65\t\n    66\t\n    67\tif __name__ == \"__main__\":\n    68\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Test the nine gravity controls reached via the protected x=3 shaft.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom perception import connected_components\n     9\tfrom probe_l9_extra_column import compact\n    10\tfrom probe_l9_k_room import enter_k_room\n    11\t\n    12\t\n    13\tdef enter_control_row(env):\n    14\t    enter_k_room(env)\n    15\t    env.step(6, 9, 33)\n    16\t    env.step(6, 45, 33)\n    17\t    for x in (39, 33, 27, 21, 15, 9, 3):\n    18\t        env.step(6, x, 39)\n    19\t        env.step(3)\n    20\t    env.step(6, 3, 33)\n    21\t\n    22\t\n    23\tdef controls(env):\n    24\t    return [\n    25\t        (6, round(blob.centroid[1]), round(blob.centroid[0]))\n    26\t        for blob in connected_components(env.frame(), colors=(8,), min_area=3)\n    27\t        if blob.bbox[0] < 63\n    28\t    ]\n    29\t\n    30\t\n    31\tdef probe(env):\n    32\t    enter_control_row(env)\n    33\t    print(\"CONTROL_ROW\", compact(env), \"controls\", controls(env))\n    34\t    for control in controls(env):\n    35\t        child = env.clone()\n    36\t        child.step(*control)\n    37\t        print(\"FLIP\", control, compact(child), \"controls\", controls(child))\n    38\t        for action in (3, 4):\n    39\t            moved = child.clone