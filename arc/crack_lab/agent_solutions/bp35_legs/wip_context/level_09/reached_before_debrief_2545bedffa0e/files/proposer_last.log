{"type":"item.completed","item":{"id":"item_218","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_l9_mechanics.py | sed -n '1,220p'\nnl -ba probe_l9_extra_column.py | sed -n '1,180p'\nnl -ba probe_l9_observe.py | sed -n '1,160p'\"","aggregated_output":"     1\t\"\"\"Reproduce level-9 movement, control, undo, and propagation mechanics.\"\"\"\n     2\t\n     3\timport json\n     4\timport sys\n     5\t\n     6\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     7\timport gkm_arena as arena\n     8\t\n     9\timport solve\n    10\tfrom legs import band_grid, moves_used\n    11\tfrom perception import connected_components\n    12\t\n    13\t\n    14\tTARGET = (6, 39, 15)\n    15\tUPPER_SWITCH = (6, 3, 27)\n    16\tLOWER_SWITCH = (6, 3, 39)\n    17\t\n    18\t\n    19\tdef enter_level_9(env):\n    20\t    with open(\"checkpoint.json\") as stream:\n    21\t        prefix = json.load(stream)[\"final_path\"]\n    22\t    for action in prefix:\n    23\t        env.step(action)\n    24\t    solve.solve(env)\n    25\t\n    26\t\n    27\tdef compact(env):\n    28\t    frame = env.frame()\n    29\t    blobs = connected_components(frame, colors=(8, 9, 11, 15), min_area=2)\n    30\t    return {\n    31\t        \"level\": int(env.levels_completed) + 1,\n    32\t        \"terminal\": bool(env.terminal()),\n    33\t        \"moves\": moves_used(frame),\n    34\t        \"grid\": tuple(\"\".join(row) for row in band_grid(frame)),\n    35\t        \"pieces\": tuple((b.color, b.bbox, b.area) for b in blobs if b.bbox[0] < 63),\n    36\t    }\n    37\t\n    38\t\n    39\tdef run(root, name, actions):\n    40\t    env = root.clone()\n    41\t    print(\"PATH\", name, \"START\", compact(env))\n    42\t    for index, action in enumerate(actions, 1):\n    43\t        if env.terminal():\n    44\t            break\n    45\t        env.step(*action) if isinstance(action, tuple) else env.step(action)\n    46\t        print(\"STEP\", name, index, action, compact(env))\n    47\t\n    48\t\n    49\tdef probe(env):\n    50\t    enter_level_9(env)\n    51\t    tests = {\n    52\t        \"right4\": [4, 4, 4, 4],\n    53\t        \"left4\": [3, 3, 3, 3],\n    54\t        \"undo1\": [4, 7],\n    55\t        \"undo2\": [4, 4, 7, 7],\n    56\t        \"upper\": [UPPER_SWITCH, 4, 4, 4],\n    57\t        \"lower\": [LOWER_SWITCH, 4, 4, 4],\n    58\t        \"split\": [TARGET],\n    59\t        \"split_up\": [TARGET, (6, 39, 9)],\n    60\t        \"split_left\": [TARGET, (6, 33, 15)],\n    61\t        \"split_down\": [TARGET, (6, 39, 21)],\n    62\t        \"split_right\": [TARGET, (6, 45, 15)],\n    63\t    }\n    64\t    for name, actions in tests.items():\n    65\t        run(env, name, actions)\n    66\t\n    67\t\n    68\tarena.run_program(\"bp35\", probe)\n     1\t\"\"\"Enter and climb the ninth, x=9 column revealed in the upper chamber.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom legs import ROW_ANCHORS, cell_symbol, moves_used\n     9\tfrom perception import connected_components\n    10\tfrom probe_l9_k_room import enter_k_room\n    11\t\n    12\t\n    13\tX_COLUMNS = (3, 9, 15, 21, 27, 33, 39, 45, 51, 57)\n    14\t\n    15\t\n    16\tdef compact(env):\n    17\t    blobs = connected_components(env.frame(), colors=(7, 8, 9, 14, 15), min_area=3)\n    18\t    return {\n    19\t        \"level\": int(env.levels_completed) + 1,\n    20\t        \"terminal\": bool(env.terminal()),\n    21\t        \"moves\": moves_used(env.frame()),\n    22\t        \"grid9\": tuple(\n    23\t            \"\".join(cell_symbol(env.frame()[y][x]) for x in X_COLUMNS)\n    24\t            for y in ROW_ANCHORS\n    25\t        ),\n    26\t        \"pieces\": tuple(\n    27\t            (b.color, b.bbox, b.area)\n    28\t            for b in blobs\n    29\t            if b.bbox[0] < 63 and b.color in (7, 8, 9, 14)\n    30\t        ),\n    31\t    }\n    32\t\n    33\t\n    34\tdef probe(env):\n    35\t    enter_k_room(env)\n    36\t    env.step(6, 9, 33)\n    37\t    env.step(6, 45, 33)\n    38\t    print(\"READY\", compact(env))\n    39\t    for x in (39, 33, 27, 21, 15, 9, 3):\n    40\t        env.step(6, x, 39)\n    41\t        env.step(3)\n    42\t        print(\"HANDOFF\", x, compact(env))\n    43\t        if env.terminal():\n    44\t            return\n    45\t    for advance in range(1, 5):\n    46\t        env.step(6, 3, 33)\n    47\t        print(\"CLIMB\", advance, compact(env))\n    48\t        if env.terminal() or int(env.levels_completed) >= 9:\n    49\t            return\n    50\t\n    51\t\n    52\tif __name__ == \"__main__\":\n    53\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Compact clean-room observation of the pristine bp35 level-9 entry.\"\"\"\n     2\t\n     3\timport json\n     4\timport sys\n     5\tfrom collections import Counter, defaultdict\n     6\t\n     7\timport numpy as np\n     8\t\n     9\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n    10\timport gkm_arena as arena\n    11\t\n    12\timport solve\n    13\tfrom legs import COL_ANCHORS, ROW_ANCHORS, band_grid\n    14\tfrom perception import color_counts, connected_components\n    15\t\n    16\t\n    17\tdef visible_components(frame):\n    18\t    return [\n    19\t        (blob.color, blob.bbox, blob.area)\n    20\t        for blob in connected_components(frame, min_area=3)\n    21\t        if blob.bbox[0] < 63 and blob.color != 10\n    22\t    ]\n    23\t\n    24\t\n    25\tdef transition_counts(before, after):\n    26\t    a = np.asarray(before)\n    27\t    b = np.asarray(after)\n    28\t    changed = (a != b)\n    29\t    changed[63, :] = False\n    30\t    pairs = Counter(\n    31\t        (int(old), int(new))\n    32\t        for old, new in zip(a[changed].tolist(), b[changed].tolist())\n    33\t    )\n    34\t    ys, xs = np.where(changed)\n    35\t    bbox = None\n    36\t    if len(ys):\n    37\t        bbox = (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max()))\n    38\t    return int(changed.sum()), bbox, sorted(pairs.items())\n    39\t\n    40\t\n    41\tdef observation(before, child):\n    42\t    return {\n    43\t        \"level\": int(child.levels_completed) + 1,\n    44\t        \"terminal\": bool(child.terminal()),\n    45\t        \"delta\": transition_counts(before, child.frame()),\n    46\t        \"grid\": band_grid(child.frame()),\n    47\t        \"actors\": [\n    48\t            item for item in visible_components(child.frame()) if item[0] in (9, 11)\n    49\t        ],\n    50\t    }\n    51\t\n    52\t\n    53\tdef enter_level_9(env):\n    54\t    with open(\"checkpoint.json\") as stream:\n    55\t        prefix = json.load(stream)[\"final_path\"]\n    56\t    for action in prefix:\n    57\t        env.step(action)\n    58\t    solve.solve(env)\n    59\t\n    60\t\n    61\tdef probe(env):\n    62\t    enter_level_9(env)\n    63\t    frame = np.asarray(env.frame()).copy()\n    64\t    print(\n    65\t        \"ENTRY\",\n    66\t        {\n    67\t            \"level\": int(env.levels_completed) + 1,\n    68\t            \"terminal\": bool(env.terminal()),\n    69\t            \"actions\": env.actions,\n    70\t            \"colors\": color_counts(frame),\n    71\t        },\n    72\t    )\n    73\t    print(\"GRID\")\n    74\t    for row in band_grid(frame):\n    75\t        print(row)\n    76\t    print(\"COMPONENTS\", visible_components(frame))\n    77\t\n    78\t    for action in (3, 4, 7):\n    79\t        child = env.clone()\n    80\t        child.step(action)\n    81\t        print(\"KEY\", action, observation(frame, child))\n    82\t\n    83\t    groups = defaultdict(list)\n    84\t    representatives = {}\n    85\t    for i, y in enumerate(ROW_ANCHORS):\n    86\t        for j, x in enumerate(COL_ANCHORS):\n    87\t            child = env.clone()\n    88\t            child.step(6, x, y)\n    89\t            key_frame = np.asarray(child.frame()).copy()\n    90\t            key_frame[63, :] = 0\n    91\t            key = (\n    92\t                int(child.levels_completed),\n    93\t                bool(child.terminal()),\n    94\t                key_frame.tobytes(),\n    95\t            )\n    96\t            groups[key].append((i, j))\n    97\t            representatives[key] = observation(frame, child)\n    98\t    print(\"CLICK_GROUPS\", len(groups))\n    99\t    for cells, result in sorted(\n   100\t        ((groups[key], representatives[key]) for key in groups),\n   101\t        key=lambda item: (len(item[0]), item[0]),\n   102\t    ):\n   103\t        print(\"CLICK\", cells, result)\n   104\t\n   105\t\n   106\tarena.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_219","type":"command_execution","command":"/bin/zsh -lc \"nl -ba legs.py | sed -n '1,180p'\nnl -ba legs.py | sed -n '180,380p'\nnl -ba legs.py | sed -n '380,620p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_219","type":"command_execution","command":"/bin/zsh -lc \"nl -ba legs.py | sed -n '1,180p'\nnl -ba legs.py | sed -n '180,380p'\nnl -ba legs.py | sed -n '380,620p'\"","aggregated_output":"     1\t# Shared leg library: small, named, reusable skills.\n     2\t# Players import from here; add a NEW leg only when no existing leg fits.\n     3\t#\n     4\t# Substrate observed on bp35 (raw frames only):\n     5\t#   * The 64x64 frame is a 6px band lattice: cell (i, j) is sampled at\n     6\t#     (3 + 6i, 15 + 6j) -> a 10 x 8 symbolic grid.\n     7\t#   * Row 63 is a move counter (one non-zero pixel per action taken).\n     8\t#   * The avatar always renders on band row 6; the world scrolls instead.\n     9\t#     After every action the avatar RISES through open cells until blocked,\n    10\t#     so height is gained by opening the cell above it.\n    11\t#   * Action 3 = step left one column, 4 = step right one column.\n    12\t#     Action 6 with (x, y) pixel coordinates clicks a cell; clicking a\n    13\t#     removable block (colour 14) turns it into open floor. Any other click\n    14\t#     is a no-op that still burns a move.\n    15\t#   * A floor rises from below one band every two moves and kills on contact,\n    16\t#     so climbing must outpace the move counter.\n    17\t#   * Reaching a prize cell (a colour outside the terrain palette) on the\n    18\t#     avatar's row completes the level.\n    19\t#   * Off-palette colours are NOT always prizes: from L2 on they are also\n    20\t#     hazards that hang below their own band, so resting under one kills while\n    21\t#     touching one sideways is simply solid. Nothing here models which is\n    22\t#     which -- a clone probe decides, and dead successors are dropped.\n    23\t#   * The world scrolls whenever the avatar rises, so any plan longer than one\n    24\t#     action goes stale. Walk and climb legs re-read the frame every step.\n    25\t\n    26\timport heapq\n    27\timport itertools\n    28\tfrom collections import deque\n    29\t\n    30\tBAND = 6\n    31\tGRID_ROWS = 10\n    32\tGRID_COLS = 8\n    33\tROW_ANCHORS = [3 + BAND * i for i in range(GRID_ROWS)]\n    34\tCOL_ANCHORS = [15 + BAND * j for j in range(GRID_COLS)]\n    35\tAVATAR_ROW = 6\n    36\t\n    37\tWALL_COLORS = (3, 5)\n    38\tOPEN_COLORS = (10,)\n    39\tBLOCK_COLORS = (14,)\n    40\tAVATAR_COLORS = (9, 11)\n    41\t\n    42\tWALL, OPEN, BLOCK, AVATAR, PRIZE = '#', ' ', 'Y', 'A', '*'\n    43\t\n    44\tLEFT, RIGHT, CLICK = 3, 4, 6\n    45\t\n    46\t\n    47\t# --- observation legs -------------------------------------------------\n    48\t\n    49\tdef cell_symbol(color):\n    50\t    \"\"\"Classify one raw colour into the terrain alphabet.\"\"\"\n    51\t    color = int(color)\n    52\t    if color in WALL_COLORS:\n    53\t        return WALL\n    54\t    if color in OPEN_COLORS:\n    55\t        return OPEN\n    56\t    if color in BLOCK_COLORS:\n    57\t        return BLOCK\n    58\t    if color in AVATAR_COLORS:\n    59\t        return AVATAR\n    60\t    return PRIZE\n    61\t\n    62\t\n    63\tdef band_grid(frame):\n    64\t    \"\"\"Quantise a frame onto the 6px band lattice as a symbolic grid.\"\"\"\n    65\t    return [[cell_symbol(frame[r][c]) for c in COL_ANCHORS] for r in ROW_ANCHORS]\n    66\t\n    67\t\n    68\tdef avatar_column(frame):\n    69\t    \"\"\"Column index of the avatar on its fixed band row, or None if gone.\"\"\"\n    70\t    row = band_grid(frame)[AVATAR_ROW]\n    71\t    for j, sym in enumerate(row):\n    72\t        if sym == AVATAR:\n    73\t            return j\n    74\t    return None\n    75\t\n    76\t\n    77\tdef moves_used(frame):\n    78\t    \"\"\"Actions consumed so far, read off the counter strip in row 63.\"\"\"\n    79\t    return sum(1 for v in frame[63] if int(v) != 0)\n    80\t\n    81\t\n    82\tdef find_symbol(grid, symbol, row=None):\n    83\t    \"\"\"All (i, j) cells carrying ``symbol``; optionally restricted to a row.\"\"\"\n    84\t    rows = range(GRID_ROWS) if row is None else (row,)\n    85\t    return [(i, j) for i in rows for j in range(GRID_COLS) if grid[i][j] == symbol]\n    86\t\n    87\t\n    88\tdef band_shift(before, after):\n    89\t    \"\"\"Bands the camera scrolled between two frames, i.e. the height gained.\n    90\t\n    91\t    The camera pins the avatar to ``AVATAR_ROW``, so a rise shows up only as\n    92\t    the world sliding down. Scored by how many raw rows line up at each\n    93\t    candidate offset, which tolerates the cells the avatar itself repainted.\n    94\t    \"\"\"\n    95\t    rows_before = [tuple(int(v) for v in before[r]) for r in range(63)]\n    96\t    rows_after = [tuple(int(v) for v in after[r]) for r in range(63)]\n    97\t    best_hits, best = -1, 0\n    98\t    for bands in range(GRID_ROWS):\n    99\t        offset = BAND * bands\n   100\t        hits = sum(1 for r in range(63 - offset)\n   101\t                   if rows_before[r] == rows_after[r + offset])\n   102\t        if hits > best_hits:\n   103\t            best_hits, best = hits, bands\n   104\t    return best\n   105\t\n   106\t\n   107\t# --- action legs ------------------------------------------------------\n   108\t\n   109\tdef click_cell(env, i, j):\n   110\t    \"\"\"Click band cell (i, j); removes a removable block, else burns a move.\"\"\"\n   111\t    env.step(CLICK, COL_ANCHORS[j], ROW_ANCHORS[i])\n   112\t\n   113\t\n   114\tdef act(env, action, log=None):\n   115\t    \"\"\"Apply one action tuple -- ``(key,)`` or ``(CLICK, x, y)`` -- and record it.\"\"\"\n   116\t    env.step(*action)\n   117\t    if log is not None:\n   118\t        log.append(action)\n   119\t\n   120\t\n   121\tdef run_action_route(env, route, resolve_action=None, stop_on_level=False):\n   122\t    \"\"\"Execute an action route, optionally resolving contextual route tokens.\n   123\t\n   124\t    ``resolve_action(env, token)`` may turn a symbolic token into an action.\n   125\t    With ``stop_on_level``, success means completing the level active on entry.\n   126\t    \"\"\"\n   127\t    base_level = env.levels_completed\n   128\t    for token in route:\n   129\t        if env.terminal():\n   130\t            return False\n   131\t        action = resolve_action(env, token) if resolve_action else token\n   132\t        if action is None:\n   133\t            return False\n   134\t        act(env, action)\n   135\t        if stop_on_level and env.levels_completed > base_level:\n   136\t            return True\n   137\t    return not stop_on_level\n   138\t\n   139\t\n   140\tdef run_actions(env, actions):\n   141\t    \"\"\"Replay a recorded action list, stopping early if the episode ends.\"\"\"\n   142\t    return run_action_route(env, actions)\n   143\t\n   144\t\n   145\tdef plan_and_commit(env, search_leg, **search_options):\n   146\t    \"\"\"Find an action route on clones, then commit it on the real environment.\"\"\"\n   147\t    base_level = env.levels_completed\n   148\t    actions = search_leg(env, **search_options)\n   149\t    if not actions:\n   150\t        return False\n   151\t    run_actions(env, actions)\n   152\t    return env.levels_completed > base_level\n   153\t\n   154\t\n   155\tdef click_action(i, j):\n   156\t    \"\"\"The action tuple that clicks band cell (i, j).\"\"\"\n   157\t    return (CLICK, COL_ANCHORS[j], ROW_ANCHORS[i])\n   158\t\n   159\t\n   160\tdef walk_to(env, target_col, log=None, max_steps=32):\n   161\t    \"\"\"Walk along the avatar row to ``target_col``, clearing blocks in the way.\n   162\t\n   163\t    Re-reads the frame every step because the world scrolls under the avatar.\n   164\t    Returns True only if the avatar is alive and standing on the target column.\n   165\t    \"\"\"\n   166\t    for _ in range(max_steps):\n   167\t        frame = env.frame()\n   168\t        col = avatar_column(frame)\n   169\t        if col is None:\n   170\t            return False\n   171\t        if col == target_col:\n   172\t            return True\n   173\t        direction = 1 if target_col > col else -1\n   174\t        ahead = band_grid(frame)[AVATAR_ROW][col + direction]\n   175\t        if ahead in (WALL, PRIZE):\n   176\t            return False\n   177\t        if ahead == BLOCK:\n   178\t            act(env, click_action(AVATAR_ROW, col + direction), log)\n   179\t            continue\n   180\t        act(env, (RIGHT if direction > 0 else LEFT,), log)\n   180\t        act(env, (RIGHT if direction > 0 else LEFT,), log)\n   181\t    return False\n   182\t\n   183\t\n   184\tdef run_plan(env, plan, base_level=None):\n   185\t    \"\"\"Execute a plan of ('click', i, j) / ('step', action) items.\n   186\t\n   187\t    Returns False as soon as the episode ends or a level above ``base_level``\n   188\t    is completed. ``base_level`` defaults to the level in progress on entry.\n   189\t    \"\"\"\n   190\t    if base_level is None:\n   191\t        base_level = env.levels_completed\n   192\t    for item in plan:\n   193\t        if env.terminal():\n   194\t            return False\n   195\t        if item[0] == 'click':\n   196\t            click_cell(env, item[1], item[2])\n   197\t        else:\n   198\t            env.step(item[1])\n   199\t        if env.terminal() or env.levels_completed > base_level:\n   200\t            return False\n   201\t    return True\n   202\t\n   203\t\n   204\t# --- planning legs ----------------------------------------------------\n   205\t\n   206\tdef _column_plan(grid, j, walk, out):\n   207\t    \"\"\"Append a climb plan for column ``j`` reached via prefix ``walk``.\"\"\"\n   208\t    cleared = set()\n   209\t    i = AVATAR_ROW - 1\n   210\t    while i >= 0 and grid[i][j] == BLOCK:\n   211\t        cleared.add(i)\n   212\t        i -= 1\n   213\t    if not cleared and i >= 0 and grid[i][j] != OPEN:\n   214\t        return  # solid immediately overhead: this column cannot be climbed\n   215\t    gain = 0\n   216\t    i = AVATAR_ROW - 1\n   217\t    while i >= 0 and (grid[i][j] == OPEN or i in cleared):\n   218\t        gain += 1\n   219\t        i -= 1\n   220\t    if gain <= 0:\n   221\t        return\n   222\t    plan = list(walk) + [('click', i, j) for i in sorted(cleared, reverse=True)]\n   223\t    out.append((len(plan), gain, plan))\n   224\t\n   225\t\n   226\tdef climb_plans(grid, col):\n   227\t    \"\"\"Enumerate (cost, height_gain, plan) options from the avatar's column.\n   228\t\n   229\t    Walking sideways is blocked by walls; a removable block in the way is\n   230\t    cleared with a click first.\n   231\t    \"\"\"\n   232\t    out = []\n   233\t    for direction in (-1, 1):\n   234\t        j = col\n   235\t        walk = []\n   236\t        while True:\n   237\t            _column_plan(grid, j, walk, out)\n   238\t            nj = j + direction\n   239\t            if not 0 <= nj < GRID_COLS or grid[AVATAR_ROW][nj] == WALL:\n   240\t                break\n   241\t            if grid[AVATAR_ROW][nj] == PRIZE:\n   242\t                break\n   243\t            if grid[AVATAR_ROW][nj] == BLOCK:\n   244\t                walk = walk + [('click', AVATAR_ROW, nj)]\n   245\t            walk = walk + [('step', LEFT if direction < 0 else RIGHT)]\n   246\t            j = nj\n   247\t    return out\n   248\t\n   249\t\n   250\tdef walk_plan(grid, col, target_col):\n   251\t    \"\"\"Sideways plan from ``col`` to ``target_col``, or None if blocked.\"\"\"\n   252\t    direction = 1 if target_col > col else -1\n   253\t    plan = []\n   254\t    j = col\n   255\t    while j != target_col:\n   256\t        nj = j + direction\n   257\t        if grid[AVATAR_ROW][nj] == WALL:\n   258\t            return None\n   259\t        if grid[AVATAR_ROW][nj] == BLOCK:\n   260\t            plan.append(('click', AVATAR_ROW, nj))\n   261\t        plan.append(('step', LEFT if direction < 0 else RIGHT))\n   262\t        j = nj\n   263\t    return plan\n   264\t\n   265\t\n   266\t# --- composite legs ---------------------------------------------------\n   267\t\n   268\tdef climb_tower(env, move_budget=56, stop_on_prize=True):\n   269\t    \"\"\"Greedily gain height until the prize shows up or no column can rise.\n   270\t\n   271\t    Each iteration picks the climb plan with the best height-per-move ratio,\n   272\t    which is the dense progress measure that outpaces the rising floor.\n   273\t    \"\"\"\n   274\t    base_level = env.levels_completed\n   275\t    climbed = 0\n   276\t    while not env.terminal() and env.levels_completed <= base_level:\n   277\t        frame = env.frame()\n   278\t        grid = band_grid(frame)\n   279\t        col = avatar_column(frame)\n   280\t        if col is None or moves_used(frame) >= move_budget:\n   281\t            break\n   282\t        if stop_on_prize and find_symbol(grid, PRIZE, row=AVATAR_ROW):\n   283\t            break\n   284\t        options = climb_plans(grid, col)\n   285\t        if not options:\n   286\t            break\n   287\t        options.sort(key=lambda p: (-p[1] / p[0], p[0]))\n   288\t        cost, gain, plan = options[0]\n   289\t        if not run_plan(env, plan):\n   290\t            break\n   291\t        climbed += gain\n   292\t    return climbed\n   293\t\n   294\t\n   295\tdef reach_prize(env):\n   296\t    \"\"\"Walk sideways onto a prize cell sharing the avatar's row.\"\"\"\n   297\t    base_level = env.levels_completed\n   298\t    if env.terminal():\n   299\t        return False\n   300\t    frame = env.frame()\n   301\t    grid = band_grid(frame)\n   302\t    col = avatar_column(frame)\n   303\t    if col is None:\n   304\t        return False\n   305\t    targets = find_symbol(grid, PRIZE, row=AVATAR_ROW)\n   306\t    if not targets:\n   307\t        return False\n   308\t    targets.sort(key=lambda t: abs(t[1] - col))\n   309\t    plan = walk_plan(grid, col, targets[0][1])\n   310\t    if plan is None:\n   311\t        return False\n   312\t    run_plan(env, plan, base_level)\n   313\t    return env.levels_completed > base_level\n   314\t\n   315\t\n   316\tdef climb_to_prize(env, move_budget=56):\n   317\t    \"\"\"Full ascent: climb the tower, then step onto the prize at the top.\"\"\"\n   318\t    climb_tower(env, move_budget=move_budget)\n   319\t    return reach_prize(env)\n   320\t\n   321\t\n   322\t# --- search legs ------------------------------------------------------\n   323\t\n   324\tdef climb_macros(env):\n   325\t    \"\"\"Successor states of one climb decision, as ``(actions, clone)`` pairs.\n   326\t\n   327\t    Two macros per column: walk there, and walk there then clear the cell\n   328\t    overhead so the avatar rises. Successors that kill the avatar are dropped,\n   329\t    so callers need no hazard model -- the clone reports the hazard.\n   330\t    \"\"\"\n   331\t    base_level = env.levels_completed\n   332\t    for j in range(GRID_COLS):\n   333\t        walk = []\n   334\t        node = env.clone()\n   335\t        if not walk_to(node, j, walk):\n   336\t            continue\n   337\t        if walk:\n   338\t            yield list(walk), node\n   339\t        if band_grid(node.frame())[AVATAR_ROW - 1][j] != BLOCK:\n   340\t            continue\n   341\t        risen = node.clone()\n   342\t        step = click_action(AVATAR_ROW - 1, j)\n   343\t        risen.step(*step)\n   344\t        if (avatar_column(risen.frame()) is None\n   345\t                and risen.levels_completed <= base_level):\n   346\t            continue  # clone died here: the cell overhead is a trap\n   347\t        yield walk + [step], risen\n   348\t\n   349\t\n   350\tdef _climb_key(env, height):\n   351\t    frame = env.frame()\n   352\t    return height, avatar_column(frame), tuple(''.join(r) for r in band_grid(frame))\n   353\t\n   354\t\n   355\tdef climb_search(env, max_expansions=800):\n   356\t    \"\"\"Best-first ascent maximising bands gained; backtracks out of trap columns.\n   357\t\n   358\t    ``climb_tower`` is greedy on height-per-move and so walks into shafts whose\n   359\t    only exit is fatal. This keeps a frontier ordered by accumulated height\n   360\t    (the dense progress measure) with move count as the tie-break, so a dead\n   361\t    end costs an expansion rather than the run. Returns the actions that\n   362\t    complete the level, else the deepest-climbing actions found.\n   363\t    \"\"\"\n   364\t    base_level = env.levels_completed\n   365\t    tie = itertools.count()\n   366\t    root = env.clone()\n   367\t    queue = [(0, 0, next(tie), root, 0, [])]\n   368\t    seen = {_climb_key(root, 0)}\n   369\t    best = (0, [])\n   370\t    for _ in range(max_expansions):\n   371\t        if not queue:\n   372\t            break\n   373\t        _, _, _, node, height, actions = heapq.heappop(queue)\n   374\t        for step, child in climb_macros(node):\n   375\t            if child.levels_completed > base_level:\n   376\t                return actions + step\n   377\t            gained = height + band_shift(node.frame(), child.frame())\n   378\t            key = _climb_key(child, gained)\n   379\t            if key in seen:\n   380\t                continue\n   380\t                continue\n   381\t            seen.add(key)\n   382\t            if gained > best[0]:\n   383\t                best = (gained, actions + step)\n   384\t            heapq.heappush(queue, (-gained, moves_used(child.frame()),\n   385\t                                   next(tie), child, gained, actions + step))\n   386\t    return best[1]\n   387\t\n   388\t\n   389\tdef climb_by_search(env, max_expansions=800):\n   390\t    \"\"\"Plan an ascent on clones, then commit it on the real env.\"\"\"\n   391\t    return plan_and_commit(\n   392\t        env, climb_search, max_expansions=max_expansions\n   393\t    )\n   394\t\n   395\t\n   396\tdef _cell_shape(frame, i, j):\n   397\t    \"\"\"Centre colour and its area in one band cell.\n   398\t\n   399\t    Shape distinguishes a small hazard from its expanded safe form even when\n   400\t    both use the same colour.\n   401\t    \"\"\"\n   402\t    r0, c0 = BAND * i, 13 + BAND * j\n   403\t    color = int(frame[ROW_ANCHORS[i]][COL_ANCHORS[j]])\n   404\t    area = sum(1 for r in range(r0, r0 + BAND)\n   405\t               for c in range(c0, c0 + BAND)\n   406\t               if int(frame[r][c]) == color)\n   407\t    return color, area\n   408\t\n   409\t\n   410\tdef local_hazard_climb_search(env, max_expansions=600):\n   411\t    \"\"\"Search a timed climb using movement and only nearby interactions.\n   412\t\n   413\t    Some towers use shape-changing hazards: interacting with a small hazard\n   414\t    makes it safe to pass, while distant clicks merely waste the tight clock.\n   415\t    The observational key retains each cell's shape as well as climbed height\n   416\t    and elapsed moves.  Replaying paths from one root avoids retaining a large\n   417\t    tree of nested clones.\n   418\t    \"\"\"\n   419\t    base_level = env.levels_completed\n   420\t    tie = itertools.count()\n   421\t    root = env.clone()\n   422\t\n   423\t    def key(node, height):\n   424\t        frame = node.frame()\n   425\t        return (height, moves_used(frame), avatar_column(frame),\n   426\t                tuple(_cell_shape(frame, i, j)\n   427\t                      for i in range(GRID_ROWS) for j in range(GRID_COLS)))\n   428\t\n   429\t    def local_actions(node):\n   430\t        frame = node.frame()\n   431\t        col = avatar_column(frame)\n   432\t        out = [(LEFT,), (RIGHT,)]\n   433\t        if col is None:\n   434\t            return out\n   435\t        for i in (AVATAR_ROW - 1, AVATAR_ROW):\n   436\t            for j in range(max(0, col - 1), min(GRID_COLS, col + 2)):\n   437\t                color = int(frame[ROW_ANCHORS[i]][COL_ANCHORS[j]])\n   438\t                if color not in OPEN_COLORS + WALL_COLORS + AVATAR_COLORS:\n   439\t                    out.append(click_action(i, j))\n   440\t        return out\n   441\t\n   442\t    queue = [(0, 0, next(tie), 0, ())]\n   443\t    seen = {key(root, 0)}\n   444\t    for _ in range(max_expansions):\n   445\t        if not queue:\n   446\t            break\n   447\t        _, _, _, height, path = heapq.heappop(queue)\n   448\t        node = root.clone()\n   449\t        run_actions(node, path)\n   450\t        for action in local_actions(node):\n   451\t            child = node.clone()\n   452\t            child.step(*action)\n   453\t            if child.levels_completed > base_level:\n   454\t                return list(path + (action,))\n   455\t            if child.terminal() or avatar_column(child.frame()) is None:\n   456\t                continue\n   457\t            gained = height + band_shift(node.frame(), child.frame())\n   458\t            state = key(child, gained)\n   459\t            if state in seen:\n   460\t                continue\n   461\t            seen.add(state)\n   462\t            new_path = path + (action,)\n   463\t            heapq.heappush(queue, (-gained, len(new_path), next(tie),\n   464\t                                   gained, new_path))\n   465\t    return []\n   466\t\n   467\t\n   468\tdef climb_local_hazards(env, max_expansions=600):\n   469\t    \"\"\"Plan a shape-changing hazard climb on clones, then commit it.\"\"\"\n   470\t    return plan_and_commit(\n   471\t        env, local_hazard_climb_search, max_expansions=max_expansions\n   472\t    )\n   473\t\n   474\t\n   475\tdef gravity_room_search(env, max_states=900, max_depth=48, debug=False):\n   476\t    \"\"\"Find a route through rooms controlled by gravity toggles and supports.\n   477\t\n   478\t    Movement is always considered.  Global gravity toggles (colour 8) can\n   479\t    appear either in the band grid or in the fixed left control strip.\n   480\t    Removable supports (14) and shape-changing supports (12) are useful only\n   481\t    when aligned near the avatar; hazards (15) only when nearby.\n   482\t    Reconstructing each state from one shallow root avoids chains of costly\n   483\t    nested clones.\n   484\t    \"\"\"\n   485\t    base_level = env.levels_completed\n   486\t    root = env.clone()\n   487\t\n   488\t    def avatar_cell(frame):\n   489\t        for i, r in enumerate(ROW_ANCHORS):\n   490\t            for j, c in enumerate(COL_ANCHORS):\n   491\t                if int(frame[r][c]) in AVATAR_COLORS:\n   492\t                    return i, j\n   493\t        return None\n   494\t\n   495\t    def choices(node):\n   496\t        frame = node.frame()\n   497\t        avatar = avatar_cell(frame)\n   498\t        out = [(LEFT,), (RIGHT,)]\n   499\t        if avatar is None:\n   500\t            return out\n   501\t        ai, aj = avatar\n   502\t        control_rows = [y for y in range(63) if int(frame[y][3]) == 8]\n   503\t        if control_rows:\n   504\t            run = [control_rows[0]]\n   505\t            for y in control_rows[1:]:\n   506\t                if y != run[-1] + 1:\n   507\t                    break\n   508\t                run.append(y)\n   509\t            out.append((CLICK, 3, run[len(run) // 2]))\n   510\t        for i, y in enumerate(ROW_ANCHORS):\n   511\t            for j, x in enumerate(COL_ANCHORS):\n   512\t                color = int(frame[y][x])\n   513\t                if color == 8 and abs(j - aj) <= 1:\n   514\t                    out.append((CLICK, x, y))\n   515\t                elif color in (12, 14) and abs(j - aj) <= 1 and abs(i - ai) <= 3:\n   516\t                    out.append((CLICK, x, y))\n   517\t                elif color == 15 and abs(i - ai) <= 1 and abs(j - aj) <= 1:\n   518\t                    out.append((CLICK, x, y))\n   519\t        return out\n   520\t\n   521\t    def state_key(node):\n   522\t        frame = node.frame()\n   523\t        cells = tuple(\n   524\t            _cell_shape(frame, i, j)\n   525\t            for i in range(GRID_ROWS)\n   526\t            for j in range(GRID_COLS)\n   527\t        )\n   528\t        return cells, moves_used(frame) % 2\n   529\t\n   530\t    def reconstruct(path):\n   531\t        node = root.clone()\n   532\t        run_actions(node, path)\n   533\t        return node\n   534\t\n   535\t    counter = itertools.count()\n   536\t    frontier = [(0, 0, next(counter), ())]\n   537\t    seen_progress = {state_key(root)}\n   538\t    expanded = 0\n   539\t\n   540\t    while frontier and expanded < max_states:\n   541\t        neg_height, _, _, prefix = heapq.heappop(frontier)\n   542\t        if debug:\n   543\t            print(\"macro\", -neg_height, len(prefix), expanded, len(frontier), prefix)\n   544\t        stage = reconstruct(prefix)\n   545\t        local_queue = deque([()])\n   546\t        local_seen = {state_key(stage)}\n   547\t\n   548\t        # Search the current room only until the camera rises.  Each distinct\n   549\t        # landing becomes a macro successor, so unsafe early toggles can still\n   550\t        # be backtracked without flattening the whole course into one BFS.\n   551\t        while local_queue and expanded < max_states:\n   552\t            suffix = local_queue.popleft()\n   553\t            path = prefix + suffix\n   554\t            node = stage.clone()\n   555\t            run_actions(node, suffix)\n   556\t            expanded += 1\n   557\t            if len(path) >= max_depth or node.terminal():\n   558\t                continue\n   559\t            for action in choices(node):\n   560\t                child = node.clone()\n   561\t                child.step(*action)\n   562\t                new_suffix = suffix + (action,)\n   563\t                new_path = prefix + new_suffix\n   564\t                if child.levels_completed > base_level:\n   565\t                    return list(new_path)\n   566\t                if child.terminal() or avatar_cell(child.frame()) is None:\n   567\t                    continue\n   568\t                key = state_key(child)\n   569\t                gain = max(0, band_shift(node.frame(), child.frame()))\n   570\t                if gain:\n   571\t                    if key in seen_progress:\n   572\t                        continue\n   573\t                    seen_progress.add(key)\n   574\t                    height = -neg_height + gain\n   575\t                    heapq.heappush(\n   576\t                        frontier,\n   577\t                        (-height, len(new_path), next(counter), new_path),\n   578\t                    )\n   579\t                elif len(new_suffix) < 12 and key not in local_seen:\n   580\t                    local_seen.add(key)\n   581\t                    local_queue.append(new_suffix)\n   582\t    return []\n   583\t\n   584\t\n   585\tdef solve_gravity_rooms(env, max_states=900, max_depth=48):\n   586\t    \"\"\"Plan context-safe gravity/support transitions, then commit the route.\"\"\"\n   587\t    return plan_and_commit(\n   588\t        env, gravity_room_search, max_states=max_states, max_depth=max_depth\n   589\t    )\n   590\t\n   591\t\n   592\tdef cross_persistent_support_rooms(env):\n   593\t    \"\"\"Stage remote supports, traverse alternating rooms, and reach the prize.\n   594\t\n   595\t    Some gravity courses scroll the starting supports off-screen long before\n   596\t    they are needed.  Expanding both first preserves a two-cell bridge in the\n   597\t    final lower chamber; the avatar can then cross it into the prize corridor.\n   598\t    \"\"\"\n   599\t    route = [\n   600\t        # Preserve the two starting supports for the otherwise lethal chamber.\n   601\t        click_action(8, 4), click_action(8, 5),\n   602\t\n   603\t        # Enter the first gravity switch and take its safe landing lane.\n   604\t        (RIGHT,), (RIGHT,), (RIGHT,), (RIGHT,), (RIGHT,),\n   605\t        click_action(5, 4),\n   606\t        click_action(4, 2),\n   607\t        (LEFT,), (LEFT,),\n   608\t        (RIGHT,), (RIGHT,),\n   609\t        (LEFT,), (LEFT,),\n   610\t\n   611\t        # Open a protected path through the full support barrier.\n   612\t        click_action(5, 3), (LEFT,),\n   613\t        click_action(5, 2), (LEFT,),\n   614\t        click_action(5, 1), (LEFT,),\n   615\t        click_action(5, 1),\n   616\t\n   617\t        # Stage the remote landing support, flip gravity, and cross the shafts.\n   618\t        click_action(8, 5),\n   619\t        (RIGHT,), (RIGHT,), (RIGHT,), (RIGHT,),\n   620\t        click_action(0, 6),\n","exit_code":0,"status":"completed"}}
