),\n    42\t        \"R8C2\": ((6, 15, 51),),\n    43\t        \"R9_R8\": ((6, 21, 57), (6, 21, 51)),\n    44\t        \"R8_R9\": ((6, 21, 51), (6, 21, 57)),\n    45\t        \"R9_C2\": ((6, 21, 57), (6, 15, 51)),\n    46\t    }\n    47\t    for name, actions in variants.items():\n    48\t        run(env, name, actions)\n    49\t\n    50\t\n    51\tif __name__ == \"__main__\":\n    52\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Verify the one-turn-faster column-three entry through the full finish.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom perception import connected_components\n     9\tfrom probe_l9_control_row import compact, controls\n    10\tfrom probe_l9_route_deletions import enter_level_9\n    11\tfrom probe_l9_second_lower_entry import goals\n    12\tfrom probe_l9_staged_entry_trace import replay\n    13\t\n    14\t\n    15\tdef avatar(env):\n    16\t    return tuple(\n    17\t        blob.bbox\n    18\t        for blob in connected_components(env.frame(), colors=(9,), min_area=3)\n    19\t        if blob.bbox[0] < 63\n    20\t    )\n    21\t\n    22\t\n    23\tdef report(label, env):\n    24\t    print(\n    25\t        label,\n    26\t        \"terminal\",\n    27\t        bool(env.terminal()),\n    28\t        \"level\",\n    29\t        int(env.levels_completed) + 1,\n    30\t        \"avatar\",\n    31\t        avatar(env),\n    32\t        \"controls\",\n    33\t        controls(env),\n    34\t        \"goals\",\n    35\t        goals(env),\n    36\t        \"grid\",\n    37\t        compact(env)[\"grid9\"],\n    38\t        flush=True,\n    39\t    )\n    40\t\n    41\t\n    42\tdef run(root, name, entry_skip, actions):\n    43\t    child = replay(root, skips=(entry_skip,))\n    44\t    report((name, 0), child)\n    45\t    for index, action in enumerate(actions, 1):\n    46\t        child.step(*action) if isinstance(action, tuple) else child.step(action)\n    47\t        report((name, index, action), child)\n    48\t        if child.terminal() or int(child.levels_completed) >= 9:\n    49\t            break\n    50\t\n    51\t\n    52\tdef probe(env):\n    53\t    enter_level_9(env)\n    54\t    finish = (\n    55\t        *((6, 21, 33),) * 5,\n    56\t        (6, 27, 27),\n    57\t        4,\n    58\t        4,\n    59\t        4,\n    60\t        (6, 45, 33),\n    61\t        4,\n    62\t        (6, 51, 27),\n    63\t        4,\n    64\t        (6, 57, 27),\n    65\t        4,\n    66\t    )\n    67\t    run(env, \"NO_PRESTAGE\", 0, finish)\n    68\t    run(env, \"NO_FINAL_ENTRY_MOVE\", 5, finish)\n    69\t\n    70\t\n    71\tif __name__ == \"__main__\":\n    72\t    arena.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
