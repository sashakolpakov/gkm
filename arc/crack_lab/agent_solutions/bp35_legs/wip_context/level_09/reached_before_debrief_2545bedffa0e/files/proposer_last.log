ted) + 1,\n    27\t        \"avatars\",\n    28\t        avatars,\n    29\t        \"controls\",\n    30\t        controls(env),\n    31\t        \"state\",\n    32\t        compact(env),\n    33\t        \"objects\",\n    34\t        objects(env),\n    35\t    )\n    36\t\n    37\t\n    38\tdef probe(env):\n    39\t    enter_level_9(env)\n    40\t    sequences = {\n    41\t        \"DIRECT\": (),\n    42\t        \"ROW7\": ((6, 57, 45),),\n    43\t        \"UP1\": ((6, 57, 45), (6, 57, 39)),\n    44\t        \"UP2\": ((6, 57, 45), (6, 57, 39), (6, 57, 33)),\n    45\t        \"C8_THEN_C9\": ((6, 51, 45), (6, 57, 45)),\n    46\t    }\n    47\t    for name, prefix in sequences.items():\n    48\t        child = root_lane8(env)\n    49\t        for action in prefix:\n    50\t            child.step(*action)\n    51\t        report((name, \"STAGED\"), child)\n    52\t        child.step(4)\n    53\t        report((name, \"ENTER\"), child)\n    54\t        if child.terminal():\n    55\t            continue\n    56\t        for action in ((6, 57, 33), (6, 57, 39), (6, 57, 45)):\n    57\t            branch = child.clone()\n    58\t            branch.step(*action)\n    59\t            report((name, \"VERTICAL\", action), branch)\n    60\t\n    61\t\n    62\tif __name__ == \"__main__\":\n    63\t    arena.run_program(\"bp35\", probe)\n     1\t\"\"\"Climb the staged exterior column-nine shaft after the early flip.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\tfrom perception import connected_components\n     9\tfrom probe_l9_control_row import compact, controls\n    10\tfrom probe_l9_lane8_early_flip_exit import root_lane8\n    11\tfrom probe_l9_route_deletions import enter_level_9\n    12\t\n    13\t\n    14\tdef goals(env):\n    15\t    return tuple(\n    16\t        (blob.bbox, blob.area)\n    17\t        for blob in connected_components(env.frame(), colors=(7