{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/zsh -lc \"nl -ba perception.py | sed -n '1,18p;39,45p;113,153p;164,233p'\"","aggregated_output":"     1\t\"\"\"Source-free frame perception helpers for cracking.\n     2\t\n     3\tThis module is deliberately observational: it derives compact symbolic state\n     4\tfrom `env.frame()` and `env.clone()` only. It is a cofibration-style scaffold:\n     5\traw pixels are embedded into a monotone tower of reusable observations\n     6\t(components -> objects -> action deltas -> replay states). Candidate level\n     7\tlogic should be written against these quotients, then replay-validated by the\n     8\tharness. No game source or prior solution history is read here.\n     9\t\"\"\"\n    10\tfrom collections import deque\n    11\tfrom dataclasses import dataclass\n    12\tfrom typing import Dict, Iterable, List, Optional, Sequence, Tuple\n    13\t\n    14\timport numpy as np\n    15\t\n    16\tUP, DOWN, LEFT, RIGHT, USE = 1, 2, 3, 4, 5\n    17\tACTIONS = (UP, DOWN, LEFT, RIGHT, USE)\n    18\tDIRS = {UP: (-1, 0), DOWN: (1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\n    39\tdef arr(frame) -> np.ndarray:\n    40\t    return np.asarray(frame)\n    41\t\n    42\t\n    43\tdef color_counts(frame) -> Dict[int, int]:\n    44\t    vals, cnts = np.unique(arr(frame), return_counts=True)\n    45\t    return {int(v): int(c) for v, c in zip(vals, cnts)}\n   113\tdef frame_delta(before, after) -> dict:\n   114\t    a, b = arr(before), arr(after)\n   115\t    ys, xs = np.where(a != b)\n   116\t    if len(ys) == 0:\n   117\t        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n   118\t    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n   119\t    return {\n   120\t        \"count\": int(len(ys)),\n   121\t        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n   122\t        \"samples\": samples,\n   123\t    }\n   124\t\n   125\t\n   126\tdef action_deltas(env, actions: Sequence[int] = ACTIONS) -> Dict[int, dict]:\n   127\t    base = arr(env.frame()).copy()\n   128\t    out = {}\n   129\t    for action in actions:\n   130\t        clone = env.clone()\n   131\t        clone.step(action)\n   132\t        out[int(action)] = frame_delta(base, clone.frame())\n   133\t    return out\n   134\t\n   135\t\n   136\tdef replay(env, actions: Sequence[int]):\n   137\t    clone = env.clone()\n   138\t    for action in actions:\n   139\t        if clone.terminal():\n   140\t            break\n   141\t        clone.step(int(action))\n   142\t    return clone\n   143\t\n   144\t\n   145\tdef path_result(env, actions: Sequence[int]) -> dict:\n   146\t    clone = replay(env, actions)\n   147\t    return {\n   148\t        \"levels_completed\": int(clone.levels_completed),\n   149\t        \"terminal\": bool(clone.terminal()),\n   150\t        \"path_len\": len(actions),\n   151\t        \"colors\": color_counts(clone.frame()),\n   152\t        \"objects\": object_candidates(clone.frame()),\n   153\t    }\n   164\tdef bounded_bfs(env, goal_fn, actions: Sequence[int] = (UP, DOWN, LEFT, RIGHT, USE),\n   165\t                key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   166\t    \"\"\"Generic clone BFS over observational keys. Use small max_states first.\"\"\"\n   167\t    if key_fn is None:\n   168\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   169\t    start_key = key_fn(env)\n   170\t    q = deque([(env.clone(), [])])\n   171\t    seen = {start_key}\n   172\t    while q and len(seen) <= max_states:\n   173\t        node, path = q.popleft()\n   174\t        if goal_fn(node, path):\n   175\t            return path\n   176\t        if len(path) >= max_depth:\n   177\t            continue\n   178\t        for action in actions:\n   179\t            child = node.clone()\n   180\t            child.step(int(action))\n   181\t            key = key_fn(child)\n   182\t            if key in seen:\n   183\t                continue\n   184\t            seen.add(key)\n   185\t            q.append((child, path + [int(action)]))\n   186\t    return None\n   187\t\n   188\t\n   189\tdef bounded_replay_bfs(env, goal_fn, action_fn,\n   190\t                       key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   191\t    \"\"\"Path-only BFS for games whose deep Arena clones become expensive.\n   192\t\n   193\t    The queue retains compact action paths, not recursively deep-copied runtime\n   194\t    states. Each node is reconstructed from one root clone. ``action_fn(node)``\n   195\t    may return integer actions or coordinate tuples such as ``(6, x, y)``.\n   196\t    \"\"\"\n   197\t    if key_fn is None:\n   198\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   199\t\n   200\t    def reconstruct(path):\n   201\t        node = env.clone()\n   202\t        for action in path:\n   203\t            if isinstance(action, tuple):\n   204\t                node.step(*action)\n   205\t            else:\n   206\t                node.step(int(action))\n   207\t        return node\n   208\t\n   209\t    start = reconstruct([])\n   210\t    q = deque([[]])\n   211\t    seen = {key_fn(start)}\n   212\t    while q and len(seen) <= max_states:\n   213\t        path = q.popleft()\n   214\t        node = reconstruct(path)\n   215\t        if goal_fn(node, path):\n   216\t            return path\n   217\t        if len(path) >= max_depth or node.terminal():\n   218\t            continue\n   219\t        for action in action_fn(node):\n   220\t            child_path = path + [action]\n   221\t            child = reconstruct(child_path)\n   222\t            key = key_fn(child)\n   223\t            if key in seen:\n   224\t                continue\n   225\t            seen.add(key)\n   226\t            if goal_fn(child, child_path):\n   227\t                return child_path\n   228\t            q.append(child_path)\n   229\t    return None\n   230\t\n   231\t\n   232\tdef level_goal(base_level: int):\n   233\t    return lambda env, path: env.levels_completed > base_level\n","exit_code":0,"status":"completed"}}
