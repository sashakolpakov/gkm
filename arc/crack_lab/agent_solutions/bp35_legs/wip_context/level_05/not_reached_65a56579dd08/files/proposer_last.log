{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"nl -ba legs.py | sed -n '49,142p'\"","aggregated_output":"    49\tdef cell_symbol(color):\n    50\t    \"\"\"Classify one raw colour into the terrain alphabet.\"\"\"\n    51\t    color = int(color)\n    52\t    if color in WALL_COLORS:\n    53\t        return WALL\n    54\t    if color in OPEN_COLORS:\n    55\t        return OPEN\n    56\t    if color in BLOCK_COLORS:\n    57\t        return BLOCK\n    58\t    if color in AVATAR_COLORS:\n    59\t        return AVATAR\n    60\t    return PRIZE\n    61\t\n    62\t\n    63\tdef band_grid(frame):\n    64\t    \"\"\"Quantise a frame onto the 6px band lattice as a symbolic grid.\"\"\"\n    65\t    return [[cell_symbol(frame[r][c]) for c in COL_ANCHORS] for r in ROW_ANCHORS]\n    66\t\n    67\t\n    68\tdef avatar_column(frame):\n    69\t    \"\"\"Column index of the avatar on its fixed band row, or None if gone.\"\"\"\n    70\t    row = band_grid(frame)[AVATAR_ROW]\n    71\t    for j, sym in enumerate(row):\n    72\t        if sym == AVATAR:\n    73\t            return j\n    74\t    return None\n    75\t\n    76\t\n    77\tdef moves_used(frame):\n    78\t    \"\"\"Actions consumed so far, read off the counter strip in row 63.\"\"\"\n    79\t    return sum(1 for v in frame[63] if int(v) != 0)\n    80\t\n    81\t\n    82\tdef find_symbol(grid, symbol, row=None):\n    83\t    \"\"\"All (i, j) cells carrying ``symbol``; optionally restricted to a row.\"\"\"\n    84\t    rows = range(GRID_ROWS) if row is None else (row,)\n    85\t    return [(i, j) for i in rows for j in range(GRID_COLS) if grid[i][j] == symbol]\n    86\t\n    87\t\n    88\tdef band_shift(before, after):\n    89\t    \"\"\"Bands the camera scrolled between two frames, i.e. the height gained.\n    90\t\n    91\t    The camera pins the avatar to ``AVATAR_ROW``, so a rise shows up only as\n    92\t    the world sliding down. Scored by how many raw rows line up at each\n    93\t    candidate offset, which tolerates the cells the avatar itself repainted.\n    94\t    \"\"\"\n    95\t    rows_before = [tuple(int(v) for v in before[r]) for r in range(63)]\n    96\t    rows_after = [tuple(int(v) for v in after[r]) for r in range(63)]\n    97\t    best_hits, best = -1, 0\n    98\t    for bands in range(GRID_ROWS):\n    99\t        offset = BAND * bands\n   100\t        hits = sum(1 for r in range(63 - offset)\n   101\t                   if rows_before[r] == rows_after[r + offset])\n   102\t        if hits > best_hits:\n   103\t            best_hits, best = hits, bands\n   104\t    return best\n   105\t\n   106\t\n   107\t# --- action legs ------------------------------------------------------\n   108\t\n   109\tdef click_cell(env, i, j):\n   110\t    \"\"\"Click band cell (i, j); removes a removable block, else burns a move.\"\"\"\n   111\t    env.step(CLICK, COL_ANCHORS[j], ROW_ANCHORS[i])\n   112\t\n   113\t\n   114\tdef act(env, action, log=None):\n   115\t    \"\"\"Apply one action tuple -- ``(key,)`` or ``(CLICK, x, y)`` -- and record it.\"\"\"\n   116\t    env.step(*action)\n   117\t    if log is not None:\n   118\t        log.append(action)\n   119\t\n   120\t\n   121\tdef run_actions(env, actions):\n   122\t    \"\"\"Replay a recorded action list, stopping early if the episode ends.\"\"\"\n   123\t    for action in actions:\n   124\t        if env.terminal():\n   125\t            return False\n   126\t        env.step(*action)\n   127\t    return True\n   128\t\n   129\t\n   130\tdef plan_and_commit(env, search_leg, **search_options):\n   131\t    \"\"\"Find an action route on clones, then commit it on the real environment.\"\"\"\n   132\t    base_level = env.levels_completed\n   133\t    actions = search_leg(env, **search_options)\n   134\t    if not actions:\n   135\t        return False\n   136\t    run_actions(env, actions)\n   137\t    return env.levels_completed > base_level\n   138\t\n   139\t\n   140\tdef click_action(i, j):\n   141\t    \"\"\"The action tuple that clicks band cell (i, j).\"\"\"\n   142\t    return (CLICK, COL_ANCHORS[j], ROW_ANCHORS[i])\n","exit_code":0,"status":"completed"}}
