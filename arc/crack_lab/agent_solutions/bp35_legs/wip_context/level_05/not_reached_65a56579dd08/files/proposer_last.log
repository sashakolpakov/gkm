{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_level5.py | sed -n '1,220p'\"","aggregated_output":"     1\timport os\n     2\timport sys\n     3\t\n     4\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     5\t\n     6\timport gkm_arena as A\n     7\timport numpy as np\n     8\t\n     9\timport perception as P\n    10\timport players\n    11\t\n    12\t\n    13\tdef reach_level_five(env):\n    14\t    for level in range(1, 5):\n    15\t        getattr(players, f\"play_level_{level}\")(env)\n    16\t        if env.levels_completed != level:\n    17\t            print(\"advance_failed\", level, env.levels_completed)\n    18\t            return False\n    19\t    return True\n    20\t\n    21\t\n    22\tdef summary(frame):\n    23\t    blobs = P.connected_components(frame, min_area=4)\n    24\t    return {\n    25\t        \"colors\": P.color_counts(frame),\n    26\t        \"blobs\": [(b.color, b.bbox, b.area) for b in blobs],\n    27\t    }\n    28\t\n    29\t\n    30\tdef probe(env):\n    31\t    if not reach_level_five(env):\n    32\t        return\n    33\t    base = np.asarray(env.frame()).copy()\n    34\t    print(\"level\", env.levels_completed + 1, \"actions\", env.actions)\n    35\t    print(\"initial\", summary(base))\n    36\t    for action in (3, 4, 6, 7):\n    37\t        clone = env.clone()\n    38\t        try:\n    39\t            clone.step(action)\n    40\t            print(\n    41\t                \"key\",\n    42\t                action,\n    43\t                \"level\",\n    44\t                clone.levels_completed,\n    45\t                \"terminal\",\n    46\t                clone.terminal(),\n    47\t                \"delta\",\n    48\t                P.frame_delta(base, clone.frame()),\n    49\t            )\n    50\t        except Exception as exc:\n    51\t            print(\"key\", action, \"error\", type(exc).__name__, str(exc))\n    52\t\n    53\t\n    54\tif __name__ == \"__main__\":\n    55\t    A.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
