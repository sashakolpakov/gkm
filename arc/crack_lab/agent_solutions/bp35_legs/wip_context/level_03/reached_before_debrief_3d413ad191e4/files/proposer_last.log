{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/zsh -lc 'tail -n 110 probes3.py'","aggregated_output":"        f = node.frame()\n        out = [(3,), (4,)]\n        for i in (AVATAR_ROW - 1, AVATAR_ROW):\n            for j in range(GRID_COLS):\n                if int(f[ROW_ANCHORS[i]][COL_ANCHORS[j]]) in (12, 14, 15):\n                    out.append(click_action(i, j))\n        return out\n\n    tie = itertools.count()\n    root = env.clone()\n    for action in opening:\n        root.step(*action)\n    queue = [(-10, len(opening), next(tie), 10, opening)]\n    seen = {key(root, 10)}\n    best = (10, opening)\n    base = env.levels_completed\n    for n in range(int(expansions)):\n        if not queue:\n            break\n        _, _, _, height, path = heapq.heappop(queue)\n        node = env.clone()\n        for action in path:\n            node.step(*action)\n        for action in actions(node):\n            child = node.clone()\n            child.step(*action)\n            if child.levels_completed > base:\n                print(f'WIN expansions={n + 1} depth={len(path) + 1}')\n                print('actions =', path + [action])\n                return\n            if child.terminal() or avatar_column(child.frame()) is None:\n                continue\n            gained = height + band_shift(node.frame(), child.frame())\n            k = key(child, gained)\n            if k in seen:\n                continue\n            seen.add(k)\n            new_path = path + [action]\n            if gained > best[0]:\n                best = (gained, new_path)\n                print(f'best height={gained} depth={len(new_path)} expansions={n + 1}')\n                print('actions =', new_path)\n            heapq.heappush(queue, (-gained, len(new_path), next(tie),\n                                   gained, new_path))\n    print(f'NO WIN states={len(seen)} best_height={best[0]} depth={len(best[1])}')\n    print('actions =', best[1])\n\n\n@probe\ndef tight_search(env, expansions='4000'):\n    \"\"\"Replay search using only clicks at/next to the avatar.\"\"\"\n    import heapq\n    import itertools\n\n    def key(node, height):\n        f = node.frame()\n        return (height, moves_used(f), avatar_column(f),\n                tuple(cell_area(f, i, j)\n                      for i in range(GRID_ROWS) for j in range(GRID_COLS)))\n\n    def actions(node):\n        f = node.frame()\n        col = avatar_column(f)\n        out = [(3,), (4,)]\n        if col is None:\n            return out\n        for i in (AVATAR_ROW - 1, AVATAR_ROW):\n            for j in range(max(0, col - 1), min(GRID_COLS, col + 2)):\n                if int(f[ROW_ANCHORS[i]][COL_ANCHORS[j]]) in (12, 14):\n                    out.append(click_action(i, j))\n        return out\n\n    tie = itertools.count()\n    root = env.clone()\n    base = env.levels_completed\n    queue = [(0, 0, next(tie), 0, ())]\n    seen = {key(root, 0)}\n    best = (0, ())\n    for n in range(int(expansions)):\n        if not queue:\n            break\n        _, _, _, height, path = heapq.heappop(queue)\n        node = root.clone()\n        for action in path:\n            node.step(*action)\n        for action in actions(node):\n            child = node.clone()\n            child.step(*action)\n            if child.levels_completed > base:\n                answer = path + (action,)\n                print(f'WIN expansions={n + 1} height={height} depth={len(answer)}')\n                print('actions =', list(answer))\n                return\n            if child.terminal() or avatar_column(child.frame()) is None:\n                continue\n            gained = height + band_shift(node.frame(), child.frame())\n            k = key(child, gained)\n            if k in seen:\n                continue\n            seen.add(k)\n            new_path = path + (action,)\n            if gained > best[0]:\n                best = (gained, new_path)\n                print(f'best height={gained} depth={len(new_path)} expansions={n + 1}',\n                      flush=True)\n                print('actions =', list(new_path), flush=True)\n            heapq.heappush(queue, (-gained, len(new_path), next(tie),\n                                   gained, new_path))\n    print(f'NO WIN states={len(seen)} best_height={best[0]} depth={len(best[1])}')\n    print('actions =', list(best[1]))\n","exit_code":0,"status":"completed"}}
