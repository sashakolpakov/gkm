 147\t            break\n   148\t\n   149\t\n   150\tarena.run_program(\"bp35\", probe)\n     1\t\"\"\"Fresh support-staging experiments across level 7's right-hand shaft.\"\"\"\n     2\t\n     3\timport json\n     4\timport os\n     5\timport sys\n     6\t\n     7\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     8\timport gkm_arena as arena\n     9\timport gkm_legs as campaign\n    10\t\n    11\tfrom legs import COL_ANCHORS, ROW_ANCHORS, _cell_shape, click_action\n    12\tfrom probe_l7_raw_search import SEED, avatar_position, target_path_distance\n    13\t\n    14\t\n    15\tif campaign._workspace_taint_reason(os.getcwd()):\n    16\t    raise SystemExit(\"tainted workspace\")\n    17\t\n    18\t\n    19\tPALETTE = {\n    20\t    0: \"v\", 3: \"#\", 5: \"D\", 7: \"T\", 8: \"g\", 9: \"A\",\n    21\t    10: \".\", 11: \"a\", 12: \"s\", 14: \"Y\", 15: \"h\",\n    22\t}\n    23\tENTRY = [(6, 3, 47), (4,), (4,), (3,)]\n    24\t\n    25\t\n    26\tdef cells(frame, colors):\n    27\t    return tuple(\n    28\t        (int(frame[y][x]), i, j, _cell_shape(frame, i, j)[1])\n    29\t        for i, y in enumerate(ROW_ANCHORS)\n    30\t        for j, x in enumerate(COL_ANCHORS)\n    31\t        if int(frame[y][x]) in colors\n    32\t    )\n    33\t\n    34\t\n    35\tdef lattice(frame):\n    36\t    return \"/\".join(\n    37\t        \"\".join(PALETTE.get(int(frame[y][x]), \"?\") for x in COL_ANCHORS)\n    38\t        for y in ROW_ANCHORS\n    39\t    )\n    40\t\n    41\t\n    42\tdef summary(node):\n    43\t    if node.terminal():\n    44\t        return (\"dead\", int(node.levels_completed))\n    45\t    frame = node.frame()\n    46\t    return (\n    47\t        \"alive\", int(node.levels_completed),\n    48\t        avatar_position(frame), target_path_distance(frame),\n    49\t        cells(frame, (0, 7, 12, 15)), lattice(frame),\n    50\t    )\n    51\t\n    52\t\n    53\tdef run(node, actions):\n    54\t    for action in actions:\n    55\t        node.step(*action)\n    56\t        if node.terminal() or node.levels_completed > 6:\n    57\t            break\n    58\t\n    59\t\n    60\tdef probe(env):\n    61\t    with open(\"checkpoint.json\") as stream:\n    62\t        for action in json.load(stream)[\"final_path\"]:\n    63\t            env.step(action)\n    64\t    run(env, [*SEED, (7,), (7,)])\n    65\t    root = env.clone()\n    66\t    print(\"ROOT\", summary(root))\n    67\t    top = root.clone()\n    68\t    for index, action in enumerate(ENTRY, 1):\n    69\t        top.step(*action)\n    70\t        print(\"ENTRY\", index, action, summary(top))\n    71\t        if top.terminal():\n    72\t            return\n    73\t\n    74\t    support_actions = [\n    75\t        click_action(i, j)\n    76\t        for color, i, j, area in cells(top.frame(), (12,))\n    77\t        if area <= 21\n    78\t    ]\n    79\t    print(\"SUPPORT_ACTIONS\", support_actions)\n    80\t    limit = int(os.environ.get(\"SUPPORT_LIMIT\", str(len(support_actions))))\n    81\t    for support in support_actions[:limit]:\n    82\t        for releases in (0, 1, 2, 3, 4, 5):\n    83\t            node = top.clone()\n    84\t            run(node, [support, *([(7,)] * releases)])\n    85\t            print(\"STAGE\", support, releases, summary(node))\n    86\t        returned = top.clone()\n    87\t        route = [support, *([(7,)] * 5), (4,), (4,)]\n    88\t        for index, action in enumerate(route, 1):\n    89\t            returned.step(*action)\n    90\t            print(\"DESCENT_STEP\", support, index, action, summary(returned))\n    91\t            if returned.terminal() or returned.levels_completed > 6:\n    92\t                break\n    93\t        print(\"DESCENT\", support, summary(returned))\n    94\t\n    95\t\n    96\tarena.run_program(\"bp35\", probe)\n     1\t\"\"\"Offset-independent best-first search from the verified level-7 entry.\"\"\"\n     2\t\n     3\timport heapq\n     4\timport itertools\n     5\timport json\n     6\timport os\n     7\timport sys\n     8\timport time\n     9\t\n    10\timport numpy as np\n    11\t\n    12\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n    13\timport gkm_arena as arena\n    14\t\n    15\tfrom legs import run_actions\n    16\tfrom perception import connected_components\n    17\t\n    18\t\n    19\tLEFT = (3,)\n    20\tRIGHT = (4,)\n    21\tDOWN_CLICK = 6\n    22\tALT_CLICK = 7\n    23\t\n    24\tSEED = [\n    25\t    RIGHT,\n    26\t    RIGHT,\n    27\t    RIGHT,\n    28\t    (6, 39, 51),\n    29\t    (6, 3, 3),\n    30\t    RIGHT,\n    31\t    (6, 3, 3),\n    32\t    RIGHT,\n    33\t    LEFT,\n    34\t    (7, 3, 3),\n    35\t    (7, 3, 3),\n    36\t    LEFT,\n    37\t    (6, 3, 9),\n    38\t    (6, 39, 35),\n    39\t    (7, 3, 5),\n    40\t    (6, 39, 35),\n    41\t    (6, 39, 17),\n    42\t    (6, 3, 5),\n    43\t    (6, 39, 33),\n    44\t    (6, 39, 51),\n    45\t    (6, 3, 15),\n    46\t    (6, 39, 5),\n    47\t    LEFT,\n    48\t    (6, 3, 11),\n    49\t    (6, 3, 39),\n    50\t    (6, 3, 23),\n    51\t    (6, 3, 51),\n    52\t    (6, 3, 35),\n    53\t    RIGHT,\n    54\t    (6, 3, 62),\n    55\t    (6, 39, 35),\n    56\t    (6, 3, 47),\n    57\t    (7, 45, 38),\n    58\t    (6, 3, 47),\n    59\t    (7, 45, 38),\n    60\t    (6, 39, 17),\n    61\t    (6, 3, 47),\n    62\t    (6, 39, 33),\n    63\t]\n    64\t\n    65\t\n    66\tdef avatar_position(frame):\n    67\t    pixels = np.asarray(frame)\n    68\t    ys, xs = np.where(pixels == 9)\n    69\t    if len(xs) == 0:\n    70\t        return None\n    71\t    return int(round(float(xs.mean()))), int(round(float(ys.mean())))\n    72\t\n    73\t\n    74\tdef control_target(frame):\n    75\t    controls = [\n    76\t        blob\n    77\t        for blob in connected_components(frame, colors=(8,), min_area=3)\n    78\t        if blob.bbox[1] <= 5 and blob.bbox[0] < 63\n    79\t    ]\n    80\t    if not controls:\n    81\t        return None\n    82\t    blob = controls[0]\n    83\t    return 3, int(round(blob.centroid[0]))\n    84\t\n    85\t\n    86\tdef support_targets(frame, ax, ay):\n    87\t    pixels = np.asarray(frame)\n    88\t    targets = set()\n    89\t    for y in range(1, 62):\n    90\t        for x in range(1, 63):\n    91\t            if (\n    92\t                int(pixels[y, x]) == 12\n    93\t                and abs(x - ax) <= 3\n    94\t                and abs(y - ay) <= 25\n    95\t                and all(\n    96\t                    int(pixels[y + dy, x + dx]) == 12\n    97\t                    for dy, dx in ((-1, -1), (-1, 1), (1, -1), (1, 1))\n    98\t                )\n    99\t                and all(\n   100\t                    int(pixels[y + dy, x + dx]) != 12\n   101\t                    for dy, dx in ((-1, 0), (1, 0), (0, -1), (0, 1))\n   102\t                )\n   103\t            ):\n   104\t                targets.add((x, y))\n   105\t    for blob in connected_components(frame, colors=(12, 14), min_area=6):\n   106\t        x = int(round(blob.centroid[1]))\n   107\t        y = int(round(blob.centroid[0]))\n   108\t        if abs(x - ax) <= 3 and abs(y - ay) <= 25:\n   109\t            targets.add((x, y))\n   110\t    return sorted(targets, key=lambda target: abs(target[1] - ay))\n   111\t\n   112\t\n   113\tdef choices(node):\n   114\t    frame = node.frame()\n   115\t    avatar = avatar_position(frame)\n   116\t    out = [LEFT, RIGHT, (ALT_CLICK, 0, 0)]\n   117\t    if avatar is None:\n   118\t        return out\n   119\t    ax, ay = avatar\n   120\t    control = control_target(frame)\n   121\t    if control is not None:\n   122\t        out.append((DOWN_CLICK, *control))\n   123\t    for x, y in support_targets(frame, ax, ay):\n   124\t        out.append((DOWN_CLICK, x, y))\n   125\t    return list(dict.fromkeys(out))\n   126\t\n   127\t\n   128\tdef state_key(node, phase):\n   129\t    return np.asarray(node.frame())[:63].tobytes(), phase\n   130\t\n   131\t\n   132\tdef target_distance(frame):\n   133\t    pixels = np.asarray(frame)\n   134\t    avatar = avatar_position(pixels)\n   135\t    ys, xs = np.where(pixels[:63] == 7)\n   136\t    if avatar is None or len(xs) == 0:\n   137\t        return None\n   138\t    ax, ay = avatar\n   139\t    tx = int(round(float(xs.mean())))\n   140\t    ty = int(round(float(ys.mean())))\n   141\t    return (abs(ax - tx) + abs(ay - ty) + 5) // 6\n   142\t\n   143\t\n   144\tdef target_path_distance(frame):\n   145\t    pixels = np.asarray(frame)\n   146\t    avatar = avatar_position(pixels)\n   147\t    ys, xs = np.where(pixels[:63] == 7)\n   148\t    if avatar is None or len(xs) == 0:\n   149\t        return None\n   150\t    ax, ay = avatar\n   151\t    row_centers = sorted(\n   152\t        ay + 6 * offset\n   153\t        for offset in range(-10, 11)\n   154\t        if 2 <= ay + 6 * offset <= 60\n   155\t    )\n   156\t    col_centers = [15 + 6 * column for column in range(8)]\n   157\t    start = (\n   158\t        row_centers.index(ay),\n   159\t        min(range(8), key=lambda column: abs(col_centers[column] - ax)),\n   160\t    )\n   161\t    tx = int(round(float(xs.mean())))\n   162\t    ty = int(round(float(ys.mean())))\n   163\t    target = (\n   164\t        min(range(len(row_centers)), key=lambda row: abs(row_centers[row] - ty)),\n   165\t        min(range(8), key=lambda column: abs(col_centers[column] - tx)),\n   166\t    )\n   167\t\n   168\t    def blocked(row, column):\n   169\t        if (row, column) == target:\n   170\t            return False\n   171\t        y, x = row_centers[row], col_centers[column]\n   172\t        patch = pixels[max(0, y - 3):min(63, y + 4), x - 3:x + 4]\n   173\t        return (\n   174\t            int(np.count_nonzero((patch == 3) | (patch == 5))) >= 10\n   175\t            or int(np.count_nonzero(patch == 12)) >= 10\n   176\t            or int(np.count_nonzero(patch == 15)) >= 3\n   177\t        )\n   178\t\n   179\t    queue = [(start, 0)]\n   180\t    seen = {start}\n   181\t    for (row, column), distance in queue:\n   182\t        if (row, column) == target:\n   183\t            return distance\n   184\t        for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n   185\t            cell = row + dr, column + dc\n   186\t            if (\n   187\t                0 <= cell[0] < len(row_centers)\n   188\t                and 0 <= cell[1] < 8\n   189\t                and cell not in seen\n   190\t                and not blocked(*cell)\n   191\t            ):\n   192\t                seen.add(cell)\n   193\t                queue.append((cell, distance + 1))\n   194\t    return len(row_centers) + 8\n   195\t\n   196\t\n   197\tdef search(env, max_states=1800, max_depth=120):\n   198\t    run_actions(env, SEED)\n   199\t    base_level = int(env.levels_completed)\n   200\t    root = env.clone()\n   201\t    counter = itertools.count()\n   202\t    root_distance = target_path_distance(root.frame())\n   203\t    root_heuristic = 8 if root_distance is None else root_distance\n   204\t    frontier = [(0, 0, next(counter), root_distance, (), 0)]\n   205\t    seen = {state_key(root, 0)}\n   206\t    started = time.monotonic()\n   207\t    best_distance = root_distance\n   208\t    for expanded in range(1, max_states + 1):\n   209\t        if not frontier:\n   210\t            break\n   211\t        _priority, _depth, _tie, distance, path, phase = heapq.heappop(frontier)\n   212\t        node = root.clone()\n   213\t        run_actions(node, path)\n   214\t        if len(path) >= max_depth or node.terminal():\n   215\t            continue\n   216\t        before = np.asarray(node.frame()).copy()\n   217\t        for action in choices(node):\n   218\t            child = node.clone()\n   219\t            child.step(*action)\n   220\t            if child.levels_completed > base_level:\n   221\t                route = list(SEED + list(path) + [action])\n   222\t                print(\n   223\t                    {\n   224\t                        \"found\": True,\n   225\t                        \"expanded\": expanded,\n   226\t                        \"seconds\": round(time.monotonic() - started, 3),\n   227\t                        \"route_len\": len(route),\n   228\t                        \"route\": route,\n   229\t                    },\n   230\t                    flush=True,\n   231\t                )\n   232\t                return route\n   233\t            if child.terminal() or avatar_position(child.frame()) is None:\n   234\t                continue\n   235\t            changed = not np.array_equal(before[:63], np.asarray(child.frame())[:63])\n   236\t            control = action[0] == DOWN_CLICK and len(action) == 3 and action[1] <= 5\n   237\t            if action[0] == ALT_CLICK:\n   238\t                new_phase = 0\n   239\t            else:\n   240\t                new_phase = phase ^ bool(control and changed)\n   241\t            child_frame = np.asarray(child.frame())\n   242\t            new_distance = target_path_distance(child_frame)\n   243\t            key = state_key(child, new_phase)\n   244\t            if key in seen:\n   245\t                continue\n   246\t            seen.add(key)\n   247\t            new_path = path + (action,)\n   248\t            heapq.heappush(\n   249\t                frontier,\n   250\t                (\n   251\t                    len(new_path),\n   252\t                    len(new_path),\n   253\t                    next(counter),\n   254\t                    new_distance,\n   255\t                    new_path,\n   256\t                    new_phase,\n   257\t                ),\n   258\t            )\n   259\t            if new_distance is not None and (\n   260\t                best_distance is None or new_distance < best_distance\n   261\t            ):\n   262\t                best_distance = new_distance\n   263\t                best_route = list(SEED) + list(new_path)\n   264\t                print(\n   265\t                    {\n   266\t                        \"target_distance\": best_distance,\n   267\t                        \"expanded\": expanded,\n   268\t                        \"depth\": len(new_path),\n   269\t                        \"frontier\": len(frontier),\n   270\t                        \"seconds\": round(time.monotonic() - started, 3),\n   271\t                        \"route\": best_route,\n   272\t                    },\n   273\t                    flush=True,\n   274\t                )\n   275\t        if expanded % 100 == 0:\n   276\t            print(\n   277\t                {\n   278\t                    \"expanded\": expanded,\n   279\t                    \"best_distance\": best_distance,\n   280\t                    \"frontier\": len(frontier),\n","exit_code":0,"status":"completed"}}
