insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     8\timport gkm_arena as arena\n     9\timport gkm_legs as campaign\n    10\t\n    11\tfrom probe_level7_coordinate_decode import advance\n    12\tfrom probe_level7_decoded_stage import decoded_route\n    13\tfrom probe_level7_reward_recovery import controls\n    14\t\n    15\t\n    16\tif campaign._workspace_taint_reason(os.getcwd()):\n    17\t    raise SystemExit(\"tainted workspace\")\n    18\t\n    19\t\n    20\tdef probe(env):\n    21\t    with open(\"checkpoint.json\") as stream:\n    22\t        prefix = json.load(stream)[\"final_path\"]\n    23\t    for action in prefix:\n    24\t        env.step(action)\n    25\t    route = decoded_route()\n    26\t    for boundary in range(len(route) + 1):\n    27\t        candidate = [*route[:boundary], (7,), *route[boundary:]]\n    28\t        node = env.clone()\n    29\t        advance(node, [*candidate, (3,), (3,), (3,), (3,)])\n    30\t        if node.levels_completed > 6:\n    31\t            print(\"RELEASE_WIN_BEFORE\", boundary, candidate, flush=True)\n    32\t            return\n    33\t        if node.terminal():\n    34\t            continue\n    35\t        for y in controls(node.frame()):\n    36\t            child = node.clone()\n    37\t            child.step(6, 3, y)\n    38\t            if child.levels_completed > 6:\n    39\t                print(\n    40\t                    \"RELEASE_WIN\",\n    41\t                    boundary,\n    42\t                    y,\n    43\t                    [\n    44\t                        *candidate,\n    45\t                        (3,), (3,), (3,), (3,), (6, 3, y),\n    46\t                    ],\n    47\t                    flush=True,\n    48\t                )\n    49\t                return\n    50\t        if boundary % 10 == 0:\n    51\t            print(\"RELEASE_CHECKED\", boundary, flush=True)\n    52\t    print(\"NO_RELEASE_WIN\", len(route) + 1, flush=True)\n    53\t\n    54\t\n    55\tlevels, replay, error = arena.run_program(\"bp35\", probe)\n    56\tprint(\"RESULT\", levels, len(replay), error)\n     1\t\"\"\"Test one omitted visible gravity click at each decoded-route boundary.\"\"\"\n     2\t\n     3\timport json\n     4\timport os\n     5\timport sys\n     6\t\n     7\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     8\timport gkm_arena as arena\n     9\timport gkm_legs as campaign\n    10\t\n    11\tfrom probe_level7_coordinate_decode import advance\n    12\tfrom probe_level7_decoded_stage import decoded_route\n    13\tfrom probe_level7_reward_recovery import controls\n    14\t\n    15\t\n    16\tif campaign._workspace_taint_reason(os.getcwd()):\n    17\t    raise SystemExit(\"tainted workspace\")\n    18\t\n    19\t\n    20\tdef probe(env):\n    21\t    with open(\"checkpoint.json\") as stream:\n    22\t        prefix = json.load(stream)[\"final_path\"]\n    23\t    for action in prefix:\n    24\t        env.step(action)\n    25\t    route = decoded_route()\n    26\t    tracker = env.clone()\n    27\t    tested = 0\n    28\t    for boundary in range(len(route) + 1):\n    29\t        visible_all = (\n    30\t            controls(tracker.frame()) if not tracker.terminal() else []\n    31\t        )\n    32\t        visible = [max(visible_all)] if visible_all else []\n    33\t        for y in visible:\n    34\t            tested += 1\n    35\t            candidate = [\n    36\t                *route[:boundary], (6, 3, y), *route[boundary:]\n    37\t            ]\n    38\t            node = env.clone()\n    39\t            advance(node, [*candidate, (3,), (3,), (3,), (3,)])\n    40\t            if node.levels_completed > 6:\n    41\t                print(\n    42\t                    \"CONTROL_WIN_BEFORE\", boundary, y, candidate, flush=True\n    43\t                )\n    44\t                return\n    45\t            if node.terminal():\n    46\t                continue\n    47\t            for final_y in controls(node.frame()):\n    48\t                child = node.clone()\n    49\t                child.step(6, 3, final_y)\n    50\t                if child.levels_completed > 6:\n    51\t                    print(\n    52\t                        \"CONTROL_WIN\",\n    53\t                        boundary,\n    54\t                        y,\n    55\t                        final_y,\n    56\t                        [\n    57\t                            *candidate,\n    58\t                            (3,), (3,), (3,), (3,),\n    59\t                            (6, 3, final_y),\n    60\t                        ],\n    61\t                        flush=True,\n    62\t                    )\n    63\t                    return\n    64\t        if boundary < len(route) and not tracker.terminal():\n    65\t            tracker.step(*route[boundary])\n    66\t        if boundary % 10 == 0:\n    67\t            print(\"CONTROL_CHECKED\", boundary, tested, flush=True)\n    68\t    print(\"NO_CONTROL_WIN\", tested, flush=True)\n    69\t\n    70\t\n    71\tlevels, replay, error = arena.run_program(\"bp35\", probe)\n    72\tprint(\"RESULT\", levels, len(replay), error)\n     1\t\"\"\"Test the two flanking stage hazards as the omitted setup interaction.\"\"\"\n     2\t\n     3\timport json\n     4\timport os\n     5\timport sys\n     6\t\n     7\timport numpy as np\n     8\t\n     9\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n    10\timport gkm_arena as arena\n    11\timport gkm_legs as campaign\n    12\t\n    13\tfrom legs import ROW_ANCHORS, run_actions\n    14\tfrom perception import connected_components, frame_delta\n    15\t\n    16\t\n    17\tif campaign._workspace_taint_reason(os.getcwd()):\n    18\t    raise SystemExit(\"tainted workspace\")\n    19\t\n    20\t\n    21\tdef staged_route():\n    22\t    with open(\"frontier_scaffold.json\") as stream:\n    23\t        source = json.load(stream)[\"staged_prefix_actions\"]\n    24\t    return [\n    25\t        (action,)\n    26\t        if isinstance(action, int)\n    27\t        else (\n    28\t            (action[0], action[1] + 12, action[2])\n    29\t            if action[1] != 3\n    30\t            else tuple(action)\n    31\t        )\n    32\t        for action in source\n    33\t    ]\n    34\t\n    35\t\n    36\tdef avatar(frame):\n    37\t    pixels = np.asarray(frame)\n    38\t    ys, xs = np.where(pixels == 9)\n    39\t    return None if not len(xs) else (round(float(xs.mean())), round(float(ys.mean())))\n    40\t\n    41\t\n    42\tdef hazard_key(frame):\n    43\t    return tuple(\n    44\t        (blob.bbox, blob.area)\n    45\t        for blob in connected_components(frame, colors=(15,), min_area=2)\n    46\t        if blob.bbox[0] < 63\n    47\t    )\n    48\t\n    49\t\n    50\tdef probe(env):\n    51\t    with open(\"checkpoint.json\") as stream:\n    52\t        prefix = json.load(stream)[\"final_path\"]\n    53\t    for action in prefix:\n    54\t        env.step(action)\n    55\t    base_level = int(env.levels_completed)\n    56\t    run_actions(env, staged_route())\n    57\t    base_frame = env.frame()\n    58\t    hazards = [\n    59\t        blob\n    60\t        for blob in connected_components(base_frame, colors=(15,), min_area=2)\n    61\t        if blob.bbox[0] < 63\n    62\t    ]\n    63\t    points = set()\n    64\t    for blob in hazards:\n    65\t        r0, c0, r1, c1 = blob.bbox\n    66\t        points.update(\n    67\t            (x, y)\n    68\t            for y in range(r0 - 1, r1 + 2)\n    69\t            for x in range(c0 - 1, c1 + 2)\n    70\t        )\n    71\t\n    72\t    for action in (6, 7):\n    73\t        for x, y in sorted(points):\n    74\t            node = env.clone()\n    75\t            node.step(action, x, y)\n    76\t            changed_hazard = hazard_key(node.frame()) != hazard_key(base_frame)\n    77\t            delta = frame_delta(base_frame, node.frame())[\"count\"]\n    78\t            positions = [avatar(node.frame())]\n    79\t            for _ in range(4):\n    80\t                node.step(3)\n    81\t                positions.append(avatar(node.frame()))\n    82\t            outcomes = []\n    83\t            for switch_y in [\n    84\t                row for row in ROW_ANCHORS if int(node.frame()[row][3]) == 8\n    85\t            ]:\n    86\t                branch = node.clone()\n    87\t                branch.step(6, 3, switch_y)\n    88\t                outcomes.append(\n    89\t                    (\n    90\t                        switch_y,\n    91\t                        int(branch.levels_completed) - base_level,\n    92\t                        bool(branch.terminal()),\n    93\t                        avatar(branch.frame()),\n    94\t                    )\n    95\t                )\n    96\t            if changed_hazard or delta > 1 or any(outcome[1] for outcome in outcomes):\n    97\t                print(\n    98\t                    \"TRY\",\n    99\t                    (action, x, y),\n   100\t                    delta,\n   101\t                    changed_hazard,\n   102\t                    positions,\n   103\t                    outcomes,\n   104\t                )\n   105\t\n   106\t\n   107\tlevels, path, err = arena.run_program(\"bp35\", probe)\n   108\tprint(\"RESULT\", levels, len(path), err)\n","exit_code":0,"status":"completed"}}
