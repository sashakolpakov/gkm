4\t        (i, j)\n    55\t        for i, y in enumerate(ROW_ANCHORS)\n    56\t        for j, x in enumerate(COL_ANCHORS)\n    57\t        if int(frame[y][x]) in (12, 14)\n    58\t    ]\n    59\t\n    60\t\n    61\tdef choices(node):\n    62\t    frame = node.frame()\n    63\t    avatar = avatar_cell(frame)\n    64\t    if avatar is None:\n    65\t        return []\n    66\t    ai, aj = avatar\n    67\t    out = [(L, None), (R, None), ((7,), None)]\n    68\t    controls = [\n    69\t        blob for blob in connected_components(frame, colors=(8,), min_area=2)\n    70\t        if blob.bbox[0] < 63 and blob.bbox[1] <= 5\n    71\t    ]\n    72\t    if controls:\n    73\t        blob = min(\n    74\t            controls,\n    75\t            key=lambda item: abs(item.centroid[0] - ROW_ANCHORS[ai]),\n    76\t        )\n    77\t        y, x = blob.centroid\n    78\t        out.append(((6, round(x), round(y)), \"gravity\"))\n    79\t    frame_tag = zlib.crc32(np.asarray(frame)[:63, 6:].tobytes())\n    80\t    for i, j in support_cells(frame):\n    81\t        if abs(i - ai) <= 3 and abs(j - aj) <= 3:\n    82\t            token = (\"support\", frame_tag, i, j)\n    83\t            out.append(((6, COL_ANCHORS[j], ROW_ANCHORS[i]), token))\n    84\t    return out\n    85\t\n    86\t\n    87\tdef frame_key(frame):\n    88\t    return np.asarray(frame)[:63].tobytes()\n    89\t\n    90\t\n    91\tdef terrain_shift(before, after):\n    92\t    scored = []\n    93\t    for shift in range(-9, 10):\n    94\t        matches = mismatches = 0\n    95\t        for i, y in enumerate(ROW_ANCHORS):\n    96\t            other = i + shift\n    97\t            if not 0 <= other < 10:\n    98\t                continue\n    99\t            for x in COL_ANCHORS:\n   100\t                left = STATIC.get(int(before[y][x]))\n   101\t                right = STATIC.get(int(after[ROW_ANCHORS[other]][x]))\n   102\t                if left is None or right is None:\n   103\t                    continue\n   104\t                matches += left == right\n   105\t                mismatches += left != right\n   106\t        scored.append((matches - 3 * mismatches, matches, -abs(shift), shift))\n   107\t    shift = max(scored)[-1]\n   108\t    return -shift\n   109\t\n   110\t\n   111\tdef dense(frame, descent):\n   112\t    avatar, target = avatar_cell(frame), target_cell(frame)\n   113\t    if avatar is None:\n   114\t        return 0, 99, descent\n   115\t    if target is None:\n   116\t        return 0, 99, descent\n   117\t    distance = abs(avatar[0] - target[0]) + abs(avatar[1] - target[1])\n   118\t    return 1, distance, descent\n   119\t\n   120\t\n   121\tdef probe(env):\n   122\t    with open(\"checkpoint.json\") as stream:\n   123\t        checkpoint = json.load(stream)\n   124\t    for action in checkpoint[\"final_path\"]:\n   125\t        env.step(action)\n   126\t    for action in TOP_ROUTE:\n   127\t        env.step(*action)\n   128\t        if env.terminal():\n   129\t            print(\"TOP_ROUTE_FAILED\", action)\n   130\t            return\n   131\t\n   132\t    base_level = int(env.levels_completed)\n   133\t    root = env.clone()\n   134\t    # The last selectable action in TOP_ROUTE is a gravity-strip click.\n   135\t    root_selected = \"gravity\"\n   136\t    tie = itertools.count()\n   137\t    root_dense = dense(root.frame(), 0)\n   138\t    frontier = [((0, 0, 0, 0), next(tie), root, (), root_selected, frozenset(), 0)]\n   139\t    seen = {(frame_key(root.frame()), root_selected, frozenset())}\n   140\t    best = root_dense\n   141\t    expanded = 0\n   142\t    print(\n   143\t        \"TOP_ROOT\", avatar_cell(root.frame()), target_cell(root.frame()),\n   144\t        support_cells(root.frame()), root_dense,\n   145\t    )\n   146\t\n   147\t    while frontier and expanded < 900:\n   148\t        _, _, node, path, selected, toggled, descent = heapq.heappop(frontier)\n   149\t        if len(path) >= 28:\n   150\t            continue\n   151\t        before = np.asarray(node.frame()).copy()\n   152\t        for action, selection in choices(node):\n   153\t            child = node.clone()\n   154\t            child.step(*action)\n   155\t            expanded += 1\n   156\t            child_path = (*path, action)\n   157\t            if child.levels_completed > base_level:\n   158\t                print(\"TOP_WIN\", child_path, expanded, flush=True)\n   159\t                return\n   160\t            if child.terminal() or avatar_cell(child.frame()) is None:\n   161\t                continue\n   162\t\n   163\t            child_selected = selected if selection is None else selection\n   164\t            child_toggled = set(toggled)\n   165\t            if selection not in (None, \"gravity\"):\n   166\t                if selection in child_toggled:\n   167\t                    child_toggled.remove(selection)\n   168\t                else:\n   169\t                    child_toggled.add(selection)\n   170\t            elif action[0] == 7 and selected not in (None, \"gravity\"):\n   171\t                if selected in child_toggled:\n   172\t                    child_toggled.remove(selected)\n   173\t                else:\n   174\t                    child_toggled.add(selected)\n   175\t            child_toggled = frozenset(child_toggled)\n   176\t            child_descent = descent + terrain_shift(before, child.frame())\n   177\t            progress = dense(child.frame(), child_descent)\n   178\t            if (\n   179\t                progress[0] > best[0]\n   180\t                or progress[0] == best[0] and progress[1] < best[1]\n   181\t                or progress[:2] == best[:2] and progress[2] > best[2]\n   182\t            ):\n   183\t                best = progress\n   184\t                print(\n   185\t                    \"TOP_PROGRESS\", best, len(child_path),\n   186\t                    avatar_cell(child.frame()), target_cell(child.frame()),\n   187\t                    child_path, flush=True,\n   188\t                )\n   189\t            key = (frame_key(child.frame()), child_selected, child_toggled)\n   190\t            if key in seen:\n   191\t                continue\n   192\t            seen.add(key)\n   193\t            target_seen, target_distance, down = progress\n   194\t            priority = (\n   195\t                -target_seen,\n   196\t                target_distance,\n   197\t                -down,\n   198\t                len(child_path),\n   199\t            )\n   200\t            heapq.heappush(\n   201\t                frontier,\n   202\t                (priority, next(tie), child, child_path,\n   203\t                 child_selected, child_toggled, child_descent),\n   204\t            )\n   205\t            if expanded >= 900:\n   206\t                break\n   207\t        if expanded and expanded % 100 < len(choices(node)):\n   208\t            print(\"TOP_SEARCH\", expanded, len(frontier), len(seen), best, flush=True)\n   209\t    print(\"TOP_DONE\", expanded, len(frontier), len(seen), best)\n   210\t\n   211\t\n   212\tlevels, path, error = arena.run_program(\"bp35\", probe)\n   213\tprint(\"RESULT\", levels, len(path), error)\n     1\t\"\"\"Replay BFS with an explicit selected-object history token.\"\"\"\n     2\t\n     3\tfrom collections import deque\n     4\timport hashlib\n     5\timport json\n     6\timport os\n     7\timport sys\n     8\timport time\n     9\t\n    10\timport numpy as np\n    11\t\n    12\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n    13\timport gkm_arena as arena\n    14\t\n    15\tfrom legs import (\n    16\t    COL_ANCHORS, ROW_ANCHORS, _cell_shape, click_action, run_actions,\n    17\t)\n    18\tfrom perception import connected_components\n    19\tfrom probe_l7_frontier import BASE\n    20\tfrom probe_l7_raw_search import avatar_position, target_path_distance\n    21\t\n    22\t\n    23\tdef selection_token(frame, action):\n    24\t    digest = hashlib.blake2b(\n    25\t        np.asarray(frame)[:63].tobytes(), digest_size=8\n    26\t    ).digest()\n    27\t    return digest, action\n    28\t\n    29\t\n    30\tdef controls(frame, ay):\n    31\t    visible = [\n    32\t        blob\n    33\t        for blob in connected_components(frame, colors=(8,), min_area=3)\n    34\t        if blob.bbox[1] <= 5 and blob.bbox[0] < 63\n    35\t    ]\n    36\t    if not visible:\n    37\t        return []\n    38\t    blob = min(visible, key=lambda item: abs(item.centroid[0] - ay))\n    39\t    y, x = blob.centroid\n    40\t    return [(6, int(round(x)), int(round(y)))]\n    41\t\n    42\t\n    43\tdef choices(frame):\n    44\t    avatar = avatar_position(frame)\n    45\t    if avatar is None:\n    46\t        return []\n    47\t    ax, ay = avatar\n    48\t    ai = min(range(10), key=lambda i: abs(ROW_ANCHORS[i] - ay))\n    49\t    aj = min(range(8), key=lambda j: abs(COL_ANCHORS[j] - ax))\n    50\t    out = [(3,), (4,), (7,), *controls(frame, ay)]\n    51\t    for i in range(max(0, ai - 3), min(10, ai + 4)):\n    52\t        for j in range(max(0, aj - 1), min(8, aj + 2)):\n    53\t            if _cell_shape(frame, i, j)[0] in (12, 14):\n    54\t                out.append(click_action(i, j))\n    55\t    return list(dict.fromkeys(out))\n    56\t\n    57\t\n    58\tdef probe(env):\n    59\t    with open(\"checkpoint.json\") as stream:\n    60\t        checkpoint = json.load(stream)\n    61\t    for action in checkpoint[\"final_path\"]:\n    62\t        env.step(action)\n    63\t    run_actions(env, BASE)\n    64\t    base_level = int(env.levels_completed)\n    65\t    root = env.clone()\n    66\t    root_token = (\"base-selected\",)\n    67\t    root_key = (np.asarray(root.frame())[:63].tobytes(), root_token)\n    68\t    queue = deque([((), root_token)])\n    69\t    seen = {root_key}\n    70\t    expanded = 0\n    71\t    best_distance = target_path_distance(root.frame())\n    72\t    started = time.monotonic()\n    73\t    max_states = int(os.environ.get(\"MAX_STATES\", \"500\"))\n    74\t    max_depth = int(os.environ.get(\"MAX_DEPTH\", \"28\"))\n    75\t    while queue and expanded < max_states:\n    76\t        path, token = queue.popleft()\n    77\t        node = root.clone()\n    78\t        run_actions(node, path)\n    79\t        expanded += 1\n    80\t        if len(path) >= max_depth or node.terminal():\n    81\t            continue\n    82\t        before = np.asarray(node.frame()).copy()\n    83\t        for action in choices(before):\n    84\t            child = node.clone()\n    85\t            child.step(*action)\n    86\t            child_path = (*path, action)\n    87\t            if child.levels_completed > base_level:\n    88\t                route = [*BASE, *child_path]\n    89\t                print(\n    90\t                    \"SELECTED_FAST_WIN\", expanded, len(route), route,\n    91\t                    flush=True,\n    92\t                )\n    93\t                return\n    94\t            if child.terminal() or avatar_position(child.frame()) is None:\n    95\t                continue\n    96\t            child_token = (\n    97\t                selection_token(before, action)\n    98\t                if action[0] == 6 else token\n    99\t            )\n   100\t            child_frame = np.asarray(child.frame())\n   101\t            key = (child_frame[:63].tobytes(), child_token)\n   102\t            if key in seen:\n   103\t                continue\n   104\t            seen.add(key)\n   105\t            queue.append((child_path, child_token))\n   106\t            distance = target_path_distance(child_frame)\n   107\t            if distance is not None and (\n   108\t                best_distance is None or distance < best_distance\n   109\t            ):\n   110\t                best_distance = distance\n   111\t                print(\n   112\t                    \"SELECTED_FAST_TARGET\", distance, expanded,\n   113\t                    len(child_path), child_path, flush=True,\n   114\t                )\n   115\t        if expanded % 50 == 0:\n   116\t            print(\n   117\t                \"SELECTED_FAST_SEARCH\", expanded, len(queue), len(seen),\n   118\t                len(path), best_distance,\n   119\t                round(time.monotonic() - started, 1), flush=True,\n   120\t            )\n   121\t    print(\n   122\t        \"SELECTED_FAST_DONE\", expanded, len(queue), len(seen),\n   123\t        best_distance, flush=True,\n   124\t    )\n   125\t\n   126\t\n   127\tlevels, path, error = arena.run_program(\"bp35\", probe)\n   128\tprint(\"RESULT\", levels, len(path), error)\n     1\t\"\"\"Fresh-process graph search for level 7's selected-object gravity maze.\"\"\"\n     2\t\n     3\timport hashlib\n     4\timport heapq\n     5\timport itertools\n     6\timport json\n     7\timport os\n     8\timport subprocess\n     9\timport sys\n    10\timport time\n    11\t\n    12\timport numpy as np\n    13\t\n    14\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n    15\timport gkm_arena as arena\n    16\timport gkm_legs as G\n    17\t\n    18\tfrom legs import (\n    19\t    COL_ANCHORS, ROW_ANCHORS, _cell_shape, click_action,\n    20\t)\n    21\tfrom perception import connected_components\n    22\tfrom probe_l7_raw_search import SEED, avatar_position, target_path_distance\n    23\t\n    24\t\n    25\tif G._workspace_taint_reason(os.getcwd()):\n    26\t    raise SystemExit(\"tainted workspace\")\n    27\t\n    28\t\n    29\tGATE_ROOT = [\n    30\t    (6, 27, 15), (6, 27, 27), (6, 39, 27), (6, 33, 9),\n    31\t    (4,), (4,), (4,), (6, 39, 51), (6, 3, 3), (4,),\n    32\t]\n    33\tSTATIC = {3: \"#\", 5: \"#\", 10: \".\", 0: \"v\"}\n    34\t\n    35\t\n    36\tdef lattice(frame):\n    37\t    return [\n    38\t        [STATIC.get(int(frame[y][x])) for x in COL_ANCHORS]\n    39\t        for y in ROW_ANCHORS\n    40\t    ]\n    41\t\n    42\t\n    43\tdef alignment(world, frame_grid, previous):\n    44\t    candidates = []\n    45\t    for origin in range(previous - 10, previous + 11):\n    46\t        matches = mismatches = overlap = 0\n    47\t        for i, row in enumerate(frame_grid):\n    48\t            for j, value in enumerate(row):\n    49\t                known = world.get((origin + i, j))\n    50\t                if value is None or known is None:\n    51\t                    continue\n    52\t                overlap += 1\n    53\t                if value == known:\n    54\t                    matches += 1\n    55\t                else:\n    56\t                    mismatches += 1\n    57\t        candidates.append((\n    58\t            matches - 3 * mismatches, matches, overlap,\n    59\t            -abs(origin - previous), -abs(origin), origin,\n    60\t        ))\n    61\t    return max(candidates)[-1]\n    62\t\n    63\t\n    64\tdef merge(world, frame_grid, origin):\n    65\t    for i, row in enumerate(frame_grid):\n    66\t        for j, value in enumerate(row):\n    67\t            if value is not None:\n    68\t                world.setdefault((origin + i, j), value)\n    69\t\n    70\t\n    71\tdef signed_origin_delta(before, after):\n    72\t    \"\"\"Camera-origin change from adjacent raw frames, including descents.\"\"\"\n    73\t    old = [\n    74\t        tuple(int(value) for value in before[row])\n    75\t        for row in range(63)\n    76\t    ]\n    77\t    new = [\n    78\t        tuple(int(value) for value in after[row])\n    79\t        for row in range(63)\n    80\t    ]\n    81\t    candidates = []\n    82\t    for bands in range(-9, 10):\n    83\t        pixels = 6 * bands\n    84\t        start = max(0, -pixels)\n    85\t        stop = min(63, 63 - pixels)\n    86\t        hits = sum(\n    87\t            new[row] == old[row + pixels]\n    88\t            for row in range(start, stop)\n    89\t        )\n    90\t        candidates.append((hits, -abs(bands), bands))\n    91\t    return max(candidates)[-1]\n    92\t\n    93\t\n    94\tdef object_identity(frame, origin, action):\n    95\t    if action[0] != 6:\n    96\t        return None\n    97\t    _, x, y = action\n    98\t    i = min(range(10), key=lambda row: abs(ROW_ANCHORS[row] - y))\n    99\t    if x <= 5:\n   100\t        color = int(frame[y][x]) if 0 <= y < 63 else -1\n   101\t        return (\"gravity\", origin + i) if color == 8 else None\n   102\t    j = min(range(8), key=lambda col: abs(COL_ANCHORS[col] - x))\n   103\t    color = int(frame[y][x]) if 0 <= y < 63 and 0 <= x < 64 else -1\n   104\t    if color in (12, 14):\n   105\t        return (\"support\", origin + i, j)\n   106\t    return None\n   107\t\n   108\t\n   109\tdef available_actions(frame):\n   110\t    avatar = avatar_position(frame)\n   111\t    if avatar is None:\n   112\t        return []\n   113\t    ax, ay = avatar\n   114\t    ai = min(range(10), key=lambda i: abs(ROW_ANCHORS[i] - ay))\n   115\t    aj = min(range(8), key=lambda j: abs(COL_ANCHORS[j] - ax))\n   116\t    out = [(3,), (4,), (7,)]\n   117\t    crosses = [\n   118\t        blob\n   119\t        for blob in connected_components(frame, colors=(8,), min_area=3)\n   120\t        if blob.bbox[1] <= 5 and blob.bbox[0] < 63\n   121\t    ]\n   122\t    crosses.sort(key=lambda blob: abs(blob.centroid[0] - ay))\n   123\t    chosen = []\n   124\t    for blob in (\n   125\t        crosses[:1]\n   126\t        + ([] if not crosses else [min(crosses, key=lambda b: b.centroid[0])])\n   127\t        + ([] if not crosses else [max(crosses, key=lambda b: b.centroid[0])])\n   128\t    ):\n   129\t        y, x = blob.centroid\n   130\t        action = (6, int(round(x)), int(round(y)))\n   131\t        if action not in chosen:\n   132\t            chosen.append(action)\n   133\t    out.extend(chosen)\n   134\t    row_radius = 5 if os.environ.get(\"WIDE_SUPPORTS\") == \"1\" else 3\n   135\t    col_radius = 3 if os.environ.get(\"WIDE_SUPPORTS\") == \"1\" else 1\n   136\t    for i in range(max(0, ai - row_radius), min(10, ai + row_radius + 1)):\n   137\t        for j in range(max(0, aj - col_radius), min(8, aj + col_radius + 1)):\n   138\t            if _cell_shape(frame, i, j)[0] in (12, 14):\n   139\t                out.append(click_action(i, j))\n   140\t    return list(dict.fromkeys(out))\n   141\t\n   142\t\n   143\tdef worker(path):\n   144\t    observation = {}\n   145\t\n   146\t    def program(env):\n   147\t        with open(\"checkpoint.json\") as stream:\n   148\t            checkpoint = json.load(stream)\n   149\t        for action in checkpoint[\"final_path\"]:\n   150\t            env.step(action)\n   151\t        base_level = int(env.levels_completed)\n   152\t        world = {}\n   153\t        origin = 0\n   154\t        merge(world, lattice(env.frame()), origin)\n   155\t        selected = None\n   156\t        root_route = SEED if os.environ.get(\"ROOT_MODE\") == \"seed\" else GATE_ROOT\n   157\t        for action in [*root_route, *path]:\n   158\t            if env.terminal():\n   159\t                break\n   160\t            before = np.asarray(env.frame()).copy()\n   161\t            identity = object_identity(before, origin, action)\n   162\t            env.step(*action)\n   163\t            if identity is not None:\n   164\t                selected = identity\n   165\t            if env.levels_completed > base_level:\n   166\t                observation[\"win\"] = True\n   167\t                observation[\"origin\"] = origin\n   168\t                return\n   169\t            if env.terminal():\n   170\t                break\n   171\t            if os.environ.get(\"SIGNED_ORIGIN\") == \"1\":\n   172\t                origin += signed_origin_delta(before, env.frame())\n   173\t            else:\n   174\t                origin = alignment(world, lattice(env.frame()), origin)\n   175\t            merge(world, lattice(env.frame()), origin)\n   176\t        observation[\"win\"] = False\n   177\t        observation[\"terminal\"] = bool(env.terminal())\n   178\t        observation[\"origin\"] = origin\n   179\t        observation[\"selected\"] = selected\n   180\t        if env.terminal():\n   181\t            return\n   182\t        frame = np.asarray(env.frame())\n   183\t        avatar = avatar_position(frame)\n   184\t        ai = min(range(10), key=lambda i: abs(ROW_ANCHORS[i] - avatar[1]))\n   185\t        aj = min(range(8), key=lambda j: abs(COL_ANCHORS[j] - avatar[0]))\n   186\t        observation.update(\n   187\t            frame=hashlib.blake2b(\n   188\t                frame[:63].tobytes(), digest_size=16\n   189\t            ).hexdigest(),\n   190\t            avatar=(ai, aj),\n   191\t            world_row=origin + ai,\n   192\t            target_distance=target_path_distance(frame),\n   193\t            target=bool(np.any(frame[:63] == 7)),\n   194\t            actions=available_actions(frame),\n   195\t        )\n   196\t        if os.environ.get(\"TRACE_WORLD\") == \"1\":\n   197\t            rows = sorted({row for row, _ in world})\n   198\t            observation[\"world\"] = [\n   199\t                [\n   200\t                    row,\n   201\t                    \"\".join(world.get((row, column), \"?\") for column in range(8)),\n   202\t                ]\n   203\t                for row in rows\n   204\t            ]\n   205\t            observation[\"objects\"] = [\n   206\t                [\n   207\t                    blob.color,\n   208\t                    origin + min(\n   209\t                        range(10),\n   210\t                        key=lambda row: abs(\n   211\t                            ROW_ANCHORS[row] - blob.centroid[0]\n   212\t                        ),\n   213\t                    ),\n   214\t                    min(\n   215\t                        range(8),\n   216\t                        key=lambda column: abs(\n   217\t                            COL_ANCHORS[column] - blob.centroid[1]\n   218\t                        ),\n   219\t                    ),\n   220\t                    blob.area,\n   221\t                ]\n   222\t                for blob in connected_components(\n   223\t                    frame, colors=(7, 12, 14, 15), min_area=2\n   224\t                )\n   225\t                if blob.bbox[0] < 63\n   226\t            ]\n   227\t\n   228\t    levels, replay, error = arena.run_program(\"bp35\", program)\n   229\t    observation[\"levels\"] = levels\n   230\t    observation[\"moves\"] = len(replay)\n   231\t    observation[\"error\"] = error\n   232\t    print(json.dumps(observation, separators=(\",\", \":\")), flush=True)\n   233\t\n   234\t\n   235\tdef evaluate_many(paths, workers=4):\n   236\t    results = []\n   237\t    script = os.path.abspath(__file__)\n   238\t    process_env = dict(os.environ)\n   239\t    process_env[\"MPLCONFIGDIR\"] = \"/tmp/mpl-l7-direct\"\n   240\t    for start in range(0, len(paths), workers):\n   241\t        batch = paths[start:start + workers]\n   242\t        processes = [\n   243\t            subprocess.Popen(\n   244\t                [\n   245\t                    sys.executable, script, \"--worker\",\n   246\t                    json.dumps(path, separators=(\",\", \":\")),\n   247\t                ],\n   248\t                stdout=subprocess.PIPE,\n   249\t                stderr=subprocess.DEVNULL,\n   250\t                text=True,\n   251\t                env=process_env,\n   252\t            )\n   253\t            for path in batch\n   254\t        ]\n   255\t        for path, process in zip(batch, processes):\n   256\t            stdout, _ = process.communicate()\n   257\t            line = stdout.strip().splitlines()[-1] if stdout.strip() else \"\"\n   258\t            if not line:\n   259\t                results.append((path, {\"error\": \"worker produced no result\"}))\n   260\t                continue\n   261\t            results.append((path, json.loads(line)))\n   262\t    return results\n   263\t\n   264\t\n   265\tdef priority(path, observation):\n   266\t    avatar = observation[\"avatar\"]\n   267\t    gap = abs(12 - observation[\"world_row\"])\n   268\t    column_gap = abs(1 - avatar[1])\n   269\t    distance = observation[\"target_distance\"]\n   270\t    if os.environ.get(\"PRIORITY_MODE\") == \"topology\":\n   271\t        world_row = observation[\"world_row\"]\n   272\t        column = avatar[1]\n   273\t        if distance is not None and distance < 18:\n   274\t            return 0, distance, len(path)\n   275\t        if world_row >= 9:\n   276\t            return 1, -world_row, column_gap, len(path)\n   277\t        if world_row <= 2 and column >= 5:\n   278\t            return 2, abs(column - 6), len(path)\n   279\t        if 5 <= world_row <= 8:\n   280\t            return 3, abs(column - 6), len(path)\n","exit_code":0,"status":"completed"}}
