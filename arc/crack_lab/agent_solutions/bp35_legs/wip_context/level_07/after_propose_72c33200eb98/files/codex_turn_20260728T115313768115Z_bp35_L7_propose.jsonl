th open(\"checkpoint.json\") as stream:\n    37\t        checkpoint = json.load(stream)\n    38\t    for action in checkpoint[\"final_path\"]:\n    39\t        env.step(action)\n    40\t    with open(\"frontier_scaffold.json\") as stream:\n    41\t        raw_route = json.load(stream)[\"staged_prefix_actions\"]\n    42\t\n    43\t    outcomes = []\n    44\t    for shifted_late in itertools.product((False, True), repeat=len(AMBIGUOUS)):\n    45\t        shifted_steps = EARLY_SHIFTED | {\n    46\t            step\n    47\t            for step, shifted in zip(AMBIGUOUS, shifted_late)\n    48\t            if shifted\n    49\t        }\n    50\t        route = []\n    51\t        for step, item in enumerate(raw_route, 1):\n    52\t            action = (item,) if isinstance(item, int) else tuple(item)\n    53\t            if (\n    54\t                step in shifted_steps\n    55\t                and len(action) == 3\n    56\t                and action[1] != 3\n    57\t            ):\n    58\t                action = (action[0], action[1] + 12, action[2])\n    59\t            route.append(action)\n    60\t\n    61\t        node = env.clone()\n    62\t        height = advance(node, [*route, (3,), (3,), (3,), (3,)])\n    63\t        if node.levels_completed > 6:\n    64\t            print(\"WIN_BEFORE_SWITCH\", shifted_late, route, flush=True)\n    65\t            return\n    66\t        if node.terminal():\n    67\t            outcomes.append((False, height, shifted_late, None, ()))\n    68\t            continue\n    69\t        visible = [\n    70\t            y for y in ROW_ANCHORS if int(node.frame()[y][3]) == 8\n    71\t        ]\n    72\t        for y in visible:\n    73\t            child = node.clone()\n    74\t            child.step(6, 3, y)\n    75\t            if child.levels_completed > 6:\n    76\t                print(\n    77\t                    \"DECODE_WIN\", shifted_late, y,\n    78\t                    [*route, (3,), (3,), (3,), (3,), (6, 3, y)],\n    79\t                    flush=True,\n    80\t                )\n    81\t                return\n    82\t        outcomes.append(\n    83\t            (\n    84\t                True, height, shifted_late, avatar_cell(node.frame()),\n    85\t                tuple(controls(node.frame())),\n    86\t            )\n    87\t        )\n    88\t    outcomes.sort(\n    89\t        key=lambda item: (-item[0], -item[1], -len(item[4]), item[2])\n    90\t    )\n    91\t    print(\"NO_DECODE_WIN\", len(outcomes))\n    92\t    for outcome in outcomes:\n    93\t        print(\"DECODE\", outcome)\n    94\t\n    95\t\n    96\tif __name__ == \"__main__\":\n    97\t    levels, path, err = A.run_program(\"bp35\", probe)\n    98\t    print(\"RESULT\", levels, len(path), err)\n","exit_code":0,"status":"completed"}}
