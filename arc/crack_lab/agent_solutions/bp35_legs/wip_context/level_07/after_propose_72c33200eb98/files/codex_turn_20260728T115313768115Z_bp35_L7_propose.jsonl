t    palette = {\n   254\t        0: \"v\", 3: \"#\", 5: \"#\", 7: \"T\", 8: \"g\", 9: \"A\",\n   255\t        10: \".\", 11: \"a\", 12: \"s\", 14: \"Y\", 15: \"h\",\n   256\t    }\n   257\t    return \"/\".join(\n   258\t        \"\".join(palette.get(int(frame[y][x]), \"?\") for x in COL_ANCHORS)\n   259\t        for y in ROW_ANCHORS\n   260\t    )\n   261\t\n   262\t\n   263\tdef controls(frame):\n   264\t    return [\n   265\t        round(blob.centroid[0])\n   266\t        for blob in connected_components(frame, colors=(8,), min_area=2)\n   267\t        if blob.bbox[0] < 63 and blob.bbox[1] <= 5\n   268\t    ]\n   269\t\n   270\t\n   271\tdef support_shapes(frame):\n   272\t    out = []\n   273\t    for i, y in enumerate(ROW_ANCHORS):\n   274\t        for j, x in enumerate(COL_ANCHORS):\n   275\t            if int(frame[y][x]) != 12:\n   276\t                continue\n   277\t            r0, c0 = 6 * i, 13 + 6 * j\n   278\t            area = sum(\n   279\t                int(frame[r][c]) == 12\n   280\t                for r in range(r0, min(63, r0 + 6))\n   281\t                for c in range(c0, c0 + 6)\n   282\t            )\n   283\t            out.append((i, j, area))\n   284\t    return out\n   285\t\n   286\t\n   287\tdef run_variant(name, suffix):\n   288\t    result = {}\n   289\t\n   290\t    def probe(env):\n   291\t        with open(\"checkpoint.json\") as stream:\n   292\t            checkpoint = json.load(stream)\n   293\t        for action in checkpoint[\"final_path\"]:\n   294\t            env.step(action)\n   295\t        all_actions = [*TOP_ROUTE, *suffix]\n   296\t        for index, action in enumerate(all_actions, 1):\n   297\t            env.step(*action)\n   298\t            if name == \"bridge72_up\" and index > len(TOP_ROUTE):\n   299\t                print(\n   300\t                    \"TOP_STEP\", index - len(TOP_ROUTE), action,\n","exit_code":0,"status":"completed"}}
