       action = action[0], action[1] + 12, action[2]\n    51\t        route.append(action)\n    52\t    return route\n    53\t\n    54\t\n    55\tdef probe(env):\n    56\t    with open(\"checkpoint.json\") as stream:\n    57\t        for action in json.load(stream)[\"final_path\"]:\n    58\t            env.step(action)\n    59\t    with open(\"frontier_scaffold.json\") as stream:\n    60\t        raw = json.load(stream)[\"staged_prefix_actions\"]\n    61\t    root = env.clone()\n    62\t    base_level = int(env.levels_completed)\n    63\t    outcomes = []\n    64\t    unique_states = {}\n    65\t    tested = 0\n    66\t\n    67\t    for flags in itertools.product((False, True), repeat=len(AMBIGUOUS)):\n    68\t        for use_bottom in (False, True):\n    69\t            node = root.clone()\n    70\t            route = []\n    71\t            repairs = []\n    72\t            for step, action in enumerate(build(raw, flags), 1):\n    73\t                candidate = action\n    74\t                if (\n    75\t                    len(action) == 3\n    76\t                    and action[0] == 6\n    77\t                    and action[1] <= 5\n    78\t                    and int(node.frame()[action[2]][action[1]]) != 8\n    79\t                ):\n    80\t                    visible = controls(node.frame())\n    81\t                    if visible:\n    82\t                        candidate = visible[-1] if use_bottom else visible[0]\n    83\t                        repairs.append((step, action, candidate))\n    84\t                node.step(*candidate)\n    85\t                route.append(candidate)\n    86\t                if node.levels_completed > base_level:\n    87\t                    print(\n    88\t                        \"DECODE_MATRIX_WIN\", flags, use_bottom, repairs,\n    89\t                        route, flush=True,\n    90\t                    )\n    91\t                    return\n    92\t                if node.terminal():\n    93\t                    break\n    94\t            tested += 1\n    95\t            if node.terminal():\n    96\t                continue\n    97\t            key = np.asarray(node.frame())[:63].tobytes()\n    98\t            unique_states.setdefault(\n    99\t                key, (node, flags, use_bottom, repairs, route)\n   100\t            )\n   101\t            if tested % 16 == 0:\n   102\t                print(\n   103\t                    \"DECODE_MATRIX_PROGRESS\", tested, len(unique_states),\n   104\t                    flush=True,\n   105\t                )\n   106\t\n   107\t    for node, flags, use_bottom, repairs, route in unique_states.values():\n   108\t        for direction in (LEFT, RIGHT):\n   109\t            staged = node.clone()\n   110\t            suffix = []\n   111\t            for count in range(7):\n   112\t                if count:\n   113\t                    staged.step(*direction)\n   114\t                    suffix.append(direction)\n   115\t                    if staged.levels_completed > base_level:\n   116\t                        print(\n   117\t                            \"DECODE_MATRIX_WIN\", flags, use_bottom,\n   118\t                            repairs, [*route, *suffix], flush=True,\n   119\t                        )\n   120\t                        return\n   121\t                    if staged.terminal():\n   122\t                        break\n   123\t                for control in controls(staged.frame()):\n   124\t                    child = staged.clone()\n   125\t                    child.step(*control)\n   126\t                    if child.levels_completed > base_level:\n   127\t                        print(\n   128\t                            \"DECODE_MATRIX_WIN\", flags, use_bottom,\n   129\t                            repairs,\n   130\t                            [*route, *suffix, control], flush=True,\n   131\t                        )\n   132\t                        return\n   133\t                outcomes.append(\n   134\t       