615\t        (RIGHT,), (RIGHT,),\n   616\t\n   617\t        # Cross both staged supports, then walk onto the corridor prize.\n   618\t        (RIGHT,), (RIGHT,),\n   619\t        (LEFT,), (LEFT,), (LEFT,), (LEFT,), (LEFT,), (LEFT,),\n   620\t    ]\n   621\t    return run_actions(env, route)\n     1\t# Per-level players. Each play_level_K(env) ONLY composes legs from legs.py.\n     2\tfrom legs import *  # noqa\n     3\t\n     4\t\n     5\tdef play_level_1(env):\n     6\t    # Ascend the block tower, then step onto the prize revealed at its top.\n     7\t    climb_to_prize(env)\n     8\t\n     9\t\n    10\tdef play_level_2(env):\n    11\t    # Taller tower with fatal ceiling hazards, so the greedy ascent walks into\n    12\t    # dead-end shafts: plan the climb by search instead, then commit it.\n    13\t    plan_and_commit(env, climb_search)\n    14\t\n    15\t\n    16\tdef play_level_3(env):\n    17\t    # Nearby hazards must be made safe before each timed crossing.\n    18\t    plan_and_commit(env, local_hazard_climb_search)\n    19\t\n    20\t\n    21\tdef play_level_4(env):\n    22\t    # Alternate gravity toggles with only context-safe support interactions.\n    23\t    plan_and_commit(env, gravity_room_search)\n    24\t\n    25\t\n    26\tdef play_level_5(env):\n    27\t    # The same gravity rooms span the full screen and require side support work.\n    28\t    solve_gravity_rooms(env, max_states=550)\n    29\t\n    30\t\n    31\tdef play_level_6(env):\n    32\t    # Supports staged in the opening room become the bridge to the final prize.\n    33\t    cross_persistent_support_rooms(env)\n     1\timport players\n     2\t\n     3\tdef solve(env):\n     4\t    # dispatch to the per-level player for the current level, in a loop\n     5\t    while not env.terminal():\n     6\t        k = env.levels_completed + 1\n     7\t        fn = getattr(players, f'play_level_{k}', None)\n     8\t        if fn is None:\n     9\t            return\n    10\t        before = env.levels_completed\n    11\t        fn(env)\n    12\t        if env.levels_completed <= before:\n    13\t            return  # no progress -> stop\n","exit_code":0,"status":"completed"}}
