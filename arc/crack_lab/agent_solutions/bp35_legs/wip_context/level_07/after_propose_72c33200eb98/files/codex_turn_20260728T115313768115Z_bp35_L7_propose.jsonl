{"type":"item.completed","item":{"id":"item_140","type":"command_execution","command":"/bin/zsh -lc \"nl -ba legs.py | sed -n '430,590p'\nnl -ba perception.py | sed -n '1,260p'\"","aggregated_output":"   430\t        if not queue:\n   431\t            break\n   432\t        _, _, _, height, path = heapq.heappop(queue)\n   433\t        node = root.clone()\n   434\t        run_actions(node, path)\n   435\t        for action in local_actions(node):\n   436\t            child = node.clone()\n   437\t            child.step(*action)\n   438\t            if child.levels_completed > base_level:\n   439\t                return list(path + (action,))\n   440\t            if child.terminal() or avatar_column(child.frame()) is None:\n   441\t                continue\n   442\t            gained = height + band_shift(node.frame(), child.frame())\n   443\t            state = key(child, gained)\n   444\t            if state in seen:\n   445\t                continue\n   446\t            seen.add(state)\n   447\t            new_path = path + (action,)\n   448\t            heapq.heappush(queue, (-gained, len(new_path), next(tie),\n   449\t                                   gained, new_path))\n   450\t    return []\n   451\t\n   452\t\n   453\tdef climb_local_hazards(env, max_expansions=600):\n   454\t    \"\"\"Plan a shape-changing hazard climb on clones, then commit it.\"\"\"\n   455\t    return plan_and_commit(\n   456\t        env, local_hazard_climb_search, max_expansions=max_expansions\n   457\t    )\n   458\t\n   459\t\n   460\tdef gravity_room_search(env, max_states=900, max_depth=48, debug=False):\n   461\t    \"\"\"Find a route through rooms controlled by gravity toggles and supports.\n   462\t\n   463\t    Movement is always considered.  Global gravity toggles (colour 8) can\n   464\t    appear either in the band grid or in the fixed left control strip.\n   465\t    Removable supports (14) and shape-changing supports (12) are useful only\n   466\t    when aligned near the avatar; hazards (15) only when nearby.\n   467\t    Reconstructing each state from one shallow root avoids chains of costly\n   468\t    nested clones.\n   469\t    \"\"\"\n   470\t    base_level = env.levels_completed\n   471\t    root = env.clone()\n   472\t\n   473\t    def avatar_cell(frame):\n   474\t        for i, r in enumerate(ROW_ANCHORS):\n   475\t            for j, c in enumerate(COL_ANCHORS):\n   476\t                if int(frame[r][c]) in AVATAR_COLORS:\n   477\t                    return i, j\n   478\t        return None\n   479\t\n   480\t    def choices(node):\n   481\t        frame = node.frame()\n   482\t        avatar = avatar_cell(frame)\n   483\t        out = [(LEFT,), (RIGHT,)]\n   484\t        if avatar is None:\n   485\t            return out\n   486\t        ai, aj = avatar\n   487\t        control_rows = [y for y in range(63) if int(frame[y][3]) == 8]\n   488\t        if control_rows:\n   489\t            run = [control_rows[0]]\n   490\t            for y in control_rows[1:]:\n   491\t                if y != run[-1] + 1:\n   492\t                    break\n   493\t                run.append(y)\n   494\t            out.append((CLICK, 3, run[len(run) // 2]))\n   495\t        for i, y in enumerate(ROW_ANCHORS):\n   496\t            for j, x in enumerate(COL_ANCHORS):\n   497\t                color = int(frame[y][x])\n   498\t                if color == 8 and abs(j - aj) <= 1:\n   499\t                    out.append((CLICK, x, y))\n   500\t                elif color in (12, 14) and abs(j - aj) <= 1 and abs(i - ai) <= 3:\n   501\t                    out.append((CLICK, x, y))\n   502\t                elif color == 15 and abs(i - ai) <= 1 and abs(j - aj) <= 1:\n   503\t                    out.append((CLICK, x, y))\n   504\t        return out\n   505\t\n   506\t    def state_key(node):\n   507\t        frame = node.frame()\n   508\t        cells = tuple(\n   509\t            _cell_shape(frame, i, j)\n   510\t            for i in range(GRID_ROWS)\n   511\t            for j in range(GRID_COLS)\n   512\t        )\n   513\t        return cells, moves_used(frame) % 2\n   514\t\n   515\t    def reconstruct(path):\n   516\t        node = root.clone()\n   517\t        run_actions(node, path)\n   518\t        return node\n   519\t\n   520\t    counter = itertools.count()\n   521\t    frontier = [(0, 0, next(counter), ())]\n   522\t    seen_progress = {state_key(root)}\n   523\t    expanded = 0\n   524\t\n   525\t    while frontier and expanded < max_states:\n   526\t        neg_height, _, _, prefix = heapq.heappop(frontier)\n   527\t        if debug:\n   528\t            print(\"macro\", -neg_height, len(prefix), expanded, len(frontier), prefix)\n   529\t        stage = reconstruct(prefix)\n   530\t        local_queue = deque([()])\n   531\t        local_seen = {state_key(stage)}\n   532\t\n   533\t        # Search the current room only until the camera rises.  Each distinct\n   534\t        # landing becomes a macro successor, so unsafe early toggles can still\n   535\t        # be backtracked without flattening the whole course into one BFS.\n   536\t        while local_queue and expanded < max_states:\n   537\t            suffix = local_queue.popleft()\n   538\t            path = prefix + suffix\n   539\t            node = stage.clone()\n   540\t            run_actions(node, suffix)\n   541\t            expanded += 1\n   542\t            if len(path) >= max_depth or node.terminal():\n   543\t                continue\n   544\t            for action in choices(node):\n   545\t                child = node.clone()\n   546\t                child.step(*action)\n   547\t                new_suffix = suffix + (action,)\n   548\t                new_path = prefix + new_suffix\n   549\t                if child.levels_completed > base_level:\n   550\t                    return list(new_path)\n   551\t                if child.terminal() or avatar_cell(child.frame()) is None:\n   552\t                    continue\n   553\t                key = state_key(child)\n   554\t                gain = max(0, band_shift(node.frame(), child.frame()))\n   555\t                if gain:\n   556\t                    if key in seen_progress:\n   557\t                        continue\n   558\t                    seen_progress.add(key)\n   559\t                    height = -neg_height + gain\n   560\t                    heapq.heappush(\n   561\t                        frontier,\n   562\t                        (-height, len(new_path), next(counter), new_path),\n   563\t                    )\n   564\t                elif len(new_suffix) < 12 and key not in local_seen:\n   565\t                    local_seen.add(key)\n   566\t                    local_queue.append(new_suffix)\n   567\t    return []\n   568\t\n   569\t\n   570\tdef solve_gravity_rooms(env, max_states=900, max_depth=48):\n   571\t    \"\"\"Plan context-safe gravity/support transitions, then commit the route.\"\"\"\n   572\t    return plan_and_commit(\n   573\t        env, gravity_room_search, max_states=max_states, max_depth=max_depth\n   574\t    )\n   575\t\n   576\t\n   577\tdef cross_persistent_support_rooms(env):\n   578\t    \"\"\"Stage remote supports, traverse alternating rooms, and reach the prize.\n   579\t\n   580\t    Some gravity courses scroll the starting supports off-screen long before\n   581\t    they are needed.  Expanding both first preserves a two-cell bridge in the\n   582\t    final lower chamber; the avatar can then cross it into the prize corridor.\n   583\t    \"\"\"\n   584\t    route = [\n   585\t        # Preserve the two starting supports for the otherwise lethal chamber.\n   586\t        click_action(8, 4), click_action(8, 5),\n   587\t\n   588\t        # Enter the first gravity switch and take its safe landing lane.\n   589\t        (RIGHT,), (RIGHT,), (RIGHT,), (RIGHT,), (RIGHT,),\n   590\t        click_action(5, 4),\n     1\t\"\"\"Source-free frame perception helpers for cracking.\n     2\t\n     3\tThis module is deliberately observational: it derives compact symbolic state\n     4\tfrom `env.frame()` and `env.clone()` only. It is a cofibration-style scaffold:\n     5\traw pixels are embedded into a monotone tower of reusable observations\n     6\t(components -> objects -> action deltas -> replay states). Candidate level\n     7\tlogic should be written against these quotients, then replay-validated by the\n     8\tharness. No game source or prior solution history is read here.\n     9\t\"\"\"\n    10\tfrom collections import deque\n    11\tfrom dataclasses import dataclass\n    12\tfrom typing import Dict, Iterable, List, Optional, Sequence, Tuple\n    13\t\n    14\timport numpy as np\n    15\t\n    16\tUP, DOWN, LEFT, RIGHT, USE = 1, 2, 3, 4, 5\n    17\tACTIONS = (UP, DOWN, LEFT, RIGHT, USE)\n    18\tDIRS = {UP: (-1, 0), DOWN: (1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\n    19\tACTION_NAME = {UP: \"UP\", DOWN: \"DOWN\", LEFT: \"LEFT\", RIGHT: \"RIGHT\", USE: \"USE\"}\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Blob:\n    24\t    color: int\n    25\t    bbox: Tuple[int, int, int, int]  # r0, c0, r1, c1 inclusive\n    26\t    area: int\n    27\t    centroid: Tuple[float, float]\n    28\t\n    29\t    @property\n    30\t    def top_left(self):\n    31\t        return self.bbox[0], self.bbox[1]\n    32\t\n    33\t    @property\n    34\t    def size(self):\n    35\t        r0, c0, r1, c1 = self.bbox\n    36\t        return r1 - r0 + 1, c1 - c0 + 1\n    37\t\n    38\t\n    39\tdef arr(frame) -> np.ndarray:\n    40\t    return np.asarray(frame)\n    41\t\n    42\t\n    43\tdef color_counts(frame) -> Dict[int, int]:\n    44\t    vals, cnts = np.unique(arr(frame), return_counts=True)\n    45\t    return {int(v): int(c) for v, c in zip(vals, cnts)}\n    46\t\n    47\t\n    48\tdef connected_components(frame, colors: Optional[Iterable[int]] = None,\n    49\t                         min_area: int = 1) -> List[Blob]:\n    50\t    f = arr(frame)\n    51\t    wanted = None if colors is None else {int(c) for c in colors}\n    52\t    seen = np.zeros(f.shape, dtype=bool)\n    53\t    out: List[Blob] = []\n    54\t    rows, cols = f.shape[:2]\n    55\t    for r in range(rows):\n    56\t        for c in range(cols):\n    57\t            if seen[r, c]:\n    58\t                continue\n    59\t            color = int(f[r, c])\n    60\t            if wanted is not None and color not in wanted:\n    61\t                seen[r, c] = True\n    62\t                continue\n    63\t            q = [(r, c)]\n    64\t            seen[r, c] = True\n    65\t            pts = []\n    66\t            while q:\n    67\t                x, y = q.pop()\n    68\t                pts.append((x, y))\n    69\t                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n    70\t                    nx, ny = x + dx, y + dy\n    71\t                    if 0 <= nx < rows and 0 <= ny < cols and not seen[nx, ny] and int(f[nx, ny]) == color:\n    72\t                        seen[nx, ny] = True\n    73\t                        q.append((nx, ny))\n    74\t            if len(pts) >= min_area:\n    75\t                rs = [p[0] for p in pts]\n    76\t                cs = [p[1] for p in pts]\n    77\t                out.append(Blob(color, (min(rs), min(cs), max(rs), max(cs)),\n    78\t                                len(pts), (sum(rs) / len(pts), sum(cs) / len(pts))))\n    79\t    return sorted(out, key=lambda b: (b.color, b.bbox))\n    80\t\n    81\t\n    82\tdef block_signatures(frame, cell: int = 4) -> Dict[Tuple[int, int], Tuple[int, ...]]:\n    83\t    \"\"\"Partition a frame into fixed cells and return each cell's color signature.\"\"\"\n    84\t    f = arr(frame)\n    85\t    out = {}\n    86\t    for r in range(0, f.shape[0], cell):\n    87\t        for c in range(0, f.shape[1], cell):\n    88\t            out[(r // cell, c // cell)] = tuple(int(v) for v in sorted(np.unique(f[r:r+cell, c:c+cell])))\n    89\t    return out\n    90\t\n    91\t\n    92\tdef object_candidates(frame, cell: int = 4, min_area: int = 4) -> List[dict]:\n    93\t    \"\"\"A compact, game-agnostic object list from color components and cell signatures.\"\"\"\n    94\t    f = arr(frame)\n    95\t    blobs = connected_components(f, min_area=min_area)\n    96\t    sigs = block_signatures(f, cell)\n    97\t    objects = []\n    98\t    for b in blobs:\n    99\t        r0, c0, r1, c1 = b.bbox\n   100\t        objects.append({\n   101\t            \"color\": b.color,\n   102\t            \"bbox\": b.bbox,\n   103\t            \"top_left\": b.top_left,\n   104\t            \"size\": b.size,\n   105\t            \"area\": b.area,\n   106\t            \"centroid\": b.centroid,\n   107\t            \"cell\": (r0 // cell, c0 // cell),\n   108\t            \"cell_sig\": sigs.get((r0 // cell, c0 // cell)),\n   109\t        })\n   110\t    return objects\n   111\t\n   112\t\n   113\tdef frame_delta(before, after) -> dict:\n   114\t    a, b = arr(before), arr(after)\n   115\t    ys, xs = np.where(a != b)\n   116\t    if len(ys) == 0:\n   117\t        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n   118\t    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n   119\t    return {\n   120\t        \"count\": int(len(ys)),\n   121\t        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n   122\t        \"samples\": samples,\n   123\t    }\n   124\t\n   125\t\n   126\tdef action_deltas(env, actions: Sequence[int] = ACTIONS) -> Dict[int, dict]:\n   127\t    base = arr(env.frame()).copy()\n   128\t    out = {}\n   129\t    for action in actions:\n   130\t        clone = env.clone()\n   131\t        clone.step(action)\n   132\t        out[int(action)] = frame_delta(base, clone.frame())\n   133\t    return out\n   134\t\n   135\t\n   136\tdef replay(env, actions: Sequence[int]):\n   137\t    clone = env.clone()\n   138\t    for action in actions:\n   139\t        if clone.terminal():\n   140\t            break\n   141\t        clone.step(int(action))\n   142\t    return clone\n   143\t\n   144\t\n   145\tdef path_result(env, actions: Sequence[int]) -> dict:\n   146\t    clone = replay(env, actions)\n   147\t    return {\n   148\t        \"levels_completed\": int(clone.levels_completed),\n   149\t        \"terminal\": bool(clone.terminal()),\n   150\t        \"path_len\": len(actions),\n   151\t        \"colors\": color_counts(clone.frame()),\n   152\t        \"objects\": object_candidates(clone.frame()),\n   153\t    }\n   154\t\n   155\t\n   156\tdef changed_signature(env, actions: Sequence[int], cell: int = 4):\n   157\t    before = block_signatures(env.frame(), cell)\n   158\t    clone = replay(env, actions)\n   159\t    after = block_signatures(clone.frame(), cell)\n   160\t    return {k: (before.get(k), after.get(k)) for k in sorted(set(before) | set(after))\n   161\t            if before.get(k) != after.get(k)}\n   162\t\n   163\t\n   164\tdef bounded_bfs(env, goal_fn, actions: Sequence[int] = (UP, DOWN, LEFT, RIGHT, USE),\n   165\t                key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   166\t    \"\"\"Generic clone BFS over observational keys. Use small max_states first.\"\"\"\n   167\t    if key_fn is None:\n   168\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   169\t    start_key = key_fn(env)\n   170\t    q = deque([(env.clone(), [])])\n   171\t    seen = {start_key}\n   172\t    while q and len(seen) <= max_states:\n   173\t        node, path = q.popleft()\n   174\t        if goal_fn(node, path):\n   175\t            return path\n   176\t        if len(path) >= max_depth:\n   177\t            continue\n   178\t        for action in actions:\n   179\t            child = node.clone()\n   180\t            child.step(int(action))\n   181\t            key = key_fn(child)\n   182\t            if key in seen:\n   183\t                continue\n   184\t            seen.add(key)\n   185\t            q.append((child, path + [int(action)]))\n   186\t    return None\n   187\t\n   188\t\n   189\tdef bounded_replay_bfs(env, goal_fn, action_fn,\n   190\t                       key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   191\t    \"\"\"Path-only BFS for games whose deep Arena clones become expensive.\n   192\t\n   193\t    The queue retains compact action paths, not recursively deep-copied runtime\n   194\t    states. Each node is reconstructed from one root clone. ``action_fn(node)``\n   195\t    may return integer actions or coordinate tuples such as ``(6, x, y)``.\n   196\t    \"\"\"\n   197\t    if key_fn is None:\n   198\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   199\t\n   200\t    def reconstruct(path):\n   201\t        node = env.clone()\n   202\t        for action in path:\n   203\t            if isinstance(action, tuple):\n   204\t                node.step(*action)\n   205\t            else:\n   206\t                node.step(int(action))\n   207\t        return node\n   208\t\n   209\t    start = reconstruct([])\n   210\t    q = deque([[]])\n   211\t    seen = {key_fn(start)}\n   212\t    while q and len(seen) <= max_states:\n   213\t        path = q.popleft()\n   214\t        node = reconstruct(path)\n   215\t        if goal_fn(node, path):\n   216\t            return path\n   217\t        if len(path) >= max_depth or node.terminal():\n   218\t            continue\n   219\t        for action in action_fn(node):\n   220\t            child_path = path + [action]\n   221\t            child = reconstruct(child_path)\n   222\t            key = key_fn(child)\n   223\t            if key in seen:\n   224\t                continue\n   225\t            seen.add(key)\n   226\t            if goal_fn(child, child_path):\n   227\t                return child_path\n   228\t            q.append(child_path)\n   229\t    return None\n   230\t\n   231\t\n   232\tdef level_goal(base_level: int):\n   233\t    return lambda env, path: env.levels_completed > base_level\n","exit_code":0,"status":"completed"}}
