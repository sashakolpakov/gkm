le_index = 0\n    50\t        for step, action in enumerate(decoded_route(), 1):\n    51\t            candidate = action\n    52\t            if (\n    53\t                len(action) == 3\n    54\t                and action[0] == 6\n    55\t                and action[1] <= 5\n    56\t                and int(node.frame()[action[2]][action[1]]) != 8\n    57\t            ):\n    58\t                visible = controls(node.frame())\n    59\t                if visible:\n    60\t                    choose_bottom = bool(mask & (1 << stale_index))\n    61\t                    candidate = visible[-1] if choose_bottom else visible[0]\n    62\t                    repaired.append((step, action, candidate))\n    63\t                stale_index += 1\n    64\t            node.step(*candidate)\n    65\t            route.append(candidate)\n    66\t            if node.levels_completed > base_level:\n    67\t                print(\"RETARGET_SIMPLE_WIN\", mask, repaired, route, flush=True)\n    68\t                return\n    69\t            if node.terminal():\n    70\t                break\n    71\t        if node.terminal():\n    72\t            outcomes.append((mask, repaired, \"dead\"))\n    73\t            continue\n    74\t        for direction in (LEFT, RIGHT):\n    75\t            staged = node.clone()\n    76\t            suffix = []\n    77\t            for _ in range(4):\n    78\t                staged.step(*direction)\n    79\t                suffix.append(direction)\n    80\t                if staged.levels_completed > base_level:\n    81\t                    print(\n    82\t                        \"RETARGET_SIMPLE_WIN\", mask, repaired,\n    83\t                        [*route, *suffix], flush=True,\n    84\t                    )\n    85\t                    return\n    86\t                if staged.terminal():\n    87\t                    break\n    88\t            if staged.terminal():\n    89\t                continue\n    90\t            for control in controls(staged.frame()):\n    91\t                child = staged.clone()\n    92\t                child.step(*control)\n    93\t                if child.levels_completed > base_level:\n    94\t                    print(\n    95\t                        \"RETARGET_SIMPLE_WIN\", mask, repaired,\n    96\t                        [*route, *suffix, control], flush=True,\n    97\t                    )\n    98\t                    return\n    99\t            outcomes.append(\n   100\t                (\n   101\t                    mask, repaired, direction,\n   102\t                    avatar_cell(staged.frame()), target(staged.frame()),\n   103\t                    tuple(controls(staged.frame())), lattice(staged.frame()),\n   104\t                )\n   105\t            )\n   106\t    print(\"RETARGET_SIMPLE_DONE\", len(outcomes), flush=True)\n   107\t    for outcome in outcomes:\n   108\t        print(\"RETARGET_SIMPLE_STATE\", outcome, flush=True)\n   109\t\n   110\t\n   111\tarena.run_program(\"bp35\", probe)\n     1\t\"\"\"Retarget only stale gravity coordinates in the decoded route.\"\"\"\n     2\t\n     3\timport json\n     4\timport sys\n     5\t\n     6\timport numpy as np\n     7\t\n     8\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     9\timport gkm_arena as arena\n    10\t\n    11\tfrom perception import connected_components\n    12\tfrom probe_level7_decoded_stage import decoded_route\n    13\tfrom probe_level7_reward_recovery import avatar_cell, lattice\n    14\t\n    15\t\n    16\tLEFT, RIGHT = (3,), (4,)\n    17\t\n    18\t\n    19\tdef control_actions(frame):\n    20\t    actions = []\n    21\t    for blob in connected_components(frame, colors=(8,), min_area=1):\n    22\t        if blob.bbox[0] >= 63 or blob.bbox[1] > 5:\n    23\t            continue\n    24\t        y, x = blob.centroid\n    25\t        action = (6, round(x), round(y))\n    26\t        if action not in actions:\n    27\t            actions.append(action)\n    28\t    return actions\n    29\t\n    30\t\n    31\tdef target_cell(frame):\n    32\t    ys, xs = np.where(np.asarray(frame)[:63] == 7)\n    33\t    if not len(xs):\n    34\t        return None\n    35\t    return round(float(xs.mean())), round(float(ys.mean()))\n    36\t\n    37\t\n    38\tdef probe(env):\n    39\t    with open(\"checkpoint.json\") as stream:\n    40\t        for action in json.load(stream)[\"final_path\"]:\n    41\t            env.step(action)\n    42\t    base_level = int(env.levels_completed)\n    43\t\n    44\t    branches = [(env.clone(), [], [])]\n    45\t    for index, action in enumerate(decoded_route(), 1):\n    46\t        next_branches = []\n    47\t        for node, route, replaced in branches:\n    48\t            candidates = [action]\n    49\t            if (\n    50\t                len(action) == 3\n    51\t                and action[0] == 6\n    52\t                and action[1] <= 5\n    53\t                and int(node.frame()[action[2]][action[1]]) != 8\n    54\t            ):\n    55\t                visible = control_actions(node.frame())\n    56\t                candidates = [action, *visible]\n    57\t            for candidate in dict.fromkeys(candidates):\n    58\t                child = node.clone()\n    59\t                child.step(*candidate)\n    60\t                if child.levels_completed > base_level:\n    61\t                    print(\n    62\t                        \"RETARGET_WIN_ROUTE\", [*route, candidate],\n    63\t                        [*replaced, (index, action, candidate)], flush=True,\n    64\t                    )\n    65\t                    return\n    66\t                if child.terminal():\n    67\t                    continue\n    68\t                change = (\n    69\t                    []\n    70\t                    if candidate == action\n    71\t                    else [(index, action, candidate)]\n    72\t                )\n    73\t                next_branches.append(\n    74\t                    (child, [*route, candidate], [*replaced, *change])\n    75\t                )\n    76\t        # Exact frame plus replacement record prevents accidental collapse of\n    77\t        # distinct held-input histories.\n    78\t        unique = {}\n    79\t        for item in next_branches:\n    80\t            key = (\n    81\t                np.asarray(item[0].frame())[:63].tobytes(),\n    82\t                tuple(item[2]),\n    83\t            )\n    84\t            unique.setdefault(key, item)\n    85\t        branches = list(unique.values())\n    86\t        if len(branches) > 64:\n    87\t            branches = branches[:64]\n    88\t        if not branches:\n    89\t            print(\"RETARGET_ALL_DEAD\", index, flush=True)\n    90\t            return\n    91\t\n    92\t    outcomes = []\n    93\t    for node, route, replaced in branches:\n    94\t        for walk in (\n    95\t            [LEFT] * 4,\n    96\t            [RIGHT] * 4,\n    97\t            [LEFT] * 3,\n    98\t            [RIGHT] * 3,\n    99\t            [],\n   100\t        ):\n   101\t            staged = node.clone()\n   102\t            suffix = []\n   103\t            for action in walk:\n   104\t                staged.step(*action)\n   105\t                suffix.append(action)\n   106\t                if staged.levels_completed > base_level:\n   107\t                    print(\n   108\t                        \"RETARGET_WIN_WALK\", replaced,\n   109\t                        [*route, *suffix], flush=True,\n   110\t                    )\n   111\t                    return\n   112\t                if staged.terminal():\n   113\t                    break\n   114\t            if staged.terminal():\n   115\t                continue\n   116\t            for control in control_actions(staged.frame()):\n   117\t                child = staged.clone()\n   118\t                child.step(*control)\n   119\t                if child.levels_completed > base_level:\n   120\t                    print(\n   121\t                        \"RETARGET_WIN_CONTROL\", replaced,\n   122\t                        [*route, *suffix, control], flush=True,\n   123\t                    )\n   124\t                    return\n   125\t            outcomes.append(\n   126\t                (\n   127\t                    replaced,\n   128\t                    tuple(walk),\n   129\t                    avatar_cell(staged.frame()),\n   130\t                    target_cell(staged.frame()),\n   131\t                    tuple(control_actions(staged.frame())),\n   132\t                    lattice(staged.frame()),\n   133\t                )\n   134\t            )\n   135\t    print(\"RETARGET_DONE\", len(branches), len(outcomes), flush=True)\n   136\t    for outcome in outcomes:\n   137\t        print(\"RETARGET_STATE\", outcome, flush=True)\n   138\t\n   139\t\n   140\tarena.run_program(\"bp35\", probe)\n     1\t\"\"\"Bounded local search in the lower-control retargeted side chamber.\"\"\"\n     2\t\n     3\tfrom collections import deque\n     4\timport json\n     5\timport os\n     6\timport sys\n     7\t\n     8\timport numpy as np\n     9\t\n    10\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n    11\timport gkm_arena as arena\n    12\t\n    13\tfrom legs import COL_ANCHORS, ROW_ANCHORS, _cell_shape, click_action, run_actions\n    14\tfrom perception import connected_components\n    15\tfrom probe_level7_decoded_stage import decoded_route\n    16\t\n    17\t\n    18\tLEFT, RIGHT, UNDO = (3,), (4,), (7,)\n    19\t\n    20\t\n    21\tdef avatar_cell(frame):\n    22\t    ys, xs = np.where(np.asarray(frame) == 9)\n    23\t    if not len(xs):\n    24\t        return None\n    25\t    y, x = float(ys.mean()), float(xs.mean())\n    26\t    return (\n    27\t        min(range(10), key=lambda i: abs(ROW_ANCHORS[i] - y)),\n    28\t        min(range(8), key=lambda j: abs(COL_ANCHORS[j] - x)),\n    29\t    )\n    30\t\n    31\t\n    32\tdef target_cell(frame):\n    33\t    ys, xs = np.where(np.asarray(frame)[:63] == 7)\n    34\t    if not len(xs):\n    35\t        return None\n    36\t    y, x = float(ys.mean()), float(xs.mean())\n    37\t    return (\n    38\t        min(range(10), key=lambda i: abs(ROW_ANCHORS[i] - y)),\n    39\t        min(range(8), key=lambda j: abs(COL_ANCHORS[j] - x)),\n    40\t    )\n    41\t\n    42\t\n    43\tdef controls(frame):\n    44\t    out = []\n    45\t    for blob in connected_components(frame, colors=(8,), min_area=1):\n    46\t        if blob.bbox[0] >= 63 or blob.bbox[1] > 5:\n    47\t            continue\n    48\t        y, x = blob.centroid\n    49\t        action = (6, round(x), round(y))\n    50\t        if action not in out:\n    51\t            out.append(action)\n    52\t    return out\n    53\t\n    54\t\n    55\tdef lattice(frame):\n    56\t    palette = {\n    57\t        0: \"v\", 3: \"#\", 5: \"#\", 7: \"T\", 8: \"g\", 9: \"A\",\n    58\t        10: \".\", 11: \"a\", 12: \"s\", 14: \"Y\", 15: \"h\",\n    59\t    }\n    60\t    return \"/\".join(\n    61\t        \"\".join(\n    62\t            palette.get(int(frame[y][x]), \"?\") for x in COL_ANCHORS\n    63\t        )\n    64\t        for y in ROW_ANCHORS\n    65\t    )\n    66\t\n    67\t\n    68\tdef actions(node):\n    69\t    frame = node.frame()\n    70\t    avatar = avatar_cell(frame)\n    71\t    if avatar is None:\n    72\t        return []\n    73\t    ai, aj = avatar\n    74\t    out = [LEFT, RIGHT, UNDO, *controls(frame)]\n    75\t    for i in range(max(0, ai - 4), min(10, ai + 5)):\n    76\t        for j in range(max(0, aj - 4), min(8, aj + 5)):\n    77\t            color, _area = _cell_shape(frame, i, j)\n    78\t            if color in (12, 14, 15):\n    79\t                out.append(click_action(i, j))\n    80\t    return list(dict.fromkeys(out))\n    81\t\n    82\t\n    83\tdef stack_key(path):\n    84\t    stack = []\n    85\t    for action in path:\n    86\t        if action[0] == 7:\n    87\t            if stack:\n    88\t                stack.pop()\n    89\t        else:\n    90\t            stack.append(action)\n    91\t    return len(stack), tuple(stack[-8:])\n    92\t\n    93\t\n    94\tdef probe(env):\n    95\t    with open(\"checkpoint.json\") as stream:\n    96\t        for action in json.load(stream)[\"final_path\"]:\n    97\t            env.step(action)\n    98\t    base_level = int(env.levels_completed)\n    99\t\n   100\t    repaired_route = []\n   101\t    repaired = False\n   102\t    for action in decoded_route():\n   103\t        candidate = action\n   104\t        if (\n   105\t            not repaired\n   106\t            and len(action) == 3\n   107\t            and action[0] == 6\n   108\t            and action[1] <= 5\n   109\t            and int(env.frame()[action[2]][action[1]]) != 8\n   110\t        ):\n   111\t            visible = controls(env.frame())\n   112\t            if visible:\n   113\t                candidate = max(visible, key=lambda item: item[2])\n   114\t                repaired = True\n   115\t        env.step(*candidate)\n   116\t        repaired_route.append(candidate)\n   117\t        if env.terminal():\n   118\t            print(\"RETARGET_LOCAL_ENTRY_DEAD\", candidate)\n   119\t            return\n   120\t    run_actions(env, [LEFT] * 4)\n   121\t    root = env.clone()\n   122\t    print(\n   123\t        \"RETARGET_LOCAL_ROOT\", avatar_cell(root.frame()),\n   124\t        target_cell(root.frame()), controls(root.frame()),\n   125\t        lattice(root.frame()), flush=True,\n   126\t    )\n   127\t\n   128\t    max_states = int(os.environ.get(\"MAX_STATES\", \"240\"))\n   129\t    max_depth = int(os.environ.get(\"MAX_DEPTH\", \"12\"))\n   130\t    queue = deque([()])\n   131\t    seen = {\n   132\t        (\n   133\t            np.asarray(root.frame())[:63].tobytes(),\n   134\t            stack_key(()),\n   135\t        )\n   136\t    }\n   137\t    observed = {\n   138\t        (avatar_cell(root.frame()), target_cell(root.frame()), lattice(root.frame()))\n   139\t    }\n   140\t    expanded = 0\n   141\t    while queue and expanded < max_states:\n   142\t        path = queue.popleft()\n   143\t        if len(path) >= max_depth:\n   144\t            continue\n   145\t        node = root.clone()\n   146\t        run_actions(node, path)\n   147\t        for action in actions(node):\n   148\t            child = node.clone()\n   149\t            child.step(*action)\n   150\t            expanded += 1\n   151\t            child_path = (*path, action)\n   152\t            if child.levels_completed > base_level:\n   153\t                print(\n   154\t                    \"RETARGET_LOCAL_WIN\", child_path,\n   155\t                    [*repaired_route, *([LEFT] * 4), *child_path],\n   156\t                    expanded, flush=True,\n   157\t                )\n   158\t                return\n   159\t            if child.terminal() or avatar_cell(child.frame()) is None:\n   160\t                if expanded >= max_states:\n   161\t                    break\n   162\t                continue\n   163\t            state = (\n   164\t                avatar_cell(child.frame()),\n   165\t                target_cell(child.frame()),\n   166\t                lattice(child.frame()),\n   167\t            )\n   168\t            if state not in observed:\n   169\t                observed.add(state)\n   170\t                if state[1] is not None or state[0] != avatar_cell(root.frame()):\n   171\t                    print(\n   172\t                        \"RETARGET_LOCAL_PROGRESS\", expanded, child_path,\n   173\t                        state[0], state[1], controls(child.frame()), state[2],\n   174\t                        flush=True,\n   175\t                    )\n   176\t            key = (\n   177\t                np.asarray(child.frame())[:63].tobytes(),\n   178\t                stack_key(child_path),\n   179\t            )\n   180\t            if key not in seen:\n   181\t                seen.add(key)\n   182\t                queue.append(child_path)\n   183\t            if expanded >= max_states:\n   184\t                break\n   185\t    print(\n   186\t        \"RETARGET_LOCAL_DONE\", expanded, len(seen), len(queue),\n   187\t        len(observed), flush=True,\n   188\t    )\n   189\t\n   190\t\n   191\tarena.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
