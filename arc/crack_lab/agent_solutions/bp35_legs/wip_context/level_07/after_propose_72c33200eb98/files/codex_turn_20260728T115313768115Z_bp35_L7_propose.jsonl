(xs.mean()))),\n    59\t    )\n    60\t\n    61\t\n    62\tdef controls(frame):\n    63\t    return [y for y in ROW_ANCHORS if int(frame[y][3]) == 8]\n    64\t\n    65\t\n    66\tdef lattice(frame):\n    67\t    palette = {\n    68\t        0: \"v\", 3: \"#\", 5: \"#\", 8: \"g\", 9: \"A\", 10: \".\",\n    69\t        11: \"a\", 12: \"s\", 14: \"Y\", 15: \"h\",\n    70\t    }\n    71\t    return \"/\".join(\n    72\t        \"\".join(palette.get(int(frame[y][x]), \"?\") for x in COL_ANCHORS)\n    73\t        for y in ROW_ANCHORS\n    74\t    )\n    75\t\n    76\t\n    77\tdef advance(node, actions):\n    78\t    height = 0\n    79\t    for action in actions:\n    80\t        if node.terminal():\n    81\t            break\n    82\t        before = arr(node.frame()).copy()\n    83\t        node.step(*action)\n    84\t        if not node.terminal():\n    85\t            height += band_shift(before, node.frame())\n    86\t    return height\n    87\t\n    88\t\n    89\tdef probe(env):\n    90\t    with open(\"checkpoint.json\") as stream:\n    91\t        checkpoint = json.load(stream)\n    92\t    for action in checkpoint[\"final_path\"]:\n    93\t        env.step(action)\n    94\t\n    95\t    route = [\n    96\t        *PREFIX,\n    97\t        click_action(5, 2),\n    98\t        *SUFFIX,\n    99\t        (3,), (6, 3, 9), (4,), (6, 3, 39),\n   100\t    ]\n   101\t    root = env.clone()\n   102\t    height = advance(root, route)\n   103\t    print(\n   104\t        \"ENDGAME_ROOT\", len(route), height, root.levels_completed,\n   105\t        root.terminal(), avatar_cell(root.frame()), controls(root.frame()),\n   106\t    )\n   107\t    for left_count in range(9):\n   108\t        staged = root.clone()\n   109\t        advance(staged, [(3,)] * left_count)\n   110\t        visible = controls(staged.frame())\n   111\t        for y in visible:\n   112\t            node = staged.clone()\n   113\t            node.step(6, 3, y)\n   114\t            print(\n   115\t                \"TRY\", left_count, y, node.levels_completed,\n   116\t                node.terminal(),\n   117\t                None if node.terminal() else avatar_cell(node.frame()),\n   118\t                [] if node.terminal() else controls(node.frame()),\n   119\t            )\n   120\t            if node.levels_completed > 6:\n   121\t                print(\n   122\t                    \"WIN_ROUTE\",\n   123\t                    [*route, *([(3,)] * left_count), (6, 3, y)],\n   124\t                    flush=True,\n   125\t                )\n   126\t                return\n   127\t            if left_count == 3 and not node.terminal():\n   128\t                print(\"SIDE_ROOM\", y, lattice(node.frame()))\n   129\t                frame = node.frame()\n   130\t                local = [(3,), (4,)]\n   131\t                local += [\n   132\t                    click_action(i, j)\n   133\t                    for i in range(10)\n   134\t                    for j in range(8)\n   135\t                    if _cell_shape(frame, i, j)[0] in (12, 14, 15)\n   136\t                ]\n   137\t                for action in local:\n   138\t                    child = node.clone()\n   139\t                    before = arr(child.frame()).copy()\n   140\t                    child.step(*action)\n   141\t                    gain = (\n   142\t                        0 if child.terminal()\n   143\t                        else band_shift(before, child.frame())\n   144\t                    )\n   145\t                    if (\n   146\t                        child.levels_completed > 6\n   147\t                        or gain\n   148\t                        or (\n   149\t                            not child.terminal()\n   150\t                            and (\n   151\t                                avatar_cell(child.frame()) != avatar_cell(frame)\n   152\t                                or controls(child.frame())\n   153\t                            )\n   154\t                        )\n  