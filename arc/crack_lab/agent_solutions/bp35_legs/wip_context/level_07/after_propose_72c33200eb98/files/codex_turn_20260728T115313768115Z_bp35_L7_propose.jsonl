ith open(\"checkpoint.json\") as stream:\n    31\t        checkpoint = json.load(stream)\n    32\t    for action in checkpoint[\"final_path\"]:\n    33\t        env.step(action)\n    34\t\n    35\t    origin = 0\n    36\t    route = [*decoded_route(), (3,), (3,), (3,), (3,)]\n    37\t    for step, action in enumerate(route, 1):\n    38\t        before = arr(env.frame()).copy()\n    39\t        pre = clicked_shape(before, action)\n    40\t        env.step(*action)\n    41\t        after = arr(env.frame())\n    42\t        shift = 0 if env.terminal() else band_shift(before, after)\n    43\t        origin -= shift\n    44\t        changed = int((before[:63] != after[:63]).sum())\n    45\t        post = None if pre is None or env.terminal() else clicked_shape(after, action)\n    46\t        print(\n    47\t            \"TRACE\", step, action, \"world\", origin,\n    48\t            \"avatar\", None if env.terminal() else avatar_cell(after),\n    49\t            \"shift\", shift, \"delta\", changed,\n    50\t            \"shape\", pre, \"to\", post,\n    51\t            \"controls\", () if env.terminal() else tuple(controls(after)),\n    52\t            \"target\", False if env.terminal() else bool((after == 7).any()),\n    53\t            flush=True,\n    54\t        )\n    55\t        if env.terminal():\n    56\t            return\n    57\t\n    58\t\n    59\tlevels, path, err = A.run_program(\"bp35\", probe)\n    60\tprint(\"RESULT\", levels, len(path), err)\n     1\t\"\"\"Reproduce and clear the support-packed final corridor decode.\"\"\"\n     2\t\n     3\timport json\n     4\timport sys\n     5\t\n     6\timport numpy as np\n     7\t\n     8\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     9\timport gkm_arena as arena\n    10\t\n    11\tfrom legs import click_action\n    12\tfrom probe_l7_decode_matrix import build, controls, target\n    13\tfrom probe_level7_coordinate_decode import AMBIGUOUS\n    14\tfrom probe_level7_reward_recovery import avatar_cell, lattice\n    15\t\n    16\t\n    17\tLEFT, RIGHT = (3,), (4,)\n    18\tFLAGS = (False, False, True, False, True)\n    19\t\n    20\t\n    21\tdef summary(node):\n    22\t    return (\n    23\t        int(node.levels_completed),\n    24\t        bool(node.terminal()),\n    25\t        None if node.terminal() else avatar_cell(node.frame()),\n    26\t        None if node.terminal() else target(node.frame()),\n    27\t        () if node.terminal() else tuple(controls(node.frame())),\n    28\t        \"\" if node.terminal() else lattice(node.frame()),\n    29\t    )\n    30\t\n    31\t\n    32\tdef probe(env):\n    33\t    with open(\"checkpoint.json\") as stream:\n    34\t        for action in json.load(stream)[\"final_path\"]:\n    35\t            env.step(action)\n    36\t    with open(\"frontier_scaffold.json\") as stream:\n    37\t        raw = json.load(stream)[\"staged_prefix_actions\"]\n    38\t    base_level = int(env.levels_completed)\n    39\t    route = []\n    40\t    repairs = []\n    41\t    for step, action in enumerate(build(raw, FLAGS), 1):\n    42\t        candidate = action\n    43\t        if (\n    44\t            len(action) == 3\n    45\t            and action[0] == 6\n    46\t            and action[1] <= 5\n    47\t            and int(env.frame()[action[2]][action[1]]) != 8\n    48\t        ):\n    49\t            visible = controls(env.frame())\n    50\t            if visible:\n    51\t                candidate = visible[0]\n    52\t                repairs.append((step, action, candidate))\n    53\t        env.step(*candidate)\n    54\t        route.append(candidate)\n    55\t        if env.terminal() or env.levels_completed > base_level:\n    56\t            print(\"FINAL_CORRIDOR_EARLY\", step, candidate, summary(env))\n    57\t            return\n    58\t    print(\n    59\t        \"FINAL_CORRIDOR_ROOT\", FLAGS, tuple(AMBIGUOUS), repairs,\n    60\t        summary(env), flush=True,\n    61\t    )\n    62\t\n    63\t    clean_root = env.clone()\n    64\t    clean_variants = {\n    65\t        \"roundtrip\": [RIGHT] * 3 + [LEFT] * 4,\n    66\t        \"right_release_left\": [RIGHT] * 3 + [(7,)] + [LEFT] * 4,\n    67\t        \"right_two_release_left\": (\n    68\t            [RIGHT] * 3 + [(7,), (7,)] + [LEFT] * 4\n    69\t        ),\n    70\t        \"right_left_release_left\": (\n    71\t            [RIGHT] * 3 + [LEFT, (7,)] + [LEFT] * 4\n    72\t        ),\n    73\t        \"right_wait_left\": (\n    74\t            [RIGHT] * 3 + [(6, 9, 3)] + [LEFT] * 4\n    75\t        ),\n    76\t    }\n    77\t    for name, suffix in clean_variants.items():\n    78\t        node = clean_root.clone()\n    79\t        for action in suffix:\n    80\t            node.step(*action)\n    81\t            if node.terminal() or node.levels_completed > base_level:\n    82\t                break\n    83\t        print(\n    84\t            \"FINAL_CORRIDOR_CLEAN\", name, suffix, summary(node), flush=True,\n    85\t        )\n    86\t        if node.levels_completed > base_level:\n    87\t            print(\"FINAL_CORRIDOR_WIN\", [*route, *suffix], flush=True)\n    88\t            return\n    89\t\n    90\t    release_states = {}\n    91\t    for rights in (0, 3):\n    92\t        for releases in range(31):\n    93\t            node = clean_root.clone()\n    94\t            suffix = [RIGHT] * rights + [(7,)] * releases + [LEFT] * 4\n    95\t            for action in suffix:\n    96\t                node.step(*action)\n    97\t                if node.terminal() or node.levels_completed > base_level:\n    98\t                    break\n    99\t            if node.levels_completed > base_level:\n   100\t                print(\n   101\t                    \"FINAL_CORRIDOR_WIN\", [*route, *suffix], flush=True,\n   102\t                )\n   103\t                return\n   104\t            if node.terminal():\n   105\t                continue\n   106\t            for control in controls(node.frame()):\n   107\t                child = node.clone()\n   108\t                child.step(*control)\n   109\t                if child.levels_completed > base_level:\n   110\t                    print(\n   111\t                        \"FINAL_CORRIDOR_WIN\",\n   112\t                        [*route, *suffix, control], flush=True,\n   113\t                    )\n   114\t                    return\n   115\t            state = summary(node)\n   116\t            release_states.setdefault(state, (rights, releases))\n   117\t    print(\n   118\t        \"FINAL_CORRIDOR_RELEASES\", len(release_states), flush=True,\n   119\t    )\n   120\t    for state, witness in release_states.items():\n   121\t        print(\"FINAL_CORRIDOR_RELEASE_STATE\", witness, state, flush=True)\n   122\t\n   123\t    for index, action in enumerate(\n   124\t        [\n   125\t            RIGHT, RIGHT, RIGHT,\n   126\t            click_action(6, 4), LEFT,\n   127\t            click_action(6, 3), LEFT,\n   128\t            click_action(6, 2), LEFT,\n   129\t            LEFT, LEFT,\n   130\t        ],\n   131\t        1,\n   132\t    ):\n   133\t        env.step(*action)\n   134\t        route.append(action)\n   135\t        print(\"FINAL_CORRIDOR_STEP\", index, action, summary(env), flush=True)\n   136\t        if env.terminal() or env.levels_completed > base_level:\n   137\t            if env.levels_completed > base_level:\n   138\t                print(\"FINAL_CORRIDOR_WIN\", route, flush=True)\n   139\t            return\n   140\t\n   141\t    frame = np.asarray(env.frame())\n   142\t    local = [LEFT, RIGHT, (7,), *controls(frame)]\n   143\t    for row in range(10):\n   144\t        for col in range(8):\n   145\t            color = int(frame[3 + 6 * row][15 + 6 * col])\n   146\t            if color in (12, 14, 15):\n   147\t                local.append(click_action(row, col))\n   148\t    for action in dict.fromkeys(local):\n   149\t        child = env.clone()\n   150\t        child.step(*action)\n   151\t        if child.levels_