t                previous = current\n   197\t                gained += advance(child, [direction])\n   198\t\n   199\t\n   200\tif __name__ == \"__main__\":\n   201\t    levels, path, err = A.run_program(\"bp35\", probe)\n   202\t    print(\"RESULT\", levels, len(path), err)\n     1\t{\n     2\t  \"version\": \"bp35-l7-winning-route-recovery-v1\",\n     3\t  \"created_at\": \"2026-07-28T00:25:00Z\",\n     4\t  \"basis\": {\n     5\t    \"kind\": \"same-lineage immutable proposer observation\",\n     6\t    \"turn_sha256\": \"b4d433a2783d42123d377d86c8e22296313a3b4eebd1a5d69af33cb67be30635\",\n     7\t    \"note\": \"The clean turn reached L7 twice under the public harness before a false-positive taint verdict prevented snapshot/promotion. This scaffold transcribes only its already-observed action route and replay results; it contains no source, environment file, private runtime state, or external solution.\"\n     8\t  },\n     9\t  \"objective\": \"Reconstruct a current winning source from the already verified route, replay it independently, and let normal orphan/promotion gates capture a new exact source boundary.\",\n    10\t  \"verified_results\": [\n    11\t    \"Exact parent: L6 at 196 actions.\",\n    12\t    \"Two clean public-harness runs reported RESULT levels=7 moves=256 replay_ok=True err=None.\",\n    13\t    \"At the final staged side-room state, four LEFT actions followed by clicking the lowest visible gravity switch increased reward from 0 to 1.\"\n    14\t  ],\n    15\t  \"implementation_witness\": {\n    16\t    \"original_leg_name\": \"cross_staged_gravity_zigzag\",\n    17\t    \"original_helper_name\": \"_lowest_gravity_switch\",\n    18\t    \"player_composition\": \"play_level_7 called cross_staged_gravity_zigzag\",\n    19\t    \"instruction\": \"Reproduce this route with gkm_try.py before retaining it. The final switch must be selected from the current public frame, not hard-coded from hidden state.\"\n    20\t  },\n    21\t  \"route_notatio