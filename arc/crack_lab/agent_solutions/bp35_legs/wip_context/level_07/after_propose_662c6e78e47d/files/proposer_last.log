rception.py:127:    base = arr(env.frame()).copy()\nperception.py:129:    for action in actions:\nperception.py:130:        clone = env.clone()\nperception.py:131:        clone.step(action)\nperception.py:132:        out[int(action)] = frame_delta(base, clone.frame())\nperception.py:136:def replay(env, actions: Sequence[int]):\nperception.py:137:    clone = env.clone()\nperception.py:138:    for action in actions:\nperception.py:139:        if clone.terminal():\nperception.py:141:        clone.step(int(action))\nperception.py:142:    return clone\nperception.py:145:def path_result(env, actions: Sequence[int]) -> dict:\nperception.py:146:    clone = replay(env, actions)\nperception.py:148:        \"levels_completed\": int(clone.levels_completed),\nperception.py:149:        \"terminal\": bool(clone.terminal()),\nperception.py:150:        \"path_len\": len(actions),\nperception.py:151:        \"colors\": color_counts(clone.frame()),\nperception.py:152:        \"objects\": object_candidates(clone.frame()),\nperception.py:156:def changed_signature(env, actions: Sequence[int], cell: int = 4):\nperception.py:157:    before = block_signatures(env.frame(), cell)\nperception.py:158:    clone = replay(env, actions)\nperception.py:159:    after = block_signatures(clone.frame(), cell)\nperception.py:164:def bounded_bfs(env, goal_fn, actions: Sequence[int] = (UP, DOWN, LEFT, RIGHT, USE),\nperception.py:166:    \"\"\"Generic clone BFS over observational keys. Use small max_states first.\"\"\"\nperception.py:168:        key_fn = lambda e: arr(e.frame()).tobytes()\nperception.py:170:    q = deque([(env.clone(), [])])\nperception.py:178:        for action in actions:\nperception.py:179:            child = node.clone()\nperception.py:180:            child.step(int(action))\nperception.py:189:def bounded_replay_bfs(env, goal_fn, action_fn,\nperception.py:191:    \"\"\"Path-only BFS for games whose deep Arena clones become expensive.\nperception.py:194:    states. Each node is reconstructed from one root clone. ``action_fn(node)``\nperception.py:195:    may return integer actions or coordinate tuples such as ``(6, x, y)``.\nperception.py:198:        key_fn = lambda e: arr(e.frame()).tobytes()\nperception.py:201:        node = env.clone()\nperception.py:204:                node.step(*action)\nperception.py:206:                node.step(int(action))\nperception.py:232:def level_goal(base_level: int):\ngkm_try.py:8:spec = importlib.util.spec_from_file_location(\"solve\", \"solve.py\")\ngkm_try.py:10:def resumed_solve(env):\ngkm_try.py:12:    # Prefix optimization must replay the edited solver from level 1 without\ngkm_try.py:13:    # mutating the supervisor-owned campaign checkpoint.\ngkm_try.py:14:    if os.environ.get(\"GKM_FRESH_REPLAY\") != \"1\" and os.path.exists(\"checkpoint.json\"):\ngkm_try.py:15:        with open(\"checkpoint.json\") as f:\ngkm_try.py:19:            env.step(act)\ngkm_try.py:20:    m.solve(env)\ngkm_try.py:21:levels, path, err = A.run_program('bp35', resumed_solve)\n      23 gkm_try.py\n      33 probe_level7_reuse.py\n      33 players.py\n     621 legs.py\n     233 perception.py\n     943 total\n","exit_code":0,"status":"completed"}}
