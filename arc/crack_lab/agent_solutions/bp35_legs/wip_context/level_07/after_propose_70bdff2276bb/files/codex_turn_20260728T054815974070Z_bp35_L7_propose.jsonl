 x in range(1, 63):\n    74\t            if (\n    75\t                int(pixels[y, x]) == 12\n    76\t                and abs(x - ax) <= 7\n    77\t                and abs(y - ay) <= 24\n    78\t                and all(\n    79\t                    int(pixels[y + dy, x + dx]) == 12\n    80\t                    for dy, dx in ((-1, -1), (-1, 1), (1, -1), (1, 1))\n    81\t                )\n    82\t                and all(\n    83\t                    int(pixels[y + dy, x + dx]) != 12\n    84\t                    for dy, dx in ((-1, 0), (1, 0), (0, -1), (0, 1))\n    85\t                )\n    86\t            ):\n    87\t                targets.add((x, y))\n    88\t    for blob in connected_components(frame, colors=(12, 14), min_area=6):\n    89\t        x = int(round(blob.centroid[1]))\n    90\t        y = int(round(blob.centroid[0]))\n    91\t        if abs(x - ax) <= 7 and abs(y - ay) <= 24:\n    92\t            targets.add((x, y))\n    93\t    return [(CLICK, x, y) for x, y in sorted(targets)]\n    94\t\n    95\t\n    96\tdef choices(frame):\n    97\t    out = [LEFT, RIGHT]\n    98\t    control = control_action(frame)\n    99\t    if control is not None:\n   100\t        out.append(control)\n   101\t    out.extend(support_actions(frame))\n   102\t    return out\n   103\t\n   104\t\n   105\tdef observation_key(frame, gravity):\n   106\t    return np.asarray(frame)[:63].tobytes(), gravity\n   107\t\n   108\t\n   109\tdef evaluate(path, gravity):\n   110\t    result = {}\n   111\t\n   112\t    def callback(env):\n   113\t        for action in PREFIX:\n   114\t            env.step(action)\n   115\t        for action in path:\n   116\t            if env.terminal():\n   117\t                break\n   118\t            env.step(*action)\n   119\t        if env.terminal():\n   120\t            result[\"children\"] = []\n   121\t            return\n   122\t        before = env.frame()\n   123\t        base_level = int(env.levels_completed)\n   124\t        children = []\n  