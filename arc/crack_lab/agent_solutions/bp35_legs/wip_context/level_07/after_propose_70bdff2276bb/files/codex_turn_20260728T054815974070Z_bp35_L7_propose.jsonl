      if flipped.levels_completed > 6:\n    83\t                    print(\"WIN_FIRST\", late, pre, y1, flush=True)\n    84\t                    return\n    85\t                if flipped.terminal():\n    86\t                    continue\n    87\t                first_key = (\n    88\t                    base_height + gain1,\n    89\t                    avatar_cell(flipped.frame()),\n    90\t                    tuple(controls(flipped.frame())),\n    91\t                )\n    92\t                outcomes.setdefault(\n    93\t                    first_key, (late, [*pre, (6, 3, y1)])\n    94\t                )\n    95\t                for post in WALKS:\n    96\t                    middle = flipped.clone()\n    97\t                    gain2 = gain1 + advance(middle, post)\n    98\t                    if middle.levels_completed > 6:\n    99\t                        print(\n   100\t                            \"WIN_WALK\", late, pre, y1, post, flush=True\n   101\t                        )\n   102\t                        return\n   103\t                    if middle.terminal():\n   104\t                        continue\n   105\t                    middle_key = (\n   106\t                        base_height + gain2,\n   107\t                        avatar_cell(middle.frame()),\n   108\t                        tuple(controls(middle.frame())),\n   109\t                    )\n   110\t                    path = [*pre, (6, 3, y1), *post]\n   111\t                    outcomes.setdefault(middle_key, (late, path))\n   112\t                    for y2 in controls(middle.frame()):\n   113\t                        child = middle.clone()\n   114\t                        gain3 = gain2 + advance(child, [(6, 3, y2)])\n   115\t                        if child.levels_completed > 6:\n   116\t                            print(\n   117\t                                \"WIN_SECOND\", late, path, y2, flush=True\n   118\t                            )\n   119\t                            return