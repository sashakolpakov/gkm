          )\n   203\t        return\n   204\t\n   205\t    representatives = {}\n   206\t    counts = Counter()\n   207\t    for support in (\n   208\t        click_action(5, 2),\n   209\t        click_action(5, 4),\n   210\t        click_action(6, 2),\n   211\t        click_action(6, 4),\n   212\t        click_action(7, 2),\n   213\t        click_action(7, 3),\n   214\t        click_action(7, 4),\n   215\t    ):\n   216\t        supported = root.clone()\n   217\t        support_gain = 0 if support is None else step(supported, support)\n   218\t        if supported.terminal():\n   219\t            continue\n   220\t        for normal in ((4,),):\n   221\t            staged = supported.clone()\n   222\t            gained0 = support_gain if normal is None else support_gain + step(staged, normal)\n   223\t            if staged.terminal():\n   224\t                continue\n   225\t            for y1 in controls(staged.frame()):\n   226\t                flipped = staged.clone()\n   227\t                gained1 = gained0 + step(flipped, (6, 3, y1))\n   228\t                if flipped.levels_completed > 6:\n   229\t                    print(\"WIN\", (support, normal, (6, 3, y1)))\n   230\t                    return\n   231\t                if flipped.terminal():\n   232\t                    continue\n   233\t                for cross in ((3,), (4,)):\n   234\t                    middle = flipped.clone()\n   235\t                    gained2 = gained1 + step(middle, cross)\n   236\t                    if middle.levels_completed > 6:\n   237\t                        print(\"WIN\", (support, normal, (6, 3, y1), cross))\n   238\t                        return\n   239\t                    if middle.terminal():\n   240\t                        continue\n   241\t                    for y2 in controls(middle.frame()):\n   242\t                        child = middle.clone()\n   243\t                        gained = gained2 + step(child, (6, 3, y2))\n   244\t                        