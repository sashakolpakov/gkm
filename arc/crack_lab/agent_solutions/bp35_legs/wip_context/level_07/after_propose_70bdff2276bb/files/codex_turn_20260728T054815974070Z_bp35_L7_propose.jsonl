rminal\": bool(env.terminal()),\n    55\t                \"avatar\": avatar_position(env.frame()),\n    56\t                \"actors\": actors(env.frame()),\n    57\t            },\n    58\t        )\n    59\t        if env.terminal() or env.levels_completed > base_level:\n    60\t            break\n    61\t\n    62\t\n    63\tarena.run_program(\"bp35\", probe)\n     1\timport json\n     2\timport os\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as A\n     7\timport gkm_legs as G\n     8\t\n     9\tfrom probe_level7_coordinate_decode import advance\n    10\tfrom probe_level7_decode_frontiers import build_route\n    11\tfrom probe_level7_reward_recovery import avatar_cell, controls, lattice\n    12\t\n    13\t\n    14\tif G._workspace_taint_reason(os.getcwd()):\n    15\t    raise SystemExit(\"tainted workspace\")\n    16\t\n    17\t\n    18\tLATE = (True, False, True, False, True)\n    19\tWALKS = [\n    20\t    [],\n    21\t    [(3,)], [(3,), (3,)], [(3,), (3,), (3,)],\n    22\t    [(4,)], [(4,), (4,)], [(4,), (4,), (4,)],\n    23\t]\n    24\t\n    25\t\n    26\tdef probe(env):\n    27\t    with open(\"checkpoint.json\") as stream:\n    28\t        checkpoint = json.load(stream)\n    29\t    for action in checkpoint[\"final_path\"]:\n    30\t        env.step(action)\n    31\t    with open(\"frontier_scaffold.json\") as stream:\n    32\t        raw_route = json.load(stream)[\"staged_prefix_actions\"]\n    33\t\n    34\t    route = [\n    35\t        *build_route(raw_route, LATE),\n    36\t        (3,), (3,), (3,), (3,),\n    37\t        (6, 27, 27),\n    38\t        (3,),\n    39\t        (6, 3, 27),\n    40\t    ]\n    41\t    root = env.clone()\n    42\t    height = advance(root, route)\n    43\t    print(\n    44\t        \"ROOT\", len(route), height, root.levels_completed, root.terminal(),\n    45\t        avatar_cell(root.frame()), controls(root.frame()), lattice(root.frame()),\n    46\t    )\n    47\t    outcomes = {}\n    48\t    for pre in WALKS:\n    49\t        staged = root.clone()\n    50\t        pre_gain = advance(staged, pre)\n    51\t        if staged.terminal():\n    52\t            continue\n    53\t        for y1 in controls(staged.frame()):\n    54\t            flipped = staged.clone()\n    55\t            gain1 = pre_gain + advance(flipped, [(6, 3, y1)])\n    56\t            if flipped.levels_completed > 6:\n    57\t                print(\"WIN_FIRST\", pre, y1, flush=True)\n    58\t                return\n    59\t            if flipped.terminal():\n    60\t                continue\n    61\t            path1 = [*pre, (6, 3, y1)]\n    62\t            outcomes.setdefault(\n    63\t                (\n    64\t                    height + gain1,\n    65\t                    avatar_cell(flipped.frame()),\n    66\t                    tuple(controls(flipped.frame())),\n    67\t                    lattice(flipped.frame()),\n    68\t                ),\n    69\t                path1,\n    70\t            )\n    71\t            for post in WALKS:\n    72\t                middle = flipped.clone()\n    73\t                gain2 = gain1 + advance(middle, post)\n    74\t                if middle.levels_completed > 6:\n    75\t                    print(\"WIN_WALK\", path1, post, flush=True)\n    76\t                    return\n    77\t                if middle.terminal():\n    78\t                    continue\n    79\t                path2 = [*path1, *post]\n    80\t                outcomes.setdefault(\n    81\t                    (\n    82\t                        height + gain2,\n    83\t                        avatar_cell(middle.frame()),\n    84\t                        tuple(controls(middle.frame())),\n    85\t                        lattice(middle.frame()),\n    86\t                    ),\n    87\t                    path2,\n    88\t                )\n    89\t                for y2 in controls(middle.frame()):\n    90\t                    child = middle.clone()\n    91\t                    gain3 = gain2 + advance(child, [(6, 3, y2)])\n    92\t                    if child.levels_completed > 6:\n    93\t                        print(\"WIN_SECOND\", path2, y2, flush=True)\n    94\t                        return\n    95\t                    if child.terminal():\n    96\t                        continue\n    97\t                    outcomes.setdefault(\n    98\t                        (\n    99\t                            height + gain3,\n   100\t                            avatar_cell(child.frame()),\n   101\t                            tuple(controls(child.frame())),\n   102\t                            lattice(child.frame()),\n   103\t                        ),\n   104\t                        [*path2, (6, 3, y2)],\n   105\t                    )\n   106\t    ordered = sorted(\n   107\t        outcomes.items(),\n   108\t        key=lambda item: (-item[0][0], -len(item[0][2])),\n   109\t    )\n   110\t    print(\"NO_CHAIN_WIN\", len(ordered))\n   111\t    for state, path in ordered:\n   112\t        print(\"OPTION\", state[:3], path, state[3])\n   113\t\n   114\t\n   115\tlevels, path, err = A.run_program(\"bp35\", probe)\n   116\tprint(\"RESULT\", levels, len(path), err)\n     1\t\"\"\"Find initial supports that make the direct right-shaft descent survivable.\"\"\"\n     2\t\n     3\tfrom itertools import combinations\n     4\timport json\n     5\timport os\n     6\timport sys\n     7\t\n     8\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     9\timport gkm_arena as arena\n    10\t\n    11\tfrom legs import COL_ANCHORS, ROW_ANCHORS, run_actions\n    12\tfrom probe_l7_frontier import R, avatar, summary\n    13\t\n    14\t\n    15\tUPPER = [(row, column) for row in range(5) for column in range(2, 5)]\n    16\t\n    17\t\n    18\tdef action(cell):\n    19\t    row, column = cell\n    20\t    return 6, COL_ANCHORS[column], ROW_ANCHORS[row]\n    21\t\n    22\t\n    23\tDESCEND = [\n    24\t    R,\n    25\t    R,\n    26\t    R,\n    27\t    action((8, 4)),\n    28\t    (6, 3, 3),\n    29\t    R,\n    30\t    R,\n    31\t]\n    32\t\n    33\t\n    34\tdef probe(env):\n    35\t    with open(\"checkpoint.json\") as stream:\n    36\t        prefix = json.load(stream)[\"final_path\"]\n    37\t    for step in prefix:\n    38\t        env.step(step)\n    39\t    root = env.clone()\n    40\t    base_level = int(env.levels_completed)\n    41\t    survivors = []\n    42\t    min_size = int(os.environ.get(\"MIN_STAGE\", \"0\"))\n    43\t    max_size = int(os.environ.get(\"MAX_STAGE\", \"2\"))\n    44\t    for size in range(min_size, max_size + 1):\n    45\t        for staged in combinations(UPPER, size):\n    46\t            node = root.clone()\n    47\t            run_actions(node, [action(cell) for cell in staged] + DESCEND)\n    48\t            if node.terminal() or avatar(node.frame()) is None:\n    49\t                continue\n    50\t            state = summary(node)\n    51\t            survivors.append(\n    52\t                {\n    53\t                    \"staged\": staged,\n    54\t                    \"level_delta\": int(node.levels_completed) - base_level,\n    55\t                    \"avatar\": state[\"avatar\"],\n    56\t                    \"grid\": state[\"grid\"],\n    57\t                }\n    58\t            )\n    59\t    print(\n    60\t        \"RESULT\",\n    61\t        {\n    62\t            \"tested_through\": max_size,\n    63\t            \"survivors\": len(survivors),\n    64\t            \"items\": survivors,\n    65\t        },\n    66\t    )\n    67\t\n    68\t\n    69\tarena.run_program(\"bp35\", probe)\n","exit_code":0,"status":"completed"}}
