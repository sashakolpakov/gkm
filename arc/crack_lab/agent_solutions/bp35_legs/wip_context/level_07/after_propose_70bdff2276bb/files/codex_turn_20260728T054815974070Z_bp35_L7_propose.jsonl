   area = sum(\n    48\t        int(frame[row][column]) == color\n    49\t        for row in range(r0, min(63, r0 + BAND))\n    50\t        for column in range(c0, c0 + BAND)\n    51\t    )\n    52\t    return color, area\n    53\t\n    54\t\n    55\tdef symbol(frame, i, j):\n    56\t    color, area = cell_shape(frame, i, j)\n    57\t    if color in (3, 5):\n    58\t        return \"#\"\n    59\t    if color == 10:\n    60\t        return \".\"\n    61\t    if color in (9, 11):\n    62\t        return \"A\"\n    63\t    if color == 12:\n    64\t        return \"X\" if area > 5 else \"x\"\n    65\t    if color == 15:\n    66\t        return \"P\"\n    67\t    if color == 8:\n    68\t        return \"g\"\n    69\t    if color == 0:\n    70\t        return \"0\"\n    71\t    return \"?\"\n    72\t\n    73\t\n    74\tdef summary(node):\n    75\t    frame = node.frame()\n    76\t    return {\n    77\t        \"terminal\": bool(node.terminal()),\n    78\t        \"avatar\": avatar(frame),\n    79\t        \"grid\": [\n    80\t            \"\".join(symbol(frame, row, column) for column in range(8))\n    81\t            for row in range(10)\n    82\t        ],\n    83\t        \"supports\": [\n    84\t            (blob.bbox, blob.area)\n    85\t            for blob in connected_components(frame, colors=(12,), min_area=3)\n    86\t            if blob.bbox[0] < 63\n    87\t        ],\n    88\t        \"controls\": [\n    89\t            (blob.bbox, blob.area)\n    90\t            for blob in connected_components(frame, colors=(8,), min_area=3)\n    91\t            if blob.bbox[0] < 63\n    92\t        ],\n    93\t        \"objects\": [\n    94\t            (blob.color, blob.bbox, blob.area)\n    95\t            for blob in connected_components(\n    96\t                frame, colors=(7, 8, 9, 11, 12, 14, 15), min_area=3\n    97\t            )\n    98\t            if blob.bbox[0] < 63\n    99\t        ],\n   100\t    }\n   101\t\n   102\t\n   103\tdef choices(frame):\n   104\t