{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_l7_seed_controls.py | sed -n '1,240p'\nnl -ba probe_level7_clean.py | sed -n '1,240p'\"","aggregated_output":"     1\t\"\"\"Compact control-action probes from the reproduced 38-step level-7 state.\"\"\"\n     2\t\n     3\timport json\n     4\timport sys\n     5\t\n     6\timport numpy as np\n     7\t\n     8\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     9\timport gkm_arena as arena\n    10\t\n    11\tfrom legs import band_grid, band_shift, run_actions\n    12\tfrom perception import color_counts, connected_components, frame_delta\n    13\tfrom probe_l7_raw_search import SEED, avatar_position\n    14\t\n    15\t\n    16\tdef compact(frame):\n    17\t    controls = [\n    18\t        (blob.bbox, blob.area, tuple(round(value, 1) for value in blob.centroid))\n    19\t        for blob in connected_components(frame, colors=(8,), min_area=2)\n    20\t        if blob.bbox[0] < 63\n    21\t    ]\n    22\t    return {\n    23\t        \"avatar\": avatar_position(frame),\n    24\t        \"colors\": color_counts(frame),\n    25\t        \"corners\": [int(frame[y][x]) for y, x in ((0, 0), (0, 3), (3, 3))],\n    26\t        \"controls\": controls,\n    27\t        \"grid\": [list(row) for row in band_grid(frame)],\n    28\t    }\n    29\t\n    30\t\n    31\tdef probe(env):\n    32\t    with open(\"checkpoint.json\") as stream:\n    33\t        prefix = json.load(stream)[\"final_path\"]\n    34\t    for action in prefix:\n    35\t        env.step(action)\n    36\t    print(\"INITIAL\", compact(env.frame()))\n    37\t    run_actions(env, SEED)\n    38\t    print(\"SEED\", compact(env.frame()))\n    39\t\n    40\t    targets = {(0, 0)}\n    41\t    for blob in connected_components(env.frame(), colors=(8,), min_area=2):\n    42\t        if blob.bbox[0] >= 63:\n    43\t            continue\n    44\t        y, x = blob.centroid\n    45\t        targets.add((int(round(x)), int(round(y))))\n    46\t    for kind in (6, 7):\n    47\t        for x, y in sorted(targets):\n    48\t            node = env.clone()\n    49\t            before = np.asarray(node.frame()).copy()\n    50\t            node.step(kind, x, y)\n    51\t            after = np.asarray(node.frame())\n    52\t            print(\n    53\t                \"TRY\",\n    54\t                (kind, x, y),\n    55\t                {\n    56\t                    \"terminal\": bool(node.terminal()),\n    57\t                    \"avatar\": avatar_position(after),\n    58\t                    \"rise\": band_shift(before, after),\n    59\t                    \"delta\": frame_delta(before[:63], after[:63]),\n    60\t                    \"state\": compact(after),\n    61\t                },\n    62\t            )\n    63\t\n    64\t\n    65\tarena.run_program(\"bp35\", probe)\n     1\timport importlib.util\n     2\timport os\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as A\n     7\timport gkm_legs as G\n     8\t\n     9\tfrom legs import COL_ANCHORS, ROW_ANCHORS, _cell_shape, band_shift\n    10\tfrom perception import connected_components, frame_delta\n    11\t\n    12\t\n    13\tif G._workspace_taint_reason(os.getcwd()):\n    14\t    raise SystemExit(\"tainted workspace\")\n    15\t\n    16\t\n    17\tdef load_solver():\n    18\t    spec = importlib.util.spec_from_file_location(\"clean_solve\", \"solve.py\")\n    19\t    module = importlib.util.module_from_spec(spec)\n    20\t    spec.loader.exec_module(module)\n    21\t    return module.solve\n    22\t\n    23\t\n    24\tdef avatar(frame):\n    25\t    blobs = connected_components(frame, colors=(9, 11), min_area=2)\n    26\t    return [(blob.color, blob.bbox, blob.area) for blob in blobs]\n    27\t\n    28\t\n    29\tdef lattice(frame):\n    30\t    palette = {\n    31\t        3: \"#\", 5: \"#\", 8: \"g\", 9: \"A\", 10: \".\", 11: \"A\",\n    32\t        12: \"c\", 14: \"Y\", 15: \"f\",\n    33\t    }\n    34\t    return \"/\".join(\n    35\t        \"\".join(palette.get(int(frame[y][x]), \"?\") for x in COL_ANCHORS)\n    36\t        for y in ROW_ANCHORS\n    37\t    )\n    38\t\n    39\t\n    40\tdef result(base, node):\n    41\t    return (\n    42\t        node.levels_completed,\n    43\t        node.terminal(),\n    44\t        avatar(node.frame()),\n    45\t        band_shift(base, node.frame()),\n    46\t        frame_delta(base, node.frame())[\"count\"],\n    47\t    )\n    48\t\n    49\t\n    50\tdef probe(env):\n    51\t    load_solver()(env)\n    52\t    base = env.frame()\n    53\t    print(\"START\", env.levels_completed, env.actions, avatar(base), lattice(base))\n    54\t\n    55\t    for action in (3, 4, 7):\n    56\t        node = env.clone()\n    57\t        node.step(action)\n    58\t        print(\"KEY\", action, result(base, node))\n    59\t\n    60\t    changed = []\n    61\t    for i, y in enumerate(ROW_ANCHORS):\n    62\t        for j, x in enumerate(COL_ANCHORS):\n    63\t            node = env.clone()\n    64\t            node.step(6, x, y)\n    65\t            delta = frame_delta(base, node.frame())\n    66\t            if delta[\"count\"] > 64:\n    67\t                changed.append(\n    68\t                    (i, j, _cell_shape(base, i, j), result(base, node))\n    69\t                )\n    70\t    print(\"CLICKS\", changed)\n    71\t\n    72\t\n    73\tlevels, path, err = A.run_program(\"bp35\", probe)\n    74\tprint(\"RESULT\", levels, len(path), err)\n","exit_code":0,"status":"completed"}}
