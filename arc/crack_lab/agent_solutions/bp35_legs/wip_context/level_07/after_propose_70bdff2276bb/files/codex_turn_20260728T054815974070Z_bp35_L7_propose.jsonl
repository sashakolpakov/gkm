{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba legs.py | sed -n '1,120p'\nnl -ba legs.py | sed -n '460,625p'\"","aggregated_output":"     1\t# Shared leg library: small, named, reusable skills.\n     2\t# Players import from here; add a NEW leg only when no existing leg fits.\n     3\t#\n     4\t# Substrate observed on bp35 (raw frames only):\n     5\t#   * The 64x64 frame is a 6px band lattice: cell (i, j) is sampled at\n     6\t#     (3 + 6i, 15 + 6j) -> a 10 x 8 symbolic grid.\n     7\t#   * Row 63 is a move counter (one non-zero pixel per action taken).\n     8\t#   * The avatar always renders on band row 6; the world scrolls instead.\n     9\t#     After every action the avatar RISES through open cells until blocked,\n    10\t#     so height is gained by opening the cell above it.\n    11\t#   * Action 3 = step left one column, 4 = step right one column.\n    12\t#     Action 6 with (x, y) pixel coordinates clicks a cell; clicking a\n    13\t#     removable block (colour 14) turns it into open floor. Any other click\n    14\t#     is a no-op that still burns a move.\n    15\t#   * A floor rises from below one band every two moves and kills on contact,\n    16\t#     so climbing must outpace the move counter.\n    17\t#   * Reaching a prize cell (a colour outside the terrain palette) on the\n    18\t#     avatar's row completes the level.\n    19\t#   * Off-palette colours are NOT always prizes: from L2 on they are also\n    20\t#     hazards that hang below their own band, so resting under one kills while\n    21\t#     touching one sideways is simply solid. Nothing here models which is\n    22\t#     which -- a clone probe decides, and dead successors are dropped.\n    23\t#   * The world scrolls whenever the avatar rises, so any plan longer than one\n    24\t#     action goes stale. Walk and climb legs re-read the frame every step.\n    25\t\n    26\timport heapq\n    27\timport itertools\n    28\tfrom collections import deque\n    29\t\n    30\tBAND = 6\n    31\tGRID_ROWS = 10\n    32\tGRID_COLS = 8\n    33\tROW_ANCHORS = [3 + BAND * i for i in range(GRID_ROWS)]\n    34\tCOL_ANCHORS = [15 + BAND * j for j in range(GRID_COLS)]\n    35\tAVATAR_ROW = 6\n    36\t\n    37\tWALL_COLORS = (3, 5)\n    38\tOPEN_COLORS = (10,)\n    39\tBLOCK_COLORS = (14,)\n    40\tAVATAR_COLORS = (9, 11)\n    41\t\n    42\tWALL, OPEN, BLOCK, AVATAR, PRIZE = '#', ' ', 'Y', 'A', '*'\n    43\t\n    44\tLEFT, RIGHT, CLICK = 3, 4, 6\n    45\t\n    46\t\n    47\t# --- observation legs -------------------------------------------------\n    48\t\n    49\tdef cell_symbol(color):\n    50\t    \"\"\"Classify one raw colour into the terrain alphabet.\"\"\"\n    51\t    color = int(color)\n    52\t    if color in WALL_COLORS:\n    53\t        return WALL\n    54\t    if color in OPEN_COLORS:\n    55\t        return OPEN\n    56\t    if color in BLOCK_COLORS:\n    57\t        return BLOCK\n    58\t    if color in AVATAR_COLORS:\n    59\t        return AVATAR\n    60\t    return PRIZE\n    61\t\n    62\t\n    63\tdef band_grid(frame):\n    64\t    \"\"\"Quantise a frame onto the 6px band lattice as a symbolic grid.\"\"\"\n    65\t    return [[cell_symbol(frame[r][c]) for c in COL_ANCHORS] for r in ROW_ANCHORS]\n    66\t\n    67\t\n    68\tdef avatar_column(frame):\n    69\t    \"\"\"Column index of the avatar on its fixed band row, or None if gone.\"\"\"\n    70\t    row = band_grid(frame)[AVATAR_ROW]\n    71\t    for j, sym in enumerate(row):\n    72\t        if sym == AVATAR:\n    73\t            return j\n    74\t    return None\n    75\t\n    76\t\n    77\tdef moves_used(frame):\n    78\t    \"\"\"Actions consumed so far, read off the counter strip in row 63.\"\"\"\n    79\t    return sum(1 for v in frame[63] if int(v) != 0)\n    80\t\n    81\t\n    82\tdef find_symbol(grid, symbol, row=None):\n    83\t    \"\"\"All (i, j) cells carrying ``symbol``; optionally restricted to a row.\"\"\"\n    84\t    rows = range(GRID_ROWS) if row is None else (row,)\n    85\t    return [(i, j) for i in rows for j in range(GRID_COLS) if grid[i][j] == symbol]\n    86\t\n    87\t\n    88\tdef band_shift(before, after):\n    89\t    \"\"\"Bands the camera scrolled between two frames, i.e. the height gained.\n    90\t\n    91\t    The camera pins the avatar to ``AVATAR_ROW``, so a rise shows up only as\n    92\t    the world sliding down. Scored by how many raw rows line up at each\n    93\t    candidate offset, which tolerates the cells the avatar itself repainted.\n    94\t    \"\"\"\n    95\t    rows_before = [tuple(int(v) for v in before[r]) for r in range(63)]\n    96\t    rows_after = [tuple(int(v) for v in after[r]) for r in range(63)]\n    97\t    best_hits, best = -1, 0\n    98\t    for bands in range(GRID_ROWS):\n    99\t        offset = BAND * bands\n   100\t        hits = sum(1 for r in range(63 - offset)\n   101\t                   if rows_before[r] == rows_after[r + offset])\n   102\t        if hits > best_hits:\n   103\t            best_hits, best = hits, bands\n   104\t    return best\n   105\t\n   106\t\n   107\t# --- action legs ------------------------------------------------------\n   108\t\n   109\tdef click_cell(env, i, j):\n   110\t    \"\"\"Click band cell (i, j); removes a removable block, else burns a move.\"\"\"\n   111\t    env.step(CLICK, COL_ANCHORS[j], ROW_ANCHORS[i])\n   112\t\n   113\t\n   114\tdef act(env, action, log=None):\n   115\t    \"\"\"Apply one action tuple -- ``(key,)`` or ``(CLICK, x, y)`` -- and record it.\"\"\"\n   116\t    env.step(*action)\n   117\t    if log is not None:\n   118\t        log.append(action)\n   119\t\n   120\t\n   460\tdef gravity_room_search(env, max_states=900, max_depth=48, debug=False):\n   461\t    \"\"\"Find a route through rooms controlled by gravity toggles and supports.\n   462\t\n   463\t    Movement is always considered.  Global gravity toggles (colour 8) can\n   464\t    appear either in the band grid or in the fixed left control strip.\n   465\t    Removable supports (14) and shape-changing supports (12) are useful only\n   466\t    when aligned near the avatar; hazards (15) only when nearby.\n   467\t    Reconstructing each state from one shallow root avoids chains of costly\n   468\t    nested clones.\n   469\t    \"\"\"\n   470\t    base_level = env.levels_completed\n   471\t    root = env.clone()\n   472\t\n   473\t    def avatar_cell(frame):\n   474\t        for i, r in enumerate(ROW_ANCHORS):\n   475\t            for j, c in enumerate(COL_ANCHORS):\n   476\t                if int(frame[r][c]) in AVATAR_COLORS:\n   477\t                    return i, j\n   478\t        return None\n   479\t\n   480\t    def choices(node):\n   481\t        frame = node.frame()\n   482\t        avatar = avatar_cell(frame)\n   483\t        out = [(LEFT,), (RIGHT,)]\n   484\t        if avatar is None:\n   485\t            return out\n   486\t        ai, aj = avatar\n   487\t        control_rows = [y for y in range(63) if int(frame[y][3]) == 8]\n   488\t        if control_rows:\n   489\t            run = [control_rows[0]]\n   490\t            for y in control_rows[1:]:\n   491\t                if y != run[-1] + 1:\n   492\t                    break\n   493\t                run.append(y)\n   494\t            out.append((CLICK, 3, run[len(run) // 2]))\n   495\t        for i, y in enumerate(ROW_ANCHORS):\n   496\t            for j, x in enumerate(COL_ANCHORS):\n   497\t                color = int(frame[y][x])\n   498\t                if color == 8 and abs(j - aj) <= 1:\n   499\t                    out.append((CLICK, x, y))\n   500\t                elif color in (12, 14) and abs(j - aj) <= 1 and abs(i - ai) <= 3:\n   501\t                    out.append((CLICK, x, y))\n   502\t                elif color == 15 and abs(i - ai) <= 1 and abs(j - aj) <= 1:\n   503\t                    out.append((CLICK, x, y))\n   504\t        return out\n   505\t\n   506\t    def state_key(node):\n   507\t        frame = node.frame()\n   508\t        cells = tuple(\n   509\t            _cell_shape(frame, i, j)\n   510\t            for i in range(GRID_ROWS)\n   511\t            for j in range(GRID_COLS)\n   512\t        )\n   513\t        return cells, moves_used(frame) % 2\n   514\t\n   515\t    def reconstruct(path):\n   516\t        node = root.clone()\n   517\t        run_actions(node, path)\n   518\t        return node\n   519\t\n   520\t    counter = itertools.count()\n   521\t    frontier = [(0, 0, next(counter), ())]\n   522\t    seen_progress = {state_key(root)}\n   523\t    expanded = 0\n   524\t\n   525\t    while frontier and expanded < max_states:\n   526\t        neg_height, _, _, prefix = heapq.heappop(frontier)\n   527\t        if debug:\n   528\t            print(\"macro\", -neg_height, len(prefix), expanded, len(frontier), prefix)\n   529\t        stage = reconstruct(prefix)\n   530\t        local_queue = deque([()])\n   531\t        local_seen = {state_key(stage)}\n   532\t\n   533\t        # Search the current room only until the camera rises.  Each distinct\n   534\t        # landing becomes a macro successor, so unsafe early toggles can still\n   535\t        # be backtracked without flattening the whole course into one BFS.\n   536\t        while local_queue and expanded < max_states:\n   537\t            suffix = local_queue.popleft()\n   538\t            path = prefix + suffix\n   539\t            node = stage.clone()\n   540\t            run_actions(node, suffix)\n   541\t            expanded += 1\n   542\t            if len(path) >= max_depth or node.terminal():\n   543\t                continue\n   544\t            for action in choices(node):\n   545\t                child = node.clone()\n   546\t                child.step(*action)\n   547\t                new_suffix = suffix + (action,)\n   548\t                new_path = prefix + new_suffix\n   549\t                if child.levels_completed > base_level:\n   550\t                    return list(new_path)\n   551\t                if child.terminal() or avatar_cell(child.frame()) is None:\n   552\t                    continue\n   553\t                key = state_key(child)\n   554\t                gain = max(0, band_shift(node.frame(), child.frame()))\n   555\t                if gain:\n   556\t                    if key in seen_progress:\n   557\t                        continue\n   558\t                    seen_progress.add(key)\n   559\t                    height = -neg_height + gain\n   560\t                    heapq.heappush(\n   561\t                        frontier,\n   562\t                        (-height, len(new_path), next(counter), new_path),\n   563\t                    )\n   564\t                elif len(new_suffix) < 12 and key not in local_seen:\n   565\t                    local_seen.add(key)\n   566\t                    local_queue.append(new_suffix)\n   567\t    return []\n   568\t\n   569\t\n   570\tdef solve_gravity_rooms(env, max_states=900, max_depth=48):\n   571\t    \"\"\"Plan context-safe gravity/support transitions, then commit the route.\"\"\"\n   572\t    return plan_and_commit(\n   573\t        env, gravity_room_search, max_states=max_states, max_depth=max_depth\n   574\t    )\n   575\t\n   576\t\n   577\tdef cross_persistent_support_rooms(env):\n   578\t    \"\"\"Stage remote supports, traverse alternating rooms, and reach the prize.\n   579\t\n   580\t    Some gravity courses scroll the starting supports off-screen long before\n   581\t    they are needed.  Expanding both first preserves a two-cell bridge in the\n   582\t    final lower chamber; the avatar can then cross it into the prize corridor.\n   583\t    \"\"\"\n   584\t    route = [\n   585\t        # Preserve the two starting supports for the otherwise lethal chamber.\n   586\t        click_action(8, 4), click_action(8, 5),\n   587\t\n   588\t        # Enter the first gravity switch and take its safe landing lane.\n   589\t        (RIGHT,), (RIGHT,), (RIGHT,), (RIGHT,), (RIGHT,),\n   590\t        click_action(5, 4),\n   591\t        click_action(4, 2),\n   592\t        (LEFT,), (LEFT,),\n   593\t        (RIGHT,), (RIGHT,),\n   594\t        (LEFT,), (LEFT,),\n   595\t\n   596\t        # Open a protected path through the full support barrier.\n   597\t        click_action(5, 3), (LEFT,),\n   598\t        click_action(5, 2), (LEFT,),\n   599\t        click_action(5, 1), (LEFT,),\n   600\t        click_action(5, 1),\n   601\t\n   602\t        # Stage the remote landing support, flip gravity, and cross the shafts.\n   603\t        click_action(8, 5),\n   604\t        (RIGHT,), (RIGHT,), (RIGHT,), (RIGHT,),\n   605\t        click_action(0, 6),\n   606\t        (LEFT,), (LEFT,), (LEFT,),\n   607\t        (RIGHT,), (RIGHT,), (RIGHT,),\n   608\t        (LEFT,),\n   609\t        (LEFT,), (LEFT,),\n   610\t        (RIGHT,), (RIGHT,),\n   611\t\n   612\t        # Descend onto the preserved starting bridge.\n   613\t        click_action(5, 4),\n   614\t        (LEFT,), (LEFT,),\n   615\t        (RIGHT,), (RIGHT,),\n   616\t\n   617\t        # Cross both staged supports, then walk onto the corridor prize.\n   618\t        (RIGHT,), (RIGHT,),\n   619\t        (LEFT,), (LEFT,), (LEFT,), (LEFT,), (LEFT,), (LEFT,),\n   620\t    ]\n   621\t    return run_actions(env, route)\n","exit_code":0,"status":"completed"}}
