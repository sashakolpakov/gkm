8:def cells(frame):\nprobe_level6_macro.py:26:def choices(node):\nprobe_level6_macro.py:44:def search(env, max_states=12000, max_depth=80):\nprobe_level6_macro.py:141:def probe(env):\n     1\t\"\"\"Compact clean-room probes for the first unsolved bp35 level.\"\"\"\n     2\timport gkm_try as harness\n     3\timport legs\n     4\timport perception as p\n     5\t\n     6\t\n     7\tdef compact_objects(frame):\n     8\t    return [\n     9\t        (o[\"color\"], o[\"bbox\"], o[\"area\"])\n    10\t        for o in p.object_candidates(frame, cell=4, min_area=4)\n    11\t    ]\n    12\t\n    13\t\n    14\tdef summary(node):\n    15\t    frame = node.frame()\n    16\t    actors = [\n    17\t        (b.color, b.bbox, b.area)\n    18\t        for b in p.connected_components(frame, colors=(8, 9, 11, 12), min_area=1)\n    19\t    ]\n    20\t    shapes = tuple(\n    21\t        (i, j, legs._cell_shape(frame, i, j))\n    22\t        for i in range(legs.GRID_ROWS)\n    23\t        for j in range(legs.GRID_COLS)\n    24\t        if int(frame[legs.ROW_ANCHORS[i]][legs.COL_ANCHORS[j]])\n    25\t        not in (3, 5, 10)\n    26\t    )\n    27\t    return (\n    28\t        node.levels_completed,\n    29\t        node.terminal(),\n    30\t        legs.moves_used(frame),\n    31\t        actors,\n    32\t        shapes,\n    33\t    )\n    34\t\n    35\t\n    36\tdef experiment(env, name, actions):\n    37\t    node = env.clone()\n    38\t    for action in actions:\n    39\t        node.step(*action)\n    40\t    print(\"SEQ\", name, actions, summary(node))\n    41\t\n    42\t\n    43\tdef probe(env):\n    44\t    harness.resumed_solve(env)\n    45\t    print(\"LEVEL\", env.levels_completed)\n    46\t    print(\"ACTIONS\", tuple(env.actions))\n    47\t    print(\"COLORS\", p.color_counts(env.frame()))\n    48\t    print(\"OBJECTS\", compact_objects(env.frame()))\n    49\t    print(\"GRID\", tuple(\"\".join(row) for row in legs.band_grid(env.frame())))\n    50\t    for action, delta in p.action_deltas(env, tuple(env.actions)).items():\n    51\t        clone = env.clone()\n    52\t        clone.step(action)\n    53\t        print(\n    54\t            \"ACTION\",\n    55\t            action,\n    56\t            \"level\",\n    57\t            clone.levels_completed,\n    58\t            \"terminal\",\n    59\t            clone.terminal(),\n    60\t            \"delta\",\n    61\t            {k: delta[k] for k in (\"count\", \"bbox\")},\n    62\t            \"objects\",\n    63\t            compact_objects(clone.frame()),\n    64\t        )\n    65\t    for i, y in enumerate(legs.ROW_ANCHORS):\n    66\t        for j, x in enumerate(legs.COL_ANCHORS):\n    67\t            color = int(env.frame()[y][x])\n    68\t            if color not in (3, 5, 10):\n    69\t                clone = env.clone()\n    70\t                before = clone.frame()\n    71\t                clone.step(6, x, y)\n    72\t                delta = p.frame_delta(before, clone.frame())\n    73\t                print(\n    74\t                    \"CLICK\",\n    75\t                    (i, j),\n    76\t                    \"color\",\n    77\t                    color,\n    78\t                    \"level\",\n    79\t                    clone.levels_completed,\n    80\t                    \"terminal\",\n    81\t                    clone.terminal(),\n    82\t                    \"delta\",\n    83\t                    {k: delta[k] for k in (\"count\", \"bbox\")},\n    84\t                )\n    85\t    left = (legs.LEFT,)\n    86\t    right = (legs.RIGHT,)\n    87\t    toggle = legs.click_action(5, 4)\n    88\t    lower4 = legs.click_action(8, 4)\n    89\t    lower5 = legs.click_action(8, 5)\n    90\t    upper0 = legs.click_action(3, 0)\n    91\t    upper1 = legs.click_action(3, 1)\n    92\t    upper2 = legs.click_action(3, 2)\n    93\t    experiments = {\n    94\t        \"lower4\": [lower4],\n    95\t        \"lower5\": [lower5],\n    96\t        \"upper0\": [upper0],\n    97\t        \"near_toggle\": [right, right, right, toggle],\n    98\t        \"lower4_toggle\": [lower4, toggle],\n    99\t        \"lower5_toggle\": [lower5, toggle],\n   100\t        \"lower_both_toggle\": [lower4, lower5, toggle],\n   101\t        \"upper_all_toggle\": [upper0, upper1, upper2, toggle],\n   102\t        \"all_supports_toggle\": [\n   103\t            upper0, upper1, upper2, lower4, lower5, toggle\n   104\t        ],\n   105\t        \"c4_lower4_toggle\": [right, right, right, lower4, toggle],\n   106\t        \"lower4_c4_toggle\": [lower4, right, right, right, toggle],\n   107\t        \"c5_lower5_toggle\": [right, right, right, right, lower5, toggle],\n   108\t        \"lower5_c5_toggle\": [lower5, right, right, right, right, toggle],\n   109\t    }\n   110\t    for col in range(7):\n   111\t        movement = [left] if col == 0 else [right] * (col - 1)\n   112\t        experiments[f\"toggle_c{col}\"] = movement + [toggle]\n   113\t    for name, actions in experiments.items():\n   114\t        experiment(env, name, actions)\n   115\t    plan = legs.gravity_room_search(\n   116\t        env,\n   117\t        max_states=2400,\n   118\t        max_depth=80,\n   119\t        interaction_radius=2,\n   120\t        debug=False,\n   121\t    )\n   122\t    solved = env.clone()\n   123\t    legs.run_actions(solved, plan)\n   124\t    print(\n   125\t        \"GRAVITY_PLAN\",\n   126\t        len(plan),\n   127\t        plan,\n   128\t        \"level\",\n   129\t        solved.levels_completed,\n   130\t        \"terminal\",\n   131\t        solved.terminal(),\n   132\t    )\n   133\t\n   134\t\n   135\tlevels, path, error = harness.A.run_program(\"bp35\", probe)\n   136\tprint(\"PROBE_RESULT\", levels, len(path), error)\n","exit_code":0,"status":"completed"}}
