{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_level6_macro.py | sed -n '1,180p'\nnl -ba probe_level6_tail.py | sed -n '1,175p'\"","aggregated_output":"     1\t\"\"\"Best-first room search retaining no-delta interaction identity.\"\"\"\n     2\timport heapq\n     3\timport itertools\n     4\tfrom collections import deque\n     5\t\n     6\timport gkm_try as harness\n     7\timport legs\n     8\t\n     9\t\n    10\tdef avatar_cell(frame):\n    11\t    for i, y in enumerate(legs.ROW_ANCHORS):\n    12\t        for j, x in enumerate(legs.COL_ANCHORS):\n    13\t            if int(frame[y][x]) in legs.AVATAR_COLORS:\n    14\t                return i, j\n    15\t    return None\n    16\t\n    17\t\n    18\tdef cells(frame):\n    19\t    return tuple(\n    20\t        legs._cell_shape(frame, i, j)\n    21\t        for i in range(legs.GRID_ROWS)\n    22\t        for j in range(legs.GRID_COLS)\n    23\t    )\n    24\t\n    25\t\n    26\tdef choices(node):\n    27\t    frame = node.frame()\n    28\t    avatar = avatar_cell(frame)\n    29\t    out = [(legs.LEFT,), (legs.RIGHT,)]\n    30\t    if avatar is None:\n    31\t        return out\n    32\t    ai, aj = avatar\n    33\t    for i, y in enumerate(legs.ROW_ANCHORS):\n    34\t        for j, x in enumerate(legs.COL_ANCHORS):\n    35\t            color = int(frame[y][x])\n    36\t            if color in (7, 8):\n    37\t                out.append((legs.CLICK, x, y))\n    38\t            elif color in (12, 14, 15):\n    39\t                if abs(i - ai) <= 2 and abs(j - aj) <= 2:\n    40\t                    out.append((legs.CLICK, x, y))\n    41\t    return out\n    42\t\n    43\t\n    44\tdef search(env, max_states=12000, max_depth=80):\n    45\t    base_level = env.levels_completed\n    46\t    root = env.clone()\n    47\t    counter = itertools.count()\n    48\t\n    49\t    def key(node, latent):\n    50\t        frame = node.frame()\n    51\t        return (\n    52\t            legs.moves_used(frame) % 2,\n    53\t            avatar_cell(frame),\n    54\t            cells(frame),\n    55\t            latent,\n    56\t        )\n    57\t\n    58\t    def reconstruct(path):\n    59\t        node = root.clone()\n    60\t        legs.run_actions(node, path)\n    61\t        return node\n    62\t\n    63\t    frontier = [(0, 0, next(counter), (), None)]\n    64\t    seen_progress = {key(root, None)}\n    65\t    expanded = 0\n    66\t    best = 0\n    67\t    while frontier and expanded < max_states:\n    68\t        neg_height, _, _, prefix, prefix_latent = heapq.heappop(frontier)\n    69\t        stage = reconstruct(prefix)\n    70\t        local_queue = deque([((), prefix_latent)])\n    71\t        local_seen = {key(stage, prefix_latent)}\n    72\t        while local_queue and expanded < max_states:\n    73\t            suffix, latent = local_queue.popleft()\n    74\t            path = prefix + suffix\n    75\t            node = stage.clone()\n    76\t            legs.run_actions(node, suffix)\n    77\t            expanded += 1\n    78\t            if expanded % 1000 == 0:\n    79\t                print(\n    80\t                    \"SEARCH\", expanded, len(frontier), len(local_queue),\n    81\t                    -neg_height, len(path), flush=True,\n    82\t                )\n    83\t            if len(path) >= max_depth or node.terminal():\n    84\t                continue\n    85\t            before_cells = cells(node.frame())\n    86\t            before_avatar = avatar_cell(node.frame())\n    87\t            for action in choices(node):\n    88\t                child = node.clone()\n    89\t                child.step(*action)\n    90\t                new_path = path + (action,)\n    91\t                if child.levels_completed > base_level:\n    92\t                    return list(new_path), expanded, best\n    93\t                if child.terminal() or avatar_cell(child.frame()) is None:\n    94\t                    continue\n    95\t                gain = max(0, legs.band_shift(node.frame(), child.frame()))\n    96\t                child_cells = cells(child.frame())\n    97\t                child_avatar = avatar_cell(child.frame())\n    98\t                new_latent = latent\n    99\t                if (\n   100\t                    action[0] == legs.CLICK\n   101\t                    and child_cells == before_cells\n   102\t                    and child_avatar == before_avatar\n   103\t                    and gain == 0\n   104\t                ):\n   105\t                    i = min(\n   106\t                        range(legs.GRID_ROWS),\n   107\t                        key=lambda r: abs(legs.ROW_ANCHORS[r] - action[2]),\n   108\t                    )\n   109\t                    j = min(\n   110\t                        range(legs.GRID_COLS),\n   111\t                        key=lambda c: abs(legs.COL_ANCHORS[c] - action[1]),\n   112\t                    )\n   113\t                    color = int(node.frame()[action[2]][action[1]])\n   114\t                    new_latent = (color, i, j)\n   115\t                state = key(child, new_latent)\n   116\t                new_suffix = suffix + (action,)\n   117\t                if gain:\n   118\t                    if state in seen_progress:\n   119\t                        continue\n   120\t                    seen_progress.add(state)\n   121\t                    height = -neg_height + gain\n   122\t                    if height > best:\n   123\t                        best = height\n   124\t                        print(\n   125\t                            \"BEST\", best, len(new_path), new_path,\n   126\t                            tuple(\"\".join(row)\n   127\t                                  for row in legs.band_grid(child.frame())),\n   128\t                            flush=True,\n   129\t                        )\n   130\t                    heapq.heappush(\n   131\t                        frontier,\n   132\t                        (-height, len(new_path), next(counter),\n   133\t                         new_path, new_latent),\n   134\t                    )\n   135\t                elif len(new_suffix) < 16 and state not in local_seen:\n   136\t                    local_seen.add(state)\n   137\t                    local_queue.append((new_suffix, new_latent))\n   138\t    return [], expanded, best\n   139\t\n   140\t\n   141\tdef probe(env):\n   142\t    harness.resumed_solve(env)\n   143\t    plan, expanded, best = search(env)\n   144\t    result = env.clone()\n   145\t    legs.run_actions(result, plan)\n   146\t    print(\n   147\t        \"FOUND\", plan, \"expanded\", expanded, \"best\", best,\n   148\t        \"level\", result.levels_completed, \"terminal\", result.terminal(),\n   149\t        flush=True,\n   150\t    )\n   151\t\n   152\t\n   153\tlevels, path, error = harness.A.run_program(\"bp35\", probe)\n   154\tprint(\"PROBE_RESULT\", levels, len(path), error)\n     1\t\"\"\"Compact clone probes after the reproduced level-6 stage.\"\"\"\n     2\timport gkm_try as harness\n     3\timport legs\n     4\t\n     5\t\n     6\tPREFIX = [\n     7\t    (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,),\n     8\t    legs.click_action(5, 4),\n     9\t    legs.click_action(4, 2),\n    10\t    (legs.LEFT,), (legs.LEFT,),\n    11\t    (legs.RIGHT,), (legs.RIGHT,),\n    12\t    (legs.LEFT,), (legs.LEFT,),\n    13\t    legs.click_action(5, 3),\n    14\t    (legs.LEFT,), (legs.LEFT,),\n    15\t]\n    16\t\n    17\tSAFE_LANE = []\n    18\tNEXT_SHAFT = [(legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,)]\n    19\tFLIP = [legs.click_action(0, 6)]\n    20\t\n    21\t\n    22\tdef avatar_cell(frame):\n    23\t    for i, y in enumerate(legs.ROW_ANCHORS):\n    24\t        for j, x in enumerate(legs.COL_ANCHORS):\n    25\t            if int(frame[y][x]) in legs.AVATAR_COLORS:\n    26\t                return i, j\n    27\t    return None\n    28\t\n    29\t\n    30\tdef compact(node):\n    31\t    frame = node.frame()\n    32\t    changed = tuple(\n    33\t        (i, j, legs._cell_shape(frame, i, j))\n    34\t        for i in range(legs.GRID_ROWS)\n    35\t        for j in range(legs.GRID_COLS)\n    36\t        if int(frame[legs.ROW_ANCHORS[i]][legs.COL_ANCHORS[j]])\n    37\t        not in (3, 5, 9, 10, 11)\n    38\t    )\n    39\t    return (\n    40\t        node.levels_completed,\n    41\t        node.terminal(),\n    42\t        legs.moves_used(frame),\n    43\t        avatar_cell(frame),\n    44\t        tuple(\"\".join(row) for row in legs.band_grid(frame)),\n    45\t        changed,\n    46\t    )\n    47\t\n    48\t\n    49\tdef probe(env):\n    50\t    harness.resumed_solve(env)\n    51\t    root = env.clone()\n    52\t    legs.run_actions(root, PREFIX + SAFE_LANE + NEXT_SHAFT + FLIP)\n    53\t    tests = {\n    54\t        \"right\": [(legs.RIGHT,)],\n    55\t        \"left1\": [(legs.LEFT,)],\n    56\t        \"left2\": [(legs.LEFT,), (legs.LEFT,)],\n    57\t        \"left3\": [(legs.LEFT,), (legs.LEFT,), (legs.LEFT,)],\n    58\t        \"left_right_left\": [\n    59\t            (legs.LEFT,), (legs.RIGHT,), (legs.LEFT,),\n    60\t        ],\n    61\t        \"right_left_right\": [\n    62\t            (legs.RIGHT,), (legs.LEFT,), (legs.RIGHT,),\n    63\t        ],\n    64\t        \"wall_clicks\": [\n    65\t            legs.click_action(0, 0),\n    66\t            legs.click_action(0, 0),\n    67\t            legs.click_action(0, 0),\n    68\t        ],\n    69\t        \"hazard3\": [legs.click_action(6, 3)],\n    70\t        \"hazard4\": [legs.click_action(6, 4)],\n    71\t        \"support3\": [legs.click_action(9, 3)],\n    72\t        \"support4\": [legs.click_action(9, 4)],\n    73\t        \"support3_left3\": [\n    74\t            legs.click_action(9, 3),\n    75\t            (legs.LEFT,), (legs.LEFT,), (legs.LEFT,),\n    76\t        ],\n    77\t        \"support4_left3\": [\n    78\t            legs.click_action(9, 4),\n    79\t            (legs.LEFT,), (legs.LEFT,), (legs.LEFT,),\n    80\t        ],\n    81\t        \"supports_both_left3\": [\n    82\t            legs.click_action(9, 3), legs.click_action(9, 4),\n    83\t            (legs.LEFT,), (legs.LEFT,), (legs.LEFT,),\n    84\t        ],\n    85\t        \"align3_support_left\": [\n    86\t            (legs.LEFT,), (legs.LEFT,),\n    87\t            legs.click_action(9, 3), (legs.LEFT,),\n    88\t        ],\n    89\t        \"align4_support_left2\": [\n    90\t            (legs.LEFT,), legs.click_action(9, 4),\n    91\t            (legs.LEFT,), (legs.LEFT,),\n    92\t        ],\n    93\t        \"align3_hazard\": [\n    94\t            (legs.LEFT,), (legs.LEFT,), legs.click_action(6, 3),\n    95\t        ],\n    96\t        \"align3_hazard_left\": [\n    97\t            (legs.LEFT,), (legs.LEFT,), legs.click_action(6, 3),\n    98\t            (legs.LEFT,),\n    99\t        ],\n   100\t        \"align4_hazard_left2\": [\n   101\t            (legs.LEFT,), legs.click_action(6, 4),\n   102\t            (legs.LEFT,), (legs.LEFT,),\n   103\t        ],\n   104\t        \"hazard3_then_left3\": [\n   105\t            legs.click_action(6, 3),\n   106\t            (legs.LEFT,), (legs.LEFT,), (legs.LEFT,),\n   107\t        ],\n   108\t        \"hazard4_then_left3\": [\n   109\t            legs.click_action(6, 4),\n   110\t            (legs.LEFT,), (legs.LEFT,), (legs.LEFT,),\n   111\t        ],\n   112\t        \"hazard5_then_left3\": [\n   113\t            legs.click_action(6, 5),\n   114\t            (legs.LEFT,), (legs.LEFT,), (legs.LEFT,),\n   115\t        ],\n   116\t        \"hazard6_then_left3\": [\n   117\t            legs.click_action(6, 6),\n   118\t            (legs.LEFT,), (legs.LEFT,), (legs.LEFT,),\n   119\t        ],\n   120\t        \"all_hazards_then_left3\": [\n   121\t            legs.click_action(6, 3), legs.click_action(6, 4),\n   122\t            legs.click_action(6, 5), legs.click_action(6, 6),\n   123\t  