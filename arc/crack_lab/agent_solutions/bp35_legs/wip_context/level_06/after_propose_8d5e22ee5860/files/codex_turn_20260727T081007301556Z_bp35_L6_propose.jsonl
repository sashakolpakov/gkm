{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_stage.py | sed -n '1,110p'\nnl -ba probe_level6_finish.py | sed -n '1,105p'\"","aggregated_output":"     1\t\"\"\"Inspect one verified level-6 prefix and its immediate affordances.\"\"\"\n     2\timport gkm_try as harness\n     3\timport legs\n     4\t\n     5\t\n     6\tPREFIX = [\n     7\t    (legs.RIGHT,),\n     8\t    (legs.RIGHT,),\n     9\t    (legs.RIGHT,),\n    10\t    (legs.RIGHT,),\n    11\t    (legs.RIGHT,),\n    12\t    legs.click_action(5, 4),\n    13\t    (legs.LEFT,),\n    14\t    (legs.LEFT,),\n    15\t    (legs.LEFT,),\n    16\t    legs.click_action(4, 2),\n    17\t    legs.click_action(7, 0),\n    18\t    (legs.RIGHT,),\n    19\t    (legs.RIGHT,),\n    20\t    (legs.RIGHT,),\n    21\t    (legs.LEFT,),\n    22\t    (legs.LEFT,),\n    23\t    (legs.RIGHT,),\n    24\t    (legs.RIGHT,),\n    25\t    (legs.LEFT,),\n    26\t    (legs.LEFT,),\n    27\t]\n    28\t\n    29\t\n    30\tdef avatar_cell(frame):\n    31\t    for i, y in enumerate(legs.ROW_ANCHORS):\n    32\t        for j, x in enumerate(legs.COL_ANCHORS):\n    33\t            if int(frame[y][x]) in legs.AVATAR_COLORS:\n    34\t                return i, j\n    35\t    return None\n    36\t\n    37\t\n    38\tdef compact(node):\n    39\t    frame = node.frame()\n    40\t    specials = []\n    41\t    for i, y in enumerate(legs.ROW_ANCHORS):\n    42\t        for j, x in enumerate(legs.COL_ANCHORS):\n    43\t            color = int(frame[y][x])\n    44\t            if color not in (3, 5, 10):\n    45\t                specials.append((i, j, legs._cell_shape(frame, i, j)))\n    46\t    return (\n    47\t        node.levels_completed,\n    48\t        node.terminal(),\n    49\t        legs.moves_used(frame),\n    50\t        avatar_cell(frame),\n    51\t        tuple(\"\".join(row) for row in legs.band_grid(frame)),\n    52\t        tuple(specials),\n    53\t    )\n    54\t\n    55\t\n    56\tdef probe(env):\n    57\t    harness.resumed_solve(env)\n    58\t    root = env.clone()\n    59\t    legs.run_actions(root, PREFIX)\n    60\t    print(\"STAGE\", compact(root))\n    61\t    actions = [(legs.LEFT,), (legs.RIGHT,)]\n    62\t    frame = root.frame()\n    63\t    for i, y in enumerate(legs.ROW_ANCHORS):\n    64\t        for j, x in enumerate(legs.COL_ANCHORS):\n    65\t            if int(frame[y][x]) not in (3, 5, 9, 10, 11):\n    66\t                actions.append(legs.click_action(i, j))\n    67\t    for action in actions:\n    68\t        child = root.clone()\n    69\t        child.step(*action)\n    70\t        print(\"NEXT\", action, compact(child))\n    71\t    experiments = {\n    72\t        \"support_c2\": [legs.click_action(5, 2)],\n    73\t        \"support_c1\": [(legs.LEFT,), legs.click_action(5, 1)],\n    74\t        \"support_c3\": [(legs.RIGHT,), legs.click_action(5, 3)],\n    75\t        \"left2\": [(legs.LEFT,), (legs.LEFT,)],\n    76\t        \"right2\": [(legs.RIGHT,), (legs.RIGHT,)],\n    77\t    }\n    78\t    for name, path in experiments.items():\n    79\t        child = root.clone()\n    80\t        legs.run_actions(child, path)\n    81\t        print(\"SEQ\", name, path, compact(child))\n    82\t\n    83\t\n    84\tlevels, path, error = harness.A.run_program(\"bp35\", probe)\n    85\tprint(\"PROBE_RESULT\", levels, len(path), error)\n     1\t\"\"\"Probe the verified post-column-1 level-6 frontier.\"\"\"\n     2\timport gkm_try as harness\n     3\timport legs\n     4\t\n     5\t\n     6\tPREFIX = [\n     7\t    (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,),\n     8\t    legs.click_action(5, 4),\n     9\t    legs.click_action(4, 2),\n    10\t    (legs.LEFT,), (legs.LEFT,),\n    11\t    (legs.RIGHT,), (legs.RIGHT,),\n    12\t    (legs.LEFT,), (legs.LEFT,),\n    13\t    legs.click_action(5, 3), (legs.LEFT,),\n    14\t    legs.click_action(5, 2), (legs.LEFT,),\n    15\t    legs.click_action(5, 1), (legs.LEFT,),\n    16\t    legs.click_action(5, 1),\n    17\t    legs.click_action(8, 5),\n    18\t    (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,),\n    19\t    legs.click_action(0, 6),\n    20\t    (legs.LEFT,), (legs.LEFT,), (legs.LEFT,),\n    21\t    (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,),\n    22\t    (legs.LEFT,),\n    23\t    (legs.LEFT,), (legs.LEFT,),\n    24\t    (legs.RIGHT,), (legs.RIGHT,),\n    25\t]\n    26\t\n    27\t\n    28\tdef avatar_cell(frame):\n    29\t    for i, y in enumerate(legs.ROW_ANCHORS):\n    30\t        for j, x in enumerate(legs.COL_ANCHORS):\n    31\t            if int(frame[y][x]) in legs.AVATAR_COLORS:\n    32\t                return i, j\n    33\t    return None\n    34\t\n    35\t\n    36\tdef compact(node):\n    37\t    frame = node.frame()\n    38\t    return (\n    39\t        node.levels_completed,\n    40\t        node.terminal(),\n    41\t        legs.moves_used(frame),\n    42\t        avatar_cell(frame),\n    43\t        tuple(\"\".join(row) for row in legs.band_grid(frame)),\n    44\t        tuple(\n    45\t            (i, j, legs._cell_shape(frame, i, j))\n    46\t            for i in range(legs.GRID_ROWS)\n    47\t            for j in range(legs.GRID_COLS)\n    48\t            if int(frame[legs.ROW_ANCHORS[i]][legs.COL_ANCHORS[j]])\n    49\t            not in (3, 5, 9, 10, 11)\n    50\t        ),\n    51\t    )\n    52\t\n    53\t\n    54\tdef probe(env):\n    55\t    harness.resumed_solve(env)\n    56\t    root = env.clone()\n    57\t    legs.run_actions(root, PREFIX)\n    58\t    print(\"ROOT\", compact(root))\n    59\t    tests = {\n    60\t        \"left1\": [(legs.LEFT,)],\n    61\t        \"left2\": [(legs.LEFT,), (legs.LEFT,)],\n    62\t        \"right1\": [(legs.RIGHT,)],\n    63\t        \"right2\": [(legs.RIGHT,), (legs.RIGHT,)],\n    64\t        \"right3\": [(legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,)],\n    65\t        \"right4\": [\n    66\t            (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,),\n    67\t        ],\n    68\t    }\n    69\t    for col in (2, 3, 4, 5):\n    70\t        tests[f\"support{col}\"] = [legs.click_action(5, col)]\n    71\t    for name, path in tests.items():\n    72\t        node = root.clone()\n    73\t        legs.run_actions(node, path)\n    74\t        print(\"TEST\", name, path, compact(node))\n    75\t\n    76\t\n    77\tlevels, path, error = harness.A.run_program(\"bp35\", probe)\n    78\tprint(\"PROBE_RESULT\", levels, len(path), error)\n","exit_code":0,"status":"completed"}}
