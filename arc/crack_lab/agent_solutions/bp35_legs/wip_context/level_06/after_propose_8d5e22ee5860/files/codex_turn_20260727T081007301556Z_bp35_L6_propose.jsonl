r prior solution history is read here.\n     9\t\"\"\"\n    10\tfrom collections import deque\n    11\tfrom dataclasses import dataclass\n    12\tfrom typing import Dict, Iterable, List, Optional, Sequence, Tuple\n    13\t\n    14\timport numpy as np\n    15\t\n    16\tUP, DOWN, LEFT, RIGHT, USE = 1, 2, 3, 4, 5\n    17\tACTIONS = (UP, DOWN, LEFT, RIGHT, USE)\n    18\tDIRS = {UP: (-1, 0), DOWN: (1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\n    19\tACTION_NAME = {UP: \"UP\", DOWN: \"DOWN\", LEFT: \"LEFT\", RIGHT: \"RIGHT\", USE: \"USE\"}\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Blob:\n    24\t    color: int\n    25\t    bbox: Tuple[int, int, int, int]  # r0, c0, r1, c1 inclusive\n    26\t    area: int\n    27\t    centroid: Tuple[float, float]\n    28\t\n    29\t    @property\n    30\t    def top_left(self):\n    31\t        return self.bbox[0], self.bbox[1]\n    32\t\n    33\t    @property\n    34\t    def size(self):\n    35\t        r0, c0, r1, c1 = self.bbox\n    36\t        return r1 - r0 + 1, c1 - c0 + 1\n    37\t\n    38\t\n    39\tdef arr(frame) -> np.ndarray:\n    40\t    return np.asarray(frame)\n    41\t\n    42\t\n    43\tdef color_counts(frame) -> Dict[int, int]:\n    44\t    vals, cnts = np.unique(arr(frame), return_counts=True)\n    45\t    return {int(v): int(c) for v, c in zip(vals, cnts)}\n   113\tdef frame_delta(before, after) -> dict:\n   114\t    a, b = arr(before), arr(after)\n   115\t    ys, xs = np.where(a != b)\n   116\t    if len(ys) == 0:\n   117\t        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n   118\t    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n   119\t    return {\n   120\t        \"count\": int(len(ys)),\n   121\t        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n   122\t        \"samples\": samples,\n   123\t    }\n   124\t\n   125\t\n   126\tdef action_deltas(env, actions: Sequence[int] = ACTIONS) -> Dict[int, dict]:\n   127\t    base = arr(env.frame()).copy()\n   128\t    out = {}\n   129\t    for action in actions:\n   130\t        clone = env.clone()\n   131\t        clone.step(action)\n   132\t        out[int(action)] = frame_delta(base, clone.frame())\n   133\t    return out\n   134\t\n   135\t\n   136\tdef replay(env, actions: Sequence[int]):\n   137\t    clone = env.clone()\n   138\t    for action in actions:\n   139\t        if clone.terminal():\n   140\t            break\n   141\t        clone.step(int(action))\n   142\t    return clone\n   143\t\n   144\t\n   145\tdef path_result(env, actions: Sequence[int]) -> dict:\n   146\t    clone = replay(env, actions)\n   147\t    return {\n   148\t        \"levels_completed\": int(clone.levels_completed),\n   149\t        \"terminal\": bool(clone.terminal()),\n   150\t        \"path_len\": len(actions),\n   151\t        \"colors\": color_counts(clone.frame()),\n   152\t        \"objects\": object_candidates(clone.frame()),\n   153\t    }\n   154\t\n   155\t\n   156\tdef changed_signature(env, actions: Sequence[int], cell: int = 4):\n   157\t    before = block_signatures(env.frame(), cell)\n   158\t    clone = replay(env, actions)\n   159\t    after = block_signatures(clone.frame(), cell)\n   160\t    return {k: (before.get(k), after.get(k)) for k in sorted(set(before) | set(after))\n   161\t            if before.get(k) != after.get(k)}\n   162\t\n   163\t\n   164\tdef bounded_bfs(env, goal_fn, actions: Sequence[int] = (UP, DOWN, LEFT, RIGHT, USE),\n   165\t                key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   166\t    \"\"\"Generic clone BFS over observational keys. Use small max_states first.\"\"\"\n   167\t    if key_fn is None:\n   168\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   169\t    start_key = key_fn(env)\n   170\t    q = deque([(env.clone(), [])])\n   171\t    seen = {start_key}\n   172\t    while q and len(seen) <= max_states:\n   173\t        node, path = q.popleft()\n   174\t        if goal_fn(node, path):\n   175\t            return path\n   176\t        if len(path) >= max_depth:\n   177\t            continue\n   178\t        for action in actions:\n   179\t            child = node.clone()\n   180\t            child.step(int(action))\n   181\t            key = key_fn(child)\n   182\t            if key in seen:\n   183\t                continue\n   184\t            seen.add(key)\n   185\t            q.append((child, path + [int(action)]))\n   186\t    return None\n   187\t\n   188\t\n   189\tdef bounded_replay_bfs(env, goal_fn, action_fn,\n   190\t                       key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   191\t    \"\"\"Path-only BFS for games whose deep Arena clones become expensive.\n   192\t\n   193\t    The queue retains compact action paths, not recursively deep-copied runtime\n   194\t    states. Each node is reconstructed from one root clone. ``action_fn(node)``\n   195\t    may return integer actions or coordinate tuples such as ``(6, x, y)``.\n   196\t    \"\"\"\n   197\t    if key_fn is None:\n   198\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   199\t\n   200\t    def reconstruct(path):\n   201\t        node = env.clone()\n   202\t        for action in path:\n   203\t            if isinstance(action, tuple):\n   204\t                node.step(*action)\n   205\t            else:\n   206\t                node.step(int(action))\n   207\t        return node\n   208\t\n   209\t    start = reconstruct([])\n   210\t    q = deque([[]])\n   211\t    seen = {key_fn(start)}\n   212\t    while q and len(seen) <= max_states:\n   213\t        path = q.popleft()\n   214\t        node = reconstruct(path)\n   215\t        if goal_fn(node, path):\n   216\t            return path\n   217\t        if len(path) >= max_depth or node.terminal():\n   218\t            continue\n   219\t        for action in action_fn(node):\n   220\t            child_path = path + [action]\n   221\t            child = reconstruct(child_path)\n   222\t            key = key_fn(child)\n   223\t            if key in seen:\n   224\t                continue\n   225\t            seen.add(key)\n   226\t            if goal_fn(child, child_path):\n   227\t                return child_path\n   228\t            q.append(child_path)\n   229\t    return None\n   230\t\n   231\t\n   232\tdef level_goal(base_level: int):\n   233\t    return lambda env, path: env.levels_completed > base_level\n     1\t# Per-level players. Each play_level_K(env) ONLY composes legs from legs.py.\n     2\tfrom legs import *  # noqa\n     3\t\n     4\t\n     5\tdef play_level_1(env):\n     6\t    # Ascend the block tower, then step onto the prize revealed at its top.\n     7\t    climb_to_prize(env)\n     8\t\n     9\t\n    10\tdef play_level_2(env):\n    11\t    # Taller tower with fatal ceiling hazards, so the greedy ascent walks into\n    12\t    # dead-end shafts: plan the climb by search instead, then commit it.\n    13\t    plan_and_commit(env, climb_search)\n    14\t\n    15\t\n    16\tdef play_level_3(env):\n    17\t    # Nearby hazards must be made safe before each timed crossing.\n    18\t    plan_and_commit(env, local_hazard_climb_search)\n    19\t\n    20\t\n    21\tdef play_level_4(env):\n    22\t    # Alternate gravity toggles with only context-safe support interactions.\n    23\t    plan_and_commit(env, gravity_room_search)\n    24\t\n    25\t\n    26\tdef play_level_5(env):\n    27\t    # The same gravity rooms span the full screen and require side support work.\n    28\t    solve_gravity_rooms(env, max_states=550)\n     1\t# Shared leg library: small, named, reusable skills.\n     2\t# Players import from here; add a NEW leg only when no existing leg fits.\n     3\t#\n     4\t# Substrate observed on bp35 (raw frames only):\n     5\t#   * The 64x64 frame is a 6px band lattice: cell (i, j) is sampled at\n     6\t#     (3 + 6i, 15 + 6j) -> a 10 x 8 symbolic grid.\n     7\t#   * Row 63 is a move counter (one non-zero pixel per action taken).\n     8\t#   * The avatar always renders on band row 6; the world scrolls instead.\n     9\t#     After every action the avatar RISES through open cells until blocked,\n    10\t#     so height is gained by opening the cell above it.\n    11\t#   * Action 3 = step left one column, 4 = step right one column.\n    12\t#     Action 6 with (x, y) pixel coordinates clicks a cell; clicking a\n    13\t#     removable block (colour 14) turns it into open floor. Any other click\n    14\t#     is a no-op that still burns a move.\n    15\t#   * A floor rises from below one band every two moves and kills on contact,\n    16\t#     so climbing must outpace the move counter.\n    17\t#   * Reaching a prize cell (a colour outside the terrain palette) on the\n    18\t#     avatar's row completes the level.\n    19\t#   * Off-palette colours are NOT always prizes: from L2 on they are also\n    20\t#     hazards that hang below their own band, so resting under one kills while\n    21\t#     touching one sideways is simply solid. Nothing here models which is\n    22\t#     which -- a clone probe decides, and dead successors are dropped.\n    23\t#   * The world scrolls whenever the avatar rises, so any plan longer than one\n    24\t#     action goes stale. Walk and climb legs re-read the frame every step.\n    25\t\n    26\timport heapq\n    27\timport itertools\n    28\tfrom collections import deque\n    29\t\n    30\tBAND = 6\n    31\tGRID_ROWS = 10\n    32\tGRID_COLS = 8\n    33\tROW_ANCHORS = [3 + BAND * i for i in range(GRID_ROWS)]\n    34\tCOL_ANCHORS = [15 + BAND * j for j in range(GRID_COLS)]\n    35\tAVATAR_ROW = 6\n    36\t\n    37\tWALL_COLORS = (3, 5)\n    38\tOPEN_COLORS = (10,)\n    39\tBLOCK_COLORS = (14,)\n    40\tAVATAR_COLORS = (9, 11)\n    41\t\n    42\tWALL, OPEN, BLOCK, AVATAR, PRIZE = '#', ' ', 'Y', 'A', '*'\n    43\t\n    44\tLEFT, RIGHT, CLICK = 3, 4, 6\n    45\t\n    46\t\n    47\t# --- observation legs -------------------------------------------------\n    48\t\n   460\tdef gravity_room_search(env, max_states=900, max_depth=48, debug=False):\n   461\t    \"\"\"Find a route through rooms controlled by gravity toggles and supports.\n   462\t\n   463\t    Movement is always considered.  Global gravity toggles (colour 8) can\n   464\t    change the whole room, while removable supports (14) are useful only when\n   465\t    aligned with the avatar and shape-changing hazards (15) only when nearby.\n   466\t    Reconstructing each state from one shallow root avoids chains of costly\n   467\t    nested clones.\n   468\t    \"\"\"\n   469\t    base_level = env.levels_completed\n   470\t    root = env.clone()\n   471\t\n   472\t    def avatar_cell(frame):\n   473\t        for i, r in enumerate(ROW_ANCHORS):\n   474\t            for j, c in enumerate(COL_ANCHORS):\n   475\t                if int(frame[r][c]) in AVATAR_COLORS:\n   476\t                    return i, j\n   477\t        return None\n   478\t\n   479\t    def choices(node):\n   480\t        frame = node.frame()\n   481\t        avatar = avatar_cell(frame)\n   482\t        out = [(LEFT,), (RIGHT,)]\n   483\t        if avatar is None:\n   484\t            return out\n   485\t        ai, aj = avatar\n   486\t        for i, y in enumerate(ROW_ANCHORS):\n   487\t            for j, x in enumerate(COL_ANCHORS):\n   488\t                color = int(frame[y][x])\n   489\t                if color == 8 and abs(j - aj) <= 1:\n   490\t                    out.append((CLICK, x, y))\n   491\t                elif color in (12, 14) and abs(j - aj) <= 1 and abs(i - ai) <= 1:\n   492\t                    out.append((CLICK, x, y))\n   493\t                elif color == 15 and abs(i - ai) <= 1 and abs(j - aj) <= 1:\n   494\t                    out.append((CLICK, x, y))\n   495\t        return out\n   496\t\n   497\t    def state_key(node):\n   498\t        frame = node.frame()\n   499\t        cells = tuple(\n   500\t            _cell_shape(frame, i, j)\n   501\t            for i in range(GRID_ROWS)\n   502\t            for j in range(GRID_COLS)\n   503\t        )\n   504\t        return cells, moves_used(frame) % 2\n   505\t\n   506\t    def reconstruct(path):\n   507\t        node = root.clone()\n   508\t        run_actions(node, path)\n   509\t        return node\n   510\t\n   511\t    counter = itertools.count()\n   512\t    frontier = [(0, 0, next(counter), ())]\n   513\t    seen_progress = {state_key(root)}\n   514\t    expanded = 0\n   515\t\n   516\t    while frontier and expanded < max_states:\n   517\t        neg_height, _, _, prefix = heapq.heappop(frontier)\n   518\t        if debug:\n   519\t            print(\"macro\", -neg_height, len(prefix), expanded, len(frontier), prefix)\n   520\t        stage = reconstruct(prefix)\n   521\t        local_queue = deque([()])\n   522\t        local_seen = {state_key(stage)}\n   523\t\n   524\t        # Search the current room only until the camera rises.  Each distinct\n   525\t        # landing becomes a macro successor, so unsafe early toggles can still\n   526\t        # be backtracked without flattening the whole course into one BFS.\n   527\t        while local_queue and expanded < max_states:\n   528\t            suffix = local_queue.popleft()\n   529\t            path = prefix + suffix\n   530\t            node = stage.clone()\n   531\t            run_actions(node, suffix)\n   532\t            expanded += 1\n   533\t            if len(path) >= max_depth or node.terminal():\n   534\t                continue\n   535\t            for action in choices(node):\n   536\t                child = node.clone()\n   537\t                child.step(*action)\n   538\t                new_suffix = suffix + (action,)\n   539\t                new_path = prefix + new_suffix\n   540\t                if child.levels_completed > base_level:\n   541\t                    return list(new_path)\n   542\t                if child.terminal() or avatar_cell(child.frame()) is None:\n   543\t                    continue\n   544\t                key = state_key(child)\n   545\t                gain = max(0, band_shift(node.frame(), child.frame()))\n   546\t                if gain:\n   547\t                    if key in seen_progress:\n   548\t                        continue\n   549\t                    seen_progress.add(key)\n   550\t                    height = -neg_height + gain\n   551\t                    heapq.heappush(\n   552\t                        frontier,\n   553\t                        (-height, len(new_path), next(counter), new_path),\n   554\t                    )\n   555\t                elif len(new_suffix) < 12 and key not in local_seen:\n   556\t                    local_seen.add(key)\n   557\t                    local_queue.append(new_suffix)\n   558\t    return []\n   559\t\n   560\t\n   561\tdef solve_gravity_rooms(env, max_states=900, max_depth=48):\n   562\t    \"\"\"Plan context-safe gravity/support transitions, then commit the route.\"\"\"\n   563\t    return plan_and_commit(\n   564\t        env, gravity_room_search, max_states=max_states, max_depth=max_depth\n   565\t    )\n","exit_code":0,"status":"completed"}}
