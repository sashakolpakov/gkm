e(frame, i, j)\n    41\t            for i in range(legs.GRID_ROWS)\n    42\t            for j in range(legs.GRID_COLS)\n    43\t        ),\n    44\t    )\n    45\t\n    46\t\n    47\tdef choices(node):\n    48\t    frame = node.frame()\n    49\t    avatar = avatar_cell(frame)\n    50\t    out = [(legs.LEFT,), (legs.RIGHT,)]\n    51\t    if avatar is None:\n    52\t        return out\n    53\t    ai, aj = avatar\n    54\t    for i, y in enumerate(legs.ROW_ANCHORS):\n    55\t        for j, x in enumerate(legs.COL_ANCHORS):\n    56\t            color = int(frame[y][x])\n    57\t            if color in (7, 8, 12, 14):\n    58\t                out.append((legs.CLICK, x, y))\n    59\t            elif color == 15 and abs(i - ai) <= 2 and abs(j - aj) <= 2:\n    60\t                out.append((legs.CLICK, x, y))\n    61\t    return out\n    62\t\n    63\t\n    64\tdef search(root, max_states=5000, max_depth=50):\n    65\t    base_level = root.levels_completed\n    66\t    queue = deque([((), 0)])\n    67\t    seen = {state_key(root, 0)}\n    68\t    expanded = 0\n    69\t    best = 0\n    70\t    while queue and expanded < max_states:\n    71\t        path, height = queue.popleft()\n    72\t        node = root.clone()\n    73\t        legs.run_actions(node, path)\n    74\t        expanded += 1\n    75\t        if expanded % 500 == 0:\n    76\t            print(\"SEARCH\", expanded, len(queue), len(path), best, flush=True)\n    77\t        if len(path) >= max_depth or node.terminal():\n    78\t            continue\n    79\t        local_keys = set()\n    80\t        for action in choices(node):\n    81\t            child = node.clone()\n    82\t            child.step(*action)\n    83\t            if child.levels_completed > base_level:\n    84\t                return list(path + (action,)), expanded, len(seen), best\n    85\t            if child.terminal() or avatar_cell(child.frame()) is None:\n    86\t                continue\n    87\t            gained = legs.band_shift(node.frame(), child.frame())\n    88\t            new_height = height + gained\n    89\t            key = state_key(child, new_height)\n    90\t            if key in seen or key in local_keys:\n    91\t                continue\n    92\t            local_keys.add(key)\n    93\t            seen.add(key)\n    94\t            best = max(best, new_height)\n    95\t            queue.append((path + (action,), new_height))\n    96\t    return [], expanded, len(seen), best\n    97\t\n    98\t\n    99\tdef probe(env):\n   100\t    harness.resumed_solve(env)\n   101\t    root = env.clone()\n   102\t    legs.run_actions(root, PREFIX)\n   103\t    print(\n   104\t        \"ROOT\",\n   105\t        legs.moves_used(root.frame()),\n   106\t        avatar_cell(root.frame()),\n   107\t        tuple(\"\".join(row) for row in legs.band_grid(root.frame())),\n   108\t        flush=True,\n   109\t    )\n   110\t    plan, expanded, seen, best = search(root)\n   111\t    result = root.clone()\n   112\t    legs.run_actions(result, plan)\n   113\t    print(\n   114\t        \"FOUND\",\n   115\t        plan,\n   116\t        \"expanded\",\n   117\t        expanded,\n   118\t        \"seen\",\n   119\t        seen,\n   120\t        \"best\",\n   121\t        best,\n   122\t        \"level\",\n   123\t        result.levels_completed,\n   124\t        \"terminal\",\n   125\t        result.terminal(),\n   126\t        flush=True,\n   127\t    )\n   128\t\n   129\t\n   130\tlevels, path, error = harness.A.run_program(\"bp35\", probe)\n   131\tprint(\"PROBE_RESULT\", levels, len(path), error)\n     1\t\"\"\"Compact transition timeline for the reproduced level-6 prefix.\"\"\"\n     2\timport gkm_try as harness\n     3\timport legs\n     4\t\n     5\t\n     6\tPREFIX = [\n     7\t    (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,), (legs.RIGHT,),\n     8\t    legs.click_action(5, 4),\n     9\t    (legs.LEFT,), (legs.LEFT,), (legs.LEFT,),\n    10\t    legs.click_action(4, 2),\n    11\t    legs