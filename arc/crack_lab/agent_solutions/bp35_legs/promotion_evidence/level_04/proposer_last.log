it safe to pass, while distant clicks merely waste the tight clock.\n   393\t    The observational key retains each cell's shape as well as climbed height\n   394\t    and elapsed moves.  Replaying paths from one root avoids retaining a large\n   395\t    tree of nested clones.\n   396\t    \"\"\"\n   397\t    base_level = env.levels_completed\n   398\t    tie = itertools.count()\n   399\t    root = env.clone()\n   400\t\n   401\t    def key(node, height):\n   402\t        frame = node.frame()\n   403\t        return (height, moves_used(frame), avatar_column(frame),\n   404\t                tuple(_cell_shape(frame, i, j)\n   405\t                      for i in range(GRID_ROWS) for j in range(GRID_COLS)))\n   406\t\n   407\t    def local_actions(node):\n   408\t        frame = node.frame()\n   409\t        col = avatar_column(frame)\n   410\t        out = [(LEFT,), (RIGHT,)]\n   411\t        if col is None:\n   412\t            return out\n   413\t        for i in (AVATAR_ROW - 1, AVATAR_ROW):\n   414\t            for j in range(max(0, col - 1), min(GRID_COLS, col + 2)):\n   415\t                color = int(frame[ROW_ANCHORS[i]][COL_ANCHORS[j]])\n   416\t                if color not in OPEN_COLORS + WALL_COLORS + AVATAR_COLORS:\n   417\t                    out.append(click_action(i, j))\n   418\t        return out\n   419\t\n   420\t    queue = [(0, 0, next(tie), 0, ())]\n   421\t    seen = {key(root, 0)}\n   422\t    for _ in range(max_expansions):\n   423\t        if not queue:\n   424\t            break\n   425\t        _, _, _, height, path = heapq.heappop(queue)\n   426\t        node = root.clone()\n   427\t        run_actions(node, path)\n   428\t        for action in local_actions(node):\n   429\t            child = node.clone()\n   430\t            child.step(*action)\n   431\t            if child.levels_completed > base_level:\n   432\t                return list(path + (action,))\n   433\t            if child.terminal() or avatar_column(child.frame()) is None:\n   434\t                continue\n   435\t            gained = height + band_shift(node.frame(), child.frame())\n   436\t            state = key(child, gained)\n   437\t            if state in seen:\n   438\t                continue\n   439\t            seen.add(state)\n   440\t            new_path = path + (action,)\n   441\t            heapq.heappush(queue, (-gained, len(new_path), next(tie),\n   442\t                                   gained, new_path))\n   443\t    return []\n   444\t\n   445\t\n   446\tdef climb_local_hazards(env, max_expansions=600):\n   447\t    \"\"\"Plan a shape-changing hazard climb on clones, then commit it.\"\"\"\n   448\t    base_level = env.levels_completed\n   449\t    actions = local_hazard_climb_search(env, max_expansions=max_expansions)\n   450\t    if not actions:\n   451\t        return False\n   452\t    run_actions(env, actions)\n   453\t    return env.levels_completed > base_level\n   454\t\n   455\t\n   456\tdef gravity_room_search(env, max_states=900, max_depth=48):\n   457\t    \"\"\"Find a route through rooms controlled by gravity toggles and supports.\n   458\t\n   459\t    Movement is always considered.  Global gravity toggles (colour 8) can\n   460\t    change the whole room, while removable supports (14) are useful only when\n   461\t    aligned with the avatar and shape-changing hazards (15) only when nearby.\n   462\t    Reconstructing each state from one shallow root avoids chains of costly\n   463\t    nested clones.\n   464\t    \"\"\"\n   465\t    base_level = env.levels_completed\n   466\t    root = env.clone()\n   467\t\n   468\t    def avatar_cell(frame):\n   469\t        for i, r in enumerate(ROW_ANCHORS):\n   470\t            for j, c in enumerate(COL_ANCHORS):\n   471\t                if int(frame[r][c]) in AVATAR_COLORS:\n   472\t                    return i, j\n   473\t        return None\n   474\t\n   475\t    def choices(node):\n   476\t        frame = node.frame()\n   477\t        avatar = avatar_cell(frame)\n   478\t        out = [(LEFT,), (RIGHT,)]\n   479\t        if avatar is None:\n   480\t            return out\n   481\t        ai, aj = avatar\n   482\t        for i, y in enumerate(ROW_ANCHORS):\n   483\t            for j, x in enumerate(COL_ANCHORS):\n   484\t                color = int(frame[y][x])\n   485\t                if color == 8:\n   486\t                    out.append((CLICK, x, y))\n   487\t                elif color == 14 and j == aj and abs(i - ai) <= 1:\n   488\t                    out.append((CLICK, x, y))\n   489\t                elif color == 15 and abs(i - ai) <= 1 and abs(j - aj) <= 1:\n   490\t                    out.append((CLICK, x, y))\n   491\t        return out\n   492\t\n   493\t    def state_key(node):\n   494\t        frame = node.frame()\n   495\t        visible = bytes(int(value) for row in frame[:63] for value in row)\n   496\t        return visible, moves_used(frame) % 2\n   497\t\n   498\t    def reconstruct(path):\n   499\t        node = root.clone()\n   500\t        run_actions(node, path)\n   501\t        return node\n   502\t\n   503\t    queue = deque([()])\n   504\t    seen = {state_key(root)}\n   505\t    while queue and len(seen) < max_states:\n   506\t        path = queue.popleft()\n   507\t        node = reconstruct(path)\n   508\t        if len(path) >= max_depth or node.terminal():\n   509\t            continue\n   510\t        for action in choices(node):\n   511\t            child = node.clone()\n   512\t            child.step(*action)\n   513\t            new_path = path + (action,)\n   514\t            if child.levels_completed > base_level:\n   515\t                return list(new_path)\n   516\t            if child.terminal() or avatar_cell(child.frame()) is None:\n   517\t                continue\n   518\t            key = state_key(child)\n   519\t            if key in seen:\n   520\t                continue\n   521\t            seen.add(key)\n   522\t            queue.append(new_path)\n   523\t    return []\n   524\t\n   525\t\n   526\tdef solve_gravity_rooms(env, max_states=900, max_depth=48):\n   527\t    \"\"\"Plan context-safe gravity/support transitions, then commit the route.\"\"\"\n   528\t    base_level = env.levels_completed\n   529\t    actions = gravity_room_search(\n   530\t        env, max_states=max_states, max_depth=max_depth\n   531\t    )\n   532\t    if not actions:\n   533\t        return False\n   534\t    run_actions(env, actions)\n   535\t    return env.levels_completed > base_level\n","exit_code":0,"status":"completed"}}
