{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"sed -n '113,123p' perception.py\"","aggregated_output":"def frame_delta(before, after) -> dict:\n    a, b = arr(before), arr(after)\n    ys, xs = np.where(a != b)\n    if len(ys) == 0:\n        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n    return {\n        \"count\": int(len(ys)),\n        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n        \"samples\": samples,\n    }\n","exit_code":0,"status":"completed"}}
