    control_actions,\n    42\t        key_fn=lambda node: (\n    43\t            node.levels_completed,\n    44\t            arr(node.frame())[1:].tobytes(),\n    45\t        ),\n    46\t        max_states=max_states,\n    47\t        max_depth=max_presses,\n    48\t    )\n    49\t    if path is not None:\n    50\t        for action in path:\n    51\t            if env.levels_completed > start_level or env.terminal():\n    52\t                return\n    53\t            env.step(*action)\n    54\t        return\n    55\t\n    56\t    # Retain a cheap greedy fallback for unusually large control configurations.\n    57\t    for _ in range(max_presses):\n    58\t        if env.levels_completed > start_level or env.terminal():\n    59\t            return\n    60\t        current = marker_distance(env)\n    61\t        controls = connected_components(env.frame(), colors=(9,), min_area=4)\n    62\t        if current is None or not controls:\n    63\t            return\n    64\t\n    65\t        best = None\n    66\t        for control in controls:\n    67\t            r0, c0, r1, c1 = control.bbox\n    68\t            x, y = (c0 + c1) // 2, (r0 + r1) // 2\n    69\t            clone = env.clone()\n    70\t            clone.step(6, x, y)\n    71\t            distance = marker_distance(clone)\n    72\t            if clone.levels_completed > start_level:\n    73\t                best = (-1, x, y)\n    74\t                break\n    75\t            if distance is not None and (best is None or distance < best[0]):\n    76\t                best = (distance, x, y)\n    77\t\n    78\t        if best is None or best[0] >= current:\n    79\t            return\n    80\t        env.step(6, best[1], best[2])\n     1\t# Per-level players. Each play_level_K(env) ONLY composes legs from legs.py.\n     2\tfrom legs import *  # noqa\n     3\t\n     4\t\n     5\tdef play_level_1(env):\n     6\t    align_lower_cyan_tip_with_upper_notch(env)\n     7\t\n     8\t\n     9\tdef play_level_2(env):\n    10\t    align_lower_cyan_tip_with_upper_notch(env, marker_color=14)\n","exit_code":0,"status":"completed"}}
