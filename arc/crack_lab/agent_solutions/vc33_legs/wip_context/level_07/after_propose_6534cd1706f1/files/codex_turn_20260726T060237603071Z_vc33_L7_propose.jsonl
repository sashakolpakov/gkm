                  node.frame(), colors=(9,), min_area=2\n    67\t                )\n    68\t            ]\n    69\t            actions.extend(\n    70\t                (6, int(blob.centroid[1]), int(blob.centroid[0]))\n    71\t                for blob in connected_components(\n    72\t                    node.frame(), colors=(12, 13, 14, 15), min_area=8\n    73\t                )\n    74\t            )\n    75\t            for action in actions:\n    76\t                child = node.clone()\n    77\t                child.step(*action)\n    78\t                candidate = prefix + [action]\n    79\t                if child.levels_completed > start_level or score(child) < baseline:\n    80\t                    stage = candidate\n    81\t                    queue.clear()\n    82\t                    break\n    83\t                key = arr(child.frame())[1:].tobytes()\n    84\t                if key not in seen:\n    85\t                    seen.add(key)\n    86\t                    queue.append((child, candidate))\n    87\t        if stage is None:\n    88\t            print(\"stall\", baseline, len(seen))\n    89\t            break\n    90\t        for action in stage:\n    91\t            env.step(*action)\n    92\t        path.extend(stage)\n    93\t        trace.append((score(env), pairs(env)))\n    94\t        if env.levels_completed > start_level:\n    95\t            break\n    96\t    print(\"result\", env.levels_completed, len(path), path)\n    97\t    print(\"trace\", trace)\n    98\t\n    99\t\n   100\tarena.run_program(\"vc33\", probe)\n     1\t# Per-level players. Each play_level_K(env) ONLY composes legs from legs.py.\n     2\tfrom legs import *  # noqa\n     3\t\n     4\t\n     5\tdef play_level_1(env):\n     6\t    align_lower_cyan_tip_with_upper_notch(env)\n     7\t\n     8\t\n     9\tdef play_level_2(env):\n    10\t    align_lower_cyan_tip_with_upper_notch(env, marker_color=14)\n    11\t\n    12\t\n    13\tdef play_level_3(env):\n    14\t    relay_height_between_adjacent_reservoirs(env)\n    15\t\n    16\t\n    17\tdef play_level_4(env):\n    18\t    cross_pressure_gates_then_align_height(env)\n    19\t\n    20\t\n    21\tdef play_level_5(env):\n    22\t    cross_horizontal_gates_then_align_opposing_markers(env)\n    23\t\n    24\t\n    25\tdef play_level_6(env):\n    26\t    cross_pressure_gates_then_align_height(env)\n    27\t    align_marker_pair_with_pressure_controls(env)\n","exit_code":0,"status":"completed"}}
