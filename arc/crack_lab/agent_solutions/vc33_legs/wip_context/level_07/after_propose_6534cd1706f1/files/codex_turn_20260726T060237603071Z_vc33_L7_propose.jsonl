{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_level7.py | sed -n '1,135p'; nl -ba probe_level7.py | sed -n '135,235p'; nl -ba legs.py | sed -n '406,475p'\"","aggregated_output":"     1\t\"\"\"Compact clean-room probes for vc33 level 7 via the public env surface.\"\"\"\n     2\timport json\n     3\timport sys\n     4\tfrom collections import deque\n     5\t\n     6\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     7\timport gkm_arena as arena\n     8\t\n     9\tfrom perception import arr, color_counts, connected_components, frame_delta\n    10\tfrom legs import (\n    11\t    align_marker_pair_with_pressure_controls,\n    12\t    cross_pressure_gates_then_align_height,\n    13\t    relay_height_between_adjacent_reservoirs,\n    14\t)\n    15\t\n    16\t\n    17\twith open(\"checkpoint.json\") as f:\n    18\t    PREFIX = json.load(f)[\"final_path\"]\n    19\t\n    20\t\n    21\tdef summary(blob):\n    22\t    return (\n    23\t        blob.color,\n    24\t        blob.area,\n    25\t        blob.bbox,\n    26\t        tuple(round(v, 1) for v in blob.centroid),\n    27\t    )\n    28\t\n    29\t\n    30\tdef probe(env):\n    31\t    for action in PREFIX:\n    32\t        env.step(*action)\n    33\t    print(\"level\", env.levels_completed, \"actions\", env.actions)\n    34\t    print(\"counts\", color_counts(env.frame()))\n    35\t    blobs = connected_components(env.frame(), min_area=2)\n    36\t    print(\"blobs\", [summary(blob) for blob in blobs])\n    37\t\n    38\t    base = arr(env.frame())\n    39\t    groups = {}\n    40\t    for y in range(2, 64, 4):\n    41\t        for x in range(2, 64, 4):\n    42\t            child = env.clone()\n    43\t            child.step(6, x, y)\n    44\t            delta = frame_delta(base, child.frame())\n    45\t            if not delta[\"count\"]:\n    46\t                continue\n    47\t            key = (arr(child.frame()).tobytes(), child.levels_completed)\n    48\t            group = groups.setdefault(\n    49\t                key,\n    50\t                {\n    51\t                    \"points\": [],\n    52\t                    \"delta\": (delta[\"count\"], delta[\"bbox\"]),\n    53\t                    \"counts\": color_counts(child.frame()),\n    54\t                    \"level\": child.levels_completed,\n    55\t                },\n    56\t            )\n    57\t            group[\"points\"].append((x, y))\n    58\t    print(\n    59\t        \"effects\",\n    60\t        [\n    61\t            {\n    62\t                \"n\": len(group[\"points\"]),\n    63\t                \"reps\": group[\"points\"][:6],\n    64\t                \"delta\": group[\"delta\"],\n    65\t                \"counts\": group[\"counts\"],\n    66\t                \"level\": group[\"level\"],\n    67\t            }\n    68\t            for group in groups.values()\n    69\t        ],\n    70\t    )\n    71\t\n    72\t    exact = []\n    73\t    for blob in connected_components(env.frame(), colors=(9,), min_area=2):\n    74\t        y, x = (int(v) for v in blob.centroid)\n    75\t        child = env.clone()\n    76\t        child.step(6, x, y)\n    77\t        delta = frame_delta(base, child.frame())\n    78\t        exact.append(((x, y), delta[\"count\"], delta[\"bbox\"], color_counts(child.frame())))\n    79\t    print(\"exact_controls\", exact)\n    80\t\n    81\t    child = env.clone()\n    82\t    relay_height_between_adjacent_reservoirs(child)\n    83\t    print(\n    84\t        \"relay\",\n    85\t        child.levels_completed,\n    86\t        color_counts(child.frame()),\n    87\t        [\n    88\t            summary(blob)\n    89\t            for blob in connected_components(\n    90\t                child.frame(), colors=(1, 9, 11, 14, 15), min_area=2\n    91\t            )\n    92\t        ],\n    93\t    )\n    94\t\n    95\t    marker_colors = (11, 14, 15)\n    96\t\n    97\t    def gaps(node):\n    98\t        result = {}\n    99\t        for color in marker_colors:\n   100\t            pair = connected_components(node.frame(), colors=(color,), min_area=1)\n   101\t            if len(pair) == 2:\n   102\t                result[color] = abs(pair[0].centroid[0] - pair[1].centroid[0])\n   103\t        return result\n   104\t\n   105\t    controls = [\n   106\t        (6, int(blob.centroid[1]), int(blob.centroid[0]))\n   107\t        for blob in connected_components(env.frame(), colors=(9,), min_area=2)\n   108\t    ]\n   109\t    initial = sum(gaps(env).values())\n   110\t    queue = deque([(env.clone(), [])])\n   111\t    seen = {arr(env.frame())[1:].tobytes()}\n   112\t    found = None\n   113\t    best = (initial, [])\n   114\t    while queue and len(seen) <= 600:\n   115\t        node, path = queue.popleft()\n   116\t        if len(path) >= 10:\n   117\t            continue\n   118\t        for action in controls:\n   119\t            child = node.clone()\n   120\t            child.step(*action)\n   121\t            child_path = path + [action]\n   122\t            value = sum(gaps(child).values())\n   123\t            if value < best[0]:\n   124\t                best = (value, child_path)\n   125\t            if child.levels_completed > env.levels_completed or value < initial:\n   126\t                found = (child.levels_completed, gaps(child), child_path)\n   127\t                queue.clear()\n   128\t                break\n   129\t            key = arr(child.frame())[1:].tobytes()\n   130\t            if key not in seen:\n   131\t                seen.add(key)\n   132\t                queue.append((child, child_path))\n   133\t    print(\"gap_search\", initial, len(seen), best, found)\n   134\t\n   135\t    child = env.clone()\n   135\t    child = env.clone()\n   136\t    greedy_path = []\n   137\t    trace = [gaps(child)]\n   138\t    for _ in range(80):\n   139\t        current = sum(gaps(child).values())\n   140\t        choice = None\n   141\t        for action in controls:\n   142\t            candidate = child.clone()\n   143\t            candidate.step(*action)\n   144\t            value = sum(gaps(candidate).values())\n   145\t            if candidate.levels_completed > env.levels_completed:\n   146\t                choice = (value, action, candidate)\n   147\t                break\n   148\t            if value < current and (choice is None or value < choice[0]):\n   149\t                choice = (value, action, candidate)\n   150\t        if choice is None:\n   151\t            break\n   152\t        _, action, child = choice\n   153\t        greedy_path.append(action)\n   154\t        trace.append(gaps(child))\n   155\t        if child.levels_completed > env.levels_completed:\n   156\t            break\n   157\t    print(\"greedy\", child.levels_completed, greedy_path, trace)\n   158\t    print(\n   159\t        \"greedy_state\",\n   160\t        [\n   161\t            summary(blob)\n   162\t            for blob in connected_components(\n   163\t                child.frame(), colors=(0, 1, 3, 11, 12, 13, 14, 15), min_area=2\n   164\t            )\n   165\t        ],\n   166\t    )\n   167\t    child = env.clone()\n   168\t    cross_pressure_gates_then_align_height(child, marker_color=11)\n   169\t    print(\n   170\t        \"cross11\",\n   171\t        child.levels_completed,\n   172\t        gaps(child),\n   173\t        [\n   174\t            summary(blob)\n   175\t            for blob in connected_components(\n   176\t                child.frame(), colors=(1, 9, 11, 12, 13, 14, 15), min_area=2\n   177\t            )\n   178\t        ],\n   179\t    )\n   180\t    align_marker_pair_with_pressure_controls(child, marker_color=11)\n   181\t    print(\"cross11_align\", child.levels_completed, gaps(child))\n   182\t    return\n   183\t\n   184\t    child = env.clone()\n   185\t    staged_path = []\n   186\t    staged_trace = [gaps(child)]\n   187\t    for _ in range(40):\n   188\t        baseline = sum(gaps(child).values())\n   189\t        queue = deque([(child.clone(), [])])\n   190\t        seen = {arr(child.frame())[1:].tobytes()}\n   191\t        stage = None\n   192\t        while queue and len(seen) <= 1200:\n   193\t            node, path = queue.popleft()\n   194\t            if len(path) >= 12:\n   195\t                continue\n   196\t            options = [\n   197\t                (6, int(blob.centroid[1]), int(blob.centroid[0]))\n   198\t                for blob in connected_components(\n   199\t                    node.frame(), colors=(9, 12, 13, 14, 15), min_area=2\n   200\t                )\n   201\t            ]\n   202\t            for action in options:\n   203\t                candidate = node.clone()\n   204\t                candidate.step(*action)\n   205\t                candidate_path = path + [action]\n   206\t                value = sum(gaps(candidate).values())\n   207\t                if (\n   208\t                    candidate.levels_completed > env.levels_completed\n   209\t                    or value < baseline\n   210\t                ):\n   211\t                    stage = candidate_path\n   212\t                    queue.clear()\n   213\t                    break\n   214\t                key = arr(candidate.frame())[1:].tobytes()\n   215\t                if key not in seen:\n   216\t                    seen.add(key)\n   217\t                    queue.append((candidate, candidate_path))\n   218\t        if stage is None:\n   219\t            print(\"staged_stall\", baseline, len(seen))\n   220\t            break\n   221\t        for action in stage:\n   222\t            child.step(*action)\n   223\t        staged_path.extend(stage)\n   224\t        staged_trace.append(gaps(child))\n   225\t        if child.levels_completed > env.levels_completed:\n   226\t            break\n   227\t    print(\"staged\", child.levels_completed, len(staged_path), staged_path, staged_trace)\n   228\t\n   229\t\n   230\tarena.run_program(\"vc33\", probe)\n   406\tdef align_marker_pair_with_pressure_controls(\n   407\t    env,\n   408\t    marker_color=11,\n   409\t    active_gate_colors=(12, 13, 14, 15),\n   410\t    max_stages=16,\n   411\t    max_states=500,\n   412\t    max_depth=12,\n   413\t):\n   414\t    \"\"\"Align an unequal marker pair using visible pressure controls and gates.\"\"\"\n   415\t    start_level = env.levels_completed\n   416\t\n   417\t    def marker_gap(node):\n   418\t        markers = connected_components(\n   419\t            node.frame(), colors=(marker_color,), min_area=2\n   420\t        )\n   421\t        if len(markers) != 2 or markers[0].area == markers[1].area:\n   422\t            return None\n   423\t        moving = max(markers, key=lambda blob: blob.area)\n   424\t        fixed = min(markers, key=lambda blob: blob.area)\n   425\t        return (\n   426\t            abs(moving.centroid[0] - fixed.centroid[0])\n   427\t            + abs(moving.centroid[1] - fixed.centroid[1])\n   428\t        )\n   429\t\n   430\t    def actions(node):\n   431\t        return [\n   432\t            (6, int(blob.centroid[1]), int(blob.centroid[0]))\n   433\t            for blob in connected_components(\n   434\t                node.frame(),\n   435\t                colors=(9,) + tuple(active_gate_colors),\n   436\t                min_area=2,\n   437\t            )\n   438\t        ]\n   439\t\n   440\t    for _ in range(max_stages):\n   441\t        if env.levels_completed > start_level or env.terminal():\n   442\t            return\n   443\t        initial_gap = marker_gap(env)\n   444\t        if initial_gap is None:\n   445\t            return\n   446\t\n   447\t        queue = deque([(env.clone(), [])])\n   448\t        seen = {arr(env.frame())[1:].tobytes()}\n   449\t        stage_path = None\n   450\t        while queue and len(seen) <= max_states:\n   451\t            node, path = queue.popleft()\n   452\t            if len(path) >= max_depth or node.terminal():\n   453\t                continue\n   454\t            for action in actions(node):\n   455\t                child = node.clone()\n   456\t                child_path = path + [action]\n   457\t                child.step(*action)\n   458\t                gap = marker_gap(child)\n   459\t                if (\n   460\t                    child.levels_completed > start_level\n   461\t                    or (gap is not None and gap < initial_gap)\n   462\t                ):\n   463\t                    stage_path = child_path\n   464\t                    queue.clear()\n   465\t                    break\n   466\t                key = arr(child.frame())[1:].tobytes()\n   467\t                if key not in seen:\n   468\t                    seen.add(key)\n   469\t                    queue.append((child, child_path))\n   470\t        if stage_path is None:\n   471\t            return\n   472\t        for action in stage_path:\n   473\t            if env.levels_completed > start_level or env.terminal():\n   474\t                return\n   475\t            env.step(*action)\n","exit_code":0,"status":"completed"}}
