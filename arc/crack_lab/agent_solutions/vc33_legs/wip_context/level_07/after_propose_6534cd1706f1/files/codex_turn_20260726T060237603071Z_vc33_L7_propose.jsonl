{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_level7_search.py | sed -n '1,190p'; nl -ba legs.py | sed -n '85,164p'; nl -ba legs.py | sed -n '277,403p'; nl -ba perception.py | sed -n '189,229p'\"","aggregated_output":"     1\t\"\"\"Bounded symbolic search for the first level-7 gate traversal.\"\"\"\n     2\timport json\n     3\timport sys\n     4\tfrom collections import deque\n     5\t\n     6\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     7\timport gkm_arena as arena\n     8\t\n     9\tfrom perception import arr, connected_components\n    10\tfrom legs import align_marker_pair_with_pressure_controls\n    11\t\n    12\t\n    13\twith open(\"checkpoint.json\") as f:\n    14\t    PREFIX = json.load(f)[\"final_path\"]\n    15\t\n    16\t\n    17\tdef probe(env):\n    18\t    for action in PREFIX:\n    19\t        env.step(*action)\n    20\t    base_level = env.levels_completed\n    21\t    colors = (11, 14, 15)\n    22\t\n    23\t    def gaps(node):\n    24\t        result = {}\n    25\t        for color in colors:\n    26\t            pair = [\n    27\t                blob\n    28\t                for blob in connected_components(\n    29\t                    node.frame(), colors=(color,), min_area=1\n    30\t                )\n    31\t                if blob.area <= 5\n    32\t            ]\n    33\t            if len(pair) == 2:\n    34\t                moving = max(pair, key=lambda blob: blob.area)\n    35\t                fixed = min(pair, key=lambda blob: blob.area)\n    36\t                result[color] = (\n    37\t                    abs(moving.centroid[1] - fixed.centroid[1]),\n    38\t                    abs(moving.centroid[0] - fixed.centroid[0]),\n    39\t                )\n    40\t        return result\n    41\t\n    42\t    initial = gaps(env)\n    43\t    initial_horizontal = sum(value[0] for value in initial.values())\n    44\t    queue = deque([(env.clone(), [])])\n    45\t    seen = {arr(env.frame())[1:].tobytes()}\n    46\t    found = None\n    47\t    best = (initial_horizontal, None)\n    48\t    while queue and len(seen) <= 6000:\n    49\t        node, path = queue.popleft()\n    50\t        if len(path) >= 32:\n    51\t            continue\n    52\t        options = [\n    53\t            (6, int(blob.centroid[1]), int(blob.centroid[0]))\n    54\t            for blob in connected_components(\n    55\t                node.frame(), colors=(9, 12, 13, 14, 15), min_area=2\n    56\t            )\n    57\t        ]\n    58\t        for action in options:\n    59\t            child = node.clone()\n    60\t            child.step(*action)\n    61\t            child_path = path + [action]\n    62\t            state_gaps = gaps(child)\n    63\t            horizontal = sum(value[0] for value in state_gaps.values())\n    64\t            if horizontal < best[0]:\n    65\t                best = (horizontal, child_path)\n    66\t            if child.levels_completed > base_level or horizontal < initial_horizontal:\n    67\t                found = (child.levels_completed, state_gaps, child_path)\n    68\t                queue.clear()\n    69\t                break\n    70\t            key = arr(child.frame())[1:].tobytes()\n    71\t            if key not in seen:\n    72\t                seen.add(key)\n    73\t                queue.append((child, child_path))\n    74\t    print(\"search\", initial, len(seen), best, found)\n    75\t\n    76\t    node = env.clone()\n    77\t    full_path = []\n    78\t    trace = [gaps(node)]\n    79\t    for action in found[2]:\n    80\t        node.step(*action)\n    81\t    full_path.extend(found[2])\n    82\t    trace.append(gaps(node))\n    83\t    for _ in range(0):\n    84\t        baseline = sum(value[0] for value in gaps(node).values())\n    85\t        queue = deque([(node.clone(), [])])\n    86\t        seen = {arr(node.frame())[1:].tobytes()}\n    87\t        stage = None\n    88\t        while queue and len(seen) <= 3000:\n    89\t            state, path = queue.popleft()\n    90\t            if len(path) >= 28:\n    91\t                continue\n    92\t            options = [\n    93\t                (6, int(blob.centroid[1]), int(blob.centroid[0]))\n    94\t                for blob in connected_components(\n    95\t                    state.frame(), colors=(9, 12, 13, 14, 15), min_area=2\n    96\t                )\n    97\t            ]\n    98\t            for action in options:\n    99\t                child = state.clone()\n   100\t                child.step(*action)\n   101\t                candidate_path = path + [action]\n   102\t                horizontal = sum(value[0] for value in gaps(child).values())\n   103\t                if child.levels_completed > base_level or horizontal < baseline:\n   104\t                    stage = candidate_path\n   105\t                    queue.clear()\n   106\t                    break\n   107\t                key = arr(child.frame())[1:].tobytes()\n   108\t                if key not in seen:\n   109\t                    seen.add(key)\n   110\t                    queue.append((child, candidate_path))\n   111\t        if stage is None:\n   112\t            print(\"horizontal_stall\", baseline, len(seen))\n   113\t            break\n   114\t        for action in stage:\n   115\t            node.step(*action)\n   116\t        full_path.extend(stage)\n   117\t        trace.append(gaps(node))\n   118\t        if node.levels_completed > base_level:\n   119\t            break\n   120\t    print(\"horizontal\", node.levels_completed, len(full_path), full_path, trace)\n   121\t\n   122\t    align_marker_pair_with_pressure_controls(\n   123\t        node, marker_color=15, max_stages=24, max_states=1200, max_depth=18\n   124\t    )\n   125\t    print(\"align15\", node.levels_completed, gaps(node))\n   126\t\n   127\t    baseline = sum(value[0] for value in gaps(node).values())\n   128\t    queue = deque([(node.clone(), [])])\n   129\t    seen = {arr(node.frame())[1:].tobytes()}\n   130\t    next_stage = None\n   131\t    while queue and len(seen) <= 4000:\n   132\t        state, path = queue.popleft()\n   133\t        if len(path) >= 32:\n   134\t            continue\n   135\t        options = [\n   136\t            (6, int(blob.centroid[1]), int(blob.centroid[0]))\n   137\t            for blob in connected_components(\n   138\t                state.frame(), colors=(9, 12, 13, 14, 15), min_area=2\n   139\t            )\n   140\t        ]\n   141\t        for action in options:\n   142\t            child = state.clone()\n   143\t            child.step(*action)\n   144\t            candidate_path = path + [action]\n   145\t            horizontal = sum(value[0] for value in gaps(child).values())\n   146\t            if child.levels_completed > base_level or horizontal < baseline:\n   147\t                next_stage = (child.levels_completed, gaps(child), candidate_path)\n   148\t                queue.clear()\n   149\t                break\n   150\t            key = arr(child.frame())[1:].tobytes()\n   151\t            if key not in seen:\n   152\t                seen.add(key)\n   153\t                queue.append((child, candidate_path))\n   154\t    print(\"next_horizontal\", len(seen), next_stage)\n   155\t\n   156\t\n   157\tarena.run_program(\"vc33\", probe)\n    85\tdef relay_height_between_adjacent_reservoirs(env, max_presses=32):\n    86\t    \"\"\"Relay height leftward until every small same-color marker pair is level.\"\"\"\n    87\t    start_level = env.levels_completed\n    88\t    frame = env.frame()\n    89\t    excluded = {0, 3, 4, 5, 7, 9}\n    90\t    by_color = {}\n    91\t    for blob in connected_components(frame, min_area=1):\n    92\t        if blob.color not in excluded and blob.area <= 12:\n    93\t            by_color.setdefault(blob.color, []).append(blob)\n    94\t    pairs = {\n    95\t        color: blobs for color, blobs in by_color.items() if len(blobs) == 2\n    96\t    }\n    97\t    if not pairs:\n    98\t        return\n    99\t\n   100\t    controls = connected_components(frame, colors=(9,), min_area=4)\n   101\t    controls.sort(key=lambda blob: blob.centroid[1])\n   102\t    if len(controls) < 2:\n   103\t        return\n   104\t    actions = [\n   105\t        (6, int(blob.centroid[1]), int(blob.centroid[0]))\n   106\t        for blob in controls[::2]\n   107\t    ]\n   108\t\n   109\t    def gaps(node):\n   110\t        out = {}\n   111\t        for color in pairs:\n   112\t            blobs = connected_components(\n   113\t                node.frame(), colors=(color,), min_area=1\n   114\t            )\n   115\t            if len(blobs) == 2:\n   116\t                out[color] = abs(blobs[0].centroid[0] - blobs[1].centroid[0])\n   117\t        return out\n   118\t\n   119\t    left_color = min(\n   120\t        pairs,\n   121\t        key=lambda color: min(blob.centroid[1] for blob in pairs[color]),\n   122\t    )\n   123\t    presses = 0\n   124\t\n   125\t    # Empty each intervening reservoir only as needed to feed the left target.\n   126\t    while presses < max_presses:\n   127\t        current_gaps = gaps(env)\n   128\t        if current_gaps.get(left_color) == 0:\n   129\t            break\n   130\t        before = arr(env.frame())[1:].tobytes()\n   131\t        moved = False\n   132\t        for action in actions[:-1]:\n   133\t            clone = env.clone()\n   134\t            clone.step(*action)\n   135\t            if arr(clone.frame())[1:].tobytes() == before:\n   136\t                continue\n   137\t            env.step(*action)\n   138\t            presses += 1\n   139\t            moved = True\n   140\t            break\n   141\t        if not moved:\n   142\t            return\n   143\t\n   144\t    # The final reservoir supplies the remaining marked reservoir(s). Only\n   145\t    # commit transfers that strictly reduce visible marker mismatch.\n   146\t    if not actions:\n   147\t        return\n   148\t    while presses < max_presses:\n   149\t        if env.levels_completed > start_level or env.terminal():\n   150\t            return\n   151\t        current = gaps(env)\n   152\t        if current and all(gap == 0 for gap in current.values()):\n   153\t            return\n   154\t        action = actions[-1]\n   155\t        clone = env.clone()\n   156\t        clone.step(*action)\n   157\t        if clone.levels_completed > start_level:\n   158\t            env.step(*action)\n   159\t            return\n   160\t        after = gaps(clone)\n   161\t        if not after or sum(after.values()) >= sum(current.values()):\n   162\t            return\n   163\t        env.step(*action)\n   164\t        presses += 1\n   277\tdef cross_horizontal_gates_then_align_opposing_markers(\n   278\t    env,\n   279\t    marker_colors=(11, 14),\n   280\t    closed_gate_color=1,\n   281\t    active_gate_colors=(12, 13, 14, 15),\n   282\t    max_stages=14,\n   283\t    max_states=2500,\n   284\t    max_depth=24,\n   285\t):\n   286\t    \"\"\"Relay opposing marked platforms across horizontal pressure gates.\"\"\"\n   287\t    start_level = env.levels_completed\n   288\t    gate_colors = (closed_gate_color,) + tuple(active_gate_colors)\n   289\t\n   290\t    def marker_pair(node, color):\n   291\t        markers = connected_components(\n   292\t            node.frame(), colors=(color,), min_area=2\n   293\t        )\n   294\t        if len(markers) != 2 or markers[0].area == markers[1].area:\n   295\t            return None\n   296\t        return (\n   297\t            max(markers, key=lambda blob: blob.area),\n   298\t            min(markers, key=lambda blob: blob.area),\n   299\t        )\n   300\t\n   301\t    def progress(node, color):\n   302\t        pair = marker_pair(node, color)\n   303\t        if pair is None:\n   304\t            return None\n   305\t        moving, fixed = pair\n   306\t        low, high = sorted((moving.centroid[0], fixed.centroid[0]))\n   307\t        gates = [\n   308\t            blob\n   309\t            for blob in connected_components(\n   310\t                node.frame(), colors=gate_colors, min_area=12\n   311\t            )\n   312\t            if (\n   313\t                blob.size[1] > blob.size[0]\n   314\t                and low < blob.centroid[0] < high\n   315\t            )\n   316\t        ]\n   317\t        return (\n   318\t            len(gates),\n   319\t            abs(moving.centroid[0] - fixed.centroid[0]),\n   320\t            abs(moving.centroid[1] - fixed.centroid[1]),\n   321\t        )\n   322\t\n   323\t    def actions(node):\n   324\t        options = [\n   325\t            (6, int(blob.centroid[1]), int(blob.centroid[0]))\n   326\t            for blob in connected_components(\n   327\t                node.frame(), colors=(9,), min_area=2\n   328\t            )\n   329\t        ]\n   330\t        options.extend(\n   331\t            (6, int(blob.centroid[1]), int(blob.centroid[0]))\n   332\t            for blob in connected_components(\n   333\t                node.frame(), colors=active_gate_colors, min_area=12\n   334\t            )\n   335\t            if blob.size[1] > blob.size[0]\n   336\t        )\n   337\t        return options\n   338\t\n   339\t    # Platforms moving upward are staged first; their displaced pressure\n   340\t    # becomes the supply that lets the opposing platforms travel downward.\n   341\t    colors = []\n   342\t    for color in marker_colors:\n   343\t        pair = marker_pair(env, color)\n   344\t        if pair is not None:\n   345\t            moving, fixed = pair\n   346\t            colors.append((moving.centroid[0] < fixed.centroid[0], color))\n   347\t    ordered_colors = [color for _, color in sorted(colors)]\n   348\t\n   349\t    for color_index, color in enumerate(ordered_colors):\n   350\t        for _ in range(max_stages):\n   351\t            if env.levels_completed > start_level or env.terminal():\n   352\t                return\n   353\t            initial = progress(env, color)\n   354\t            if initial is None:\n   355\t                break\n   356\t            if initial[0] == 0 and initial[2] == 0 and color_index + 1 < len(\n   357\t                ordered_colors\n   358\t            ):\n   359\t                break\n   360\t\n   361\t            def improved(node):\n   362\t                if node.levels_completed > start_level:\n   363\t                    return True\n   364\t                current = progress(node, color)\n   365\t                if current is None:\n   366\t                    return False\n   367\t                if initial[0]:\n   368\t                    return current[0] < initial[0]\n   369\t                return current[0] == 0 and current[2] < initial[2]\n   370\t\n   371\t            queue = deque([(env.clone(), [])])\n   372\t            seen = {\n   373\t                (\n   374\t                    env.levels_completed,\n   375\t                    arr(env.frame())[1:].tobytes(),\n   376\t                )\n   377\t            }\n   378\t            stage_path = None\n   379\t            while queue and len(seen) <= max_states:\n   380\t                node, path = queue.popleft()\n   381\t                if len(path) >= max_depth or node.terminal():\n   382\t                    continue\n   383\t                for action in actions(node):\n   384\t                    child = node.clone()\n   385\t                    child.step(*action)\n   386\t                    child_path = path + [action]\n   387\t                    if improved(child):\n   388\t                        stage_path = child_path\n   389\t                        queue.clear()\n   390\t                        break\n   391\t                    key = (\n   392\t                        child.levels_completed,\n   393\t                        arr(child.frame())[1:].tobytes(),\n   394\t                    )\n   395\t                    if key not in seen:\n   396\t                        seen.add(key)\n   397\t                        queue.append((child, child_path))\n   398\t            if stage_path is None:\n   399\t                break\n   400\t            for action in stage_path:\n   401\t                if env.levels_completed > start_level or env.terminal():\n   402\t                    return\n   403\t                env.step(*action)\n   189\tdef bounded_replay_bfs(env, goal_fn, action_fn,\n   190\t                       key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   191\t    \"\"\"Path-only BFS for games whose deep Arena clones become expensive.\n   192\t\n   193\t    The queue retains compact action paths, not recursively deep-copied runtime\n   194\t    states. Each node is reconstructed from one root clone. ``action_fn(node)``\n   195\t    may return integer actions or coordinate tuples such as ``(6, x, y)``.\n   196\t    \"\"\"\n   197\t    if key_fn is None:\n   198\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   199\t\n   200\t    def reconstruct(path):\n   201\t        node = env.clone()\n   202\t        for action in path:\n   203\t            if isinstance(action, tuple):\n   204\t                node.step(*action)\n   205\t            else:\n   206\t                node.step(int(action))\n   207\t        return node\n   208\t\n   209\t    start = reconstruct([])\n   210\t    q = deque([[]])\n   211\t    seen = {key_fn(start)}\n   212\t    while q and len(seen) <= max_states:\n   213\t        path = q.popleft()\n   214\t        node = reconstruct(path)\n   215\t        if goal_fn(node, path):\n   216\t            return path\n   217\t        if len(path) >= max_depth or node.terminal():\n   218\t            continue\n   219\t        for action in action_fn(node):\n   220\t            child_path = path + [action]\n   221\t            child = reconstruct(child_path)\n   222\t            key = key_fn(child)\n   223\t            if key in seen:\n   224\t                continue\n   225\t            seen.add(key)\n   226\t            if goal_fn(child, child_path):\n   227\t                return child_path\n   228\t            q.append(child_path)\n   229\t    return None\n","exit_code":0,"status":"completed"}}
