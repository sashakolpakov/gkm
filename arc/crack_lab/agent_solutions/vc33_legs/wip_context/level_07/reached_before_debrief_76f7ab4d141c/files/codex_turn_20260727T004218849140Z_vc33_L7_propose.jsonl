l\", baseline, len(seen))\n    89\t            break\n    90\t        for action in stage:\n    91\t            env.step(*action)\n    92\t        path.extend(stage)\n    93\t        trace.append((score(env), pairs(env)))\n    94\t        if env.levels_completed > start_level:\n    95\t            break\n    96\t    print(\"result\", env.levels_completed, len(path), path)\n    97\t    print(\"trace\", trace)\n    98\t\n    99\t\n   100\tarena.run_program(\"vc33\", probe)\n     1\t\"\"\"Bounded reward search over level 7's visible pressure controls.\"\"\"\n     2\timport heapq\n     3\timport json\n     4\timport sys\n     5\t\n     6\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     7\timport gkm_arena as arena\n     8\t\n     9\tfrom perception import arr, connected_components\n    10\tfrom legs import align_marker_pair_with_pressure_controls\n    11\t\n    12\t\n    13\twith open(\"checkpoint.json\") as f:\n    14\t    PREFIX = json.load(f)[\"final_path\"]\n    15\t\n    16\t\n    17\tdef probe(env):\n    18\t    for action in PREFIX:\n    19\t        env.step(*action)\n    20\t    start_level = env.levels_completed\n    21\t    marker_colors = (11, 14, 15)\n    22\t\n    23\t    for action in ((6, 24, 8), (6, 42, 8), (6, 40, 19)):\n    24\t        env.step(*action)\n    25\t    align_marker_pair_with_pressure_controls(\n    26\t        env, marker_color=15, max_stages=24, max_states=1200, max_depth=18\n    27\t    )\n    28\t    for _ in range(3):\n    29\t        env.step(6, 38, 32)\n    30\t\n    31\t    def gaps(node):\n    32\t        values = []\n    33\t        for color in marker_colors:\n    34\t            blobs = [\n    35\t                blob\n    36\t                for blob in connected_components(\n    37\t                    node.frame(), colors=(color,), min_area=1\n    38\t                )\n    39\t                if blob.area <= 5\n    40\t            ]\n    41\t            if len(blobs) == 2:\n    42\t                moving = max(blobs, key=lambda blob: blob.area)\n    43\t                fixed = min(blobs, key=lambda blob: blob.area)\n    44\t                values.append(\n    45\t                    (\n    46\t                        color,\n    47\t                        abs(moving.centroid[0] - fixed.centroid[0]),\n    48\t                        abs(moving.centroid[1] - fixed.centroid[1]),\n    49\t                    )\n    50\t                )\n    51\t        return tuple(values)\n    52\t\n    53\t    def heuristic(node):\n    54\t        return sum(vertical + horizontal for _, vertical, horizontal in gaps(node))\n    55\t\n    56\t    def actions(node):\n    57\t        options = [\n    58\t            (6, int(blob.centroid[1]), int(blob.centroid[0]))\n    59\t            for blob in connected_components(node.frame(), colors=(9,), min_area=2)\n    60\t        ]\n    61\t        options.extend(\n    62\t            (6, int(blob.centroid[1]), int(blob.centroid[0]))\n    63\t            for blob in connected_components(\n    64\t                node.frame(), colors=(12, 13, 14, 15), min_area=8\n    65\t            )\n    66\t        )\n    67\t        return options\n    68\t\n    69\t    root = env.clone()\n    70\t    counter = 0\n    71\t    heap = [(heuristic(root), 0, counter, root, [])]\n    72\t    seen = {arr(root.frame())[1:].tobytes()}\n    73\t    best = heuristic(root)\n    74\t    solution = None\n    75\t    while heap and len(seen) <= 20000:\n    76\t        _, depth, _, node, path = heapq.heappop(heap)\n    77\t        if depth >= 80 or node.terminal():\n    78\t            continue\n    79\t        for action in actions(node):\n    80\t            child = node.clone()\n    81\t            child.step(*action)\n    82\t            key = arr(child.frame())[1:].tobytes()\n    83\t            if key in seen:\n    84\t                continue\n    85\t            seen.add(key)\n    86\t            child_path = path + [action]\n    87\t            if child.levels_completed > start_level:\n    88\t                solution = child_path\n    89\t                heap.clear()\n    90\t                break\n    91\t            value = heuristic(child)\n    92\t            if value < best:\n    93\t                best = value\n    94\t                print(\"best\", len(seen), depth + 1, value, gaps(child))\n    95\t            counter += 1\n    96\t            heapq.heappush(\n    97\t                heap, (value + 0.15 * (depth + 1), depth + 1, counter, child, child_path)\n    98\t            )\n    99\t    print(\"result\", len(seen), best, solution)\n   100\t\n   101\t\n   102\tarena.run_program(\"vc33\", probe)\n    33\tdef probe(env):\n    34\t    for action in PREFIX:\n    35\t        env.step(*action)\n    36\t    start_level = env.levels_completed\n    37\t\n    38\t    def state():\n    39\t        markers = {}\n    40\t        for color in (11, 14, 15):\n    41\t            markers[color] = [\n    42\t                (\n    43\t                    blob.area,\n    44\t                    tuple(round(value, 1) for value in blob.centroid),\n    45\t                )\n    46\t                for blob in connected_components(\n    47\t                    env.frame(), colors=(color,), min_area=1\n    48\t                )\n    49\t                if blob.area <= 5\n    50\t            ]\n    51\t        gates = [\n    52\t            (blob.color, blob.bbox)\n    53\t            for blob in connected_components(\n    54\t                env.frame(), colors=(1, 12, 13, 14, 15), min_area=8\n    55\t            )\n    56\t        ]\n    57\t        return env.levels_completed, markers, gates\n    58\t\n    59\t    staging = [\n    60\t        (6, 24, 8),\n    61\t        (6, 42, 8),\n    62\t        (6, 40, 19),\n    63\t        *([(6, 24, 8)] * 9),\n    64\t        *([(6, 38, 8)] * 4),\n    65\t        *([(6, 24, 32)] * 4),\n    66\t    ]\n    67\t    for action in staging:\n    68\t        env.step(*action)\n    69\t    print(\"staged\", state())\n    70\t\n    71\t    crossing = StepLog(env)\n    72\t    cross_pressure_gates_then_align_height(\n    73\t        crossing,\n    74\t        marker_color=11,\n    75\t        max_stages=16,\n    76\t        max_states=1000,\n    77\t        max_depth=20,\n    78\t    )\n    79\t    print(\"cross11\", crossing.actions, state())\n    80\t\n    81\t    alignment = StepLog(env)\n    82\t    align_marker_pair_with_pressure_controls(\n    83\t        alignment,\n    84\t        marker_color=11,\n    85\t        max_stages=24,\n    86\t        max_states=1000,\n    87\t        max_depth=18,\n    88\t    )\n    89\t    print(\n    90\t        \"align11\",\n    91\t        alignment.actions,\n    92\t        env.levels_completed - start_level,\n    93\t        state(),\n    94\t    )\n    95\t\n    96\t\n    97\tarena.run_program(\"vc33\", probe)\n","exit_code":0,"status":"completed"}}
