e=bool)\n    53\t    out: List[Blob] = []\n    54\t    rows, cols = f.shape[:2]\n    55\t    for r in range(rows):\n    56\t        for c in range(cols):\n    57\t            if seen[r, c]:\n    58\t                continue\n    59\t            color = int(f[r, c])\n    60\t            if wanted is not None and color not in wanted:\n    61\t                seen[r, c] = True\n    62\t                continue\n    63\t            q = [(r, c)]\n    64\t            seen[r, c] = True\n    65\t            pts = []\n    66\t            while q:\n    67\t                x, y = q.pop()\n    68\t                pts.append((x, y))\n    69\t                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n    70\t                    nx, ny = x + dx, y + dy\n    71\t                    if 0 <= nx < rows and 0 <= ny < cols and not seen[nx, ny] and int(f[nx, ny]) == color:\n    72\t                        seen[nx, ny] = True\n    73\t                        q.append((nx, ny))\n    74\t            if len(pts) >= min_area:\n    75\t                rs = [p[0] for p in pts]\n    76\t                cs = [p[1] for p in pts]\n    77\t                out.append(Blob(color, (min(rs), min(cs), max(rs), max(cs)),\n    78\t                                len(pts), (sum(rs) / len(pts), sum(cs) / len(pts))))\n    79\t    return sorted(out, key=lambda b: (b.color, b.bbox))\n   113\tdef frame_delta(before, after) -> dict:\n   114\t    a, b = arr(before), arr(after)\n   115\t    ys, xs = np.where(a != b)\n   116\t    if len(ys) == 0:\n   117\t        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n   118\t    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n   119\t    return {\n   120\t        \"count\": int(len(ys)),\n   121\t        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n   122\t        \"samples\": samples,\n   123\t    }\n   124\t\n   125\t\n   126\tdef action_deltas(env, actions: Sequence[int] = ACTIONS) -> Dict[int, dict]:\n   127\t    base = arr(env.frame()).copy()\n   128\t    out = {}\n   129\t    for action in actions:\n   130\t        clone = env.clone()\n   131\t        clone.step(action)\n   132\t        out[int(action)] = frame_delta(base, clone.frame())\n   133\t    return out\n   134\t\n   135\t\n   136\tdef replay(env, actions: Sequence[int]):\n   137\t    clone = env.clone()\n   138\t    for action in actions:\n   139\t        if clone.terminal():\n   140\t            break\n   141\t        clone.step(int(action))\n   142\t    return clone\n   143\t\n   144\t\n   145\tdef path_result(env, actions: Sequence[int]) -> dict:\n   146\t    clone = replay(env, actions)\n   147\t    return {\n   148\t        \"levels_completed\": int(clone.levels_completed),\n   149\t        \"terminal\": bool(clone.terminal()),\n   150\t        \"path_len\": len(actions),\n   151\t        \"colors\": color_counts(clone.frame()),\n   152\t        \"objects\": object_candidates(clone.frame()),\n   153\t    }\n   154\t\n   155\t\n   156\tdef changed_signature(env, actions: Sequence[int], cell: int = 4):\n   157\t    before = block_signatures(env.frame(), cell)\n   158\t    clone = replay(env, actions)\n   159\t    after = block_signatures(clone.frame(), cell)\n   160\t    return {k: (before.get(k), after.get(k)) for k in sorted(set(before) | set(after))\n   161\t            if before.get(k) != after.get(k)}\n   189\tdef bounded_replay_bfs(env, goal_fn, action_fn,\n   190\t                       key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   191\t    \"\"\"Path-only BFS for games whose deep Arena clones become expensive.\n   192\t\n   193\t    The queue retains compact action paths, not recursively deep-copied runtime\n   194\t    states. Each node is reconstructed from one root clone. ``action_fn(node)``\n   195\t    may return integer actions or coordinate tuples such as ``(6, x, y)``.\n   196\t    \"\"\"\n   197\t    if key_fn is None:\n   198\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   199\t\n   200\t    def reconstruct(path):\n   201\t        node = env.clone()\n   202\t        for action in path:\n   203\t            if isinstance(action, tuple):\n   204\t                node.step(*action)\n   205\t            else:\n   206\t                node.step(int(action))\n   207\t        return node\n   208\t\n   209\t    start = reconstruct([])\n   210\t    q = deque([[]])\n   211\t    seen = {key_fn(start)}\n   212\t    while q and len(seen) <= max_states:\n   213\t        path = q.popleft()\n   214\t        node = reconstruct(path)\n   215\t        if goal_fn(node, path):\n   216\t            return path\n   217\t        if len(path) >= max_depth or node.terminal():\n   218\t            continue\n   219\t        for action in action_fn(node):\n   220\t            child_path = path + [action]\n   221\t            child = reconstruct(child_path)\n   222\t            key = key_fn(child)\n   223\t            if key in seen:\n   224\t                continue\n   225\t            seen.add(key)\n   226\t            if goal_fn(child, child_path):\n   227\t                return child_path\n   228\t            q.append(child_path)\n   229\t    return None\n   230\t\n   231\t\n   232\tdef level_goal(base_level: int):\n   233\t    return lambda env, path: env.levels_completed > base_level\n","exit_code":0,"status":"completed"}}
