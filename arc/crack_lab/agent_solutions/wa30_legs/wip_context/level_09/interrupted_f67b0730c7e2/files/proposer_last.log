{"type":"item.completed","item":{"id":"item_122","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe9_right_depot.py | sed -n '1,190p'; nl -ba probe9_three_stage.py | sed -n '1,160p'; nl -ba probe9_stageports.py | sed -n '1,190p'\"","aggregated_output":"     1\t\"\"\"Exercise the wall-separated right depots with the full 12-slot metric.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom perception import arr, bounded_bfs\n     6\tfrom probe9_actual_candidates import state\n     7\tfrom probe9_prefix_shortcuts import reach_level_9\n     8\tfrom probe9_two_staged_trace import LOCAL_FINISH\n     9\tfrom probe9_verify import TARGET, boxes, tile_map\n    10\t\n    11\t\n    12\tFULL_TARGET = TARGET | {(2, 13), (2, 14), (6, 13), (6, 14)}\n    13\t\n    14\t\n    15\tdef full_target_state(frame):\n    16\t    grid = arr(frame)\n    17\t    empty = []\n    18\t    filled = []\n    19\t    occupied = []\n    20\t    for row, col in sorted(FULL_TARGET):\n    21\t        colors = set(int(value) for value in\n    22\t                     grid[row * 4:row * 4 + 4,\n    23\t                          col * 4:col * 4 + 4].flat)\n    24\t        if 2 in colors and 9 in colors:\n    25\t            empty.append((row, col))\n    26\t        if 4 in colors and 9 in colors:\n    27\t            filled.append((row, col))\n    28\t        if colors - {2, 9}:\n    29\t            occupied.append((row, col, tuple(sorted(colors))))\n    30\t    return tuple(empty), tuple(filled), tuple(occupied)\n    31\t\n    32\t\n    33\tdef show(env, turn, label):\n    34\t    print(\n    35\t        \"RIGHT_DEPOT\",\n    36\t        label,\n    37\t        turn,\n    38\t        {\n    39\t            \"level\": env.levels_completed,\n    40\t            \"terminal\": env.terminal(),\n    41\t            \"avatar\": boxes(env.frame(), 14),\n    42\t            \"couriers\": boxes(env.frame(), 12),\n    43\t            \"thief\": boxes(env.frame(), 15),\n    44\t            \"cargo\": boxes(env.frame(), 4),\n    45\t            \"target\": full_target_state(env.frame()),\n    46\t        },\n    47\t        flush=True,\n    48\t    )\n    49\t    print(*tile_map(env.frame()), sep=\"\\n\", flush=True)\n    50\t\n    51\t\n    52\tdef inspect(env):\n    53\t    reach_level_9(env)\n    54\t    clone = env.clone()\n    55\t    show(clone, 0, \"start\")\n    56\t\n    57\t    first = (\n    58\t        [2] + [4] * 6 + [1, 5]\n    59\t        + [1] * 2 + [5, 2]\n    60\t    )\n    61\t    second = [3] * 2 + [1, 5] + [4, 1, 5, 2]\n    62\t    turn = 0\n    63\t    third = [3] * 2 + [1] * 3 + [5] + [1] * 2 + [5, 2]\n    64\t    for label, route in (\n    65\t        (\"lower_right\", first),\n    66\t        (\"lower_left\", second),\n    67\t        (\"upper_port\", third),\n    68\t    ):\n    69\t        for action in route:\n    70\t            clone.step(action)\n    71\t            turn += 1\n    72\t        show(clone, turn, label)\n    73\t\n    74\t    candidate = clone.clone()\n    75\t    to_intercept = [2] * 3 + [3] * 5\n    76\t    intercept = clone.clone()\n    77\t    for action in to_intercept:\n    78\t        intercept.step(action)\n    79\t    for path in (\n    80\t        [2, 3, 3, 5],\n    81\t        [2, 3, 3, 3, 5],\n    82\t        [3, 2, 3, 5],\n    83\t        [2, 3, 1, 3, 5],\n    84\t        [1, 3, 3, 3, 5],\n    85\t    ):\n    86\t        child = intercept.clone()\n    87\t        for action in path:\n    88\t            child.step(action)\n    89\t        print(\n    90\t            \"RIGHT_DEPOT_DISMISS_VARIANT\",\n    91\t            path,\n    92\t            boxes(child.frame(), 14),\n    93\t            boxes(child.frame(), 15),\n    94\t            flush=True,\n    95\t        )\n    96\t    searched_dismiss = bounded_bfs(\n    97\t        intercept,\n    98\t        lambda node, path: not boxes(node.frame(), 15),\n    99\t        max_states=5000,\n   100\t        max_depth=8,\n   101\t    )\n   102\t    print(\"RIGHT_DEPOT_DISMISS_SEARCH\", searched_dismiss, flush=True)\n   103\t    dismiss = to_intercept + (\n   104\t        searched_dismiss if searched_dismiss is not None else [2, 3, 3, 5]\n   105\t    )\n   106\t    local_right_finish = (\n   107\t        [3] * 4 + [1, 5]\n   108\t        + [4] * 7 + [1] * 3 + [3, 5, 2]\n   109\t        + [5] * 7\n   110\t    )\n   111\t    prior = full_target_state(candidate.frame())\n   112\t    for index, action in enumerate(dismiss + local_right_finish):\n   113\t        candidate.step(action)\n   114\t        turn += 1\n   115\t        current = full_target_state(candidate.frame())\n   116\t        if index < len(dismiss):\n   117\t            print(\n   118\t                \"RIGHT_DEPOT_DISMISS_TRACE\",\n   119\t                turn,\n   120\t                action,\n   121\t                boxes(candidate.frame(), 14),\n   122\t                boxes(candidate.frame(), 15),\n   123\t                flush=True,\n   124\t            )\n   125\t        if (\n   126\t            current != prior\n   127\t            or candidate.levels_completed > env.levels_completed\n   128\t            or turn >= 64\n   129\t        ):\n   130\t            print(\n   131\t                \"RIGHT_DEPOT_CANDIDATE\",\n   132\t                turn,\n   133\t                action,\n   134\t                candidate.levels_completed - env.levels_completed,\n   135\t                current,\n   136\t                boxes(candidate.frame(), 12),\n   137\t                boxes(candidate.frame(), 15),\n   138\t                flush=True,\n   139\t            )\n   140\t        prior = current\n   141\t        if candidate.terminal() or candidate.levels_completed > env.levels_completed:\n   142\t            break\n   143\t    print(\n   144\t        \"RIGHT_DEPOT_RESULT\",\n   145\t        turn,\n   146\t        candidate.levels_completed - env.levels_completed,\n   147\t        candidate.terminal(),\n   148\t        full_target_state(candidate.frame()),\n   149\t        flush=True,\n   150\t    )\n   151\t\n   152\t    turn = 31\n   153\t    prior = full_target_state(clone.frame())\n   154\t    for _ in range(40):\n   155\t        clone.step(5)\n   156\t        turn += 1\n   157\t        current = full_target_state(clone.frame())\n   158\t        if current != prior:\n   159\t            print(\n   160\t                \"RIGHT_DEPOT_IDLE\",\n   161\t                turn,\n   162\t                current,\n   163\t                boxes(clone.frame(), 12),\n   164\t                flush=True,\n   165\t            )\n   166\t        prior = current\n   167\t        if clone.terminal():\n   168\t            break\n   169\t\n   170\t\n   171\tif __name__ == \"__main__\":\n   172\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Test feeding a third local cargo after the two remote level-9 stages.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe9_two_staged_trace import DISMISS, TWO_STAGED\n     6\tfrom probe9_verify import boxes, target_state, tile_map\n     7\t\n     8\t\n     9\tSTAGE_LOCAL = (\n    10\t    [3] * 2 + [5]\n    11\t    + [4] + [1] * 5 + [5, 2]\n    12\t)\n    13\t\n    14\t\n    15\tdef compact(env, turn):\n    16\t    return {\n    17\t        \"turn\": turn,\n    18\t        \"level\": env.levels_completed,\n    19\t        \"terminal\": env.terminal(),\n    20\t        \"avatar\": boxes(env.frame(), 14),\n    21\t        \"helpers\": boxes(env.frame(), 12),\n    22\t        \"cargo\": boxes(env.frame(), 4),\n    23\t        \"target\": target_state(env.frame()),\n    24\t    }\n    25\t\n    26\t\n    27\tdef inspect(env):\n    28\t    gkm_try.resumed_solve(env)\n    29\t    clone = env.clone()\n    30\t    for action in TWO_STAGED + DISMISS:\n    31\t        clone.step(action)\n    32\t    for action in STAGE_LOCAL:\n    33\t        clone.step(action)\n    34\t    turn = 13 + len(TWO_STAGED + DISMISS + STAGE_LOCAL)\n    35\t    print(\"THREE_STAGE\", compact(clone, turn), flush=True)\n    36\t    print(\"THREE_STAGE_MAP\", *tile_map(clone.frame()), sep=\"\\n\", flush=True)\n    37\t\n    38\t    prior = target_state(clone.frame())\n    39\t    while not clone.terminal() and clone.levels_completed == env.levels_completed:\n    40\t        clone.step(5)\n    41\t        turn += 1\n    42\t        current = target_state(clone.frame())\n    43\t        if current != prior or turn >= 66:\n    44\t            print(\"THREE_EVENT\", compact(clone, turn), flush=True)\n    45\t        prior = current\n    46\t\n    47\t\n    48\tif __name__ == \"__main__\":\n    49\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Probe staging the second remote cargo on the surviving courier's row.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom perception import arr\n     6\tfrom probe9_reroute import second_pick_prefix\n     7\tfrom probe9_verify import (\n     8\t    ReachedLevel9,\n     9\t    StopAtLevel9,\n    10\t    boxes,\n    11\t    summary,\n    12\t    target_state,\n    13\t)\n    14\t\n    15\t\n    16\tdef shortest_dismiss(env, max_depth=6):\n    17\t    frontier = [(env.clone(), [])]\n    18\t    for depth in range(1, max_depth + 1):\n    19\t        next_states = {}\n    20\t        for node, path in frontier:\n    21\t            for action in node.actions:\n    22\t                child = node.clone()\n    23\t                child.step(action)\n    24\t                child_path = path + [action]\n    25\t                if not boxes(child.frame(), 15):\n    26\t                    return child, child_path\n    27\t                next_states.setdefault(\n    28\t                    arr(child.frame()).tobytes(),\n    29\t                    (child, child_path),\n    30\t                )\n    31\t        frontier = list(next_states.values())\n    32\t    return None, None\n    33\t\n    34\t\n    35\tdef inspect(env):\n    36\t    try:\n    37\t        gkm_try.resumed_solve(StopAtLevel9(env))\n    38\t    except ReachedLevel9:\n    39\t        pass\n    40\t\n    41\t    picked = env.clone()\n    42\t    prefix = second_pick_prefix()\n    43\t    for action in prefix:\n    44\t        picked.step(action)\n    45\t\n    46\t    for column in range(4, 9):\n    47\t        stage_path = [2] + [3] * (12 - column) + [1, 5]\n    48\t        staged = picked.clone()\n    49\t        for action in stage_path:\n    50\t            staged.step(action)\n    51\t        stage_turn = len(prefix) + len(stage_path)\n    52\t        print(\n    53\t            \"PORT_STAGE\",\n    54\t            column,\n    55\t            summary(staged, stage_turn),\n    56\t            flush=True,\n    57\t        )\n    58\t        dismissed, contact = shortest_dismiss(staged)\n    59\t        print(\n    60\t            \"PORT_DISMISS\",\n    61\t            column,\n    62\t            contact,\n    63\t            None if dismissed is None else summary(\n    64\t                dismissed, stage_turn + len(contact)\n    65\t            ),\n    66\t            flush=True,\n    67\t        )\n    68\t        if dismissed is None:\n    69\t            continue\n    70\t        idle = dismissed.clone()\n    71\t        idle_turn = stage_turn + len(contact)\n    72\t        prior = None\n    73\t        while not idle.terminal():\n    74\t            target = target_state(idle.frame())\n    75\t            condensed = (target[\"empty\"], target[\"filled\"])\n    76\t            if condensed != prior:\n    77\t                print(\n    78\t                    \"PORT_IDLE\",\n    79\t                    column,\n    80\t                    idle_turn,\n    81\t                    condensed,\n    82\t                    boxes(idle.frame(), 12),\n    83\t                    flush=True,\n    84\t                )\n    85\t            prior = condensed\n    86\t            idle.step(5)\n    87\t            idle_turn += 1\n    88\t\n    89\t\n    90\tgkm_try.A.run_program(\"wa30\", inspect)\n","exit_code":0,"status":"completed"}}
