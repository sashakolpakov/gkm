{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe9_context.py | sed -n '1,220p'; nl -ba probe9_entry.py | sed -n '1,240p'\"","aggregated_output":"     1\t\"\"\"Small context probes from the real level-9 dispatcher entry.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe9_verify import boxes, target_state\n     6\t\n     7\t\n     8\tdef state(env):\n     9\t    target = target_state(env.frame())\n    10\t    return {\n    11\t        \"avatar\": boxes(env.frame(), 14),\n    12\t        \"cargo\": boxes(env.frame(), 4),\n    13\t        \"courier_12\": boxes(env.frame(), 12),\n    14\t        \"courier_15\": boxes(env.frame(), 15),\n    15\t        \"empty\": target[\"empty\"],\n    16\t        \"filled\": target[\"filled\"],\n    17\t        \"level\": env.levels_completed,\n    18\t        \"terminal\": env.terminal(),\n    19\t    }\n    20\t\n    21\t\n    22\tdef trace(base, name, actions):\n    23\t    clone = base.clone()\n    24\t    print(\"PATH\", name, \"START\", state(clone), flush=True)\n    25\t    for turn, action in enumerate(actions, 14):\n    26\t        clone.step(action)\n    27\t        print(\"STEP\", name, turn, action, state(clone), flush=True)\n    28\t\n    29\t\n    30\tdef idle_trace(base):\n    31\t    clone = base.clone()\n    32\t    prior = None\n    33\t    for turn in range(13, 81):\n    34\t        current = state(clone)\n    35\t        condensed = (\n    36\t            current[\"empty\"],\n    37\t            current[\"filled\"],\n    38\t            current[\"courier_12\"],\n    39\t            current[\"courier_15\"],\n    40\t            current[\"level\"],\n    41\t            current[\"terminal\"],\n    42\t        )\n    43\t        if condensed != prior:\n    44\t            print(\"IDLE\", turn, current, flush=True)\n    45\t        if clone.terminal() or clone.levels_completed > base.levels_completed:\n    46\t            break\n    47\t        prior = condensed\n    48\t        clone.step(5)\n    49\t\n    50\t\n    51\tdef inspect(env):\n    52\t    gkm_try.resumed_solve(env)\n    53\t    traces = {\n    54\t        \"up_left_use\": [1, 3, 5],\n    55\t        \"left_up_use\": [3, 1, 5],\n    56\t        \"up_left_use_down\": [1, 3, 5, 2],\n    57\t        \"left_up_use_down\": [3, 1, 5, 2],\n    58\t    }\n    59\t    for name, actions in traces.items():\n    60\t        trace(env, name, actions)\n    61\t    idle_trace(env)\n    62\t\n    63\t\n    64\tif __name__ == \"__main__\":\n    65\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Compact reproduction of the actual solve-loop entry state for level 9.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom perception import action_deltas, color_counts, connected_components\n     6\tfrom probe9_verify import boxes, target_state, tile_map\n     7\t\n     8\t\n     9\tclass CaptureLevel9:\n    10\t    def __init__(self, env):\n    11\t        self.env = env\n    12\t        self.actions_seen = []\n    13\t        self.transitions = []\n    14\t        self.level9 = None\n    15\t        self.level9_index = None\n    16\t\n    17\t    def __getattr__(self, name):\n    18\t        return getattr(self.env, name)\n    19\t\n    20\t    def step(self, action, *args):\n    21\t        before = self.env.levels_completed\n    22\t        result = self.env.step(action, *args)\n    23\t        self.actions_seen.append(action)\n    24\t        if self.env.levels_completed > before:\n    25\t            self.transitions.append(\n    26\t                (self.env.levels_completed, len(self.actions_seen))\n    27\t            )\n    28\t        if before < 8 <= self.env.levels_completed and self.level9 is None:\n    29\t            self.level9 = self.env.clone()\n    30\t            self.level9_index = len(self.actions_seen)\n    31\t        return result\n    32\t\n    33\t\n    34\tdef compact(env):\n    35\t    frame = env.frame()\n    36\t    return {\n    37\t        \"level\": env.levels_completed,\n    38\t        \"terminal\": env.terminal(),\n    39\t        \"actions\": tuple(env.actions),\n    40\t        \"colors\": color_counts(frame),\n    41\t        \"avatar\": boxes(frame, 14),\n    42\t        \"cargo\": boxes(frame, 4),\n    43\t        \"courier_12\": boxes(frame, 12),\n    44\t        \"courier_15\": boxes(frame, 15),\n    45\t        \"target\": target_state(frame),\n    46\t    }\n    47\t\n    48\t\n    49\tdef inspect(env):\n    50\t    capture = CaptureLevel9(env)\n    51\t    gkm_try.resumed_solve(capture)\n    52\t    print(\n    53\t        \"TRANSITION\",\n    54\t        compact(capture.level9),\n    55\t        \"POST_ACTIONS\",\n    56\t        tuple(capture.actions_seen[capture.level9_index:]),\n    57\t        flush=True,\n    58\t    )\n    59\t    print(\"ALL_TRANSITIONS\", tuple(capture.transitions), flush=True)\n    60\t    print(\"ENTRY\", compact(env), flush=True)\n    61\t    print(\"MAP\", *tile_map(env.frame()), sep=\"\\n\", flush=True)\n    62\t    print(\n    63\t        \"BLOBS\",\n    64\t        tuple(\n    65\t            (blob.color, blob.bbox, blob.area)\n    66\t            for blob in connected_components(env.frame(), min_area=4)\n    67\t            if blob.color not in (1, 2)\n    68\t        ),\n    69\t        flush=True,\n    70\t    )\n    71\t    after = {}\n    72\t    for action, delta in action_deltas(env).items():\n    73\t        child = env.clone()\n    74\t        child.step(action)\n    75\t        after[action] = {\n    76\t            \"pixels\": delta[\"count\"],\n    77\t            \"bbox\": delta[\"bbox\"],\n    78\t            \"state\": compact(child),\n    79\t        }\n    80\t    print(\n    81\t        \"ACTION_DELTAS\",\n    82\t        after,\n    83\t        flush=True,\n    84\t    )\n    85\t\n    86\t\n    87\tif __name__ == \"__main__\":\n    88\t    gkm_try.A.run_program(\"wa30\", inspect)\n","exit_code":0,"status":"completed"}}
