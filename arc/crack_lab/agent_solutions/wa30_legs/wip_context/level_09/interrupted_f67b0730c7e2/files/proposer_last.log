{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"''^(def |class |if __name__)|run_program|''^BASE|''^PATH|''^print\" probe9_verify.py; nl -ba probe9_verify.py | sed -n '\"'1,90p'; nl -ba probe9_verify.py | sed -n '180,260p'\"","aggregated_output":"8:class ReachedLevel9(Exception):\n12:class StopAtLevel9:\n33:def boxes(frame, color):\n40:def target_state(frame):\n65:def glyph(cell):\n83:def tile_map(frame):\n94:def summary(env, turn):\n105:def layered_suffix_search(env, max_depth=6, max_transitions=20000):\n153:def inspect(env):\n257:if __name__ == \"__main__\":\n258:    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Compact verification of the level-9 route and final placement.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom perception import arr, connected_components\n     6\t\n     7\t\n     8\tclass ReachedLevel9(Exception):\n     9\t    pass\n    10\t\n    11\t\n    12\tclass StopAtLevel9:\n    13\t    def __init__(self, env):\n    14\t        self.env = env\n    15\t\n    16\t    def __getattr__(self, name):\n    17\t        return getattr(self.env, name)\n    18\t\n    19\t    def step(self, action, *args):\n    20\t        result = self.env.step(action, *args)\n    21\t        if self.env.levels_completed >= 8:\n    22\t            raise ReachedLevel9\n    23\t        return result\n    24\t\n    25\t\n    26\tTARGET = {\n    27\t    (3, 5), (3, 6), (3, 7),\n    28\t    (4, 5),         (4, 7),\n    29\t    (5, 5), (5, 6), (5, 7),\n    30\t}\n    31\t\n    32\t\n    33\tdef boxes(frame, color):\n    34\t    return tuple(\n    35\t        blob.bbox\n    36\t        for blob in connected_components(frame, colors=(color,), min_area=4)\n    37\t    )\n    38\t\n    39\t\n    40\tdef target_state(frame):\n    41\t    grid = arr(frame)\n    42\t    empty = []\n    43\t    filled = []\n    44\t    signatures = {}\n    45\t    for row, col in sorted(TARGET):\n    46\t        colors = tuple(sorted(set(\n    47\t            int(value)\n    48\t            for value in grid[\n    49\t                row * 4:row * 4 + 4,\n    50\t                col * 4:col * 4 + 4,\n    51\t            ].flat\n    52\t        )))\n    53\t        signatures[(row, col)] = colors\n    54\t        if 2 in colors and 9 in colors:\n    55\t            empty.append((row, col))\n    56\t        if 4 in colors and 9 in colors:\n    57\t            filled.append((row, col))\n    58\t    return {\n    59\t        \"empty\": tuple(empty),\n    60\t        \"filled\": tuple(filled),\n    61\t        \"signatures\": signatures,\n    62\t    }\n    63\t\n    64\t\n    65\tdef glyph(cell):\n    66\t    colors = set(int(value) for value in cell.flat)\n    67\t    for color, symbol in ((14, \"A\"), (15, \"X\"), (12, \"C\"), (4, \"o\")):\n    68\t        if color in colors:\n    69\t            return symbol\n    70\t    if colors == {5}:\n    71\t        return \"#\"\n    72\t    if 5 in colors:\n    73\t        return \"+\"\n    74\t    if 2 in colors and 9 in colors:\n    75\t        return \"T\"\n    76\t    if 2 in colors:\n    77\t        return \"=\"\n    78\t    if 7 in colors:\n    79\t        return \"|\"\n    80\t    return \".\"\n    81\t\n    82\t\n    83\tdef tile_map(frame):\n    84\t    grid = arr(frame)\n    85\t    return tuple(\n    86\t        \"\".join(\n    87\t            glyph(grid[row:row + 4, col:col + 4])\n    88\t            for col in range(0, 64, 4)\n    89\t        )\n    90\t        for row in range(0, 64, 4)\n   180\t    )\n   181\t\n   182\t    checkpoint = env.clone()\n   183\t    previous = 0\n   184\t    states = {}\n   185\t    for name, actions in (\n   186\t        (\"first_delivery\", first_delivery),\n   187\t        (\"second_pick\", second_pick),\n   188\t        (\"second_delivery\", second_delivery),\n   189\t        (\"dismiss_courier\", dismiss_courier),\n   190\t        (\"align_local\", align_local),\n   191\t    ):\n   192\t        for action in actions[previous:]:\n   193\t            checkpoint.step(action)\n   194\t        previous = len(actions)\n   195\t        states[name] = checkpoint.clone()\n   196\t        print(\"L9_PHASE\", name, summary(checkpoint, previous), flush=True)\n   197\t\n   198\t    contact_wins = []\n   199\t    contact_frontier = [(states[\"second_delivery\"].clone(), [])]\n   200\t    for depth in range(1, 4):\n   201\t        next_frontier = []\n   202\t        for node, path in contact_frontier:\n   203\t            for action in node.actions:\n   204\t                child = node.clone()\n   205\t                child.step(action)\n   206\t                child_path = path + [action]\n   207\t                if not boxes(child.frame(), 15):\n   208\t                    contact_wins.append(\n   209\t                        (child_path, boxes(child.frame(), 14))\n   210\t                    )\n   211\t                else:\n   212\t                    next_frontier.append((child, child_path))\n   213\t        if contact_wins:\n   214\t            print(\"L9_CONTACT_WINS\", depth, contact_wins, flush=True)\n   215\t            break\n   216\t        contact_frontier = next_frontier\n   217\t\n   218\t    idle = states[\"dismiss_courier\"].clone()\n   219\t    idle_turn = len(dismiss_courier)\n   220\t    prior_target = None\n   221\t    while not idle.terminal():\n   222\t        current_target = target_state(idle.frame())\n   223\t        condensed = (\n   224\t            current_target[\"empty\"],\n   225\t            current_target[\"filled\"],\n   226\t        )\n   227\t        if condensed != prior_target or idle_turn % 4 == 2:\n   228\t            print(\n   229\t                \"L9_IDLE\",\n   230\t                idle_turn,\n   231\t                condensed,\n   232\t                boxes(idle.frame(), 12),\n   233\t                boxes(idle.frame(), 4),\n   234\t                flush=True,\n   235\t            )\n   236\t        prior_target = condensed\n   237\t        idle.step(5)\n   238\t        idle_turn += 1\n   239\t    print(\"L9_IDLE_TERMINAL\", idle_turn, summary(idle, idle_turn),\n   240\t          flush=True)\n   241\t\n   242\t    print(\"L9_CHECKPOINT_MAP\", *tile_map(checkpoint.frame()), sep=\"\\n\",\n   243\t          flush=True)\n   244\t    for action in env.actions:\n   245\t        child = checkpoint.clone()\n   246\t        child.step(action)\n   247\t        print(\n   248\t            \"L9_CHECKPOINT_ACTION\",\n   249\t            action,\n   250\t            summary(child, len(align_local) + 1),\n   251\t            flush=True,\n   252\t        )\n   253\t    suffix = layered_suffix_search(checkpoint)\n   254\t    print(\"L9_SUFFIX\", suffix, flush=True)\n   255\t\n   256\t\n   257\tif __name__ == \"__main__\":\n   258\t    gkm_try.A.run_program(\"wa30\", inspect)\n","exit_code":0,"status":"completed"}}
