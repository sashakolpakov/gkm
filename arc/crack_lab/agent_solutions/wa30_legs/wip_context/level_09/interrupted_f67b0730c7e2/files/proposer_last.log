{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe9_clean_entry.py | sed -n '1,220p'; nl -ba probe9_structure_compact.py | sed -n '1,220p'\"","aggregated_output":"     1\t\"\"\"Reproduce the pristine level-9 frame through the documented arena surface.\"\"\"\n     2\t\n     3\timport sys\n     4\t\n     5\tsys.path.insert(0, \"/Users/sasha/gkm/arc/crack_lab\")\n     6\timport gkm_arena as arena\n     7\t\n     8\timport solve\n     9\tfrom perception import action_deltas, color_counts, connected_components\n    10\t\n    11\t\n    12\tclass ReachedLevel9(Exception):\n    13\t    pass\n    14\t\n    15\t\n    16\tclass StopAtLevel9:\n    17\t    def __init__(self, env):\n    18\t        self.env = env\n    19\t\n    20\t    def __getattr__(self, name):\n    21\t        return getattr(self.env, name)\n    22\t\n    23\t    def step(self, action, *args):\n    24\t        result = self.env.step(action, *args)\n    25\t        if self.env.levels_completed >= 8:\n    26\t            raise ReachedLevel9\n    27\t        return result\n    28\t\n    29\t\n    30\tdef components(frame):\n    31\t    return tuple(\n    32\t        (blob.color, blob.bbox, blob.area)\n    33\t        for blob in connected_components(frame, min_area=4)\n    34\t        if blob.area < 3000\n    35\t    )\n    36\t\n    37\t\n    38\tdef inspect(env):\n    39\t    try:\n    40\t        solve.solve(StopAtLevel9(env))\n    41\t    except ReachedLevel9:\n    42\t        pass\n    43\t\n    44\t    print(\n    45\t        \"ENTRY\",\n    46\t        {\n    47\t            \"level\": env.levels_completed,\n    48\t            \"actions\": tuple(env.actions),\n    49\t            \"colors\": color_counts(env.frame()),\n    50\t            \"components\": components(env.frame()),\n    51\t        },\n    52\t        flush=True,\n    53\t    )\n    54\t    deltas = action_deltas(env, env.actions)\n    55\t    for action in env.actions:\n    56\t        child = env.clone()\n    57\t        child.step(action)\n    58\t        print(\n    59\t            \"ACTION\",\n    60\t            action,\n    61\t            {\n    62\t                \"delta\": (\n    63\t                    deltas[action][\"count\"],\n    64\t                    deltas[action][\"bbox\"],\n    65\t                ),\n    66\t                \"components\": components(child.frame()),\n    67\t            },\n    68\t            flush=True,\n    69\t        )\n    70\t\n    71\t\n    72\tif __name__ == \"__main__\":\n    73\t    arena.run_program(\"wa30\", inspect)\n     1\t\"\"\"Compact phase maps for the actual level-9 handoff and staged route.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe9_actual_candidates import state\n     6\tfrom probe9_stage_endings import STAGE_BASE\n     7\tfrom probe9_stage_finish_beam import ENDING\n     8\tfrom probe9_two_staged_trace import DISMISS, TWO_STAGED\n     9\tfrom probe9_verify import boxes, tile_map\n    10\t\n    11\t\n    12\tdef show(env, turn, label):\n    13\t    print(\"STRUCTURE\", label, turn, state(env), flush=True)\n    14\t    print(*tile_map(env.frame()), sep=\"\\n\", flush=True)\n    15\t\n    16\t\n    17\tdef inspect(env):\n    18\t    gkm_try.resumed_solve(env)\n    19\t    clone = env.clone()\n    20\t    show(clone, 13, \"handoff\")\n    21\t\n    22\t    phase_lengths = (11, 17, 26, 31)\n    23\t    route = TWO_STAGED + DISMISS\n    24\t    for turn, action in enumerate(route, 14):\n    25\t        clone.step(action)\n    26\t        if turn - 13 in phase_lengths:\n    27\t            show(clone, turn, \"two_stage\")\n    28\t\n    29\t    idle = clone.clone()\n    30\t    prior = state(idle)\n    31\t    for turn in range(45, 71):\n    32\t        idle.step(5)\n    33\t        current = state(idle)\n    34\t        if (\n    35\t            current[\"empty\"] != prior[\"empty\"]\n    36\t            or current[\"filled\"] != prior[\"filled\"]\n    37\t            or current[\"cargo\"] != prior[\"cargo\"]\n    38\t        ):\n    39\t            print(\"STRUCTURE_IDLE\", turn, current, flush=True)\n    40\t        prior = current\n    41\t        if idle.terminal():\n    42\t            break\n    43\t\n    44\t    for turn, action in enumerate(STAGE_BASE, 45):\n    45\t        clone.step(action)\n    46\t        print(\"STAGE_STEP\", turn, action, boxes(clone.frame(), 0),\n    47\t              state(clone), flush=True)\n    48\t    for turn, action in enumerate(ENDING, 45 + len(STAGE_BASE)):\n    49\t        clone.step(action)\n    50\t        print(\"STAGE_STEP\", turn, action, boxes(clone.frame(), 0),\n    51\t              state(clone), flush=True)\n    52\t    show(clone, 44 + len(STAGE_BASE) + len(ENDING), \"local_stage\")\n    53\t\n    54\t\n    55\tif __name__ == \"__main__\":\n    56\t    gkm_try.A.run_program(\"wa30\", inspect)\n","exit_code":0,"status":"completed"}}
