     5\tfrom probe_minimize_segments import CaptureSegments\n     6\tfrom probe9_verify import boxes, tile_map\n     7\t\n     8\t\n     9\tPHASES = (\n    10\t    (\"direct\", [4] + [2] * 5 + [3, 5] + [1] * 6 + [3] * 8 + [5]),\n    11\t    (\n    12\t        \"upper_left\",\n    13\t        [4] * 9 + [1] * 7 + [3, 5] + [2] * 6 + [3, 5, 2],\n    14\t    ),\n    15\t    (\n    16\t        \"upper_right\",\n    17\t        [4] * 3 + [1] * 6 + [3, 5] + [2] * 5\n    18\t        + [3] * 3 + [5, 2],\n    19\t    ),\n    20\t    (\n    21\t        \"boundary\",\n    22\t        [4] * 2 + [2] * 5 + [4, 5] + [1] * 5\n    23\t        + [3] * 10 + [2, 5, 1],\n    24\t    ),\n    25\t)\n    26\t\n    27\t\n    28\tdef summary(env, turn):\n    29\t    return {\n    30\t        \"turn\": turn,\n    31\t        \"level\": env.levels_completed,\n    32\t        \"terminal\": env.terminal(),\n    33\t        \"avatar\": boxes(env.frame(), 14),\n    34\t        \"cargo\": boxes(env.frame(), 4),\n    35\t        \"courier\": boxes(env.frame(), 12),\n    36\t    }\n    37\t\n    38\t\n    39\tdef inspect(env):\n    40\t    capture = CaptureSegments(env)\n    41\t    gkm_try.resumed_solve(capture)\n    42\t    clone = capture.starts[4].clone()\n    43\t    print(\"L5_PHASE\", \"start\", summary(clone, 0), flush=True)\n    44\t    print(*tile_map(clone.frame()), sep=\"\\n\", flush=True)\n    45\t    turn = 0\n    46\t    for label, actions in PHASES:\n    47\t        for action in actions:\n    48\t            clone.step(action)\n    49\t            turn += 1\n    50\t        print(\"L5_PHASE\", label, summary(clone, turn), flush=True)\n    51\t        print(*tile_map(clone.frame()), sep=\"\\n\", flush=True)\n    52\t\n    53\t\n    54\tif __name__ == \"__main__\":\n    55\t    gkm_try.A.run_program(\"wa30\", inspect)\n   180\tdef expedite_single_courier_with_four_blocks(env):\n   181\t    \"\"\"Place one cargo and shorten a courier's routes to three distant cargos.\"\"\"\n   182\t    base_level = env.levels_completed\n   183\t\n   184\t    # Take the lower-left cargo from its right side and carry it straight into\n   185\t    # the open target row. This supplies one slot without a courier round trip.\n   186\t    walk(env, RIGHT)\n   187\t    walk(env, DOWN, 5)\n   188\t    walk(env, LEFT)\n   189\t    interact(env)\n   190\t    walk(env, UP, 6)\n   191\t    walk(env, LEFT, 8)\n   192\t    interact(env)\n   193\t\n   194\t    # Bring the upper-left cargo to the corridor-side courier port.\n   195\t    walk(env, RIGHT, 9)\n   196\t    walk(env, UP, 7)\n   197\t    walk(env, LEFT)\n   198\t    interact(env)\n   199\t    walk(env, DOWN, 6)\n   200\t    walk(env, LEFT)\n   201\t    interact(env)\n   202\t    walk(env, DOWN)  # leave the staged cargo so USE cannot re-grab it\n   203\t\n   204\t    # Queue the upper-right cargo at the same port after the first is cleared.\n   205\t    walk(env, RIGHT, 3)\n   206\t    walk(env, UP, 6)\n   207\t    walk(env, LEFT)\n   208\t    interact(env)\n   209\t    walk(env, DOWN, 5)\n   210\t    walk(env, LEFT, 3)\n   211\t    interact(env)\n   212\t    walk(env, DOWN)\n   213\t\n   214\t    # The last boundary cargo cannot initially be approached from its right.\n   215\t    # Carry it close to the target instead, where the courier's return route\n   216\t    # can collect it quickly enough to beat the turn limit.\n   217\t    walk(env, RIGHT, 2)\n   218\t    walk(env, DOWN, 5)\n   219\t    walk(env, RIGHT)\n   220\t    interact(env)\n   221\t    walk(env, UP, 5)\n   222\t    walk(env, LEFT, 10)\n   223\t    walk(env, DOWN)\n   224\t    interact(env)\n   225\t    walk(env, UP)  # crucial: clear the cargo before using USE as a wait\n   226\t\n   227\t    while env.levels_completed == base_level and not env.terminal():\n   228\t        interact(env)\n   229\t\n   230\t\n","exit_code":0,"status":"completed"}}
