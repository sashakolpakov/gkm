{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_cumulative.py | sed -n '1,140p'; nl -ba probe_solver_timing.py | sed -n '1,170p'; nl -ba probe_current_solver.py | sed -n '1,120p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_38","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe_cumulative.py | sed -n '1,140p'; nl -ba probe_solver_timing.py | sed -n '1,170p'; nl -ba probe_current_solver.py | sed -n '1,120p'\"","aggregated_output":"     1\t\"\"\"Report cumulative real-action handoffs for the current composed solver.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\t\n     6\tclass Handoffs:\n     7\t    def __init__(self, env):\n     8\t        self.env = env\n     9\t        self.turn = 0\n    10\t\n    11\t    def __getattr__(self, name):\n    12\t        return getattr(self.env, name)\n    13\t\n    14\t    def step(self, action, *args):\n    15\t        before = self.env.levels_completed\n    16\t        result = self.env.step(action, *args)\n    17\t        self.turn += 1\n    18\t        if self.env.levels_completed > before:\n    19\t            print(\"HANDOFF\", self.env.levels_completed, self.turn, flush=True)\n    20\t        return result\n    21\t\n    22\t\n    23\tdef inspect(env):\n    24\t    wrapped = Handoffs(env)\n    25\t    try:\n    26\t        gkm_try.resumed_solve(wrapped)\n    27\t    except RuntimeError as error:\n    28\t        print(\"HANDOFF_ERROR\", wrapped.turn, str(error), flush=True)\n    29\t\n    30\t\n    31\tif __name__ == \"__main__\":\n    32\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Measure current solver transitions without replaying the checkpoint.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\t\n     6\tclass TimedEnv:\n     7\t    def __init__(self, env):\n     8\t        self.env = env\n     9\t        self.moves = 0\n    10\t        self.transitions = []\n    11\t\n    12\t    def __getattr__(self, name):\n    13\t        return getattr(self.env, name)\n    14\t\n    15\t    def step(self, action, *args):\n    16\t        before = self.env.levels_completed\n    17\t        result = self.env.step(action, *args)\n    18\t        self.moves += 1\n    19\t        if self.env.levels_completed > before:\n    20\t            self.transitions.append((self.env.levels_completed, self.moves))\n    21\t        return result\n    22\t\n    23\t\n    24\tdef inspect(env):\n    25\t    timed = TimedEnv(env)\n    26\t    gkm_try.m.solve(timed)\n    27\t    print(\n    28\t        \"SOLVER_TIMING\",\n    29\t        {\n    30\t            \"moves\": timed.moves,\n    31\t            \"level\": env.levels_completed,\n    32\t            \"terminal\": env.terminal(),\n    33\t            \"transitions\": tuple(timed.transitions),\n    34\t        },\n    35\t        flush=True,\n    36\t    )\n    37\t\n    38\t\n    39\tif __name__ == \"__main__\":\n    40\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Run the edited solver from a fresh arena, bypassing checkpoint replay.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\tfrom probe_cumulative import Handoffs\n     5\t\n     6\t\n     7\tif __name__ == \"__main__\":\n     8\t    levels, path, error = gkm_try.A.run_program(\n     9\t        \"wa30\", lambda env: gkm_try.m.solve(Handoffs(env))\n    10\t    )\n    11\t    valid = gkm_try.A.validate(\"wa30\", path, levels) if path else False\n    12\t    print(\n    13\t        \"FRESH_RESULT\",\n    14\t        f\"levels={levels}\",\n    15\t        f\"moves={len(path)}\",\n    16\t        f\"replay_ok={valid}\",\n    17\t        f\"err={error}\",\n    18\t        flush=True,\n    19\t    )\n","exit_code":0,"status":"completed"}}
