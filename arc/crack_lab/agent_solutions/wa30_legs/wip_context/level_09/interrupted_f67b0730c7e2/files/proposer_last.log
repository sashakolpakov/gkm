{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe9_minimize_win.py | sed -n '1,140p'; nl -ba probe9_best_short_verify.py | sed -n '1,220p'; nl -ba probe9_best_trace.py | sed -n '1,200p'\"","aggregated_output":"     1\t\"\"\"Minimize the verified 61-turn full level-9 route.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe9_prefix_shortcuts import reach_level_9\n     6\tfrom probe_pair_minimize import encode, pair_minimize\n     7\t\n     8\t\n     9\tROUTE = (\n    10\t    [2] + [4] * 6 + [1, 5] + [1] * 2 + [5, 2]\n    11\t    + [3] * 2 + [1, 5] + [4, 1, 5, 2]\n    12\t    + [3] * 2 + [1] * 3 + [5] + [1] * 2 + [5, 2]\n    13\t    + [2] * 3 + [3] * 5 + [2] * 2 + [3, 5]\n    14\t    + [3] * 4 + [1, 5] + [4] * 7 + [1] * 3 + [3, 5]\n    15\t)\n    16\t\n    17\t\n    18\tdef inspect(env):\n    19\t    reach_level_9(env)\n    20\t    print(\"L9_MIN_BASE\", len(ROUTE), encode(ROUTE), flush=True)\n    21\t    best, turns = pair_minimize(env, ROUTE)\n    22\t    print(\n    23\t        \"L9_MIN_RESULT\",\n    24\t        len(best),\n    25\t        turns,\n    26\t        encode(best),\n    27\t        best,\n    28\t        flush=True,\n    29\t    )\n    30\t\n    31\t\n    32\tif __name__ == \"__main__\":\n    33\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Verify deleting the apparent extra interact after middle-right settles.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe9_best_mutations import POSITION\n     6\tfrom probe9_candidate import direct_second_prefix\n     7\tfrom probe9_picksearch_finish import COMBINED_DISMISS_PICK\n     8\tfrom probe9_prefix_shortcuts import reach_level_9\n     9\tfrom probe9_verify import boxes, target_state\n    10\t\n    11\t\n    12\tSHORT_SUFFIX = [2, 4, 5, 1, 3, 2, 2, 5, 1]\n    13\t\n    14\t\n    15\tdef inspect(env):\n    16\t    reach_level_9(env)\n    17\t    route = (\n    18\t        direct_second_prefix()\n    19\t        + COMBINED_DISMISS_PICK\n    20\t        + [5]\n    21\t        + POSITION\n    22\t        + SHORT_SUFFIX\n    23\t        + [5]\n    24\t    )\n    25\t    state = env.clone()\n    26\t    base_level = state.levels_completed\n    27\t    prior = target_state(state.frame())\n    28\t    for turn, action in enumerate(route, 1):\n    29\t        state.step(action)\n    30\t        current = target_state(state.frame())\n    31\t        if current != prior or turn >= 63:\n    32\t            print(\n    33\t                \"BEST_SHORT_TRACE\",\n    34\t                turn,\n    35\t                action,\n    36\t                state.levels_completed - base_level,\n    37\t                state.terminal(),\n    38\t                boxes(state.frame(), 14),\n    39\t                current,\n    40\t                flush=True,\n    41\t            )\n    42\t        prior = current\n    43\t        if state.terminal() or state.levels_completed > base_level:\n    44\t            break\n    45\t    print(\n    46\t        \"BEST_SHORT_RESULT\",\n    47\t        len(route),\n    48\t        state.levels_completed - base_level,\n    49\t        state.terminal(),\n    50\t        target_state(state.frame()),\n    51\t        flush=True,\n    52\t    )\n    53\t\n    54\t\n    55\tif __name__ == \"__main__\":\n    56\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Trace target events in the exact all-eight-at-69 level-9 route.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe9_best_mutations import POSITION, SUFFIX\n     6\tfrom probe9_candidate import direct_second_prefix\n     7\tfrom probe9_picksearch_finish import COMBINED_DISMISS_PICK\n     8\tfrom probe9_prefix_shortcuts import reach_level_9\n     9\tfrom probe9_verify import boxes, target_state\n    10\t\n    11\t\n    12\tdef inspect(env):\n    13\t    reach_level_9(env)\n    14\t    route = (\n    15\t        direct_second_prefix()\n    16\t        + COMBINED_DISMISS_PICK\n    17\t        + [5]\n    18\t        + POSITION\n    19\t        + SUFFIX\n    20\t    )\n    21\t    state = env.clone()\n    22\t    prior = target_state(state.frame())\n    23\t    for turn, action in enumerate(route, 1):\n    24\t        state.step(action)\n    25\t        current = target_state(state.frame())\n    26\t        if current != prior or turn >= 56:\n    27\t            print(\n    28\t                \"BEST_TRACE\",\n    29\t                {\n    30\t                    \"turn\": turn,\n    31\t                    \"action\": action,\n    32\t                    \"level\": state.levels_completed,\n    33\t                    \"terminal\": state.terminal(),\n    34\t                    \"avatar\": boxes(state.frame(), 14),\n    35\t                    \"helpers\": boxes(state.frame(), 12),\n    36\t                    \"empty\": current[\"empty\"],\n    37\t                    \"filled\": current[\"filled\"],\n    38\t                    \"signatures\": current[\"signatures\"],\n    39\t                },\n    40\t                flush=True,\n    41\t            )\n    42\t        prior = current\n    43\t\n    44\t\n    45\tif __name__ == \"__main__\":\n    46\t    gkm_try.A.run_program(\"wa30\", inspect)\n","exit_code":0,"status":"completed"}}
