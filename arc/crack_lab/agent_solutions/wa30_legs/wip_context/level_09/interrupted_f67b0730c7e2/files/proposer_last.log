result[\"reward\"] or result[\"best\"] >= 7:\n    48\t            print(\n    49\t                \"DELETE_ONE\",\n    50\t                index,\n    51\t                prefix[index],\n    52\t                result,\n    53\t                flush=True,\n    54\t            )\n    55\t        results.append((result[\"reward\"], result[\"best\"], index, result))\n    56\t    print(\"DELETE_BEST\", max(results, key=lambda item: item[:3]), flush=True)\n    57\t\n    58\t    replacement_results = []\n    59\t    for index, original in enumerate(prefix):\n    60\t        for replacement in env.actions:\n    61\t            if replacement == original:\n    62\t                continue\n    63\t            candidate = list(prefix)\n    64\t            candidate[index] = replacement\n    65\t            result = replay(\n    66\t                env,\n    67\t                candidate\n    68\t                + COMBINED_DISMISS_PICK\n    69\t                + POSITION_BLOCK\n    70\t                + PLACE_BLOCK,\n    71\t            )\n    72\t            if result[\"reward\"] or result[\"best\"] >= 8:\n    73\t                print(\n    74\t                    \"REPLACE_ONE\",\n    75\t                    index,\n    76\t                    original,\n    77\t                    replacement,\n    78\t                    result,\n    79\t                    flush=True,\n    80\t                )\n    81\t            replacement_results.append(\n    82\t                (result[\"reward\"], result[\"best\"], index, replacement, result)\n    83\t            )\n    84\t    print(\n    85\t        \"REPLACE_BEST\",\n    86\t        max(replacement_results, key=lambda item: item[:4]),\n    87\t        flush=True,\n    88\t    )\n    89\t\n    90\t    near_route = (\n    91\t        prefix\n    92\t        + COMBINED_DISMISS_PICK\n    93\t        + POSITION_BLOCK\n    94\t        + PLACE_BLOCK\n    95\t    )\n    96\t    full_results = []\n    97\t    for index, original in enumerate(near_route):\n    98\t        result = replay(\n    99\t            env,\n   100\t            near_route[:index] + near_route[index + 1:] + [5],\n   101\t        )\n   102\t        if result[\"reward\"] or result[\"best\"] >= 8:\n   103\t            print(\"FULL_DELETE\", index, original, result, flush=True)\n   104\t        full_results.append((result[\"reward\"], result[\"best\"], index, result))\n   105\t    print(\n   106\t        \"FULL_DELETE_BEST\",\n   107\t        max(full_results, key=lambda item: item[:3]),\n   108\t        flush=True,\n   109\t    )\n   110\t\n   111\t    full_replace_results = []\n   112\t    for index, original in enumerate(near_route):\n   113\t        for replacement in env.actions:\n   114\t            if replacement == original:\n   115\t                continue\n   116\t            candidate = list(near_route)\n   117\t            candidate[index] = replacement\n   118\t            result = replay(env, candidate)\n   119\t            if result[\"reward\"]:\n   120\t                print(\n   121\t                    \"FULL_REPLACE_WIN\",\n   122\t                    index,\n   123\t                    original,\n   124\t                    replacement,\n   125\t                    result,\n   126\t                    flush=True,\n   127\t                )\n   128\t                return\n   129\t            full_replace_results.append(\n   130\t                (result[\"reward\"], result[\"best\"], index, replacement, result)\n   131\t            )\n   132\t    print(\n   133\t        \"FULL_REPLACE_BEST\",\n   134\t        max(full_replace_results, key=lambda item: item[:4]),\n   135\t        flush=True,\n   136\t    )\n   137\t\n   138\t\n   139\tif __name__ == \"__main__\":\n   140\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Mutate the exact all-eight-at-69 level-9 post-pick route.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe9_candidate import direct_second_prefix\n     6\tfrom probe9_picksearch_finish import COMBINED_DISMISS_PICK\n     7\tfrom probe9_prefix_shortcuts import reach_level_9\n     8\tfrom probe9_verify import target_state\n     9\t\n    10\t\n    11\tPOSITION = [4] + [1] * 6 + [4] * 4\n    12\tSUFFIX = [2, 4, 5, 1, 3, 2, 5, 2, 5, 1]\n    13\tTAIL = POSITION + SUFFIX\n    14\t\n    15\t\n    16\tdef replay(base, route):\n    17\t    child = base.clone()\n    18\t    base_level = child.levels_completed\n    19\t    best = 0\n    20\t    for action in route:\n    21\t        if child.terminal() or child.levels_completed > base_level:\n    22\t            break\n    23\t        child.step(action)\n    24\t        best = max(best, len(target_state(child.frame())[\"filled\"]))\n    25\t    return child, best\n    26\t\n    27\t\n    28\tdef inspect(env):\n    29\t    reach_level_9(env)\n    30\t    picked = env.clone()\n    31\t    prefix = direct_second_prefix() + COMBINED_DISMISS_PICK + [5]\n    32\t    for action in prefix:\n    33\t        picked.step(action)\n    34\t    exact, exact_best = replay(picked, TAIL)\n    35\t    print(\n    36\t        \"BEST_MUTATION_EXACT\",\n    37\t        len(prefix) + len(TAIL),\n    38\t        exact.levels_completed - picked.levels_completed,\n    39\t        exact_best,\n    40\t        target_state(exact.frame()),\n    41\t        flush=True,\n    42\t    )\n    43\t\n    44\t    best = None\n    45\t    for index in range(len(TAIL)):\n    46\t        shortened = TAIL[:index] + TAIL[index + 1:]\n    47\t        for final_action in picked.actions:\n    48\t            child, filled = replay(picked, shortened + [final_action])\n    49\t            reward = child.levels_completed - picked.levels_completed\n    50\t            target = target_state(child.frame())\n    51\t            score = (reward, filled, len(target[\"filled\"]))\n    52\t            if best is None or score > best[0]:\n    53\t                best = (\n    54\t                    score,\n    55\t                    \"delete\",\n    56\t                    index,\n    57\t                    TAIL[index],\n    58\t                    final_action,\n    59\t                    target,\n    60\t                )\n    61\t            if reward:\n    62\t                print(\n    63\t                    \"BEST_MUTATION_WIN\",\n    64\t                    shortened + [final_action],\n    65\t                    best,\n    66\t                    flush=True,\n    67\t                )\n    68\t                return\n    69\t\n    70\t    for index, original in enumerate(TAIL):\n    71\t        for replacement in picked.actions:\n    72\t            if replacement == original:\n    73\t                continue\n    74\t            route = list(TAIL)\n    75\t            route[index] = replacement\n    76\t            child, filled = replay(picked, route)\n    77\t            reward = child.levels_completed - picked.levels_completed\n    78\t            target = target_state(child.frame())\n    79\t            score = (reward, filled, len(target[\"filled\"]))\n    80\t            if best is None or score > best[0]:\n    81\t                best = (\n    82\t                    score,\n    83\t                    \"replace\",\n    84\t                    index,\n    85\t                    original,\n    86\t                    replacement,\n    87\t                    target,\n    88\t                )\n    89\t            if reward:\n    90\t                print(\"BEST_MUTATION_WIN\", route, best, flush=True)\n    91\t                return\n    92\t\n    93\t    for index in range(len(TAIL) - 1):\n    94\t        route = list(TAIL)\n    95\t        route[index], route[index + 1] = route[index + 1], route[index]\n    96\t        child, filled = replay(picked, route)\n    97\t        reward = child.levels_completed - picked.levels_completed\n    98\t        target = target_state(child.frame())\n    99\t        score = (reward, filled, len(target[\"filled\"]))\n   100\t        if best is None or score > best[0]:\n   101\t            best = (\n   102\t                score,\n   103\t                \"swap\",\n   104\t                index,\n   105\t                TAIL[index:index + 2],\n   106\t                target,\n   107\t            )\n   108\t        if reward:\n   109\t            print(\"BEST_MUTATION_WIN\", route, best, flush=True)\n   110\t            return\n   111\t\n   112\t    print(\"BEST_MUTATION_BEST\", best, flush=True)\n   113\t\n   114\t\n   115\tif __name__ == \"__main__\":\n   116\t    gkm_try.A.run_program(\"wa30\", inspect)\n","exit_code":0,"status":"completed"}}
