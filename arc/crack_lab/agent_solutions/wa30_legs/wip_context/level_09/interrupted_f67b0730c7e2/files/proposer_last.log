{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/zsh -lc \"nl -ba legs.py | sed -n '296,360p'; nl -ba probe8_entry.py | sed -n '1,190p'; nl -ba probe8_optimized_tail.py | sed -n '1,210p'; nl -ba probe8_fast_finish.py | sed -n '1,190p'\"","aggregated_output":"   296\tdef disable_competing_couriers_and_expedite_paired_depots(env):\n   297\t    \"\"\"Dismiss two wrong-way couriers and hand-deliver two slow remote cargos.\"\"\"\n   298\t    base_level = env.levels_completed\n   299\t\n   300\t    # Enter the lower room and meet its left-going courier while it is carrying\n   301\t    # past the lower depot. The final left moves establish contact and facing.\n   302\t    walk(env, RIGHT, 8)\n   303\t    walk(env, DOWN, 5)\n   304\t    walk(env, LEFT, 3)\n   305\t    interact(env)\n   306\t\n   307\t    # Cross the central corridor to the upper room. Intercept the other\n   308\t    # left-going courier at the end of its return sweep, then allow its\n   309\t    # dismissal animation to finish.\n   310\t    walk(env, RIGHT, 3)\n   311\t    walk(env, UP, 5)\n   312\t    walk(env, LEFT, 5)\n   313\t    walk(env, UP, 4)\n   314\t    walk(env, LEFT)\n   315\t    walk(env, UP)\n   316\t    interact(env)\n   317\t    interact(env)\n   318\t    interact(env)\n   319\t\n   320\t    # Carry the exposed bottom-right cargo of the wrong depot directly into\n   321\t    # the lower row of the outlined depot.\n   322\t    walk(env, LEFT)\n   323\t    interact(env)\n   324\t    walk(env, UP)\n   325\t    walk(env, RIGHT, 8)\n   326\t    interact(env)\n   327\t    walk(env, DOWN)\n   328\t\n   329\t    # Take a second cargo from below. Route one row beneath the first delivery\n   330\t    # so the carried block can pass it, then lift it into a later target slot.\n   331\t    walk(env, LEFT, 10)\n   332\t    walk(env, UP)\n   333\t    interact(env)\n   334\t    walk(env, DOWN)\n   335\t    walk(env, RIGHT, 11)\n   336\t    walk(env, UP)\n   337\t    interact(env)\n   338\t    walk(env, DOWN)\n   339\t\n   340\t    # With both competitors gone and two long transfers removed, the surviving\n   341\t    # couriers monotonically empty the plain depots before the turn limit.\n   342\t    while env.levels_completed == base_level and not env.terminal():\n   343\t        interact(env)\n   344\t    walk(env, UP)\n   345\t\n   346\t    # Return the lower delivery to the lower-left target.\n   347\t    walk(env, DOWN, 2)\n   348\t    walk(env, RIGHT, 10)\n   349\t    interact(env)\n   350\t    walk(env, LEFT, 9)\n   351\t    interact(env)\n     1\t\"\"\"Compact pristine level-8 observation for joint cap optimization.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom perception import color_counts, connected_components\n     6\tfrom probe9_verify import boxes, tile_map\n     7\t\n     8\t\n     9\tclass ReachedLevel8(Exception):\n    10\t    pass\n    11\t\n    12\t\n    13\tclass StopAtLevel8:\n    14\t    def __init__(self, env):\n    15\t        self.env = env\n    16\t\n    17\t    def __getattr__(self, name):\n    18\t        return getattr(self.env, name)\n    19\t\n    20\t    def step(self, action, *args):\n    21\t        result = self.env.step(action, *args)\n    22\t        if self.env.levels_completed >= 7:\n    23\t            raise ReachedLevel8\n    24\t        return result\n    25\t\n    26\t\n    27\tdef compact(env):\n    28\t    return {\n    29\t        \"level\": env.levels_completed,\n    30\t        \"terminal\": env.terminal(),\n    31\t        \"actions\": tuple(env.actions),\n    32\t        \"colors\": color_counts(env.frame()),\n    33\t        \"actors\": {\n    34\t            color: boxes(env.frame(), color)\n    35\t            for color in (4, 12, 14, 15)\n    36\t        },\n    37\t        \"blobs\": tuple(\n    38\t            (blob.color, blob.bbox, blob.area)\n    39\t            for blob in connected_components(env.frame(), min_area=4)\n    40\t            if blob.color not in (1, 2)\n    41\t        ),\n    42\t    }\n    43\t\n    44\t\n    45\tdef inspect(env):\n    46\t    try:\n    47\t        gkm_try.resumed_solve(StopAtLevel8(env))\n    48\t    except ReachedLevel8:\n    49\t        pass\n    50\t    print(\"L8_ENTRY\", compact(env), flush=True)\n    51\t    print(\"L8_MAP\", *tile_map(env.frame()), sep=\"\\n\", flush=True)\n    52\t\n    53\t\n    54\tif __name__ == \"__main__\":\n    55\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Inspect and shorten the last courier leg of the 114-turn level-8 route.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom legs import disable_competing_couriers_and_expedite_paired_depots\n     6\tfrom probe8_entry import ReachedLevel8, StopAtLevel8\n     7\tfrom probe8_reverse_stage import compact\n     8\tfrom probe9_verify import tile_map\n     9\t\n    10\t\n    11\tclass ReachedTurn(Exception):\n    12\t    pass\n    13\t\n    14\t\n    15\tclass StopAtTurn:\n    16\t    def __init__(self, env, limit):\n    17\t        self.env = env\n    18\t        self.limit = limit\n    19\t        self.turn = 0\n    20\t\n    21\t    def __getattr__(self, name):\n    22\t        return getattr(self.env, name)\n    23\t\n    24\t    def step(self, action, *args):\n    25\t        result = self.env.step(action, *args)\n    26\t        self.turn += 1\n    27\t        if self.turn >= self.limit:\n    28\t            raise ReachedTurn\n    29\t        return result\n    30\t\n    31\t\n    32\tdef inspect(env):\n    33\t    try:\n    34\t        gkm_try.resumed_solve(StopAtLevel8(env))\n    35\t    except ReachedLevel8:\n    36\t        pass\n    37\t    clone = env.clone()\n    38\t    stopped = StopAtTurn(clone, 99)\n    39\t    try:\n    40\t        disable_competing_couriers_and_expedite_paired_depots(stopped)\n    41\t    except ReachedTurn:\n    42\t        pass\n    43\t    print(\"OPT8_TAIL\", compact(clone, stopped.turn), flush=True)\n    44\t    print(*tile_map(clone.frame()), sep=\"\\n\", flush=True)\n    45\t    base_level = clone.levels_completed\n    46\t    for turn in range(100, 115):\n    47\t        clone.step(5)\n    48\t        print(\n    49\t            \"OPT8_WAIT\",\n    50\t            turn,\n    51\t            compact(clone, turn),\n    52\t            flush=True,\n    53\t        )\n    54\t        if clone.levels_completed > base_level:\n    55\t            break\n    56\t\n    57\t\n    58\tif __name__ == \"__main__\":\n    59\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Inspect and finish the early-dismissal, lower-staging level-8 branch.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe8_entry import ReachedLevel8, StopAtLevel8\n     6\tfrom probe8_reverse_idle import ROUTE\n     7\tfrom probe8_reverse_stage import STAGE_LOWER, compact\n     8\tfrom probe8_trace import target_state\n     9\tfrom probe9_verify import tile_map\n    10\t\n    11\t\n    12\tdef inspect(env):\n    13\t    try:\n    14\t        gkm_try.resumed_solve(StopAtLevel8(env))\n    15\t    except ReachedLevel8:\n    16\t        pass\n    17\t    clone = env.clone()\n    18\t    prefix = ROUTE + STAGE_LOWER\n    19\t    for action in prefix:\n    20\t        clone.step(action)\n    21\t    print(\"FAST8_START\", compact(clone, len(prefix)), flush=True)\n    22\t    print(*tile_map(clone.frame()), sep=\"\\n\", flush=True)\n    23\t\n    24\t    second_stage = [3] * 6 + [1, 5] + [4] * 5 + [5, 2]\n    25\t    turn = len(prefix)\n    26\t    prior = target_state(clone.frame())\n    27\t    for action in second_stage:\n    28\t        clone.step(action)\n    29\t        turn += 1\n    30\t        current = target_state(clone.frame())\n    31\t        if action == 5 or current != prior:\n    32\t            print(\"FAST8_SECOND\", compact(clone, turn), flush=True)\n    33\t        prior = current\n    34\t    while not clone.terminal() and clone.levels_completed == env.levels_completed:\n    35\t        clone.step(5)\n    36\t        turn += 1\n    37\t        current = target_state(clone.frame())\n    38\t        if current != prior or turn >= 84:\n    39\t            print(\"FAST8_EVENT\", compact(clone, turn), flush=True)\n    40\t        prior = current\n    41\t    print(\"FAST8_RESULT\", compact(clone, turn), flush=True)\n    42\t\n    43\t\n    44\tif __name__ == \"__main__\":\n    45\t    gkm_try.A.run_program(\"wa30\", inspect)\n","exit_code":0,"status":"completed"}}
