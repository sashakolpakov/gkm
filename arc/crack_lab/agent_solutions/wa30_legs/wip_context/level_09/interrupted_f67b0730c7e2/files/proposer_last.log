{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe8_reverse_idle.py | sed -n '1,190p'; nl -ba probe8_reverse_stage.py | sed -n '1,220p'; nl -ba probe8_minimize.py | sed -n '1,250p'; nl -ba probe8_third_minimize.py | sed -n '1,140p'\"","aggregated_output":"     1\t\"\"\"Trace target progress after the verified early level-8 dismissals.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe8_entry import ReachedLevel8, StopAtLevel8\n     6\tfrom probe8_trace import target_state\n     7\tfrom probe9_verify import boxes\n     8\t\n     9\t\n    10\tROUTE = (\n    11\t    [4] * 3 + [1] * 3 + [5] * 3\n    12\t    + [2] * 3 + [4] * 5 + [2] * 5\n    13\t    + [2, 2, 3, 3, 1, 5]\n    14\t)\n    15\t\n    16\t\n    17\tdef compact(env, turn):\n    18\t    empty, filled = target_state(env.frame())\n    19\t    return {\n    20\t        \"turn\": turn,\n    21\t        \"level\": env.levels_completed,\n    22\t        \"terminal\": env.terminal(),\n    23\t        \"avatar\": boxes(env.frame(), 14),\n    24\t        \"helpers\": boxes(env.frame(), 12),\n    25\t        \"competitors\": boxes(env.frame(), 15),\n    26\t        \"cargo\": boxes(env.frame(), 4),\n    27\t        \"empty\": empty,\n    28\t        \"filled\": filled,\n    29\t    }\n    30\t\n    31\t\n    32\tdef inspect(env):\n    33\t    try:\n    34\t        gkm_try.resumed_solve(StopAtLevel8(env))\n    35\t    except ReachedLevel8:\n    36\t        pass\n    37\t\n    38\t    base_level = env.levels_completed\n    39\t    clone = env.clone()\n    40\t    for action in ROUTE:\n    41\t        clone.step(action)\n    42\t    print(\"REVERSE_START\", compact(clone, len(ROUTE)), flush=True)\n    43\t\n    44\t    prior = target_state(clone.frame())\n    45\t    for turn in range(len(ROUTE) + 1, 91):\n    46\t        clone.step(5)\n    47\t        current = target_state(clone.frame())\n    48\t        if current != prior or clone.levels_completed > base_level:\n    49\t            print(\"REVERSE_EVENT\", compact(clone, turn), flush=True)\n    50\t        prior = current\n    51\t        if clone.terminal() or clone.levels_completed > base_level:\n    52\t            break\n    53\t\n    54\t\n    55\tif __name__ == \"__main__\":\n    56\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Test a compact bottom-port stage after the early level-8 dismissals.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe8_entry import ReachedLevel8, StopAtLevel8\n     6\tfrom probe8_reverse_idle import ROUTE\n     7\tfrom probe8_trace import target_state\n     8\tfrom probe9_verify import boxes\n     9\t\n    10\t\n    11\tSTAGE_LOWER = (\n    12\t    [3, 3, 5]\n    13\t    + [1] * 2 + [4] * 4 + [5, 2]\n    14\t)\n    15\t\n    16\t\n    17\tdef compact(env, turn):\n    18\t    empty, filled = target_state(env.frame())\n    19\t    return {\n    20\t        \"turn\": turn,\n    21\t        \"level\": env.levels_completed,\n    22\t        \"terminal\": env.terminal(),\n    23\t        \"avatar\": boxes(env.frame(), 14),\n    24\t        \"helpers\": boxes(env.frame(), 12),\n    25\t        \"cargo\": boxes(env.frame(), 4),\n    26\t        \"empty\": empty,\n    27\t        \"filled\": filled,\n    28\t    }\n    29\t\n    30\t\n    31\tdef inspect(env):\n    32\t    try:\n    33\t        gkm_try.resumed_solve(StopAtLevel8(env))\n    34\t    except ReachedLevel8:\n    35\t        pass\n    36\t\n    37\t    base_level = env.levels_completed\n    38\t    clone = env.clone()\n    39\t    for action in ROUTE:\n    40\t        clone.step(action)\n    41\t    for offset, action in enumerate(STAGE_LOWER, 1):\n    42\t        clone.step(action)\n    43\t        if action == 5:\n    44\t            print(\n    45\t                \"STAGE_USE\",\n    46\t                compact(clone, len(ROUTE) + offset),\n    47\t                flush=True,\n    48\t            )\n    49\t    print(\n    50\t        \"STAGE_LOWER_DONE\",\n    51\t        compact(clone, len(ROUTE) + len(STAGE_LOWER)),\n    52\t        flush=True,\n    53\t    )\n    54\t\n    55\t    prior = target_state(clone.frame())\n    56\t    start = len(ROUTE) + len(STAGE_LOWER)\n    57\t    for turn in range(start + 1, 131):\n    58\t        clone.step(5)\n    59\t        current = target_state(clone.frame())\n    60\t        if current != prior or clone.levels_completed > base_level:\n    61\t            print(\"STAGE_EVENT\", compact(clone, turn), flush=True)\n    62\t        prior = current\n    63\t        if clone.terminal() or clone.levels_completed > base_level:\n    64\t            break\n    65\t\n    66\t\n    67\tif __name__ == \"__main__\":\n    68\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Greedily delete actions from the proven level-8 route on bounded clones.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe8_entry import ReachedLevel8, StopAtLevel8\n     6\tfrom probe8_trace import target_state\n     7\t\n     8\t\n     9\tdef active_route():\n    10\t    return (\n    11\t        [4] * 8 + [2] * 5 + [3] * 3 + [5]\n    12\t        + [4] * 3 + [1] * 5 + [3] * 5 + [1] * 4\n    13\t        + [3, 1] + [5] * 3\n    14\t        + [3, 5, 1] + [4] * 8 + [5, 2]\n    15\t        + [3] * 10 + [1, 5, 2] + [4] * 11 + [1, 5, 2]\n    16\t    )\n    17\t\n    18\t\n    19\tdef evaluate(base, actions, max_turns=150):\n    20\t    clone = base.clone()\n    21\t    base_level = clone.levels_completed\n    22\t    used = 0\n    23\t    for action in actions:\n    24\t        if clone.terminal() or clone.levels_completed > base_level:\n    25\t            break\n    26\t        clone.step(action)\n    27\t        used += 1\n    28\t    while (\n    29\t        used < max_turns\n    30\t        and not clone.terminal()\n    31\t        and clone.levels_completed == base_level\n    32\t    ):\n    33\t        clone.step(5)\n    34\t        used += 1\n    35\t    empty, filled = target_state(clone.frame())\n    36\t    return {\n    37\t        \"won\": clone.levels_completed > base_level,\n    38\t        \"turns\": used,\n    39\t        \"empty\": empty,\n    40\t        \"filled\": filled,\n    41\t    }\n    42\t\n    43\t\n    44\tdef minimize(base):\n    45\t    best = active_route()\n    46\t    best_result = evaluate(base, best)\n    47\t    print(\"MIN_START\", len(best), best_result, flush=True)\n    48\t    for chunk in (16, 8, 4, 2, 1):\n    49\t        changed = True\n    50\t        while changed:\n    51\t            changed = False\n    52\t            index = 0\n    53\t            while index < len(best):\n    54\t                candidate = best[:index] + best[index + chunk:]\n    55\t                result = evaluate(base, candidate)\n    56\t                if result[\"won\"] and result[\"turns\"] < best_result[\"turns\"]:\n    57\t                    print(\n    58\t                        \"MIN_ACCEPT\",\n    59\t                        chunk,\n    60\t                        index,\n    61\t                        len(candidate),\n    62\t                        result,\n    63\t                        flush=True,\n    64\t                    )\n    65\t                    best = candidate\n    66\t                    best_result = result\n    67\t                    changed = True\n    68\t                else:\n    69\t                    index += chunk\n    70\t    return best, best_result\n    71\t\n    72\t\n    73\tdef inspect(env):\n    74\t    try:\n    75\t        gkm_try.resumed_solve(StopAtLevel8(env))\n    76\t    except ReachedLevel8:\n    77\t        pass\n    78\t    best, result = minimize(env)\n    79\t    print(\"MIN_RESULT\", best, result, flush=True)\n    80\t\n    81\t\n    82\tif __name__ == \"__main__\":\n    83\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Minimize the verified three-transfer level-8 route.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe8_current_tail import PREFIX\n     6\tfrom probe8_entry import ReachedLevel8, StopAtLevel8\n     7\tfrom probe_pair_minimize import encode, pair_minimize\n     8\t\n     9\t\n    10\tTHIRD = [1] + [3] * 10 + [1, 5, 2] + [4] * 11 + [1, 5, 2]\n    11\tROUTE = PREFIX + THIRD + [5] * 13\n    12\t\n    13\t\n    14\tdef inspect(env):\n    15\t    try:\n    16\t        gkm_try.resumed_solve(StopAtLevel8(env))\n    17\t    except ReachedLevel8:\n    18\t        pass\n    19\t    print(\"THIRD_MIN_BASE\", len(ROUTE), encode(ROUTE), flush=True)\n    20\t    best, turns = pair_minimize(env, ROUTE)\n    21\t    print(\n    22\t        \"THIRD_MIN_RESULT\",\n    23\t        len(best),\n    24\t        turns,\n    25\t        encode(best),\n    26\t        best,\n    27\t        flush=True,\n    28\t    )\n    29\t\n    30\t\n    31\tif __name__ == \"__main__\":\n    32\t    gkm_try.A.run_program(\"wa30\", inspect)\n","exit_code":0,"status":"completed"}}
