{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc 'rg -n \"''^def |''^class |''^[A-Z][A-Z0-9_]* =|if __name__|checkpoint|resumed_solve\" probe9_prefix_shortcuts.py; nl -ba probe9_prefix_shortcuts.py | sed -n '\"'1,130p'\"","aggregated_output":"14:def reach_level_9(env):\n16:        gkm_try.resumed_solve(StopAtLevel9(env))\n21:def compact(env):\n33:def run(env, name, path):\n56:def direct_short_prefix():\n66:def inspect(env):\n155:if __name__ == \"__main__\":\n     1\t\"\"\"Test compact approaches to the first two level-9 remote blocks.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe9_verify import (\n     6\t    ReachedLevel9,\n     7\t    StopAtLevel9,\n     8\t    boxes,\n     9\t    target_state,\n    10\t    tile_map,\n    11\t)\n    12\t\n    13\t\n    14\tdef reach_level_9(env):\n    15\t    try:\n    16\t        gkm_try.resumed_solve(StopAtLevel9(env))\n    17\t    except ReachedLevel9:\n    18\t        pass\n    19\t\n    20\t\n    21\tdef compact(env):\n    22\t    avatar = boxes(env.frame(), 14)\n    23\t    cargo = boxes(env.frame(), 4)\n    24\t    return {\n    25\t        \"avatar\": avatar,\n    26\t        \"cargo\": cargo,\n    27\t        \"courier\": boxes(env.frame(), 12),\n    28\t        \"thief\": boxes(env.frame(), 15),\n    29\t        \"target\": target_state(env.frame())[\"filled\"],\n    30\t    }\n    31\t\n    32\t\n    33\tdef run(env, name, path):\n    34\t    child = env.clone()\n    35\t    base = child.levels_completed\n    36\t    used = 0\n    37\t    for action in path:\n    38\t        if child.terminal() or child.levels_completed > base:\n    39\t            break\n    40\t        child.step(action)\n    41\t        used += 1\n    42\t    print(\n    43\t        \"PREFIX_SHORTCUT\",\n    44\t        name,\n    45\t        {\n    46\t            \"requested\": len(path),\n    47\t            \"used\": used,\n    48\t            \"reward\": child.levels_completed - base,\n    49\t            \"terminal\": child.terminal(),\n    50\t            \"state\": compact(child),\n    51\t        },\n    52\t        flush=True,\n    53\t    )\n    54\t\n    55\t\n    56\tdef direct_short_prefix():\n    57\t    short_first = (\n    58\t        [4] * 5 + [5]\n    59\t        + [3] * 5 + [1] * 3 + [3, 5]\n    60\t    )\n    61\t    second_pick = [2] * 2 + [4] * 5 + [1, 5]\n    62\t    place_bottom_middle = [2] + [3] * 6 + [1] * 3 + [5]\n    63\t    return short_first + second_pick + place_bottom_middle\n    64\t\n    65\t\n    66\tdef inspect(env):\n    67\t    reach_level_9(env)\n    68\t    candidates = {\n    69\t        \"right4_use\": [4] * 4 + [5],\n    70\t        \"right5_use\": [4] * 5 + [5],\n    71\t        \"right4_down_use\": [4] * 4 + [2, 5],\n    72\t        \"down_right4_use\": [2] + [4] * 4 + [5],\n    73\t        \"down_right5_use\": [2] + [4] * 5 + [5],\n    74\t        \"down_right6_up_use\": [2] + [4] * 6 + [1, 5],\n    75\t        \"right4_down_right_use\": [4] * 4 + [2, 4, 5],\n    76\t    }\n    77\t    for name, path in candidates.items():\n    78\t        run(env, name, path)\n    79\t\n    80\t    short_first = [4] * 5 + [5] + [3] * 5 + [1] * 3 + [3, 5]\n    81\t    second_pick = [2] * 2 + [4] * 5 + [1, 5]\n    82\t    place_bottom_middle = [2] + [3] * 6 + [1] * 3 + [5]\n    83\t    short_prefix = direct_short_prefix()\n    84\t    combined_dismiss = [2, 2, 3, 5, 3, 3, 3]\n    85\t    position = [5, 4] + [1] * 6 + [4] * 5\n    86\t    known_suffix = [4, 5, 1, 3, 2, 5, 2, 5, 1]\n    87\t    run(env, \"short_first\", short_first)\n    88\t    run(env, \"short_prefix\", short_prefix)\n    89\t    mapped = env.clone()\n    90\t    for action in short_prefix:\n    91\t        mapped.step(action)\n    92\t    print(\"SHORT_PREFIX_MAP\", *tile_map(mapped.frame()), sep=\"\\n\", flush=True)\n    93\t    run(\n    94\t        env,\n    95\t        \"short_complete_known\",\n    96\t        short_prefix + combined_dismiss + position + known_suffix + [1] * 5,\n    97\t    )\n    98\t    short_dismiss = [3] * 5 + [5]\n    99\t    short_pick = [3, 3, 1, 5]\n   100\t    short_position = [4] + [1] * 6 + [4] * 5\n   101\t    run(\n   102\t        env,\n   103\t        \"short_complete_local\",\n   104\t        (\n   105\t            short_prefix\n   106\t            + short_dismiss\n   107\t            + short_pick\n   108\t            + short_position\n   109\t            + known_suffix\n   110\t            + [1] * 5\n   111\t        ),\n   112\t    )\n   113\t    collision_pick = [1, 3, 3]\n   114\t    run(\n   115\t        env,\n   116\t        \"short_complete_collision\",\n   117\t        (\n   118\t            short_prefix\n   119\t            + short_dismiss\n   120\t            + collision_pick\n   121\t            + short_position\n   122\t            + known_suffix\n   123\t            + [1] * 8\n   124\t        ),\n   125\t    )\n   126\t    run(\n   127\t        env,\n   128\t        \"short_complete_collision_use\",\n   129\t        (\n   130\t            short_prefix\n","exit_code":0,"status":"completed"}}
