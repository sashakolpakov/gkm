  22\tdef replay(base, actions):\n    23\t    clone = base.clone()\n    24\t    for action in actions:\n    25\t        if clone.terminal() or clone.levels_completed > base.levels_completed:\n    26\t            break\n    27\t        clone.step(action)\n    28\t    return clone\n    29\t\n    30\t\n    31\tdef shortest_dismissal(start, label, max_depth=5):\n    32\t    frontier = [(start.clone(), [])]\n    33\t    seen = {start.frame().tobytes()}\n    34\t    transitions = 0\n    35\t    for depth in range(1, max_depth + 1):\n    36\t        next_frontier = []\n    37\t        wins = []\n    38\t        for node, path in frontier:\n    39\t            for action in node.actions:\n    40\t                child = node.clone()\n    41\t                child.step(action)\n    42\t                transitions += 1\n    43\t                child_path = path + [action]\n    44\t                if not boxes(child.frame(), 15):\n    45\t                    wins.append((child_path, state(child)))\n    46\t                    continue\n    47\t                key = child.frame().tobytes()\n    48\t                if key not in seen:\n    49\t                    seen.add(key)\n    50\t                    next_frontier.append((child, child_path))\n    51\t        print(\n    52\t            \"DISMISS_DEPTH\", label, depth, len(next_frontier), transitions,\n    53\t            flush=True,\n    54\t        )\n    55\t        if wins:\n    56\t            return wins\n    57\t        frontier = next_frontier\n    58\t    return []\n    59\t\n    60\t\n    61\tdef inspect(env):\n    62\t    gkm_try.resumed_solve(env)\n    63\t\n    64\t    first_delivery = (\n    65\t        [3, 1, 5]\n    66\t        + [3] * 6 + [1] * 3 + [3, 5]\n    67\t    )\n    68\t    second_delivery = (\n    69\t        [2] * 2 + [4] * 5 + [1, 5]\n    70\t        + [2] + [3] * 6 + [1] * 3 + [5]\n    71\t    )\n    72\t    second_pick = [2] * 2 + [4] * 5 + [1, 5]\n    73\t    prefix = first_delivery + second_delivery\n    74\t    inline_dismiss = prefix[:30] + [5, 3, 1, 5]\n    75\t    replace_second = [4, 1, 5] + [1] * 3 + [5, 2]\n    76\t    early_inline_a = prefix[:29] + [2, 5, 4, 3, 5]\n    77\t    early_inline_b = prefix[:29] + [5, 3, 2, 1, 5]\n    78\t    stage8 = first_delivery + second_pick + [2] + [3] * 4 + [1, 5]\n    79\t    stage8_dismiss = stage8 + [3, 3, 3, 1, 5]\n    80\t    stage8_manual = (\n    81\t        stage8_dismiss\n    82\t        + [3] * 4 + [5]\n    83\t        + [1] * 3 + [4] * 6 + [5, 4]\n    84\t    )\n    85\t    paths = {\n    86\t        \"first_delivery\": first_delivery,\n    87\t        \"two_deliveries\": prefix,\n    88\t        \"two_idle23\": prefix + [5] * 23,\n    89\t        \"old_dismiss\": prefix + [2, 2, 3, 5],\n    90\t        \"old_tail\": (\n    91\t            prefix + [2, 2, 3, 5]\n    92\t            + [3] * 3 + [5, 4]\n    93\t            + [1] * 6 + [4] * 5\n    94\t            + [5, 1, 3, 2, 5, 2, 5, 1]\n    95\t        ),\n    96\t        \"inline_dismiss\": inline_dismiss,\n    97\t        \"inline_idle\": inline_dismiss + [5] * 24,\n    98\t        \"inline_replaced\": inline_dismiss + replace_second,\n    99\t        \"inline_finish\": inline_dismiss + replace_second + [5] * 16,\n   100\t        \"early_a_idle\": early_inline_a + [5] * 24,\n   101\t        \"early_b_idle\": early_inline_b + [5] * 24,\n   102\t        \"stage8_idle\": stage8 + [5] * 30,\n   103\t        \"stage8_safe_idle\": stage8_dismiss + [5] * 24,\n   104\t        \"stage8_manual\": stage8_manual + [5] * 8,\n   105\t    }\n   106\t    for name, path in paths.items():\n   107\t        clone = replay(env, path)\n   108\t        print(\"CANDIDATE\", name, len(path), state(clone), flush=True)\n   109\t\n   110\t    watch = replay(env, inline_dismiss + replace_second)\n   111\t    for turn in range(55, 71):\n   112\t        current = state(watch)\n   113\t        print(\n   114\t            \"HELPER_TRACE\",\n   115\t            turn,\n   116\t            current[\"helper\"],\n   117\t            current[\"empty\"],\n   118\t            current[\"filled\"],\n   119\t            flush=True,\n   120\t        )\n   121\t        if watch.terminal():\n   122\t            break\n   123\t        watch.step(5)\n   124\t\n   125\t    trace = env.clone()\n   126\t    prior = None\n   127\t    for turn, action in enumerate(prefix + [5] * 23, 14):\n   128\t        trace.step(action)\n   129\t        current = state(trace)\n   130\t        condensed = (\n   131\t            current[\"empty\"],\n   132\t            current[\"filled\"],\n   133\t            current[\"thief\"],\n   134\t            current[\"level\"],\n   135\t            current[\"terminal\"],\n   136\t        )\n   137\t        if action == 5 or condensed != prior:\n   138\t            print(\"EVENT\", turn, action, current, flush=True)\n   139\t        prior = condensed\n   140\t        if trace.terminal() or trace.levels_completed > env.levels_completed:\n   141\t            break\n   142\t\n   143\t\n   144\tif __name__ == \"__main__\":\n   145\t    gkm_try.A.run_program(\"wa30\", inspect)\n","exit_code":0,"status":"completed"}}
