{"type":"item.completed","item":{"id":"item_115","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe9_reverse_combined.py | sed -n '1,180p'; nl -ba probe9_picksearch_finish.py | sed -n '1,100p'; nl -ba probe9_reroute.py | sed -n '1,120p'\"","aggregated_output":"     1\t\"\"\"Combine the second right-slot delivery with an early thief dismissal.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom perception import bounded_replay_bfs\n     6\tfrom probe9_actual_candidates import state\n     7\tfrom probe9_prefix_shortcuts import reach_level_9\n     8\tfrom probe9_verify import boxes, target_state, tile_map\n     9\t\n    10\t\n    11\tMIDDLE_RIGHT = (\n    12\t    [4] * 5 + [1, 3, 5]\n    13\t    + [2] * 2 + [3] * 5 + [1] * 5\n    14\t    + [5, 2]\n    15\t)\n    16\tSECOND_PICK = [2] * 4 + [4] * 6 + [1, 5]\n    17\t\n    18\t\n    19\tdef combined_goal(env, _path):\n    20\t    target = target_state(env.frame())\n    21\t    return (\n    22\t        (5, 5) in target[\"filled\"]\n    23\t        and (5, 7) in target[\"filled\"]\n    24\t        and not boxes(env.frame(), 15)\n    25\t    )\n    26\t\n    27\t\n    28\tdef reward_goal(base_level):\n    29\t    return lambda env, _path: env.levels_completed > base_level\n    30\t\n    31\t\n    32\tdef inspect(env):\n    33\t    reach_level_9(env)\n    34\t    picked = env.clone()\n    35\t    prefix = MIDDLE_RIGHT + SECOND_PICK\n    36\t    for action in prefix:\n    37\t        picked.step(action)\n    38\t    print(\"REVERSE_COMBINED_START\", len(prefix), state(picked), flush=True)\n    39\t\n    40\t    direct_bridge = [3] * 6 + [1] * 3 + [3, 5, 3, 5]\n    41\t    direct = picked.clone()\n    42\t    for action in direct_bridge:\n    43\t        direct.step(action)\n    44\t    print(\n    45\t        \"REVERSE_COMBINED_DIRECT\",\n    46\t        len(prefix) + len(direct_bridge),\n    47\t        state(direct),\n    48\t        flush=True,\n    49\t    )\n    50\t    if combined_goal(direct, direct_bridge):\n    51\t        bridge = direct_bridge\n    52\t    else:\n    53\t        bridge = bounded_replay_bfs(\n    54\t            picked,\n    55\t            combined_goal,\n    56\t            lambda node: node.actions,\n    57\t            max_states=5000,\n    58\t            max_depth=16,\n    59\t        )\n    60\t    print(\"REVERSE_COMBINED_BRIDGE\", bridge, flush=True)\n    61\t    if bridge is None:\n    62\t        return\n    63\t    bridged = picked.clone()\n    64\t    for action in bridge:\n    65\t        bridged.step(action)\n    66\t    turn = len(prefix) + len(bridge)\n    67\t    print(\"REVERSE_COMBINED_STATE\", turn, state(bridged), flush=True)\n    68\t    print(*tile_map(bridged.frame()), sep=\"\\n\", flush=True)\n    69\t\n    70\t    direct_finish = (\n    71\t        [3] * 5 + [2, 5]\n    72\t        + [1] * 5 + [4] * 6\n    73\t        + [2, 5, 1]\n    74\t    )\n    75\t    direct_final = bridged.clone()\n    76\t    base_level = direct_final.levels_completed\n    77\t    for action in direct_finish:\n    78\t        direct_final.step(action)\n    79\t        if direct_final.levels_completed > base_level:\n    80\t            break\n    81\t    print(\n    82\t        \"REVERSE_COMBINED_DIRECT_FINISH\",\n    83\t        turn + len(direct_finish),\n    84\t        state(direct_final),\n    85\t        flush=True,\n    86\t    )\n    87\t    for extra in direct_final.actions:\n    88\t        child = direct_final.clone()\n    89\t        child.step(extra)\n    90\t        print(\n    91\t            \"REVERSE_COMBINED_EXTRA\",\n    92\t            extra,\n    93\t            child.levels_completed - base_level,\n    94\t            state(child),\n    95\t            flush=True,\n    96\t        )\n    97\t    final_tick = direct_final.clone()\n    98\t    final_tick.step(5)\n    99\t    final_tick.step(5)\n   100\t    print(\n   101\t        \"REVERSE_COMBINED_FINAL_TICK\",\n   102\t        final_tick.levels_completed - base_level,\n   103\t        state(final_tick),\n   104\t        flush=True,\n   105\t    )\n   106\t    if direct_final.levels_completed > base_level:\n   107\t        finish = direct_finish\n   108\t    else:\n   109\t        finish = None\n   110\t        for extra in direct_final.actions:\n   111\t            child = direct_final.clone()\n   112\t            child.step(extra)\n   113\t            if child.levels_completed > base_level:\n   114\t                finish = direct_finish + [extra]\n   115\t                break\n   116\t        if final_tick.levels_completed > base_level:\n   117\t            finish = direct_finish + [5, 5]\n   118\t    print(\"REVERSE_COMBINED_FINISH\", finish, flush=True)\n   119\t    if finish is not None:\n   120\t        print(\"REVERSE_COMBINED_WIN\", prefix + bridge + finish, flush=True)\n   121\t\n   122\t\n   123\tif __name__ == \"__main__\":\n   124\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Verify the one-action-faster pristine level-9 candidate for reward.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe9_candidate import direct_second_prefix\n     6\tfrom probe9_verify import ReachedLevel9, StopAtLevel9, boxes, target_state\n     7\t\n     8\t\n     9\tCOMBINED_DISMISS_PICK = [2, 2, 3, 5, 3, 3, 3]\n    10\tDELIVER_LOCAL = (\n    11\t    [4] + [1] * 6 + [4] * 5\n    12\t    + [4, 5, 1, 3, 2, 5, 2, 5, 1]\n    13\t    + [5]\n    14\t)\n    15\t\n    16\t\n    17\tdef inspect(env):\n    18\t    try:\n    19\t        gkm_try.resumed_solve(StopAtLevel9(env))\n    20\t    except ReachedLevel9:\n    21\t        pass\n    22\t\n    23\t    clone = env.clone()\n    24\t    base_level = clone.levels_completed\n    25\t    route = direct_second_prefix() + COMBINED_DISMISS_PICK + DELIVER_LOCAL\n    26\t    prior = target_state(clone.frame())\n    27\t    for turn, action in enumerate(route, 1):\n    28\t        clone.step(action)\n    29\t        current = target_state(clone.frame())\n    30\t        if current != prior or turn >= 64:\n    31\t            print(\n    32\t                \"FAST_EVENT\",\n    33\t                {\n    34\t                    \"turn\": turn,\n    35\t                    \"action\": action,\n    36\t                    \"level\": clone.levels_completed,\n    37\t                    \"terminal\": clone.terminal(),\n    38\t                    \"target\": current,\n    39\t                    \"avatar\": boxes(clone.frame(), 14),\n    40\t                },\n    41\t                flush=True,\n    42\t            )\n    43\t        prior = current\n    44\t        if clone.terminal() or clone.levels_completed > base_level:\n    45\t            break\n    46\t    print(\n    47\t        \"FAST_RESULT\",\n    48\t        {\n    49\t            \"requested\": len(route),\n    50\t            \"level\": clone.levels_completed,\n    51\t            \"reward\": clone.levels_completed - base_level,\n    52\t            \"terminal\": clone.terminal(),\n    53\t            \"target\": target_state(clone.frame()),\n    54\t        },\n    55\t        flush=True,\n    56\t    )\n    57\t    while (\n    58\t        not clone.terminal()\n    59\t        and clone.levels_completed == base_level\n    60\t        and len(route) < 70\n    61\t    ):\n    62\t        clone.step(5)\n    63\t        route.append(5)\n    64\t        print(\n    65\t            \"FAST_WAIT\",\n    66\t            len(route),\n    67\t            clone.levels_completed - base_level,\n    68\t            clone.terminal(),\n    69\t            target_state(clone.frame()),\n    70\t            flush=True,\n    71\t        )\n    72\t\n    73\t\n    74\tif __name__ == \"__main__\":\n    75\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Find a shortest second-delivery ordering with an earlier dismissal.\"\"\"\n     2\t\n     3\tfrom itertools import combinations, product\n     4\t\n     5\timport gkm_try\n     6\t\n     7\tfrom perception import arr\n     8\tfrom probe9_verify import (\n     9\t    ReachedLevel9,\n    10\t    StopAtLevel9,\n    11\t    boxes,\n    12\t    target_state,\n    13\t)\n    14\t\n    15\t\n    16\tdef second_pick_prefix():\n    17\t    remote_pick = [2] + [4] * 6 + [1, 5]\n    18\t    first_delivery = remote_pick + [3] * 6 + [1] * 3 + [3, 5]\n    19\t    return first_delivery + [2] * 2 + [4] * 5 + [1, 5]\n    20\t\n    21\t\n    22\tdef inspect(env):\n    23\t    try:\n    24\t        gkm_try.resumed_solve(StopAtLevel9(env))\n    25\t    except ReachedLevel9:\n    26\t        pass\n    27\t\n    28\t    picked = env.clone()\n    29\t    prefix = second_pick_prefix()\n    30\t    for action in prefix:\n    31\t        picked.step(action)\n    32\t\n    33\t    endings = {}\n    34\t    for up_positions in combinations(range(9), 3):\n    35\t        up_positions = set(up_positions)\n    36\t        ordering = [\n    37\t            1 if index in up_positions else 3\n    38\t            for index in range(9)\n    39\t        ]\n    40\t        route = [2] + ordering + [5]\n    41\t        state = picked.clone()\n    42\t        for action in route:\n    43\t            state.step(action)\n    44\t        target = target_state(state.frame())\n    45\t        if (\n    46\t            boxes(state.frame(), 14) == ((25, 24, 27, 27),)\n    47\t            and target[\"signatures\"][(5, 6)] == (3, 9)\n    48\t        ):\n    49\t            endings.setdefault(\n    50\t                arr(state.frame()).tobytes(),\n    51\t                (state, route),\n    52\t            )\n    53\t    print(\"REROUTE_ENDINGS\", len(endings), flush=True)\n    54\t\n    55\t    wins = []\n    56\t    for state, route in endings.values():\n    57\t        for depth in range(1, 4):\n    58\t            for suffix in product(state.actions, repeat=depth):\n    59\t                child = state.clone()\n    60\t                for action in suffix:\n    61\t                    child.step(action)\n    62\t                target = target_state(child.frame())\n    63\t                if (\n    64\t                    (5, 6) in target[\"filled\"]\n    65\t                    and not boxes(child.frame(), 15)\n    66\t                ):\n    67\t                    wins.append(\n    68\t                        {\n    69\t                            \"route\": route,\n    70\t                            \"contact\": list(suffix),\n    71\t                            \"turn\": len(prefix) + len(route) + depth,\n    72\t                            \"avatar\": boxes(child.frame(), 14),\n    73\t                            \"courier_12\": boxes(child.frame(), 12),\n    74\t                        }\n    75\t                    )\n    76\t            if wins:\n    77\t                break\n    78\t    print(\"REROUTE_WINS\", wins, flush=True)\n    79\t\n    80\t\n    81\tgkm_try.A.run_program(\"wa30\", inspect)\n","exit_code":0,"status":"completed"}}
