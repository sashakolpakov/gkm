{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/zsh -lc \"nl -ba probe8_combo_finish.py | sed -n '1,220p'; nl -ba probe8_combo.py | sed -n '1,150p'; nl -ba probe8_reposition.py | sed -n '1,150p'\"","aggregated_output":"     1\t\"\"\"Compare compact finishes from the verified level-8 combined prefix.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe8_combo import REVERSE_TOP, UPPER_DELIVERY\n     6\tfrom probe8_entry import ReachedLevel8, StopAtLevel8\n     7\tfrom probe8_reverse_stage import compact\n     8\t\n     9\t\n    10\tAPPROACH_AND_DISMISS = (\n    11\t    [3] * 7 + [2] * 3 + [4] * 5 + [2] * 4 + [5, 3, 5]\n    12\t)\n    13\tPREFIX = REVERSE_TOP + UPPER_DELIVERY + APPROACH_AND_DISMISS\n    14\t\n    15\tTO_ROW13_RIGHT = (\n    16\t    [1] + [3] * 4 + [2, 5, 1] + [4] * 10 + [2] * 2 + [5]\n    17\t)\n    18\tTO_ROW14_RIGHT = (\n    19\t    [1] + [3] * 4 + [2, 5, 1] + [4] * 10 + [2] * 3 + [5]\n    20\t)\n    21\t\n    22\t\n    23\tdef finish(base, suffix, label):\n    24\t    clone = base.clone()\n    25\t    base_level = clone.levels_completed\n    26\t    turn = len(PREFIX)\n    27\t    for action in suffix:\n    28\t        clone.step(action)\n    29\t        turn += 1\n    30\t        if clone.levels_completed > base_level or clone.terminal():\n    31\t            break\n    32\t    placed = compact(clone, turn)\n    33\t    print(label + \"_PLACED\", placed, flush=True)\n    34\t    prior = (placed[\"empty\"], placed[\"filled\"])\n    35\t    while clone.levels_completed == base_level and not clone.terminal():\n    36\t        clone.step(5)\n    37\t        turn += 1\n    38\t        current = compact(clone, turn)\n    39\t        progress = (current[\"empty\"], current[\"filled\"])\n    40\t        if progress != prior:\n    41\t            print(label + \"_EVENT\", current, flush=True)\n    42\t        prior = progress\n    43\t    print(label + \"_RESULT\", compact(clone, turn), flush=True)\n    44\t\n    45\t\n    46\tdef inspect(env):\n    47\t    try:\n    48\t        gkm_try.resumed_solve(StopAtLevel8(env))\n    49\t    except ReachedLevel8:\n    50\t        pass\n    51\t    start = env.clone()\n    52\t    for action in PREFIX:\n    53\t        start.step(action)\n    54\t    print(\"FINISH_START\", compact(start, len(PREFIX)), flush=True)\n    55\t    finish(start, (), \"IDLE\")\n    56\t    finish(start, TO_ROW13_RIGHT, \"ROW13\")\n    57\t    finish(start, TO_ROW14_RIGHT, \"ROW14\")\n    58\t\n    59\t\n    60\tif __name__ == \"__main__\":\n    61\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Combine an early top delivery with a later lower-courier dismissal.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom perception import bounded_bfs\n     6\tfrom probe8_entry import ReachedLevel8, StopAtLevel8\n     7\tfrom probe8_lower_manual import REVERSE_TOP\n     8\tfrom probe8_reverse_stage import compact\n     9\tfrom probe9_verify import boxes, tile_map\n    10\t\n    11\t\n    12\tUPPER_DELIVERY = [1, 1, 5, 2] + [4] * 7 + [1, 5, 2]\n    13\t\n    14\t\n    15\tdef inspect(env):\n    16\t    try:\n    17\t        gkm_try.resumed_solve(StopAtLevel8(env))\n    18\t    except ReachedLevel8:\n    19\t        pass\n    20\t\n    21\t    delivered = env.clone()\n    22\t    for action in REVERSE_TOP + UPPER_DELIVERY:\n    23\t        delivered.step(action)\n    24\t    print(\"COMBO_DELIVERED\", compact(delivered, 24), flush=True)\n    25\t    print(*tile_map(delivered.frame()), sep=\"\\n\", flush=True)\n    26\t\n    27\t    approaches = (\n    28\t        [3] * 6 + [2] * 3 + [4] * 5 + [2] * 4,\n    29\t        [3] * 7 + [2] * 3 + [4] * 5 + [2] * 4,\n    30\t        [3] * 6 + [2] * 3 + [4] * 4 + [2] * 4,\n    31\t    )\n    32\t    for index, approach in enumerate(approaches):\n    33\t        node = delivered.clone()\n    34\t        for action in approach:\n    35\t            node.step(action)\n    36\t        path = bounded_bfs(\n    37\t            node,\n    38\t            lambda candidate, _: not boxes(candidate.frame(), 15),\n    39\t            actions=(5, 1, 2, 3, 4),\n    40\t            max_states=10000,\n    41\t            max_depth=9,\n    42\t        )\n    43\t        print(\n    44\t            \"COMBO_APPROACH\",\n    45\t            index,\n    46\t            len(approach),\n    47\t            compact(node, 24 + len(approach)),\n    48\t            path,\n    49\t            flush=True,\n    50\t        )\n    51\t        print(*tile_map(node.frame()), sep=\"\\n\", flush=True)\n    52\t\n    53\t    best = delivered.clone()\n    54\t    best_suffix = approaches[1] + [5, 3, 5]\n    55\t    for action in best_suffix:\n    56\t        best.step(action)\n    57\t    print(\n    58\t        \"COMBO_DISMISSED\",\n    59\t        len(REVERSE_TOP + UPPER_DELIVERY + best_suffix),\n    60\t        compact(best, len(REVERSE_TOP + UPPER_DELIVERY + best_suffix)),\n    61\t        flush=True,\n    62\t    )\n    63\t    print(*tile_map(best.frame()), sep=\"\\n\", flush=True)\n    64\t\n    65\t    lower_two = (\n    66\t        [1] + [3] * 4 + [2, 5, 1] + [4] * 10 + [2, 5]\n    67\t        + [3] * 8 + [2] * 3 + [3, 5, 4, 1] + [4] * 8 + [5]\n    68\t    )\n    69\t    base_level = best.levels_completed\n    70\t    prior = compact(best, 45)\n    71\t    for offset, action in enumerate(lower_two, 1):\n    72\t        best.step(action)\n    73\t        current = compact(best, 45 + offset)\n    74\t        if (\n    75\t            action == 5\n    76\t            or current[\"empty\"] != prior[\"empty\"]\n    77\t            or current[\"filled\"] != prior[\"filled\"]\n    78\t            or current[\"level\"] != base_level\n    79\t        ):\n    80\t            print(\"COMBO_LOWER\", action, current, flush=True)\n    81\t        prior = current\n    82\t        if best.levels_completed > base_level or best.terminal():\n    83\t            break\n    84\t    wait_turn = 45 + len(lower_two)\n    85\t    while best.levels_completed == base_level and not best.terminal():\n    86\t        best.step(5)\n    87\t        wait_turn += 1\n    88\t        current = compact(best, wait_turn)\n    89\t        if (\n    90\t            current[\"empty\"] != prior[\"empty\"]\n    91\t            or current[\"filled\"] != prior[\"filled\"]\n    92\t            or current[\"level\"] != base_level\n    93\t        ):\n    94\t            print(\"COMBO_WAIT\", current, flush=True)\n    95\t        prior = current\n    96\t    print(\"COMBO_RESULT\", compact(best, wait_turn), flush=True)\n    97\t\n    98\t\n    99\tif __name__ == \"__main__\":\n   100\t    gkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Reposition friendly lower deliveries into otherwise-unused target slots.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom perception import bounded_bfs\n     6\tfrom probe8_entry import ReachedLevel8, StopAtLevel8\n     7\tfrom probe8_reverse_idle import ROUTE\n     8\tfrom probe8_reverse_stage import compact\n     9\tfrom probe8_trace import target_state\n    10\tfrom probe9_verify import tile_map\n    11\t\n    12\t\n    13\tSHIFT_TWO = (\n    14\t    [4] * 4 + [5] + [4] * 2 + [5]\n    15\t    + [3] * 2 + [1] * 2 + [5] + [4] * 2 + [5]\n    16\t)\n    17\tSHIFT_BOTTOM_QUEUE = (\n    18\t    [4] * 4 + [5] + [4] * 2 + [5]\n    19\t    + [5] * 19\n    20\t    + [4, 3, 5, 4, 5]\n    21\t)\n    22\t\n    23\t\n    24\tdef run_candidate(base, actions, label):\n    25\t    clone = base.clone()\n    26\t    base_level = clone.levels_completed\n    27\t    prior = compact(clone, len(ROUTE))\n    28\t    for offset, action in enumerate(actions, 1):\n    29\t        clone.step(action)\n    30\t        current = compact(clone, len(ROUTE) + offset)\n    31\t        if (\n    32\t            action == 5\n    33\t            or current[\"empty\"] != prior[\"empty\"]\n    34\t            or current[\"filled\"] != prior[\"filled\"]\n    35\t        ):\n    36\t            print(label, action, current, flush=True)\n    37\t        prior = current\n    38\t    print(label + \"_MAP\", *tile_map(clone.frame()), sep=\"\\n\", flush=True)\n    39\t    turn = len(ROUTE) + len(actions)\n    40\t    while clone.levels_completed == base_level and not clone.terminal():\n    41\t        clone.step(5)\n    42\t        turn += 1\n    43\t        current = compact(clone, turn)\n    44\t        if (\n    45\t            current[\"empty\"] != prior[\"empty\"]\n    46\t            or current[\"filled\"] != prior[\"filled\"]\n    47\t            or current[\"level\"] != base_level\n    48\t        ):\n    49\t            print(label + \"_WAIT\", current, flush=True)\n    50\t        prior = current\n    51\t    print(label + \"_RESULT\", compact(clone, turn), flush=True)\n    52\t\n    53\t\n    54\tdef inspect(env):\n    55\t    try:\n    56\t        gkm_try.resumed_solve(StopAtLevel8(env))\n    57\t    except ReachedLevel8:\n    58\t        pass\n    59\t    start = env.clone()\n    60\t    for action in ROUTE:\n    61\t        start.step(action)\n    62\t    run_candidate(start, SHIFT_TWO, \"SHIFT_TWO\")\n    63\t    run_candidate(start, SHIFT_TWO[:8], \"SHIFT_ONE\")\n    64\t    run_candidate(start, SHIFT_BOTTOM_QUEUE, \"SHIFT_QUEUE\")\n    65\t\n    66\t    local = start.clone()\n    67\t    setup = (\n    68\t        [4] * 4 + [5] + [4] * 2 + [5]\n    69\t        + [3] * 2 + [5] * 24\n    70\t    )\n    71\t    for action in setup:\n    72\t        local.step(action)\n    73\t    print(\"SHIFT_SEARCH_START\", compact(local, 62), flush=True)\n    74\t    path = bounded_bfs(\n    75\t        local,\n    76\t        lambda candidate, _: {\n    77\t            (14, 13), (14, 14)\n    78\t        }.issubset(set(target_state(candidate.frame())[1])),\n    79\t        actions=(3, 4, 5, 1, 2),\n    80\t        max_states=3000,\n    81\t        max_depth=6,\n    82\t    )\n    83\t    print(\"SHIFT_SEARCH_RESULT\", path, flush=True)\n    84\t\n    85\t\n    86\tif __name__ == \"__main__\":\n    87\t    gkm_try.A.run_program(\"wa30\", inspect)\n","exit_code":0,"status":"completed"}}
