{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"MPLCONFIGDIR=/tmp/gkm_mpl_probe python - <<'PY'\nimport importlib.util,sys\nsys.path.insert(0,'/Users/sasha/gkm/arc/crack_lab')\nimport gkm_arena as A\nfrom perception import connected_components\ns=importlib.util.spec_from_file_location('s','solve.py'); m=importlib.util.module_from_spec(s); s.loader.exec_module(m)\ndef cell(blob): return (round(blob.centroid[0]/4),round(blob.centroid[1]/4))\ndef f(env):\n m.solve(env); n=env.clone(); path=[4]*3+[1]*3+[5]+[2]*3+[4]*5+[2]*3\n for a in path:n.step(a)\n print('start',len(path),cell(connected_components(n.frame(),[14])[0]),[(b.area,cell(b)) for b in connected_components(n.frame(),[15])])\n for k in range(50):\n  av=connected_components(n.frame(),[14])[0]; active=[b for b in connected_components(n.frame(),[15]) if b.area>=9]\n  if not active: print('dismissed',len(path),path); return\n  target=max(active,key=lambda b:b.centroid[0]); ar,ac=cell(av); tr,tc=cell(target); d=abs(ar-tr)+abs(ac-tc)\n  if d<=1: a=5 if d==0 else (2 if tr>ar else 1 if tr<ar else 4 if tc>ac else 3)\n  elif ar<tr:a=2\n  elif ar>tr:a=1\n  elif ac<tc:a=4\n  else:a=3\n  path.append(a); n.step(a)\n  print(len(path),a,(ar,ac),(tr,tc),[(b.area,cell(b)) for b in connected_components(n.frame(),[15])])\n print('fail',path)\nA.run_program('wa30',f)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
