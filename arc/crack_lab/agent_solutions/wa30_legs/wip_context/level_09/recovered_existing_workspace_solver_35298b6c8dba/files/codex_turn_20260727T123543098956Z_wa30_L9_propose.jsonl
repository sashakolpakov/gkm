# Send the central loose block through the bottom port.\n   122\t    walk(env, RIGHT)\n   123\t    walk(env, DOWN)  # blocked contact faces the block\n   124\t    interact(env)\n   125\t    walk(env, LEFT)\n   126\t    walk(env, DOWN, 2)\n   127\t    interact(env)\n   128\t\n   129\t    # Send the lower-right block through the right port.\n   130\t    walk(env, RIGHT, 2)\n   131\t    interact(env)\n   132\t    walk(env, UP, 3)\n   133\t    walk(env, RIGHT)\n   134\t    interact(env)\n   135\t\n   136\t    # Send the lower-left block through the left port.\n   137\t    walk(env, DOWN, 3)\n   138\t    walk(env, LEFT, 3)\n   139\t    interact(env)\n   140\t    walk(env, UP, 2)\n   141\t    walk(env, LEFT)\n   142\t    interact(env)\n   143\t\n   144\t    # Refill the left port once its courier has cleared the first queued block.\n   145\t    walk(env, RIGHT)\n   146\t    walk(env, UP, 2)\n   147\t    walk(env, LEFT)\n   148\t    interact(env)\n   149\t    walk(env, DOWN, 2)\n   150\t    walk(env, LEFT, 2)  # the second step holds the block at the port\n   151\t    interact(env)\n   152\t\n   153\t    # Turn the upper-middle block around so it can enter the bottom port.\n   154\t    walk(env, RIGHT, 2)\n   155\t    walk(env, UP, 2)\n   156\t    interact(env)\n   157\t    walk(env, DOWN, 2)\n   158\t    interact(env)\n   159\t    walk(env, LEFT)\n   160\t    walk(env, UP, 2)\n   161\t    walk(env, RIGHT)\n   162\t    walk(env, DOWN)\n   163\t    interact(env)\n   164\t    walk(env, DOWN, 3)\n   165\t    interact(env)\n   166\t\n   167\t    # Route the final upper-right block directly into the right port.\n   168\t    walk(env, UP, 4)\n   169\t    walk(env, RIGHT)\n   170\t    interact(env)\n   171\t    walk(env, DOWN)\n   172\t    walk(env, RIGHT)\n   173\t    interact(env)\n   174\t    walk(env, LEFT)  # leave the port so waiting cannot re-grab its cargo\n   175\t\n   176\t    while env.levels_completed == base_level and not env.terminal():\n   177\t        interact(env)\n   178\t\n   179\t\n   264\tdef stage_and_recover_two_courier_deliveries(env):\n   265\t    \"\"\"Stage an off-lane cargo, dismiss its courier, and recover both deliveries.\"\"\"\n   266\t    # The lower cargo is too close to the courier to claim first. While that\n   267\t    # delivery runs, move the upper cargo down onto the courier's return lane.\n   268\t    walk(env, UP, 2)\n   269\t    walk(env, RIGHT, 3)  # blocked contact faces the upper cargo\n   270\t    interact(env)\n   271\t    walk(env, DOWN)\n   272\t    interact(env)\n   273\t    walk(env, LEFT)\n   274\t\n   275\t    # Let the courier finish the lower route, then collect the staged cargo and\n   276\t    # finish the upper route. The final wait leaves both deliveries on its pad.\n   277\t    for _ in range(11):\n   278\t        interact(env)\n   279\t\n   280\t    # Approach the courier from above after delivery and dismiss it, preventing\n   281\t    # it from reclaiming cargo while the avatar carries each block back.\n   282\t    walk(env, UP)\n   283\t    walk(env, RIGHT, 7)\n   284\t    walk(env, DOWN)\n   285\t    interact(env)\n   286\t\n   287\t    # Return the upper delivery to the upper-left target.\n   288\t    walk(env, LEFT, 2)\n   289\t    walk(env, DOWN)\n   290\t    walk(env, RIGHT)\n   291\t    interact(env)\n   292\t    walk(env, LEFT, 9)\n   293\t    interact(env)\n   294\t\n   295\t\n","exit_code":0,"status":"completed"}}
