    interact(env)\n   344\t    walk(env, UP)\n   345\t\n   346\t    # Return the lower delivery to the lower-left target.\n   347\t    walk(env, DOWN, 2)\n   348\t    walk(env, RIGHT, 10)\n   349\t    interact(env)\n   350\t    walk(env, LEFT, 9)\n   351\t    interact(env)\n     1\t\"\"\"Observe the actual solve-loop entry state for play_level_9.\"\"\"\n     2\t\n     3\timport gkm_try\n     4\t\n     5\tfrom probe9_verify import boxes, target_state\n     6\t\n     7\t\n     8\tdef inspect(env):\n     9\t    called = {\"value\": False}\n    10\t\n    11\t    def play_level_9(level_env):\n    12\t        called[\"value\"] = True\n    13\t        print(\n    14\t            \"REAL_HANDOFF\",\n    15\t            {\n    16\t                \"terminal\": level_env.terminal(),\n    17\t                \"avatar\": boxes(level_env.frame(), 14),\n    18\t                \"courier_12\": boxes(level_env.frame(), 12),\n    19\t                \"courier_15\": boxes(level_env.frame(), 15),\n    20\t                \"target\": target_state(level_env.frame()),\n    21\t            },\n    22\t            flush=True,\n    23\t        )\n    24\t\n    25\t    gkm_try.m.players.play_level_9 = play_level_9\n    26\t    gkm_try.resumed_solve(env)\n    27\t    print(\n    28\t        \"REAL_HANDOFF_AFTER\",\n    29\t        {\n    30\t            \"called\": called[\"value\"],\n    31\t            \"level\": env.levels_completed,\n    32\t            \"terminal\": env.terminal(),\n    33\t        },\n    34\t        flush=True,\n    35\t    )\n    36\t\n    37\t\n    38\tgkm_try.A.run_program(\"wa30\", inspect)\n     1\t\"\"\"Source-free frame perception helpers for cracking.\n     2\t\n     3\tThis module is deliberately observational: it derives compact symbolic state\n     4\tfrom `env.frame()` and `env.clone()` only. It is a cofibration-style scaffold:\n     5\traw pixels are embedded into a monotone tower of reusable observations\n     6\t(components -> objects -> action deltas -> replay states). Candidate level\n     7\tlogic should be written against these quotients, then replay-validated by the\n     8\tharness. No game source or prior solution history is read here.\n     9\t\"\"\"\n    10\tfrom collections import deque\n    11\tfrom dataclasses import dataclass\n    12\tfrom typing import Dict, Iterable, List, Optional, Sequence, Tuple\n    13\t\n    14\timport numpy as np\n    15\t\n    16\tUP, DOWN, LEFT, RIGHT, USE = 1, 2, 3, 4, 5\n    17\tACTIONS = (UP, DOWN, LEFT, RIGHT, USE)\n    18\tDIRS = {UP: (-1, 0), DOWN: (1, 0), LEFT: (0, -1), RIGHT: (0, 1)}\n    19\tACTION_NAME = {UP: \"UP\", DOWN: \"DOWN\", LEFT: \"LEFT\", RIGHT: \"RIGHT\", USE: \"USE\"}\n    20\t\n    21\t\n    22\t@dataclass(frozen=True)\n    23\tclass Blob:\n    24\t    color: int\n    25\t    bbox: Tuple[int, int, int, int]  # r0, c0, r1, c1 inclusive\n    26\t    area: int\n    27\t    centroid: Tuple[float, float]\n    28\t\n    29\t    @property\n    30\t    def top_left(self):\n    31\t        return self.bbox[0], self.bbox[1]\n    32\t\n    33\t    @property\n    34\t    def size(self):\n    35\t        r0, c0, r1, c1 = self.bbox\n    36\t        return r1 - r0 + 1, c1 - c0 + 1\n    37\t\n    38\t\n    39\tdef arr(frame) -> np.ndarray:\n    40\t    return np.asarray(frame)\n    41\t\n    42\t\n    43\tdef color_counts(frame) -> Dict[int, int]:\n    44\t    vals, cnts = np.unique(arr(frame), return_counts=True)\n    45\t    return {int(v): int(c) for v, c in zip(vals, cnts)}\n    82\tdef block_signatures(frame, cell: int = 4) -> Dict[Tuple[int, int], Tuple[int, ...]]:\n    83\t    \"\"\"Partition a frame into fixed cells and return each cell's color signature.\"\"\"\n    84\t    f = arr(frame)\n    85\t    out = {}\n    86\t    for r in range(0, f.shape[0], cell):\n    87\t        for c in range(0, f.shape[1], cell):\n    88\t            out[(r // cell, c // cell)] = tuple(int(v) for v in sorted(np.unique(f[r:r+cell, c:c+cell])))\n    89\t    return out\n    90\t\n    91\t\n    92\tdef object_candidates(frame, cell: int = 4, min_area: int = 4) -> List[dict]:\n    93\t    \"\"\"A compact, game-agnostic object list from color components and cell signatures.\"\"\"\n    94\t    f = arr(frame)\n    95\t    blobs = connected_components(f, min_area=min_area)\n    96\t    sigs = block_signatures(f, cell)\n    97\t    objects = []\n    98\t    for b in blobs:\n    99\t        r0, c0, r1, c1 = b.bbox\n   100\t        objects.append({\n   101\t            \"color\": b.color,\n   102\t            \"bbox\": b.bbox,\n   103\t            \"top_left\": b.top_left,\n   104\t            \"size\": b.size,\n   105\t            \"area\": b.area,\n   106\t            \"centroid\": b.centroid,\n   107\t            \"cell\": (r0 // cell, c0 // cell),\n   108\t            \"cell_sig\": sigs.get((r0 // cell, c0 // cell)),\n   109\t        })\n   110\t    return objects\n   111\t\n   112\t\n   113\tdef frame_delta(before, after) -> dict:\n   114\t    a, b = arr(before), arr(after)\n   115\t    ys, xs = np.where(a != b)\n   116\t    if len(ys) == 0:\n   117\t        return {\"count\": 0, \"bbox\": None, \"samples\": []}\n   118\t    samples = [(int(y), int(x), int(a[y, x]), int(b[y, x])) for y, x in zip(ys[:80], xs[:80])]\n   119\t    return {\n   120\t        \"count\": int(len(ys)),\n   121\t        \"bbox\": (int(ys.min()), int(xs.min()), int(ys.max()), int(xs.max())),\n   122\t        \"samples\": samples,\n   123\t    }\n   124\t\n   125\t\n   126\tdef action_deltas(env, actions: Sequence[int] = ACTIONS) -> Dict[int, dict]:\n   127\t    base = arr(env.frame()).copy()\n   128\t    out = {}\n   129\t    for action in actions:\n   130\t        clone = env.clone()\n   131\t        clone.step(action)\n   132\t        out[int(action)] = frame_delta(base, clone.frame())\n   133\t    return out\n   134\t\n   135\t\n   136\tdef replay(env, actions: Sequence[int]):\n   137\t    clone = env.clone()\n   138\t    for action in actions:\n   139\t        if clone.terminal():\n   140\t            break\n   141\t        clone.step(int(action))\n   142\t    return clone\n   145\tdef path_result(env, actions: Sequence[int]) -> dict:\n   146\t    clone = replay(env, actions)\n   147\t    return {\n   148\t        \"levels_completed\": int(clone.levels_completed),\n   149\t        \"terminal\": bool(clone.terminal()),\n   150\t        \"path_len\": len(actions),\n   151\t        \"colors\": color_counts(clone.frame()),\n   152\t        \"objects\": object_candidates(clone.frame()),\n   153\t    }\n   154\t\n   155\t\n   156\tdef changed_signature(env, actions: Sequence[int], cell: int = 4):\n   157\t    before = block_signatures(env.frame(), cell)\n   158\t    clone = replay(env, actions)\n   159\t    after = block_signatures(clone.frame(), cell)\n   160\t    return {k: (before.get(k), after.get(k)) for k in sorted(set(before) | set(after))\n   161\t            if before.get(k) != after.get(k)}\n   162\t\n   163\t\n   164\tdef bounded_bfs(env, goal_fn, actions: Sequence[int] = (UP, DOWN, LEFT, RIGHT, USE),\n   165\t                key_fn=None, max_states: int = 20000, max_depth: int = 80):\n   166\t    \"\"\"Generic clone BFS over observational keys. Use small max_states first.\"\"\"\n   167\t    if key_fn is None:\n   168\t        key_fn = lambda e: arr(e.frame()).tobytes()\n   169\t    start_key = key_fn(env)\n   170\t    q = deque([(env.clone(), [])])\n   171\t    seen = {start_key}\n   172\t    while q and len(seen) <= max_states:\n   173\t        node, path = q.popleft()\n   174\t        if goal_fn(node, path):\n   175\t            return path\n   176\t        if len(path) >= max_depth:\n   177\t            continue\n   178\t        for action in actions:\n   179\t            child = node.clone()\n   180\t            child.step(int(action))\n   181\t            key = key_fn(child)\n   182\t            if key in seen:\n   183\t                continue\n   184\t            seen.add(key)\n   185\t            q.append((child, path + [int(action)]))\n   186\t    return None\n   232\tdef level_goal(base_level: int):\n   233\t    return lambda env, path: env.levels_completed > base_level\n","exit_code":0,"status":"completed"}}
