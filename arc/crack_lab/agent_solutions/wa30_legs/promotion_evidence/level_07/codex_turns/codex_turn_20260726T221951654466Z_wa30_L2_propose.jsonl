act(env)\n    28\t\n    29\t    # Circle around to the left of the left block, then carry it rightward\n    30\t    # into the target's left slot.\n    31\t    walk(env, DOWN)\n    32\t    walk(env, LEFT, 5)\n    33\t    walk(env, UP, 2)\n    34\t    walk(env, RIGHT)  # blocked contact turns the avatar toward the block\n    35\t    interact(env)\n    36\t    walk(env, RIGHT, 3)\n    37\t    interact(env)\n    38\t\n    39\t    # Approach the upper-right block from below. Its carried offset remains\n    40\t    # above the avatar, so one down and two left steps place it in the last slot.\n    41\t    walk(env, DOWN)\n    42\t    walk(env, RIGHT, 5)\n    43\t    walk(env, UP)\n    44\t    interact(env)\n    45\t    walk(env, DOWN)\n    46\t    walk(env, LEFT, 2)\n    47\t    interact(env)\n     1\timport importlib.util, json, os, sys\n     2\tsys.path.insert(0, '/Users/sasha/gkm/arc/crack_lab')\n     3\timport gkm_legs as G\n     4\timport gkm_arena as A\n     5\ttaint_reason = G._workspace_taint_reason(os.getcwd())\n     6\tif taint_reason:\n     7\t    raise SystemExit(f\"TAINTED WORKSPACE: {taint_reason}\")\n     8\tspec = importlib.util.spec_from_file_location(\"solve\", \"solve.py\")\n     9\tm = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\n    10\tdef resumed_solve(env):\n    11\t    ck = None\n    12\t    if os.path.exists(\"checkpoint.json\"):\n    13\t        with open(\"checkpoint.json\") as f:\n    14\t            ck = json.load(f)\n    15\t    if ck and ck.get(\"game\") == 'wa30' and ck.get(\"validated\") and ck.get(\"final_path\"):\n    16\t        for act in ck[\"final_path\"]:\n    17\t            env.step(act)\n    18\t    m.solve(env)\n    19\tlevels, path, err = A.run_program('wa30', resumed_solve)\n    20\tok = A.validate('wa30', path, levels) if path else False\n    21\tprint(f\"RESULT levels={levels} moves={len(path)} replay_ok={ok} err={err}\")\n     1\timport players\n     2\t\n     3\tdef solve(env):\n     4\t    # dispatch to the per-level player for the current level, in a loop\n     5\t    while not env.terminal():\n     6\t        k = env.levels_completed + 1\n     7\t        fn = getattr(players, f'play_level_{k}', None)\n     8\t        if fn is None:\n     9\t            return\n    10\t        before = env.levels_completed\n    11\t        fn(env)\n    12\t        if env.levels_completed <= before:\n    13\t            return  # no progress -> stop\n","exit_code":0,"status":"completed"}}
