ccepted_source_digest":"","attempted_log_digest":"e3cdaa2eeaa185cad7173862b9df69fd7317c13acac38aa37be8b1948b37d6f9","attempted_source":"# Shared predicate library. p_<name>(panel) -> float | bool\n\nimport math\nimport numpy as np\nfrom scipy.ndimage import convolve\nfrom skimage.morphology import skeletonize\n\n\ndef p_endpoint_turn_degrees(panel):\n    \"\"\"Endpoint-tangent turning of a single open stroke, or -1 if inapplicable.\"\"\"\n    image = np.asarray(panel)\n    if len(image.shape) == 3:\n        gray = image.astype(np.float64).mean(axis=2)\n    else:\n        gray = image.astype(np.float64)\n\n    low = gray.min()\n    high = gray.max()\n    if high <= low:\n        return -1.0\n\n    ink = gray < (low + high) * 0.5\n    skel = skeletonize(ink)\n    kernel = np.ones((3, 3), dtype=np.int32)\n    neighbors = convolve(skel.astype(np.int32), kernel, mode=\"constant\", cval=0) - skel\n    endpoints = np.logical_and(skel, neighbors == 1)\n    ey, ex = np.nonzero(endpoints)\n    if len(ex) != 2:\n        return -1.0\n\n    sy, sx = np.nonzero(skel)\n    d0 = (sx - ex[0]) * (sx - ex[0]) + (sy - ey[0]) * (sy - ey[0])\n    local0 = np.logical_and(d0 <= 144, d0 > 0)\n    d1 = (sx - ex[1]) * (sx - ex[1]) + (sy - ey[1]) * (sy - ey[1])\n    local1 = np.logical_and(d1 <= 144, d1 > 0)\n\n    count0 = local0.sum()\n    count1 = local1.sum()\n    if count0 == 0 or count1 == 0:\n        return -1.0\n\n    vx0 = (sx * local0).sum() / count0 - ex[0]\n    vy0 = (sy * local0).sum() / count0 - ey[0]\n    vx1 = (sx * local1).sum() / count1 - ex[1]\n    vy1 = (sy * local1).sum() / count1 - ey[1]\n\n    norm0 = math.sqrt(vx0 * vx0 + vy0 * vy0)\n    norm1 = math.sqrt(vx1 * vx1 + vy1 * vy1)\n    if norm0 == 0 or norm1 == 0:\n        return -1.0\n\n    cosine = (vx0 * vx1 + vy0 * vy1) / (norm0 * norm1)\n    cosine = min(1.0, max(-1.0, cosine))\n    inward_angle = math.acos(cosine) * 180.0 / math.pi\n    return 180.0 - inward_angle\n\n\ndef _fitted_open_circle(panel):\n    \"\"\"Return normalized circle-fit error and endpoint central angle.\"\"\"\n    image = np.asarray(panel)\n    if len(image.shape) == 3:\n        gray = image.astype(np.float64).mean(axis=2)\n    else:\n        gray = image.astype(np.float64)\n\n    low = gray.min()\n    high = gray.max()\n    if high <= low:\n        return 1.0, -1.0\n\n    ink = gray < (low + high) * 0.5\n    skel = skeletonize(ink)\n    kernel = np.ones((3, 3), dtype=np.int32)\n    neighbors = convolve(skel.astype(np.int32), kernel, mode=\"constant\", cval=0) - skel\n    endpoints = np.logical_and(skel, neighbors == 1)\n    ey, ex = np.nonzero(endpoints)\n    if len(ex) != 2:\n        return 1.0, -1.0\n\n    sy, sx = np.nonzero(skel)\n    if len(sx) < 8:\n        return 1.0, -1.0\n\n    mx = sx.mean()\n    my = sy.mean()\n    x = sx.astype(np.float64) - mx\n    y = sy.astype(np.float64) - my\n    design = np.c_[2.0 * x, 2.0 * y, np.ones_like(x)]\n    target = x * x + y * y\n    solution = np.linalg.lstsq(design, target, rcond=None)[0]\n    cx = solution[0]\n    cy = solution[1]\n    radius_squared = solution[2] + cx * cx + cy * cy\n    if radius_squared <= 0:\n        return 1.0, -1.0\n\n    radius = math.sqrt(radius_squared)\n    distances = np.sqrt((x - cx) * (x - cx) + (y - cy) * (y - cy))\n    fit_error = distances.std() / radius\n\n    rx0 = ex[0] - mx - cx\n    ry0 = ey[0] - my - cy\n    rx1 = ex[1] - mx - cx\n    ry1 = ey[1] - my - cy\n    norm0 = math.sqrt(rx0 * rx0 + ry0 * ry0)\n    norm1 = math.sqrt(rx1 * rx1 + ry1 * ry1)\n    if norm0 == 0 or norm1 == 0:\n        return 1.0, -1.0\n\n    cosine = (rx0 * rx1 + ry0 * ry1) / (norm0 * norm1)\n    cosine = min(1.0, max(-1.0, cosine))\n    angle = math.acos(cosine) * 180.0 / math.pi\n    return float(fit_error), float(angle)\n\n\ndef p_open_circle_fit_error(panel):\n    \"\"\"Normalized radial residual of a fitted simple open circular arc.\"\"\"\n    return _fitted_open_circle(panel)[0]\n\n\ndef p_open_circle_span_degrees(panel):\n    \"\"\"Central angle between endpoints of a fitted simple open circular arc.\"\"\"\n    return _fitted_open_circle(panel)[1]\n","attempted_source_digest":"305bf061fc084b18a9ebcdf7e79dd3baf12259432409ea8b049ba3be86dd6cb1","attempts":3,"baseline_log_digest":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","baseline_source_digest":"357e3a78fe66e45bd8ae862fb142d5932e7d4b67c3132a77d46fe947a87c0c39","charged_definition_node_identities":[],"condition":"primary","control_digest":"","corpus_digest":"sha256:138cbabfc0214fe95fb926d0e7a38b7c1860ec95158eb961886265a43f075205","definition_charge":0,"escalated":true,"fold_rule_atoms":[[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op":"<=","threshold":6.6067460135239315}],[{"name":"p_endpoint_turn_degrees","op"