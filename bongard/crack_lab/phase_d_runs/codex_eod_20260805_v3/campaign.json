.5\n    skel = skeletonize(ink)\n    rows, cols = np.nonzero(skel)\n    ys = rows.tolist()\n    xs = cols.tolist()\n    n = len(xs)\n    if n < 17:\n        return 0.0\n\n    index = dict()\n    adj = dict()\n    for i in range(n):\n        index[(ys[i], xs[i])] = i\n        adj[i] = tuple()\n\n    offsets = ((-1, 0), (0, -1), (0, 1), (1, 0),\n               (-1, -1), (-1, 1), (1, -1), (1, 1))\n    for i in range(n):\n        y = ys[i]\n        x = xs[i]\n        for dy, dx in offsets:\n            j = index.get((y + dy, x + dx), -1)\n            if j <= i:\n                continue\n            keep = True\n            if dy != 0 and dx != 0:\n                if (y + dy, x) in index or (y, x + dx) in index:\n                    keep = False\n            if keep:\n                adj[i] = adj[i] + (j,)\n                adj[j] = adj[j] + (i,)\n\n    order = list()\n    for i in range(n):\n        if len(adj[i]) != 2:\n            order.append(i)\n    for i in range(n):\n        order.append(i)\n\n    visited = dict()\n    chains = list()\n    for start in order:\n        for first in adj[start]:\n            edge = (min(start, first), max(start, first))\n            if edge in visited:\n                continue\n            chain = list()\n            chain.append(start)\n            chain.append(first)\n            visited[edge] = True\n            previous = start\n            current = first\n            for _step in range(n + 1):\n                if len(adj[current]) != 2:\n                    break\n                a = adj[current][0]\n                b = adj[current][1]\n                following = b if a == previous else a\n                edge = (min(current, following), max(current, following))\n                if edge in visited:\n                    break\n                visited[edge] = True\n                previous = current\n                current = following\n                chain.append(current)\n            chains.append(chain)\n\n    best = 0.0\n    gap = 7\n    for chain in chains:\n        if len(chain) < 17:\n            continue\n        values = list()\n        for k in range(gap, len(chain) - gap, 3):\n            ia = chain[k - gap]\n            ib = chain[k]\n            ic = chain[k + gap]\n            ux = float(xs[ib] - xs[ia])\n            uy = float(ys[ib] - ys[ia])\n            vx = float(xs[ic] - xs[ib])\n            vy = float(ys[ic] - ys[ib])\n            lu = (ux * ux + uy * uy) ** 0.5\n            lv = (vx * vx + vy * vy) ** 0.5\n            if lu > 0.0 and lv > 0.0:\n                cosine = (ux * vx + uy * vy) / (lu * lv)\n                cosine = min(1.0, max(-1.0, cosine))\n                turning = (2.0 * (1.0 - cosine)) ** 0.5\n                values.append(2.0 * turning / (lu + lv))\n        if len(values) >= 3:\n            total = 0.0\n            for value in values:\n                total = total + value\n            average = total / float(len(values))\n            if average > 0.001:\n                squared_total = 0.0\n                for value in values:\n                    difference = value - average\n                    squared_total = squared_total + difference * difference\n                deviation = (squared_total / float(len(values))) ** 0.5\n                best = max(best, deviation / average)\n    return float(best)\n","attempted_source_digest":"e36a193dcbbc151e3a4e4f9e516f3678cfead5d3d283467c1fbdf65251e1a24f","attempts":3,"baseline_log_digest":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","baseline_source_digest":"357e3a78fe66e45bd8ae862fb142d5932e7d4b67c3132a77d46fe947a87c0c39","charged_definition_node_identities":[],"condition":"shuffled-sides","control_digest":"sha256:52ccb2d85f9544b2a24cd4969180b5a8f3273f0efe2c4959ac276d3423cbebd2","corpus_digest":"sha256:138cbabfc0214fe95fb926d0e7a38b7c1860ec95158eb961886265a43f075205","definition_charge":0,"escalated":true,"fold_rule_atoms":[],"full_definition_cost":0,"heldout_accuracy":0.0,"label_pol